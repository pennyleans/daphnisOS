// src/main_desknet.ci: A-0 (docs/specs/2026-11-06-a-agent.md section 3), the desk with the network. The desk's
// main (src/main_desk.ci) after the net flavor's boot ARP (src/main_net.ci): busybox-net's sh on a pty in tile
// 0,0, with talk and grant in the image, so `grant net ./talk 10.0.2.2 7070` typed into the shell speaks to
// tools/claudebridge.py on the host (tools/run-desk-agent.sh). Not in the default flavors and not in any gate's
// image: an app the person starts (section 2a). Every received frame is printed as the net flavor prints it.
// A-3: with RDRAND (tools/run-desk-agent.sh passes -cpu max) getrandom draws and the date is the CMOS clock's.
// A-6: agent is in the image too, and a volume, when QEMU attaches one, is mounted at /home, where
// tools/run-agent-live.sh puts the key file (section 2a: nothing runs agent but the person, in the desk's shell).

import src.serial;
import src.fs;
import src.cpu;
import src.pit;
import src.user;
import src.proc;
import src.pool;
import src.surface;
import src.input;
import src.tile;
import src.net;
import src.eth;
import src.dhcp;
import src.udp;
import src.trap;
import src.rng;
import src.rtc;
import src.blk;
import src.ext2;

const I64 LIMIT = 300;   // ticks for the gateway's ARP reply, as src/main_net.ci

void main() {
    serial.serial_write("Daphnis A: the desk with the network\n");
    cpu.tss_install();
    cpu.idt_install_ist();
    _ = pool.init();          // M-3: the pool from the memory map under daphnis.pool=max; the gates' pool otherwise
    user.user_init();
    fs.init();
    if (user.fb_init() > 0) {
        fs.set_fb(user.fb_word(0) as I64, user.fb_word(1) as I64, user.fb_word(2) as I64);
        serial.serial_write("daphnis: framebuffer ");
        proc.put_dec(user.fb_word(0) as I64);
        serial.serial_write("x");
        proc.put_dec(user.fb_word(1) as I64);
        serial.serial_write(" stride ");
        proc.put_dec(user.fb_word(2) as I64);
        serial.serial_write("\n");
    } else {
        serial.serial_write("daphnis: no framebuffer\n");
    }
    pit.pic_remap();
    pit.pit_start(11932);
    rng.init();
    rtc.boot();
    if (input.devices_on()) {
        serial.serial_write("daphnis: keyboard and mouse on\n");
    } else {
        serial.serial_write("daphnis: keyboard on, no mouse\n");
    }
    if (net.init()) {
        if (dhcp.boot_begin()) {
            while (!dhcp.bound() && net.timers() < LIMIT) {   // NW-1's wait: the bound counts timer interrupts
                _ = udp.wait();
                udp.pump();
            }
        }
        dhcp.report_boot(LIMIT);
        I64 gw = eth.gateway();
        if (gw != 0) {
            eth.request(gw);
            I64 gw_until = net.timers() + LIMIT;
            while (!eth.known(gw) && net.timers() < gw_until) {
                _ = udp.wait();
                udp.pump();
            }
            if (eth.known(gw)) {
                serial.serial_write("daphnis: net gateway ");
                dhcp.put_ip(gw);
                serial.serial_write(" known\n");
            } else {
                serial.serial_write("daphnis: net no reply from the gateway\n");
            }
        }
    } else {
        serial.serial_write("daphnis: no network device\n");
    }
    if (blk.init() > 0 && fs.mount_disk()) {
        serial.serial_write("daphnis: /home mounted, ext2, block ");
        proc.put_dec(ext2.block_size());
        serial.serial_write("\n");
    }
    fs.set_input(true);
    serial.serial_write("daphnis: image ");
    proc.put_dec(user.initrd_size());
    serial.serial_write(" bytes from the loader module\n");
    serial.serial_write("daphnis: desk\n");
    proc.push_arg("--cols");
    proc.push_arg("1");
    proc.push_arg("--rows");
    proc.push_arg("2");
    proc.push_arg("--desk");
    proc.run_desk(1, "tiler");
    surface.print();
    if (input.dropped() != 0 || tile.dropped() != 0) {
        serial.serial_write("daphnis: input dropped\n");
        input.say_dropped(tile.dropped());
    }
    proc.report_pool();
    serial.serial_write("daphnis: done\n");
}
