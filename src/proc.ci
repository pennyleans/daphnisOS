    } else if (nr == 17) {
        ret = fs.sys_pread(pid, fd_of(a0), a1, a2, a3);
    } else if (nr == 19) {
        ret = sys_readv(pid, a0, a1, a2);
    } else if (nr == 21) {
        ret = fs.sys_access(pid, CWD, a0, a1);
    } else if (nr == 32) {
        ret = fs.sys_dup(pid, fd_of(a0), 0);
    } else if (nr == 33) {
        ret = fs.sys_dup2(pid, fd_of(a0), fd_of(a1), 0, false);
    } else if (nr == 72) {
        ret = fs.sys_fcntl(pid, fd_of(a0), signed_of(a1), a2);
    } else if (nr == 79) {
        ret = fs.sys_getcwd(pid, a0, a1);
    } else if (nr == 80) {
        ret = fs.sys_chdir(pid, a0);
    } else if (nr == 81) {
        ret = fs.sys_fchdir(pid, fd_of(a0));
    } else if (nr == 82) {
        ret = fs.sys_rename(pid, CWD, a0, CWD, a1, stamp_s());
    } else if (nr == 83) {
        ret = fs.sys_mkdir(pid, CWD, a0, a1, stamp_s());
    } else if (nr == 84) {
        ret = fs.sys_unlink(pid, CWD, a0, true, stamp_s());
    } else if (nr == 87) {
        ret = fs.sys_unlink(pid, CWD, a0, false, stamp_s());
    } else if (nr == 99) {
        ret = sys_sysinfo(pid, a0);                        // KF-2
    } else if (nr == 137) {
        ret = fs.sys_statfs(pid, a0, a1);                  // KF-1
    } else if (nr == 138) {
        ret = fs.sys_fstatfs(pid, fd_of(a0), a1);          // KF-1
    } else if (nr == 76) {
        ret = fs.sys_truncate(pid, a0, signed_of(a1), stamp_s());
    } else if (nr == 77) {
