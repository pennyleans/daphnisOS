// src/proc.ci: processes (U1-1, U1-2; docs/user.md). The table, the loader (a static ELF64 from
// the cpio image into a fresh space), the system calls of the U1-2 subset of the Linux x86-64 ABI,
// and the end of a process by exit or by signal. A process runs only inside user.user_enter; the
// kernel is this module's loop between two turns.
//
// What a transcript shows must not depend on the timer: run_alone runs one process at a time,
// with its output live on the console; run_together runs several under the timer and prints
// their output and ends afterwards, in pid order.

import src.serial;
import src.text;
import src.user;
import src.uvm;
import src.cpio;
import src.elf;
import src.frames;
import src.tile;
import src.fs;
import src.input;
import src.xhci;
import src.udp;
import src.sock;
import src.pty;
import src.trap;
import src.pit;
import src.rng;
import src.sysinfo;
import src.facts;
import src.pci;
import src.blk;
import src.grants;
import src.stamp;
import src.dsp;
import src.job;
import src.exepath;
import src.seat;
import src.net;
import src.eth;
import src.dhcp;
import src.civil;
import src.cmos;
import src.keyrep;

// rt/host.c's row (KF-3a): the processor's brand string, 48 bytes, into dst; 48, or 0 with dst zeroed when the CPU
// has none.
extern observe I64 cpu_brand(out U8[_] dst);
// The processor's base speed in MHz as it reports it (CPUID 0x16), 0 when it reports none.
extern observe I64 cpu_mhz();

const I64 FREE = 0;
const I64 READY = 1;
const I64 DONE = 2;
const I64 ZOMBIE = 3;      // ended, its parent has not waited yet
const I64 WAITING = 4;     // in a call that must wait: retried by the scheduler
const I64 CAP = 256;                  // bytes of output kept per captured process
const U64 STACK_TOP = 0x7FFFFFFFF000;
const U64 STACK_BYTES = 131072;
const U64 MMAP_TOP = 0x7FFF00000000;  // mmap places down from here, a bump pointer per process
const I64 RLIMIT_STACK = 3;
const I64 RLIMIT_AS = 9;
const U64 EPOCH_S = 1767225600;       // 2026-01-01T00:00:00Z: the fixed epoch every gate flavor keeps
const U64 NS = 1000000000;
const U64 CLOCK_MAX = 0x7FFFFFFFFFFFFFFF;
const I64 EPERM = 1;
const I64 EBADF = 9;
const I64 ENOMEM = 12;
const I64 EFAULT = 14;
const I64 EINVAL = 22;
const I64 ENOTTY = 25;
const I64 ECHILD = 10;
const I64 ESRCH = 3;
const I64 E2BIG = 7;
const I64 ESPIPE = 29;
const U64 AT_FDCWD = 0xFFFFFFFFFFFFFF9C;   // -100
const I64 CWD = -100;                       // fs: a path relative to the working directory
const I64 ENOSYS = 38;
const U64 NR_GRANT = 1000;             // P-3, GR-1 A: grant(word), Daphnis's own; Linux has no call 1000 (-ENOSYS)
const U64 NR_TRAY = 1002;              // SP-2: tray(on), the window's program asks for the desk's tray; Linux has no call 1002
const U64 NR_KERN = 1001;              // R0-1: kern(text, n), ask the desk for ring 0; Linux has no call 1001 (-ENOSYS)
const U64 NR_LOGIN = 1003;             // AC-1a (1002 is SP-2's tray): login(uid, gid, ceiling), the desk's child before its first execve
const U64 NR_OPEN_ASK = 1005;          // FF-6c (FF-R8 A): open_ask(path, n), a window asks the desk to open a file; Linux has no call 1005
const U64 NR_HOME = 1006;              // FS-3: home(path, uid, gid), the desk makes or checks an account's home
const U64 NR_FACTS = 1007;             // KF-3a: facts(kind, id, buf, n), one read-only record of the system; Linux has no call 1007
const U64 NR_REVOKE = 1008;            // GV-1a: revoke(vpid, word), the desk takes grants back from a window's processes
const U64 NR_SEAT = 1009;              // LO-1: seat(uid), the desk names the account whose processes take its tile; Linux has no call 1009
const U64 NR_SWEEP = 1010;             // LO-1: sweep(uid), the desk ends a logged out account's processes; Linux has no call 1010
const U64 NR_GRANT_ASK = 1004;         // AC-1a: grant_ask(text, n, word), ask the desk for grants past the ceiling
const I64 EACCES = 13;
const I64 ENOENT = 2;
const I64 ENOEXEC = 8;
const I64 EAGAIN = 11;
const I64 EMFILE = 24;
const I64 ENODEV = 19;
const U64 MAP_SHARED = 1;
const U64 MAP_PRIVATE = 2;
const U64 MAP_FIXED = 16;
const U64 MAP_ANONYMOUS = 32;

I64[64] state;
I64[64] code;       // exit status, or the signal
Bool[64] signaled;
I64[64] ticks;      // turns the timer ended
Bool[64] on_device; // WAITING for the input device (F-2): the scheduler halts for an interrupt, not a deadlock
I64[64] poll_wait;   // E-1: a timed poll parked (1, or 3 when spent), 2 it expires on its next call (E spec 4a)
Bool[64] poll_spent; // a timeout expired and nothing was ready since: the next timed poll waits for a device
I64[64] poll_seen;   // pty.resize_count() at that expiry; a window change ends the untimed wait
const I64 WAIT_MAX = 1500;   // halts for the device before the process is ended: about 15 s of ticks
U64[64] sleep_until; // RS-SLEEP: the wall time (wall_ns) a parked sleep ends, 0 for none; not in the state
Bool sleep_wall = false;   // RS-SLEEP: a live boot that took the machine's date: a sleep also waits the machine's time
Bool[64] capture;
I64[64] caplen;
U8[16384] cap;       // CAP bytes per process
U8[2048] digests;   // per process the digest of its canonical state when it ended (uvm.state_digest)
U64[64] brk_base;   // the page after the program's highest segment
U64[64] brk_now;
U64[64] mmap_next;
U64[64] sres_va;     // RS-SURF: the span of address space a private surface maps into again, 0 for none
U64[64] sres_len;
U64[64] clock;      // the virtual clock, nanoseconds since the process started
I64[64] zero_at;    // RS-CLK2: where CLOCK_REALTIME stood, ns past realtime_s, when the process's clock read 0:
                    // far - far_set when a program starts (load), the parent's at a fork, less the clock at a set
                    // (sys_clock_settime). Not in the state
U64 far = 0;        // FS-R3 C, RS-CLK2: the furthest any process's time line (time_line) has run since boot, ns;
                    // it only grows
I64 stamped = 0;    // the last stamp time given in this boot (src/stamp.ci); neither word is in the state
I64[64] began;      // KF-3b: when the process began, in seconds: the boot's base for one the kernel started, the
                    // system's stamp time (FS-R3 C) at the fork for a child. An execve keeps it (load() starts
                    // the clock again at 0; this word is not load's). Not in the state
U64 realtime_s = EPOCH_S;   // what CLOCK_REALTIME adds: the fixed epoch, or the boot's `rtc` seconds (A-3, src/rtc.ci)
Bool dated = false; // RS-CLK: the boot took a date (src/rtc.ci), so a set is journaled
U64 far_set = 0;    // RS-CLK: `far` at the last set; the stamp time runs from the set's seconds by what far gained since
U64 wall_set = 0;   // RS-CLK2: the wall clock (wall_ns) when the date was last taken: the boot's rtc, or a set
I64[64] vpid;       // the pid the process sees: its number among the processes started together
Bool[64] trayf;     // SP-2: the process asked for the desk's tray (sys_tray)
Bool[64] traymin;   // SP-6: its window minimizes to the tray (tray(2), DN-16)
Bool[64] dlrun;     // SP-7: the process said a download started (tray(3)) and has not said it finished (tray(4))
I64 dl_started = 0; // SP-7 (SP-R6 A): downloads started and finished since boot, FBIO_TILE_INFO kind 12
I64 dl_done = 0;
I64 tray_seq = 0;   // asks and leaves since boot, and those the tiler was told of (FBIO_TILE_SYNC 7)
I64 tray_told = 0;
U8[256] open_path;  // FF-6c: the latest open asked of the desk (sys_open_ask), FBIO_TILE_INFO kind 7
I64 open_len = 0;   // its bytes, 0 for none
I64 open_from = -1; // the asking process
I64 open_seq = 0;   // asks since boot, and those the tiler was told of (FBIO_TILE_SYNC 10)
I64 open_told = 0;
I64[64] parent;     // the slot of the parent, or -1
I64[64] window;     // GV-1a: the window a process belongs to: a number of its own for each child the desk forks,
                    // inherited by all that child starts and kept when a parent ends; 0 for a process of no window
                    // (the desk, and what was started before there was one). Not in the state
I64 windows = 0;    // the last window number given
I64[64] root;       // the slot the kernel started: the family
I64[64] out_owner;  // whose capture buffer console output goes to
I64[64] forks;      // children made
I64 focus_p = -1;   // SCHED-1: the focused pixel window's process, or -1; not in the state (the tiler's input names it)
I64 focus_pty = -1; // SCHED-1: the focused terminal's pty, or -1
I64 desk_run = 0;   // SCHED-1: desk-class turns in a row that an interrupt ended
Bool keep = false;  // SCHED-1: the last turn ended at a system call
const I64 DESK_RUN = 3;
I64[64] exec_at;    // H-3a: the execs counter at the process's last execve (a fork keeps the parent's); not in the state
I64 execs = 0;
I64 family_next = 2;   // the pid the next child of the running family sees
const I64 CHILD_LO = 48;   // children take slots 48 to 63; the kernel starts programs below
U8[1024] comm;      // 16 bytes a process: the name prctl sees (Linux's comm); U1-5
U8[2048] exe;       // 32 bytes a process: the image it runs, what /proc/self/exe names

// execve's strings (FS-4): one string up to PATH_MAX, 4,096 bytes with its NUL, so a path Linux takes is an
// argument here too; 8,192 bytes in all. They lie in the front of digest_now's head (module-level: a kernel local
// past about 4 KiB has no room, and the high window none for both); a digest is never taken during an execve.
const I64 ARG_BYTES = 8192;
const I64 ARG_STR = 4096;
U8[11852] head;     // digest_now's head: at most 256 open descriptors (2 + 20 each), 256 sockets (24 each), the ring
I64[64] exelen;
I64[64] exe_ino;    // K13: the volume inode the process's program was loaded from, 0 for an image member
I64 found_at = 0;   // the last lookup: where the member's data starts, and its size
I64 found_size = 0;
I64 src_ino = 0;    // K13: the loader reads volume inode src_ino (found_size bytes), or the image at found_at when 0
I64 pending_ino = 0;   // K13: the volume inode execve hands load, 0 for the image member load is named

// --- printing ---

export void put_dec(I64 v) {
    U8[20] d;
    I64 mag = v;
    if (v < 0) {
        serial.serial_putc(45);
        mag = 0 - v;
    }
    I64 k = text.dec_digits(mag, d);
    for i in 0..k {
        serial.serial_putc(d[i]);
    }
}

// 0x and the hex digits of v, without leading zeros.
void put_hex(U64 v) {
    serial.serial_write("0x");
    Bool started = false;
    for i in 0..16 {
        U8 nib = ((v >> ((60 - 4 * i) as U64)) & 15) as U8;
        if (nib != 0 || started || i == 15) {
            serial.serial_putc(text.hex_digit(nib));
            started = true;
        }
    }
}

void put_name[m](in U8[m] name) {
    serial.serial_write(name);
}

// --- the image ---

// Finds the member called `want` in the cpio image; sets found_at and found_size. A member with
// no bytes and more than one link is a hard link: the bytes are with the member of the same
// inode that has them (tools/mkcpio.py writes them last, as Linux does).
Bool lookup[m](in U8[m] want) {
    I64 total = user.initrd_size();
    I64 at = 0;
    U8[110] h;
    U8[64] nm;
    while (at + cpio.HEADER_BYTES <= total) {
        if (user.initrd_read(at, h) != cpio.HEADER_BYTES || !cpio.magic_ok(h)) {
            return false;
        }
        I64 ns = cpio.field(h, cpio.F_NAMESIZE);
        I64 msize = cpio.field(h, cpio.F_FILESIZE);
        if (ns < 1 || msize < 0) {
            return false;
        }
        I64 da = cpio.data_at(at, ns);
        if (ns == m + 1) {
            Bool same = user.initrd_read(at + cpio.HEADER_BYTES, nm[0..ns]) == ns && nm[m] == 0;
            for i in 0..m {
                if (nm[i] != want[i]) {
                    same = false;
                }
            }
            if (same) {
                if (msize == 0 && cpio.field(h, cpio.F_NLINK) > 1) {
                    return lookup_ino(cpio.field(h, cpio.F_INO));
                }
                if (msize > total - da) {
                    return false;
                }
                found_at = da;
                found_size = msize;
                return true;
            }
        }
        at = cpio.next_at(at, ns, msize);
    }
    return false;
}

// True when the image has a member called name (N-2: the net flavor runs mudp only when it is there).
export Bool in_image[m](in U8[m] name) {
    return lookup(name);
}

// The member of inode `ino` that holds its bytes.
Bool lookup_ino(I64 ino) {
    I64 total = user.initrd_size();
    I64 at = 0;
    U8[110] h;
    while (at + cpio.HEADER_BYTES <= total) {
        if (user.initrd_read(at, h) != cpio.HEADER_BYTES || !cpio.magic_ok(h)) {
            return false;
        }
        I64 ns = cpio.field(h, cpio.F_NAMESIZE);
        I64 msize = cpio.field(h, cpio.F_FILESIZE);
        if (ns < 1 || msize < 0) {
            return false;
        }
        I64 da = cpio.data_at(at, ns);
        if (msize > 0 && cpio.field(h, cpio.F_INO) == ino) {
            if (msize > total - da) {
                return false;
            }
            found_at = da;
            found_size = msize;
            return true;
        }
        at = cpio.next_at(at, ns, msize);
    }
    return false;
}

// --- user memory words ---

Bool user_range(U64 va, U64 nbytes) {
    return va < uvm.USER_HI && nbytes <= uvm.USER_HI - va;
}

U64 page_up(U64 v) {
    return (v + 4095) & 0xFFFFFFFFFFFFF000;
}

// Writes the 64-bit words of w to pid's memory at va (where ring 3 may write); the bytes written.
I64 poke_words[n](I64 pid, U64 va, in U64[n] w) {
    U8[1024] b;
    for i in 0..n {
        for k in 0..8 {
            b[8 * i + k] = ((w[i] >> ((8 * k) as U64)) & 0xFF) as U8;
        }
    }
    return uvm.poke(pid, va, b, 8 * n, true);
}

// The little-endian word at va in pid's memory; ok[0] goes false if ring 3 could not read it.
U64 peek_word(I64 pid, U64 va, inout Bool[1] ok) {
    U8[8] b;
    if (!user_range(va, 8) || uvm.peek(pid, va, b, 8) != 8) {
        ok[0] = false;
        return 0;
    }
    U64 v = 0;
    for k in 0..8 {
        v = v | ((b[k] as U64) << ((8 * k) as U64));
    }
    return v;
}

// --- pages ---

// Gives every page of [lo, hi) the rights prot; on a failure, takes the pages mapped so far away
// and returns -1.
I64 set_pages(I64 pid, U64 lo, U64 hi, I64 prot) {
    U64 p = lo;
    while (p < hi) {
        if (uvm.set_page(pid, p, prot) < 0) {
            unmap_pages(pid, lo, p);
            return -1;
        }
        p += 4096;
    }
    return 0;
}

void unmap_pages(I64 pid, U64 lo, U64 hi) {
    U64 p = lo;
    while (p < hi) {
        uvm.unmap_page(pid, p);
        p += 4096;
    }
}

// True when every page of [lo, hi) is of the kind asked (uvm.KIND_NONE), or, with any, of any
// kind but none.
Bool pages_are(I64 pid, U64 lo, U64 hi, I64 want, Bool any) {
    U64 p = lo;
    while (p < hi) {
        I64 k = uvm.kind(pid, p);
        if ((any && k == uvm.KIND_NONE) || (!any && k != want)) {
            return false;
        }
        p += 4096;
    }
    return true;
}

// A page-aligned user range of at least one byte.
Bool range_ok(U64 addr, U64 nbytes) {
    return (addr & 4095) == 0 && addr >= uvm.USER_LO && nbytes > 0 && user_range(addr, nbytes);
}

// --- loading ---

// K13: bytes of the executable being loaded from off into b, as many as b holds; the count read.
I64 src_read[n](I64 off, inout U8[n] b) {
    if (src_ino > 0) {
        return fs.exec_read(src_ino, off, b);
    }
    return user.initrd_read(found_at + off, b);
}

// K13: the executable's source for load: volume inode xi, or (xi 0) the image member name. False when
// there is none.
Bool set_source[m](in U8[m] name, I64 xi) {
    src_ino = xi;
    if (xi > 0) {
        found_size = fs.exec_size(xi);
        return found_size > 0;
    }
    return lookup(name);
}

// K13: execve checks the executable whole before the old space goes: the ELF header and each PT_LOAD
// header, as load will. 0, -ENOENT when there is no such member or file, -ENOEXEC when it is not an
// executable this loader takes.
I64 exec_check[m](in U8[m] name, I64 xi) {
    if (!set_source(name, xi)) {
        return 0 - ENOENT;
    }
    U8[64] h;
    if (found_size < elf.EHDR_BYTES || src_read(0, h) != elf.EHDR_BYTES) {
        return 0 - ENOEXEC;
    }
    U64 fsize = found_size as U64;
    if (!elf.exec_ok(h, fsize) || elf.entry(h) < uvm.USER_LO || elf.entry(h) >= STACK_TOP - STACK_BYTES) {
        return 0 - ENOEXEC;
    }
    I64 ph_at = elf.phoff(h) as I64;
    U8[56] p;
    for i in 0..elf.phnum(h) {
        if (src_read(ph_at + elf.PHDR_BYTES * i, p) != elf.PHDR_BYTES) {
            return 0 - ENOEXEC;
        }
        if (elf.p_type(p) == elf.PT_LOAD && !elf.load_ok(p, fsize, uvm.USER_LO, STACK_TOP - STACK_BYTES)) {
            return 0 - ENOEXEC;
        }
    }
    return 0;
}

// Loads `name` from the image into a new space for pid and sets its first frame: 0, or a
// negative step number (2 no such file, 3 not an executable, 4 a segment outside user space,
// 5 out of memory, 6 the stack).
// head holds argc + envc strings (take_strings, start), each with its NUL, argn bytes in all: the program's argv, then
// its environment (CT-5b; at most 96 strings together).
I64 load[m](I64 pid, in U8[m] name, I64 argc, I64 envc, I64 argn) {
    I64 xi = pending_ino;
    pending_ino = 0;
    if (!set_source(name, xi) || found_size < elf.EHDR_BYTES || m > 31 || argc < 1 || envc < 0 || argc + envc > 96 || argn < 1 || argn > ARG_BYTES) {
        return -2;
    }
    U8[64] h;
    if (src_read(0, h) != elf.EHDR_BYTES) {
        return -3;
    }
    U64 fsize = found_size as U64;
    if (!elf.exec_ok(h, fsize) || elf.entry(h) < uvm.USER_LO || elf.entry(h) >= STACK_TOP - STACK_BYTES) {
        return -3;
    }
    if (uvm.create(pid) < 0) {
        return -5;
    }
    for i in 0..32 {
        exe[pid * 32 + i] = 0;
    }
    for i in 0..m {
        exe[pid * 32 + i] = name[i];
    }
    exelen[pid] = m;
    exe_ino[pid] = xi;
    U64 phoff = elf.phoff(h);
    I64 ph_at = phoff as I64;
    I64 ph_count = elf.phnum(h);
    U64 top = 0;
    U64 phdr_va = 0;
    U8[56] p;
    U8[512] buf;
    for i in 0..ph_count {
        if (src_read(ph_at + elf.PHDR_BYTES * i, p) != elf.PHDR_BYTES) {
            return -3;
        }
        if (elf.p_type(p) == elf.PT_LOAD) {
            if (!elf.load_ok(p, fsize, uvm.USER_LO, STACK_TOP - STACK_BYTES)) {
                return -4;
            }
            U64 va = elf.p_vaddr(p);
            U64 page = va & 0xFFFFFFFFFFFFF000;
            Bool w = (elf.p_flags(p) & elf.PF_W) != 0;
            Bool x = (elf.p_flags(p) & elf.PF_X) != 0;
            while (page < va + elf.p_memsz(p)) {
                if (uvm.map(pid, page, w, x) < 0) {
                    return -5;
                }
                page += 4096;
            }
            if (va + elf.p_memsz(p) > top) {
                top = va + elf.p_memsz(p);
            }
            I64 fsz = elf.p_filesz(p) as I64;
            I64 off = elf.p_offset(p) as I64;
            if (phoff >= elf.p_offset(p) && phoff < elf.p_offset(p) + elf.p_filesz(p)) {
                phdr_va = va + (phoff - elf.p_offset(p));
            }
            I64 done = 0;
            while (done < fsz) {
                I64 c = fsz - done;
                if (c > 512) {
                    c = 512;
                }
                if (src_read(off + done, buf[0..c]) != c || uvm.poke(pid, va + done as U64, buf, c, false) != c) {
                    return -5;
                }
                done += c;
            }
        }
    }
    brk_base[pid] = page_up(top);
    brk_now[pid] = brk_base[pid];
    mmap_next[pid] = MMAP_TOP;
    sres_va[pid] = 0;
    sres_len[pid] = 0;
    clock[pid] = 0;
    zero_at[pid] = now_rel() as I64;   // RS-CLK2: a program starts at the system's time, not the boot's second
    far = stamp.further(far, time_line(pid));
    poll_wait[pid] = 0;
    poll_spent[pid] = false;
    sleep_until[pid] = 0;
    U64 sp = STACK_TOP - STACK_BYTES;
    while (sp < STACK_TOP) {
        if (uvm.map(pid, sp, true, false) < 0) {
            return -5;
        }
        sp += 4096;
    }
    // The Linux initial stack, from the top: the argv and environment strings, the 16 bytes
    // AT_RANDOM points at (fixed, so the sealed state depends on nothing but the program, its
    // arguments and its environment), then, 16-byte aligned, argc, argv[0..argc), NULL,
    // envp[0..envc), NULL and the auxiliary vector.
    U64 str = STACK_TOP - (((argn + 15) / 16) * 16) as U64;
    U64 rnd = str - 16;
    U8[16] rb;
    for i in 0..16 {
        rb[i] = ((0x9E + 0x3B * i) & 0xFF) as U8;
    }
    I64 nwords = argc + envc + 27;
    U64 rsp = (rnd - (8 * nwords) as U64) & 0xFFFFFFFFFFFFFFF0;
    U64[128] w;
    for i in 0..128 {
        w[i] = 0;
    }
    w[0] = argc as U64;
    I64 at = 0;
    for i in 0..(argc + envc) {
        I64 slot = 1 + i;              // argv[i]
        if (i >= argc) {
            slot = 2 + i;              // envp[i - argc], after argv's NULL
        }
        w[slot] = str + at as U64;
        while (at < argn && head[at] != 0) {
            at += 1;
        }
        at += 1;
    }
    I64 ax = argc + envc + 3;          // after argv's NULL and envp's NULL
    w[ax] = 3;                         // AT_PHDR
    w[ax + 1] = phdr_va;
    w[ax + 2] = 4;                     // AT_PHENT
    w[ax + 3] = elf.PHDR_BYTES as U64;
    w[ax + 4] = 5;                     // AT_PHNUM
    w[ax + 5] = ph_count as U64;
    w[ax + 6] = 6;                     // AT_PAGESZ
    w[ax + 7] = 4096;
    w[ax + 8] = 9;                     // AT_ENTRY
    w[ax + 9] = elf.entry(h);
    w[ax + 10] = 11;                   // AT_UID, AT_EUID, AT_GID, AT_EGID: 0
    w[ax + 12] = 12;
    w[ax + 14] = 13;
    w[ax + 16] = 14;
    w[ax + 18] = 23;                   // AT_SECURE 0
    w[ax + 20] = 25;                   // AT_RANDOM
    w[ax + 21] = rnd;
    if (uvm.poke(pid, str, head, argn, true) != argn || uvm.poke(pid, rnd, rb, 16, true) != 16 || poke_words(pid, rsp, w[0..nwords]) != 8 * nwords) {
        return -6;
    }
    user.user_setup(pid, elf.entry(h), rsp);
    return 0;
}

// --- system calls ---

void emit[n](I64 pid, in U8[n] b, I64 k) {
    I64 ow = out_owner[pid];
    for i in 0..k {
        if (capture[ow]) {
            if (caplen[ow] < CAP) {
                cap[ow * CAP + caplen[ow]] = b[i];
                caplen[ow] += 1;
            }
        } else {
            serial.serial_putc(b[i]);
        }
    }
}

// A write to the console. Stops at the first byte ring 3 may not read: the count so far, or
// -EFAULT if that was the first.
I64 console_write(I64 pid, U64 buf, U64 n) {
    if (buf >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    U64 want = n;
    if (want > uvm.USER_HI - buf) {
        want = uvm.USER_HI - buf;
    }
    if (want > 0x7FFFF000) {
        want = 0x7FFFF000;
    }
    I64 total = want as I64;
    I64 done = 0;
    U8[256] b;
    while (done < total) {
        I64 c = total - done;
        if (c > 256) {
            c = 256;
        }
        I64 got = uvm.peek(pid, buf + done as U64, b, c);
        emit(pid, b, got);
        done += got;
        if (got < c) {
            if (done == 0) {
                return 0 - EFAULT;
            }
            return done;
        }
    }
    return done;
}

// A descriptor number from a register: -1 when it cannot be one.
I64 fd_of(U64 v) {
    if (v > 0x7FFFFFFF) {
        return -1;
    }
    return v as I64;
}

// poll(fds, nfds, ms) and ppoll(fds, nfds, ts, mask) with the wait in nanoseconds, -1 for none (E-1,
// docs/specs/2026-11-06-e-editor.md section 4a): each pollfd's revents from fs.poll_events, and the count of
// those not 0. Nothing ready and a wait above 0 parks the call; it returns 0 only when the scheduler expires it,
// with every process waiting, and the clock moves on by the wait. After an expiry with nothing ready since,
// the next timed poll is spent: it expires only when no process waits for a device, so it waits for a key
// rather than spin, until something is ready or a pty's window changes. The mask is ignored.
I64 sys_poll(I64 pid, U64 va, U64 nfds, I64 wait_ns) {
    if (nfds > 256) {
        return 0 - EINVAL;
    }
    I64 n = nfds as I64;
    if (n > 0 && (va >= uvm.USER_HI || uvm.USER_HI - va < (8 * n) as U64)) {
        return 0 - EFAULT;
    }
    U8[2048] b;
    if (n > 0 && uvm.peek(pid, va, b, 8 * n) != 8 * n) {
        return 0 - EFAULT;
    }
    I64 ready = 0;
    for k in 0..n {
        I64 fd = (b[8 * k] as I64) | ((b[8 * k + 1] as I64) << 8) | ((b[8 * k + 2] as I64) << 16) | ((b[8 * k + 3] as I64) << 24);
        I64 ev = (b[8 * k + 4] as I64) | ((b[8 * k + 5] as I64) << 8);
        I64 re = 0;
        if (fd < 0x80000000) {
            re = fs.poll_events(pid, fd, ev);   // a negative fd is skipped: revents 0
        }
        b[8 * k + 6] = (re & 0xFF) as U8;
        b[8 * k + 7] = ((re >> 8) & 0xFF) as U8;
        if (re != 0) {
            ready += 1;
        }
    }
    Bool expire = poll_wait[pid] == 2;
    poll_wait[pid] = 0;
    if (ready == 0 && wait_ns != 0 && !expire) {
        if (poll_spent[pid] && pty.resize_count() != poll_seen[pid]) {
            poll_spent[pid] = false;
        }
        if (wait_ns > 0) {
            poll_wait[pid] = 1;
            if (poll_spent[pid]) {
                poll_wait[pid] = 3;
            }
        }
        return fs.WOULD_BLOCK;
    }
    if (ready > 0) {
        poll_spent[pid] = false;
    } else if (expire) {
        poll_spent[pid] = true;
        poll_seen[pid] = pty.resize_count();
        advance(pid, wait_ns as U64);
    }
    if (n > 0 && uvm.poke(pid, va, b, 8 * n, true) != 8 * n) {
        return 0 - EFAULT;
    }
    return ready;
}

// The two's complement value of v.
// A directory descriptor argument (an int): AT_FDCWD (-100), a descriptor, or -1 for anything else.
I64 dirfd_of(U64 v) {
    U64 low = v & 0xFFFFFFFF;
    if (low == (AT_FDCWD & 0xFFFFFFFF)) {
        return CWD;
    }
    return fd_of(low);
}

I64 signed_of(U64 v) {
    if (v < 0x8000000000000000) {
        return v as I64;
    }
    return 0 - ((0xFFFFFFFFFFFFFFFF - v) as I64) - 1;
}

// read(fd, buf, n) and write(fd, buf, n) by what the descriptor is.
I64 sys_read(I64 pid, U64 fdv, U64 buf, U64 n) {
    I64 fd = fd_of(fdv);
    I64 k = fs.fd_kind(pid, fd);
    if (k == fs.KIND_IN || k == fs.KIND_FILE || k == fs.KIND_DIR || k == fs.KIND_PIPE_R || k == fs.KIND_FB
        || k == fs.KIND_XFILE || k == fs.KIND_XDIR || k == fs.KIND_PTM || k == fs.KIND_PTS || k == fs.KIND_DSP
        || k == fs.KIND_FSIDX || k == fs.KIND_RESOLV || k == fs.KIND_NULL) {
        return fs.sys_read(pid, fd, buf, n);
    }
    if (k == fs.KIND_EVENT && tile.queued(pid)) {
        return tile.read_queue(pid, buf, n, real_rel(pid) + realtime_s * NS, fs.nonblock(pid, fd));
    }
    if (k == fs.KIND_EVENT) {
        if (fs.uid_of(pid) != 0 || (tile.tiler_pid() >= 0 && pid != tile.tiler_pid())) { return 0 - EACCES; }
        return input.read_events(pid, buf, n, real_rel(pid) + realtime_s * NS, fs.nonblock(pid, fd));
    }
    if (k == fs.KIND_TCP) {
        return sock.stream_read(pid, fd, buf, n, 0);
    }
    return 0 - EBADF;
}

I64 sys_write(I64 pid, U64 fdv, U64 buf, U64 n) {
    I64 fd = fd_of(fdv);
    I64 k = fs.fd_kind(pid, fd);
    if (k == fs.KIND_OUT) {
        return console_write(pid, buf, n);
    }
    if (k == fs.KIND_FILE || k == fs.KIND_XFILE || k == fs.KIND_PIPE_W || k == fs.KIND_FB || k == fs.KIND_EVENT
        || k == fs.KIND_PTM || k == fs.KIND_PTS || k == fs.KIND_DSP || k == fs.KIND_NULL) {
        return fs.sys_write(pid, fd, buf, n, stamp_s());
    }
    if (k == fs.KIND_TCP) {
        return sock.stream_write(pid, fd, buf, n, 0);
    }
    return 0 - EBADF;
}

// readv(fd, iov, cnt): read for each vector in turn, stopping at a short one.
I64 sys_readv(I64 pid, U64 fd, U64 iov, U64 cnt) {
    if (fs.fd_kind(pid, fd_of(fd)) == fs.KIND_NONE) {
        return 0 - EBADF;
    }
    if (cnt > 1024) {
        return 0 - EINVAL;
    }
    if (iov >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    I64 total = 0;
    Bool[1] ok;
    ok[0] = true;
    for i in 0..cnt as I64 {
        U64 base = peek_word(pid, iov + (16 * i) as U64, ok);
        U64 nbytes = peek_word(pid, iov + (16 * i + 8) as U64, ok);
        if (!ok[0]) {
            if (total == 0) {
                return 0 - EFAULT;
            }
            return total;
        }
        if (nbytes > 0) {
            I64 r = sys_read(pid, fd, base, nbytes);
            if (r <= 0) {
                if (total == 0) {
                    return r;
                }
                return total;
            }
            total += r;
            if ((r as U64) < nbytes) {
                return total;
            }
        }
    }
    return total;
}

// writev(fd, iov, cnt): write for each vector in turn; stops where Linux stops.
I64 sys_writev(I64 pid, U64 fd, U64 iov, U64 cnt) {
    if (fs.fd_kind(pid, fd_of(fd)) == fs.KIND_NONE) {
        return 0 - EBADF;
    }
    if (cnt > 1024) {
        return 0 - EINVAL;
    }
    if (iov >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    I64 total = 0;
    Bool[1] ok;
    ok[0] = true;
    for i in 0..cnt as I64 {
        U64 base = peek_word(pid, iov + (16 * i) as U64, ok);
        U64 nbytes = peek_word(pid, iov + (16 * i + 8) as U64, ok);
        if (!ok[0]) {
            if (total == 0) {
                return 0 - EFAULT;
            }
            return total;
        }
        if (nbytes > 0) {
            I64 r = sys_write(pid, fd, base, nbytes);
            if (r < 0) {
                if (total == 0) {
                    return r;
                }
                return total;
            }
            total += r;
            if ((r as U64) < nbytes) {
                return total;
            }
        }
    }
    return total;
}

// brk(a): the break, moved to a when a is at or above its base, below the mmap area, and the pages are
// free and within the quota (M-1: no cap of its own); the break as it is otherwise (Linux reports a
// failure that way).
I64 sys_brk(I64 pid, U64 a) {
    U64 cur = brk_now[pid];
    if (a < brk_base[pid] || a > mmap_next[pid]) {
        return cur as I64;
    }
    U64 old_end = page_up(cur);
    U64 new_end = page_up(a);
    if (new_end > old_end) {
        if (!pages_are(pid, old_end, new_end, uvm.KIND_NONE, false) || set_pages(pid, old_end, new_end, uvm.PROT_READ | uvm.PROT_WRITE) < 0) {
            return cur as I64;
        }
    } else if (new_end < old_end) {
        unmap_pages(pid, new_end, old_end);
    }
    brk_now[pid] = a;
    return a as I64;
}

// mmap(addr, nbytes, prot, flags, fd, off): anonymous memory, or the surface (F-1): /dev/fb0 at
// offset 0, MAP_SHARED, up to its length, as device pages at the next mmap address (a private
// surface, W-2: fresh pages of the process, which the kernel copies into its tile); any other
// descriptor is -ENODEV. MAP_FIXED replaces what is at addr; otherwise the pages come from the
// top of the process's mmap area, downward.
I64 sys_mmap(I64 pid, U64 addr, U64 nbytes, U64 prot, U64 flags, U64 fd, U64 off) {
    if (nbytes == 0 || nbytes > uvm.USER_HI) {
        return 0 - EINVAL;
    }
    if ((flags & MAP_ANONYMOUS) == 0) {
        I64 k = fs.fd_kind(pid, fd_of(fd));
        if (k == fs.KIND_NONE) {
            return 0 - EBADF;
        }
        if (k != fs.KIND_FB) {
            return 0 - ENODEV;
        }
        Bool own = tile.kind_of(pid) == tile.PRIVATE;
        U64 limit = user.fb_word(4);
        if (own) {
            limit = (tile.stride(pid) * tile.height(pid)) as U64;   // M-1: its pages come out of the quota
        }                              // else the device pages: bounded by fb_word(4), the framebuffer's length, any pitch
        // RES-1: a private surface is bounded by its own length (up to the screen's size, src/surfsize.ci), as
        // /dev/fb0 is by the framebuffer's (HX-8); no 8 MiB MAP_LIMIT (M-1 took it out), so a 4K surface maps
        if ((flags & MAP_SHARED) == 0 || (flags & MAP_FIXED) != 0 || off != 0 || nbytes > limit) {
            return 0 - EINVAL;
        }
        U64 dbytes = page_up(nbytes);
        U64 dat = 0;
        if (own && sres_len[pid] >= dbytes && pages_are(pid, sres_va[pid], sres_va[pid] + dbytes, uvm.KIND_NONE, false)) {
            dat = sres_va[pid];        // RS-SURF: a surface mapped again starts where the last one did (section 5a)
        } else {
            U64 span = dbytes;         // the first map takes its own length, as before RS-SURF
            if (own && sres_len[pid] > 0) {
                span = page_up(4 * user.fb_word(0) * user.fb_word(1));   // a larger one: the mode's whole screen
                if (span < dbytes) {
                    span = dbytes;
                }
            }
            if (mmap_next[pid] - uvm.USER_LO < span) {
                return 0 - ENOMEM;
            }
            dat = mmap_next[pid] - span;
            mmap_next[pid] = dat;
            if (own) {
                sres_va[pid] = dat;
                sres_len[pid] = span;
            }
        }
        if (own) {
            // W-2: a private surface is the process's own pages, read and write, in its digest
            if (set_pages(pid, dat, dat + dbytes, uvm.PROT_READ | uvm.PROT_WRITE) < 0) {
                return 0 - ENOMEM;
            }
            tile.mapped(pid, dat);
            return dat as I64;
        }
        U64 p = 0;
        while (p < dbytes) {
            U64 pa = user.fb_page(p);
            if (pa == 0 || uvm.map_device(pid, dat + p, pa) < 0) {
                unmap_pages(pid, dat, dat + p);
                return 0 - ENOMEM;
            }
            p += 4096;
        }
        return dat as I64;
    }
    if (fd != 0xFFFFFFFFFFFFFFFF) {
        return 0 - EBADF;
    }
    if ((flags & (MAP_SHARED | MAP_PRIVATE)) == 0) {
        return 0 - EINVAL;
    }
    U64 bytes = page_up(nbytes);
    U64 at = 0;
    if ((flags & MAP_FIXED) != 0) {
        if (!range_ok(addr, bytes)) {
            return 0 - EINVAL;
        }
        at = addr;
        tile.unmapped(pid, at, at + bytes);           // RS-SURF: as munmap
        unmap_pages(pid, at, at + bytes);
    } else {
        if (mmap_next[pid] - uvm.USER_LO < bytes) {
            return 0 - ENOMEM;
        }
        at = mmap_next[pid] - bytes;
        mmap_next[pid] = at;
    }
    if (set_pages(pid, at, at + bytes, (prot & 7) as I64) < 0) {
        return 0 - ENOMEM;
    }
    return at as I64;
}

// KF-3 (docs/specs/2026-11-11-kf-facts.md section 2): facts(kind, id, buf, n) (1007), Daphnis's own call: one fixed
// little-endian record of the system (src/facts.ci). It only reads the kernel's state: nothing of the caller's is
// read (buf and n are where the answer goes), it never blocks and it changes nothing. At most n bytes of the record
// are written to buf, and the record's full size is returned, so a record can grow at its end; n 0 asks for the
// size alone and buf is not touched.
//   -EINVAL  a kind that is not one (checked first, before id and buf)
//   -ENOENT  an id past the kind's last record
//   -EFAULT  buf at or above USER_HI, or the bytes to write not all where ring 3 may write (the copy goes a page at
//            a time, as every copy-out does)
// Kind 1, the processor (KF-3a): id 0 only; any process may ask. The record is the CPU's brand string, the count of
// processors the kernel runs on (1: no second processor is started) and the base speed it reports in MHz.
I64 facts_out[m](I64 pid, U64 buf, U64 n, in U8[m] rec, I64 full) {
    I64 k = facts.share(full, n);
    if (k > 0 && (buf >= uvm.USER_HI || uvm.poke(pid, buf, rec, k, true) != k)) {
        return 0 - EFAULT;
    }
    return full;
}

I64 sys_facts(I64 pid, U64 kind, U64 id, U64 buf, U64 n) {
    if (kind == facts.CPU) {
        if (id != 0) {
            return 0 - ENOENT;
        }
        U8[48] brand;
        _ = cpu_brand(brand);
        U8[80] rec;
        facts.cpu(rec, brand, 1, cpu_mhz() as U64, facts.busy_ticks() as U64, facts.idle_ticks() as U64);
        return facts_out(pid, buf, n, rec, facts.CPU_BYTES);
    }
    if (kind == facts.PROCESS) {
        return facts_process(pid, id, buf, n);
    }
    if (kind == facts.NETWORK) {
        return facts_network(pid, id, buf, n);
    }
    if (kind == facts.DISPLAY) {
        return facts_display(pid, id, buf, n);
    }
    if (kind == facts.DISK) {
        return facts_disk(pid, id, buf, n);
    }
    return 0 - EINVAL;
}

// Kind 3, the network (KF-3c): id 0 is the device src/net.ci drives, live or replayed; -ENOENT past it, and for id 0
// when the machine has no network. Any process may ask: an address is no secret on the machine that holds it, and the
// record changes nothing. Link up is a device that holds an address (no carrier state is read from the device).
I64 facts_network(I64 pid, U64 id, U64 buf, U64 n) {
    if (id != 0 || !net.up()) {
        return 0 - ENOENT;
    }
    U8[6] mac;
    for k in 0..6 {
        mac[k] = net.mac_byte(k);
    }
    U8[64] rec;
    facts.network(rec, eth.our_ip() != 0, mac, eth.our_ip() as U64, eth.netmask() as U64, eth.gateway() as U64,
                  eth.dns_ip() as U64, dhcp.source() as U64, dhcp.lease_left() as U64, net.bytes_received() as U64,
                  net.bytes_sent() as U64);
    return facts_out(pid, buf, n, rec, facts.NET_BYTES);
}

// Kind 5, the disk (KF-3e): id 0 is the block device src/blk.ci drives; -ENOENT past it, and for id 0 when the
// machine has no such device. Any process may ask: the record is the device's size and how many bytes its requests
// have moved since boot, no file and no process. Used and free space are statfs's (KF-1), not this record's.
I64 facts_disk(I64 pid, U64 id, U64 buf, U64 n) {
    if (id != 0 || blk.sector_count() == 0) {
        return 0 - ENOENT;
    }
    U8[64] rec;
    facts.disk(rec, (blk.sector_count() * blk.SECTOR_BYTES) as U64, blk.bytes_read() as U64, blk.bytes_written() as U64);
    return facts_out(pid, buf, n, rec, facts.DISK_BYTES);
}

// Kind 4, the display (KF-3d): id 0 only (-ENOENT past it); any process may ask: the record names the machine's
// display adapter and the mode on the screen, and no process. The adapter is the first PCI function of class 0x03
// in the order src/pci.ci lists them (0 with none); its name comes from facts.display_name's table. The mode is the
// surface's as it stands (a mode change shows at the next call); bits a pixel is 32 whenever there is a surface,
// the only depth the kernel takes.
I64 facts_display(I64 pid, U64 id, U64 buf, U64 n) {
    if (id != 0) {
        return 0 - ENOENT;
    }
    I64[64] devs;
    U32[64] ids;
    U32[64] classes;
    I64 found = pci.list(devs, ids, classes);
    U64 idw = 0;
    U64 cls = 0;
    for k in 0..found {
        if (idw == 0 && (classes[k] >> 16) == 3) {
            idw = ids[k] as U64;
            cls = classes[k] as U64;
        }
    }
    U64 w = user.fb_word(0);
    U64 h = user.fb_word(1);
    U64 depth = 0;
    U64 source = facts.SRC_NONE;
    if (w != 0 && h != 0) {
        depth = 32;
        if (user.fb_word(5) == 1) {
            source = facts.SRC_BOCHS;
        } else if (user.fb_word(5) == 2) {
            source = facts.SRC_FIRMWARE;
        }
    }
    U8[104] rec;
    facts.display(rec, idw, cls, w, h, depth, source);
    return facts_out(pid, buf, n, rec, facts.DISPLAY_BYTES);
}

// Kind 2, a process (KF-3b): id is a slot of the process table, 0 up to uvm.PROCS; past it, -ENOENT. The caller sees
// a slot's record when facts.sees says so: the slot's uid is the caller's, or the caller is uid 0, or the caller
// holds ring 0, or its account is a Parent (DN-69 item 5: facts.is_parent, what the desk's login said). Every other slot, with a process the caller may not see or with none, answers with the same 96
// zero bytes and the same return value, so a caller cannot tell the two apart by what it reads. The uid and the
// grant asked about are the kernel's own words for the caller (fs.uid_of, fs.grant_of, facts.is_parent): nothing the
// caller passes decides what it sees.
I64 facts_process(I64 pid, U64 id, U64 buf, U64 n) {
    if (id >= uvm.PROCS as U64) {
        return 0 - ENOENT;
    }
    I64 s = id as I64;
    U8[96] rec;
    facts.empty(rec);
    U64 st = facts.S_EMPTY;
    if (state[s] == READY) {
        st = facts.S_READY;
    } else if (state[s] == WAITING) {
        st = facts.S_WAITING;
    } else if (state[s] == ZOMBIE) {
        st = facts.S_ENDED;
    }
    Bool kern = (fs.grant_of(pid) & fs.GRANT_KERN) != 0;
    if (st != facts.S_EMPTY && facts.sees(fs.uid_of(pid), kern, facts.is_parent(pid), fs.uid_of(s))) {
        U8[16] name;
        for k in 0..16 {
            name[k] = comm[s * 16 + k];
        }
        U64 ppid = 0;
        if (parent[s] >= 0) {
            ppid = vpid[parent[s]] as U64;
        }
        facts.process(rec, vpid[s] as U64, ppid, fs.uid_of(s) as U64, st, name, uvm.frames_owned(s) as U64,
                      frames.quota() as U64, clock[s], fs.grant_of(s), began[s] as U64, facts.ran_ticks(s) as U64);
    }
    return facts_out(pid, buf, n, rec, facts.PROCESS_BYTES);
}

// GV-1a (docs/specs/2026-11-11-gv-revoke.md section 2): revoke(vpid, word) (1008), the desk takes grants back from a
// running window. Only the desk may ask: the tiler's pid with uid 0, the test home (1006) makes; any other caller
// reads -EPERM, before anything else is looked at. word holds disk, net or audio bits; ring 0 or an unknown bit is
// -EINVAL. vpid names a live process as the desk's window record names it (FBIO_TILE_INFO); the call acts on its
// whole window: every live process that carries the same window number, which is the child the desk forked and all
// it started, an orphan among them. -ESRCH when vpid names no live process of the desk's family, or one of no window
// (the desk itself). For each process the bits leave the word and the ceiling (fs.revoke). The count of processes
// whose word held one of the bits. Nothing is copied to or from the caller's memory.
I64 sys_revoke(I64 pid, I64 vp, U64 word) {
    if (pid != tile.tiler_pid() || fs.uid_of(pid) != 0) {
        return 0 - EPERM;
    }
    if (!grants.revocable(word)) {
        return 0 - EINVAL;
    }
    I64 t = slot_of(pid, vp);
    if (t < 0 || state[t] == ZOMBIE || window[t] == 0) {
        return 0 - ESRCH;
    }
    I64 changed = 0;
    for p in 0..uvm.PROCS {
        if ((state[p] == READY || state[p] == WAITING) && root[p] == root[pid] && window[p] == window[t]) {
            if (fs.revoke(p, word)) {
                changed += 1;
            }
        }
    }
    return changed;
}

// KF-2 (docs/specs/2026-11-11-kf-facts.md section 2): sysinfo(info) (99), Linux's struct sysinfo (src/sysinfo.ci).
// uptime is the caller's virtual clock in seconds, so it is a function of the caller's own history like every
// other time it reads. totalram and freeram are the pool's RAM frames and its free ones (mem_unit 4096): the pool
// starts at 32 MiB, below it are the kernel and the loader's image. procs counts the processes that have a pid:
// ready, waiting, or ended and not yet waited for. Any process may ask, as on Linux; the record is five counts.
// -EFAULT unless all 112 bytes lie below USER_HI where ring 3 may write (the copy goes a page at a time).
I64 sys_sysinfo(I64 pid, U64 info) {
    I64 live = 0;
    for p in 0..uvm.PROCS {
        if (state[p] == READY || state[p] == WAITING || state[p] == ZOMBIE) {
            live += 1;
        }
    }
    U64[14] w;
    sysinfo.words(w, clock[pid] / NS, frames.ram() as U64, frames.free_count() as U64, live as U64);
    if (info >= uvm.USER_HI || poke_words(pid, info, w) != sysinfo.BYTES) {
        return 0 - EFAULT;
    }
    return 0;
}

// getrlimit(resource, rlim) and prlimit64(pid, resource, new, old): RLIMIT_AS is the quota, frames.quota() in
// bytes (M-1), RLIMIT_STACK the stack; both fixed, so a new limit is -EPERM. Any other resource is -ENOSYS,
// not modeled. The process is its own pid (0 or its vpid); another is -ESRCH.
I64 sys_rlimit(I64 pid, I64 who, I64 resource, U64 newp, U64 oldp) {
    if (who != 0 && who != vpid[pid]) {
        return 0 - ESRCH;
    }
    U64 lim = 0;
    if (resource == RLIMIT_AS) {
        lim = (frames.quota() * 4096) as U64;
    } else if (resource == RLIMIT_STACK) {
        lim = STACK_BYTES;
    } else {
        return 0 - ENOSYS;
    }
    if (newp != 0) {
        return 0 - EPERM;
    }
    if (oldp != 0) {
        U8[16] b;
        for k in 0..8 {
            b[k] = ((lim >> ((8 * k) as U64)) & 0xFF) as U8;
            b[8 + k] = b[k];
        }
        if (uvm.poke(pid, oldp, b, 16, true) != 16) {
            return 0 - EFAULT;
        }
    }
    return 0;
}

I64 sys_munmap(I64 pid, U64 addr, U64 nbytes) {
    if (!range_ok(addr, nbytes)) {
        return 0 - EINVAL;
    }
    tile.unmapped(pid, addr, addr + page_up(nbytes));   // RS-SURF: a surface page among them ends the mapping
    unmap_pages(pid, addr, addr + page_up(nbytes));
    return 0;
}

I64 sys_mprotect(I64 pid, U64 addr, U64 nbytes, U64 prot) {
    if (!range_ok(addr, nbytes)) {
        return 0 - EINVAL;
    }
    U64 hi = addr + page_up(nbytes);
    if (!pages_are(pid, addr, hi, uvm.KIND_NONE, true) || set_pages(pid, addr, hi, (prot & 7) as I64) < 0) {
        return 0 - ENOMEM;
    }
    return 0;
}

// The virtual clock moves forward by add nanoseconds, never past CLOCK_MAX.
void advance(I64 pid, U64 add) {
    if (add > CLOCK_MAX - clock[pid]) {
        clock[pid] = CLOCK_MAX;
    } else {
        clock[pid] = clock[pid] + add;
    }
    far = stamp.further(far, time_line(pid));  // FS-R3 C, RS-CLK2
}

// RS-CLK2: the process's CLOCK_REALTIME in ns past realtime_s: its time line's zero (zero_at) plus its clock. Every
// process is on the stamp time's line (FS-R3 C): a program starts where the system's furthest clock stands, so one
// started later reads later, and never before a file stamped before it started.
U64 real_rel(I64 pid) {
    I64 z = zero_at[pid];
    U64 c = clock[pid];
    if (z < 0) {
        U64 back = (0 - z) as U64;
        if (c < back) {
            return 0;
        }
        return c - back;
    }
    if (c > CLOCK_MAX - z as U64) {
        return CLOCK_MAX;
    }
    return c + z as U64;
}

// RS-CLK2: where pid's time line stands in far's terms: far_set plus its CLOCK_REALTIME past realtime_s. A program
// starts at far (zero_at), so `sleep 1; sleep 1` moves the system's time 2 s, and one started after another slept
// reads after it.
U64 time_line(I64 pid) {
    U64 r = real_rel(pid);
    if (r > CLOCK_MAX - far_set) {
        return CLOCK_MAX;
    }
    return far_set + r;
}

// RS-CLK2: the system's time in ns past realtime_s. On the fixed epoch, the furthest line (far - far_set), a function
// of the system's history. On a boot that took a date (A-3), the machine's clock alone: the whole seconds the PIT has
// run since the date was taken (the desk's clock), journaled `wal S N` and taken from the journal in a replay
// (rng.wall_take). There a process's sleeps move its own reads and no other's: no call but a set moves the system's
// time.
U64 now_rel() {
    if (!dated) {
        return far - far_set;
    }
    U64 w = wall_ns();
    I64 s = 0;
    if (w > wall_set) {
        s = ((w - wall_set) / NS) as I64;
    }
    return rng.wall_take(s) as U64 * NS;
}

// The wall clock (G-2): the PIT's ticks since the kernel programmed it, in nanoseconds; real time under KVM,
// dilated under TCG. Only CLOCK_BOOTTIME reads it, and no digest holds it.
U64 wall_ns() {
    I64 num = trap.timer_ticks() * pit.USER_DIVISOR;
    I64 s = num / pit.INPUT_HZ;
    I64 frac = (num % pit.INPUT_HZ) * 1000000000 / pit.INPUT_HZ;
    return (s * 1000000000 + frac) as U64;
}

// clock_gettime(clk, ts): the virtual clock, then 1 us on, so a loop that polls it ends.
// CLOCK_REALTIME (0) is realtime_s plus the process's place on the stamp time's line (real_rel, RS-CLK2);
// CLOCK_BOOTTIME (7, G-2) reads the wall clock, the one result that is not a function of the system's history
// (docs/user.md); every other id reads the bare clock.
I64 sys_clock_gettime(I64 pid, U64 clk, U64 ts) {
    if (clk > 11) {
        return 0 - EINVAL;
    }
    U64 t = clock[pid];
    if (clk == 0) {
        U64 n = now_rel();             // RS-CLK2: a running process catches up to the system's time
        U64 r = real_rel(pid);
        if (n > r) {
            zero_at[pid] = zero_at[pid] + (n - r) as I64;
            far = stamp.further(far, time_line(pid));
        }
        t = real_rel(pid);
    }
    if (clk == 7) {
        t = wall_ns();
    }
    advance(pid, 1000);
    U64[2] w;
    w[0] = t / NS;
    w[1] = t % NS;
    if (clk == 0) {
        w[0] = w[0] + realtime_s;
    }
    if (poke_words(pid, ts, w) != 16) {
        return 0 - EFAULT;
    }
    return 0;
}

// The nanoseconds of the timespec at req, or -1 if it is unreadable or not a valid time. RS-CLK2, as Linux: seconds
// below 0 (as a signed word) or nanoseconds of a second or more are -EINVAL; any other time is taken, one past what
// the clock holds read as the clock's end (CLOCK_MAX), so a sleep to a real date is a sleep.
I64 read_timespec(I64 pid, U64 req) {
    Bool[1] ok;
    ok[0] = true;
    U64 s = peek_word(pid, req, ok);
    U64 n = peek_word(pid, req + 8, ok);
    if (!ok[0]) {
        return 0 - EFAULT;
    }
    if (s >= 0x8000000000000000 || n >= NS) {
        return 0 - EINVAL;
    }
    if (s > CLOCK_MAX / NS - 1) {
        return CLOCK_MAX as I64;
    }
    return (s * NS + n) as I64;
}

// A-3: CLOCK_REALTIME from now on adds s, the seconds since 1970 that src/rtc.ci read at boot; K-6: the desk's clock
// runs from it (src/tile.ci).
export void set_realtime(U64 s) {
    realtime_s = s;
    wall_set = wall_ns();              // RS-CLK2
    dated = true;
    sleep_wall = rng.mode() == rng.LIVE;   // RS-SLEEP: a replay's dates come from its journal, and it never waits
    tile.set_date(s as I64);
}

// RS-CLK (docs/specs/2026-11-11-rs-rel-s1-units.md section 2): clock_settime(clk, ts). CLOCK_REALTIME (0) alone; every
// other id is -EINVAL, as Linux answers for a clock it cannot set. In Linux's order: the id, the copy (-EFAULT), the
// time (-EINVAL for nanoseconds of a second or more, or seconds at or past Linux's settimeofday bound), then the
// caller: uid 0 or a holder of GRANT_KERN, else -EPERM, so a session reaches it only through the approval prompt.
// From the set on, CLOCK_REALTIME adds its seconds (each process still adds its own clock), the desk's clock reads
// them at once, and the stamp time (FS-R3 C) runs from them with its guard started again, forward or back. On a boot
// that took a date (A-3) the set is printed and journaled, `clk S` (src/rng.ci), a replay takes the journal's
// seconds, and a boot that read the machine's clock writes it back (src/cmos.ci); on the fixed epoch the set lasts
// for the boot.
I64 sys_clock_settime(I64 pid, U64 clk, U64 ts) {
    if (clk != 0) {
        return 0 - EINVAL;
    }
    if (ts >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    Bool[1] ok;
    ok[0] = true;
    U64 s = peek_word(pid, ts, ok);
    U64 n = peek_word(pid, ts + 8, ok);
    if (!ok[0]) {
        return 0 - EFAULT;
    }
    if (n >= NS || s >= civil.SETTOD_MAX as U64) {   // civil.settable: Linux's settimeofday bound
        return 0 - EINVAL;
    }
    if (fs.uid_of(pid) != 0 && (fs.grant_of(pid) & fs.GRANT_KERN) == 0) {
        return 0 - EPERM;
    }
    I64 t = s as I64;
    if (dated) {
        t = rng.clock_take(t);
        if (!civil.settable(t)) {   // a replay's `clk` line past the bound: the caller's seconds, as live
            t = s as I64;
        }
        rng.clock_record(t);
        if (cmos.live()) {
            cmos.write(t);
        }
    }
    realtime_s = t as U64;
    wall_set = wall_ns();              // RS-CLK2: the machine's clock runs on from the set
    rng.wall_reset();
    for q in 0..uvm.PROCS {            // RS-CLK2: every process reads the set's seconds now, then runs on by its clock
        zero_at[q] = 0 - clock[q] as I64;
    }
    I64 dbase = t - trap.timer_ticks() * pit.USER_DIVISOR / pit.INPUT_HZ;   // K-6: the desk's clock adds the PIT's seconds
    if (dbase < 0) {
        dbase = 0;
    }
    tile.set_date(dbase);
    far_set = far;
    stamped = t;
    return 0;
}

// RS-KR (docs/specs/2026-11-11-rs-rel-s1-units.md section 2): Linux's key repeat control on /dev/input/event0, two
// u32 at arg, the delay before the first repeat and the period between repeats, in ms (src/keyrep.ci). EVIOCGREP: any
// holder of the device reads them. EVIOCSREP: the desk alone (the tiler's pid, uid 0), -EPERM for any other before
// arg is read; then -EFAULT, and -EINVAL for a delay outside 100 to 2000 or a period outside 10 to 1000.
// Whether an ioctl request is EVIOCGREP or EVIOCSREP. Linux's request is an unsigned int, so only its low 32 bits
// count: musl's ioctl takes an int, and EVIOCGREP (bit 31 set) reaches the kernel sign-extended.
Bool is_keyrep(U64 req) {
    U64 r = req & 0xFFFFFFFF;
    return r == keyrep.EVIOCGREP || r == keyrep.EVIOCSREP;
}

I64 sys_keyrep(I64 pid, U64 req, U64 arg) {
    U8[8] b;
    if (req == keyrep.EVIOCGREP) {
        I64 d = keyrep.delay();
        I64 p = keyrep.period();
        for k in 0..4 {
            b[k] = ((d >> (8 * k)) & 0xFF) as U8;
            b[4 + k] = ((p >> (8 * k)) & 0xFF) as U8;
        }
        if (arg >= uvm.USER_HI || uvm.poke(pid, arg, b, 8, true) != 8) {
            return 0 - EFAULT;
        }
        return 0;
    }
    if (pid != tile.tiler_pid() || fs.uid_of(pid) != 0) {
        return 0 - EPERM;
    }
    if (arg >= uvm.USER_HI || uvm.peek(pid, arg, b, 8) != 8) {
        return 0 - EFAULT;
    }
    I64 d = (b[0] as I64) | ((b[1] as I64) << 8) | ((b[2] as I64) << 16) | ((b[3] as I64) << 24);
    I64 p = (b[4] as I64) | ((b[5] as I64) << 8) | ((b[6] as I64) << 16) | ((b[7] as I64) << 24);
    if (!keyrep.set(d, p)) {
        return 0 - EINVAL;
    }
    return 0;
}

// getrandom(buf, n, flags) (A-3): up to rng.DRAW_MAX bytes from src/rng.ci's source, the draw recorded there;
// -ENOSYS with no source, as on a Linux without the call. GRND_NONBLOCK, GRND_RANDOM and GRND_INSECURE (the
// low three bits) change nothing: the source never blocks. A source that fails is -EAGAIN.
I64 sys_getrandom(I64 pid, U64 buf, U64 n, U64 flags) {
    if (rng.mode() == rng.NONE) {
        return 0 - ENOSYS;
    }
    if ((flags & 0xFFFFFFFFFFFFFFF8) != 0) {
        return 0 - EINVAL;
    }
    if (n == 0) {
        return 0;
    }
    I64 k = rng.DRAW_MAX;
    if (n < k as U64) {
        k = n as I64;
    }
    if (!user_range(buf, k as U64)) {
        return 0 - EFAULT;
    }
    U8[256] b;
    if (rng.draw(b, k) != k) {
        return 0 - EAGAIN;
    }
    if (uvm.poke(pid, buf, b, k, true) != k) {
        return 0 - EFAULT;
    }
    return k;
}

// RS-SLEEP (docs/specs/2026-11-05-u1-2-musl.md section 4, edition 2): a sleep moves the virtual clock as it always
// did, and on a live boot that took the machine's date (sleep_wall) the call then also waits the same time on the
// machine's clock: parked as a device wait (the scheduler halts until the PIT's next tick, never a deadlock) and
// made again at each turn until wall_ns reaches sleep_until. A sealed run, a replay and every gate's golden boot
// return at once, as before, so no digest or transcript moves (G-2 A: the PIT never enters the virtual clock).
I64 sleep_park(I64 pid, U64 c0, I64 r) {
    if (r != 0 || !sleep_wall || clock[pid] <= c0) {
        return r;
    }
    U64 d = clock[pid] - c0;
    U64 w = wall_ns();
    if (d > 0xFFFFFFFFFFFFFFFF - w) {
        sleep_until[pid] = 0xFFFFFFFFFFFFFFFF;
    } else {
        sleep_until[pid] = w + d;
    }
    return input.WOULD_BLOCK_DEV;
}

// A parked sleep made again: still waiting, or 0 once the machine's clock reached its end.
I64 sleep_on(I64 pid) {
    if (wall_ns() < sleep_until[pid]) {
        return input.WOULD_BLOCK_DEV;
    }
    sleep_until[pid] = 0;
    return 0;
}

// nanosleep(req, rem): the clock moves by req, and the call returns (RS-SLEEP: on a live boot, after req).
I64 sys_nanosleep(I64 pid, U64 req) {
    if (sleep_until[pid] != 0) {
        return sleep_on(pid);
    }
    U64 c0 = clock[pid];
    return sleep_park(pid, c0, nanosleep_clock(pid, req));
}

I64 nanosleep_clock(I64 pid, U64 req) {
    if (req >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    I64 t = read_timespec(pid, req);
    if (t < 0) {
        return t;
    }
    advance(pid, t as U64);
    return 0;
}

// clock_nanosleep(clk, flags, req, rem): as nanosleep; with TIMER_ABSTIME (1) the clock moves to
// req if that is later (RS-SLEEP: on a live boot the call waits what the clock moved).
I64 sys_clock_nanosleep(I64 pid, U64 clk, U64 flags, U64 req) {
    if (sleep_until[pid] != 0) {
        return sleep_on(pid);
    }
    U64 c0 = clock[pid];
    return sleep_park(pid, c0, clock_nanosleep_clock(pid, clk, flags, req));
}

I64 clock_nanosleep_clock(I64 pid, U64 clk, U64 flags, U64 req) {
    if (clk > 11) {
        return 0 - EINVAL;
    }
    if (req >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    I64 t = read_timespec(pid, req);
    if (t < 0) {
        return t;
    }
    U64 target = t as U64;
    if ((flags & 1) == 0) {
        advance(pid, target);
        return 0;
    }
    if (clk == 0) {                    // RS-CLK2: the process's clock where its CLOCK_REALTIME reads target
        if (target < realtime_s * NS) {
            return 0;
        }
        target = target - realtime_s * NS;
        I64 z = zero_at[pid];
        if (z >= 0) {
            if (target < z as U64) {
                return 0;
            }
            target = target - z as U64;
        } else if (target > CLOCK_MAX - (0 - z) as U64) {
            target = CLOCK_MAX;
        } else {
            target = target + (0 - z) as U64;
        }
    }
    if (target > clock[pid]) {
        clock[pid] = target;
        far = stamp.further(far, time_line(pid));  // FS-R3 C, RS-CLK2
    }
    return 0;
}

// arch_prctl(op, addr): the FS base, which thread-local storage goes through.
I64 sys_arch_prctl(I64 pid, U64 op, U64 addr) {
    if (op == 0x1002) {
        if (addr >= uvm.USER_HI) {
            return 0 - EPERM;
        }
        user.user_set_reg(pid, user.R_FS, addr);
        return 0;
    }
    if (op == 0x1003) {
        U64[1] w;
        w[0] = user.user_reg(pid, user.R_FS);
        if (addr >= uvm.USER_HI || poke_words(pid, addr, w) != 8) {
            return 0 - EFAULT;
        }
        return 0;
    }
    return 0 - EINVAL;
}

// FS-4 with ruling FS-R3 C (docs/specs/2026-11-07-bu2-meta.md section 4.6): the stamp time, the one time every file
// stamp and utimensat's UTIME_NOW take: the boot's base plus the furthest any process's time line has run since boot
// (RS-CLK2: its clock from where the system's stood when its program started), in seconds, never earlier than the last
// stamp given. Not the caller's own clock: a program's clock starts again at 0 when it starts, so a file written later
// by a fresh program would read earlier; RS-CLK2: the caller's CLOCK_REALTIME is this line from where it stood at the
// program's start (real_rel). `far` only grows (advance, and clock_nanosleep's absolute sleep, are the two places a
// clock moves; a fork copies a line that is already counted; a process that ends leaves `far` where it was), so neither
// a child nor an ended process pulls the value back, and the guard holds if the base itself is set back. RS-CLK: a set
// of the clock is the one exception, as the person asked for that time: the stamp time is then the set's seconds plus
// what `far` gained since (far_set), and the guard starts again from them (sys_clock_settime).
I64 stamp_s() {
    stamped = stamp.time(now_rel(), realtime_s, stamped);   // RS-CLK: from the last set's seconds; RS-CLK2
    return stamped;
}

// BU-2: uname (63), struct utsname, six fields of 65 bytes, NUL padded (docs/specs/2026-11-07-bu2-meta.md 4.8).
void uts_field[m](inout U8[390] b, I64 k, in U8[m] v) {
    for i in 0..m {
        b[65 * k + i] = v[i];
    }
}

I64 sys_uname(I64 pid, U64 buf) {
    U8[390] b;
    for i in 0..390 {
        b[i] = 0;
    }
    uts_field(b, 0, "Daphnis");
    uts_field(b, 1, "daphnis");
    uts_field(b, 2, "0.1.0");
    uts_field(b, 3, "#1 BU-2");
    uts_field(b, 4, "x86_64");
    uts_field(b, 5, "(none)");
    if (buf >= uvm.USER_HI || uvm.poke(pid, buf, b, 390, true) != 390) {
        return 0 - EFAULT;
    }
    return 0;
}

// The two's complement bits of v, without a checked cast of a negative value.
U64 bits(I64 v) {
    if (v >= 0) {
        return v as U64;
    }
    return 0xFFFFFFFFFFFFFFFF - (0 - (v + 1)) as U64;
}

void syscall(I64 pid) {
    U64 nr = user.user_reg(pid, user.R_RAX);
    U64 a0 = user.user_reg(pid, user.R_RDI);
    U64 a1 = user.user_reg(pid, user.R_RSI);
    U64 a2 = user.user_reg(pid, user.R_RDX);
    U64 a3 = user.user_reg(pid, user.R_R10);
    U64 a4 = user.user_reg(pid, user.R_R8);
    U64 a5 = user.user_reg(pid, user.R_R9);
    I64 ret = 0 - ENOSYS;
    if (nr == 60 || nr == 231) {
        finish(pid, (a0 & 0xFF) as I64, false);
        return;
    }
    if (nr == 169) {
        ret = sys_reboot(pid, a0, a1, a2);
        if (ret == 0) {
            return;                    // FF-4: every process has ended, the caller last
        }
    } else if (nr == 62) {
        I64 t = slot_of(pid, signed_of(a0));
        I64 sig = signed_of(a1);
        I64 answer = 0 - ESRCH;
        if (t >= 0) {               // KF edition 14: -ESRCH as well for a process the caller may not see
            answer = facts.kill_answer(fs.uid_of(pid), (fs.grant_of(pid) & fs.GRANT_KERN) != 0, facts.is_parent(pid),
                                       fs.uid_of(t));
        }
        if (answer != 0) {
            ret = answer;
        } else if (sig == 0) {
            ret = 0;
        } else if (sig < 1 || sig > 64) {
            ret = 0 - EINVAL;
        } else if (state[t] == ZOMBIE) {
            ret = 0;                   // KILL-Z: an ended process not yet waited for takes no signal, as on Linux;
                                       // finish() on it read the page tables its end had freed (a kernel fault)
        } else if (job.ignored(t, sig)) {
            ret = 0;                   // K-10: an ignored signal does nothing
        } else if (t == pid) {
            finish(pid, sig, true);
            return;
        } else {
            finish(t, sig, true);
            ret = 0;
        }
    } else if (nr == 57) {
        ret = sys_fork(pid);
    } else if (nr == 56) {
        ret = sys_clone(pid, a0, a1);
    } else if (nr == 58) {
        ret = sys_clone(pid, 0x4111, user.user_reg(pid, user.R_RSP));   // vfork: clone's flags on the same stack
    } else if (nr == 59) {
        ret = sys_execve(pid, a0, a1, a2);
        if (ret == 0) {
            return;                    // the new program starts at its entry
        }
        if (ret == 0 - ESRCH) {
            finish(pid, 9, true);      // the old image is gone and the new could not load
            return;
        }
    } else if (nr == 61) {
        ret = sys_wait4(pid, signed_of(a0), a1, a2, a3);
    } else if (nr == 110) {
        ret = 1;
        if (parent[pid] >= 0) {
            ret = vpid[parent[pid]];
        }
    } else if (nr == 102 || nr == 107) {
        ret = fs.uid_of(pid);          // getuid, geteuid (AC-1a): 0 until a login, then the account's
    } else if (nr == 104 || nr == 108) {
        ret = fs.gid_of(pid);          // getgid, getegid
    } else if (nr == 186) {
        ret = vpid[pid];               // gettid: a process is one thread
    } else if (nr == 157) {
        ret = sys_prctl(pid, a0, a1);
    } else if (nr == 97) {
        ret = sys_rlimit(pid, 0, signed_of(a0), 0, a1);
    } else if (nr == 302) {
        ret = sys_rlimit(pid, signed_of(a0), signed_of(a1), a2, a3);
    } else if (nr == 22) {
        ret = fs.sys_pipe(pid, a0, 0);
    } else if (nr == 293) {
        ret = fs.sys_pipe(pid, a0, a1);
    } else if (nr == 7) {
        U64 ms = a2 & 0xFFFFFFFF;
        I64 w = -1;                    // an int below 0: no timeout
        if (ms < 0x80000000) {
            w = (ms as I64) * 1000000;
        }
        ret = sys_poll(pid, a0, a1, w);
    } else if (nr == 271) {
        I64 t = -1;
