    } else if (nr == 316) {
        ret = 0 - EINVAL;              // renameat2: no flags taken
        if (a4 == 0) {
            ret = fs.sys_rename(pid, dirfd_of(a0), a1, dirfd_of(a2), a3, stamp_s());
        }
    } else if (nr == 63) {
        ret = sys_uname(pid, a0);      // BU-2 (docs/specs/2026-11-07-bu2-meta.md): K5 and K4 below
    } else if (nr == 90) {
        ret = fs.sys_chmod(pid, CWD, a0, a1, stamp_s());
    } else if (nr == 268) {
        ret = fs.sys_chmod(pid, dirfd_of(a0), a1, a2, stamp_s());
    } else if (nr == 91) {
        ret = fs.sys_fchmod(pid, fd_of(a0), a1, stamp_s());
    } else if (nr == 92) {
        ret = fs.sys_chown(pid, CWD, a0, a1, a2, 0, stamp_s());
    } else if (nr == 94) {
        ret = fs.sys_chown(pid, CWD, a0, a1, a2, 0x100, stamp_s());
    } else if (nr == 260) {
        ret = fs.sys_chown(pid, dirfd_of(a0), a1, a2, a3, a4, stamp_s());
    } else if (nr == 93) {
        ret = fs.sys_fchown(pid, fd_of(a0), a1, a2, stamp_s());
    } else if (nr == 95) {
        ret = fs.sys_umask(pid, a0);
    } else if (nr == 280) {
        ret = fs.sys_utimensat(pid, dirfd_of(a0), a1, a2, a3, stamp_s());
    } else if (nr == 86) {
        ret = fs.sys_link(pid, CWD, a0, CWD, a1, 0, stamp_s());
    } else if (nr == 265) {
        ret = fs.sys_link(pid, dirfd_of(a0), a1, dirfd_of(a2), a3, a4, stamp_s());
    } else if (nr == 88) {
        ret = fs.sys_symlink(pid, a0, CWD, a1, stamp_s());
    } else if (nr == 266) {
        ret = fs.sys_symlink(pid, a0, dirfd_of(a1), a2, stamp_s());
    } else if (nr == 89 && is_self_exe(pid, a0)) {
        ret = self_exe(pid, a1, a2);
    } else if (nr == 89) {
        ret = fs.sys_readlink(pid, CWD, a0, a1, a2);
    } else if (nr == 267 && is_self_exe(pid, a1)) {
        ret = self_exe(pid, a2, a3);
    } else if (nr == 267) {
        ret = fs.sys_readlink(pid, dirfd_of(a0), a1, a2, a3);
    } else if (nr == 269) {
        ret = fs.sys_access(pid, dirfd_of(a0), a1, a2);
    } else if (nr == 292) {
        ret = fs.sys_dup2(pid, fd_of(a0), fd_of(a1), a2, true);
    } else if (nr == 9 && uvm.lender_of(pid) > 0) {
        ret = 0 - ENOMEM;              // K12: a child running in its parent's space maps nothing of its own
    } else if (nr == 12 && uvm.lender_of(pid) > 0) {
        ret = brk_now[pid] as I64;     // nor moves the break: the break stays where it is, as a refused brk
    } else if (nr == 9) {
        ret = sys_mmap(pid, a0, a1, a2, a3, a4, a5);
    } else if (nr == 10) {
        ret = sys_mprotect(pid, a0, a1, a2);
    } else if (nr == 11) {
        ret = sys_munmap(pid, a0, a1);
    } else if (nr == 12) {
        ret = sys_brk(pid, a0);
    } else if (nr == 13) {
        ret = sys_sigaction(pid, signed_of(a0), a1, a2, a3);
    } else if (nr == 14 || nr == 28) {
        ret = 0;                       // rt_sigprocmask, madvise: nothing to do yet
    } else if (nr == 109) {
        ret = sys_setpgid(pid, signed_of(a0), signed_of(a1));
    } else if (nr == 111) {
        ret = job.group(pid);          // getpgrp
    } else if (nr == 112) {
        ret = sys_setsid(pid);
    } else if (nr == 121 || nr == 124) {
        ret = sys_getpgid(pid, signed_of(a0), nr == 124);
    } else if (nr == 16 && is_keyrep(a1) && fs.fd_kind(pid, fd_of(a0)) == fs.KIND_EVENT) {
        ret = sys_keyrep(pid, a1 & 0xFFFFFFFF, a2);   // RS-KR
    } else if (nr == 16 && a1 == tile.FBIO_TILE_INFO && fs.fd_kind(pid, fd_of(a0)) == fs.KIND_FB) {
        ret = sys_tile_info(pid, a2);
    } else if (nr == 16 && a1 == tile.FBIO_TILE_KERN && fs.fd_kind(pid, fd_of(a0)) == fs.KIND_FB) {
        ret = sys_tile_kern(pid, a2);
    } else if (nr == 16 && a1 == tile.FBIO_TILE_AUDIO && fs.fd_kind(pid, fd_of(a0)) == fs.KIND_FB) {
        ret = sys_tile_audio(pid, a2);
    } else if (nr == 16 && a1 == tile.FBIO_TILE_SYNC && fs.fd_kind(pid, fd_of(a0)) == fs.KIND_FB) {
        ret = fs.sys_ioctl(pid, fd_of(a0), a1, a2, stamp_s());
        if (ret == input.WOULD_BLOCK_DEV && pid == tile.tiler_pid() && kern_news()) {
            ret = 9;                   // R0-1: a request waits for the desk, or a hold ended or turned a minute
        } else if (ret == input.WOULD_BLOCK_DEV && pid == tile.tiler_pid() && tray_told != tray_seq) {
            tray_told = tray_seq;
            ret = 7;                   // SP-2: a process asked for the tray or left it
        } else if (ret == input.WOULD_BLOCK_DEV && pid == tile.tiler_pid() && open_told != open_seq) {
            open_told = open_seq;
            ret = 10;                  // FF-6c: a window asked the desk to open a file
        }
    } else if (nr == 16 && a1 == tile.FBIO_TILE_FOCUS && fs.fd_kind(pid, fd_of(a0)) == fs.KIND_FB) {
        ret = sys_tile_focus(pid, a2);
    } else if (nr == 16 && (a1 == tile.FBIO_TILE_INPUT || a1 == tile.FBIO_TILE_PLACE) &&
               fs.fd_kind(pid, fd_of(a0)) == fs.KIND_FB) {
        ret = sys_tile_pid(pid, a1, a2);
    } else if (nr == 16 && a1 == tile.FBIO_TILER && fs.uid_of(pid) != 0) {
        ret = 0 - EPERM;               // AC-1a: only uid 0 may become the desk
    } else if (nr == 16) {
        ret = fs.sys_ioctl(pid, fd_of(a0), a1, a2, stamp_s());
    } else if (nr == 20) {
        ret = sys_writev(pid, a0, a1, a2);
    } else if (nr == 35) {
        ret = sys_nanosleep(pid, a0);
    } else if (nr == 39 || nr == 218) {
        ret = vpid[pid];               // getpid, set_tid_address: the pid the process sees
    } else if (nr == 158) {
        ret = sys_arch_prctl(pid, a0, a1);
    } else if (nr == 228) {
        ret = sys_clock_gettime(pid, a0, a1);
    } else if (nr == 227) {
        ret = sys_clock_settime(pid, a0, a1);   // RS-CLK
    } else if (nr == 318) {
        ret = sys_getrandom(pid, a0, a1, a2);
    } else if (nr == 230) {
        ret = sys_clock_nanosleep(pid, a0, a1, a2);
    } else if (nr == 41) {
        ret = sock.sys_socket(pid, a0, a1, a2);
    } else if (nr == 49) {
        ret = sock.sys_bind(pid, fd_of(a0), a1, a2);
    } else if (nr == 44) {
        ret = sock.sys_sendto(pid, fd_of(a0), a1, a2, a3, a4, a5);
    } else if (nr == 45) {
        ret = sock.sys_recvfrom(pid, fd_of(a0), a1, a2, a3, a4, a5);
    } else if (nr == 51) {
        ret = sock.sys_getsockname(pid, fd_of(a0), a1, a2);
    } else if (nr == 54) {
        ret = sock.sys_setsockopt(pid, fd_of(a0));
    } else if (nr == 42) {
        ret = sock.sys_connect(pid, fd_of(a0), a1, a2);
    } else if (nr == 43) {
        ret = sock.sys_accept(pid, fd_of(a0), a1, a2, 0);
    } else if (nr == 288) {
        ret = sock.sys_accept(pid, fd_of(a0), a1, a2, a3);
    } else if (nr == 48) {
        ret = sock.sys_shutdown(pid, fd_of(a0), a1);
    } else if (nr == 50) {
        ret = sock.sys_listen(pid, fd_of(a0));
    } else if (nr == 52) {
        ret = sock.sys_getpeername(pid, fd_of(a0), a1, a2);
    }
    if (ret == fs.WOULD_BLOCK || ret == input.WOULD_BLOCK_DEV) {
        state[pid] = WAITING;          // the frame is left as it is: the call is made again
        on_device[pid] = ret == input.WOULD_BLOCK_DEV;
        return;
    }
    if (ret == 0 - 32 && (nr == 1 || nr == 20) && !job.ignored(pid, 13)) {
        finish(pid, 13, true);         // a write with no reader: SIGPIPE, unless it is ignored
        return;
    }
    if (state[pid] == WAITING) {
        state[pid] = READY;
        on_device[pid] = false;
    }
    user.user_set_reg(pid, user.R_RAX, bits(ret));
}

// FBIO_TILE_INPUT (W-3) and FBIO_TILE_PLACE (H-2): the tiler names the client by the pid it sees; the event goes
// to its tile queue, the placement to its window (pid 0: to the tile set next).
I64 sys_tile_pid(I64 pid, U64 req, U64 arg) {
    if (pid != tile.tiler_pid()) {
        return 0 - EPERM;
    }
    U8[4] b;
    if (arg >= uvm.USER_HI || uvm.peek(pid, arg, b, 4) != 4) {
        return 0 - EFAULT;
    }
    I64 vp = (b[0] as I64) | ((b[1] as I64) << 8) | ((b[2] as I64) << 16) | ((b[3] as I64) << 24);
    if (req == tile.FBIO_TILE_PLACE) {
        if (vp == 0) {
            return tile.place(uvm.PROCS, arg);
        }
        return tile.place(slot_of(pid, vp), arg);
    }
    return tile.input_to(slot_of(pid, vp), arg);
}

// FBIO_TILE_FOCUS (SCHED-1, docs/specs/2026-11-07-ds-desk-speed.md section 3), the tiler only: the {u32 kind,
// u32 id} at arg names the focused window as FBIO_TILE_INFO does, kind 0 a pixel client by the pid the tiler sees,
// kind 1 a terminal by the tiler's descriptor of its pty's master; any other kind, no focus. 0, -EPERM, -EFAULT, or
// -ESRCH (no such process or pty: the focus is none).
I64 sys_tile_focus(I64 pid, U64 arg) {
    if (pid != tile.tiler_pid()) {
        return 0 - EPERM;
    }
    U8[8] b;
    if (arg >= uvm.USER_HI || uvm.peek(pid, arg, b, 8) != 8) {
        return 0 - EFAULT;
    }
    I64 kind = (b[0] as I64) | ((b[1] as I64) << 8) | ((b[2] as I64) << 16) | ((b[3] as I64) << 24);
    I64 id = (b[4] as I64) | ((b[5] as I64) << 8) | ((b[6] as I64) << 16) | ((b[7] as I64) << 24);
    focus_p = -1;
    focus_pty = -1;
    if (kind == 0) {
        focus_p = slot_of(pid, id);
        if (focus_p < 0) {
            return 0 - ESRCH;
        }
    } else if (kind == 1) {
        focus_pty = fs.fd_pty(pid, id);
        if (focus_pty < 0) {
            return 0 - ESRCH;
        }
    }
    return 0;
}

// SCHED-1: p is in the desk class: the tiler, the focused pixel window's process, or a member of the focused
// terminal's foreground process group.
Bool desk(I64 p) {
    if (p == tile.tiler_pid() || p == focus_p) {
        return true;
    }
    if (focus_pty < 0) {
        return false;
    }
    I64 g = pty.foreground(focus_pty);
    return g > 0 && job.group(p) == g;
}

// FBIO_TILE_INFO (H-3a, section 5 item 4), the tiler only: the {u32 kind, u32 id} at arg names a window, kind 0 a
// pixel client by the pid the tiler sees (id 0: the latest that took the tile set next at its open or asked
// FBIO_TILE_WANT), kind 1 a terminal by the tiler's descriptor of its pty's master; for a terminal the process is the
// foreground one, the live process with that pty's slave as descriptor 0 that exec'd last, ties to the lowest vpid.
// Writes 64 bytes at arg, {u32 vpid as the tiler sees it, u16 surface w, u16 h (0 x 0 for none), u64 grant word,
// comm[16], the variable[32] (H-3c3)}, the grant word's bit 32 the process's ask for the tray (SP-2): 0, -ESRCH for none, -EFAULT, -EPERM.
// Kinds 8 and 9 (AM-2, DN-43): kinds 0 and 1's window, its app menu's head {u32 vpid, u8 bit 0 Settings declared at 4
// and bit 1 Settings dimmed (AM-4: kind 1 | MARK_DIM << 8),
// u32 its id at 8, About's name[24] at 16, its version[16] at 40}; kinds 10 and 11 About's text {u32 vpid, text[60]}.
// Kinds 15 and 16 (AM-4, docs/specs/2026-11-11-am4-appitems.md section 5): kinds 0 and 1's window, its own row k for a
// kind word 15 + 256 k or 16 + 256 k: {u32 vpid, u8 the rows declared at 4, then the row at 8: u16 id, u16 parent (0
// a menu row), u8 marks at 12 (1 a divider above, 2 the dot, 4 dimmed), u8 the label's length, u8 the keys' length,
// the label[24] at 16 and the keys[16] at 40, NUL padded}; all zero past the rows.
// Kinds 13 and 14 (AC-T2, docs/specs/2026-11-11-ac-t2-image-path.md): kinds 0 and 1's process, the program it runs as
// the kernel loaded it (src/exepath.ci: {u32 vpid, u32 source, u32 the path's length, u32 0, the path at 16, NUL
// padded}); its comm and prctl have no part in it.
// Kinds 17 and 18 (DN-51 frame 25, "NAME is not answering."): kinds 0 and 1's window, {u32 vpid, u32 the input
// waiting unread, u64 the input taken since it began}: a pixel window's tile queue in events (src/tile.ci), a
// terminal's pty in bytes ready to read (src/pty.ci), for any process of it.
// Kind 19 (RS-TTL section 6): kind 0's process, the rest of its variable, {u32 vpid, 28 zero bytes, the variable's
// bytes 32 to 64 at 32}, so kind 0's answer and this one hold the whole tile.VAR_LEN bytes.
// Kind 2 (HX-14): the system, {u32 pool
// frames free, u32 frames, u64 flags (bit 0 a volume on /home, bit 1 stepped frames, SP-3), u64 the date in seconds since 1970 (K-6: the live
// date, src/tile.ci, or the fixed epoch), u64 the compose budget in pixels (D-ROW)}, the rest zero.
I64 sys_tile_info(I64 pid, U64 arg) {
    if (pid != tile.tiler_pid()) {
        return 0 - EPERM;
    }
    U8[64] b;
    if (arg >= uvm.USER_HI || uvm.peek(pid, arg, b, 8) != 8) {
        return 0 - EFAULT;
    }
    I64 kind = (b[0] as I64) | ((b[1] as I64) << 8) | ((b[2] as I64) << 16) | ((b[3] as I64) << 24);
    I64 id = (b[4] as I64) | ((b[5] as I64) << 8) | ((b[6] as I64) << 16) | ((b[7] as I64) << 24);
    I64 p = -1;
    if (kind == 2) {
        // HX-14: the system for Settings' About: u32 pool frames free, u32 frames, u64 bit 0 a volume on /home;
        // K-6: u64 the date for the bar's clock
        I64 fr = frames.free_count();
        U64 fl = 0;
        if (fs.disk_mounted()) { fl = 1; }
        if (tile.stepped()) { fl = fl | 2; }   // SP-3: the gates' stepped frames
        U64 dt = realtime_s;
        I64 dn = tile.date_now();
        if (dn >= 0) { dt = dn as U64; }
        for k in 0..4 {
            b[k] = ((fr >> (8 * k)) & 0xFF) as U8;
            b[4 + k] = ((frames.FRAMES >> (8 * k)) & 0xFF) as U8;
        }
        for k in 0..8 { b[8 + k] = ((fl >> ((8 * k) as U64)) & 0xFF) as U8; }
        for k in 0..8 { b[16 + k] = ((dt >> ((8 * k) as U64)) & 0xFF) as U8; }
        I64 bu = tile.budget_now();    // D-ROW: u64 the compose budget, pixels a timed copy
        for k in 0..8 { b[24 + k] = ((bu >> (8 * k)) & 0xFF) as U8; }
        for k in 32..64 { b[k] = 0; }
        if (uvm.poke(pid, arg, b, 64, true) != 64) {
            return 0 - EFAULT;
        }
        return 0;
    }
    if (kind == 3 || kind == 4 || kind == 6) {
        return kern_info(pid, kind, id, arg);
    }
    if (kind == 5) {
        return panel_info(pid, arg);
    }
    if (kind == 7) {
        return open_info(pid, id, arg);
    }
    if (kind == 12) {
        return dl_info(pid, arg);
    }
    I64 menu = 0;                      // AM-2: kinds 8 to 11 are 0 and 1's window, its app menu declaration
    if (kind == 8 || kind == 9) {
        menu = 1;                      // the head: Settings and About's name and version
        kind = kind - 8;
    } else if (kind == 10 || kind == 11) {
        menu = 2;                      // About's text
        kind = kind - 10;
    } else if (kind == 13 || kind == 14) {
        menu = 3;                      // AC-T2: the program the process runs, as loaded
        kind = kind - 13;
    } else if (kind == 17 || kind == 18) {
        menu = 4;                      // DN-51 frame 25: its input, waiting and taken
        kind = kind - 17;
    } else if (kind == 19) {
        menu = 6;                      // RS-TTL section 6: the rest of the variable (5 is AM-4's)
        kind = 0;
    }
    I64 row = 0;                       // AM-4: kinds 15 and 16, row kind >> 8 of 0 and 1's window
    if ((kind & 0xFF) == 15 || (kind & 0xFF) == 16) {
        menu = 5;                      // 4 is DN-51's (kinds 17 and 18)
        row = kind >> 8;
        kind = (kind & 0xFF) - 15;
    }
    if (kind == 0 && id == 0) {
        p = tile.bound_last();
    } else if (kind == 0) {
        p = slot_of(pid, id);
    } else if (kind == 1) {
        I64 pair = fs.fd_pty(pid, id);
        for q in 0..uvm.PROCS {
            Bool live = state[q] == READY || state[q] == WAITING;
            if (pair >= 0 && live && root[q] == root[pid] && fs.fd_kind(q, 0) == fs.KIND_PTS && fs.fd_pty(q, 0) == pair &&
                (p < 0 || exec_at[q] > exec_at[p] || (exec_at[q] == exec_at[p] && vpid[q] < vpid[p]))) {
                p = q;
            }
        }
    }
    if (p < 0 || root[p] != root[pid] || !(state[p] == READY || state[p] == WAITING)) {
        return 0 - ESRCH;
    }
    if (menu == 4) {
        I64 un = tile.queue_unread(p);
        I64 tk = tile.queue_taken(p);
        if (kind == 1) {
            I64 pair = fs.fd_pty(pid, id);
            un = pty.unread(pair);
            tk = pty.taken_bytes(pair);
        }
        for k in 0..64 { b[k] = 0; }
        for k in 0..4 {
            b[k] = ((vpid[p] >> (8 * k)) & 0xFF) as U8;
            b[4 + k] = ((un >> (8 * k)) & 0xFF) as U8;
        }
        for k in 0..8 { b[8 + k] = ((tk >> (8 * k)) & 0xFF) as U8; }
        if (uvm.poke(pid, arg, b, 64, true) != 64) {
            return 0 - EFAULT;
        }
        return 0;
    }
    if (menu == 6) {
        for k in 0..64 { b[k] = 0; }
        for k in 0..4 { b[k] = ((vpid[p] >> (8 * k)) & 0xFF) as U8; }
        for k in 32..64 { b[k] = tile.var_byte(p, k); }
        if (uvm.poke(pid, arg, b, 64, true) != 64) {
            return 0 - EFAULT;
        }
        return 0;
    }
    if (menu == 3) {
        U8[32] e;
        for k in 0..32 { e[k] = exe[p * 32 + k]; }
        exepath.record(b, vpid[p] as U64, exe_ino[p], e, exelen[p]);
        if (uvm.poke(pid, arg, b, 64, true) != 64) {
            return 0 - EFAULT;
        }
        return 0;
    }
    if (menu > 0) {                    // AM-2: {u32 vpid, then the head or the text}, the rest zero
        for k in 0..64 { b[k] = 0; }
        for k in 0..4 { b[k] = ((vpid[p] >> (8 * k)) & 0xFF) as U8; }
        if (menu == 1) {
            b[4] = tile.menu_byte(p, 104);                         // bit 0: Settings declared; bit 1 dimmed (AM-4)
            b[5] = tile.menu_byte(p, 100);                         // AM section 7: unsaved work
            for k in 0..4 { b[8 + k] = tile.menu_byte(p, 105 + k); }   // its id
            for k in 0..24 { b[16 + k] = tile.menu_byte(p, k); }        // About's name
            for k in 0..16 { b[40 + k] = tile.menu_byte(p, 24 + k); }   // its version
        } else if (menu == 2) {
            for k in 0..60 { b[4 + k] = tile.menu_byte(p, 40 + k); }    // its text
        } else {
            b[4] = tile.rows_of(p) as U8;                          // AM-4: the rows declared, then row `row`
            for k in 0..48 { b[8 + k] = tile.row_byte(p, row, k); }
        }
        if (uvm.poke(pid, arg, b, 64, true) != 64) {
            return 0 - EFAULT;
        }
        return 0;
    }
    U64 gw = fs.grant_of(p);
    if (kind == 1) {
        I64 pair = fs.fd_pty(pid, id);
        for q in 0..uvm.PROCS {
            if ((state[q] == READY || state[q] == WAITING) && root[q] == root[pid] && fs.fd_kind(q, 0) == fs.KIND_PTS &&
                fs.fd_pty(q, 0) == pair) {
                gw = gw | (fs.grant_of(q) & fs.GRANT_KERN);   // R0-1: ring 0 while any process of the terminal holds it
            }
        }
    }
    I64 w = 0;
    I64 h = 0;
    if (tile.kind_of(p) == tile.PRIVATE) {
        w = tile.width(p);
        h = tile.height(p);
    }
    for k in 0..4 {
        b[k] = ((vpid[p] >> (8 * k)) & 0xFF) as U8;
    }
    for k in 0..2 {
        b[4 + k] = ((w >> (8 * k)) & 0xFF) as U8;
        b[6 + k] = ((h >> (8 * k)) & 0xFF) as U8;
    }
    for k in 0..8 {
        b[8 + k] = ((gw >> ((8 * k) as U64)) & 0xFF) as U8;
    }
    if (trayf[p]) {
        b[12] = b[12] | 1;             // SP-2: bit 32, the process asked for the tray
    }
    if (traymin[p]) {
        b[12] = b[12] | 2;             // SP-6: bit 33, its window minimizes to the tray
    }
    for k in 0..16 {
        b[16 + k] = comm[p * 16 + k];
    }
    for k in 0..32 {
        b[32 + k] = tile.var_byte(p, k);
    }
    if (uvm.poke(pid, arg, b, 64, true) != 64) {
        return 0 - EFAULT;
    }
    return 0;
}

// --- R0-1: ring 0 by the desk's word (docs/specs/2026-11-07-r0-ring-zero.md) ---

const I64 KQ = 4;                      // requests that wait for the desk at once
const I64 KTEXT = 56;                  // bytes of a request's command line the desk is shown
const I64 KQ_FREE = 0;
const I64 KQ_ASKED = 1;
const I64 KQ_YES = 2;
const I64 KQ_NO = 3;
I64[4] kq_pid = [-1, -1, -1, -1];
I64[4] kq_state;
I64[4] kq_len;
I64[4] kq_seq;                         // the order requests came in
U64[4] kq_want;                        // AC-1a: what a request asks: GRANT_KERN for kern, grant bits for grant_ask
U8[224] kq_text;
I64 kq_next = 0;
I64 kq_told = 0;                       // requests the desk was told of (FBIO_TILE_SYNC 9)
I64 kq_asked = 0;
I64[64] hold_end;                      // R0-R4 B: the tick a window's hold ends, 0 for none
I64[64] hold_min;                      // its whole minutes left when the desk was last told
I64 hold_s = 300;                      // R0-R4 B: 5 minutes; the hybrid desk's daphnis.kernhold=20 shortens it
I64[64] cool_end;                      // AC-D4: the tick until which the process's asks are refused at once, 0 for
                                       // none; a fork copies it, and nothing but a process's end clears it. Not in
                                       // the state, as hold_end is not
const I64 COOL_S = 30;                 // AC-D4: 30 s from the desk's no or a prompt's timeout

// R0-R4 B: a window's hold, s seconds (src/main_hdesk.ci, from the loader's line, for the gates).
export void set_hold(I64 s) {
    hold_s = s;
}

I64 hold_ticks() {
    return hold_s * pit.INPUT_HZ / pit.USER_DIVISOR;
}

// AC-D4: COOL_S in timer ticks, rounded up, so the cooldown is never shorter than 30 s (3000 at 100 Hz).
I64 cool_ticks() {
    return (COOL_S * pit.INPUT_HZ + pit.USER_DIVISOR - 1) / pit.USER_DIVISOR;
}

// kern(text, n): ring 0 for the caller, asked of the desk. 0 when the caller holds it (a hold in its window, or the
// desk's yes); the call waits while the desk's prompt is up; -EPERM on the desk's no, with no desk, or at once with
// no prompt within 30 s of the desk's no to the caller's tree (AC-D4, cool); -EAGAIN when KQ requests wait already;
// -EFAULT. text is the command line the prompt names, NUL-separated. kern(0, 0) asks
// nothing: 1 when the caller holds ring 0, else 0.
I64 sys_kern(I64 pid, U64 a0, U64 a1) {
    if (a0 == 0 && a1 == 0) {
        if ((fs.grant_of(pid) & fs.GRANT_KERN) != 0) { return 1; }
        return 0;
    }
    return ask(pid, a0, a1, fs.GRANT_KERN);
}

// AC-1a (docs/specs/2026-11-08-ac-accounts.md section 5): grant_ask(text, n, word), the grants of word that the
// caller's ceiling does not reach, asked of the desk as kern is (L2, L8). 0 when nothing is past the ceiling or on
// the desk's yes, which adds the bits to the caller's word (so they last until its tree ends); the call waits while
// the prompt is up; -EPERM on the desk's no or with no desk; -EINVAL for a word holding ring 0 or an unknown bit.
I64 sys_grant_ask(I64 pid, U64 a0, U64 a1, U64 w) {
    if ((w & ~fs.GRANT_ALL) != 0) {
        return 0 - EINVAL;
    }
    for k in 0..KQ {
        if (kq_pid[k] == pid) {
            return ask(pid, a0, a1, w);   // the answer to the request already made
        }
    }
    U64 more = fs.beyond(pid, w);
    if (more == 0) {
        return 0;
    }
    return ask(pid, a0, a1, more);
}

// AC-1a: login(uid, gid, ceiling), the one-way door of section 5. Only a child of the desk that has not run execve
// may call it, once: uid 1 or more, gid 0 or more, the ceiling grant bits without ring 0. The caller takes the user,
// the group and the ceiling, and drops ring 0, its window hold and every grant but disk if the ceiling holds it.
// DN-69 item 5: facts.LOGIN_PARENT beside the ceiling bits says the account is a Parent (the desk reads the role from
// authd's store), so the session sees every process in facts. 0, -EPERM (not the desk's child, already execve'd, or
// already a user), -EINVAL.
// FS-3: home(path, uid, gid), the desk's alone (the tiler's pid, uid 0): src/fs.ci's sys_home. -EPERM for any other.
I64 sys_home(I64 pid, U64 path, I64 uid, I64 gid) {
    if (pid != tile.tiler_pid() || fs.uid_of(pid) != 0) {
        return 0 - EPERM;
    }
    return fs.sys_home(pid, path, uid, gid, stamp_s());
}

// LO-1: seat(uid), the desk's alone (-EPERM for any other): the account whose processes may take the tile the desk
// offers (src/tile.ci's on_open), named at login, or -1 for none between a log out and the next login; with accounts
// off, uid 0. Until a desk names one, any process takes the tile, as before LO-1. uid -1 to 65535, else -EINVAL.
I64 sys_seat(I64 pid, I64 uid) {
    if (pid != tile.tiler_pid() || fs.uid_of(pid) != 0) {
        return 0 - EPERM;
    }
    return seat.name(uid);
}

// LO-1: sweep(uid), the desk's alone (the tiler's pid, uid 0; -EPERM for any other): every live process of the desk's
// family whose uid is uid ends as SIGKILL ends it, whatever its session or what it ignores (src/seat.ci). After a log
// out's SIGTERM and its hold, so a program an account left running never reaches the next session. uid 1 to 65535,
// else -EINVAL; the count of processes it ended. No process runs during the call, and a fork's child has its parent's uid, so no fork
// escapes it; a process that has ended (ZOMBIE) is left for its parent's wait.
I64 sys_sweep(I64 pid, I64 uid) {
    if (pid != tile.tiler_pid() || fs.uid_of(pid) != 0) {
        return 0 - EPERM;
    }
    if (uid < 1 || uid > 65535) {
        return 0 - EINVAL;
    }
    I64 n = 0;
    for p in 0..uvm.PROCS {
        if (seat.ends(uid, fs.uid_of(p), state[p] == READY || state[p] == WAITING, root[p] == root[pid])) {
            n += 1;
        }
    }
    for p in 0..uvm.PROCS {
        if (seat.ends(uid, fs.uid_of(p), state[p] == READY || state[p] == WAITING, root[p] == root[pid])) {
            finish(p, 9, true);        // a vfork child in its space ends first, as kill ends one (K12)
        }
    }
    return n;
}

I64 sys_login(I64 pid, I64 uid, I64 gid, U64 c) {
    I64 d = tile.tiler_pid();
    if (d < 0 || parent[pid] != d || exec_at[pid] != exec_at[d] || fs.uid_of(pid) != 0) {
        return 0 - EPERM;
    }
    U64 g = c & ~facts.LOGIN_PARENT;
    if (uid < 1 || uid > 65535 || gid < 0 || gid > 65535 || (g & ~fs.GRANT_ALL) != 0) {
        return 0 - EINVAL;
    }
    kern_forget(pid);
    fs.set_login(pid, uid, gid, g);
    facts.set_parent(pid, (c & facts.LOGIN_PARENT) != 0);
    return 0;
}

// A request of the desk for want (GRANT_KERN, or grant bits): kern's and grant_ask's common path.
I64 ask(I64 pid, U64 a0, U64 a1, U64 want) {
    for k in 0..KQ {
        if (kq_pid[k] == pid) {
            if (kq_state[k] == KQ_ASKED) { return fs.WOULD_BLOCK; }
            Bool yes = kq_state[k] == KQ_YES;
            kq_pid[k] = -1;
            kq_state[k] = KQ_FREE;
            if (yes) { return 0; }
            return 0 - EPERM;
        }
    }
    if ((fs.grant_of(pid) & fs.GRANT_KERN) != 0) {
        return 0;
    }
    if (want != fs.GRANT_KERN && fs.beyond(pid, want) == 0) {
        return 0;
    }
    if (cool_end[pid] > 0 && trap.timer_ticks() < cool_end[pid]) {
        return 0 - EPERM;              // AC-D4: the tree was refused under 30 s ago: refused at once, no prompt
    }
    if (tile.tiler_pid() < 0 || root[tile.tiler_pid()] != root[pid]) {
        return 0 - EPERM;              // no desk to ask: the kernel never sets the bit on its own
    }
    I64 at = -1;
    for k in 0..KQ {
        if (at < 0 && kq_state[k] == KQ_FREE) { at = k; }
    }
    if (at < 0) {
        return 0 - EAGAIN;
    }
    I64 n = a1 as I64;
    if (a1 > 4096) { n = 4096; }
    if (n > KTEXT) { n = KTEXT; }
    U8[56] t;
    if (n > 0 && (a0 >= uvm.USER_HI || uvm.peek(pid, a0, t, n) != n)) {
        return 0 - EFAULT;
    }
    for k in 0..KTEXT {
        kq_text[KTEXT * at + k] = 0;
        if (k < n) { kq_text[KTEXT * at + k] = t[k]; }
    }
    kq_pid[at] = pid;
    kq_state[at] = KQ_ASKED;
    kq_want[at] = want;
    kq_len[at] = n;
    kq_seq[at] = kq_next;
    kq_next = kq_next + 1;
    kq_asked = kq_asked + 1;
    return fs.WOULD_BLOCK;
}

// A process ended: its request, if any, its hold and its cooldown go.
void kern_forget(I64 pid) {
    for k in 0..KQ {
        if (kq_pid[k] == pid) {
            kq_pid[k] = -1;
            kq_state[k] = KQ_FREE;
        }
    }
    hold_end[pid] = 0;
    cool_end[pid] = 0;
    if (trayf[pid] || traymin[pid]) {
        trayf[pid] = false;
        traymin[pid] = false;
        tray_seq += 1;
    }
    if (dlrun[pid]) {                  // SP-7: a download that ended unfinished; the desk's icon stays as it is
        dlrun[pid] = false;
        tray_seq += 1;
    }
}

// Whether the desk has news of ring 0: a request it was not told of, a hold that ended (its bit cleared here), or a
// hold whose whole minutes left changed.
Bool kern_news() {
    Bool news = kq_asked != kq_told;
    kq_told = kq_asked;
    I64 now = trap.timer_ticks();
    for p in 0..uvm.PROCS {
        if (hold_end[p] > 0) {
            if (now >= hold_end[p]) {
                hold_end[p] = 0;
                fs.kern_set(p, false);  // R0-R4 B: commands started now hold none; a running one keeps its bit
                news = true;
            } else {
                I64 m = mins_left(p, now);
                if (m != hold_min[p]) {
                    hold_min[p] = m;
                    news = true;
                }
            }
        }
    }
    return news;
}

I64 secs_left(I64 p, I64 now) {
    if (hold_end[p] <= now) { return 0; }
    return ((hold_end[p] - now) * pit.USER_DIVISOR + pit.INPUT_HZ - 1) / pit.INPUT_HZ;
}

I64 mins_left(I64 p, I64 now) {
    return (secs_left(p, now) + 59) / 60;
}

// FBIO_TILE_INFO kinds 3, 4 and 6, the tiler only. Kind 3: the oldest request the desk has not answered, {u32 vpid,
// u32 n, the command line[56]}, -ESRCH for none. Kind 4, id a vpid: {u32 seconds its hold has left (0: none),
// u32 1 if it holds ring 0}, -ESRCH for no such process. Kind 6 (AC-1a; 5 is the SP panel), the same oldest request: {u32 vpid, u32 the
// word it asks (GRANT_KERN for kern, else grant bits), u32 the asking process's uid}, so the desk draws the
// KERNEL ELEVATION REQUEST or PARENT APPROVAL in the asked ring's color (L8).
I64 kern_info(I64 pid, I64 kind, I64 id, U64 arg) {
    U8[64] b;
    for k in 0..64 { b[k] = 0; }
    if (kind == 3 || kind == 6) {
        I64 at = -1;
        for k in 0..KQ {
            if (kq_state[k] == KQ_ASKED && (at < 0 || kq_seq[k] < kq_seq[at])) { at = k; }
        }
        if (at < 0) { return 0 - ESRCH; }
        I64 vp = vpid[kq_pid[at]];
        I64 second = kq_len[at];
        if (kind == 6) { second = kq_want[at] as I64; }
        I64 u = fs.uid_of(kq_pid[at]);
        for k in 0..4 {
            b[k] = ((vp >> (8 * k)) & 0xFF) as U8;
            b[4 + k] = ((second >> (8 * k)) & 0xFF) as U8;
            if (kind == 6) { b[8 + k] = ((u >> (8 * k)) & 0xFF) as U8; }
        }
        if (kind == 3) {
            for k in 0..KTEXT { b[8 + k] = kq_text[KTEXT * at + k]; }
        }
    } else {
        I64 p = slot_of(pid, id);
        if (p < 0) { return 0 - ESRCH; }
        I64 sl = secs_left(p, trap.timer_ticks());
        for k in 0..4 { b[k] = ((sl >> (8 * k)) & 0xFF) as U8; }
        if ((fs.grant_of(p) & fs.GRANT_KERN) != 0) { b[4] = 1; }
    }
    if (uvm.poke(pid, arg, b, 64, true) != 64) {
        return 0 - EFAULT;
    }
    return 0;
}

// FBIO_TILE_KERN (R0-1), the tiler only: {u32 vpid, u32 verb} at arg. Verb 0, the person refused vpid's request
// (Esc), or it timed out: an account's tree is cooled for 30 s (AC-D4, cool); 1, confirmed it (Super+Enter): the
// bit is set on vpid; 2, the window's hold (R0-R4 B): the bit on vpid
// (its shell) until hold_s seconds from now; 3, the hold cleared now. 0, -EPERM, -EFAULT, -ESRCH, -EINVAL.
I64 sys_tile_kern(I64 pid, U64 arg) {
    if (pid != tile.tiler_pid()) {
        return 0 - EPERM;
    }
    U8[8] b;
    if (arg >= uvm.USER_HI || uvm.peek(pid, arg, b, 8) != 8) {
        return 0 - EFAULT;
    }
    I64 vp = (b[0] as I64) | ((b[1] as I64) << 8) | ((b[2] as I64) << 16) | ((b[3] as I64) << 24);
    I64 verb = (b[4] as I64) | ((b[5] as I64) << 8) | ((b[6] as I64) << 16) | ((b[7] as I64) << 24);
    I64 p = slot_of(pid, vp);
    if (p < 0) {
        return 0 - ESRCH;
    }
    if (verb == 0 || verb == 1) {
        for k in 0..KQ {
            if (kq_pid[k] == p && kq_state[k] == KQ_ASKED) {
                if (verb == 1) {
                    if (kq_want[k] == fs.GRANT_KERN) {
                        fs.kern_set(p, true);
                    } else {
                        fs.grant_add(p, kq_want[k]);   // AC-1a: a parent's yes to grant_ask (L2)
                    }
                    kq_state[k] = KQ_YES;
                } else {
                    kq_state[k] = KQ_NO;
                    cool(p);
                }
                return 0;
            }
        }
        return 0 - ESRCH;
    }
    if (verb == 2) {
        fs.kern_set(p, true);
        hold_end[p] = trap.timer_ticks() + hold_ticks();
        hold_min[p] = mins_left(p, trap.timer_ticks());
        return 0;
    }
    if (verb == 3) {
        hold_end[p] = 0;
        fs.kern_set(p, false);
        return 0;
    }
    return 0 - EINVAL;
}

// AC-D4 (docs/specs/2026-11-08-ac-accounts.md section 2): the desk said no to p's request, by Esc, a click off,
// a lock or the prompt's timeout. A refused or timed-out request from the same process tree is refused without a
// prompt for 30 s: the tree is p's window (GV-1a), the child the desk forked and all it started, an orphan or a new
// session among them, so every live process of the family with p's window number is marked until cool_ticks() from
// now, and a request of theirs already waiting is refused with p's. What they start is marked by fork. A process of
// no window marks itself alone. Only an account's process (uid 1 or more) is marked: with accounts off every process
// is uid 0, and R0-3's prompt is asked each time.
void cool(I64 p) {
    if (fs.uid_of(p) == 0) {
        return;
    }
    I64 e = trap.timer_ticks() + cool_ticks();
    for q in 0..uvm.PROCS {
        if ((state[q] == READY || state[q] == WAITING) && root[q] == root[p] &&
            (q == p || (window[p] != 0 && window[q] == window[p]))) {
            if (cool_end[q] < e) {
                cool_end[q] = e;
            }
            for k in 0..KQ {
                if (kq_pid[k] == q && kq_state[k] == KQ_ASKED) {
                    kq_state[k] = KQ_NO;
                }
            }
        }
    }
}

// --- SP-1: the system panel (docs/specs/2026-11-08-sp-system-panel.md) ---

// SP-2 (SP-R3 A): a process's ask for the desk's tray, told the desk by FBIO_TILE_SYNC 7 and FBIO_TILE_INFO kinds 0
// and 1 (bit 32 of the grant word's u64). Only the asking program puts its window there; nothing hides by default.

// tray(on): 1 asks for the tray, 2 asks that the window minimize to it (SP-6, DN-16: the program's choice, DN-19),
// 0 drops either; SP-7 (SP-R6 A): 3 says a download started, 4 that the process's download finished (once a 3);
// 0, -EINVAL.
I64 sys_tray(I64 pid, U64 on) {
    if (on > 4) {
        return 0 - EINVAL;
    }
    if (on == 3) {
        dl_started += 1;
        dlrun[pid] = true;
        tray_seq += 1;
        return 0;
    }
    if (on == 4) {
        if (dlrun[pid]) {
            dl_done += 1;
            dlrun[pid] = false;
            tray_seq += 1;
        }
        return 0;
    }
    Bool want = trayf[pid];           // (not `ask`: the name of this module's ask for the desk)
    Bool to_min = traymin[pid];
    if (on == 0) {
        want = false;
        to_min = false;
    }
    if (on == 1) { want = true; }
    if (on == 2) { to_min = true; }
    if (want != trayf[pid] || to_min != traymin[pid]) {
        trayf[pid] = want;
        traymin[pid] = to_min;
        tray_seq += 1;
    }
    return 0;
}

// FBIO_TILE_INFO kind 12 (SP-7): the downloads, {u32 started, u32 finished, u32 running} since boot; 0, -EFAULT.
I64 dl_info(I64 pid, U64 arg) {
    U8[64] b;
    for k in 0..64 { b[k] = 0; }
    I64 live_n = 0;
    for q in 0..64 {
        if (dlrun[q]) { live_n += 1; }
    }
    I64[3] v = [dl_started, dl_done, live_n];
    for j in 0..3 {
        for k in 0..4 { b[4 * j + k] = ((v[j] >> (8 * k)) & 255) as U8; }
    }
    if (uvm.poke(pid, arg, b, 64, true) != 64) {
        return 0 - EFAULT;
    }
    return 0;
}

// FF-6c (FF-R8 A): open_ask(path, n): a window's program asks the desk to open the file at path (1..256 bytes) as
// the Super plane opens one; the latest ask waits, the desk told by FBIO_TILE_SYNC 10 and reading it by
// FBIO_TILE_INFO kind 7. 0, -EINVAL, -EFAULT. The desk opens it only for a process that holds one of its windows.
I64 sys_open_ask(I64 pid, U64 va, U64 n) {
    if (n < 1 || n > 256) {
        return 0 - EINVAL;
    }
    if (!user_range(va, n) || uvm.peek(pid, va, open_path, n as I64) != n as I64) {
        open_len = 0;
        return 0 - EFAULT;
    }
    open_len = n as I64;
    open_from = pid;
    open_seq += 1;
    return 0;
}

// FBIO_TILE_INFO kind 7 (FF-6c), id the byte offset: {u32 vpid of the asking process, u32 the path's length, its
// bytes from the offset (56 at most)}; 1 when an ask waits, 0 for none. The chunk that holds the path's end takes it.
I64 open_info(I64 pid, I64 off, U64 arg) {
    U8[64] b;
    for k in 0..64 { b[k] = 0; }
    if (open_len == 0 || off < 0 || off >= open_len) {
        if (uvm.poke(pid, arg, b, 64, true) != 64) {
            return 0 - EFAULT;
        }
        return 0;
    }
    I64 v = 0;
    if (open_from >= 0) { v = vpid[open_from]; }
    for k in 0..4 {
        b[k] = ((v >> (8 * k)) & 0xFF) as U8;
        b[4 + k] = ((open_len >> (8 * k)) & 0xFF) as U8;
    }
    I64 c = open_len - off;
    if (c > 56) { c = 56; }
    for k in 0..c { b[8 + k] = open_path[off + k]; }
    if (uvm.poke(pid, arg, b, 64, true) != 64) {
        return 0 - EFAULT;
    }
    if (off + c >= open_len) {
        open_len = 0;
        open_from = -1;
    }
    return 1;
}

// FBIO_TILE_INFO kind 5, the tiler only: {u32 flags (bit 0 an audio device, bit 1 a network), u32 the mix's level
// 0..100, u32 the vpid of the process that opened the lowest open stream (0: none), u32 the open streams, u32 the
// network's IPv4 address (0: none), u8 its MAC[6] at 20, the player's comm[16] at 32}.
I64 panel_info(I64 pid, U64 arg) {
    U8[64] b;
    for k in 0..64 { b[k] = 0; }
    I64 fl = 0;
    if (dsp.present()) { fl = fl | 1; }
    if (net.up()) { fl = fl | 2; }
    I64 p = dsp.player();
    I64 vp = 0;
    if (p >= 0 && root[p] == root[pid] && (state[p] == READY || state[p] == WAITING)) {
        vp = vpid[p];
        for k in 0..16 { b[32 + k] = comm[p * 16 + k]; }
    }
    I64 ipa = 0;
    if (net.up()) {
        ipa = eth.our_ip();
        for k in 0..6 { b[20 + k] = net.mac_byte(k); }
    }
    I64[5] v = [fl, dsp.level_of(), vp, dsp.open_streams(), ipa];
    for j in 0..5 {
        for k in 0..4 { b[4 * j + k] = ((v[j] >> (8 * k)) & 0xFF) as U8; }
    }
    if (uvm.poke(pid, arg, b, 64, true) != 64) {
        return 0 - EFAULT;
    }
    return 0;
}

// FBIO_TILE_AUDIO (SP-1, SP-R4 B), the tiler only: the u32 at arg is the mix's level, 0 to 100 percent. 0, -EPERM,
// -EFAULT, -ENODEV (no audio device), -EINVAL.
I64 sys_tile_audio(I64 pid, U64 arg) {
    if (pid != tile.tiler_pid()) {
        return 0 - EPERM;
    }
    U8[4] b;
    if (arg >= uvm.USER_HI || uvm.peek(pid, arg, b, 4) != 4) {
        return 0 - EFAULT;
    }
    if (!dsp.present()) {
        return 0 - ENODEV;
    }
    I64 l = (b[0] as I64) | ((b[1] as I64) << 8) | ((b[2] as I64) << 16) | ((b[3] as I64) << 24);
    if (l > 100) {
        return 0 - EINVAL;
    }
    dsp.set_level(l);
    return 0;
}

// --- groups, sessions and signals (K-10, src/job.ci) ---

// rt_sigaction(sig, act, oact, sigsetsize): SIG_IGN (1) is recorded; any other handler reads back as SIG_DFL, since
// no handler frame is built. oact is {handler, flags, restorer, mask}, the handler 1 or 0 and the rest 0.
I64 sys_sigaction(I64 pid, I64 sig, U64 act, U64 oact, U64 setsize) {
    if (setsize != 8 || sig < 1 || sig > 64) {
        return 0 - EINVAL;
    }
    if (act != 0 && !job.can_ignore(sig)) {
        return 0 - EINVAL;
    }
    U64 h = 0;
    if (act != 0) {
        Bool[1] ok;
        ok[0] = true;
        h = peek_word(pid, act, ok);
        if (!ok[0]) {
            return 0 - EFAULT;
        }
    }
    if (oact != 0) {
        U64[4] w;
        for i in 0..4 {
            w[i] = 0;
        }
        if (job.ignored(pid, sig)) {
            w[0] = 1;
        }
        if (!user_range(oact, 32) || poke_words(pid, oact, w) != 32) {
            return 0 - EFAULT;
        }
    }
    if (act != 0) {
        job.set_ignored(pid, sig, h == 1);
    }
    return 0;
}

// setpgid(which, g): process which (0 itself, else itself or a child) joins group g (0: its own pid's) of its session.
// A session leader cannot move; no check that a child has exec'd (Linux's EACCES).
I64 sys_setpgid(I64 pid, I64 which, I64 g) {
    if (which < 0 || g < 0) {
        return 0 - EINVAL;
    }
    I64 t = pid;
    if (which != 0) {
        t = slot_of(pid, which);
        if (t < 0 || state[t] == ZOMBIE || (t != pid && parent[t] != pid)) {
            return 0 - ESRCH;
        }
    }
    if (job.session(t) != job.session(pid) || job.session(t) == vpid[t]) {
        return 0 - EPERM;
    }
    I64 want = g;
    if (want == 0) {
        want = vpid[t];
    }
    if (want != vpid[t] && !job.group_in(root[pid], job.session(pid), want)) {
        return 0 - EPERM;
    }
    job.set_group(t, want);
    return 0;
}

// setsid(): a new session and group named by the caller, with no terminal; -EPERM when a group of that name exists.
I64 sys_setsid(I64 pid) {
    if (job.group_used(root[pid], vpid[pid])) {
        return 0 - EPERM;
    }
    job.new_session(pid, vpid[pid]);
    return vpid[pid];
}

// getpgid(which) and getsid(which): 0 names the caller.
I64 sys_getpgid(I64 pid, I64 which, Bool sid) {
    I64 t = pid;
    if (which != 0) {
        t = slot_of(pid, which);
        if (t < 0 || !facts.sees(fs.uid_of(pid), (fs.grant_of(pid) & fs.GRANT_KERN) != 0, facts.is_parent(pid),
                                 fs.uid_of(t))) {
            return 0 - ESRCH;      // KF edition 14: a process the caller may not see is no process
        }
    }
    if (sid) {
        return job.session(t);
    }
    return job.group(t);
}

// After a system call: each signal a pty master's write raised (VINTR, VQUIT) goes to every live process of the pair's
// foreground group that does not ignore it, and ends it by its default action; TIOCSIGSESS's (WB-4) to every live
// process the pair controls, its whole session.
void tty_signals() {
    for i in 0..pty.PTYS {
        I64 m = pty.take_raised(i);
        if (m != 0) {
            I64 f = pty.session_family(i);
            I64 g = pty.foreground(i);
            for s in 0..2 {
                I64 sig = pty.SIGINT + s;
                I64 bit = 1 + s;       // bit 0 SIGINT, bit 1 SIGQUIT
                if ((m & bit) != 0) {
                    for p in 0..uvm.PROCS {
                        if ((state[p] == READY || state[p] == WAITING) && root[p] == f && job.group(p) == g &&
                            !job.ignored(p, sig)) {
                            finish(p, sig, true);
                        }
                    }
                }
            }
            I64 ss = pty.session_signal(i);
            if ((m & 4) != 0) {
                for p in 0..uvm.PROCS {
                    if ((state[p] == READY || state[p] == WAITING) && root[p] == f && job.terminal(p) == i &&
                        !job.ignored(p, ss)) {
                        finish(p, ss, true);
                    }
                }
            }
        }
    }
}

// --- processes (U1-4) ---

// The slot of the process of the running family that sees itself as vp, alive or a zombie; -1.
I64 slot_of(I64 pid, I64 vp) {
    for p in 0..uvm.PROCS {
        if (root[p] == root[pid] && vpid[p] == vp && (state[p] == READY || state[p] == WAITING || state[p] == ZOMBIE)) {
            return p;
        }
    }
    return -1;
}

// The name prctl sees: up to 15 bytes of name, then zeros (Linux's TASK_COMM_LEN 16).
void set_comm[m](I64 pid, in U8[m] name) {
    for i in 0..16 {
        comm[pid * 16 + i] = 0;
    }
    I64 k = 0;
    while (k < m && k < 15 && name[k] != 0) {
        comm[pid * 16 + k] = name[k];
        k += 1;
    }
}

// NAMES-28: set_comm, and the tiler woken (sync 6) when the name changed, so the bar names a program that writes
// nothing after its exec (Read with no file, waiting on its input).
void set_name[m](I64 pid, in U8[m] name) {
    U8[16] was;
    for i in 0..16 {
        was[i] = comm[pid * 16 + i];
    }
    set_comm(pid, name);
    for i in 0..16 {
        if (comm[pid * 16 + i] != was[i]) {
            tile.named();
            return;
        }
    }
}

// prctl(PR_SET_NAME 15, PR_GET_NAME 16): the process's comm; other options -EINVAL.
I64 sys_prctl(I64 pid, U64 op, U64 arg) {
    U8[16] b;
    if (arg >= uvm.USER_HI) {
        return 0 - EFAULT;
    }
    if (op == 15) {
        I64 got = uvm.peek(pid, arg, b, 16);
        if (got == 0) {
            return 0 - EFAULT;
        }
        for i in got..16 {
            b[i] = 0;
        }
        set_name(pid, b);
        return 0;
    }
    if (op == 16) {
        for i in 0..16 {
            b[i] = comm[pid * 16 + i];
        }
        if (uvm.poke(pid, arg, b, 16, true) != 16) {
            return 0 - EFAULT;
        }
        return 0;
    }
    return 0 - EINVAL;
}

// fork(): a child in a free child slot, a copy of the parent's memory, registers, FPU state,
// descriptors and process words; it returns 0 to the child and the child's pid to the parent.
I64 sys_fork(I64 pid) {
    I64 c = new_child(pid, false);
    if (c < 0) {
        return c;
    }
    return vpid[c];
}

// K12 (BU-4a, docs/specs/2026-11-07-bu4-toolchain.md 4.8): clone with exactly CLONE_VM | CLONE_VFORK | SIGCHLD, as
// musl's posix_spawn and busybox's vfork make it: the child runs in the parent's space (uvm.borrow, nothing copied),
// from the stack sp names with 0 in RAX, its own descriptors as fork's; the parent waits in the call (WOULD_BLOCK, the
// call made again) until the child's execve or end gives the space back, then gets the child's pid. Any other
// flags: -ENOSYS.
I64[64] vfork_child;   // 1 + the child a parent waits for in clone, or 0

I64 sys_clone(I64 pid, U64 flags, U64 sp) {
    if (vfork_child[pid] > 0) {
        I64 w = vfork_child[pid] - 1;
        if (uvm.lender_of(w) == pid + 1) {
            return fs.WOULD_BLOCK;
        }
        vfork_child[pid] = 0;
        return vpid[w];
    }
    if (flags != 0x4111 || sp == 0 || sp >= uvm.USER_HI) {
        return 0 - ENOSYS;
    }
    I64 c = new_child(pid, true);
    if (c < 0) {
        return c;
    }
    user.user_set_reg(c, user.R_RSP, sp);
    vfork_child[pid] = c + 1;
    return fs.WOULD_BLOCK;
}

// A child of pid in a free child slot with pid's registers (RAX 0), FPU state, descriptors and process words,
// running in a copy of pid's memory, or in pid's own (share, K12). Its slot, or -EAGAIN, -ENOMEM.
I64 new_child(I64 pid, Bool share) {
    I64 c = -1;
    for p in CHILD_LO..uvm.PROCS {
        if (c < 0 && state[p] == FREE) {
            c = p;
        }
    }
    if (c < 0) {
        return 0 - EAGAIN;
    }
    if (share) {
        uvm.borrow(pid, c);
    } else if (uvm.clone(pid, c) < 0) {
        return 0 - ENOMEM;
    }
    user.user_copy(pid, c);
    user.user_set_reg(c, user.R_RAX, 0);
    fs.proc_clone(pid, c);
    tile.clone(pid, c);
    for i in 0..16 {
        comm[c * 16 + i] = comm[pid * 16 + i];
    }
    exec_at[c] = exec_at[pid];
    job.clone(pid, c);
    for i in 0..32 {
        exe[c * 32 + i] = exe[pid * 32 + i];
    }
    exelen[c] = exelen[pid];
    exe_ino[c] = exe_ino[pid];
    brk_base[c] = brk_base[pid];
    brk_now[c] = brk_now[pid];
    mmap_next[c] = mmap_next[pid];
    sres_va[c] = sres_va[pid];
    sres_len[c] = sres_len[pid];
    clock[c] = clock[pid];
    zero_at[c] = zero_at[pid];
    began[c] = stamp_s();
    poll_wait[c] = 0;
    poll_spent[c] = false;
    sleep_until[c] = 0;
    capture[c] = false;
    caplen[c] = 0;
    out_owner[c] = out_owner[pid];
    parent[c] = pid;
    if (pid == tile.tiler_pid()) {
        windows += 1;                  // GV-1a: the desk's child starts a window
        window[c] = windows;
    } else {
        window[c] = window[pid];
    }
    cool_end[c] = cool_end[pid];       // AC-D4: a cooled tree's child is cooled with it (the desk is never cooled)
    root[c] = root[pid];
    ticks[c] = 0;
    facts.tick_fresh(c);               // KF-R1: a child's CPU time begins at 0
    facts.role_fork(c, pid);           // DN-69 item 5: a Parent's child is a Parent's
    forks[c] = 0;
    vpid[c] = family_next;
    family_next += 1;
    trayf[c] = trayf[pid];         // SP-2: a resident program's children stay in its tray
    traymin[c] = traymin[pid];     // SP-6: and keep its minimize to the tray
    forks[pid] += 1;
    state[c] = READY;
    return c;
}


// Copies the NULL-ended vector of strings at vec in pid's memory (none when vec is 0) into
// head from got[1] on, counting them in got[0]: 0, -EFAULT, or -E2BIG past 96 strings, a string
// of ARG_STR bytes or more, or ARG_BYTES in all.
I64 take_strings(I64 pid, U64 vec, inout I64[2] got) {
    Bool[1] ok;
    ok[0] = true;
    I64 i = 0;
    while (true) {
        U64 sp = 0;
        if (vec != 0) {
            sp = peek_word(pid, vec + (8 * i) as U64, ok);
        }
        if (!ok[0]) {
            return 0 - EFAULT;
        }
        if (sp == 0) {
            return 0;
        }
        if (got[0] >= 96) {
            return 0 - E2BIG;
        }
        I64 want = ARG_BYTES - got[1];
        if (want > ARG_STR) {
            want = ARG_STR;
        }
        if (want <= 0) {
            return 0 - E2BIG;
        }
        I64 n = uvm.peek(pid, sp, head[got[1]..got[1] + want], want);
        I64 slen = 0;
        while (slen < n && head[got[1] + slen] != 0) {
            slen += 1;
        }
        if (slen == n) {
            if (n < want) {
                return 0 - EFAULT;
            }
            return 0 - E2BIG;
        }
        got[1] += slen + 1;
        got[0] += 1;
        i += 1;
    }
    return 0;
}

// execve(path, argv, envp): the program at path (an image member, walked from the working
// directory, src/fs.ci) replaces this one, with argv and envp (up to 96 strings and 8,192
// bytes together, FS-4; CT-5b passes envp, which was empty before). Descriptors stay but
// for FD_CLOEXEC ones; the pid the process sees stays. 0, -ENOENT with the old program intact,
// or -ESRCH when the new one could not be loaded after the old was torn down.
I64 sys_execve(I64 pid, U64 path, U64 argv, U64 envp) {
    U8[32] nm;
    U8[16] raw;
    I64 k = 0;
    I64 xi = 0;                        // K13: the volume inode of the program, 0 for an image member
    Bool self = false;
    if (path < uvm.USER_HI && uvm.peek(pid, path, raw, 15) == 15) {
        self = same_text(raw, "/proc/self/exe");
    }
    if (self) {
        // the image this process runs, under the name Linux gives the comm
        k = exelen[pid];
        for i in 0..k {
            nm[i] = exe[pid * 32 + i];
        }
        xi = exe_ino[pid];
    } else {
        k = fs.exec_name(pid, path, nm);
        if (k < 0) {
            return k;
        }
        xi = fs.exec_ino();
    }
    I64 c = exec_check(nm[0..k], xi);
    if (c < 0) {
        return c;
    }
    I64[2] got;                        // strings taken, bytes taken
    got[0] = 0;
    got[1] = 0;
    I64 r = take_strings(pid, argv, got);
    if (r < 0) {
        return r;
    }
    if (got[0] == 0) {
        for i in 0..k {
            head[i] = nm[i];
        }
        head[k] = 0;
        got[0] = 1;
        got[1] = k + 1;
    }
    I64 argc = got[0];
    r = take_strings(pid, envp, got);
    if (r < 0) {
        return r;
    }
    I64 envc = got[0] - argc;
    I64 argn = got[1];
    tile.end(pid, false);
    user.fb_present();
    uvm.destroy(pid);
    fs.proc_exec(pid);
    pending_ino = xi;
    if (load(pid, nm[0..k], argc, envc, argn) < 0) {
        uvm.destroy(pid);
        return 0 - ESRCH;
    }
    if (self) {
        set_name(pid, "exe");
    } else if (xi > 0) {
        I64 base = 0;                  // K13: a volume program's comm is its file's name, the path's last part
        for i in 0..k {
            if (nm[i] == 47) {
                base = i + 1;
            }
        }
        set_name(pid, nm[base..k]);
    } else {
        set_name(pid, nm[0..k]);
    }
    execs += 1;
    exec_at[pid] = execs;
    return 0;
}

// BU-4f: true when path (a process address) names /proc/self/exe.
Bool is_self_exe(I64 pid, U64 path) {
    U8[16] raw;
    return path < uvm.USER_HI && uvm.peek(pid, path, raw, 15) == 15 && same_text(raw, "/proc/self/exe");
}

// BU-4f: readlink of /proc/self/exe: the absolute path of the program the process runs, `/` and the image member's
// name, or the volume path K13 loaded it from (which starts with `/`), cut at n bytes as Linux cuts it; its
// length, -EINVAL for n 0 or past 2^31, -EFAULT for a buffer the process cannot write.
I64 self_exe(I64 pid, U64 buf, U64 n) {
    if (n == 0 || n > 0x7FFFFFFF) {
        return 0 - EINVAL;
    }
    U8[33] t;
    I64 k = exelen[pid];
    I64 tl = 0;
    if (k == 0 || exe[pid * 32] != 47) {
        t[0] = 47;
        tl = 1;
    }
    for i in 0..k {
        t[tl + i] = exe[pid * 32 + i];
    }
    tl += k;
    if (tl > (n as I64)) {
        tl = n as I64;
    }
    if (buf >= uvm.USER_HI || uvm.poke(pid, buf, t, tl, true) != tl) {
        return 0 - EFAULT;
    }
    return tl;
}

// True when the first m bytes of b are s and the byte after is 0.
Bool same_text[m](in U8[16] b, in U8[m] s) {
    if (m >= 16) {
        return false;
    }
    for i in 0..m {
        if (b[i] != s[i]) {
            return false;
        }
    }
    return b[m] == 0;
}

// wait4(pid, status, options, rusage): reaps a zombie child (any with -1), writing its status
// as Linux packs it; WNOHANG (1) gives 0 instead of waiting; -ECHILD with no child to wait for. A rusage gets its
// 144 bytes, all 0 but ru_maxrss (BU-4h2): the child's peak of frames since its last execve, in KiB.
I64 sys_wait4(I64 pid, I64 which, U64 status, U64 options, U64 rusage) {
    Bool have = false;
    I64 z = -1;
    for p in CHILD_LO..uvm.PROCS {
        if (parent[p] == pid && (which == -1 || vpid[p] == which)) {
            if (state[p] == READY || state[p] == WAITING) {
                have = true;
            }
            if (z < 0 && state[p] == ZOMBIE) {
                z = p;
            }
        }
    }
    if (z < 0) {
        if (!have) {
            return 0 - ECHILD;
        }
        if ((options & 1) != 0) {
            return 0;
        }
        return fs.WOULD_BLOCK;
    }
    U64 st = (code[z] as U64) << 8;
    if (signaled[z]) {
        st = code[z] as U64;
    }
    if (status != 0) {
        U8[4] b;
        for j in 0..4 {
            b[j] = ((st >> ((8 * j) as U64)) & 0xFF) as U8;
        }
        if (status >= uvm.USER_HI || uvm.poke(pid, status, b, 4, true) != 4) {
            return 0 - EFAULT;
        }
    }
    if (rusage != 0) {
        U8[144] ru;
        for j in 0..144 {
            ru[j] = 0;
        }
        U64 kib = (uvm.frames_peak(z) * 4) as U64;
        for j in 0..8 {
            ru[32 + j] = ((kib >> ((8 * j) as U64)) & 0xFF) as U8;
        }
        if (rusage >= uvm.USER_HI || uvm.poke(pid, rusage, ru, 144, true) != 144) {
            return 0 - EFAULT;
        }
    }
    I64 vp = vpid[z];
    state[z] = FREE;
    return vp;
}

// --- the canonical state (docs/user.md) ---

// The head of the digest (edition 6, unchanged in edition 7; edition 9, FS-4: the descriptors): the tag 0x54, the 15
// general registers, RIP, RSP, the
// RFLAGS a process may set, the FS base, the break base, the break and the clock (u64 each), then
// the FPU state that is the process's: FCW, FSW, the abridged FTW, MXCSR, ST0 to ST7 (10 bytes
// each) and XMM0 to XMM15; the open descriptors (fs.digest_fds, edition 9, FS-4); the working directory (fs.digest_cwd:
// its filesystem u8 and inode u64); the grant word (u64, P-3); the surface (W-2,
// tile.state: its kind u8, w, h and stride u32, the tile input queue's length u8); the comm (16 bytes); the
// sockets (fs.digest_socks, N-2: 24 bytes for each descriptor that holds one, none for a process without); the
// ring of the volume's changes (fs.digest_ring, edition 8, FF-1: 17 bytes for a process that holds /dev/fsidx, none
// for a process without).
// The pages follow in uvm.state_digest, the dead stack as zeros (edition 7, W-4): the bytes of the 128 KiB stack
// below RSP and the 128 bytes of the red zone under it.
void digest_now(I64 pid) {
    head[0] = 0x54;
    U64[22] regs;
    for i in 0..15 {
        regs[i] = user.user_reg(pid, i);
    }
    regs[15] = user.user_reg(pid, user.R_RIP);
    regs[16] = user.user_reg(pid, user.R_RSP);
    regs[17] = user.user_reg(pid, user.R_RFLAGS) & 0x0CD5;
    regs[18] = user.user_reg(pid, user.R_FS);
    regs[19] = brk_base[pid];
    regs[20] = brk_now[pid];
    regs[21] = clock[pid];
    for i in 0..22 {
        for k in 0..8 {
            head[1 + 8 * i + k] = ((regs[i] >> ((8 * k) as U64)) & 0xFF) as U8;
        }
    }
    U8[512] raw;
    for i in 0..64 {
        U64 v = user.user_fx(pid, i);
        for k in 0..8 {
            raw[8 * i + k] = ((v >> ((8 * k) as U64)) & 0xFF) as U8;
        }
    }
    I64 at = 177;
    for k in 0..5 {
        head[at] = raw[k];
        at += 1;
    }
    for k in 24..28 {
        head[at] = raw[k];
        at += 1;
    }
    for i in 0..8 {
        for k in 0..10 {
            head[at] = raw[32 + 16 * i + k];
            at += 1;
        }
    }
    for k in 160..416 {
        head[at] = raw[k];
        at += 1;
    }
    I64 nfd = fs.digest_fds(pid, head[at..at + 5122]);
    at += nfd;
    U8[9] wd;
    fs.digest_cwd(pid, wd);
    for k in 0..9 {
        head[at] = wd[k];
        at += 1;
    }
    U64 gw = fs.grant_of(pid);
    for k in 0..8 {
        head[at] = ((gw >> ((8 * k) as U64)) & 0xFF) as U8;   // the grant word
        at += 1;
    }
    U8[14] sf;
    tile.state(pid, sf);
    for k in 0..14 {
        head[at] = sf[k];
        at += 1;
    }
    for k in 0..16 {
        head[at] = comm[pid * 16 + k];
        at += 1;
    }
    I64 nsk = fs.digest_socks(pid, head[at..at + 6144]);
    at += nsk;
    I64 nrg = fs.digest_ring(pid, head[at..at + 17]);
    at += nrg;
    U8[32] d;
    U64 dlo = STACK_TOP - STACK_BYTES;     // the dead stack: below the stack pointer and its 128-byte red zone
    U64 dhi = dlo;
    if (regs[16] > dlo + 128 && regs[16] <= STACK_TOP) {
        dhi = regs[16] - 128;
    }
    uvm.state_digest(pid, head[0..at], dlo, dhi, d);
    for i in 0..32 {
        digests[32 * pid + i] = d[i];
    }
}

void put_state(I64 pid) {
    serial.serial_write("daphnis: state ");
    for i in 0..32 {
        U8 b = digests[32 * pid + i];
        serial.serial_putc(text.hex_digit(b >> 4));
        serial.serial_putc(text.hex_digit(b));
    }
    serial.serial_write("\n");
}

// True when processes a and b ended in the same canonical state.
export Bool same_state(I64 a, I64 b) {
    Bool same = true;
    for i in 0..32 {
        if (digests[32 * a + i] != digests[32 * b + i]) {
            same = false;
        }
    }
    return same;
}

void finish(I64 pid, I64 c, Bool sig) {
    sleep_until[pid] = 0;              // RS-SLEEP: a sleeper ended (a signal) leaves no parked sleep for the slot
    // K12: a child still running in this process's space ends first; the space goes with this process
    for ch in CHILD_LO..uvm.PROCS {
        if (uvm.lender_of(ch) == pid + 1 && (state[ch] == READY || state[ch] == WAITING)) {
            finish(ch, 9, true);
        }
    }
    vfork_child[pid] = 0;
    digest_now(pid);
    code[pid] = c;
    signaled[pid] = sig;
    if (focus_p == pid) {
        focus_p = -1;                  // SCHED-1: the slot may be another process's next
    }
    tile.end(pid, true);
    user.fb_present();
    uvm.destroy(pid);
    kern_forget(pid);
    fs.proc_close_all(pid);
    job.end(pid);
    if (job.session(pid) == vpid[pid]) {
        pty.session_ended(root[pid], vpid[pid]);   // K-10: the leader's terminal has no session now
    }
    for ch in CHILD_LO..uvm.PROCS {
        if (parent[ch] == pid) {
            parent[ch] = -1;           // orphaned: nobody will wait
            if (state[ch] == ZOMBIE) {
                state[ch] = FREE;
            }
        }
    }
    I64 pa = parent[pid];
    if (pa >= 0 && (state[pa] == READY || state[pa] == WAITING)) {
        state[pid] = ZOMBIE;
    } else if (pid >= CHILD_LO) {
        state[pid] = FREE;
    } else {
        state[pid] = DONE;
        if (!capture[pid]) {
            print_end(pid);
        }
    }
}

// FF-4 (docs/specs/2026-11-07-ff-super-plane.md section 3, the actions): reboot(2), the desk's Shut down and
// Restart. Linux's two magic words, then LINUX_REBOOT_CMD_POWER_OFF or _HALT (shut down) or _RESTART; the tiler
// alone may ask (-EPERM for any other process). Every other process ends as SIGKILL ends it, then the caller with
// status 0, and the flavor's main ends the machine by ending(): the exit port as today (HW-2 adds S5), or a reset
// through the 8042 for a restart. 0 when it took (the caller has ended), else -errno.
I64 ending_cmd = 0;

export I64 ending() {
    return ending_cmd;
}

I64 sys_reboot(I64 pid, U64 m1, U64 m2, U64 cmd) {
    if (m1 != 0xFEE1DEAD || (m2 != 672274793 && m2 != 85072278 && m2 != 369367448 && m2 != 537993216)) {
        return 0 - EINVAL;
    }
    I64 c = 0;
    if (cmd == 0x4321FEDC || cmd == 0xCDEF0123) {
        c = 1;
    } else if (cmd == 0x01234567) {
        c = 2;
    } else {
        return 0 - EINVAL;
    }
    if (tile.tiler_pid() != pid) {
        return 0 - EPERM;
    }
    ending_cmd = c;
    for p in 0..uvm.PROCS {
        if (p != pid && (state[p] == READY || state[p] == WAITING)) {
            finish(p, 9, true);
        }
    }
    finish(pid, 0, false);
    return 0;
}

void print_end(I64 pid) {
    put_state(pid);
    if (signaled[pid]) {
        serial.serial_write("daphnis: signal ");
    } else {
        serial.serial_write("daphnis: exit ");
    }
    put_dec(code[pid]);
    serial.serial_write("\n");
    if (forks[pid] > 0) {
        serial.serial_write("daphnis: pid ");
        put_dec(pid);
        serial.serial_write(" forked ");
        put_dec(forks[pid]);
        serial.serial_write("\n");
    }
}

// The signal Linux sends for an exception in ring 3.
I64 signal_of(U64 vector) {
    I64 s = 11;
    if (vector == 0 || vector == 16 || vector == 19) {
        s = 8;
    }
    if (vector == 6) {
        s = 4;
    }
    if (vector == 1 || vector == 3) {
        s = 5;
    }
    if (vector == 17) {
        s = 7;
    }
    return s;
}

void fault(I64 pid) {
    U64 v = user.user_reg(pid, user.E_VECTOR);
    if (v == 14 && (user.user_reg(pid, user.E_ERROR) & 1) == 0) {
        // M-2: a not-present page that is a promise gets its frame and the process goes on, nothing printed
        if (uvm.back(pid, user.user_reg(pid, user.E_ADDR) & 0xFFFFFFFFFFFFF000) == 0) {
            return;
        }
    }
    serial.serial_write("daphnis: fault vector ");
    put_dec(v as I64);
    serial.serial_write(" error ");
    put_hex(user.user_reg(pid, user.E_ERROR));
    serial.serial_write(" addr ");
    put_hex(user.user_reg(pid, user.E_ADDR));
    serial.serial_write(" rip ");
    put_hex(user.user_reg(pid, user.R_RIP));
    serial.serial_write("\n");
    finish(pid, signal_of(v), true);
}

// --- running ---

// The pid a process sees (getpid, set_tid_address) is vp: 1 for a process run alone, its number
// from 1 among processes started together. The slot pid is the kernel's, so a program's state
// does not depend on what ran before it (stage R: a sealed process sees pid 1).
// Arguments after argv[0] for the next start (R-2d: `doom --sealed`), each with its NUL; start takes and
// clears them.
U8[64] next_args;
I64 next_argc;
I64 next_argn;

export void push_arg[m](in U8[m] s) {
    if (next_argn + m + 1 > 64) {
        serial.serial_write("daphnis: arguments over 64 bytes, one dropped\n");
        return;
    }
    for i in 0..m {
        next_args[next_argn + i] = s[i];
    }
    next_args[next_argn + m] = 0;
    next_argn = next_argn + m + 1;
    next_argc = next_argc + 1;
}

Bool start[m](I64 pid, in U8[m] name, Bool cap_out, I64 vp) {
    return start_as(pid, name, name, cap_out, vp);
}

// start, with argv[0] and the comm `name` and the executable `exename` (K13: a volume program's path, which
// load records for /proc/self/exe; pending_ino names its inode).
Bool start_as[m, q](I64 pid, in U8[m] name, in U8[q] exename, Bool cap_out, I64 vp) {
    state[pid] = FREE;
    vpid[pid] = vp;
    set_comm(pid, name);
    ticks[pid] = 0;
    facts.tick_fresh(pid);             // KF-R1
    facts.set_parent(pid, false);      // DN-69 item 5: a process the kernel starts is no account's
    caplen[pid] = 0;
    capture[pid] = cap_out;
    parent[pid] = -1;
    root[pid] = pid;
    out_owner[pid] = pid;
    forks[pid] = 0;
    job.start(pid, pid, vp);
    tile.reset(pid);
    if (vp + 1 > family_next || vp == 1) {
        family_next = vp + 1;
    }
    for i in 0..96 {
        head[i] = 0;                   // the strings load reads (the front of the digest's head, as execve's)
    }
    for i in 0..m {
        head[i] = name[i];
    }
    for i in 0..next_argn {
        head[m + 1 + i] = next_args[i];
    }
    I64 argc = 1 + next_argc;
    I64 argn = m + 1 + next_argn;
    next_argc = 0;
    next_argn = 0;
    began[pid] = stamp_s();            // KF-3b, RS-CLK2: a process the kernel starts begins at the stamp time (at boot,
                                       // the boot's base)
    window[pid] = 0;                   // GV-1a: and belongs to no window
    I64 r = load(pid, exename, argc, 0, argn);
    if (r < 0) {
        uvm.destroy(pid);
        serial.serial_write("daphnis: cannot run ");
        put_name(exename);
        serial.serial_write(": step ");
        put_dec(0 - r);
        serial.serial_write("\n");
        return false;
    }
    fs.proc_init(pid);
    state[pid] = READY;
    return true;
}

// With nothing ready, what the scheduler waits for, into o: o[0] the process it halts for, the first that waits for
// the device and is not a parked sleep, else the first parked sleep (RS-SLEEP), else -1; o[1] the first that waits
// on no device (a deadlock when o[0] is -1), else -1.
void halt_for(inout I64[2] o) {
    o[0] = -1;
    o[1] = -1;
    I64 slp = -1;
    for p in 0..uvm.PROCS {
        if (state[p] == WAITING) {
            if (on_device[p] && sleep_until[p] != 0) {
                if (slp < 0) {
                    slp = p;
                }
            } else if (on_device[p]) {
                if (o[0] < 0) {
                    o[0] = p;
                }
            } else if (o[1] < 0) {
                o[1] = p;
            }
        }
    }
    if (o[0] < 0) {
        o[0] = slp;
    }
}

// Whether to halt once more for dev after waited halts: the tiler (the session, W-4) and a parked sleep (RS-SLEEP,
// which the PIT ends) without limit, any other device wait up to WAIT_MAX.
Bool halt_ok(I64 dev, I64 waited) {
    return sleep_until[dev] != 0 || waited < WAIT_MAX || dev == tile.tiler_pid();
}

// Runs the ready processes lo..=hi round robin until none is ready. A process keeps the CPU
// across its system calls; the timer moves it to the back.
// Runs every ready process round robin until none is ready and none waits. A process keeps
// the CPU across its system calls; the timer moves it to the back. A process in a call that
// must wait (wait4, a pipe) is retried before each pick; if nothing is ready and the waiting
// ones can never be answered, they end with SIGKILL and the transcript says so. A process waiting
// for the input device (F-2) can be answered by the hardware: the kernel halts until an interrupt
// and tries again, up to WAIT_MAX halts, then ends it with SIGKILL and says so; the tiler, which is the
// session, waits without that limit (W-4), as does a parked sleep (RS-SLEEP).
// SCHED-1 (docs/specs/2026-11-07-ds-desk-speed.md section 3): when a turn
// ends at the timer, an input interrupt or a wait, a ready process of the desk class (desk()) is picked before the
// rest, and after DESK_RUN desk turns in a row that an interrupt ended, the rest get one pick; with no tiler the
// class is empty and the pick is the plain round robin.
void run(I64 lo, I64 hi) {
    I64 cur = lo;
    I64 ring_cur = lo;
    Bool any = true;
    I64 waited = 0;
    while (any) {
        dsp.pump();                    // AU-3: the device ring kept ahead of the controller, every turn
        xhci.poll();                   // HW-4: the USB reports, every turn: a timed poll that is always due (the desk's
                                       // clock) otherwise keeps the scheduler off the tick and device-wait paths
        for p in 0..uvm.PROCS {
            if (state[p] == WAITING) {
                syscall(p);
                tty_signals();
            }
        }
        I64 pick = -1;                 // SCHED-1: a process keeps the CPU across its system calls, as before;
        I64 ring = -1;                 // at any other pick the first ready desk-class process in ring order runs
        if (keep && state[cur] == READY) {   // before the rest, and after DESK_RUN desk turns in a row that an
            pick = cur;                // interrupt ended, one of the rest
        } else {
            Bool cls = tile.tiler_pid() >= 0;   // no tiler, no class: the plain round robin, at its old cost
            for k in 0..uvm.PROCS {
                I64 p = (cur + k) % uvm.PROCS;
                if (state[p] == READY) {
                    if (cls && desk(p)) {
                        if (pick < 0) {
                            pick = p;
                        }
                    } else if (ring < 0) {
                        ring = p;
                    }
                }
            }
            if (cls) {
                // Desk picks keep their cursor; background turns advance independently.
                ring = -1;
                for k in 0..uvm.PROCS {
                    I64 p = (ring_cur + k) % uvm.PROCS;
                    if (ring < 0 && state[p] == READY && !desk(p)) { ring = p; }
                }
            }
            if (ring >= 0 && (pick < 0 || desk_run >= DESK_RUN)) {
                if (pick >= 0) {
                    desk_run = 0;
                }
                pick = ring;
                if (cls) { ring_cur = (ring + 1) % uvm.PROCS; }
            }
        }
        keep = false;
        I64 due = -1;                  // E-1: with nothing ready, a parked timed poll expires before any halt;
        Bool devw = false;             // a spent one only when no process waits for a device
        I64 spent = -1;
        for p in 0..uvm.PROCS {
            if (pick < 0 && state[p] == WAITING) {
                if (due < 0 && poll_wait[p] == 1) {
                    due = p;
                }
                if (spent < 0 && poll_wait[p] == 3) {
                    spent = p;
                }
                devw = devw || on_device[p];
            }
        }
        if (due < 0 && !devw) {
            due = spent;
        }
        if (due >= 0) {
            poll_wait[due] = 2;
        } else if (pick < 0) {
            I64[2] hw;
            halt_for(hw);
            I64 dev = hw[0];
            I64 stuck = hw[1];
            Bool slept = dev >= 0 && sleep_until[dev] != 0;   // only sleepers wait: never toward WAIT_MAX
            if (dev >= 0) {
                if (halt_ok(dev, waited)) {
                    facts.tick_mark(trap.timer_ticks());   // KF-R1: ticks that come in the wait are idle time
                    Bool woke = udp.wait();    // NW-1: spin when TCP is open; unmask NIC IRQ across halt; count timer wakes
                    facts.tick_idle(trap.timer_ticks());
                    if (woke && !slept) {
                        waited += 1;           // W-4: the tiler is the session (the desk): it waits without limit
                    }
                    xhci.poll();       // HW-4: the USB keyboard's reports, at each wake
                    udp.pump();        // a network tick (N-3): only here, where every process is blocked
                } else {
                    serial.serial_write("daphnis: input timeout: pid ");
                    put_dec(dev);
                    serial.serial_write(" waited for the device\n");
                    finish(dev, 9, true);
                }
            } else if (stuck < 0) {
                any = false;
            } else {
                serial.serial_write("daphnis: deadlock: pid ");
                put_dec(stuck);
                serial.serial_write(" waits for what cannot come\n");
                finish(stuck, 9, true);
            }
        } else {
            waited = 0;
            cur = pick;
            facts.tick_mark(trap.timer_ticks());               // KF-R1: ticks that come in the turn are pick's
            I64 why = user.user_enter(pick, uvm.root(pick));
            facts.tick_ran(pick, trap.timer_ticks());
            if (why == user.TURN_SYSCALL) {
                syscall(pick);
                tty_signals();
                keep = true;
            } else if (why == user.TURN_FAULT) {
                fault(pick);
                if (state[pick] == READY) { keep = true; }
            } else if (why == user.TURN_TICK) {
                ticks[pick] += 1;
                xhci.poll();                   // HW-4: at the scheduler's tick, as a frame enters the record
                if (tile.tiler_pid() >= 0 && desk(pick)) {
                    desk_run += 1;
                }
                cur = (pick + 1) % uvm.PROCS;
            } else {
                serial.serial_write("daphnis: user_enter refused\n");
                finish(pick, 0, true);
            }
        }
    }
}

void put_run[m](I64 pid, in U8[m] name) {
    serial.serial_write("daphnis: run ");
    put_name(name);
    for i in 0..next_argn {
        if (next_args[i] == 0) {
            if (i + 1 < next_argn) {
                serial.serial_putc(32);
            }
        } else {
            if (i == 0) {
                serial.serial_putc(32);
            }
            serial.serial_putc(next_args[i]);
        }
    }
    serial.serial_write(" pid ");
    put_dec(pid);
}

// Runs one program alone, its output live.
export void run_alone[m](I64 pid, in U8[m] name) {
    put_run(pid, name);
    serial.serial_write("\n");
    if (start(pid, name, false, 1)) {
        run(pid, pid);
    }
}

// K13 (BU-4e): runs the volume's program at rel (a path from the volume's root) alone, as run_alone runs an
// image member: argv[0] and the comm are its file's name, /proc/self/exe its path. Nothing is printed or run
// when the volume has no such file.
export void run_volume[m](I64 pid, in U8[m] rel) {
    U8[32] nm;
    I64 k = fs.vol_exec(rel, nm);
    if (k <= 0) {
        return;
    }
    I64 base = 0;
    for i in 0..k {
        if (nm[i] == 47) {
            base = i + 1;
        }
    }
    put_run(pid, nm[0..k]);
    serial.serial_write("\n");
    pending_ino = fs.exec_ino();
    if (start_as(pid, nm[base..k], nm[0..k], false, 1)) {
        run(pid, pid);
    }
    pending_ino = 0;
}

// True when the volume holds a regular file at rel (a path from its root).
export Bool on_volume[m](in U8[m] rel) {
    U8[32] nm;
    return fs.vol_exec(rel, nm) > 0;
}

// Runs one program that draws on the surface (F-1), alone, its output live; the block is marked
// so the Linux oracle skips it (tools/check-user.py). The surface digest is printed by the caller.
export void run_device[m](I64 pid, in U8[m] name) {
    put_run(pid, name);
    serial.serial_write(" (device)\n");
    if (start(pid, name, false, 1)) {
        run(pid, pid);
    }
}

// FS-3: run_device for a desk: the process starts in the home with the disk grant (fs.home) when a volume is
// mounted, and says so.
export void run_desk[m](I64 pid, in U8[m] name) {
    put_run(pid, name);
    serial.serial_write(" (device)\n");
    if (start(pid, name, false, 1)) {
        if (fs.home(pid)) {
            serial.serial_write("daphnis: the desk starts in /home");
            if (fs.held(pid, fs.GRANT_DISK)) {
                serial.serial_write(", the disk grant held");
            }
            serial.serial_write("\n");
        }
        run(pid, pid);
    }
}

// The 1-bit canary: runs `name` alone with bit 0 of register `reg` flipped before its first
// instruction. Its end state must desync from a clean run; if it did not, the digest would not
// be seeing that register.
export void run_canary[m](I64 pid, in U8[m] name, I64 reg) {
    put_run(pid, name);
    serial.serial_write(" canary: bit 0 of register ");
    put_dec(reg);
    serial.serial_write(" flipped\n");
    if (start(pid, name, false, 1)) {
        user.user_set_reg(pid, reg, user.user_reg(pid, reg) ^ 1);
        run(pid, pid);
    }
}

// The FPU canary: bit 0 of MXCSR (the sticky invalid-operation flag) flipped before the first
// instruction. Nothing a program does clears it, so the end state must desync.
export void run_fx_canary[m](I64 pid, in U8[m] name) {
    put_run(pid, name);
    serial.serial_write(" canary: bit 0 of MXCSR flipped\n");
    if (start(pid, name, false, 1)) {
        user.user_set_fx(pid, user.FX_MXCSR, user.user_fx(pid, user.FX_MXCSR) ^ 1);
        run(pid, pid);
    }
}

// Loads `name` as pid with its output held, for a run with others under the timer; the process
// sees itself as pid vp.
export void start_held[m](I64 pid, in U8[m] name, I64 vp) {
    Bool ok = start(pid, name, true, vp);
    if (!ok) {
        state[pid] = FREE;
    }
}

// Runs lo..=hi together under the timer until every one has ended.
export void run_range(I64 lo, I64 hi) {
    run(lo, hi);
}

// Prints a held process's block as if it had run alone: its output, its state and its end.
export void print_held[m](I64 pid, in U8[m] name) {
    put_run(pid, name);
    serial.serial_write("\n");
    for i in 0..caplen[pid] {
        serial.serial_putc(cap[pid * CAP + i]);
    }
    print_end(pid);
}

// Whether the timer ended at least one of pid's turns.
export void print_preempted(I64 pid) {
    serial.serial_write("daphnis: pid ");
    put_dec(pid);
    if (ticks[pid] > 0) {
        serial.serial_write(" preempted yes\n");
    } else {
        serial.serial_write(" preempted no\n");
    }
}

// Runs `name` as `copies` processes from pid lo on, together under the timer; then prints each
// one's output and end in pid order, and whether the timer ended at least one of its turns.
export void run_together[m](I64 lo, I64 copies, in U8[m] name) {
    I64 hi = lo + copies - 1;
    serial.serial_write("daphnis: together ");
    put_name(name);
    serial.serial_write(" pids ");
    put_dec(lo);
    serial.serial_write(" to ");
    put_dec(hi);
    serial.serial_write("\n");
    for p in lo..hi + 1 {
        start_held(p, name, p - lo + 1);
    }
    run(lo, hi);
    for p in lo..hi + 1 {
        print_held(p, name);
    }
    for p in lo..hi + 1 {
        print_preempted(p);
    }
}

// Every frame back once processes end, except the named filesystem tables and lifetime display backing.
// Display ownership is counted only on successful allocator-to-display transfer, never inferred from a gap.
// The pool's frames are the RAM
// less the frame bitmap's own (FB), which are never handed out.
export void report_pool() {
    if (user.fb_held_frames() != 0) {
        serial.serial_write("daphnis: display backing ");
        put_dec(user.fb_held_frames());
        serial.serial_write(" frames held\n");
    }
    serial.serial_write("daphnis: fs tables ");
    put_dec(fs.table_frames());
    serial.serial_write(" frames held\n");
    serial.serial_write("daphnis: pool frames free ");
    put_dec(frames.free_count());
    serial.serial_write(" of ");
    put_dec(frames.ram() - frames.bitmap_frames());
    serial.serial_write("\n");
}

// Takes a run of n frames from the pool and keeps it: the ballast of the placement test (a
// program run again with it held gets other frames for its tables and pages). The first frame,
// or a negative frames status.
export I64 hold_frames(I64 n) {
    return frames.alloc(n);
}

export void release_frames(I64 first, I64 n) {
    if (first < 0 || frames.release(first, n) < 0) {
        serial.serial_write("daphnis: ballast not returned\n");
    }
}
