// src/main_desk.ci: W-4, the desk (docs/specs/2026-11-05-w-tiler.md sections 2 and 5). The user flavor's kernel
// with another main: after boot the tiler is the first process, in desk mode, on a grid of 1 x 2
// tiles: busybox sh on a pty in tile 0,0's terminal, and tile 1 for the first program that opens /dev/fb0 (doom
// --sealed, started from the shell). check-tiler.sh types the session through the QEMU monitor; the desk ends
// when the shell does, and the kernel prints the screen's digest.

import src.serial;
import src.fs;
import src.cpu;
import src.pit;
import src.user;
import src.proc;
import src.pool;
import src.surface;
import src.input;
import src.tile;
import src.dsp;


void main() {
    serial.serial_write("Daphnis W: the desk\n");
    cpu.tss_install();
    cpu.idt_install_ist();
    _ = pool.init();          // M-3: the pool from the memory map under daphnis.pool=max; the gates' pool otherwise
    user.user_init();
    fs.init();
    if (user.fb_init() > 0) {
        fs.set_fb(user.fb_word(0) as I64, user.fb_word(1) as I64, user.fb_word(2) as I64);
        serial.serial_write("daphnis: framebuffer ");
        proc.put_dec(user.fb_word(0) as I64);
        serial.serial_write("x");
        proc.put_dec(user.fb_word(1) as I64);
        serial.serial_write(" stride ");
        proc.put_dec(user.fb_word(2) as I64);
        serial.serial_write("\n");
    } else {
        serial.serial_write("daphnis: no framebuffer\n");
    }
    pit.pic_remap();
    pit.pit_start(11932);
    _ = dsp.init();           // AU-3: /dev/dsp when an HDA controller is there; nothing said when none is
    if (input.devices_on()) {
        serial.serial_write("daphnis: keyboard and mouse on\n");
    } else {
        serial.serial_write("daphnis: keyboard on, no mouse\n");
    }
    fs.set_input(true);
    serial.serial_write("daphnis: image ");
    proc.put_dec(user.initrd_size());
    serial.serial_write(" bytes from the loader module\n");
    serial.serial_write("daphnis: desk\n");
    proc.push_arg("--cols");
    proc.push_arg("1");
    proc.push_arg("--rows");
    proc.push_arg("2");
    proc.push_arg("--desk");
    proc.run_device(1, "tiler");
    surface.print();
    if (input.dropped() != 0 || tile.dropped() != 0) {
        serial.serial_write("daphnis: input dropped\n");
        input.say_dropped(tile.dropped());
    }
    proc.report_pool();
    serial.serial_write("daphnis: done\n");
}
