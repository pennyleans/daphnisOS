// src/cursor.ci: the pointer's shapes. The arrow (H-4, docs/specs/2026-11-05-h-hybrid.md HX-5 and section 5 item 3),
// 8 x 16 at 1x, one byte a row, bit 7 the left pixel: EDGE the paper outline, BODY the ink inside it, its hot spot its
// top left. tools/check-tiler.py and tools/check-hdesk.py read these two lists from this file. Frame 26's other
// shapes (DN-51: Text, Move, Width, Height, the two Corners, Aim, Not here), 24 x 24 at 1x, one U32 a row, bit 23 the
// left pixel, 24 rows a shape in SHAPE order from TEXT, their hot spot the center (12, 12): edge24 and body24, made
// by tools/gen-pointers.py from the frame's strokes (dark core, 1 px light edge), which --check holds them to.
// FBIO_TILE_CURSOR names a shape by its number (src/tile.ci); Busy is the arrow with its sprite (FBIO_TILE_BUSY).
export const I64 W = 8;
export const I64 H = 16;
export const I64 ARROW = 1;
export const I64 TEXT = 2;
export const I64 MOVE = 3;
export const I64 WIDTH = 4;
export const I64 HEIGHT = 5;
export const I64 CORNER_NWSE = 6;     // the corner from top left to bottom right
export const I64 CORNER_NESW = 7;     // the corner from top right to bottom left
export const I64 AIM = 8;
export const I64 NOT_HERE = 9;
export const I64 LAST = 9;
export const I64 SIDE = 24;           // a frame 26 shape's box at 1x
U8[16] edge = [0x80, 0xC0, 0xA0, 0x90, 0x88, 0x84, 0x82, 0x81, 0x87, 0x94, 0xAA, 0xCA, 0x85, 0x05, 0x02, 0x00];
U8[16] body = [0x00, 0x00, 0x40, 0x60, 0x70, 0x78, 0x7C, 0x7E, 0x78, 0x68, 0x44, 0x04, 0x02, 0x02, 0x00, 0x00];
