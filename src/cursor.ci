// Shape s's box at 1x, its width and height; and its hot spot from the box's top left.
export I64 width(I64 s) {
    if (s <= ARROW || s > LAST) { return W; }
    return SIDE;
}
export I64 height(I64 s) {
    if (s <= ARROW || s > LAST) { return H; }
    return SIDE;
}
export I64 hot(I64 s) {
    if (s <= ARROW || s > LAST) { return 0; }
    return SIDE / 2;
}

// Shape s's pixel (i, j) of its box at 1x: 0 none, 1 paper, 2 ink. A shape past LAST is the arrow.
export I64 shape_at(I64 s, I64 i, I64 j) {
    if (s <= ARROW || s > LAST) {
        return at(i, j);
    }
    if (i < 0 || i >= SIDE || j < 0 || j >= SIDE) {
        return 0;
    }
    I64 r = SIDE * (s - TEXT) + j;
    U32 m = (0x800000 >> i) as U32;
    if ((body24[r] & m) != 0) {
        return 2;
    }
    if ((edge24[r] & m) != 0) {
        return 1;
    }
    return 0;
}

// The arrow's pixel (i, j) at 1x: 0 none, 1 paper, 2 ink.
export I64 at(I64 i, I64 j) {
    if (i < 0 || i >= W || j < 0 || j >= H) {
        return 0;
    }
    I64 m = 0x80 >> i;
    if (((body[j] as I64) & m) != 0) {
        return 2;
    }
    if (((edge[j] as I64) & m) != 0) {
        return 1;
    }
    return 0;
}

// FBIO_TILE_BUSY (docs/specs/2026-11-10-busy-pointer.md): the sprite's pixel px (0xAARRGGBB, AA the coverage in
// sixteenths, 0 to 16) over the screen's pixel under, a channel at a time: (c * a + under * (16 - a)) / 16.
export U64 blend(U64 under, U64 px) {
    I64 a = ((px >> 24) & 0xFF) as I64;
    if (a <= 0) {
        return under;
    }
    if (a > 16) {
        a = 16;
    }
    U64 mixed = 0;
    for k in 0..3 {
        U64 sh = (8 * k) as U64;
        I64 c = ((px >> sh) & 0xFF) as I64;
        I64 u = ((under >> sh) & 0xFF) as I64;
        mixed = mixed | ((((c * a + u * (16 - a)) / 16) as U64) << sh);
    }
    return mixed;
}
