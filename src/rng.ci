// src/rng.ci: A-3 (docs/specs/2026-11-06-a-agent.md sections 3 and 4), the source getrandom draws on, journaled
// (law 2). Three modes, fixed at init():
//   replay  the image has a member rng.journal (tools/netjournal.py rng: the `rtc` line and the `rng` lines of
//           a transcript); each draw takes the journal's next `rng` line, which must have the draw's length.
//   live    the CPU has RDRAND (QEMU's -cpu max under TCG, the host's under KVM); each draw reads it.
//   none    neither, or init() never ran (every flavor but net and desknet): getrandom is -ENOSYS, as on a
//           Linux without the call, and nothing is printed, so no golden of those flavors moves.
// Every draw prints `rng N HEX` (N bytes, 2N lowercase hex digits), in replay as live, so a replay transcript
// equals the live one but for the mode line.

import src.serial;
import src.text;
import src.user;
import src.cpio;

extern unrestricted void journal_record(I64 kind, in U8[_] bytes);
extern observe I64 journal_size(I64 kind);
extern observe I64 journal_read(I64 kind, I64 offset, out U8[_] bytes);

extern observe I64 rdrand_present();
extern observe I64 rdrand_fill(out U8[_] dst);

export const I64 NONE = 0;
export const I64 LIVE = 1;
export const I64 REPLAY = 2;
export const I64 DRAW_MAX = 256;   // bytes a call: Linux never shortens a draw of 256 or fewer
const I64 LINE_MAX = 520;          // `rng 256 ` and 512 hex digits

I64 source = 0;
Bool journaled = false;  // RS-CLK2: the boot replays a journal (init found one), so the machine's clock is never read
I64 wall_last = 0;       // RS-CLK2: the wall seconds since the date that the system's time last took (`wal S N`)
I64 wall_calls = 0;      // RS-CLK2: wall_take's calls since boot; N of `wal S N` is the call that took S
Bool no_draws = false;   // replay of a journal with no `rng` line after its date (K-6b): getrandom is -ENOSYS
Bool private_journal = false;
I64 j_at = 0;        // replay: the journal's next unread byte in the image, and its end
I64 j_end = 0;
U8[520] line;
I64 line_len = 0;

void put_dec(I64 v) {
    U8[20] d;
    I64 k = text.dec_digits(v, d);
    for i in 0..k {
        serial.serial_putc(d[i]);
    }
}

Bool named[m](in U8[m] want, in U8[12] nm) {
    if (m != 11 || nm[11] != 0) {
        return false;
    }
    for i in 0..m {
        if (nm[i] != want[i]) {
            return false;
        }
    }
    return true;
}

// prefers authenticated input; otherwise finds rng.journal in the image: sets j_at and j_end. The member is a plain file.
Bool find_journal() {
    I64 private_size = journal_size(2);
    if (private_size >= 0) {
        private_journal = true;
        j_at = 0;
        j_end = private_size;
        return true;
    }
    I64 total = user.initrd_size();
    I64 at = 0;
    U8[110] h;
    U8[12] nm;
    while (at + cpio.HEADER_BYTES <= total) {
        if (user.initrd_read(at, h) != cpio.HEADER_BYTES || !cpio.magic_ok(h)) {
            return false;
        }
        I64 ns = cpio.field(h, cpio.F_NAMESIZE);
        I64 msize = cpio.field(h, cpio.F_FILESIZE);
        if (ns < 1 || msize < 0) {
            return false;
        }
        I64 da = cpio.data_at(at, ns);
        if (ns == 12 && user.initrd_read(at + cpio.HEADER_BYTES, nm) == 12 && named("rng.journal", nm) && msize <= total - da) {
            j_at = da;
            j_end = da + msize;
            return true;
        }
        at = cpio.next_at(at, ns, msize);
    }
    return false;
}

// Reads the next journal line, without its line end, into line. False at the end of the journal or for a
// line longer than LINE_MAX.
Bool next_line() {
    line_len = 0;
    if (j_at >= j_end) {
        return false;
    }
    U8[1] c;
    while (j_at < j_end) {
        I64 got = -1;
        if (private_journal) {
            got = journal_read(2, j_at, c);
        } else {
            got = user.initrd_read(j_at, c);
        }
        if (got != 1) {
            j_at = j_end;
            return false;
        }
        j_at += 1;
        if (c[0] == 10) {
            return true;
        }
        if (line_len == LINE_MAX) {
            return false;
        }
        line[line_len] = c[0];
        line_len += 1;
    }
    return true;
}

I64 hexval(U8 c) {
    if (c >= 48 && c <= 57) {
        return (c as I64) - 48;
    }
    if (c >= 97 && c <= 102) {
        return (c as I64) - 87;
    }
    return -1;
}

// The decimal number at line[at..), its end in parse_end; -1 if none.
I64 parse_end = 0;
I64 parse_dec(I64 at) {
    I64 v = 0;
    I64 i = at;
    while (i < line_len && line[i] >= 48 && line[i] <= 57 && v < 1000000000000) {
        v = v * 10 + (line[i] as I64) - 48;
        i += 1;
    }
    parse_end = i;
    if (i == at) {
        return -1;
    }
    return v;
}

Bool starts[n](in U8[n] p) {
    if (line_len < n) {
        return false;
    }
    for i in 0..n {
        if (line[i] != p[i]) {
            return false;
        }
    }
    return true;
}

// Fixes the mode and prints it, except for none. The net and desknet flavors call it once, before any process.
export void init() {
    if (find_journal()) {
        journaled = true;
        if (private_journal && j_at == j_end) {
            source = NONE;
            return;
        }
        source = REPLAY;
        serial.serial_write("daphnis: rng replay from rng.journal, ");
        put_dec(j_end - j_at);
        serial.serial_write(" bytes\n");
    } else if (rdrand_present() == 1) {
        source = LIVE;
        serial.serial_write("daphnis: rng rdrand, live\n");
    }
}

export I64 mode() {
    if (no_draws) {
        return NONE;
    }
    return source;
}

// an empty authenticated stream still forbids live entropy and clock input.
export Bool private_replay() {
    return private_journal;
}

// True when an `rng` line follows the journal's next unread byte; the journal stays where it was.
Bool draws_ahead() {
    I64 back = j_at;
    Bool seen = false;
    while (!seen && next_line()) {
        seen = starts("rng ");
    }
    j_at = back;
    return seen;
}

// Replay: the seconds of the journal's `rtc S` line when it is the next line, else -1 and the journal is
// where it was (src/rtc.ci reads it once at boot, before any draw). K-6b: a journal with no draw after its date is
// the record of a run that had no source (daphnis.rtc=1 without RDRAND), so once its line is taken the source is
// none, as it was live, and getrandom is -ENOSYS again; RS-CLK: its `clk` lines are still read (clock_take).
export I64 journal_rtc() {
    if (source != REPLAY) {
        return -1;
    }
    I64 back = j_at;
    if (next_line() && starts("rtc ")) {
        I64 s = parse_dec(4);
        if (s >= 0 && parse_end == line_len) {
            if (j_at >= j_end) {
                source = NONE;
            } else if (!draws_ahead()) {
                no_draws = true;
            }
            return s;
        }
    }
    j_at = back;
    return -1;
}

// RS-CLK (docs/specs/2026-11-11-rs-rel-s1-units.md section 2): a set of the clock is an outside input. The seconds
// it takes are s, or in replay the journal's `clk S` line when it is the next line (else s, and the journal stays
// where it was). The caller bounds them (civil.settable, src/proc.ci) before clock_record prints them `clk S` and
// records them as the `rtc` line is, so a replay's transcript equals the live one and a journal line past the
// bound is neither printed nor recorded. src/proc.ci calls both only on a boot that took a date (src/rtc.ci).
export I64 clock_take(I64 s) {
    if (source != REPLAY) {
        return s;
    }
    I64 back = j_at;
    if (next_line() && starts("clk ")) {
        I64 v = parse_dec(4);
        if (v >= 0 && parse_end == line_len) {
            return v;
        }
    }
    j_at = back;
    return s;
}

export void clock_record(I64 t) {
    U8[25] record;
    record[0] = 99;
    record[1] = 108;
    record[2] = 107;
    record[3] = 32;
    I64 end = 4 + text.dec_digits(t, record[4..25]);
    record[end] = 10;
    own_line();
    serial.serial_write("clk ");
    put_dec(t);
    serial.serial_write("\n");
    journal_record(2, record[0..end + 1]);
}

// RS-CLK2 (docs/specs/2026-11-11-rs-rel-s1-units.md under RS-CLK): the machine's clock is an outside input too. On
// a boot that took a date the system's time is the whole seconds the PIT has run since the date was taken (s, from
// src/proc.ci). Each call counts (wall_calls). Live, when the seconds pass the last taken, the call prints and
// records `wal S N`, N its count, on a line of its own, as `clk` is; a boot that replays a journal never reads the
// PIT: it takes the journal's next `wal S N` line at call N alone and keeps the last at every other call, so each
// call of a replay reads what the same call read live (two reads in one second read the same) and its transcript
// equals the live one. Never earlier than the last; wall_reset starts again from 0 at a set.
export I64 wall_take(I64 s) {
    wall_calls += 1;
    I64 v = s;
    if (journaled) {
        v = wall_last;
        if (source == REPLAY) {
            I64 back = j_at;
            I64 w = -1;
            if (next_line() && starts("wal ")) {
                w = parse_dec(4);
                I64 n = -1;
                if (w >= 0 && parse_end < line_len && line[parse_end] == 32) {
                    n = parse_dec(parse_end + 1);
                }
                if (n != wall_calls || parse_end != line_len) {
                    w = -1;
                }
            }
            if (w >= 0) {
                v = w;
            } else {
                j_at = back;
            }
        }
    }
    if (v > wall_last) {
        wall_last = v;
        U8[48] record;
        record[0] = 119;
        record[1] = 97;
        record[2] = 108;
        record[3] = 32;
        I64 end = 4 + text.dec_digits(v, record[4..25]);
        record[end] = 32;
        end = end + 1 + text.dec_digits(wall_calls, record[end + 1..end + 21]);
        record[end] = 10;
        own_line();
        serial.serial_write(record[0..end + 1]);
        journal_record(2, record[0..end + 1]);
    }
    return wall_last;
}

// A record of the kernel's starts its own line: a program's open line is ended first, so a record is a whole line
// and tools/netjournal.py takes whole lines alone (RS-CLK2).
void own_line() {
    if (!serial.at_line_start()) {
        serial.serial_write("\n");
    }
}

export void wall_reset() {
    wall_last = 0;
}

// Replay: the next `rng k HEX` line into dst[0..k); false, and the replay ends, if it is not one.
Bool from_journal[n](inout U8[n] dst, I64 k) {
    Bool ok = next_line() && starts("rng ") && parse_dec(4) == k && line_len == parse_end + 1 + 2 * k && line[parse_end] == 32;
    I64 at = parse_end + 1;
    for i in 0..k {
        if (ok) {
            I64 hi = hexval(line[at + 2 * i]);
            I64 lo = hexval(line[at + 2 * i + 1]);
            ok = hi >= 0 && lo >= 0;
            if (ok) {
                dst[i] = (hi * 16 + lo) as U8;
            }
        }
    }
    if (!ok) {
        serial.serial_write("daphnis: rng journal: a line that is not the next draw's `rng` record ends the replay\n");
        source = NONE;
        j_at = j_end;
    }
    return ok;
}

// Draws k bytes (1 to DRAW_MAX, at most n) into dst and prints the record; k, or -1 when the source failed
// (no source, the journal ended, or RDRAND gave no value ten times).
export I64 draw[n](inout U8[n] dst, I64 k) {
    if (k < 1 || k > DRAW_MAX || k > n) {
        return -1;
    }
    if (source == LIVE) {
        if (rdrand_fill(dst[0..k]) != k) {
            return -1;
        }
    } else if (source != REPLAY || !from_journal(dst, k)) {
        return -1;
    }
    U8[521] record;
    record[0] = 114;
    record[1] = 110;
    record[2] = 103;
    record[3] = 32;
    I64 at = 4 + text.dec_digits(k, record[4..521]);
    record[at] = 32;
    at += 1;
    serial.serial_write("rng ");
    put_dec(k);
    serial.serial_write(" ");
    for i in 0..k {
        serial.serial_putc(text.hex_digit(dst[i] >> 4));
        serial.serial_putc(text.hex_digit(dst[i]));
        record[at] = text.hex_digit(dst[i] >> 4);
        record[at + 1] = text.hex_digit(dst[i]);
        at += 2;
    }
    serial.serial_write("\n");
    record[at] = 10;
    journal_record(2, record[0..at + 1]);
    return k;
}
