// src/main_deskplay.ci: G-5b (docs/specs/2026-11-06-g-menu.md section 5), the episode played in a desk window:
// the hybrid desk's kernel (src/main_hdesk.ci) with the play image, the hdesk image plus grant, e1.wad, menu.wad
// and tests/play/doom.sh. hdesk starts in the home with the disk grant (FS-3) and `--monocle --run ". /doom.sh"`:
// the first terminal sources the script, which runs `./doom --live --menu menu.wad --config home/doom.cfg --record
// home/g.lmp --fit e1.wad` from the root, so the desk boots into Doom's title and menu in a monocle window, the frame
// at the largest whole scale the window holds (3x, 960 x 600, at 1080 x 1920 portrait). Quit (F10, y) returns to the
// terminal in the home: `. /doom.sh` plays again, `exit` ends the desk. The record and doom.cfg are on the volume;
// tools/play.sh boots it under KVM. A kernel's argument block is 64 bytes (src/proc.ci), hence the script.

import src.portio;
import src.serial;
import src.fs;
import src.cpu;
import src.pit;
import src.user;
import src.proc;
import src.surface;
import src.input;
import src.tile;
import src.blk;
import src.pool;
import src.dsp;
import src.rng;
import src.rtc;


void main() {
    serial.serial_write("Daphnis G: play in the desk\n");
    cpu.tss_install();
    cpu.idt_install_ist();
    _ = pool.init();          // M-3: the pool from the memory map under daphnis.pool=max; the gates' pool otherwise
    user.user_init();
    fs.init();
    if (user.fb_init() > 0) {
        fs.set_fb(user.fb_word(0) as I64, user.fb_word(1) as I64, user.fb_word(2) as I64);
        serial.serial_write("daphnis: framebuffer ");
        proc.put_dec(user.fb_word(0) as I64);
        serial.serial_write("x");
        proc.put_dec(user.fb_word(1) as I64);
        serial.serial_write(" stride ");
        proc.put_dec(user.fb_word(2) as I64);
        serial.serial_write("\n");
    } else {
        serial.serial_write("daphnis: no framebuffer\n");
    }
    pit.pic_remap();
    pit.pit_start(11932);
    rng.init();               // K-6: the date (A-3), live with RDRAND (KVM, -cpu max); the fixed epoch in every gate
    rtc.boot();
    _ = dsp.init();           // AU-3: /dev/dsp when an HDA controller is there; nothing said when none is
    if (input.devices_on()) {
        serial.serial_write("daphnis: keyboard and mouse on\n");
    } else {
        serial.serial_write("daphnis: keyboard on, no mouse\n");
    }
    fs.set_input(true);
    if (blk.init() > 0 && fs.mount_disk()) {
        serial.serial_write("daphnis: /home mounted\n");
        if (fs.load_mode()) {
            serial.serial_write("daphnis: the saved size ");
            proc.put_dec(user.fb_word(0) as I64);
            serial.serial_write("x");
            proc.put_dec(user.fb_word(1) as I64);
            serial.serial_write("\n");
        }
    }
    serial.serial_write("daphnis: image ");
    proc.put_dec(user.initrd_size());
    serial.serial_write(" bytes from the loader module\n");
    proc.push_arg("--monocle");
    proc.push_arg("--run");
    proc.push_arg(". /doom.sh");
    proc.run_desk(1, "hdesk");
    surface.print();
    if (input.dropped() != 0 || tile.dropped() != 0) {
        serial.serial_write("daphnis: input dropped\n");
        input.say_dropped(tile.dropped());
    }
    proc.report_pool();
    _ = blk.flush();          // before S5 or the reset cuts the disk's power (the read of PR 489); it prints a failure
    if (proc.ending() == 1) {
        serial.serial_write("daphnis: shut down\n");   // FF-4: the desk asked
    }
    serial.serial_write("daphnis: done\n");
    if (proc.ending() == 2) {
        serial.serial_write("daphnis: restart\n");      // FF-4: the 8042's pulse on the reset line
        portio.port_out8(0x64, 0xFE);
    }
}
