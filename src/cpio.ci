// src/cpio.ci: the cpio "newc" header, the format of a Linux initramfs, pure so the hosted tests
// run it. A member is a 110-byte header (the magic "070701", then thirteen fields of eight hex
// digits), the name and its NUL padded to a multiple of 4, then the data padded to a multiple
// of 4. The archive ends with the member named "TRAILER!!!".

export const I64 HEADER_BYTES = 110;
export const I64 F_INO = 0;
export const I64 F_MODE = 1;
export const I64 F_UID = 2;
export const I64 F_GID = 3;
export const I64 F_NLINK = 4;
export const I64 F_MTIME = 5;
export const I64 F_FILESIZE = 6;
export const I64 F_NAMESIZE = 11;

I64 hexval(U8 c) {
    I64 v = -1;
    if (c >= 48 && c <= 57) {
        v = (c as I64) - 48;
    }
    if (c >= 97 && c <= 102) {
        v = (c as I64) - 87;
    }
    if (c >= 65 && c <= 70) {
        v = (c as I64) - 55;
    }
    return v;
}

// True when h starts with the newc magic "070701".
export Bool magic_ok[n](in U8[n] h) {
    if (n < HEADER_BYTES) {
        return false;
    }
    return h[0] == 48 && h[1] == 55 && h[2] == 48 && h[3] == 55 && h[4] == 48 && h[5] == 49;
}

// Field k (0 ino, 1 mode, ..., 6 filesize, ..., 11 namesize, 12 check) of the header, or -1 if
// a digit is not hex.
export I64 field[n](in U8[n] h, I64 k) {
    if (n < HEADER_BYTES || k < 0 || k > 12) {
        return -1;
    }
    I64 v = 0;
    for i in 0..8 {
        I64 d = hexval(h[6 + 8 * k + i]);
        if (d < 0) {
            return -1;
        }
        v = v * 16 + d;
    }
    return v;
}

// x rounded up to a multiple of 4 (x is at most 2^32 + 110 here, far from any limit).
export I64 align4(I64 x) {
    return (x + 3) / 4 * 4;
}

// Where the data of the member whose header is at `at` starts.
export I64 data_at(I64 at, I64 namesize) {
    return align4(at + HEADER_BYTES + namesize);
}

// Where the next header starts.
export I64 next_at(I64 at, I64 namesize, I64 filesize) {
    return align4(data_at(at, namesize) + filesize);
}
