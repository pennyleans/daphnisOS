// tests/hosted/dhcp/src/bootarg.ci: src/bootarg.ci for the hosted DHCP test; the boot line says daphnis.net=dhcp.

export I64 boot_net[n](inout U8[n] dst) {
    dst[0] = 100;   // d
    dst[1] = 104;   // h
    dst[2] = 99;    // c
    dst[3] = 112;   // p
    return 4;
}
