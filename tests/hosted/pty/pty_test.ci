// tests/hosted/pty/pty_test.ci: src/pty.ci hosted (tests/hosted/pty/src's uvm and job stand in), under the key flood
// of board 20261110T234031Z: the desk's nonblocking key writes to the master, a shell's reads and its redraws on the
// slave, the desk's reads of the master, the termios turned between raw and canonical, ^C, erase and kill, in a
// seeded random order. After every step the output queue holds together (pty.queue_ok) and a master with output
// gives some of it to a read: the stall the board saw is a master the desk can never empty.
// Run by check.sh in a root of tests/hosted/pty and src/pty.ci.
import src.pty;
import src.uvm;

I64 seed = 12345;
I64 rnd(I64 n) {
    seed = (seed * 1103515245 + 12345) % 2147483648;   // a small LCG: checked arithmetic stays in range
    return (seed / 65536) % n;
}

const U64 TCGETS = 0x5401;
const U64 TCSETS = 0x5402;
const U64 KEYS = 4096;        // the desk's key buffer
const U64 SH_IN = 8192;       // the shell's read buffer
const U64 SH_OUT = 16384;     // the shell's write buffer
const U64 DESK_IN = 32768;    // the desk's read buffer
const U64 TIO = 60000;

// lflag bits on or off (ICANON 2, ECHO 8, ISIG 1, ECHOE 16)
void set_lflag(I64 i, I64 on, I64 off) {
    assert(pty.ioctl(2, i, false, TCGETS, TIO, false, false) == 0);
    U64 lf = 0;
    for j in 0..4 { lf = lf | ((uvm.at(TIO + 12 + j as U64) as U64) << ((8 * j) as U64)); }
    lf = (lf | on as U64) & ~(off as U64);
    for j in 0..4 { uvm.put(TIO + 12 + j as U64, ((lf >> ((8 * j) as U64)) & 0xFF) as U8); }
    assert(pty.ioctl(2, i, false, TCSETS, TIO, false, false) == 0);
}

I64 flood(I64 steps, I64 seed0, I64 read_cap) {
    seed = seed0;
    I64 i = pty.alloc(0, false);
    assert(i >= 0);
    pty.ref(i, true, 1);
    pty.slave_opened(2, i, 0x100, false);
    pty.ref(i, false, 1);
    set_lflag(i, 0, 2 + 8);             // the shell's editor: raw, no echo
    I64 line = 0;                       // the shell's line, redrawn whole on every key
    I64 reads = 0;
    for t in 0..steps {
        I64 a = rnd(100);
        if (a < 40) {                   // the desk: 1 to 6 keys held, one nonblocking write
            I64 k = 1 + rnd(6);
            for j in 0..k {
                I64 c = 'a' + rnd(26);
                I64 z = rnd(200);
                if (z == 0) { c = 3; }   // ^C
                if (z == 1) { c = 13; }
                if (z == 2) { c = 127; }
                if (z == 3) { c = 21; }
                uvm.put(KEYS + j as U64, c as U8);
            }
            I64 w = pty.master_write(0, i, KEYS, k as U64, true);
            assert(w > 0 || w == 0 - 11);
        } else if (a < 60) {            // the shell: what is queued, then its redraw
            I64 got = pty.slave_read(2, i, SH_IN, (1 + rnd(512)) as U64);
            if (got > 0) {
                line = min(line + got, 2000);
                I64 n = 8 + line + line / 80 * 6;
                for j in 0..n {
                    I64 c = 'x';
                    if (j % 97 == 96) { c = 10; }
                    uvm.put(SH_OUT + j as U64, c as U8);
                }
                I64 put = pty.slave_write(2, i, SH_OUT, n as U64);
                assert(put > 0 || put == pty.WAIT);
            }
        } else if (a < 92) {            // the desk reads the master until it is empty
            I64 g = pty.master_read(0, i, DESK_IN, (1 + rnd(read_cap)) as U64, true);
            while (g > 0) {
                reads += 1;
                g = pty.master_read(0, i, DESK_IN, (1 + rnd(read_cap)) as U64, true);
            }
            assert(g == 0 - 11);        // empty: -EAGAIN, never -EFAULT
        } else if (a < 96) {
            set_lflag(i, 2 + 8 + 16, 0);   // canonical with echo, then raw again
        } else {
            set_lflag(i, 0, 2 + 8);
        }
        assert(pty.queue_ok(i));
        if (pty.out_ready()) {
            I64 g = pty.master_read(0, i, DESK_IN, 1, true);
            assert(g == 1);             // a master with output gives a byte
            assert(pty.queue_ok(i));
        }
    }
    pty.ref(i, true, -1);
    pty.ref(i, false, -1);
    return reads;
}

test "the key flood: the queue holds together and the master always gives what it holds" {
    for s in 0..8 {
        I64 r = flood(4000, 1000 + s, 4096);
        assert(r > 0);
    }
}

test "^C with 32 writes unread: the queue still holds together and the master still gives its bytes" {
    I64 i = pty.alloc(0, false);
    pty.ref(i, true, 1);
    pty.slave_opened(2, i, 0x100, false);
    pty.ref(i, false, 1);
    set_lflag(i, 1, 2 + 8);              // raw, no echo, ISIG on: cish's editor
    uvm.put(SH_OUT, 'x' as U8);
    for k in 0..32 { assert(pty.slave_write(2, i, SH_OUT, 1) == 1); }   // the desk reads none of them
    assert(pty.slave_write(2, i, SH_OUT, 1) == pty.WAIT);              // the 33rd waits
    uvm.put(KEYS, 3 as U8);                                             // ^C: SIGINT, the output dropped
    assert(pty.master_write(0, i, KEYS, 1, true) == 1);
    assert(pty.queue_ok(i));
    assert(pty.slave_write(2, i, SH_OUT, 1) == 1);                     // the shell writes again
    assert(pty.queue_ok(i));
    assert(pty.master_read(0, i, DESK_IN, 4096, true) == 1);            // and the desk reads it
    assert(pty.master_read(0, i, DESK_IN, 4096, true) == 0 - 11);
    pty.ref(i, true, -1);
    pty.ref(i, false, -1);
}

test "the same with small reads, as a desk that reads a little at a time" {
    for s in 0..4 { I64 r = flood(3000, 2000 + s, 64); }
}
