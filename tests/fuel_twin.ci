// tests/fuel_twin.ci: the hosted twin of run 10 of the faults flavor (the fuel probe). A hosted
// program runs with unbounded fuel and `cint test` with an allowance of 1,000,000,000, so the
// record is not byte-identical to the kernel's (the limit differs); check.sh compares the
// rendered fields: operation, operand count, exact, position (the `while` of src/probes.ci).

import src.probes;

test "fuel probe" {
    U8[3] a;
    a[0] = 49;
    a[1] = 48;
    a[2] = 0;
    probes.run(a);
}
