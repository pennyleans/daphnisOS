// tests/font/term_cells_test.ci: hosted tests of the terminal swap (FONT-1; docs/specs/2026-11-07-k-kit2.md sections
// 3e and 3f): a cell user/ci/terms.ci draws is kit/mtext.ci's cell_row of its code point, in its colors, bold from
// the bold plane, reverse and the shown cursor swapping ink and paper, at 1x and 2x. Run by check.sh:
// cint test --root . tests/font/term_cells_test.ci

import user.ci.kit.tokens;
import user.ci.kit.mtext;
import user.ci.terms;

U32[256] got;
U32[256] want;

void feeds(I64 s, in U8[_] b) {
    for k in 0..len(b) { terms.feed(s, b[k]); }
}

// Slot s a fresh 8 x 2 grid fed b, the cursor hidden unless shown.
void fresh(I64 s, in U8[_] b, Bool shown) {
    terms.init(s, 8, 2);
    feeds(s, b);
    if (!shown) { feeds(s, b"\x1b[?25l"); }
}

// Column c of row 0 of slot s, every pixel row at scale z, is mtext's cell of code point cp in ink fg on ground bg.
Bool cell_is(I64 s, I64 c, I64 cp, Bool bold, U32 fg, U32 bg, I64 z) {
    I64 cw = mtext.cell_w(z);
    for y in 0..mtext.cell_h(z) {
        terms.draw_row(s, got[0..8 * cw], y, z);
        mtext.cell_row(want[0..cw], 0, y, mtext.index(cp), bold, fg, bg, z);
        for x in 0..cw {
            if (got[cw * c + x] != want[x]) { return false; }
        }
    }
    return true;
}

// The same at 1x and 2x.
Bool both(I64 s, I64 c, I64 cp, Bool bold, U32 fg, U32 bg) {
    return cell_is(s, c, cp, bold, fg, bg, 1) && cell_is(s, c, cp, bold, fg, bg, 2);
}

// Code points a and b draw differently at scale z, regular or bold.
Bool differ(I64 a, Bool ba, I64 b, Bool bb, I64 z) {
    I64 cw = mtext.cell_w(z);
    for y in 0..mtext.cell_h(z) {
        mtext.cell_row(got[0..cw], 0, y, mtext.index(a), ba, 0xFFFFFF, 0, z);
        mtext.cell_row(want[0..cw], 0, y, mtext.index(b), bb, 0xFFFFFF, 0, z);
        for x in 0..cw {
            if (got[x] != want[x]) { return true; }
        }
    }
    return false;
}

test "ASCII cells are mtext's, in the default ink and paper" {
    fresh(0, b"Ag ~", false);
    U32 ink = tokens.term_ink();
    U32 paper = tokens.term_paper();
    assert(both(0, 0, 0x41, false, ink, paper));
    assert(both(0, 1, 0x67, false, ink, paper));
    assert(both(0, 2, 0x20, false, ink, paper));
    assert(both(0, 3, 0x7E, false, ink, paper));
    assert(both(0, 4, 0x20, false, ink, paper));
}

test "an accented letter is its own glyph, not ?" {
    fresh(0, b"caf\xc3\xa9 \xc3\x80", false);
    assert(terms.code(0, 0, 3) == 0xE9);
    assert(mtext.index(0xE9) != mtext.index(0xFFFD));
    assert(both(0, 3, 0xE9, false, tokens.term_ink(), tokens.term_paper()));
    assert(both(0, 5, 0xC0, false, tokens.term_ink(), tokens.term_paper()));
    assert(differ(0xE9, false, 0x3F, false, 1));
    assert(differ(0xE9, false, 0x65, false, 1));
}

test "box drawing glyphs are mtext's" {
    fresh(0, b"\xe2\x94\x8c\xe2\x94\x80\xe2\x94\x90\xe2\x94\x82\xe2\x95\x90", false);
    I64[5] cps = [0x250C, 0x2500, 0x2510, 0x2502, 0x2550];
    for k in 0..5 {
        assert(terms.code(0, 0, k) == cps[k]);
        assert(mtext.index(cps[k]) != mtext.index(0xFFFD));
        assert(both(0, k, cps[k], false, tokens.term_ink(), tokens.term_paper()));
    }
}

test "bold draws JetBrains Mono 600 from the bold plane" {
    fresh(1, b"a\x1b[1mBb\xc3\xa9\xe2\x94\x80\x1b[22mB", false);
    U32 ink = tokens.term_ink();
    U32 paper = tokens.term_paper();
    assert(both(1, 0, 0x61, false, ink, paper));
    assert(both(1, 1, 0x42, true, ink, paper));
    assert(both(1, 2, 0x62, true, ink, paper));
    assert(both(1, 3, 0xE9, true, ink, paper));
    assert(both(1, 4, 0x2500, true, ink, paper));
    assert(both(1, 5, 0x42, false, ink, paper));
    assert(differ(0x42, true, 0x42, false, 1));
    assert(differ(0x42, true, 0x42, false, 2));
}

test "colors, reverse and the shown cursor swap ink and paper" {
    fresh(2, b"\x1b[31;44mR\x1b[7mv\x1b[0;7mw\x1b[0m", true);
    U32 red = tokens.term_ansi(1);
    U32 blue = tokens.term_ansi(4);
    U32 ink = tokens.term_ink();
    U32 paper = tokens.term_paper();
    assert(both(2, 0, 0x52, false, red, blue));
    assert(both(2, 1, 0x76, false, blue, red));
    assert(both(2, 2, 0x77, false, paper, ink));
    assert(both(2, 3, 0x20, false, paper, ink));        // the cursor's cell, shown
    feeds(2, b"\x1b[1;3H");
    assert(both(2, 2, 0x77, false, ink, paper));        // reverse under the cursor: not swapped
    assert(both(2, 3, 0x20, false, ink, paper));
    feeds(2, b"\x1b[?25l");
    assert(both(2, 2, 0x77, false, paper, ink));
}

test "a code point the face lacks draws as U+FFFD" {
    fresh(3, b"\xf0\x9f\x98\x80\x80", false);
    assert(terms.code(3, 0, 0) == 0x1F600);
    assert(mtext.index(0x1F600) == mtext.index(0xFFFD));
    assert(both(3, 0, 0xFFFD, false, tokens.term_ink(), tokens.term_paper()));
    assert(both(3, 1, 0xFFFD, false, tokens.term_ink(), tokens.term_paper()));
}

test "a narrow row draws only the whole cells that fit" {
    fresh(4, b"ABCDEFGH", false);
    for k in 0..256 { got[k] = 0x123456; }
    terms.draw_row(4, got[0..20], 3, 1);
    mtext.cell_row(want[0..8], 0, 3, mtext.index(0x42), false, tokens.term_ink(), tokens.term_paper(), 1);
    for x in 0..8 { assert(got[8 + x] == want[x]); }
    for x in 16..20 { assert(got[x] == 0x123456); }
}
