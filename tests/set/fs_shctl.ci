// tests/set/fs_shctl.ci: a volume in memory for U-SET's file tests, copied over user/ci/shctl.ci in an isolated root
// by tools/check-settings.py (tests/set/fs_corectl.ci and fs_fdctl.ci over corectl.ci and fdctl.ci reach it through
// the fs_ calls). Seven nodes (file, folder or link) with a path, an owner, a mode and up to 8300 bytes; one
// descriptor open at a time; scripted failures for open, fstat, read, write, close, mkdir and rename. A read open is
// O_RDONLY | O_NONBLOCK | O_NOFOLLOW only: a link at the name is -ELOOP, as the kernel's sys_open (FS-5), and a
// folder opens. A write open is O_WRONLY | O_CREAT | O_EXCL only: anything at the name, a link too, is -EEXIST. Not
// a filesystem: just what kit/setfile.ci calls.

export const I64 NONE = 0;
export const I64 FILE = 1;
export const I64 DIR = 2;
export const I64 LINK = 3;

U8[896] names;       // 128 bytes a node
I64[7] nlen;
I64[7] kinds;
I64[7] uids;
I64[7] modes;
U8[58100] data;      // 8300 bytes a node
I64[7] sizes;
I64 me = 1000;       // the caller's uid
I64 pid = 7;         // the caller's process
I64 open_fd = -1;    // the node open, or -1
I64 pos = 0;
Bool writing = false;
I64 opens = 0;
I64 closes = 0;
I64 e_open = 0;      // scripted failures: the next call of their kind returns them
I64 e_fstat = 0;
I64 e_read = 0;
I64 read_ok = 0;     // bytes read before e_read
I64 e_close = 0;
I64 e_mkdir = 0;
I64 e_rename = 0;
Bool short_write = false;

export void reset() {
    for i in 0..7 {
        kinds[i] = NONE;
        nlen[i] = 0;
        sizes[i] = 0;
    }
    me = 1000;
    pid = 7;
    open_fd = -1;
    opens = 0;
    closes = 0;
    e_open = 0;
    e_fstat = 0;
    e_read = 0;
    read_ok = 0;
    e_close = 0;
    e_mkdir = 0;
    e_rename = 0;
    short_write = false;
}

export void caller(I64 uid) { me = uid; }
export void process(I64 p) { pid = p; }
export I64 sh_getpid() { return pid; }
export void fail_open(I64 e) { e_open = e; }
export void fail_fstat(I64 e) { e_fstat = e; }
export void fail_read(I64 after, I64 e) {
    read_ok = after;
    e_read = e;
}
export void fail_close(I64 e) { e_close = e; }
export void fail_mkdir(I64 e) { e_mkdir = e; }
export void fail_rename(I64 e) { e_rename = e; }
export void write_short() { short_write = true; }
export I64 opened() { return opens; }
export I64 closed() { return closes; }

export I64 find(in U8[_] p) {
    for i in 0..7 {
        if (kinds[i] != NONE && nlen[i] == len(p)) {
            Bool same = true;
            for k in 0..len(p) {
                if (names[128 * i + k] != p[k]) { same = false; }
            }
            if (same) { return i; }
        }
    }
    return -1;
}

// Whether the folder p is in exists.
Bool parent(in U8[_] p) {
    I64 s = len(p);
    while (s > 0 && p[s - 1] != '/') { s = s - 1; }
    if (s <= 1) { return true; }
    I64 d = find(p[0..s - 1]);
    return d >= 0 && kinds[d] == DIR;
}

export I64 node(in U8[_] p, I64 kind, I64 uid, I64 mode, in U8[_] bytes, I64 n) {
    I64 i = find(p);
    if (i < 0) {
        i = 0;
        while (kinds[i] != NONE) { i = i + 1; }
    }
    kinds[i] = kind;
    nlen[i] = len(p);
    for k in 0..len(p) { names[128 * i + k] = p[k]; }
    uids[i] = uid;
    modes[i] = mode;
    sizes[i] = n;
    for k in 0..n { data[8300 * i + k] = bytes[k]; }
    return i;
}

// The bytes of file p in o, their count; -1 when p is no file.
export I64 contents(in U8[_] p, inout U8[_] o) {
    I64 i = find(p);
    if (i < 0 || kinds[i] != FILE) { return -1; }
    for k in 0..sizes[i] { o[k] = data[8300 * i + k]; }
    return sizes[i];
}

export I64 kind_of(in U8[_] p) {
    I64 i = find(p);
    if (i < 0) { return NONE; }
    return kinds[i];
}
export I64 uid_of(in U8[_] p) { return uids[find(p)]; }
export I64 mode_of(in U8[_] p) { return modes[find(p)]; }

// fdctl's call, for tests/set/fs_fdctl.ci: the node open on fd
export I64 fs_fstat(I64 fd, inout I64[_] rec) {
    assert(fd == 10 + open_fd);
    if (e_fstat != 0) {
        I64 e = e_fstat;
        e_fstat = 0;
        return e;
    }
    I64 i = open_fd;
    I64 t = 0x8000;
    if (kinds[i] == DIR) { t = 0x4000; }
    if (kinds[i] == LINK) { t = 0xA000; }
    rec[2] = t | modes[i];
    rec[4] = uids[i];
    rec[7] = sizes[i];
    return 0;
}

// corectl's calls, for tests/set/fs_corectl.ci
export I64 fs_mkdir(in U8[_] p, I64 mode) {
    if (e_mkdir != 0) {
        I64 e = e_mkdir;
        e_mkdir = 0;
        return e;
    }
    if (find(p) >= 0) { return -17; }
    if (!parent(p)) { return -2; }
    _ = node(p, DIR, me, mode, p, 0);
    return 0;
}

export I64 fs_rename(in U8[_] from, in U8[_] to) {
    if (e_rename != 0) {
        I64 e = e_rename;
        e_rename = 0;
        return e;
    }
    I64 i = find(from);
    if (i < 0) { return -2; }
    I64 j = find(to);
    if (j >= 0) { kinds[j] = NONE; }
    nlen[i] = len(to);
    for k in 0..len(to) { names[128 * i + k] = to[k]; }
    return 0;
}

export I64 fs_unlink(in U8[_] p) {
    I64 i = find(p);
    if (i < 0) { return -2; }
    if (kinds[i] == DIR) { return -21; }
    kinds[i] = NONE;
    return 0;
}

// shctl's calls
export I64 sh_open(in U8[_] path, I64 flags, I64 mode) {
    assert(open_fd < 0);
    if (e_open != 0) {
        I64 e = e_open;
        e_open = 0;
        return e;
    }
    I64 i = find(path);
    if (flags == 0x20800) {
        if (i < 0) { return -2; }
        if (kinds[i] == LINK) { return -40; }
        writing = false;
    } else {
        assert(flags == 0xC1);
        if (i >= 0) { return -17; }
        if (!parent(path)) { return -2; }
        i = node(path, FILE, me, mode, path, 0);
        writing = true;
    }
    open_fd = i;
    pos = 0;
    opens = opens + 1;
    return 10 + i;
}

export I64 fd_read(I64 fd, inout U8[_] buf) {
    assert(fd == 10 + open_fd && !writing);
    if (e_read != 0 && pos >= read_ok) { return e_read; }
    I64 n = sizes[open_fd] - pos;
    if (n > len(buf)) { n = len(buf); }
    if (e_read != 0 && pos + n > read_ok) { n = read_ok - pos; }
    for k in 0..n { buf[k] = data[8300 * open_fd + pos + k]; }
    pos = pos + n;
    return n;
}

export I64 fd_write(I64 fd, in U8[_] bytes) {
    assert(fd == 10 + open_fd && writing);
    I64 n = len(bytes);
    if (short_write) { n = n / 2; }
    for k in 0..n { data[8300 * open_fd + pos + k] = bytes[k]; }
    pos = pos + n;
    sizes[open_fd] = pos;
    return n;
}

export I64 fd_close(I64 fd) {
    assert(fd == 10 + open_fd);
    open_fd = -1;
    closes = closes + 1;
    if (e_close != 0) {
        I64 e = e_close;
        e_close = 0;
        return e;
    }
    return 0;
}
