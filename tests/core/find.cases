# tests/core/find.cases: ARGS | STDIN | DIFF (docs/specs/2026-11-06-c-core.md section 6). The fixture is tree/f: a/b/c.txt
# is a chain of one name each; f and f/e hold several, so a case that lists them is D-4 (walk order).
f | - | D-4
f/a | - | -
f/a/b/c.txt | - | -
f/a/ | - | -
f/a/b/c.txt/ | - | -
f/ -name big.dat | - | -
f -name '*.txt' | - | D-4
f -name '.*' | - | -
f -name '*' | - | D-4
f -name '[bd]*' | - | D-4
f -name '?.txt' | - | D-4
f -name '\*' | - | -
f -path 'f/a/*' | - | -
f/a -path '*b*' | - | -
f -type d | - | D-4
f -type f | - | D-4
f -type l | - | -
f -type f -size 0 | - | D-4
f -size 1c -o -size 1025c | - | D-4
f -size +512c | - | D-4
f -size -513c -type f | - | D-4
f -size +1 | - | D-4
f -size 1 | - | D-41
f -size -1 | - | D-41
f -size 3 | - | D-41
f -mtime -100000 | - | D-4
f -mtime +100000 | - | -
f -atime -100000 -ctime -100000 -type f | - | D-4
f -newer f/a/b/c.txt -name nothing | - | -
f -newer missing | - | -
f -name a -prune -o -print | - | D-4
f -name e -prune -o -type f -print | - | D-4
f ! -name '*.txt' | - | D-4
f \( -name a -o -name b \) -print | - | -
f -name b -print -name b -print | - | -
f -name c.txt -a -type f | - | -
f -print0 | - | D-4
f/a -print0 | - | -
f/a -exec echo X {} \; | - | -
f/a -exec echo [{}] + | - | -
f/a -type f -exec echo {} + | - | -
f -name c.txt -exec cat {} \; | - | -
f -name c.txt -exec false \; -o -name c.txt -print | - | -
f/a -exec nosuch {} \; | - | -
f/a -exec sh -c 'exit 3' \; -print | - | -
f/a -depth | - | -
f/a -depth -prune | - | -
f/a -links 2 | - | -
f/a -type d -links +1 | - | -
f/a/b/c.txt -perm 644 | - | -
f/a/b/c.txt -perm -400 | - | -
f/a/b/c.txt -perm 600 | - | -
f/a -xdev -name c.txt | - | -
-H f/a | - | -
-L f/a | - | -
missing | - | -
f/a missing f/a/b | - | -
f -ok echo {} \; | - | D-42
f -size 1k | - | D-1
f -bogus | - | D-1
f -regex x | - | D-1
f -perm u+r | - | D-1
-P f/a | - | D-1
f -name | - | D-3
f -type x | - | D-3
f/a -exec echo | - | D-3
f ( -name a | - | D-3
f -o | - | D-3
f -size x | - | D-3
