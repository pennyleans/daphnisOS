-f text.txt nonl.txt | - | T
-sf look/a.txt nonl.txt | - | -
look/a.txt | - | T
-s look/sub | - | -
text.txt nonl.txt empty | - | -
look hard | - | -
missing x | - | -
-L text.txt hard | - | D-62 T
-P text.txt hard | - | D-62 T
text.txt box/ | - | T
-x text.txt hard | - | D-1
