// tests/rs/net_proof.ci: RS-SET3's proof, frame 35: QEMU's user network, link up, DHCP; with a third argument D, the
// link down and no address. Theme TH (0 dark, 1 light) at zoom Z (1 or 2). The record is the proof's own, as QEMU
// gives it; the page shows what the host hands it.
// Frame 48: a fourth argument sizes the window (tests/rs/stwin.ci size_of: N 480 x 400, W 976 x 400).
// Run: cint run --root . tests/rs/net_proof.ci -- TH Z [D|-] [N|W]
import user.ci.kit.tokens;
import user.ci.kit.stside;
import user.ci.kit.stnet;
import user.ci.kit.stbox;
import tests.rs.stwin;

U32[2048] row;

export void main(in U8[_] a) {
    I64 th = 0;
    I64 z = 1;
    if (len(a) > 0 && a[0] == '1') { th = 1; }
    if (len(a) > 2 && a[2] == '2') { z = 2; }
    Bool down = len(a) > 4 && a[4] == 'D';
    tokens.set_theme(th);
    U8 sz = '-';
    if (len(a) > 6) { sz = a[6]; }
    stwin.size_of(sz);
    stbox.show(stside.NETWORK);
    U8[6] mac = [0x52 as U8, 0x54 as U8, 0x00 as U8, 0x12 as U8, 0x34 as U8, 0x56 as U8];
    U8[4] addr = [10 as U8, 0 as U8, 2 as U8, 15 as U8];
    U8[4] mask = [255 as U8, 255 as U8, 255 as U8, 0 as U8];
    U8[4] gw = [10 as U8, 0 as U8, 2 as U8, 2 as U8];
    U8[4] dns = [10 as U8, 0 as U8, 2 as U8, 3 as U8];
    U8[4] none = [0 as U8, 0 as U8, 0 as U8, 0 as U8];
    if (down) {
        stnet.set_record(false, mac, none, none, none, none, stnet.DHCP);
    } else {
        stnet.set_record(true, mac, addr, mask, gw, dns, stnet.DHCP);
    }
    stnet.open();
    stbox.set_tall(stnet.tall());
    "frame {stwin.fw() * z} {stwin.fh() * z}\n";
    for dy in 0..stwin.fh() * z {
        I64 y = dy / z;
        stwin.frame_row(row, dy, z);
        if (stwin.in_body(dy, z)) { stnet.row_at(row, stwin.cx(), stbox.y0_at(y), stwin.cr(), stbox.yb_at(y), y); }
        stwin.over_row(row, dy, z);
        stwin.corners_row(row, dy, z);
        stwin.emit(row, stwin.fw() * z);
    }
}
