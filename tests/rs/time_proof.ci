// tests/rs/time_proof.ci: RS-SET4's proof, frame 36: 01:59 on Monday, November 9, 2026 in New York, 24-Hour Time on,
// the week from Sunday; with a third argument P, the Time Zone plate open at New York (frame 47); T, the plate with
// "lo" typed. Theme TH (0 dark, 1 light) at zoom Z (1 or 2).
// Frame 48: a fourth argument sizes the window (tests/rs/stwin.ci size_of: N 480 x 400, W 976 x 400).
// Run: cint run --root . tests/rs/time_proof.ci -- TH Z [P|T|-] [N|W]
import user.ci.kit.tokens;
import user.ci.kit.stside;
import user.ci.kit.sttime;
import user.ci.core.cal;
import user.ci.core.tz;
import user.ci.kit.stbox;
import tests.rs.stwin;

U32[2048] row;

export void main(in U8[_] a) {
    I64 th = 0;
    I64 z = 1;
    if (len(a) > 0 && a[0] == '1') { th = 1; }
    if (len(a) > 2 && a[2] == '2') { z = 2; }
    tokens.set_theme(th);
    U8 sz = '-';
    if (len(a) > 6) { sz = a[6]; }
    stwin.size_of(sz);
    stbox.show(stside.DATETIME);
    sttime.open();
    sttime.set_now(cal.days(2026, 11, 9) * 86400 + 6 * 3600 + 59 * 60);
    sttime.set_zone(tz.find(b"America/New_York"));
    sttime.set_24(true);
    sttime.set_week(0);
    if (len(a) > 4 && (a[4] == 'P' || a[4] == 'T')) { sttime.pick(); }
    if (len(a) > 4 && a[4] == 'T') {
        I64 r = sttime.typed('l');
        r = sttime.typed('o');
    }
    stbox.set_tall(sttime.tall());
    "frame {stwin.fw() * z} {stwin.fh() * z}\n";
    for dy in 0..stwin.fh() * z {
        I64 y = dy / z;
        stwin.frame_row(row, dy, z);
        if (y >= stwin.yb()) { stwin.corners_row(row, dy, z); }   // the plate lies over the window's foot
        if (y >= stwin.y0()) { sttime.row_at(row, stwin.cx(), stbox.y0_at(y), stwin.cr(), stbox.yb_at(y), y); }
        stwin.over_row(row, dy, z);
        if (y < stwin.yb()) { stwin.corners_row(row, dy, z); }
        stwin.emit(row, stwin.fw() * z);
    }
}
