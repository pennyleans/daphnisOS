// tests/rs/view_test.ci: RS-VIEW (docs/specs/2026-11-11-rs-rel-s1-units.md section 3; frame 39, design note 64):
// View's window (user/ci/kit/viewpad.ci): the fit, the zoom ladder about the center, the pan kept inside, the wedge
// bands, the picture laid on the ground, the wedge plate drawn over it and nothing else; and the picture menu of the
// menu kit (kit/ctxmenu.ci, list PICTURE). Run: cint test --root . tests/rs/view_test.ci
import user.ci.kit.tokens;
import user.ci.kit.viewpad;
import user.ci.kit.ctxmenu;

U32[1920] row;
U8[64] px;           // a 4 x 4 RGBA picture

test "a picture opens whole, never above actual size, centered" {
    viewpad.surface(400, 300);
    viewpad.picture(100, 50);                       // smaller than the surface: actual size (frame 48)
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 1);
    assert(viewpad.left() == 150 && viewpad.top() == 125);
    viewpad.surface(1920, 1080);
    viewpad.picture(3840, 2160);                    // a 4K picture in the largest window
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 2 && viewpad.left() == 0 && viewpad.top() == 0);
    assert(!viewpad.larger());
}

test "zoom steps whole scales about the center; Actual Size is 1; the ends hold" {
    viewpad.surface(1920, 1080);
    viewpad.picture(3840, 2160);
    assert(viewpad.zoom_in());                      // 1/2 to 1, the center kept
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 1);
    assert(viewpad.left() == 0 - 960 && viewpad.top() == 0 - 540);
    assert(viewpad.larger());
    assert(viewpad.zoom_in() && viewpad.scale_up() == 2);
    assert(viewpad.actual() && viewpad.scale_up() == 1 && !viewpad.actual());
    assert(viewpad.zoom_out() && viewpad.scale_down() == 2);
    assert(viewpad.zoom_out() && viewpad.scale_down() == 3);
    for k in 0..8 { _ = viewpad.zoom_out(); }
    assert(viewpad.scale_down() == 8 && !viewpad.zoom_out());
    for k in 0..20 { _ = viewpad.zoom_in(); }
    assert(viewpad.scale_up() == 16 && !viewpad.zoom_in());
}

test "a drag pans a larger picture and never past its edges" {
    viewpad.surface(400, 300);
    viewpad.picture(800, 600);
    assert(viewpad.scale_down() == 2 && !viewpad.pan(10, 10));   // it fits: nothing to pan
    assert(viewpad.actual());
    assert(viewpad.left() == 0 - 200 && viewpad.top() == 0 - 150);
    assert(viewpad.pan(50, 0) && viewpad.left() == 0 - 150);
    assert(viewpad.pan(1000, 1000) && viewpad.left() == 0 && viewpad.top() == 0);
    assert(viewpad.pan(0 - 5000, 0 - 5000) && viewpad.left() == 0 - 400 && viewpad.top() == 0 - 300);
    assert(viewpad.src_x(0) == 400 && viewpad.src_y(299) == 599);
}

test "the wedge bands: a sixth of the width, 24 to 96" {
    viewpad.surface(566, 353);
    assert(viewpad.band() == 94);
    assert(viewpad.side_at(0) == 1 && viewpad.side_at(93) == 1 && viewpad.side_at(94) == 0);
    assert(viewpad.side_at(471) == 0 && viewpad.side_at(472) == 2 && viewpad.side_at(565) == 2);
    viewpad.surface(100, 100);
    assert(viewpad.band() == 24);
}

test "the picture lies on the ground, its alpha composed; the wedge covers its plate and nothing else" {
    tokens.set_theme(1);                            // the light ground, so the dark plate shows on it
    for i in 0..16 {
        px[4 * i] = 255;
        px[4 * i + 1] = 0;
        px[4 * i + 2] = 0;
        px[4 * i + 3] = 255;
    }
    px[3] = 0;                                      // pixel (0, 0) clear: the ground shows
    viewpad.surface(200, 100);
    viewpad.picture(4, 4);                          // actual size: 4 x 4 from (98, 48)
    assert(viewpad.scale_up() == 1 && viewpad.left() == 98 && viewpad.top() == 48);
    for i in 0..7 { assert(viewpad.zoom_in()); }    // 2, 3, 4, 6, 8, 12, 16: 64 x 64 from (68, 18)
    assert(viewpad.scale_up() == 16 && viewpad.left() == 68 && viewpad.top() == 18);
    viewpad.picture_row(row, 18, 1, px);
    assert(row[10] == tokens.word(tokens.MANTLE) && row[68] == tokens.word(tokens.MANTLE));
    assert(row[84] == 0xff0000 && row[131] == 0xff0000 && row[132] == tokens.word(tokens.MANTLE));
    viewpad.picture_row(row, 50, 1, px);
    U32 before = row[180];
    U32 inside = row[199];
    viewpad.wedge_row(row, 50, 2, 1);               // the plate is x 164 to 200, y 6 to 94
    assert(row[180] != before && row[163] == tokens.word(tokens.MANTLE));
    assert(row[199] != inside);
    viewpad.picture_row(row, 2, 1, px);
    U32 above = row[180];
    viewpad.wedge_row(row, 2, 2, 1);
    assert(row[180] == above);                      // above the plate: untouched
}

test "with no picture: the window body's PAPER, the symbol and the line in INK_DIM" {
    tokens.set_theme(0);
    viewpad.surface(viewpad.EMPTY_W, viewpad.EMPTY_H);
    viewpad.empty_row(row, 0, 1, b"No picture is open.");
    assert(row[0] == tokens.word(tokens.PAPER) && row[457] == tokens.word(tokens.PAPER));
    Bool marked = false;
    for y in 105..140 {
        viewpad.empty_row(row, y, 1, b"No picture is open.");
        for x in 0..458 {
            if (row[x] != tokens.word(tokens.PAPER)) { marked = true; }
        }
    }
    assert(marked);
}

test "the picture menu: 200 wide, no strip; zoom, the picture's rows, Properties; a dimmed row takes no press" {
    ctxmenu.begin(ctxmenu.PICTURE, false);
    ctxmenu.row_dim(ctxmenu.PROPERTIES);
    ctxmenu.open_at(40, 30, 0, 0, 566, 353, false);
    assert(ctxmenu.width() == 200 && ctxmenu.slots() == 0 && ctxmenu.rows() == 6);
    assert(ctxmenu.row_act(0) == ctxmenu.ZOOM_IN && ctxmenu.row_act(2) == ctxmenu.ACTUAL_SIZE);
    assert(ctxmenu.row_act(3) == ctxmenu.SET_BACKGROUND && ctxmenu.row_act(4) == ctxmenu.SHOW_IN_INDEX);
    assert(ctxmenu.row_act(5) == ctxmenu.PROPERTIES && ctxmenu.row_off(5) && !ctxmenu.row_off(3));
    // 6 + 3 rows + a divider + 2 rows + a divider + 1 row + 6
    assert(ctxmenu.height() == 6 + 6 * 28 + 2 * 11 + 6);
    U8[32] w;
    assert(ctxmenu.words(ctxmenu.SET_BACKGROUND, w) == 17 && w[0] == 'S' && w[16] == 'd');
    I64 y5 = ctxmenu.row_top(5) + 4;
    assert(ctxmenu.click(60, y5) == ctxmenu.STAY);
    I64 y0 = ctxmenu.row_top(0) + 4;
    assert(ctxmenu.click(60, y0) == ctxmenu.ZOOM_IN);
}
test "the surface asked: the picture, at least the wedges' and the picture menu's size, at most 1920 x 1080" {
    ctxmenu.begin(ctxmenu.PICTURE, false);
    ctxmenu.open_at(0, 0, 0, 0, 1920, 1080, false);
    I64 mw = ctxmenu.width();
    I64 mh = ctxmenu.height();
    ctxmenu.close();
    assert(mw == 200 && mh == 202);
    assert(viewpad.want_w(100, false, mw) == 200 && viewpad.want_h(100, false, mh) == 202);   // a lone 100 x 100
    assert(viewpad.want_w(100, true, mw) == 200 && viewpad.want_h(100, true, mh) == 202);
    assert(viewpad.want_w(640, true, mw) == 640 && viewpad.want_h(480, true, mh) == 480);
    assert(viewpad.want_w(4000, false, mw) == 1920 && viewpad.want_h(3000, false, mh) == 1080);
    viewpad.surface(200, 202);                                     // the 100 x 100 at actual size, centered
    viewpad.picture(100, 100);
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 1 && viewpad.left() == 50 && viewpad.top() == 51);
    ctxmenu.open_at(150, 150, 0, 0, 200, 202, false);              // a click anywhere: the whole menu inside
    assert(ctxmenu.left() == 0 && ctxmenu.top() == 0);
    ctxmenu.close();
}
test "RS-SURF: a new box fits the picture whole again; a hand zoom keeps its scale; under 320 x 240 lays out at it" {
    viewpad.surface(458, 267);
    viewpad.picture(800, 600);
    assert(viewpad.scale_down() == 3);                        // 800 / 458: 1/2 is too large, 1/3 fits
    viewpad.resurface(1916, 1052);
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 1 && viewpad.left() == (1916 - 800) / 2);
    viewpad.resurface(500, 400);
    assert(viewpad.scale_down() == 2 && viewpad.left() == (500 - 400) / 2);
    assert(viewpad.zoom_in());                                // by hand: 1
    viewpad.resurface(1916, 1052);
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 1);
    viewpad.resurface(300, 200);                              // kept, held inside a 320 x 240 layout
    assert(viewpad.scale_up() == 1 && viewpad.scale_down() == 1 && viewpad.left() == 0 && viewpad.top() == 0);
    viewpad.picture(100, 50);                                 // a new picture is fitted again
    viewpad.resurface(300, 200);
    assert(viewpad.left() == (320 - 100) / 2 && viewpad.top() == (240 - 50) / 2);
}

