// tests/rs/grants_proof.ci: the Grants page's proof, frame 21: Fetch on the network, Edit on the disk and then the
// network (two lines, one Revoke), Console on the disk; with a third argument E, no grant. Theme TH (0 dark, 1
// light) at zoom Z (1 or 2); a fourth argument sizes the window (tests/rs/stwin.ci size_of: N 480 x 400, W 976 x 400).
// Run: cint run --root . tests/rs/grants_proof.ci -- TH Z [E|-] [N|W]
import user.ci.kit.tokens;
import user.ci.kit.stside;
import user.ci.kit.stgrant;
import user.ci.kit.stbox;
import tests.rs.stwin;

U32[2048] row;

void put(I64 w, in U8[_] nm, I64 b, in U8[_] t, in U8[_] o) {
    Bool ok = stgrant.line(w, nm, len(nm), b, t, len(t), o, len(o));
}

export void main(in U8[_] a) {
    I64 th = 0;
    I64 z = 1;
    if (len(a) > 0 && a[0] == '1') { th = 1; }
    if (len(a) > 2 && a[2] == '2') { z = 2; }
    tokens.set_theme(th);
    U8 sz = '-';
    if (len(a) > 6) { sz = a[6]; }
    stwin.size_of(sz);
    stbox.show(stside.GRANTS);
    stgrant.open();
    stgrant.lines_clear();
    if (!(len(a) > 4 && a[4] == 'E')) {
        put(4, b"Fetch", stgrant.NET, b"01:42", b"fetch example.org");
        put(2, b"Edit", stgrant.DISK, b"01:51", b"ced /home/ci/notes.txt");
        put(2, b"Edit", stgrant.NET, b"01:53", b"");
        put(7, b"Console", stgrant.DISK, b"01:58", b"");
    }
    stgrant.refreshed();
    stbox.set_tall(stgrant.tall());
    "frame {stwin.fw() * z} {stwin.fh() * z}\n";
    for dy in 0..stwin.fh() * z {
        I64 y = dy / z;
        stwin.frame_row(row, dy, z);
        if (stwin.in_body(dy, z)) { stgrant.row_at(row, stwin.cx(), stbox.y0_at(y), stwin.cr(), stbox.yb_at(y), y); }
        stwin.over_row(row, dy, z);
        stwin.corners_row(row, dy, z);
        stwin.emit(row, stwin.fw() * z);
    }
}
