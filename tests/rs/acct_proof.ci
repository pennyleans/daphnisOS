// tests/rs/acct_proof.ci: RS-SET2's proof, frame 34: ci (Parent, signed in) and sam (Child, Disk and Sound), sam
// chosen; with a third argument L, ci alone and chosen, the last Parent's rows at 40 percent. Theme TH (0 dark,
// 1 light) at zoom Z (1 or 2).
// Frame 48: a fourth argument sizes the window (tests/rs/stwin.ci size_of: N 480 x 400, W 976 x 400); with a
// fifth, S, the page is lifted one wheel notch under its title; K, the keyboard on Remove Account (Shift+Tab from the
// sidebar), lifted to it.
// Run: cint run --root . tests/rs/acct_proof.ci -- TH Z [L|-] [N|W|-] [S|K]
import user.ci.kit.tokens;
import user.ci.kit.stside;
import user.ci.kit.stacct;
import user.ci.kit.stbox;
import tests.rs.stwin;

U32[2048] row;

export void main(in U8[_] a) {
    I64 th = 0;
    I64 z = 1;
    if (len(a) > 0 && a[0] == '1') { th = 1; }
    if (len(a) > 2 && a[2] == '2') { z = 2; }
    Bool last = len(a) > 4 && a[4] == 'L';
    tokens.set_theme(th);
    U8 sz = '-';
    if (len(a) > 6) { sz = a[6]; }
    stwin.size_of(sz);
    stbox.show(stside.ACCOUNTS);
    I64 cx = stwin.cx();
    I64 y0 = stwin.y0();
    I64 cr = stwin.cr();
    I64 yb = stwin.yb();
    stacct.accounts_clear();
    Bool b = stacct.account(b"ci", 2, 1000, stacct.PARENT, stacct.ALL, true);
    if (!last) { b = stacct.account(b"sam", 3, 1001, stacct.CHILD, stacct.DISK | stacct.AUDIO, false); }
    stacct.open();
    if (!last) { I64 c = stacct.click(cx, y0, cr, yb, cx + 100, y0 + 68 + stacct.PILL_PITCH + 20); }
    stbox.set_tall(stacct.tall());
    if (len(a) > 8 && a[8] == 'S') { Bool m = stbox.scroll(cx, 1); }
    if (len(a) > 8 && a[8] == 'K') {
        Bool e = stacct.enter_last();
        Bool m = stbox.reveal(stacct.focus_top(), stacct.focus_bottom());
    }
    "frame {stwin.fw() * z} {stwin.fh() * z}\n";
    for dy in 0..stwin.fh() * z {
        I64 y = dy / z;
        stwin.frame_row(row, dy, z);
        if (stwin.in_body(dy, z)) { stacct.row_at(row, cx, stbox.y0_at(y), cr, stbox.yb_at(y), y); }
        stwin.over_row(row, dy, z);
        stwin.corners_row(row, dy, z);
        stwin.emit(row, stwin.fw() * z);
    }
}
