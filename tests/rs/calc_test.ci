// tests/rs/calc_test.ci: RS-CALC (docs/specs/2026-11-11-rs-rel-s1-units.md section 3; frame 39): the arithmetic ccalc
// and Calc share (user/ci/core/calc.ci) and Calc's model (user/ci/kit/calcpad.ci): keys, typing, `=`, the tape, the
// preview that keeps nothing, and where the keys are. Run: cint test --root . tests/rs/calc_test.ci
import user.ci.core.calc;
import user.ci.kit.calcpad;

U8[256] b;

Bool same(I64 n, in U8[_] want) {
    if (n != len(want)) { return false; }
    for i in 0..n {
        if (b[i] != want[i]) { return false; }
    }
    return true;
}

Bool eval_to(in U8[_] line, in U8[_] want) {
    I64 r = calc.line(line, len(line));
    if (r != calc.VALUE) { return false; }
    return same(calc.value_text(calc.m(), calc.s(), calc.marked(), b), want);
}

void keys(in U8[_] s) {
    for i in 0..len(s) { calcpad.typed(s[i]); }
}

test "core/calc: ccalc's arithmetic, values, marks, hex, names and failures by name" {
    calc.forget();
    assert(eval_to(b"12 * 4", b"48"));
    assert(eval_to(b"48 / 7", b"~6.857142857"));
    assert(eval_to(b"(1920 - 720) / 2", b"600"));
    assert(eval_to(b"0.1 + 0.2", b"0.3"));
    assert(eval_to(b"-7 % 3", b"2"));            // the rest is never negative, as ccalc prints
    assert(eval_to(b"_ * 2", b"4"));
    assert(calc.line(b"hex 255", 7) == calc.HEX && same(calc.hex_text(calc.hex_value(), b), b"0xff"));
    assert(calc.line(b"x = 3", 5) == calc.SET && eval_to(b"x * x", b"9"));
    assert(calc.line(b"scale = 2", 9) == calc.SET && eval_to(b"1 / 3", b"~0.33"));
    assert(calc.line(b"2 ^ 63", 6) == calc.E_DEC - 1 && same(calc.error_text(calc.E_DEC - 1, b), b"overflow"));
    assert(calc.line(b"2 ^ 64", 6) == calc.E_DEC - 4);   // frame 39 draws 2 ^ 64 on the tape; I64 cannot hold it
    assert(calc.line(b"7 / 0", 5) == calc.E_DEC - 2 && same(calc.error_text(calc.E_DEC - 2, b), b"division by zero"));
    assert(calc.line(b"1 +", 3) == calc.E_SYNTAX && same(calc.error_text(calc.E_SYNTAX, b), b"syntax at column 4"));
    assert(calc.line(b"nope + 1", 8) == calc.E_NAME && calc.name_from() == 0 && calc.name_to() == 4);
    assert(calc.line(b"   ", 3) == calc.BLANK);
}

test "core/calc: a preview keeps nothing: no name, no scale, no last value" {
    calc.forget();
    assert(eval_to(b"5", b"5"));
    assert(calc.preview(b"y = 9", 5) == calc.SET);
    assert(calc.line(b"y", 1) == calc.E_NAME);
    assert(calc.preview(b"scale = 1", 9) == calc.SET && calc.scale() == 9);
    assert(calc.preview(b"40 + 2", 6) == calc.VALUE && calc.m() == 42);
    assert(eval_to(b"_", b"5"));
}

test "RS-CALC: the keypad builds a literal line; = puts it on the tape and keeps line and result" {
    calcpad.reset();
    calcpad.press(12);                           // 1
    calcpad.press(13);                           // 2
    calcpad.press(calcpad.K_MUL);
    calcpad.press(8);                            // 4
    assert(same(calcpad.line_text(b), b"12 * 4"));
    assert(same(calcpad.result_text(b), b"48"));    // the preview
    calcpad.press(calcpad.K_EQUALS);
    assert(calcpad.tape_lines() == 1 && same(calcpad.tape_line(0, b), b"12 * 4") && same(calcpad.tape_result(0, b), b"48"));
    assert(same(calcpad.line_text(b), b"12 * 4") && same(calcpad.result_text(b), b"48"));
    calcpad.press(calcpad.K_MUL);                // an operator goes on from the result
    assert(same(calcpad.line_text(b), b"48 * "));
    calcpad.press(calcpad.K_ERASE);
    assert(same(calcpad.line_text(b), b"48"));
    calcpad.press(calcpad.K_DIV);
    calcpad.press(4);                            // 7
    calcpad.press(calcpad.K_EQUALS);
    assert(same(calcpad.result_text(b), b"~6.857142857"));
    calcpad.press(calcpad.K_MUL);                // the digits go on; the mark does not
    assert(same(calcpad.line_text(b), b"6.857142857 * "));
    calcpad.press(calcpad.K_CLEAR);
    assert(calcpad.line_text(b) == 0 && calcpad.result_text(b) == 0 && calcpad.tape_lines() == 2);
}

test "RS-CALC: minus where an operand is due is a sign; a digit after = starts a new line" {
    calcpad.reset();
    calcpad.press(calcpad.K_SUB);
    calcpad.press(10);                           // 6
    assert(same(calcpad.line_text(b), b"-6"));
    calcpad.press(calcpad.K_EQUALS);
    calcpad.press(16);                           // 0 after = : a new line
    assert(same(calcpad.line_text(b), b"0"));
    calcpad.press(calcpad.K_OPEN);
    calcpad.press(calcpad.K_SUB);
    assert(same(calcpad.line_text(b), b"0(-"));
}

test "RS-CALC: typing is the field: ^, %, &, |, shifts and names; a failure shows its words and is not taped" {
    calcpad.reset();
    keys(b"2^10");
    assert(same(calcpad.result_text(b), b"1024"));
    calcpad.equals();
    keys(b" >> 2");                              // an operator after = goes on from the result
    assert(same(calcpad.line_text(b), b"1024 >> 2") && same(calcpad.result_text(b), b"256"));
    calcpad.clear();
    keys(b"7 / 0");
    assert(calcpad.result_text(b) == 0);         // no preview of a failure
    calcpad.equals();
    assert(calcpad.failed() && same(calcpad.result_text(b), b"division by zero") && calcpad.tape_lines() == 1);
    keys(b"5");                                  // a new line after a failure
    assert(same(calcpad.line_text(b), b"5") && !calcpad.failed());
    calcpad.clear();
    keys(b"1-4");
    calcpad.equals();
    keys(b"^2");                                 // a negative result goes on in parentheses: ^ binds before the sign
    assert(same(calcpad.line_text(b), b"(-3)^2") && same(calcpad.result_text(b), b"9"));
}

test "RS-CALC: = typed after a name alone sets the name; anywhere else it evaluates" {
    calcpad.reset();
    keys(b"rate");
    calcpad.typed_equals();
    assert(same(calcpad.line_text(b), b"rate = "));
    keys(b"12");
    calcpad.typed_equals();                      // a set keeps no result and is taped as the line alone
    assert(calcpad.result_text(b) == 0 && calcpad.tape_lines() == 1 && same(calcpad.tape_line(0, b), b"rate = 12"));
    keys(b"rate * 3");
    calcpad.typed_equals();
    assert(same(calcpad.result_text(b), b"36") && calcpad.tape_lines() == 2);
    keys(b"hex 255");
    calcpad.typed_equals();
    assert(same(calcpad.result_text(b), b"0xff"));
}

test "RS-CALC: the tape keeps the last three, newest last; a click puts a line back" {
    calcpad.reset();
    for v in 1..5 {
        calcpad.typed((v + 48) as U8);
        calcpad.equals();
    }
    assert(calcpad.tape_lines() == 3 && same(calcpad.tape_line(0, b), b"2") && same(calcpad.tape_line(2, b), b"4"));
    I64 h = calcpad.hit(200, 12 + 18 * 0 + 5);   // the top row holds the oldest of three
    assert(h == calcpad.TAPE_HIT + 0);
    calcpad.tape_back(h - calcpad.TAPE_HIT);
    assert(same(calcpad.line_text(b), b"2") && same(calcpad.result_text(b), b"2"));
    calcpad.clear_tape();
    assert(calcpad.tape_lines() == 0 && calcpad.hit(200, 17) == -1);
}

test "RS-CALC: the keys sit on frame 39's grid: 60 x 44 at a 66 x 50 pitch from (14, 162)" {
    assert(calcpad.hit(14, 162) == calcpad.K_CLEAR && calcpad.hit(73, 205) == calcpad.K_CLEAR);
    assert(calcpad.hit(74, 162) == -1 && calcpad.hit(80, 162) == calcpad.K_OPEN);
    assert(calcpad.hit(212, 362) == calcpad.K_EQUALS && calcpad.hit(271, 405) == calcpad.K_EQUALS);
    assert(calcpad.hit(212, 406) == -1);
    assert(calcpad.key_x(calcpad.K_ERASE) == 146 && calcpad.key_y(calcpad.K_ERASE) == 362);
}
