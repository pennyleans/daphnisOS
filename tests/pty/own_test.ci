// tests/pty/own_test.ci: hosted tests of whose a pty's slave is (the plan's P1 of 2026-11-11, src/ptyown.ci; docs/user.md
// section 19). Run by check.sh: cint test --root . tests/pty/own_test.ci
// may(desk, ctty, master, ofam, osid, fam, sid): 0, or -13 (-EACCES); room(desk, held, pairs): 0, or -28 (-ENOSPC).

import src.ptyown;

test "the desk's window: its shell and the shell's jobs may, another window's shell and another account may not" {
    // the desk made the pair; its child, after setsid and before execve, still holds the master and is the first to
    // open the slave (session 4 of family 1)
    assert(ptyown.may(false, false, true, -1, 0, 1, 4) == 0);
    // the owner is now session 4; the shell, after login and execve (the master closed with O_CLOEXEC), its terminal
    assert(ptyown.may(false, true, false, 1, 4, 1, 4) == 0);
    // a background job of the session: its terminal too, or, after it let it go, still of the session
    assert(ptyown.may(false, false, false, 1, 4, 1, 4) == 0);
    // the same account's shell in another window (session 9), or another account's process (session 12): -EACCES
    assert(ptyown.may(false, false, false, 1, 4, 1, 9) == -13);
    assert(ptyown.may(false, false, false, 1, 4, 1, 12) == -13);
    // the desk itself
    assert(ptyown.may(true, false, false, 1, 4, 1, 1) == 0);
}

test "before the first open: a holder of the master alone, so no other window can take a fresh pair in the gap" {
    assert(ptyown.may(false, false, true, -1, 0, 1, 7) == 0);            // the maker, or its child before execve
    assert(ptyown.may(false, false, false, -1, 0, 1, 7) == -13);         // a uid 0 shell of another window looping
    assert(ptyown.may(false, false, false, -1, 0, 1, 4) == -13);         //   over /dev/pts/0..7, whatever its session
    assert(ptyown.may(true, false, false, -1, 0, 1, 1) == 0);            // the desk
    assert(ptyown.may(false, true, false, -1, 0, 1, 7) == 0);            // its terminal already (TIOCSCTTY's own rule)
}

test "the owner is a session of a family: the same session number in another family is another session" {
    assert(ptyown.may(false, false, false, 1, 5, 2, 5) == -13);
    assert(ptyown.may(false, false, false, 1, 5, 1, 5) == 0);
}

test "over a small range: past the first open, the owner session, the controlling terminal or the desk, nothing else" {
    for fam in 0..3 {
        for sid in 0..9 {
            for m in 0..2 {
                Bool master = m == 1;
                Bool owner = fam == 1 && sid == 5;
                assert((ptyown.may(false, false, master, 1, 5, fam, sid) == 0) == owner);
                assert((ptyown.may(false, false, master, 1, 5, fam, sid) == -13) == !owner);
                assert(ptyown.may(true, false, master, 1, 5, fam, sid) == 0);
                assert(ptyown.may(false, true, master, 1, 5, fam, sid) == 0);
                assert((ptyown.may(false, false, master, -1, 0, fam, sid) == 0) == master);
            }
        }
    }
}

test "pairs a uid may make: all but two of the kernel's 8 while it is not the desk, so two stay the desk's" {
    for held in 0..6 {
        assert(ptyown.room(false, held, 8) == 0);
    }
    assert(ptyown.room(false, 6, 8) == -28);           // a Child's program kept 6 across a log out: the 7th is refused
    assert(ptyown.room(false, 7, 8) == -28);
    assert(ptyown.room(false, 8, 8) == -28);
    for held in 0..9 {
        assert(ptyown.room(true, held, 8) == 0);       // the desk takes any free pair, the last two included
    }
    assert(ptyown.room(false, 0, 2) == -28);           // a kernel of 2 pairs: both the desk's
    assert(ptyown.room(false, 0, 3) == 0);
    assert(ptyown.room(false, 1, 3) == -28);
}
