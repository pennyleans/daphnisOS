    assert(pair(50, false, true, 36, false, false, false, b"\xc2\xb4j"));   // j
    assert(pair(50, false, true, 37, false, false, false, b"\xc2\xb4k"));   // k
    assert(pair(50, false, true, 38, false, false, false, b"\xc2\xb4l"));   // l
    assert(pair(50, false, true, 39, false, false, false, b"\xc2\xb4m"));   // m
    assert(pair(50, false, true, 49, false, false, false, b"\xc2\xb4n"));   // n
    assert(pair(50, false, true, 24, false, false, false, b"\xc3\xb3"));   // o
    assert(pair(50, false, true, 25, false, false, false, b"\xc2\xb4p"));   // p
    assert(pair(50, false, true, 30, false, false, false, b"\xc2\xb4q"));   // q
    assert(pair(50, false, true, 19, false, false, false, b"\xc2\xb4r"));   // r
    assert(pair(50, false, true, 31, false, false, false, b"\xc2\xb4s"));   // s
    assert(pair(50, false, true, 20, false, false, false, b"\xc2\xb4t"));   // t
    assert(pair(50, false, true, 22, false, false, false, b"\xc3\xba"));   // u
    assert(pair(50, false, true, 47, false, false, false, b"\xc2\xb4v"));   // v
    assert(pair(50, false, true, 44, false, false, false, b"\xc2\xb4w"));   // w
    assert(pair(50, false, true, 45, false, false, false, b"\xc2\xb4x"));   // x
    assert(pair(50, false, true, 21, false, false, false, b"\xc3\xbd"));   // y
    assert(pair(50, false, true, 17, false, false, false, b"\xc2\xb4z"));   // z
    assert(pair(50, false, true, 57, false, false, false, b"\xc2\xb4"));   // space: the accent
    assert(pair(50, false, true, 57, true, false, false, b"\xc2\xb4"));   // Shift+space: the accent
    assert(pair(50, false, true, 2, false, false, false, b"\xc2\xb4&"));   // the key of code 2
    assert(pair(50, false, true, 5, false, false, true, b"\xc2\xb4\x7b"));   // AltGr at code 5
    assert(pair(50, false, true, 28, false, false, false, b"\xc2\xb4\x0d"));   // Enter
    assert(pair(50, false, true, 14, false, false, false, b"\xc2\xb4\x7f"));   // Backspace
    assert(pair(50, false, true, 103, false, false, false, b"\xc2\xb4\x1b[A"));   // Up
    assert(pair(50, false, true, 46, false, true, false, b"\xc2\xb4\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(50, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xc3\x89") && equal(got[0..n], b"\xc3\x89") && !keymap.dead_pending());   // E
    assert(dead(50, false, true));
    n = keymap.key_utf8(26, false, false, false, got);   // dead_circumflex
    assert(n == len(b"\xc2\xb4") && equal(got[0..n], b"\xc2\xb4") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"^") && equal(got[0..n], b"^") && !keymap.dead_pending());
}

