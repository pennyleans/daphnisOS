    assert(pair(27, false, true, 2, false, false, false, b"~1"));   // the key of code 2
    assert(pair(27, false, true, 5, false, false, true, b"~\xe2\x82\xac"));   // AltGr at code 5
    assert(pair(27, false, true, 28, false, false, false, b"~\x0d"));   // Enter
    assert(pair(27, false, true, 14, false, false, false, b"~\x7f"));   // Backspace
    assert(pair(27, false, true, 103, false, false, false, b"~\x1b[A"));   // Up
    assert(pair(27, false, true, 46, false, true, false, b"~\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(27, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"~E") && equal(got[0..n], b"~E") && !keymap.dead_pending());   // E
    assert(dead(27, false, true));
    n = keymap.key_utf8(13, false, false, true, got);   // dead_cedilla
    assert(n == len(b"~") && equal(got[0..n], b"~") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xb8") && equal(got[0..n], b"\xc2\xb8") && !keymap.dead_pending());
}

