    assert(pair(36, false, true, 44, false, false, false, b"\xcc\x89z"));   // z
    assert(pair(36, false, true, 57, false, false, false, b"\xcc\x89"));   // space: the accent
    assert(pair(36, false, true, 57, true, false, false, b"\xcc\x89"));   // Shift+space: the accent
    assert(pair(36, false, true, 2, false, false, false, b"\xcc\x891"));   // the key of code 2
    assert(pair(36, false, true, 5, false, false, true, b"\xcc\x89~"));   // AltGr at code 5
    assert(pair(36, false, true, 28, false, false, false, b"\xcc\x89\x0d"));   // Enter
    assert(pair(36, false, true, 14, false, false, false, b"\xcc\x89\x7f"));   // Backspace
    assert(pair(36, false, true, 103, false, false, false, b"\xcc\x89\x1b[A"));   // Up
    assert(pair(36, false, true, 46, false, true, false, b"\xcc\x89\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(36, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xcc\x89E") && equal(got[0..n], b"\xcc\x89E") && !keymap.dead_pending());   // E
    assert(dead(36, false, true));
    n = keymap.key_utf8(13, false, false, true, got);   // dead_cedilla
    assert(n == len(b"\xcc\x89") && equal(got[0..n], b"\xcc\x89") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xb8") && equal(got[0..n], b"\xc2\xb8") && !keymap.dead_pending());
}

