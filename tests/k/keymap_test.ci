// tests/k/keymap_test.ci: hosted tests of the keyboard layouts of K-11b (user/ci/keymap.ci; docs/specs/
// 2026-11-07-k-kit2.md section 3h). The expectations come from the same layout definitions as keymap.ci's
// tables (xkeyboard-config 2.42), through a Python twin of key_utf8; the anchors at the end are by hand.
// Run by check.sh: cint test --root . tests/k/keymap_test.ci

import user.ci.keymap;

// The bytes of one press, with no dead key waiting before or after, equal want.
Bool is(I64 code, Bool shift, Bool ctrl, Bool altgr, in U8[_] want) {
    keymap.dead_clear();
    U8[16] got;
    I64 n = keymap.key_utf8(code, shift, ctrl, altgr, got);
    return n == len(want) && equal(got[0..n], want) && !keymap.dead_pending();
}

// A dead key at code dc gives nothing and waits.
Bool dead(I64 dc, Bool ds, Bool da) {
    keymap.dead_clear();
    U8[16] got;
    return keymap.key_utf8(dc, ds, false, da, got) == 0 && keymap.dead_pending();
}

// The dead key at code dc, then the key at code: the second press gives want and nothing waits after it.
Bool pair(I64 dc, Bool ds, Bool da, I64 code, Bool shift, Bool ctrl, Bool altgr, in U8[_] want) {
    if (!dead(dc, ds, da)) { return false; }
    U8[16] got;
    I64 n = keymap.key_utf8(code, shift, ctrl, altgr, got);
    return n == len(want) && equal(got[0..n], want) && !keymap.dead_pending();
}

test "GB: every key of the rows, plain, Shift and AltGr; Shift with AltGr gives nothing" {
    keymap.set_layout(keymap.GB);
    assert(keymap.layout() == keymap.GB && keymap.has_altgr());
    assert(is(2, false, false, false, b"1"));
    assert(is(2, true, false, false, b"!"));
    assert(is(2, false, false, true, b"\xc2\xb9"));
    assert(is(2, true, false, true, b""));
    assert(is(3, false, false, false, b"2"));
    assert(is(3, true, false, false, b"\x22"));
    assert(is(3, false, false, true, b"\xc2\xb2"));
    assert(is(3, true, false, true, b""));
    assert(is(4, false, false, false, b"3"));
    assert(is(4, true, false, false, b"\xc2\xa3"));
    assert(is(4, false, false, true, b"\xc2\xb3"));
    assert(is(4, true, false, true, b""));
    assert(is(5, false, false, false, b"4"));
    assert(is(5, true, false, false, b"$"));
    assert(is(5, false, false, true, b"\xe2\x82\xac"));
    assert(is(5, true, false, true, b""));
    assert(is(6, false, false, false, b"5"));
    assert(is(6, true, false, false, b"%"));
    assert(is(6, false, false, true, b"\xc2\xbd"));
    assert(is(6, true, false, true, b""));
    assert(is(7, false, false, false, b"6"));
    assert(is(7, true, false, false, b"^"));
    assert(is(7, false, false, true, b"\xc2\xbe"));
    assert(is(7, true, false, true, b""));
    assert(is(8, false, false, false, b"7"));
    assert(is(8, true, false, false, b"&"));
    assert(is(8, false, false, true, b"\x7b"));
    assert(is(8, true, false, true, b""));
    assert(is(9, false, false, false, b"8"));
    assert(is(9, true, false, false, b"*"));
    assert(is(9, false, false, true, b"["));
    assert(is(9, true, false, true, b""));
    assert(is(10, false, false, false, b"9"));
    assert(is(10, true, false, false, b"("));
    assert(is(10, false, false, true, b"]"));
    assert(is(10, true, false, true, b""));
    assert(is(11, false, false, false, b"0"));
    assert(is(11, true, false, false, b")"));
    assert(is(11, false, false, true, b"\x7d"));
    assert(is(11, true, false, true, b""));
    assert(is(12, false, false, false, b"-"));
    assert(is(12, true, false, false, b"_"));
    assert(is(12, false, false, true, b"\x5c"));
    assert(is(12, true, false, true, b""));
    assert(is(13, false, false, false, b"="));
    assert(is(13, true, false, false, b"+"));
    assert(dead(13, false, true));   // dead_cedilla
    assert(is(13, true, false, true, b""));
    assert(is(16, false, false, false, b"q"));
    assert(is(16, true, false, false, b"Q"));
    assert(is(16, false, false, true, b"@"));
    assert(is(16, true, false, true, b""));
    assert(is(17, false, false, false, b"w"));
    assert(is(17, true, false, false, b"W"));
    assert(is(17, false, false, true, b"\xc5\xbf"));
    assert(is(17, true, false, true, b""));
    assert(is(18, false, false, false, b"e"));
    assert(is(18, true, false, false, b"E"));
    assert(is(18, false, false, true, b"e"));
    assert(is(18, true, false, true, b""));
    assert(is(19, false, false, false, b"r"));
    assert(is(19, true, false, false, b"R"));
    assert(is(19, false, false, true, b"\xc2\xb6"));
    assert(is(19, true, false, true, b""));
    assert(is(20, false, false, false, b"t"));
    assert(is(20, true, false, false, b"T"));
    assert(is(20, false, false, true, b"\xc5\xa7"));
    assert(is(20, true, false, true, b""));
    assert(is(21, false, false, false, b"y"));
    assert(is(21, true, false, false, b"Y"));
    assert(is(21, false, false, true, b"\xe2\x86\x90"));
    assert(is(21, true, false, true, b""));
    assert(is(22, false, false, false, b"u"));
    assert(is(22, true, false, false, b"U"));
    assert(is(22, false, false, true, b"\xe2\x86\x93"));
