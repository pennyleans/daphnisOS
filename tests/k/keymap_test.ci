test "FR: every key of the rows, plain, Shift and AltGr; Shift with AltGr gives nothing" {
    keymap.set_layout(keymap.FR);
    assert(keymap.layout() == keymap.FR && keymap.has_altgr());
    assert(is(2, false, false, false, b"&"));
    assert(is(2, true, false, false, b"1"));
    assert(is(2, false, false, true, b"\xc2\xb9"));
    assert(is(2, true, false, true, b""));
    assert(is(3, false, false, false, b"\xc3\xa9"));
    assert(is(3, true, false, false, b"2"));
    assert(is(3, false, false, true, b"~"));
    assert(is(3, true, false, true, b""));
    assert(is(4, false, false, false, b"\x22"));
    assert(is(4, true, false, false, b"3"));
    assert(is(4, false, false, true, b"#"));
    assert(is(4, true, false, true, b""));
    assert(is(5, false, false, false, b"'"));
    assert(is(5, true, false, false, b"4"));
    assert(is(5, false, false, true, b"\x7b"));
    assert(is(5, true, false, true, b""));
    assert(is(6, false, false, false, b"("));
    assert(is(6, true, false, false, b"5"));
    assert(is(6, false, false, true, b"["));
    assert(is(6, true, false, true, b""));
