    assert(pair(13, false, true, 2, false, false, false, b"\xc2\xb81"));   // the key of code 2
    assert(pair(13, false, true, 5, false, false, true, b"\xc2\xb8~"));   // AltGr at code 5
    assert(pair(13, false, true, 28, false, false, false, b"\xc2\xb8\x0d"));   // Enter
    assert(pair(13, false, true, 14, false, false, false, b"\xc2\xb8\x7f"));   // Backspace
    assert(pair(13, false, true, 103, false, false, false, b"\xc2\xb8\x1b[A"));   // Up
    assert(pair(13, false, true, 46, false, true, false, b"\xc2\xb8\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(13, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xc2\xb8E") && equal(got[0..n], b"\xc2\xb8E") && !keymap.dead_pending());   // E
    assert(dead(13, false, true));
    n = keymap.key_utf8(26, false, false, false, got);   // dead_grave
    assert(n == len(b"\xc2\xb8") && equal(got[0..n], b"\xc2\xb8") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"`") && equal(got[0..n], b"`") && !keymap.dead_pending());
}

