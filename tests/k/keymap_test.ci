}

test "GB: dead_cedilla (code 13, AltGr) with every letter, space and other keys" {
    keymap.set_layout(keymap.GB);
    assert(pair(13, false, true, 30, true, false, false, b"\xc2\xb8A"));   // A
    assert(pair(13, false, true, 48, true, false, false, b"\xc2\xb8B"));   // B
    assert(pair(13, false, true, 46, true, false, false, b"\xc3\x87"));   // C
    assert(pair(13, false, true, 32, true, false, false, b"\xc2\xb8D"));   // D
    assert(pair(13, false, true, 18, true, false, false, b"\xc2\xb8E"));   // E
    assert(pair(13, false, true, 33, true, false, false, b"\xc2\xb8F"));   // F
    assert(pair(13, false, true, 34, true, false, false, b"\xc2\xb8G"));   // G
    assert(pair(13, false, true, 35, true, false, false, b"\xc2\xb8H"));   // H
    assert(pair(13, false, true, 23, true, false, false, b"\xc2\xb8I"));   // I
    assert(pair(13, false, true, 36, true, false, false, b"\xc2\xb8J"));   // J
    assert(pair(13, false, true, 37, true, false, false, b"\xc2\xb8K"));   // K
    assert(pair(13, false, true, 38, true, false, false, b"\xc2\xb8L"));   // L
    assert(pair(13, false, true, 50, true, false, false, b"\xc2\xb8M"));   // M
    assert(pair(13, false, true, 49, true, false, false, b"\xc2\xb8N"));   // N
    assert(pair(13, false, true, 24, true, false, false, b"\xc2\xb8O"));   // O
    assert(pair(13, false, true, 25, true, false, false, b"\xc2\xb8P"));   // P
    assert(pair(13, false, true, 16, true, false, false, b"\xc2\xb8Q"));   // Q
    assert(pair(13, false, true, 19, true, false, false, b"\xc2\xb8R"));   // R
    assert(pair(13, false, true, 31, true, false, false, b"\xc2\xb8S"));   // S
    assert(pair(13, false, true, 20, true, false, false, b"\xc2\xb8T"));   // T
    assert(pair(13, false, true, 22, true, false, false, b"\xc2\xb8U"));   // U
    assert(pair(13, false, true, 47, true, false, false, b"\xc2\xb8V"));   // V
    assert(pair(13, false, true, 17, true, false, false, b"\xc2\xb8W"));   // W
    assert(pair(13, false, true, 45, true, false, false, b"\xc2\xb8X"));   // X
    assert(pair(13, false, true, 21, true, false, false, b"\xc2\xb8Y"));   // Y
    assert(pair(13, false, true, 44, true, false, false, b"\xc2\xb8Z"));   // Z
    assert(pair(13, false, true, 30, false, false, false, b"\xc2\xb8a"));   // a
    assert(pair(13, false, true, 48, false, false, false, b"\xc2\xb8b"));   // b
    assert(pair(13, false, true, 46, false, false, false, b"\xc3\xa7"));   // c
    assert(pair(13, false, true, 32, false, false, false, b"\xc2\xb8d"));   // d
    assert(pair(13, false, true, 18, false, false, false, b"\xc2\xb8e"));   // e
    assert(pair(13, false, true, 33, false, false, false, b"\xc2\xb8f"));   // f
    assert(pair(13, false, true, 34, false, false, false, b"\xc2\xb8g"));   // g
    assert(pair(13, false, true, 35, false, false, false, b"\xc2\xb8h"));   // h
    assert(pair(13, false, true, 23, false, false, false, b"\xc2\xb8i"));   // i
    assert(pair(13, false, true, 36, false, false, false, b"\xc2\xb8j"));   // j
    assert(pair(13, false, true, 37, false, false, false, b"\xc2\xb8k"));   // k
    assert(pair(13, false, true, 38, false, false, false, b"\xc2\xb8l"));   // l
    assert(pair(13, false, true, 50, false, false, false, b"\xc2\xb8m"));   // m
    assert(pair(13, false, true, 49, false, false, false, b"\xc2\xb8n"));   // n
    assert(pair(13, false, true, 24, false, false, false, b"\xc2\xb8o"));   // o
    assert(pair(13, false, true, 25, false, false, false, b"\xc2\xb8p"));   // p
    assert(pair(13, false, true, 16, false, false, false, b"\xc2\xb8q"));   // q
    assert(pair(13, false, true, 19, false, false, false, b"\xc2\xb8r"));   // r
    assert(pair(13, false, true, 31, false, false, false, b"\xc2\xb8s"));   // s
    assert(pair(13, false, true, 20, false, false, false, b"\xc2\xb8t"));   // t
    assert(pair(13, false, true, 22, false, false, false, b"\xc2\xb8u"));   // u
    assert(pair(13, false, true, 47, false, false, false, b"\xc2\xb8v"));   // v
    assert(pair(13, false, true, 17, false, false, false, b"\xc2\xb8w"));   // w
    assert(pair(13, false, true, 45, false, false, false, b"\xc2\xb8x"));   // x
    assert(pair(13, false, true, 21, false, false, false, b"\xc2\xb8y"));   // y
    assert(pair(13, false, true, 44, false, false, false, b"\xc2\xb8z"));   // z
    assert(pair(13, false, true, 57, false, false, false, b"\xc2\xb8"));   // space: the accent
    assert(pair(13, false, true, 57, true, false, false, b"\xc2\xb8"));   // Shift+space: the accent
    assert(pair(13, false, true, 2, false, false, false, b"\xc2\xb81"));   // the key of code 2
    assert(pair(13, false, true, 5, false, false, true, b"\xc2\xb8\xe2\x82\xac"));   // AltGr at code 5
    assert(pair(13, false, true, 28, false, false, false, b"\xc2\xb8\x0d"));   // Enter
    assert(pair(13, false, true, 14, false, false, false, b"\xc2\xb8\x7f"));   // Backspace
    assert(pair(13, false, true, 103, false, false, false, b"\xc2\xb8\x1b[A"));   // Up
    assert(pair(13, false, true, 46, false, true, false, b"\xc2\xb8\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(13, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xc2\xb8E") && equal(got[0..n], b"\xc2\xb8E") && !keymap.dead_pending());   // E
    assert(dead(13, false, true));
    n = keymap.key_utf8(26, false, false, true, got);   // dead_diaeresis
    assert(n == len(b"\xc2\xb8") && equal(got[0..n], b"\xc2\xb8") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xa8") && equal(got[0..n], b"\xc2\xa8") && !keymap.dead_pending());
}

test "GB: dead_diaeresis (code 26, AltGr) with every letter, space and other keys" {
    keymap.set_layout(keymap.GB);
    assert(pair(26, false, true, 30, true, false, false, b"\xc3\x84"));   // A
    assert(pair(26, false, true, 48, true, false, false, b"\xc2\xa8B"));   // B
    assert(pair(26, false, true, 46, true, false, false, b"\xc2\xa8C"));   // C
    assert(pair(26, false, true, 32, true, false, false, b"\xc2\xa8D"));   // D
    assert(pair(26, false, true, 18, true, false, false, b"\xc3\x8b"));   // E
    assert(pair(26, false, true, 33, true, false, false, b"\xc2\xa8F"));   // F
    assert(pair(26, false, true, 34, true, false, false, b"\xc2\xa8G"));   // G
    assert(pair(26, false, true, 35, true, false, false, b"\xc2\xa8H"));   // H
    assert(pair(26, false, true, 23, true, false, false, b"\xc3\x8f"));   // I
    assert(pair(26, false, true, 36, true, false, false, b"\xc2\xa8J"));   // J
    assert(pair(26, false, true, 37, true, false, false, b"\xc2\xa8K"));   // K
    assert(pair(26, false, true, 38, true, false, false, b"\xc2\xa8L"));   // L
    assert(pair(26, false, true, 50, true, false, false, b"\xc2\xa8M"));   // M
    assert(pair(26, false, true, 49, true, false, false, b"\xc2\xa8N"));   // N
    assert(pair(26, false, true, 24, true, false, false, b"\xc3\x96"));   // O
    assert(pair(26, false, true, 25, true, false, false, b"\xc2\xa8P"));   // P
    assert(pair(26, false, true, 16, true, false, false, b"\xc2\xa8Q"));   // Q
    assert(pair(26, false, true, 19, true, false, false, b"\xc2\xa8R"));   // R
    assert(pair(26, false, true, 31, true, false, false, b"\xc2\xa8S"));   // S
    assert(pair(26, false, true, 20, true, false, false, b"\xc2\xa8T"));   // T
    assert(pair(26, false, true, 22, true, false, false, b"\xc3\x9c"));   // U
    assert(pair(26, false, true, 47, true, false, false, b"\xc2\xa8V"));   // V
    assert(pair(26, false, true, 17, true, false, false, b"\xc2\xa8W"));   // W
    assert(pair(26, false, true, 45, true, false, false, b"\xc2\xa8X"));   // X
    assert(pair(26, false, true, 21, true, false, false, b"\xc2\xa8Y"));   // Y
    assert(pair(26, false, true, 44, true, false, false, b"\xc2\xa8Z"));   // Z
    assert(pair(26, false, true, 30, false, false, false, b"\xc3\xa4"));   // a
    assert(pair(26, false, true, 48, false, false, false, b"\xc2\xa8b"));   // b
    assert(pair(26, false, true, 46, false, false, false, b"\xc2\xa8c"));   // c
    assert(pair(26, false, true, 32, false, false, false, b"\xc2\xa8d"));   // d
    assert(pair(26, false, true, 18, false, false, false, b"\xc3\xab"));   // e
    assert(pair(26, false, true, 33, false, false, false, b"\xc2\xa8f"));   // f
    assert(pair(26, false, true, 34, false, false, false, b"\xc2\xa8g"));   // g
    assert(pair(26, false, true, 35, false, false, false, b"\xc2\xa8h"));   // h
    assert(pair(26, false, true, 23, false, false, false, b"\xc3\xaf"));   // i
    assert(pair(26, false, true, 36, false, false, false, b"\xc2\xa8j"));   // j
    assert(pair(26, false, true, 37, false, false, false, b"\xc2\xa8k"));   // k
    assert(pair(26, false, true, 38, false, false, false, b"\xc2\xa8l"));   // l
    assert(pair(26, false, true, 50, false, false, false, b"\xc2\xa8m"));   // m
    assert(pair(26, false, true, 49, false, false, false, b"\xc2\xa8n"));   // n
    assert(pair(26, false, true, 24, false, false, false, b"\xc3\xb6"));   // o
    assert(pair(26, false, true, 25, false, false, false, b"\xc2\xa8p"));   // p
    assert(pair(26, false, true, 16, false, false, false, b"\xc2\xa8q"));   // q
    assert(pair(26, false, true, 19, false, false, false, b"\xc2\xa8r"));   // r
    assert(pair(26, false, true, 31, false, false, false, b"\xc2\xa8s"));   // s
    assert(pair(26, false, true, 20, false, false, false, b"\xc2\xa8t"));   // t
    assert(pair(26, false, true, 22, false, false, false, b"\xc3\xbc"));   // u
    assert(pair(26, false, true, 47, false, false, false, b"\xc2\xa8v"));   // v
    assert(pair(26, false, true, 17, false, false, false, b"\xc2\xa8w"));   // w
    assert(pair(26, false, true, 45, false, false, false, b"\xc2\xa8x"));   // x
    assert(pair(26, false, true, 21, false, false, false, b"\xc3\xbf"));   // y
    assert(pair(26, false, true, 44, false, false, false, b"\xc2\xa8z"));   // z
    assert(pair(26, false, true, 57, false, false, false, b"\xc2\xa8"));   // space: the accent
    assert(pair(26, false, true, 57, true, false, false, b"\xc2\xa8"));   // Shift+space: the accent
    assert(pair(26, false, true, 2, false, false, false, b"\xc2\xa81"));   // the key of code 2
    assert(pair(26, false, true, 5, false, false, true, b"\xc2\xa8\xe2\x82\xac"));   // AltGr at code 5
    assert(pair(26, false, true, 28, false, false, false, b"\xc2\xa8\x0d"));   // Enter
    assert(pair(26, false, true, 14, false, false, false, b"\xc2\xa8\x7f"));   // Backspace
    assert(pair(26, false, true, 103, false, false, false, b"\xc2\xa8\x1b[A"));   // Up
    assert(pair(26, false, true, 46, false, true, false, b"\xc2\xa8\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(26, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xc3\x8b") && equal(got[0..n], b"\xc3\x8b") && !keymap.dead_pending());   // E
    assert(dead(26, false, true));
    n = keymap.key_utf8(13, false, false, true, got);   // dead_cedilla
    assert(n == len(b"\xc2\xa8") && equal(got[0..n], b"\xc2\xa8") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xb8") && equal(got[0..n], b"\xc2\xb8") && !keymap.dead_pending());
}

