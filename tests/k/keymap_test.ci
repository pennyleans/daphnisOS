    assert(pair(39, false, true, 25, false, false, false, b"\xcb\x9dp"));   // p
    assert(pair(39, false, true, 16, false, false, false, b"\xcb\x9dq"));   // q
    assert(pair(39, false, true, 19, false, false, false, b"\xcb\x9dr"));   // r
    assert(pair(39, false, true, 31, false, false, false, b"\xcb\x9ds"));   // s
    assert(pair(39, false, true, 20, false, false, false, b"\xcb\x9dt"));   // t
    assert(pair(39, false, true, 22, false, false, false, b"\xcb\x9du"));   // u
    assert(pair(39, false, true, 47, false, false, false, b"\xcb\x9dv"));   // v
    assert(pair(39, false, true, 17, false, false, false, b"\xcb\x9dw"));   // w
    assert(pair(39, false, true, 45, false, false, false, b"\xcb\x9dx"));   // x
    assert(pair(39, false, true, 44, false, false, false, b"\xcb\x9dy"));   // y
    assert(pair(39, false, true, 21, false, false, false, b"\xcb\x9dz"));   // z
    assert(pair(39, false, true, 57, false, false, false, b"\xcb\x9d"));   // space: the accent
    assert(pair(39, false, true, 57, true, false, false, b"\xcb\x9d"));   // Shift+space: the accent
    assert(pair(39, false, true, 2, false, false, false, b"\xcb\x9d1"));   // the key of code 2
    assert(pair(39, false, true, 5, false, false, true, b"\xcb\x9d\xc2\xbc"));   // AltGr at code 5
    assert(pair(39, false, true, 28, false, false, false, b"\xcb\x9d\x0d"));   // Enter
    assert(pair(39, false, true, 14, false, false, false, b"\xcb\x9d\x7f"));   // Backspace
    assert(pair(39, false, true, 103, false, false, false, b"\xcb\x9d\x1b[A"));   // Up
    assert(pair(39, false, true, 46, false, true, false, b"\xcb\x9d\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(39, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xcb\x9dE") && equal(got[0..n], b"\xcb\x9dE") && !keymap.dead_pending());   // E
    assert(dead(39, false, true));
    n = keymap.key_utf8(13, false, false, false, got);   // dead_acute
    assert(n == len(b"\xcb\x9d") && equal(got[0..n], b"\xcb\x9d") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xb4") && equal(got[0..n], b"\xc2\xb4") && !keymap.dead_pending());
}

