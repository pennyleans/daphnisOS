test "DE: dead_acute (code 13, plain) with every letter, space and other keys" {
    keymap.set_layout(keymap.DE);
    assert(pair(13, false, false, 30, true, false, false, b"\xc3\x81"));   // A
    assert(pair(13, false, false, 48, true, false, false, b"\xc2\xb4B"));   // B
    assert(pair(13, false, false, 46, true, false, false, b"\xc2\xb4C"));   // C
    assert(pair(13, false, false, 32, true, false, false, b"\xc2\xb4D"));   // D
    assert(pair(13, false, false, 18, true, false, false, b"\xc3\x89"));   // E
    assert(pair(13, false, false, 33, true, false, false, b"\xc2\xb4F"));   // F
    assert(pair(13, false, false, 34, true, false, false, b"\xc2\xb4G"));   // G
    assert(pair(13, false, false, 35, true, false, false, b"\xc2\xb4H"));   // H
    assert(pair(13, false, false, 23, true, false, false, b"\xc3\x8d"));   // I
    assert(pair(13, false, false, 36, true, false, false, b"\xc2\xb4J"));   // J
    assert(pair(13, false, false, 37, true, false, false, b"\xc2\xb4K"));   // K
    assert(pair(13, false, false, 38, true, false, false, b"\xc2\xb4L"));   // L
    assert(pair(13, false, false, 50, true, false, false, b"\xc2\xb4M"));   // M
    assert(pair(13, false, false, 49, true, false, false, b"\xc2\xb4N"));   // N
    assert(pair(13, false, false, 24, true, false, false, b"\xc3\x93"));   // O
    assert(pair(13, false, false, 25, true, false, false, b"\xc2\xb4P"));   // P
    assert(pair(13, false, false, 16, true, false, false, b"\xc2\xb4Q"));   // Q
    assert(pair(13, false, false, 19, true, false, false, b"\xc2\xb4R"));   // R
    assert(pair(13, false, false, 31, true, false, false, b"\xc2\xb4S"));   // S
    assert(pair(13, false, false, 20, true, false, false, b"\xc2\xb4T"));   // T
    assert(pair(13, false, false, 22, true, false, false, b"\xc3\x9a"));   // U
    assert(pair(13, false, false, 47, true, false, false, b"\xc2\xb4V"));   // V
    assert(pair(13, false, false, 17, true, false, false, b"\xc2\xb4W"));   // W
    assert(pair(13, false, false, 45, true, false, false, b"\xc2\xb4X"));   // X
    assert(pair(13, false, false, 44, true, false, false, b"\xc3\x9d"));   // Y
    assert(pair(13, false, false, 21, true, false, false, b"\xc2\xb4Z"));   // Z
    assert(pair(13, false, false, 30, false, false, false, b"\xc3\xa1"));   // a
    assert(pair(13, false, false, 48, false, false, false, b"\xc2\xb4b"));   // b
    assert(pair(13, false, false, 46, false, false, false, b"\xc2\xb4c"));   // c
    assert(pair(13, false, false, 32, false, false, false, b"\xc2\xb4d"));   // d
    assert(pair(13, false, false, 18, false, false, false, b"\xc3\xa9"));   // e
    assert(pair(13, false, false, 33, false, false, false, b"\xc2\xb4f"));   // f
    assert(pair(13, false, false, 34, false, false, false, b"\xc2\xb4g"));   // g
    assert(pair(13, false, false, 35, false, false, false, b"\xc2\xb4h"));   // h
    assert(pair(13, false, false, 23, false, false, false, b"\xc3\xad"));   // i
    assert(pair(13, false, false, 36, false, false, false, b"\xc2\xb4j"));   // j
    assert(pair(13, false, false, 37, false, false, false, b"\xc2\xb4k"));   // k
    assert(pair(13, false, false, 38, false, false, false, b"\xc2\xb4l"));   // l
    assert(pair(13, false, false, 50, false, false, false, b"\xc2\xb4m"));   // m
    assert(pair(13, false, false, 49, false, false, false, b"\xc2\xb4n"));   // n
    assert(pair(13, false, false, 24, false, false, false, b"\xc3\xb3"));   // o
    assert(pair(13, false, false, 25, false, false, false, b"\xc2\xb4p"));   // p
    assert(pair(13, false, false, 16, false, false, false, b"\xc2\xb4q"));   // q
    assert(pair(13, false, false, 19, false, false, false, b"\xc2\xb4r"));   // r
    assert(pair(13, false, false, 31, false, false, false, b"\xc2\xb4s"));   // s
    assert(pair(13, false, false, 20, false, false, false, b"\xc2\xb4t"));   // t
    assert(pair(13, false, false, 22, false, false, false, b"\xc3\xba"));   // u
    assert(pair(13, false, false, 47, false, false, false, b"\xc2\xb4v"));   // v
    assert(pair(13, false, false, 17, false, false, false, b"\xc2\xb4w"));   // w
    assert(pair(13, false, false, 45, false, false, false, b"\xc2\xb4x"));   // x
    assert(pair(13, false, false, 44, false, false, false, b"\xc3\xbd"));   // y
    assert(pair(13, false, false, 21, false, false, false, b"\xc2\xb4z"));   // z
    assert(pair(13, false, false, 57, false, false, false, b"\xc2\xb4"));   // space: the accent
    assert(pair(13, false, false, 57, true, false, false, b"\xc2\xb4"));   // Shift+space: the accent
    assert(pair(13, false, false, 2, false, false, false, b"\xc2\xb41"));   // the key of code 2
    assert(pair(13, false, false, 5, false, false, true, b"\xc2\xb4\xc2\xbc"));   // AltGr at code 5
    assert(pair(13, false, false, 28, false, false, false, b"\xc2\xb4\x0d"));   // Enter
    assert(pair(13, false, false, 14, false, false, false, b"\xc2\xb4\x7f"));   // Backspace
    assert(pair(13, false, false, 103, false, false, false, b"\xc2\xb4\x1b[A"));   // Up
    assert(pair(13, false, false, 46, false, true, false, b"\xc2\xb4\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(13, false, false));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xc3\x89") && equal(got[0..n], b"\xc3\x89") && !keymap.dead_pending());   // E
    assert(dead(13, false, false));
    n = keymap.key_utf8(13, true, false, false, got);   // dead_grave
    assert(n == len(b"\xc2\xb4") && equal(got[0..n], b"\xc2\xb4") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"`") && equal(got[0..n], b"`") && !keymap.dead_pending());
}

