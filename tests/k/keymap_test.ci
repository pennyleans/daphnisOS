test "DE: every key of the rows, plain, Shift and AltGr; Shift with AltGr gives nothing" {
    keymap.set_layout(keymap.DE);
    assert(keymap.layout() == keymap.DE && keymap.has_altgr());
    assert(is(2, false, false, false, b"1"));
    assert(is(2, true, false, false, b"!"));
    assert(is(2, false, false, true, b"\xc2\xb9"));
    assert(is(2, true, false, true, b""));
    assert(is(3, false, false, false, b"2"));
    assert(is(3, true, false, false, b"\x22"));
    assert(is(3, false, false, true, b"\xc2\xb2"));
    assert(is(3, true, false, true, b""));
    assert(is(4, false, false, false, b"3"));
    assert(is(4, true, false, false, b"\xc2\xa7"));
    assert(is(4, false, false, true, b"\xc2\xb3"));
    assert(is(4, true, false, true, b""));
    assert(is(5, false, false, false, b"4"));
    assert(is(5, true, false, false, b"$"));
    assert(is(5, false, false, true, b"\xc2\xbc"));
    assert(is(5, true, false, true, b""));
    assert(is(6, false, false, false, b"5"));
    assert(is(6, true, false, false, b"%"));
    assert(is(6, false, false, true, b"\xc2\xbd"));
    assert(is(6, true, false, true, b""));
    assert(is(7, false, false, false, b"6"));
    assert(is(7, true, false, false, b"&"));
    assert(is(7, false, false, true, b"\xc2\xac"));
    assert(is(7, true, false, true, b""));
    assert(is(8, false, false, false, b"7"));
    assert(is(8, true, false, false, b"/"));
    assert(is(8, false, false, true, b"\x7b"));
    assert(is(8, true, false, true, b""));
    assert(is(9, false, false, false, b"8"));
    assert(is(9, true, false, false, b"("));
    assert(is(9, false, false, true, b"["));
    assert(is(9, true, false, true, b""));
    assert(is(10, false, false, false, b"9"));
    assert(is(10, true, false, false, b")"));
    assert(is(10, false, false, true, b"]"));
    assert(is(10, true, false, true, b""));
    assert(is(11, false, false, false, b"0"));
    assert(is(11, true, false, false, b"="));
    assert(is(11, false, false, true, b"\x7d"));
    assert(is(11, true, false, true, b""));
    assert(is(12, false, false, false, b"\xc3\x9f"));
    assert(is(12, true, false, false, b"?"));
    assert(is(12, false, false, true, b"\x5c"));
    assert(is(12, true, false, true, b""));
    assert(dead(13, false, false));   // dead_acute
    assert(dead(13, true, false));   // dead_grave
    assert(dead(13, false, true));   // dead_cedilla
    assert(is(13, true, false, true, b""));
    assert(is(16, false, false, false, b"q"));
    assert(is(16, true, false, false, b"Q"));
    assert(is(16, false, false, true, b"@"));
    assert(is(16, true, false, true, b""));
    assert(is(17, false, false, false, b"w"));
    assert(is(17, true, false, false, b"W"));
    assert(is(17, false, false, true, b"\xc5\xbf"));
    assert(is(17, true, false, true, b""));
    assert(is(18, false, false, false, b"e"));
    assert(is(18, true, false, false, b"E"));
