    assert(is(40, false, false, false, b"\xc3\xb9"));
    assert(is(40, true, false, false, b"%"));
    assert(dead(40, false, true));   // dead_circumflex
    assert(is(40, true, false, true, b""));
    assert(is(41, false, false, false, b"\xc2\xb2"));
    assert(is(41, true, false, false, b"~"));
    assert(is(41, false, false, true, b"\xc2\xac"));
    assert(is(41, true, false, true, b""));
    assert(is(43, false, false, false, b"*"));
    assert(is(43, true, false, false, b"\xc2\xb5"));
    assert(dead(43, false, true));   // dead_grave
    assert(is(43, true, false, true, b""));
    assert(is(44, false, false, false, b"w"));
    assert(is(44, true, false, false, b"W"));
    assert(is(44, false, false, true, b"\xc5\x82"));
    assert(is(44, true, false, true, b""));
    assert(is(45, false, false, false, b"x"));
    assert(is(45, true, false, false, b"X"));
    assert(is(45, false, false, true, b"\xc2\xbb"));
    assert(is(45, true, false, true, b""));
    assert(is(46, false, false, false, b"c"));
    assert(is(46, true, false, false, b"C"));
    assert(is(46, false, false, true, b"\xc2\xa2"));
    assert(is(46, true, false, true, b""));
    assert(is(47, false, false, false, b"v"));
    assert(is(47, true, false, false, b"V"));
    assert(is(47, false, false, true, b"\xe2\x80\x9e"));
    assert(is(47, true, false, true, b""));
    assert(is(48, false, false, false, b"b"));
    assert(is(48, true, false, false, b"B"));
    assert(is(48, false, false, true, b"\xe2\x80\x9c"));
    assert(is(48, true, false, true, b""));
    assert(is(49, false, false, false, b"n"));
    assert(is(49, true, false, false, b"N"));
    assert(is(49, false, false, true, b"\xe2\x80\x9d"));
    assert(is(49, true, false, true, b""));
    assert(is(50, false, false, false, b","));
    assert(is(50, true, false, false, b"?"));
    assert(dead(50, false, true));   // dead_acute
    assert(is(50, true, false, true, b""));
    assert(is(51, false, false, false, b";"));
    assert(is(51, true, false, false, b"."));
    assert(is(51, false, false, true, b"\xe2\x80\xa2"));
    assert(is(51, true, false, true, b""));
    assert(is(52, false, false, false, b":"));
    assert(is(52, true, false, false, b"/"));
    assert(is(52, false, false, true, b"\xc2\xb7"));
    assert(is(52, true, false, true, b""));
    assert(is(53, false, false, false, b"!"));
    assert(is(53, true, false, false, b"\xc2\xa7"));
    assert(dead(53, false, true));   // dead_belowdot
    assert(is(53, true, false, true, b""));
    assert(is(86, false, false, false, b"<"));
    assert(is(86, true, false, false, b">"));
    assert(is(86, false, false, true, b"|"));
    assert(is(86, true, false, true, b""));
    assert(is(1, false, false, false, b"\x1b"));
    assert(is(1, true, false, false, b"\x1b"));
    assert(is(1, false, false, true, b"\x1b"));
    assert(is(1, true, false, true, b"\x1b"));
    assert(is(14, false, false, false, b"\x7f"));
    assert(is(14, true, false, false, b"\x7f"));
    assert(is(14, false, false, true, b"\x7f"));
    assert(is(14, true, false, true, b"\x7f"));
    assert(is(15, false, false, false, b"\x09"));
    assert(is(15, true, false, false, b"\x09"));
    assert(is(15, false, false, true, b"\x09"));
    assert(is(15, true, false, true, b"\x09"));
    assert(is(28, false, false, false, b"\x0d"));
    assert(is(28, true, false, false, b"\x0d"));
    assert(is(28, false, false, true, b"\x0d"));
    assert(is(28, true, false, true, b"\x0d"));
    assert(is(57, false, false, false, b" "));
    assert(is(57, true, false, false, b" "));
    assert(is(57, false, false, true, b" "));
    assert(is(57, true, false, true, b" "));
}

test "FR: dead_circumflex (code 26, plain) with every letter, space and other keys" {
    keymap.set_layout(keymap.FR);
    assert(pair(26, false, false, 16, true, false, false, b"\xc3\x82"));   // A
    assert(pair(26, false, false, 48, true, false, false, b"^B"));   // B
    assert(pair(26, false, false, 46, true, false, false, b"^C"));   // C
    assert(pair(26, false, false, 32, true, false, false, b"^D"));   // D
    assert(pair(26, false, false, 18, true, false, false, b"\xc3\x8a"));   // E
    assert(pair(26, false, false, 33, true, false, false, b"^F"));   // F
    assert(pair(26, false, false, 34, true, false, false, b"^G"));   // G
    assert(pair(26, false, false, 35, true, false, false, b"^H"));   // H
    assert(pair(26, false, false, 23, true, false, false, b"\xc3\x8e"));   // I
    assert(pair(26, false, false, 36, true, false, false, b"^J"));   // J
    assert(pair(26, false, false, 37, true, false, false, b"^K"));   // K
    assert(pair(26, false, false, 38, true, false, false, b"^L"));   // L
    assert(pair(26, false, false, 39, true, false, false, b"^M"));   // M
    assert(pair(26, false, false, 49, true, false, false, b"^N"));   // N
    assert(pair(26, false, false, 24, true, false, false, b"\xc3\x94"));   // O
    assert(pair(26, false, false, 25, true, false, false, b"^P"));   // P
    assert(pair(26, false, false, 30, true, false, false, b"^Q"));   // Q
    assert(pair(26, false, false, 19, true, false, false, b"^R"));   // R
    assert(pair(26, false, false, 31, true, false, false, b"^S"));   // S
    assert(pair(26, false, false, 20, true, false, false, b"^T"));   // T
    assert(pair(26, false, false, 22, true, false, false, b"\xc3\x9b"));   // U
    assert(pair(26, false, false, 47, true, false, false, b"^V"));   // V
    assert(pair(26, false, false, 44, true, false, false, b"^W"));   // W
    assert(pair(26, false, false, 45, true, false, false, b"^X"));   // X
    assert(pair(26, false, false, 21, true, false, false, b"^Y"));   // Y
    assert(pair(26, false, false, 17, true, false, false, b"^Z"));   // Z
    assert(pair(26, false, false, 16, false, false, false, b"\xc3\xa2"));   // a
    assert(pair(26, false, false, 48, false, false, false, b"^b"));   // b
    assert(pair(26, false, false, 46, false, false, false, b"^c"));   // c
    assert(pair(26, false, false, 32, false, false, false, b"^d"));   // d
    assert(pair(26, false, false, 18, false, false, false, b"\xc3\xaa"));   // e
    assert(pair(26, false, false, 33, false, false, false, b"^f"));   // f
    assert(pair(26, false, false, 34, false, false, false, b"^g"));   // g
    assert(pair(26, false, false, 35, false, false, false, b"^h"));   // h
    assert(pair(26, false, false, 23, false, false, false, b"\xc3\xae"));   // i
    assert(pair(26, false, false, 36, false, false, false, b"^j"));   // j
    assert(pair(26, false, false, 37, false, false, false, b"^k"));   // k
    assert(pair(26, false, false, 38, false, false, false, b"^l"));   // l
    assert(pair(26, false, false, 39, false, false, false, b"^m"));   // m
    assert(pair(26, false, false, 49, false, false, false, b"^n"));   // n
    assert(pair(26, false, false, 24, false, false, false, b"\xc3\xb4"));   // o
    assert(pair(26, false, false, 25, false, false, false, b"^p"));   // p
    assert(pair(26, false, false, 30, false, false, false, b"^q"));   // q
    assert(pair(26, false, false, 19, false, false, false, b"^r"));   // r
    assert(pair(26, false, false, 31, false, false, false, b"^s"));   // s
    assert(pair(26, false, false, 20, false, false, false, b"^t"));   // t
    assert(pair(26, false, false, 22, false, false, false, b"\xc3\xbb"));   // u
    assert(pair(26, false, false, 47, false, false, false, b"^v"));   // v
    assert(pair(26, false, false, 44, false, false, false, b"^w"));   // w
    assert(pair(26, false, false, 45, false, false, false, b"^x"));   // x
    assert(pair(26, false, false, 21, false, false, false, b"^y"));   // y
    assert(pair(26, false, false, 17, false, false, false, b"^z"));   // z
    assert(pair(26, false, false, 57, false, false, false, b"^"));   // space: the accent
    assert(pair(26, false, false, 57, true, false, false, b"^"));   // Shift+space: the accent
    assert(pair(26, false, false, 2, false, false, false, b"^&"));   // the key of code 2
    assert(pair(26, false, false, 5, false, false, true, b"^\x7b"));   // AltGr at code 5
    assert(pair(26, false, false, 28, false, false, false, b"^\x0d"));   // Enter
    assert(pair(26, false, false, 14, false, false, false, b"^\x7f"));   // Backspace
    assert(pair(26, false, false, 103, false, false, false, b"^\x1b[A"));   // Up
    assert(pair(26, false, false, 46, false, true, false, b"^\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(26, false, false));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xc3\x8a") && equal(got[0..n], b"\xc3\x8a") && !keymap.dead_pending());   // E
    assert(dead(26, false, false));
    n = keymap.key_utf8(26, true, false, false, got);   // dead_diaeresis
    assert(n == len(b"^") && equal(got[0..n], b"^") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xa8") && equal(got[0..n], b"\xc2\xa8") && !keymap.dead_pending());
}

