    assert(pair(53, false, true, 25, true, false, false, b"\xcc\xa3P"));   // P
    assert(pair(53, false, true, 16, true, false, false, b"\xcc\xa3Q"));   // Q
    assert(pair(53, false, true, 19, true, false, false, b"\xcc\xa3R"));   // R
    assert(pair(53, false, true, 31, true, false, false, b"\xcc\xa3S"));   // S
    assert(pair(53, false, true, 20, true, false, false, b"\xcc\xa3T"));   // T
    assert(pair(53, false, true, 22, true, false, false, b"\xcc\xa3U"));   // U
    assert(pair(53, false, true, 47, true, false, false, b"\xcc\xa3V"));   // V
    assert(pair(53, false, true, 17, true, false, false, b"\xcc\xa3W"));   // W
    assert(pair(53, false, true, 45, true, false, false, b"\xcc\xa3X"));   // X
    assert(pair(53, false, true, 21, true, false, false, b"\xcc\xa3Y"));   // Y
    assert(pair(53, false, true, 44, true, false, false, b"\xcc\xa3Z"));   // Z
    assert(pair(53, false, true, 30, false, false, false, b"\xcc\xa3a"));   // a
    assert(pair(53, false, true, 48, false, false, false, b"\xcc\xa3b"));   // b
    assert(pair(53, false, true, 46, false, false, false, b"\xcc\xa3c"));   // c
    assert(pair(53, false, true, 32, false, false, false, b"\xcc\xa3d"));   // d
    assert(pair(53, false, true, 18, false, false, false, b"\xcc\xa3e"));   // e
    assert(pair(53, false, true, 33, false, false, false, b"\xcc\xa3f"));   // f
    assert(pair(53, false, true, 34, false, false, false, b"\xcc\xa3g"));   // g
    assert(pair(53, false, true, 35, false, false, false, b"\xcc\xa3h"));   // h
    assert(pair(53, false, true, 23, false, false, false, b"\xcc\xa3i"));   // i
    assert(pair(53, false, true, 36, false, false, false, b"\xcc\xa3j"));   // j
    assert(pair(53, false, true, 37, false, false, false, b"\xcc\xa3k"));   // k
    assert(pair(53, false, true, 38, false, false, false, b"\xcc\xa3l"));   // l
    assert(pair(53, false, true, 50, false, false, false, b"\xcc\xa3m"));   // m
    assert(pair(53, false, true, 49, false, false, false, b"\xcc\xa3n"));   // n
    assert(pair(53, false, true, 24, false, false, false, b"\xcc\xa3o"));   // o
    assert(pair(53, false, true, 25, false, false, false, b"\xcc\xa3p"));   // p
    assert(pair(53, false, true, 16, false, false, false, b"\xcc\xa3q"));   // q
    assert(pair(53, false, true, 19, false, false, false, b"\xcc\xa3r"));   // r
    assert(pair(53, false, true, 31, false, false, false, b"\xcc\xa3s"));   // s
    assert(pair(53, false, true, 20, false, false, false, b"\xcc\xa3t"));   // t
    assert(pair(53, false, true, 22, false, false, false, b"\xcc\xa3u"));   // u
    assert(pair(53, false, true, 47, false, false, false, b"\xcc\xa3v"));   // v
    assert(pair(53, false, true, 17, false, false, false, b"\xcc\xa3w"));   // w
    assert(pair(53, false, true, 45, false, false, false, b"\xcc\xa3x"));   // x
    assert(pair(53, false, true, 21, false, false, false, b"\xcc\xa3y"));   // y
    assert(pair(53, false, true, 44, false, false, false, b"\xcc\xa3z"));   // z
    assert(pair(53, false, true, 57, false, false, false, b"\xcc\xa3"));   // space: the accent
    assert(pair(53, false, true, 57, true, false, false, b"\xcc\xa3"));   // Shift+space: the accent
    assert(pair(53, false, true, 2, false, false, false, b"\xcc\xa31"));   // the key of code 2
    assert(pair(53, false, true, 5, false, false, true, b"\xcc\xa3~"));   // AltGr at code 5
    assert(pair(53, false, true, 28, false, false, false, b"\xcc\xa3\x0d"));   // Enter
    assert(pair(53, false, true, 14, false, false, false, b"\xcc\xa3\x7f"));   // Backspace
    assert(pair(53, false, true, 103, false, false, false, b"\xcc\xa3\x1b[A"));   // Up
    assert(pair(53, false, true, 46, false, true, false, b"\xcc\xa3\x03"));   // Ctrl at code 46: 0x03 by position
    assert(dead(53, false, true));
    U8[16] got;
    assert(keymap.key_utf8(42, true, false, false, got) == 0 && keymap.dead_pending());   // Shift
    assert(keymap.key_utf8(59, false, false, false, got) == 0 && keymap.dead_pending());   // F1
    I64 n = keymap.key_utf8(18, true, false, false, got);
    assert(n == len(b"\xcc\xa3E") && equal(got[0..n], b"\xcc\xa3E") && !keymap.dead_pending());   // E
    assert(dead(53, false, true));
    n = keymap.key_utf8(13, false, false, true, got);   // dead_cedilla
    assert(n == len(b"\xcc\xa3") && equal(got[0..n], b"\xcc\xa3") && keymap.dead_pending());
    n = keymap.key_utf8(57, false, false, false, got);
    assert(n == len(b"\xc2\xb8") && equal(got[0..n], b"\xc2\xb8") && !keymap.dead_pending());
}

// By hand: anchors from the printed layouts, not the generator.
test "anchors: QWERTZ, AZERTY, the ISO key, the euro sign, Ctrl by position" {
    keymap.set_layout(keymap.DE);
    assert(is(21, false, false, false, b"z"));
    keymap.set_layout(keymap.DE);
    assert(is(44, false, false, false, b"y"));
    keymap.set_layout(keymap.DE);
    assert(is(26, false, false, false, b"\xc3\xbc"));
    keymap.set_layout(keymap.DE);
    assert(is(12, false, false, false, b"\xc3\x9f"));
    keymap.set_layout(keymap.DE);
    assert(is(86, false, false, false, b"<"));
    keymap.set_layout(keymap.DE);
    assert(is(86, false, false, true, b"|"));
    keymap.set_layout(keymap.DE);
    assert(is(16, false, false, true, b"@"));
    keymap.set_layout(keymap.DE);
    assert(is(18, false, false, true, b"\xe2\x82\xac"));
    keymap.set_layout(keymap.FR);
    assert(is(16, false, false, false, b"a"));
    keymap.set_layout(keymap.FR);
    assert(is(30, false, false, false, b"q"));
    keymap.set_layout(keymap.FR);
    assert(is(44, false, false, false, b"w"));
    keymap.set_layout(keymap.FR);
    assert(is(39, false, false, false, b"m"));
    keymap.set_layout(keymap.FR);
    assert(is(3, false, false, false, b"\xc3\xa9"));
    keymap.set_layout(keymap.FR);
    assert(is(3, true, false, false, b"2"));
    keymap.set_layout(keymap.FR);
    assert(is(18, false, false, true, b"\xe2\x82\xac"));
    keymap.set_layout(keymap.FR);
    assert(is(16, false, true, false, b"\x11"));
    keymap.set_layout(keymap.ES);
    assert(is(39, false, false, false, b"\xc3\xb1"));
    keymap.set_layout(keymap.ES);
    assert(is(39, true, false, false, b"\xc3\x91"));
    keymap.set_layout(keymap.ES);
    assert(is(18, false, false, true, b"\xe2\x82\xac"));
    keymap.set_layout(keymap.ES);
    assert(is(3, false, false, true, b"@"));
    keymap.set_layout(keymap.GB);
    assert(is(4, true, false, false, b"\xc2\xa3"));
    keymap.set_layout(keymap.GB);
    assert(is(5, false, false, true, b"\xe2\x82\xac"));
    keymap.set_layout(keymap.GB);
    assert(is(3, true, false, false, b"\x22"));
    keymap.set_layout(keymap.GB);
    assert(is(40, true, false, false, b"@"));
    keymap.set_layout(keymap.GB);
    assert(is(43, false, false, false, b"#"));
    keymap.set_layout(keymap.GB);
    assert(is(86, false, false, false, b"\x5c"));
    keymap.set_layout(keymap.GB);
    assert(is(30, false, true, true, b"\x01"));
}

test "anchors: dead keys by hand" {
    keymap.set_layout(keymap.DE);
    assert(pair(41, false, false, 18, false, false, false, b"\xc3\xaa"));
    keymap.set_layout(keymap.DE);
    assert(pair(13, false, false, 18, true, false, false, b"\xc3\x89"));
    keymap.set_layout(keymap.DE);
    assert(pair(13, true, false, 30, false, false, false, b"\xc3\xa0"));
    keymap.set_layout(keymap.DE);
    assert(pair(41, false, false, 57, false, false, false, b"^"));
    keymap.set_layout(keymap.DE);
    assert(pair(41, false, false, 45, false, false, false, b"^x"));
    keymap.set_layout(keymap.FR);
    assert(pair(26, false, false, 18, false, false, false, b"\xc3\xaa"));
    keymap.set_layout(keymap.FR);
    assert(pair(26, true, false, 16, false, false, false, b"\xc3\xa4"));
    keymap.set_layout(keymap.FR);
    assert(pair(26, true, false, 21, true, false, false, b"\xc2\xa8Y"));
    keymap.set_layout(keymap.ES);
    assert(pair(40, false, false, 18, false, false, false, b"\xc3\xa9"));
    keymap.set_layout(keymap.ES);
    assert(pair(40, false, false, 46, false, false, false, b"\xc2\xb4c"));
    keymap.set_layout(keymap.ES);
    assert(pair(39, false, true, 49, false, false, false, b"\xc3\xb1"));
    keymap.set_layout(keymap.ES);
    assert(pair(13, false, true, 46, true, false, false, b"\xc3\x87"));
    keymap.set_layout(keymap.GB);
    assert(pair(40, false, true, 24, false, false, false, b"\xc3\xb4"));
    keymap.set_layout(keymap.GB);
    assert(pair(39, false, true, 21, false, false, false, b"\xc3\xbd"));
    keymap.set_layout(keymap.GB);
    assert(pair(26, false, true, 57, false, false, false, b"\xc2\xa8"));
}

test "US is today's keymap; the layout index and its names" {
    keymap.set_layout(keymap.US);
    assert(keymap.layout() == keymap.US && !keymap.has_altgr());
    assert(is(30, false, false, false, b"a") && is(30, false, false, true, b"a"));   // AltGr is no level
    assert(is(3, true, false, false, b"@") && is(40, false, false, false, b"'"));
    assert(is(30, false, true, false, b"\x01") && is(103, false, false, false, b"\x1b[A"));
    assert(is(86, false, false, false, b""));
    keymap.set_layout(keymap.DE);
    assert(keymap.byte_of(21, false, false) == 'y' as I64);   // byte_of and seq_of stay US
    keymap.set_layout(99);
    assert(keymap.layout() == keymap.DE);   // out of range: unchanged
    keymap.set_layout(-1);
    assert(keymap.layout() == keymap.DE);
    assert(dead(41, false, false));
    keymap.set_layout(keymap.DE);
    assert(!keymap.dead_pending());   // set_layout drops a waiting dead key
    assert(keymap.LAYOUTS == 5);
    U8[32] nm;
    I64 n0 = keymap.layout_name(keymap.US, nm);
    assert(n0 == len(b"English (US)") && equal(nm[0..n0], b"English (US)"));
    I64 n1 = keymap.layout_name(keymap.GB, nm);
    assert(n1 == len(b"English (UK)") && equal(nm[0..n1], b"English (UK)"));
    I64 n2 = keymap.layout_name(keymap.DE, nm);
    assert(n2 == len(b"German") && equal(nm[0..n2], b"German"));
    I64 n3 = keymap.layout_name(keymap.FR, nm);
    assert(n3 == len(b"French") && equal(nm[0..n3], b"French"));
    I64 n4 = keymap.layout_name(keymap.ES, nm);
    assert(n4 == len(b"Spanish") && equal(nm[0..n4], b"Spanish"));
    assert(keymap.layout_name(5, nm) == 0 && keymap.layout_name(-1, nm) == 0);
}
