    assert(is(25, true, false, true, b""));
    assert(is(26, false, false, false, b"["));
    assert(is(26, true, false, false, b"\x7b"));
    assert(dead(26, false, true));   // dead_diaeresis
    assert(is(26, true, false, true, b""));
    assert(is(27, false, false, false, b"]"));
