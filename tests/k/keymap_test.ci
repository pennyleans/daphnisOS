test "ES: dead_cedilla (code 13, AltGr) with every letter, space and other keys" {
    keymap.set_layout(keymap.ES);
    assert(pair(13, false, true, 30, true, false, false, b"\xc2\xb8A"));   // A
    assert(pair(13, false, true, 48, true, false, false, b"\xc2\xb8B"));   // B
    assert(pair(13, false, true, 46, true, false, false, b"\xc3\x87"));   // C
    assert(pair(13, false, true, 32, true, false, false, b"\xc2\xb8D"));   // D
    assert(pair(13, false, true, 18, true, false, false, b"\xc2\xb8E"));   // E
    assert(pair(13, false, true, 33, true, false, false, b"\xc2\xb8F"));   // F
    assert(pair(13, false, true, 34, true, false, false, b"\xc2\xb8G"));   // G
