X=$((6 * 7)); ECHO "SIX TIMES SEVEN IS $X"
TEST -F HELLO.TXT && ECHO HELLO.TXT EXISTS
CAT < LINES.TXT | SORT -R | HEAD -2
SEQ 1 5 | XARGS ECHO
