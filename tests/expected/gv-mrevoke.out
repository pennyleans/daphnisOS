mrevoke: child 1: grant disk and net again, no prompt (want -EACCES -13) = -13
mrevoke: child 1: grant disk alone, still its own (want 0) = 0
mrevoke: child 1: a socket now (want -EACCES -13) = -13
mrevoke: a child forked after the revoke: its word (want 1) = 1
mrevoke: a child forked after the revoke: grant net (want -EACCES -13) = -13
mrevoke: a child forked after the revoke: a socket (want -EACCES -13) = -13
mrevoke: a program exec'd after the revoke: its word (want 1) = 1
mrevoke: a program exec'd after the revoke: grant net (want -EACCES -13) = -13
mrevoke: a program exec'd after the revoke: a socket (want -EACCES -13) = -13
mrevoke: grandchild: its word after the revoke (want 1) = 1
mrevoke: grandchild: grant net again (want -EACCES -13) = -13
mrevoke: desk: revoke disk, naming the orphan of window A (want 1) = 1
mrevoke: the orphan: its word after the revoke (want 0) = 0
