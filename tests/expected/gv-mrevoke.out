mrevoke: child 1: grant disk and net, within the ceiling (want 0) = 0
mrevoke: child 1: its word (want 3) = 3
mrevoke: child 1: a socket (want 0) = 0
mrevoke: desk: child 1's word before (want 3) = 3
mrevoke: desk: revoke net, naming the grandchild: the whole window, 2 processes (want 2) = 2
mrevoke: desk: child 1's word (want 1) = 1
mrevoke: desk: the grandchild's word (want 1) = 1
mrevoke: desk: child 2's word, another window (want 2) = 2
mrevoke: desk: revoke net again: none holds it (want 0) = 0
