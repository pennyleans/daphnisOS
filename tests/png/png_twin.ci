// tests/png/png_twin.ci: U-PNG's writers for an independent reader (docs/specs/2026-11-11-u-png.md). It prints each
// zlib case as `zlib NAME N`, `in HEX`, `out HEX`, and each picture as `png NAME W H CH`, `px HEX`, `file HEX`.
// tools/check-png.py inflates every stream with the host's zlib and reads every file with its own strict PNG reader
// (and Pillow's, where the host has it), then compares with the bytes put in. Run by check.sh:
// cint run --root . tests/png/png_twin.ci > OUT && python3 tools/check-png.py OUT
import user.ci.core.deflate;
import user.ci.core.png;

I64 seed = 1;

I64 rnd() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed >> 16;
}

void hex(in U8[_] b, I64 n) {
    for i in 0..n { "{b[i]:02x}"; }
    "\n";
}

// The rest of a `zlib NAME` line, the name printed by the caller.
void stream(I64 n, I64 kind) {
    U8[100000] b;
    U8[110000] z;
    seed = 3 + kind;
    I64 run = 0;
    I64 v = 0;
    for i in 0..n {
        if (kind == 1) { v = rnd() & 255; }
        else if (kind == 2) { v = b"Index shows the home, Trash and the volume; "[i % 44] as I64; }
        else if (kind == 3) { v = (i / 5) % 256; }
        else if (kind == 4) {
            if (run == 0) {
                v = rnd() & 255;
                run = 1 + rnd() % 12;
            }
            run = run - 1;
        }
        b[i] = v as U8;
    }
    I64 e = deflate.zlib(b, 0, n, z, 0);
    " {n}\nin ";
    hex(b, n);
    "out ";
    hex(z, e);
}

// The rest of a `png NAME` line, the name printed by the caller.
void picture(I64 w, I64 h, I64 ch, I64 kind) {
    U8[160000] px;
    U8[170000] raw;
    U8[180000] f;
    seed = 17 + kind;
    for y in 0..h {
        for x in 0..w {
            for c in 0..ch {
                I64 v = 0;
                if (kind == 0) { v = 20 + 70 * c; }
                else if (kind == 1) { v = rnd() & 255; }
                else if (kind == 2) { v = (x * 5 + y * 9 + c * 40) % 256; }
                else if (kind == 3) { v = ((x / 4 + y / 3 + c) % 2) * 190 + 30; }
                else {
                    v = (rnd() % 3) * 90;
                    if (c == 3) { v = (y * 255) / h; }
                }
                px[(y * w + x) * ch + c] = v as U8;
            }
        }
    }
    I64 n = png.encode(px, w, h, ch, raw, f);
    " {w} {h} {ch}\npx ";
    hex(px, w * h * ch);
    "file ";
    hex(f, n);
}

void main() {
    "zlib empty";
    stream(0, 0);
    "zlib zeros";
    stream(70000, 0);
    "zlib noise";
    stream(70000, 1);
    "zlib phrase";
    stream(20000, 2);
    "zlib ramp";
    stream(5000, 3);
    "zlib runs";
    stream(100000, 4);
    "png dot-rgb";
    picture(1, 1, 3, 2);
    "png dot-rgba";
    picture(1, 1, 4, 1);
    "png flat-rgba";
    picture(200, 120, 4, 0);
    "png noise-rgb";
    picture(61, 47, 3, 1);
    "png gradient-rgb";
    picture(199, 101, 3, 2);
    "png gradient-rgba";
    picture(101, 199, 4, 2);
    "png checker-rgba";
    picture(173, 57, 4, 3);
    "png alpha-rgba";
    picture(129, 63, 4, 4);
    "png tall-rgb";
    picture(3, 400, 3, 3);
}
