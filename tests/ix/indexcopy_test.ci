// tests/ix/indexcopy_test.ci: Index's Copy and Paste (user/ci/kit/indexcopy.ci), hosted over a tree in memory that
// answers each step as the program's call would: a folder copies whole, a taken name takes the next free one, a copy
// into itself is refused, a paste's folder is held, a clip is taken whole or not at all, a link copies as a link and is
// never followed, the wheel's share, the limits, and a failure or a cancel at every step leaving the folder shown as it
// was and the source unwritten. Run by check.sh with every tests/ix/*_test.ci.
import user.ci.kit.indexcopy;
import user.ci.kit.wheel;

const I64 DIR = 0x4000;
const I64 REG = 0x8000;
const I64 LNK = 0xA000;
const I64 FIFO = 0x1000;
const I64 EIO = 5;
const I64 CAP = 600;                 // the tree's entries

// --- the tree: each entry's parent, name, mode, size, a link's target ---
I64[600] f_par;
I64[600] f_noff;
I64[600] f_nlen;
I64[600] f_mode;
I64[600] f_size;
I64[600] f_toff;
I64[600] f_tlen;
Bool[600] f_live;
U8[65536] f_names;
I64 f_ntop = 0;
I64 fn = 0;
I64 g_ino = 0;                       // the last stat's
I64 g_mode = 0;
I64 g_size = 0;
I64 src_e = 0;                       // the open files
I64 src_off = 0;
I64 dst_e = 0;
I64 f_open = 0;
I64 lt_off = 0;                      // the last link read
I64 lt_len = 0;
U8[65536] lb;                        // a listing
U8[8192] lp;                         // a path being looked up, and its tail
U8[8192] lq;

I64 H = 0;
I64 S = 0;
I64 T = 0;

void reset() {
    fn = 1;
    f_ntop = 0;
    f_par[0] = 0 - 1;
    f_nlen[0] = 0;
    f_mode[0] = DIR | 0x1ED;
    f_size[0] = 0;
    f_tlen[0] = 0;
    f_live[0] = true;
    f_open = 0;
}

I64 keep(in U8[_] s, I64 n) {
    I64 o = f_ntop;
    for q in 0..n { f_names[o + q] = s[q]; }
    f_ntop = f_ntop + n;
    return o;
}

I64 mk(I64 par, in U8[_] nm, I64 m, I64 sz) {
    I64 e = fn;
    fn = fn + 1;
    f_par[e] = par;
    f_noff[e] = keep(nm, len(nm));
    f_nlen[e] = len(nm);
    f_mode[e] = m;
    f_size[e] = sz;
    f_tlen[e] = 0;
    f_live[e] = true;
    return e;
}

I64 lk(I64 par, in U8[_] nm, in U8[_] target) {
    I64 e = mk(par, nm, LNK | 0x1FF, len(target));
    f_toff[e] = keep(target, len(target));
    f_tlen[e] = len(target);
    return e;
}

// /h/s holds a.txt (150,000 bytes, 0644) and d (0555): b (10 bytes, 0400), e (an empty folder, 0750) and .hid (empty);
// /h/t is empty.
void base() {
    reset();
    H = mk(0, b"h", DIR | 0x1ED, 0);
    S = mk(H, b"s", DIR | 0x1ED, 0);
    T = mk(H, b"t", DIR | 0x1ED, 0);
    I64 a = mk(S, b"a.txt", REG | 0x1A4, 150000);
    I64 d = mk(S, b"d", DIR | 0x16D, 0);
    I64 b = mk(d, b"b", REG | 0x100, 10);
    I64 e = mk(d, b"e", DIR | 0x1E8, 0);
    I64 h = mk(d, b".hid", REG | 0x180, 0);
}

Bool named(I64 e, in U8[_] nm, I64 n) {
    if (f_nlen[e] != n) { return false; }
    for q in 0..n {
        if (f_names[f_noff[e] + q] != nm[q]) { return false; }
    }
    return true;
}

I64 find(I64 par, in U8[_] nm, I64 n) {
    for e in par + 1..fn {
        if (f_live[e] && f_par[e] == par && named(e, nm, n)) { return e; }
    }
    return 0 - 1;
}

// The entry at path p, through every link on the way (an absolute one), and through the last when last says so.
I64 lookup(in U8[_] p, Bool last) {
    I64 ln = len(p);
    for q in 0..ln { lp[q] = p[q]; }
    I64 hops = 0;
    while (true) {
        I64 cur = 0;
        I64 i = 0;
        Bool again = false;
        while (i < ln && !again) {
            while (i < ln && lp[i] == '/') { i = i + 1; }
            if (i < ln) {
                I64 e = i;
                while (e < ln && lp[e] != '/') { e = e + 1; }
                I64 c = find(cur, lp[i..e], e - i);
                if (c < 0) { return 0 - 2; }
                I64 rest = e;
                while (rest < ln && lp[rest] == '/') { rest = rest + 1; }
                Bool end = rest == ln;
                if ((f_mode[c] & 0xF000) == LNK && (!end || last)) {
                    hops = hops + 1;
                    if (hops > 8 || f_names[f_toff[c]] != '/') { return 0 - 40; }
                    I64 tn = f_tlen[c];
                    for q in 0..tn { lq[q] = f_names[f_toff[c] + q]; }
                    for q in e..ln { lq[tn + q - e] = lp[q]; }
                    ln = tn + ln - e;
                    for q in 0..ln { lp[q] = lq[q]; }
                    again = true;
                } else {
                    if (!end && (f_mode[c] & 0xF000) != DIR) { return 0 - 20; }
                    cur = c;
                    i = e;
                }
            }
        }
        if (!again) { return cur; }
    }
    return 0 - 2;
}

I64 slash(in U8[_] p) {
    I64 s = 0;
    for q in 0..len(p) {
        if (p[q] == '/') { s = q; }
    }
    return s;
}

// The folder that would hold p, or -errno.
I64 holder(in U8[_] p) {
    I64 s = slash(p);
    if (s == 0) { return 0; }
    I64 d = lookup(p[0..s], true);
    if (d >= 0 && (f_mode[d] & 0xF000) != DIR) { return 0 - 20; }
    return d;
}

// A new entry at p: its index, or -errno.
I64 make(in U8[_] p, I64 m, I64 sz) {
    I64 d = holder(p);
    if (d < 0) { return d; }
    I64 s = slash(p) + 1;
    if (find(d, p[s..len(p)], len(p) - s) >= 0) { return 0 - 17; }
    return mk(d, p[s..len(p)], m, sz);
}

I64 f_stat(in U8[_] p) {
    I64 e = lookup(p, false);
    if (e < 0) { return e; }
    g_ino = 1000 + e;
    g_mode = f_mode[e];
    g_size = f_size[e];
    return 0;
}

I64 f_list(in U8[_] p) {
    I64 e = lookup(p, true);
    if (e < 0) { return e; }
    if ((f_mode[e] & 0xF000) != DIR) { return 0 - 20; }
    lb[0] = '.';
    lb[1] = 0;
    lb[2] = '.';
    lb[3] = '.';
    lb[4] = 0;
    I64 n = 5;
    for c in 0..fn {
        if (f_live[c] && f_par[c] == e) {
            for q in 0..f_nlen[c] { lb[n + q] = f_names[f_noff[c] + q]; }
            n = n + f_nlen[c];
            lb[n] = 0;
            n = n + 1;
        }
    }
    return n;
}

I64 f_mkdir(in U8[_] p, I64 m) {
    I64 e = make(p, DIR | m, 0);
    if (e < 0) { return e; }
    return 0;
}

// O_RDONLY | O_NONBLOCK | O_NOFOLLOW: a link last is -ELOOP; a pipe opens at once.
I64 f_open_src(in U8[_] p) {
    I64 e = lookup(p, false);
    if (e < 0) { return e; }
    if ((f_mode[e] & 0xF000) == LNK) { return 0 - 40; }
    src_e = e;
    src_off = 0;
    f_open = f_open + 1;
    return 0;
}

I64 f_open_dst(in U8[_] p, I64 m) {
    I64 e = make(p, REG | m, 0);
    if (e < 0) { return e; }
    dst_e = e;
    f_open = f_open + 1;
    return 0;
}

I64 f_fstat() {
    g_ino = 1000 + src_e;
    g_mode = f_mode[src_e];
    g_size = f_size[src_e];
    return 0;
}

I64 f_bytes() {
    I64 n = f_size[src_e] - src_off;
    if (n > indexcopy.CHUNK) { n = indexcopy.CHUNK; }
    src_off = src_off + n;
    f_size[dst_e] = f_size[dst_e] + n;
    return n;
}

I64 f_readlink(in U8[_] p) {
    I64 e = lookup(p, false);
    if (e < 0) { return e; }
    if ((f_mode[e] & 0xF000) != LNK) { return 0 - 22; }
    lt_off = f_toff[e];
    lt_len = f_tlen[e];
    return lt_len;
}

I64 f_symlink(in U8[_] p) {
    I64 e = make(p, LNK | 0x1FF, lt_len);
    if (e < 0) { return e; }
    f_toff[e] = lt_off;
    f_tlen[e] = lt_len;
    return 0;
}

I64 f_unlink(in U8[_] p) {
    I64 e = lookup(p, false);
    if (e < 0) { return e; }
    if ((f_mode[e] & 0xF000) == DIR) { return 0 - 21; }
    f_live[e] = false;
    return 0;
}

I64 f_rmdir(in U8[_] p) {
    I64 e = lookup(p, false);
    if (e < 0) { return e; }
    if ((f_mode[e] & 0xF000) != DIR) { return 0 - 20; }
    for c in 0..fn {
        if (f_live[c] && f_par[c] == e) { return 0 - 39; }
    }
    f_live[e] = false;
    return 0;
}

Bool under(I64 e, I64 root) {
    I64 c = e;
    while (c >= 0) {
        if (c == root) { return true; }
        c = f_par[c];
    }
    return false;
}

I64 mix(I64 h, I64 x) { return (h * 31 + x) % 1000000007; }

// A digest of every live entry under root: its place, name, mode, size and target.
I64 sig(I64 root) {
    I64 h = 7;
    for e in 0..fn {
        if (f_live[e] && under(e, root)) {
            h = mix(h, e);
            h = mix(h, f_par[e] + 1);
            h = mix(h, f_mode[e]);
            h = mix(h, f_size[e] % 1000003);
            for q in 0..f_nlen[e] { h = mix(h, f_names[f_noff[e] + q] as I64); }
            for q in 0..f_tlen[e] { h = mix(h, f_names[f_toff[e] + q] as I64); }
        }
    }
    return h;
}

I64 at(in U8[_] p) { return lookup(p, false); }

Bool target_is(I64 e, in U8[_] t) {
    if (f_tlen[e] != len(t)) { return false; }
    for q in 0..len(t) {
        if (f_names[f_toff[e] + q] != t[q]) { return false; }
    }
    return true;
}

// --- the program: each step's call on the tree ---
U8[4096] pb;
U8[4096] cb;
U8[1024] gd;                         // the chosen paths, which no write may touch
I64[4] g_at;
I64[4] g_n;
I64 gn = 0;
I64 fail_at = 0 - 1;                 // the step whose call fails with EIO
I64 cancel_at = 0 - 1;               // the step before which the person cancels
I64 bad = 0;                         // writes on a chosen path
I64 far = 0;                         // steps on /h/far
I64 nbytes = 0;                      // BYTES steps
I64 swap_to = 0;                     // /h/s/a.txt becomes this kind just before its OPEN_SRC

void fresh() {
    fail_at = 0 - 1;
    cancel_at = 0 - 1;
    bad = 0;
    far = 0;
    nbytes = 0;
    gn = 0;
    swap_to = 0;
}

// Another entry in /h/s/a.txt's place: a link to /h/s/d/b, a pipe, or another file.
void replace() {
    I64 a = find(S, b"a.txt", 5);
    f_live[a] = false;
    if (swap_to == LNK) {
        I64 l = lk(S, b"a.txt", b"/h/s/d/b");
    } else {
        I64 e = mk(S, b"a.txt", swap_to | 0x1A4, 3);
    }
    swap_to = 0;
}

void guard(in U8[_] p) {
    I64 o = 0;
    if (gn > 0) { o = g_at[gn - 1] + g_n[gn - 1]; }
    for q in 0..len(p) { gd[o + q] = p[q]; }
    g_at[gn] = o;
    g_n[gn] = len(p);
    gn = gn + 1;
}

Bool on(in U8[_] p, in U8[_] g) {
    I64 n = len(g);
    if (len(p) < n || (len(p) > n && p[n] != '/')) { return false; }
    for q in 0..n {
        if (p[q] != g[q]) { return false; }
    }
    return true;
}

Bool hit(in U8[_] p) {
    for k in 0..gn {
        if (on(p, gd[g_at[k]..g_at[k] + g_n[k]])) { return true; }
    }
    return false;
}

void step(I64 o, I64 n, Bool forced) {
    if (o == indexcopy.END) { return; }
    Bool writes = o == indexcopy.MKDIR || o == indexcopy.OPEN_DST || o == indexcopy.SYMLINK;
    writes = writes || o == indexcopy.UNLINK || o == indexcopy.RMDIR;
    if (writes && hit(pb[0..n])) { bad = bad + 1; }
    if (on(pb[0..n], b"/h/far")) { far = far + 1; }
    I64 r = 0 - EIO;
    if (o == indexcopy.OPEN_SRC && swap_to != 0 && on(pb[0..n], b"/h/s/a.txt")) { replace(); }
    if (o == indexcopy.STAT) {
        if (!forced) { r = f_stat(pb[0..n]); }
        indexcopy.stated(r, 1, g_ino, g_mode, g_size);
    } else if (o == indexcopy.FSTAT) {
        if (!forced) { r = f_fstat(); }
        indexcopy.stated(r, 1, g_ino, g_mode, g_size);
    } else if (o == indexcopy.LIST) {
        if (!forced) { r = f_list(pb[0..n]); }
        indexcopy.listed(lb, r);
    } else if (o == indexcopy.BYTES) {
        nbytes = nbytes + 1;
        if (!forced) { r = f_bytes(); }
        indexcopy.moved(r);
    } else if (o == indexcopy.CLOSE) {
        f_open = 0;
        if (!forced) { r = 0; }
        indexcopy.done(r);
    } else {
        if (forced) {
            r = 0 - EIO;
        } else if (o == indexcopy.MKDIR) {
            r = f_mkdir(pb[0..n], indexcopy.mode());
        } else if (o == indexcopy.OPEN_SRC) {
            r = f_open_src(pb[0..n]);
        } else if (o == indexcopy.OPEN_DST) {
            r = f_open_dst(pb[0..n], indexcopy.mode());
        } else if (o == indexcopy.READLINK) {
            r = f_readlink(pb[0..n]);
        } else if (o == indexcopy.SYMLINK) {
            r = f_symlink(pb[0..n]);
        } else if (o == indexcopy.UNLINK) {
            r = f_unlink(pb[0..n]);
        } else {
            r = f_rmdir(pb[0..n]);
        }
        indexcopy.done(r);
    }
}

// Runs the paste to its end: the steps taken.
I64 drive() {
    I64 k = 0;
    while (indexcopy.busy() && k < 200000) {
        k = k + 1;
        if (k == cancel_at) { indexcopy.cancel(); }
        I64 o = indexcopy.next();
        I64 n = indexcopy.path(pb);
        step(o, n, k == fail_at);
    }
    return k;
}

// The clip's names, `|` between them, each ended by a 0 byte into cb: the length.
I64 clip(in U8[_] s) {
    I64 n = len(s);
    for q in 0..n {
        cb[q] = s[q];
        if (s[q] == '|') { cb[q] = 0; }
    }
    cb[n] = 0;
    return n + 1;
}

Bool paste(in U8[_] dir, in U8[_] names, in U8[_] dst) {
    I64 n = clip(names);
    return indexcopy.start(dir, cb[0..n], dst);
}

test "a folder copies whole: its folders, each file's bytes and bits, a folder open to its owner; the source as was" {
    fresh();
    base();
    I64 before = sig(S);
    guard(b"/h/s/a.txt");
    guard(b"/h/s/d");
    assert(paste(b"/h/s", b"a.txt|d", b"/h/t"));
    assert(indexcopy.busy());
    I64 k = drive();
    assert(!indexcopy.busy() && indexcopy.next() == indexcopy.END && indexcopy.failed() == 0);
    I64 a = at(b"/h/t/a.txt");
    assert(a >= 0 && f_mode[a] == (REG | 0x1A4) && f_size[a] == 150000);
    I64 d = at(b"/h/t/d");
    assert(d >= 0 && f_mode[d] == (DIR | 0x1ED));        // 0555 and the owner's 0700
    I64 b = at(b"/h/t/d/b");
    assert(b >= 0 && f_mode[b] == (REG | 0x100) && f_size[b] == 10);
    I64 e = at(b"/h/t/d/e");
    assert(e >= 0 && f_mode[e] == (DIR | 0x1E8));
    I64 h = at(b"/h/t/d/.hid");
    assert(h >= 0 && f_size[h] == 0);
    assert(nbytes == 4 + 2 + 1);                         // 65,536 twice, 18,928, the end; 10, the end; the end
    assert(sig(S) == before && bad == 0 && f_open == 0);
}

test "a name taken in the folder shown takes the next free one; inside a folder the copy made, none is taken" {
    fresh();
    base();
    I64 a = mk(T, b"a.txt", REG | 0x1A4, 5);
    I64 a2 = mk(T, b"a 2.txt", REG | 0x1A4, 5);
    I64 d = mk(T, b"d", DIR | 0x1ED, 0);
    guard(b"/h/s/a.txt");
    guard(b"/h/s/d");
    assert(paste(b"/h/s", b"a.txt|d", b"/h/t"));
    I64 k = drive();
    assert(indexcopy.failed() == 0 && bad == 0);
    I64 a3 = at(b"/h/t/a 3.txt");
    assert(a3 >= 0 && f_size[a3] == 150000);
    assert(f_size[at(b"/h/t/a.txt")] == 5 && f_size[at(b"/h/t/a 2.txt")] == 5);
    assert(at(b"/h/t/d 2/b") >= 0 && at(b"/h/t/d 2/e") >= 0);
    assert(at(b"/h/t/d/b") < 0);
    // Beside itself, in the folder it was copied in; a leading dot is no ending.
    fresh();
    I64 c = mk(S, b".cfg", REG | 0x180, 3);
    guard(b"/h/s/a.txt");
    guard(b"/h/s/.cfg");
    assert(paste(b"/h/s", b"a.txt|.cfg", b"/h/s"));
    k = drive();
    assert(indexcopy.failed() == 0 && bad == 0);
    assert(f_size[at(b"/h/s/a 2.txt")] == 150000 && f_size[at(b"/h/s/a.txt")] == 150000);
    assert(f_size[at(b"/h/s/.cfg 2")] == 3);
}

test "a copy into itself or a folder inside it is refused; beside it, or into a name it only begins, is not" {
    fresh();
    base();
    I64 n = clip(b"d");
    assert(indexcopy.inside(b"/h/s", cb[0..n], b"/h/s/d"));
    assert(indexcopy.inside(b"/h/s", cb[0..n], b"/h/s/d/e"));
    assert(!indexcopy.inside(b"/h/s", cb[0..n], b"/h/s"));
    assert(!indexcopy.inside(b"/h/s", cb[0..n], b"/h/s/dd"));
    assert(!indexcopy.inside(b"/h/s", cb[0..n], b"/h/sd"));
    assert(!indexcopy.inside(b"/h/s", cb[0..n], b"/h"));
    n = clip(b"a.txt|d");
    assert(indexcopy.inside(b"/h/s", cb[0..n], b"/h/s/d/e"));
    n = clip(b"h");
    assert(indexcopy.inside(b"/", cb[0..n], b"/h/t"));
    assert(!indexcopy.inside(b"/", cb[0..n], b"/hx"));
    assert(!paste(b"/h/s", b"a.txt|d", b"/h/s/d/e"));
    assert(!indexcopy.busy() && indexcopy.next() == indexcopy.END);
    // One paste at a time.
    assert(paste(b"/h/s", b"a.txt", b"/h/t"));
    assert(!paste(b"/h/s", b"d", b"/h/t"));
    I64 k = drive();
    assert(indexcopy.failed() == 0 && at(b"/h/t/d") < 0);
}

test "while a paste runs, its folder and each folder inside it are held, undoing too; then none is" {
    fresh();
    base();
    assert(!indexcopy.touches(b"/h/t"));
    assert(paste(b"/h/s", b"a.txt|d", b"/h/t"));
    assert(indexcopy.touches(b"/h/t") && indexcopy.touches(b"/h/t/d") && indexcopy.touches(b"/h/t/d/e"));
    assert(!indexcopy.touches(b"/h/tx") && !indexcopy.touches(b"/h") && !indexcopy.touches(b"/h/s"));
    for i in 0..12 {
        I64 o = indexcopy.next();
        step(o, indexcopy.path(pb), false);
    }
    assert(indexcopy.touches(b"/h/t/d"));
    indexcopy.cancel();
    assert(indexcopy.busy() && indexcopy.touches(b"/h/t") && !indexcopy.touches(b"/h/t2"));
    I64 k = drive();
    assert(!indexcopy.busy() && !indexcopy.touches(b"/h/t"));
    assert(paste(b"/h/s", b"a.txt", b"/"));            // the root: every folder
    assert(indexcopy.touches(b"/") && indexcopy.touches(b"/h/s"));
    indexcopy.cancel();
    assert(!indexcopy.busy() && !indexcopy.touches(b"/"));
}

U8[16384] taken;
U8[256] nb;

// A name of n bytes, all c, in nb.
I64 name(I64 n, U8 c) {
    for q in 0..n { nb[q] = c; }
    return n;
}

test "a clip is taken whole or not at all: 16,384 bytes fit and one more does not; 1024 names fit, 1025 do not" {
    I64 w = 0;
    for k in 0..64 {                                     // 64 names of 255 bytes, each ended: 16,384 exactly
        w = indexcopy.clip_put(taken, w, k, nb[0..name(255, 'a' + (k % 26) as U8)]);
    }
    assert(w == indexcopy.CLIP_BYTES);
    assert(indexcopy.clip_put(taken, w, 64, nb[0..name(1, 'z')]) == 0 - 1);
    w = 0;
    for k in 0..63 { w = indexcopy.clip_put(taken, w, k, nb[0..name(255, 'b')]); }
    w = indexcopy.clip_put(taken, w, 63, nb[0..name(254, 'c')]);
    assert(w == indexcopy.CLIP_BYTES - 1);              // one byte short: a 1-byte name would end one byte over
    assert(indexcopy.clip_put(taken, w, 64, nb[0..name(1, 'd')]) == 0 - 1);
    w = 0;
    for k in 0..1024 {
        w = indexcopy.clip_put(taken, w, k, nb[0..name(1 + k % 9, 'e')]);
        assert(w > 0);
    }
    assert(indexcopy.clip_put(taken, w, 1024, nb[0..name(1, 'f')]) == 0 - 1);   // the 1025th
    assert(indexcopy.clip_put(taken, 0, 0, nb[0..0]) == 0 - 1);                 // no empty name
    // The whole clip of 1024 starts a paste; a clip of 1025 names, which clip_put never makes, does not.
    fresh();
    base();
    assert(indexcopy.start(b"/h/s", taken[0..w], b"/h/t") && indexcopy.busy());
    indexcopy.cancel();
    I64 k = drive();
    assert(!indexcopy.busy() && at(b"/h/t/e") < 0);
    U8[4096] big;
    I64 b = 0;
    for q in 0..1025 {
        big[b] = 'g';
        big[b + 1] = ('0' as I64 + q % 10) as U8;
        big[b + 2] = 0;
        b = b + 3;
    }
    assert(!indexcopy.start(b"/h/s", big[0..b], b"/h/t") && !indexcopy.busy());
}

U8[4096] lpath;

// A clean path of exactly n bytes (2 to 4096) in lpath: names of 255 bytes, then the last of what is left.
I64 sized(I64 n) {
    I64 w = 0;
    I64 c = 0;
    while (n - w > 256) {
        lpath[w] = '/';
        for q in 0..255 { lpath[w + 1 + q] = ('a' as I64 + c) as U8; }
        w = w + 256;
        c = c + 1;
    }
    lpath[w] = '/';
    for q in 0..(n - w - 1) { lpath[w + 1 + q] = 'z'; }
    return n;
}

// Starts a paste where can_start() holds and checks it began, then cancels it to its end.
Bool starts(in U8[_] dir, in U8[_] names, in U8[_] dst) {
    if (!indexcopy.can_start(dir, names, dst)) { return false; }
    Bool began = indexcopy.start(dir, names, dst);
    indexcopy.cancel();
    I64 k = drive();
    return began && !indexcopy.busy();
}

// Where can_start() is false, start() refuses and nothing runs.
Bool refused(in U8[_] dir, in U8[_] names, in U8[_] dst) {
    return !indexcopy.can_start(dir, names, dst) && !indexcopy.start(dir, names, dst) && !indexcopy.busy();
}

test "a paste starts exactly where can_start() holds: each folder's path 1 to 4095 bytes, 4096 not, the clip a name" {
    fresh();
    base();
    I64 shown = sig(T);
    I64 n = clip(b"a.txt");
    assert(starts(lpath[0..sized(4095)], cb[0..n], b"/h/t"));          // the clip's folder
    assert(refused(lpath[0..sized(4096)], cb[0..n], b"/h/t"));
    assert(starts(b"/h/s", cb[0..n], lpath[0..sized(4095)]));          // the folder shown
    assert(refused(b"/h/s", cb[0..n], lpath[0..sized(4096)]));
    assert(refused(b"", cb[0..n], b"/h/t") && refused(b"/h/s", cb[0..n], b""));
    assert(refused(b"/h/s", cb[0..clip(b".|..")], b"/h/t"));          // no name but . and ..
    assert(refused(b"/h/s", cb[0..0], b"/h/t"));
    for q in 0..255 { lpath[q] = 'n'; }
    assert(starts(b"/h/s", cb[0..clip(lpath[0..255])], b"/h/t"));     // 255 bytes, which /h/s does not hold
    for q in 0..256 { lpath[q] = 'n'; }
    assert(refused(b"/h/s", cb[0..clip(lpath[0..256])], b"/h/t"));
    assert(refused(b"/h/s", cb[0..clip(b"d")], b"/h/s/d/e"));         // inside(), as before
    assert(paste(b"/h/s", b"a.txt", b"/h/t"));                        // one paste at a time
    assert(!indexcopy.can_start(b"/h/s", cb[0..n], b"/h"));
    indexcopy.cancel();
    I64 k = drive();
    assert(!indexcopy.busy() && sig(T) == shown);
}

test "clip_put takes an entry's name only: not . or .., not past 255 bytes, no 0 byte or /; its clip can_start()" {
    I64 w = indexcopy.clip_put(taken, 0, 0, b"...");
    w = indexcopy.clip_put(taken, w, 1, b".a");
    w = indexcopy.clip_put(taken, w, 2, nb[0..name(255, 'q')]);
    assert(w == 4 + 3 + 256);
    assert(indexcopy.clip_put(taken, w, 3, b".") == 0 - 1 && indexcopy.clip_put(taken, w, 3, b"..") == 0 - 1);
    assert(indexcopy.clip_put(taken, w, 3, b"a/b") == 0 - 1);
    nb[1] = 0;
    assert(indexcopy.clip_put(taken, w, 3, nb[0..3]) == 0 - 1);
    U8[300] wide;
    for q in 0..256 { wide[q] = 'o'; }
    assert(indexcopy.clip_put(taken, w, 3, wide[0..256]) == 0 - 1);
    fresh();
    base();
    assert(indexcopy.can_start(b"/h/s", taken[0..w], b"/h/t"));
}

test "a link copies as a link and is never followed; a pipe is left out" {
    fresh();
    base();
    I64 fd = mk(H, b"far", DIR | 0x1ED, 0);
    I64 big = mk(fd, b"big", REG | 0x1A4, 9000000);
    I64 l1 = lk(S, b"ln", b"../far");
    I64 d = find(S, b"d", 1);
    I64 l2 = lk(d, b"l2", b"/h/far");
    I64 p = mk(d, b"p", FIFO | 0x1A4, 0);
    guard(b"/h/s/ln");
    guard(b"/h/s/d");
    assert(paste(b"/h/s", b"ln|d", b"/h/t"));
    I64 k = drive();
    assert(indexcopy.failed() == 0 && bad == 0 && far == 0);
    I64 c1 = at(b"/h/t/ln");
    assert(c1 >= 0 && (f_mode[c1] & 0xF000) == LNK);
    assert(target_is(c1, b"../far"));
    I64 c2 = at(b"/h/t/d/l2");
    assert(c2 >= 0 && (f_mode[c2] & 0xF000) == LNK && target_is(c2, b"/h/far"));
    assert(at(b"/h/t/d/p") < 0 && at(b"/h/t/d/b") >= 0);
    assert(nbytes == 2 + 1);                             // b and .hid only: nothing of /h/far
}

test "a file swapped between its stat and its open is never read: a link (ELOOP), a pipe or another file (EAGAIN)" {
    I64[3] kinds;
    kinds[0] = LNK;
    kinds[1] = FIFO;
    kinds[2] = REG;
    I64[3] want;
    want[0] = 0 - 40;
    want[1] = 0 - 11;
    want[2] = 0 - 11;
    for i in 0..3 {
        fresh();
        base();
        I64 shown = sig(T);
        guard(b"/h/s/a.txt");
        swap_to = kinds[i];
        assert(paste(b"/h/s", b"a.txt", b"/h/t"));
        I64 k = drive();
        assert(indexcopy.failed() == want[i] && swap_to == 0);
        assert(sig(T) == shown && nbytes == 0 && f_open == 0 && bad == 0);
    }
}

test "the wheel's share: unknown while the tree is measured, then 0 up to 100 by bytes and entries; unknown undoing" {
    fresh();
    base();
    assert(paste(b"/h/s", b"a.txt|d", b"/h/t"));
    I64 unknown = 0;
    I64 lo = 101;
    I64 hi = 0 - 1;
    I64 last = 0 - 1;
    Bool rising = true;
    Bool measured = false;
    while (indexcopy.busy()) {
        I64 s = indexcopy.share();
        if (s == wheel.UNKNOWN) {
            unknown = unknown + 1;
            if (measured) { rising = false; }
        } else {
            measured = true;
            if (s < last) { rising = false; }
            last = s;
            if (s < lo) { lo = s; }
            if (s > hi) { hi = s; }
        }
        I64 o = indexcopy.next();
        step(o, indexcopy.path(pb), false);
    }
    assert(unknown > 0 && lo == 0 && hi == 100 && rising);
    // A cancel halfway: the undo's wheel is unknown.
    fresh();
    base();
    assert(paste(b"/h/s", b"a.txt|d", b"/h/t"));
    while (indexcopy.share() == wheel.UNKNOWN) {
        I64 o = indexcopy.next();
        step(o, indexcopy.path(pb), false);
    }
    for i in 0..3 {
        I64 o = indexcopy.next();
        step(o, indexcopy.path(pb), false);
    }
    indexcopy.cancel();
    assert(indexcopy.busy() && indexcopy.share() == wheel.UNKNOWN);
    I64 k = drive();
    assert(indexcopy.failed() == 0 - 125 && at(b"/h/t/a.txt") < 0);
}

test "the wheel shows once a paste has run 400 ms: 16 px, 16 in from the status bar's right end, centered in it" {
    U32[400] row;
    I64 sw = 400;
    I64 sh = 300;
    I64 x0 = sw - 16 - 16;
    I64 y0 = sh - 28 + 6;
    U32 ground = 0x123456;
    for x in 0..sw { row[x] = ground; }
    indexcopy.wheel_row(row, y0 + 8, sw, sh, wheel.DARK, 1000, true);
    for x in 0..sw { assert(row[x] == ground); }
    fresh();
    base();
    assert(paste(b"/h/s", b"a.txt|d", b"/h/t"));
    indexcopy.wheel_row(row, y0 + 8, sw, sh, wheel.DARK, indexcopy.SHOW_MS - 1, true);
    for x in 0..sw { assert(row[x] == ground); }
    indexcopy.wheel_row(row, y0 + 8, sw, sh, wheel.DARK, indexcopy.SHOW_MS, true);
    I64 inked = 0;
    for x in 0..sw {
        if (row[x] != ground) {
            assert(x >= x0 && x < x0 + 16);
            inked = inked + 1;
        }
    }
    assert(inked > 8);
    for x in 0..sw { row[x] = ground; }
    indexcopy.wheel_row(row, y0 - 1, sw, sh, wheel.DARK, indexcopy.SHOW_MS, true);
    indexcopy.wheel_row(row, y0 + 16, sw, sh, wheel.DARK, indexcopy.SHOW_MS, true);
    for x in 0..sw { assert(row[x] == ground); }
    I64 k = drive();
    assert(indexcopy.failed() == 0);
}

// A clash, a link, folders and files: every kind of step.
void mixed() {
    base();
    I64 a = mk(T, b"a.txt", REG | 0x1A4, 5);
    I64 l = lk(S, b"ln", b"/h/s/d");
    guard(b"/h/s/a.txt");
    guard(b"/h/s/d");
    guard(b"/h/s/ln");
}

test "a failure at any step removes each entry the copy made, with all under it, and nothing else; the source as was" {
    fresh();
    mixed();
    assert(paste(b"/h/s", b"a.txt|d|ln", b"/h/t"));
    I64 steps = drive();
    assert(indexcopy.failed() == 0 && steps > 20);
    for n in 1..steps + 1 {
        fresh();
        mixed();
        I64 src = sig(S);
        I64 dst = sig(T);
        fail_at = n;
        assert(paste(b"/h/s", b"a.txt|d|ln", b"/h/t"));
        I64 k = drive();
        assert(!indexcopy.busy() && indexcopy.failed() == 0 - EIO);
        assert(sig(T) == dst && sig(S) == src && bad == 0 && f_open == 0);
    }
}

test "a cancel at any step undoes the paste the same way" {
    fresh();
    mixed();
    assert(paste(b"/h/s", b"a.txt|d|ln", b"/h/t"));
    I64 steps = drive();
    for n in 1..steps + 1 {
        fresh();
        mixed();
        I64 src = sig(S);
        I64 dst = sig(T);
        cancel_at = n;
        assert(paste(b"/h/s", b"a.txt|d|ln", b"/h/t"));
        I64 k = drive();
        assert(!indexcopy.busy() && indexcopy.failed() == 0 - 125);
        assert(sig(T) == dst && sig(S) == src && bad == 0 && f_open == 0);
    }
}

test "the limits fail whole: a name past 255 bytes, a path past 4096, a folder 256 deep" {
    U8[300] nm;
    // A 254-byte name beside itself: `NAME 2` is 256 bytes.
    fresh();
    base();
    for q in 0..254 { nm[q] = 'n'; }
    I64 f = mk(S, nm[0..254], REG | 0x1A4, 7);
    I64 src = sig(S);
    I64 n = clip(nm[0..254]);
    assert(indexcopy.start(b"/h/s", cb[0..n], b"/h/s"));
    I64 k = drive();
    assert(indexcopy.failed() == 0 - 36 && sig(S) == src);
    // Paths in the folder shown past 4096 bytes, 15 folders down: those made are removed.
    fresh();
    base();
    U8[4096] dst;
    dst[0] = '/';
    dst[1] = 'h';
    dst[2] = '/';
    dst[3] = 't';
    I64 dn = 4;
    I64 up = T;
    for i in 0..4 {
        for q in 0..255 { nm[q] = (97 + i) as U8; }
        up = mk(up, nm[0..255], DIR | 0x1ED, 0);
        dst[dn] = '/';
        for q in 0..255 { dst[dn + 1 + q] = nm[q]; }
        dn = dn + 256;
    }
    up = S;
    for i in 0..16 {
        for q in 0..200 { nm[q] = 'x'; }
        up = mk(up, nm[0..200], DIR | 0x1ED, 0);
    }
    src = sig(S);
    I64 shown = sig(T);
    n = clip(nm[0..200]);
    assert(indexcopy.start(b"/h/s", cb[0..n], dst[0..dn]));
    k = drive();
    assert(indexcopy.failed() == 0 - 36 && sig(S) == src && sig(T) == shown);
    // A folder 256 deep: the measure stops at DEPTH before anything is made.
    fresh();
    base();
    up = S;
    for i in 0..256 { up = mk(up, b"x", DIR | 0x1ED, 0); }
    shown = sig(T);
    assert(paste(b"/h/s", b"x", b"/h/t"));
    k = drive();
    assert(indexcopy.failed() == 0 - 40 && sig(T) == shown);
}

test "a folder the copy made is never copied again: a folder shown through a link into the source ends" {
    fresh();
    reset();
    H = mk(0, b"h", DIR | 0x1ED, 0);
    I64 a = mk(H, b"A", DIR | 0x1ED, 0);
    I64 sub = mk(a, b"sub", DIR | 0x1ED, 0);
    I64 f = mk(a, b"f", REG | 0x1A4, 10);
    I64 l = lk(H, b"L", b"/h/A");
    I64 n = clip(b"A");
    assert(!indexcopy.inside(b"/h", cb[0..n], b"/h/L/sub"));
    assert(paste(b"/h", b"A", b"/h/L/sub"));
    I64 k = drive();
    assert(indexcopy.failed() == 0);
    I64 top = at(b"/h/A/sub/A");
    assert(top >= 0 && at(b"/h/A/sub/A/f") >= 0 && at(b"/h/A/sub/A/sub") >= 0);
    assert(at(b"/h/A/sub/A/sub/A") < 0);
}
