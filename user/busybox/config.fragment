# user/busybox/config.fragment: what busybox 1.36.1 is built with for Daphnis (user/busybox/build.sh
# applies it over `make allnoconfig`). Static, musl, ash with the applets the scripted session
# uses (P-0 adds mkdir, rmdir, mv and ls -R; P-2 adds find, stat with -c and md5sum, and
# for P-3 cp, truncate and sync); no job control, no line editing, no sendfile, no locale.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_BUSYBOX=y
CONFIG_NO_DEBUG_LIB=y
CONFIG_FEATURE_COPYBUF_KB=4
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y
CONFIG_LS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_GREP=y
CONFIG_SORT=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_TR=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_PRINTF=y
CONFIG_SEQ=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_CUT=y
CONFIG_UNIQ=y
CONFIG_REV=y
CONFIG_RM=y
CONFIG_TEE=y
CONFIG_XARGS=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_MV=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FIND=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_MD5SUM=y
CONFIG_CP=y
CONFIG_TRUNCATE=y
CONFIG_SYNC=y
# CONFIG_FEATURE_USE_SENDFILE is not set
# CONFIG_FEATURE_SUID is not set
# CONFIG_FEATURE_SYSLOG is not set
# CONFIG_FEATURE_DEVPTS is not set
# CONFIG_UNICODE_SUPPORT is not set
# CONFIG_LOCALE_SUPPORT is not set
# CONFIG_FEATURE_CLEAN_UP is not set
# CONFIG_FEATURE_COMPRESS_USAGE is not set
# CONFIG_SHOW_USAGE is not set
# CONFIG_FEATURE_VERBOSE_USAGE is not set
# CONFIG_PIE is not set
# CONFIG_FEATURE_SHARED_BUSYBOX is not set
# CONFIG_INSTALL_NO_USR is not set
# CONFIG_ASH_JOB_CONTROL is not set
# CONFIG_ASH_ALIAS is not set
# CONFIG_ASH_RANDOM_SUPPORT is not set
# CONFIG_ASH_EXPAND_PRMT is not set
# CONFIG_ASH_IDLE_TIMEOUT is not set
# CONFIG_ASH_MAIL is not set
# CONFIG_ASH_HELP is not set
# CONFIG_ASH_GETOPTS is not set
# CONFIG_ASH_CMDCMD is not set
# CONFIG_ASH_BASH_COMPAT is not set
# CONFIG_FEATURE_EDITING is not set
# CONFIG_FEATURE_LS_TIMESTAMPS is not set
# CONFIG_FEATURE_LS_USERNAME is not set
# CONFIG_FEATURE_LS_FILETYPES is not set
# CONFIG_FEATURE_LS_FOLLOWLINKS is not set
# CONFIG_FEATURE_LS_WIDTH is not set
# CONFIG_FEATURE_LS_COLOR is not set
# CONFIG_FEATURE_INSTALLER is not set
