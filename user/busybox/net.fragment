# user/busybox/net.fragment: what user/bin/busybox-net adds over config.fragment (N-3, the net flavor's image):
# wget over plain HTTP to an address (no DNS, no TLS, no FTP), and md5sum to check what it fetched.
CONFIG_WGET=y
# CONFIG_FEATURE_WGET_LONG_OPTIONS is not set
# CONFIG_FEATURE_WGET_STATUSBAR is not set
# CONFIG_FEATURE_WGET_FTP is not set
# CONFIG_FEATURE_WGET_AUTHENTICATION is not set
# CONFIG_FEATURE_WGET_TIMEOUT is not set
# CONFIG_FEATURE_WGET_HTTPS is not set
# CONFIG_FEATURE_WGET_OPENSSL is not set
CONFIG_MD5SUM=y
