# user/busybox/oracle.fragment: what user/bin/busybox-oracle adds over config.fragment, the oracle of the native core
# set (docs/specs/2026-11-06-c-core.md section 6, gate 1). check-core.sh alone runs it; it is in no image. It adds the
# applets of tier C-1 that user/bin/busybox lacks and the features behind the options of the spec's section 8; each
# feature of a new applet is named here, on or off, so `make oldconfig` takes no default.
# ls: -F, -t and -l's times; owners stay numeric (Daphnis has no /etc/passwd)
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
# du: XCU's 512-byte units unless -k
CONFIG_DU=y
# CONFIG_FEATURE_DU_DEFAULT_BLOCKSIZE_1K is not set
CONFIG_MKTEMP=y
CONFIG_CMP=y
CONFIG_SHA256SUM=y
CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y
# tr: XCU's classes and equivalence classes
CONFIG_FEATURE_TR_CLASSES=y
CONFIG_FEATURE_TR_EQUIV=y
# find: XCU's primaries (section 8 and -path, -depth, -xdev, -perm, -links, -user, -group, -atime, -ctime), not the
# busybox-only ones
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_FEATURE_FIND_MTIME=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_NEWER=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_EXEC_PLUS=y
CONFIG_FEATURE_FIND_NOT=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_PRUNE=y
CONFIG_FEATURE_FIND_LINKS=y
CONFIG_FEATURE_FIND_PATH=y
CONFIG_FEATURE_FIND_DEPTH=y
CONFIG_FEATURE_FIND_GROUP=y
CONFIG_FEATURE_FIND_USER=y
CONFIG_FEATURE_FIND_XDEV=y
CONFIG_FEATURE_FIND_PERM=y
CONFIG_FEATURE_FIND_CTIME=y
CONFIG_FEATURE_FIND_ATIME=y
# CONFIG_FEATURE_FIND_MMIN is not set
# CONFIG_FEATURE_FIND_AMIN is not set
# CONFIG_FEATURE_FIND_CMIN is not set
# CONFIG_FEATURE_FIND_EXECUTABLE is not set
# CONFIG_FEATURE_FIND_MAXDEPTH is not set
# CONFIG_FEATURE_FIND_INUM is not set
# CONFIG_FEATURE_FIND_SAMEFILE is not set
# CONFIG_FEATURE_FIND_QUIT is not set
# CONFIG_FEATURE_FIND_DELETE is not set
# CONFIG_FEATURE_FIND_EMPTY is not set
# CONFIG_FEATURE_FIND_REGEX is not set
# CONFIG_FEATURE_FIND_CONTEXT is not set
# xargs: XCU's quotes, -0, -I, -x and -p; not -P or -a
CONFIG_FEATURE_XARGS_SUPPORT_CONFIRMATION=y
CONFIG_FEATURE_XARGS_SUPPORT_QUOTES=y
CONFIG_FEATURE_XARGS_SUPPORT_TERMOPT=y
CONFIG_FEATURE_XARGS_SUPPORT_ZERO_TERM=y
CONFIG_FEATURE_XARGS_SUPPORT_REPL_STR=y
# CONFIG_FEATURE_XARGS_SUPPORT_PARALLEL is not set
# CONFIG_FEATURE_XARGS_SUPPORT_ARGS_FILE is not set
# env, sleep and date: XCU's; date -d @N; no fancy sleep, no ISO or nanosecond date
CONFIG_ENV=y
CONFIG_SLEEP=y
# CONFIG_FEATURE_FANCY_SLEEP is not set
CONFIG_DATE=y
# CONFIG_FEATURE_DATE_ISOFMT is not set
# CONFIG_FEATURE_DATE_NANO is not set
# CONFIG_FEATURE_DATE_COMPAT is not set
# BU-2b (docs/specs/2026-11-07-bu2-meta.md section 6): tier C-2's ln, chmod, touch (XCU's -a -d -m -t -r) and uname
CONFIG_LN=y
CONFIG_CHMOD=y
CONFIG_TOUCH=y
CONFIG_FEATURE_TOUCH_SUSV3=y
CONFIG_UNAME=y
CONFIG_UNAME_OSNAME="GNU/Linux"
# CONFIG_BB_ARCH is not set
