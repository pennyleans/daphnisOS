import state;
import buf;
import cur;
import undo;
import keys;
import wrap;

I64 rows(in I64[_] r) {
    return min(r[state.R_ROWS], state.MAX_ROWS);
}

I64 cols(in I64[_] r) {
    return min(r[state.R_COLS], state.MAX_COLS);
}

void cell(inout I64[_] grid, in I64[_] r, I64 row, I64 col, I64 cp, I64 style) {
    if (col >= 0 && col < cols(r)) {
        grid[row * cols(r) + col] = cp + style * state.STYLE;
    }
}

I64 put(inout I64[_] grid, in I64[_] r, I64 row, I64 col, in U8[_] s, I64 style) {
    for i in 0..len(s) {
        cell(grid, r, row, col + i, s[i] as I64, style);
    }
    return col + len(s);
}

I64 digits_of(I64 v) {
    I64 digits = 1;
    I64 p = 10;
    while (p <= v) {
        digits += 1;
        p *= 10;
    }
    return digits;
}

I64 put_num(inout I64[_] grid, in I64[_] r, I64 row, I64 col, I64 v, I64 style) {
    I64 digits = digits_of(v);
    I64 x = v;
    for i in 0..digits {
        cell(grid, r, row, col + digits - 1 - i, '0' + x % 10, style);
        x /= 10;
    }
    return col + digits;
}

I64 cp_at(in I64[_] r, in U8[_] t, I64 q) {
    I64 b = buf.at(r, t, q) as I64;
    if (b < 128) {
        return b;
    }
    I64 k = cur.next_cp(r, t, q) - q;
    I64 v = b % (128 >> k);
    for j in 1..k {
        v = v * 64 + (buf.at(r, t, q + j) as I64) % 64;
    }
    return v;
}

I64 text_height(in I64[_] r) {
    if (r[state.R_DESK] == 1) {
        return max(rows(r) - 1, 1);
    }
    return max(rows(r) - 2, 1);
}

void scroll(inout I64[_] r, inout U8[_] t) {
    I64 text_rows = text_height(r);
    if (wrap.on(r[state.R_WRAP])) {
        r[state.R_TOP] = wrap.scroll_gap(t, r[state.R_GAP_START], r[state.R_GAP_END], r[state.R_HEAD], r[state.R_TOP],
                                         r[state.R_COLS], text_rows);
        r[state.R_LEFT] = 0;
        return;
    }
    I64 h = r[state.R_HEAD];
    I64 hl = cur.line_start(r, t, h);
    I64 top = cur.line_start(r, t, min(r[state.R_TOP], buf.length(r, t)));
    if (hl < top) {
        top = hl;
    } else {
        I64 n = 0;
        I64 p = top;
        while (p < hl && n < text_rows) {
            p = cur.line_end(r, t, p) + 1;
            n += 1;
        }
        if (p < hl || n == text_rows) {
            top = hl;
            for i in 1..text_rows {
                if (top > 0) {
                    top = cur.line_start(r, t, top - 1);
                }
            }
        }
    }
    r[state.R_TOP] = top;
    I64 c = cur.column(r, t, h);
    if (c < r[state.R_LEFT]) {
        r[state.R_LEFT] = c;
    } else if (c >= r[state.R_LEFT] + cols(r)) {
        r[state.R_LEFT] = c - cols(r) + 1;
    }
}

I64 put_selection(inout I64[_] grid, in I64[_] r, in U8[_] t, I64 bar, I64 col, I64 style) {
    I64 lo = min(r[state.R_ANCHOR], r[state.R_HEAD]);
    I64 hi = max(r[state.R_ANCHOR], r[state.R_HEAD]);
    if (lo == hi) {
        return col;
    }
    I64 lfs = buf.count_byte(r, t, 10, lo, hi);
    I64 c = col;
    if (lfs == 0) {
        I64 chars = buf.count_code_points(r, t, lo, hi);
        c = put_num(grid, r, bar, c, chars, style);
        if (chars == 1) {
            return put(grid, r, bar, c, b" char selected", style);
        }
        return put(grid, r, bar, c, b" chars selected", style);
    }
    I64 lines = lfs;
    if (buf.at(r, t, hi - 1) != 10) {
        lines += 1;
    }
    c = put_num(grid, r, bar, c, lines, style);
    if (lines == 1) {
        return put(grid, r, bar, c, b" line selected", style);
    }
    return put(grid, r, bar, c, b" lines selected", style);
}

I64 whole_items(in U8[_] s, I64 ncols) {
    if (len(s) <= ncols) {
        return len(s);
    }
    I64 i = ncols;
    while (i > 0 && !(s[i] == ' ' && s[i + 1] == ' ')) {
        i -= 1;
    }
    return i;
}

export void render(inout I64[_] r, inout U8[_] t, in U8[_] name, in U8[_] f, inout I64[_] grid) {
    scroll(r, t);
    I64 nrows = rows(r);
    I64 ncols = cols(r);
    for i in 0..nrows * ncols {
        grid[i] = ' ';
    }
    I64 text_rows = text_height(r);
    I64 lo = min(r[state.R_ANCHOR], r[state.R_HEAD]);
    I64 hi = max(r[state.R_ANCHOR], r[state.R_HEAD]);
    I64 h = r[state.R_HEAD];
    I64 left = r[state.R_LEFT];
    I64 n = buf.length(r, t);
    I64 p = r[state.R_TOP];
    Bool more = true;
    for row in 0..text_rows {
        if (!more) {
            break;
        }
        I64 stop = n;
        if (wrap.on(r[state.R_WRAP])) {
            stop = wrap.row_next_gap(t, r[state.R_GAP_START], r[state.R_GAP_END], p, wrap.cap(r[state.R_COLS]));
        }
        I64 col = 0;
        I64 q = p;
        while (q < stop && buf.at(r, t, q) != 10) {
            if (q == h) {
                r[state.R_CUR_ROW] = row;
                r[state.R_CUR_COL] = col - left;
            }
            I64 style = state.S_PLAIN;
            if (q >= lo && q < hi) {
                style = state.S_SELECTED;
            }
            I64 c = cp_at(r, t, q);
            if (c == 9) {
                I64 next = (col / 4 + 1) * 4;
                while (col < next) {
                    cell(grid, r, row, col - left, ' ', style);
                    col += 1;
                }
            } else if (c == 13) {
                if (q + 1 < n && buf.at(r, t, q + 1) == 10) {
                    q += 1;
                    continue;
                }
                cell(grid, r, row, col - left, '^', style);
                cell(grid, r, row, col + 1 - left, 'M', style);
                col += 2;
            } else {
                cell(grid, r, row, col - left, c, style);
                col += 1;
            }
            q = cur.next_cp(r, t, q);
        }
        if (wrap.continued_gap(t, r[state.R_GAP_START], r[state.R_GAP_END], q)) {
            p = q;
        } else {
            if (q == h) {
                r[state.R_CUR_ROW] = row;
                r[state.R_CUR_COL] = col - left;
            }
            if (q < n && q >= lo && q < hi) {
                cell(grid, r, row, col - left, ' ', state.S_SELECTED);
            }
            if (q < n) {
                p = q + 1;
            } else {
                more = false;
            }
        }
    }

    I64 last = nrows - 1;
    if (r[state.R_DESK] == 1) {
        quiet(grid, r, t, f, last);
        return;
    }
    I64 bar = nrows - 2;
    for c in 0..ncols {
        cell(grid, r, bar, c, ' ', state.S_BAR);
    }
    I64 col = put(grid, r, bar, 1, name[0..r[state.R_NAME_LEN]], state.S_BAR);
    if (undo.modified(r)) {
        col = put(grid, r, bar, col, b" [+]", state.S_BAR);
    } else if (r[state.R_NEW_FILE] == 1) {
        col = put(grid, r, bar, col, b" (new file)", state.S_BAR);
    }
    col = message(grid, r, t, bar, col + 2, state.S_BAR);
    _ = place(grid, r, t, bar, col, state.S_BAR);
    if (prompt(grid, r, f, last) < 0) {
        U8[81] items = b"^S save  ^Q quit  ^F find  ^X cut  ^Z undo  ^Y redo  ^G line  ^R replace  ^W wrap";
        _ = put(grid, r, last, 0, items[0..whole_items(items, ncols)], state.S_PLAIN);
    }
}

I64 message(inout I64[_] grid, in I64[_] r, in U8[_] t, I64 row, I64 col, I64 style) {
    switch (r[state.R_MSG]) {
        case state.MSG_TOO_BIG: return put(grid, r, row, col, b"the text does not fit", style);
        case state.MSG_HISTORY_CLEARED: return put(grid, r, row, col, b"undo history cleared: the edit was too large", style);
        case state.MSG_SAVED: return put(grid, r, row, col, b"saved", style);
        case state.MSG_SAVE_FAILED: return put(grid, r, row, col, b"not saved: the file could not be written", style);
        case state.MSG_NOT_FOUND: return put(grid, r, row, col, b"not found", style);
        case state.MSG_WRAPPED: return put(grid, r, row, col, b"wrapped", style);
        case state.MSG_QUIT_WARN: return put(grid, r, row, col, b"^Q again discards changes", style);
        case state.MSG_NOTHING_TO_UNDO: return put(grid, r, row, col, b"nothing to undo", style);
        case state.MSG_NOTHING_TO_REDO: return put(grid, r, row, col, b"nothing to redo", style);
        case state.MSG_COPIED: return put(grid, r, row, col, b"copied", style);
        case state.MSG_WRAP_ON: return put(grid, r, row, col, b"wrap on", style);
        case state.MSG_WRAP_OFF: return put(grid, r, row, col, b"wrap off", style);
        case state.MSG_EXISTS: return put(grid, r, row, col, b"a file of that name exists", style);
        case state.MSG_BAD_NAME: return put(grid, r, row, col, b"letters, digits, _ - . only", style);
        case state.MSG_REPLACED: {
            I64 c = put_num(grid, r, row, col, r[state.R_REPLACE_DONE], style);
            return put(grid, r, row, c, b" replaced", style);
        }
        default: return put_selection(grid, r, t, row, col, style);
    }
}

I64 place(inout I64[_] grid, inout I64[_] r, inout U8[_] t, I64 row, I64 col, I64 style) {
    I64 h = r[state.R_HEAD];
    I64 line = buf.lines_before(r, t, h) + 1;
    I64 column = cur.code_points(r, t, h) + 1;
    I64 width = digits_of(line) + 1 + digits_of(column);
    I64 at = max(cols(r) - width - 1, col);
    at = put_num(grid, r, row, at, line, style);
    cell(grid, r, row, at, ':', style);
    return put_num(grid, r, row, at + 1, column, style);
}

// the open prompt; its end, or -1 with none
I64 prompt(inout I64[_] grid, inout I64[_] r, in U8[_] f, I64 row) {
    if (r[state.R_MODE] == state.MODE_REPLACE_ASK) {
        return put(grid, r, row, 0, b"y replace  n skip  a all  Esc stop", state.S_PLAIN);
    }
    if (r[state.R_MODE] == state.MODE_REPLACE_WITH) {
        I64 c = put(grid, r, row, 0, b"with: ", state.S_PLAIN);
        I64 q = 0;
        I64 w = r[state.R_WITH_LEN];
        I64[2] k;
        while (q < w) {
            q += keys.decode(f[state.FIND_MAX..state.FIND_MAX + w], q, k);
            cell(grid, r, row, c, k[0], state.S_PLAIN);
            c += 1;
        }
        r[state.R_CUR_ROW] = row;
        r[state.R_CUR_COL] = c;
        return c;
    }
    if (r[state.R_MODE] == state.MODE_FIND || r[state.R_MODE] == state.MODE_REPLACE_FIND) {
        I64 c = put(grid, r, row, 0, b"find: ", state.S_PLAIN);
        I64 q = 0;
        I64[2] k;
        while (q < r[state.R_FIND_LEN]) {
            q += keys.decode(f[0..r[state.R_FIND_LEN]], q, k);
            if (r[state.R_FIND_TYPED] == 0) {
                cell(grid, r, row, c, k[0], state.S_SELECTED);
            } else {
                cell(grid, r, row, c, k[0], state.S_PLAIN);
            }
            c += 1;
        }
        r[state.R_CUR_ROW] = row;
        r[state.R_CUR_COL] = c;
        return c;
    }
    if (r[state.R_MODE] == state.MODE_SAVE_AS) {
        I64 c = put(grid, r, row, 0, b"save as: ", state.S_PLAIN);
        c = put(grid, r, row, c, f[state.ASK_AT..state.ASK_AT + r[state.R_ASK_LEN]], state.S_PLAIN);
        r[state.R_CUR_ROW] = row;
        r[state.R_CUR_COL] = c;
        return c;
    }
    if (r[state.R_MODE] == state.MODE_LINE) {
        I64 c = put(grid, r, row, 0, b"line: ", state.S_PLAIN);
        if (r[state.R_LINE_NUM] > 0) {
            c = put_num(grid, r, row, c, r[state.R_LINE_NUM], state.S_PLAIN);
        }
        r[state.R_CUR_ROW] = row;
        r[state.R_CUR_COL] = c;
        return c;
    }
    return -1;
}

// the desk's one line: prompt, message, place
void quiet(inout I64[_] grid, inout I64[_] r, inout U8[_] t, in U8[_] f, I64 row) {
    I64 col = prompt(grid, r, f, row);
    if (col < 0) {
        col = message(grid, r, t, row, 0, state.S_PLAIN);
    } else if (r[state.R_MSG] != state.MSG_NONE) {
        col = message(grid, r, t, row, col + 2, state.S_PLAIN);
    }
    _ = place(grid, r, t, row, col + 2, state.S_DIM);
}

I64 at_cell(in I64[_] grid, in I64[_] r, I64 row, I64 col) {
    return grid[row * cols(r) + col];
}

void setup(inout I64[_] r, inout U8[_] t, in U8[_] s) {
    buf.reset(r, t);
    assert(buf.insert(r, t, 0, s));
    undo.reset(r);
    r[state.R_ROWS] = 4;
    r[state.R_COLS] = 12;
    r[state.R_TOP] = 0;
    r[state.R_LEFT] = 0;
    r[state.R_MODE] = state.MODE_EDIT;
    r[state.R_MSG] = state.MSG_NONE;
    r[state.R_NAME_LEN] = 0;
    cur.go(r, 0, false);
}

test "two lines, the bars and the cursor" {
    I64[64] r;
    U8[32] t;
    U8[16] name;
    U8[4] f;
    I64[48] grid;
    U8[5] s = b"ab\ncd";
    setup(r, t, s);
    cur.go(r, 4, false);
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 0, 0) == 'a' && at_cell(grid, r, 0, 1) == 'b');
    assert(at_cell(grid, r, 1, 0) == 'c' && at_cell(grid, r, 1, 1) == 'd');
    assert(r[state.R_CUR_ROW] == 1 && r[state.R_CUR_COL] == 1);
    assert(at_cell(grid, r, 2, 10) == '2' + state.S_BAR * state.STYLE);
    assert(at_cell(grid, r, 3, 0) == '^');
}

test "the view scrolls down to the caret" {
    I64[64] r;
    U8[32] t;
    U8[16] name;
    U8[4] f;
    I64[48] grid;
    U8[7] s = b"1\n2\n3\n4";
    setup(r, t, s);
    cur.doc_end(r, t, false);
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 0, 0) == '3');
    assert(at_cell(grid, r, 1, 0) == '4');
    assert(r[state.R_CUR_ROW] == 1);
}

test "the seed of the find prompt is drawn reversed" {
    I64[64] r;
    U8[32] t;
    U8[16] name;
    U8[4] f = b"ab\0\0";
    I64[48] grid;
    U8[3] s = b"xab";
    setup(r, t, s);
    r[state.R_MODE] = state.MODE_FIND;
    r[state.R_FIND_LEN] = 2;
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 3, 6) == 'a' + state.S_SELECTED * state.STYLE);
    r[state.R_FIND_TYPED] = 1;
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 3, 6) == 'a');
}

test "a selected LF draws one reversed cell" {
    I64[64] r;
    U8[32] t;
    U8[16] name;
    U8[4] f;
    I64[60] grid;
    U8[4] s = b"a\n\nb";
    setup(r, t, s);
    r[state.R_ROWS] = 5;
    r[state.R_ANCHOR] = 0;
    r[state.R_HEAD] = 3;
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 0, 1) == ' ' + state.S_SELECTED * state.STYLE);
    assert(at_cell(grid, r, 1, 0) == ' ' + state.S_SELECTED * state.STYLE);
    assert(at_cell(grid, r, 1, 1) == ' ');
    r[state.R_HEAD] = 1;
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 0, 1) == ' ');
}

test "a selection is drawn reversed, a tab as spaces" {
    I64[64] r;
    U8[32] t;
    U8[16] name;
    U8[4] f;
    I64[48] grid;
    U8[3] s = b"\txy";
    setup(r, t, s);
    r[state.R_ANCHOR] = 1;
    r[state.R_HEAD] = 2;
    render(r, t, name, f, grid);
    assert(at_cell(grid, r, 0, 0) == ' ' && at_cell(grid, r, 0, 3) == ' ');
    assert(at_cell(grid, r, 0, 4) == 'x' + state.S_SELECTED * state.STYLE);
    assert(at_cell(grid, r, 0, 5) == 'y');
}

// gap at g draws as flat and stays, with typing
void draws_in_place(in U8[_] s, I64 g, I64 head, I64 flag) {
    I64[64] r;
    U8[32] t;
    I64[64] rf;
    U8[32] tf;
    U8[16] name;
    U8[4] f;
    I64[30] grid;
    I64[30] gf;
    U8[1] z = b"z";
    setup(r, t, s);
    setup(rf, tf, s);
    buf.move_gap(r, t, g);
    for i in 0..4 {
        if (i > 0) {
            assert(buf.insert(r, t, g + i - 1, z));
            assert(buf.insert(rf, tf, g + i - 1, z));
        }
        r[state.R_ROWS] = 5;
        r[state.R_COLS] = 6;
        r[state.R_WRAP] = flag;
        rf[state.R_ROWS] = 5;
        rf[state.R_COLS] = 6;
        rf[state.R_WRAP] = flag;
        cur.go(r, head + i, false);
        cur.go(rf, head + i, false);
        I64 gs = r[state.R_GAP_START];
        I64 ge = r[state.R_GAP_END];
        render(r, t, name, f, grid);
        _ = buf.flat(rf, tf);
        render(rf, tf, name, f, gf);
        assert(r[state.R_GAP_START] == gs && r[state.R_GAP_END] == ge);
        assert(gs == g + i);
        for c in 0..30 {
            assert(grid[c] == gf[c]);
        }
        assert(r[state.R_CUR_ROW] == rf[state.R_CUR_ROW] && r[state.R_CUR_COL] == rf[state.R_CUR_COL]);
        assert(r[state.R_TOP] == rf[state.R_TOP] && r[state.R_LEFT] == rf[state.R_LEFT]);
    }
}

test "VIEW-1 VIEW-2: drawing reads around the gap and leaves it in place" {
    U8[25] s = b"ab c\tde\r\nf\xc3\xa9 ghij klm\rno\n";
    for flag in 0..2 {
        for g in 0..len(s) + 1 {
            draws_in_place(s, g, 0, flag);
            draws_in_place(s, g, 11, flag);
            draws_in_place(s, g, len(s) - 3, flag);
        }
    }
}
