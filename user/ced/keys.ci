export const I64 M_SHIFT = 16777216;
export const I64 M_ALT = 33554432;
export const I64 M_CTRL = 67108864;
export const I64 M_MASK = 117440512;
export const I64 K_UP = 1114112;
export const I64 K_DOWN = 1114113;
export const I64 K_RIGHT = 1114114;
export const I64 K_LEFT = 1114115;
export const I64 K_HOME = 1114116;
export const I64 K_END = 1114117;
export const I64 K_PGUP = 1114118;
export const I64 K_PGDN = 1114119;
export const I64 K_DELETE = 1114120;
export const I64 K_F3 = 1114121;
export const I64 K_ENTER = 1114122;
export const I64 K_TAB = 1114123;
export const I64 K_BACKSPACE = 1114124;
export const I64 K_ESC = 1114125;
export const I64 K_PASTE = 1114126;
export const I64 K_NONE = 1114127;
export const I64 REPLACEMENT = 65533;
export const I64 HELD_MAX = 64;
const I64 PARAM_MAX = 1000000;

const U8 ESC = 27;

I64 utf8_len(U8 b) {
    if (b < 128) {
        return 1;
    }
    if (b >= 194 && b < 224) {
        return 2;
    }
    if (b >= 224 && b < 240) {
        return 3;
    }
    if (b >= 240 && b < 245) {
        return 4;
    }
    return 0;
}

I64 mods(I64 m) {
    I64 bits = 0;
    I64 v = max(m - 1, 0);
    if (v % 2 == 1) {
        bits += M_SHIFT;
    }
    if ((v / 2) % 2 == 1) {
        bits += M_ALT;
    }
    if ((v / 4) % 2 == 1) {
        bits += M_CTRL;
    }
    return bits;
}

I64 param(I64 v, U8 d) {
    return min(v, PARAM_MAX) * 10 + (d as I64) - '0';
}

I64 final_key(U8 f) {
    switch (f) {
        case 'A': return K_UP;
        case 'B': return K_DOWN;
        case 'C': return K_RIGHT;
        case 'D': return K_LEFT;
        case 'H': return K_HOME;
        case 'F': return K_END;
        case 'R': return K_F3;
        default: return K_NONE;
    }
}

I64 tilde_key(I64 n) {
    switch (n) {
        case 1: return K_HOME;
        case 7: return K_HOME;
        case 4: return K_END;
        case 8: return K_END;
        case 3: return K_DELETE;
        case 5: return K_PGUP;
        case 6: return K_PGDN;
        case 13: return K_F3;
        case 200: return K_PASTE;
        default: return K_NONE;
    }
}

I64 byte_key(U8 b) {
    if (b == 13 || b == 10) {
        return K_ENTER;
    }
    if (b == 9) {
        return K_TAB;
    }
    if (b == 127 || b == 8) {
        return K_BACKSPACE;
    }
    if (b == 31) {
        return M_CTRL + '/';   // xterm sends 0x1f
    }
    if (b >= 1 && b <= 26) {
        return M_CTRL + ('a' + (b as I64) - 1);
    }
    if (b < 32) {
        return K_NONE;
    }
    return b as I64;
}

export I64 decode(in U8[_] b, I64 i, inout I64[_] res) {
    I64 n = len(b);
    U8 c = b[i];
    if (c != ESC) {
        I64 k = utf8_len(c);
        if (k == 0) {
            res[0] = REPLACEMENT;
            return 1;
        }
        if (k == 1) {
            res[0] = byte_key(c);
            return 1;
        }
        if (i + k > n) {
            return 0;
        }
        I64 cp = (c as I64) % (128 >> k);
        for j in 1..k {
            cp = cp * 64 + (b[i + j] as I64) % 64;
        }
        res[0] = cp;
        return k;
    }
    if (i + 1 == n) {
        res[0] = K_ESC;
        return 1;
    }
    U8 c1 = b[i + 1];
    if (c1 == 'O') {
        if (i + 2 == n) {
            return 0;
        }
        res[0] = final_key(b[i + 2]);
        return 3;
    }
    if (c1 != '[') {
        if (c1 == ESC && i + 2 < n && b[i + 2] == ESC) {
            res[0] = K_NONE;
            return 1;
        }
        I64[2] inner;
        I64 used = decode(b, i + 1, inner);
        if (used == 0) {
            return 0;
        }
        res[0] = inner[0] | M_ALT;
        return used + 1;
    }
    I64 p0 = 0;
    I64 p1 = 0;
    I64 which = 0;
    I64 j = i + 2;
    while (j < n && ((b[j] >= '0' && b[j] <= '9') || b[j] == ';')) {
        if (b[j] == ';') {
            which += 1;
        } else if (which == 0) {
            p0 = param(p0, b[j]);
        } else if (which == 1) {
            p1 = param(p1, b[j]);
        }
        j += 1;
    }
    if (which == 0) {
        p1 = 1;
    }
    if (j == n) {
        return 0;
    }
    U8 f = b[j];
    I64 key = K_NONE;
    if (f == '~') {
        key = tilde_key(p0);
    } else if (f == 'Z') {
        key = K_TAB + M_SHIFT;
    } else {
        key = final_key(f);
    }
    if (p0 >= PARAM_MAX || p1 >= PARAM_MAX) {
        key = K_NONE;
    }
    if (key != K_NONE && key != K_PASTE) {
        key += mods(p1);
    }
    res[0] = key;
    return j - i + 1;
}

// length of a key whose lead byte already went
export I64 tail(in U8[_] b, inout I64[_] res) {
    if (len(b) == 0 || (b[0] != '[' && b[0] != 'O')) {
        return 0;
    }
    U8[17] s;
    I64 n = min(len(b), 16);
    s[0] = ESC;
    for i in 0..n {
        s[i + 1] = b[i];
    }
    I64 used = decode(s[0..n + 1], 0, res) - 1;
    if (used <= 0 || res[0] == K_NONE || (res[0] & ~M_MASK) == K_DELETE) {
        return 0;
    }
    if (used < len(b) && b[used] != ESC && res[0] != K_PASTE) {
        return 0;
    }
    return used;
}

// how much of a cut end marker b ends with
I64 paste_cut(in U8[_] b, I64 i) {
    U8[6] end = b"\x1b[201~";
    I64 n = len(b);
    I64 m = min(n - i, 5);
    while (m > 0) {
        Bool same = true;
        for j in 0..m {
            if (b[n - m + j] != end[j]) {
                same = false;
            }
        }
        if (same) {
            return m;
        }
        m -= 1;
    }
    return 0;
}

export I64 paste_len(in U8[_] b, I64 i, inout I64[_] res) {
    I64 n = len(b);
    I64 j = i;
    while (j + 6 <= n) {
        if (b[j] == ESC && b[j + 1] == '[' && b[j + 2] == '2' && b[j + 3] == '0' && b[j + 4] == '1' && b[j + 5] == '~') {
            res[0] = 1;
            return j - i + 6;
        }
        j += 1;
    }
    res[0] = 0;
    return n - i - paste_cut(b, i);
}

export Bool valid_utf8(in U8[_] b) {
    I64 n = len(b);
    I64 i = 0;
    while (i < n) {
        I64 k = utf8_len(b[i]);
        if (k == 0 || i + k > n) {
            return false;
        }
        I64 cp = (b[i] as I64) % (128 >> k);
        if (k == 1) {
            cp = b[i] as I64;
        }
        for j in 1..k {
            if (b[i + j] < 128 || b[i + j] >= 192) {
                return false;
            }
            cp = cp * 64 + (b[i + j] as I64) % 64;
        }
        if ((k == 3 && cp < 2048) || (k == 4 && cp < 65536) || cp > 1114111 || (cp >= 55296 && cp < 57344)) {
            return false;
        }
        i += k;
    }
    return true;
}

export I64 encode(I64 cp, inout U8[_] s) {
    if (cp < 128) {
        s[0] = cp as U8;
        return 1;
    }
    if (cp < 2048) {
        s[0] = (192 + cp / 64) as U8;
        s[1] = (128 + cp % 64) as U8;
        return 2;
    }
    if (cp < 65536) {
        s[0] = (224 + cp / 4096) as U8;
        s[1] = (128 + (cp / 64) % 64) as U8;
        s[2] = (128 + cp % 64) as U8;
        return 3;
    }
    s[0] = (240 + cp / 262144) as U8;
    s[1] = (128 + (cp / 4096) % 64) as U8;
    s[2] = (128 + (cp / 64) % 64) as U8;
    s[3] = (128 + cp % 64) as U8;
    return 4;
}

test "encode is decode's inverse" {
    U8[4] s;
    I64[2] k;
    assert(encode(233, s) == 2);
    assert(decode(s[0..2], 0, k) == 2 && k[0] == 233);
    assert(encode(128512, s) == 4);
    assert(decode(s, 0, k) == 4 && k[0] == 128512);
}

test "text and control bytes" {
    I64[2] k;
    U8[3] b = b"a\x13\r";
    assert(decode(b, 0, k) == 1);
    assert(k[0] == 'a');
    assert(decode(b, 1, k) == 1);
    assert(k[0] == M_CTRL + 's');
    assert(decode(b, 2, k) == 1);
    assert(k[0] == K_ENTER);
}

test "a two-byte code point, and one split across chunks" {
    I64[2] k;
    U8[2] e = b"\xc3\xa9";
    assert(decode(e, 0, k) == 2);
    assert(k[0] == 233);
    U8[1] half = b"\xc3";
    assert(decode(half, 0, k) == 0);
}

test "arrows, with and without modifiers" {
    I64[2] k;
    U8[3] up = b"\x1b[A";
    assert(decode(up, 0, k) == 3);
    assert(k[0] == K_UP);
    U8[6] cr = b"\x1b[1;5C";
    assert(decode(cr, 0, k) == 6);
    assert(k[0] == K_RIGHT + M_CTRL);
    U8[6] sd = b"\x1b[1;2B";
    assert(decode(sd, 0, k) == 6);
    assert(k[0] == K_DOWN + M_SHIFT);
    U8[3] ss3 = b"\x1bOH";
    assert(decode(ss3, 0, k) == 3);
    assert(k[0] == K_HOME);
}

test "tilde keys and a sequence cut off at the end" {
    I64[2] k;
    U8[4] del = b"\x1b[3~";
    assert(decode(del, 0, k) == 4);
    assert(k[0] == K_DELETE);
    U8[3] cut = b"\x1b[3";
    assert(decode(cut, 0, k) == 0);
}

test "a lone ESC is Esc, ESC then a letter is Alt" {
    I64[2] k;
    U8[1] e = b"\x1b";
    assert(decode(e, 0, k) == 1);
    assert(k[0] == K_ESC);
    U8[2] ax = b"\x1bx";
    assert(decode(ax, 0, k) == 2);
    assert(k[0] == 'x' + M_ALT);
}

test "a tail is a whole key's tail, ending the bytes or before an ESC" {
    I64[2] k;
    U8[2] up = b"[A";
    assert(tail(up, k) == 2);
    assert(k[0] == K_UP);
    U8[2] ss3 = b"OF";
    assert(tail(ss3, k) == 2);
    assert(k[0] == K_END);
    U8[5] sl = b"[1;2D";
    assert(tail(sl, k) == 5);
    assert(k[0] == K_LEFT + M_SHIFT);
    U8[3] del = b"[3~";
    assert(tail(del, k) == 0);
    U8[5] sdel = b"[3;2~";
    assert(tail(sdel, k) == 0);
    U8[3] next = b"[F\x1b";
    assert(tail(next, k) == 2);
    assert(k[0] == K_END);
    U8[3] text = b"[Ab";
    assert(tail(text, k) == 0);
    U8[6] paste = b"[200~a";
    assert(tail(paste, k) == 5);
    assert(k[0] == K_PASTE);
    U8[1] open = b"[";
    assert(tail(open, k) == 0);
    U8[2] cut = b"[1";
    assert(tail(cut, k) == 0);
    U8[2] word = b"OK";
    assert(tail(word, k) == 0);
    U8[2] unknown = b"[x";
    assert(tail(unknown, k) == 0);
    U8[2] plain = b"ab";
    assert(tail(plain, k) == 0);
    U8[20] digits = b"[1234567890123456789";
    assert(tail(digits, k) == 0);
}

test "no input faults the decoder" {
    I64[2] k;
    U8[26] big = b"\x1b[99999999999999999999999A";
    assert(decode(big, 0, k) == 26);
    assert(k[0] == K_NONE);
    U8[28] mod = b"\x1b[1;99999999999999999999999C";
    assert(decode(mod, 0, k) == 28);
    assert(k[0] == K_NONE);
    U8[300] flood;
    for j in 0..300 {
        flood[j] = ESC;
    }
    assert(decode(flood, 0, k) == 1);
    assert(k[0] == K_NONE);
    assert(decode(flood, 298, k) == 2);
    assert(k[0] == K_ESC + M_ALT);
    U8[3] twice = b"\x1b\x1bs";
    assert(decode(twice, 0, k) == 3);
    assert(k[0] == 's' + M_ALT);
}

test "a bracketed paste and its end" {
    I64[2] k;
    U8[14] p = b"\x1b[200~hi\x1b[201~";
    assert(decode(p, 0, k) == 6);
    assert(k[0] == K_PASTE);
    assert(paste_len(p, 6, k) == 8);
    assert(k[0] == 1);
}

test "a cut end marker stays out of the body" {
    I64[2] k;
    U8[5] body = b"ab\x1b[2";
    assert(paste_len(body, 0, k) == 2);
    assert(k[0] == 0);
    U8[4] other = b"ab\x1bx";
    assert(paste_len(other, 0, k) == 4);
    U8[3] cut = b"\x1b[2";
    assert(paste_len(cut, 0, k) == 0);
}
