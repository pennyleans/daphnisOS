import state;

// gap buffer: t[0, gs) then t[ge, len)

export void reset(inout I64[_] r, in U8[_] t) {
    r[state.R_GAP_START] = 0;
    r[state.R_GAP_END] = len(t);
    r[state.R_LF_AT] = 0;
    r[state.R_LF_COUNT] = 0;
}

export I64 find_byte(in I64[_] r, in U8[_] t, U8 b, I64 from, I64 stop) {
    I64 gs = r[state.R_GAP_START];
    I64 shift = r[state.R_GAP_END] - gs;
    I64 i = from;
    I64 first = min(stop, gs);
    while (i < first) {
        if (t[i] == b) {
            return i;
        }
        i += 1;
    }
    i = max(i, gs);
    while (i < stop) {
        if (t[i + shift] == b) {
            return i;
        }
        i += 1;
    }
    return -1;
}

export I64 find_byte_back(in I64[_] r, in U8[_] t, U8 b, I64 before) {
    I64 gs = r[state.R_GAP_START];
    I64 shift = r[state.R_GAP_END] - gs;
    I64 i = before - 1;
    while (i >= gs) {
        if (t[i + shift] == b) {
            return i;
        }
        i -= 1;
    }
    while (i >= 0) {
        if (t[i] == b) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

export I64 count_byte(in I64[_] r, in U8[_] t, U8 b, I64 from, I64 stop) {
    I64 gs = r[state.R_GAP_START];
    I64 shift = r[state.R_GAP_END] - gs;
    I64 c = 0;
    I64 i = from;
    I64 first = min(stop, gs);
    while (i < first) {
        if (t[i] == b) {
            c += 1;
        }
        i += 1;
    }
    i = max(i, gs);
    while (i < stop) {
        if (t[i + shift] == b) {
            c += 1;
        }
        i += 1;
    }
    return c;
}

export I64 count_code_points(in I64[_] r, in U8[_] t, I64 from, I64 stop) {
    I64 gs = r[state.R_GAP_START];
    I64 shift = r[state.R_GAP_END] - gs;
    I64 c = 0;
    I64 i = from;
    I64 first = min(stop, gs);
    while (i < first) {
        if (t[i] < 128 || t[i] >= 192) {
            c += 1;
        }
        i += 1;
    }
    i = max(i, gs);
    while (i < stop) {
        U8 b = t[i + shift];
        if (b < 128 || b >= 192) {
            c += 1;
        }
        i += 1;
    }
    return c;
}

export I64 lines_before(inout I64[_] r, in U8[_] t, I64 p) {
    I64 m = r[state.R_LF_AT];
    I64 n = r[state.R_LF_COUNT];
    if (m < p) {
        n += count_byte(r, t, 10, m, p);
    } else if (m > p) {
        n -= count_byte(r, t, 10, p, m);
    }
    r[state.R_LF_AT] = p;
    r[state.R_LF_COUNT] = n;
    return n;
}

void edited(inout I64[_] r, in U8[_] t, I64 p) {
    if (p < r[state.R_LF_AT]) {
        _ = lines_before(r, t, p);
    }
}

export I64 length(in I64[_] r, in U8[_] t) {
    return len(t) - (r[state.R_GAP_END] - r[state.R_GAP_START]);
}

export I64 room(in I64[_] r) {
    return r[state.R_GAP_END] - r[state.R_GAP_START];
}

export U8 at(in I64[_] r, in U8[_] t, I64 p) {
    I64 gs = r[state.R_GAP_START];
    if (p < gs) {
        return t[p];
    }
    return t[p + (r[state.R_GAP_END] - gs)];
}

export void move_gap(inout I64[_] r, inout U8[_] t, I64 p) {
    I64 gs = r[state.R_GAP_START];
    I64 ge = r[state.R_GAP_END];
    assert(p >= 0 && p <= len(t) - (ge - gs));
    while (gs > p) {
        gs -= 1;
        ge -= 1;
        t[ge] = t[gs];
    }
    while (gs < p) {
        t[gs] = t[ge];
        gs += 1;
        ge += 1;
    }
    r[state.R_GAP_START] = gs;
    r[state.R_GAP_END] = ge;
}

export Bool insert(inout I64[_] r, inout U8[_] t, I64 p, in U8[_] s) {
    if (len(s) > room(r)) {
        return false;
    }
    edited(r, t, p);
    move_gap(r, t, p);
    I64 gs = r[state.R_GAP_START];
    for i in 0..len(s) {
        t[gs + i] = s[i];
    }
    r[state.R_GAP_START] = gs + len(s);
    return true;
}

export void remove(inout I64[_] r, inout U8[_] t, I64 p, I64 n) {
    assert(n >= 0 && p + n <= length(r, t));
    edited(r, t, p);
    move_gap(r, t, p);
    r[state.R_GAP_END] = r[state.R_GAP_END] + n;
}

export I64 copy_out(in I64[_] r, in U8[_] t, inout U8[_] dst) {
    I64 n = length(r, t);
    for i in 0..n {
        dst[i] = at(r, t, i);
    }
    return n;
}

test "an empty buffer has no text and a full gap" {
    I64[64] r;
    U8[8] t;
    reset(r, t);
    assert(length(r, t) == 0);
    assert(room(r) == 8);
}

test "typing fills the gap" {
    I64[64] r;
    U8[8] t;
    reset(r, t);
    U8[4] helo = b"helo";
    U8[1] l = b"l";
    assert(insert(r, t, 0, helo));
    assert(insert(r, t, 3, l));
    U8[8] got;
    I64 n = copy_out(r, t, got);
    U8[5] hello = b"hello";
    assert(n == 5);
    assert(equal(got[0..n], hello));
}

test "removing widens the gap" {
    I64[64] r;
    U8[8] t;
    reset(r, t);
    U8[6] abcdef = b"abcdef";
    assert(insert(r, t, 0, abcdef));
    remove(r, t, 1, 3);
    U8[8] got;
    I64 n = copy_out(r, t, got);
    U8[3] aef = b"aef";
    assert(equal(got[0..n], aef));
    assert(room(r) == 5);
}

test "the gap moves both ways and the text stays the same" {
    I64[64] r;
    U8[8] t;
    reset(r, t);
    U8[4] abcd = b"abcd";
    assert(insert(r, t, 0, abcd));
    move_gap(r, t, 1);
    assert(at(r, t, 0) == 'a');
    assert(at(r, t, 3) == 'd');
    move_gap(r, t, 4);
    assert(at(r, t, 1) == 'b');
}

test "an insert that does not fit changes nothing" {
    I64[64] r;
    U8[4] t;
    reset(r, t);
    U8[3] abc = b"abc";
    U8[2] xy = b"xy";
    assert(insert(r, t, 0, abc));
    assert(!insert(r, t, 1, xy));
    assert(length(r, t) == 3);
}

test "the byte scans see both sides of the gap" {
    I64[64] r;
    U8[16] t;
    reset(r, t);
    U8[6] s = b"a\nb\nc\n";
    assert(insert(r, t, 0, s));
    for p in 0..7 {
        move_gap(r, t, p);
        assert(find_byte(r, t, 10, 0, 6) == 1);
        assert(find_byte(r, t, 10, 2, 6) == 3);
        assert(find_byte(r, t, 10, 6, 6) == -1);
        assert(find_byte(r, t, 'z', 0, 6) == -1);
        assert(find_byte_back(r, t, 10, 6) == 5);
        assert(find_byte_back(r, t, 10, 5) == 3);
        assert(find_byte_back(r, t, 10, 1) == -1);
        assert(count_byte(r, t, 10, 0, 6) == 3);
        assert(count_byte(r, t, 10, 2, 5) == 1);
        assert(count_code_points(r, t, 1, 5) == 4);
    }
}

test "the line count follows the caret and survives edits before it" {
    I64[64] r;
    U8[32] t;
    reset(r, t);
    U8[6] abc = b"a\nb\nc\n";
    assert(insert(r, t, 0, abc));
    assert(lines_before(r, t, 4) == 2);
    assert(lines_before(r, t, 1) == 0);
    assert(lines_before(r, t, 6) == 3);
    U8[2] nl = b"x\n";
    assert(insert(r, t, 0, nl));
    assert(lines_before(r, t, 8) == 4);
    remove(r, t, 0, 2);
    assert(lines_before(r, t, 6) == 3);
}

export I64 flat(inout I64[_] r, inout U8[_] t) {
    I64 n = length(r, t);
    move_gap(r, t, n);
    return n;
}
