// the desk probe's replies, out of the input

export const I64 PROBING = 0;
export const I64 DAPHNIS = 1;
export const I64 CUT = 2;

const U8 ESC = 27;

// a reply's length at p; 0 none, -1 cut
export I64 reply_at(in U8[_] s, I64 p, I64 n) {
    if (s[p] != ESC) {
        return 0;
    }
    if (p + 1 >= n) {
        return -1;
    }
    if (s[p + 1] == 'P') {
        I64 k = p + 2;
        while (k + 1 < n && !(s[k] == ESC && s[k + 1] == '\\')) {
            k += 1;
        }
        if (k + 1 >= n) {
            return -1;
        }
        return k + 2 - p;
    }
    if (s[p + 1] != '[') {
        return 0;
    }
    if (p + 2 >= n) {
        return -1;
    }
    if (s[p + 2] != '?') {
        return 0;
    }
    I64 k = p + 3;
    while (k < n && ((s[k] >= '0' && s[k] <= '9') || s[k] == ';')) {
        k += 1;
    }
    if (k >= n) {
        return -1;
    }
    if (s[k] != 'c') {
        return 0;
    }
    return k + 1 - p;
}

Bool names_daphnis(in U8[_] s, I64 p, I64 m) {
    U8[9] want = b">|Daphnis";
    if (m < 13 || s[p + 1] != 'P') {
        return false;
    }
    for i in 0..9 {
        if (s[p + 2 + i] != want[i]) {
            return false;
        }
    }
    return true;
}

// an osc's length at p; 0 none, -1 cut
export I64 osc_at(in U8[_] s, I64 p, I64 n) {
    if (s[p] != ESC) {
        return 0;
    }
    if (p + 1 >= n) {
        return -1;
    }
    if (s[p + 1] != ']') {
        return 0;
    }
    I64 k = p + 2;
    while (k < n && k - p < 80 && s[k] != 7 && s[k] != ESC) {
        k += 1;
    }
    if (k - p >= 80) {
        return 0;
    }
    if (k >= n) {
        return -1;
    }
    if (s[k] == 7) {
        return k + 1 - p;
    }
    if (k + 1 >= n) {
        return -1;
    }
    if (s[k + 1] != '\\') {
        return 0;
    }
    return k + 2 - p;
}

// the key a chosen row stands for, or -1
export I64 chosen(in U8[_] s, I64 p, I64 m) {
    U8[13] head = b"\x1b]7770;chose;";
    if (m < 15) {
        return -1;
    }
    for i in 0..13 {
        if (s[p + i] != head[i]) {
            return -1;
        }
    }
    I64 v = 0;
    I64 k = p + 13;
    while (k < p + m && s[k] >= '0' && s[k] <= '9' && v < 65536) {
        v = v * 10 + (s[k] - '0') as I64;
        k += 1;
    }
    if (k == p + 13 || (s[k] != 7 && s[k] != ESC)) {
        return -1;
    }
    for i in 0..N_ROWS {
        if (ROW_ID[i] == v && v < 32 && (ROW_MARKS[i] & DIM) == 0) {
            return v;
        }
    }
    return -1;
}

// replies taken out of s[from, to); the new end
export I64 strip(inout U8[_] s, I64 from, I64 to, inout Bool[3] st) {
    st[CUT] = false;
    Bool rows = st[DAPHNIS] && !st[PROBING];
    I64 w = from;
    I64 p = from;
    while (p < to) {
        I64 m = 0;
        if (st[PROBING]) {
            m = reply_at(s, p, to);
        } else if (rows) {
            m = osc_at(s, p, to);
        }
        if (m < 0) {
            st[CUT] = true;
            m = 0;
        }
        if (m > 0 && rows) {
            I64 key = chosen(s, p, m);
            p += m;
            if (key > 0) {
                s[w] = key as U8;
                w += 1;
            }
        } else if (m > 0) {
            if (names_daphnis(s, p, m)) {
                st[DAPHNIS] = true;
            }
            if (s[p + m - 1] == 'c' && s[p + 1] == '[') {
                st[PROBING] = false;
            }
            p += m;
        } else {
            s[w] = s[p];
            w += 1;
            p += 1;
        }
    }
    return w;
}

// the menu's rows; an id under 32 is its key
export const I64 GROUP = 1;
export const I64 ON = 2;
export const I64 DIM = 4;
export const I64 N_ROWS = 10;
export const I64 WRAP_ROW = 9;
I64[10] ROW_ID = [14, 15, 100, 19, 101, 26, 25, 6, 18, 23];
I64[10] ROW_MARKS = [5, 4, 4, 0, 4, 1, 0, 1, 0, 1];
I64 put(inout U8[_] o, I64 at, in U8[_] b) {
    for i in 0..len(b) {
        o[at + i] = b[i];
    }
    return at + len(b);
}

I64 put_num(inout U8[_] o, I64 at, I64 v) {
    I64 n = at;
    if (v >= 10) {
        n = put_num(o, at, v / 10);
    }
    o[n] = ('0' + v % 10) as U8;
    return n + 1;
}

I64 words(inout U8[_] o, I64 at, I64 i) {
    switch (i) {
        case 0: return put(o, at, b"New Window;Ctrl+N");
        case 1: return put(o, at, b"Open;Ctrl+O");
        case 2: return put(o, at, b"Open Recent;");
        case 3: return put(o, at, b"Save;Ctrl+S");
        case 4: return put(o, at, b"Save As;");
        case 5: return put(o, at, b"Undo;Ctrl+Z");
        case 6: return put(o, at, b"Redo;Ctrl+Y");
        case 7: return put(o, at, b"Find;Ctrl+F");
        case 8: return put(o, at, b"Replace;Ctrl+R");
        default: return put(o, at, b"Word Wrap;");
    }
}

I64 row(inout U8[_] o, I64 at, I64 i, Bool wrap) {
    I64 n = put(o, at, b"\x1b]7770;item;");
    n = put_num(o, n, ROW_ID[i]);
    n = put(o, n, b";0;");
    n = words(o, n, i);
    o[n] = ';';
    n += 1;
    I64 marks = ROW_MARKS[i];
    if (i == WRAP_ROW && wrap) {
        marks = marks | ON;
    }
    if ((marks & GROUP) != 0) {
        o[n] = 'g';
        n += 1;
    }
    if ((marks & ON) != 0) {
        o[n] = 'o';
        n += 1;
    }
    if ((marks & DIM) != 0) {
        o[n] = 'd';
        n += 1;
    }
    o[n] = 7;
    return n + 1;
}

// every row, at most 600 bytes; the length
export I64 rows_osc(inout U8[_] o, Bool wrap) {
    I64 n = 0;
    for i in 0..N_ROWS {
        n = row(o, n, i, wrap);
    }
    return n;
}

// the wrap row alone, its dot on or off
export I64 wrap_osc(inout U8[_] o, Bool wrap) {
    return row(o, 0, WRAP_ROW, wrap);
}

test "xtversion naming daphnis, then da1: both taken out, daphnis, the probe over" {
    U8[32] s = b"\x1bP>|Daphnis\x1b\\\x1b[?62;22cab\x00\x00\x00\x00\x00\x00\x00\x00";
    Bool[3] st = [true, false, false];
    I64 e = strip(s, 0, 24, st);
    assert(e == 2 && s[0] == 'a' && s[1] == 'b');
    assert(!st[PROBING] && st[DAPHNIS] && !st[CUT]);
}

test "da1 alone: not daphnis; another xtversion: not daphnis" {
    U8[12] a = b"\x1b[?1;2cx\x00\x00\x00\x00";
    Bool[3] st = [true, false, false];
    assert(strip(a, 0, 8, st) == 1 && a[0] == 'x' && !st[DAPHNIS] && !st[PROBING]);
    U8[22] b = b"\x1bP>|xterm(390)\x1b\\\x1b[?62c";
    st[PROBING] = true;
    assert(strip(b, 0, 22, st) == 0 && !st[DAPHNIS] && !st[PROBING]);
}

test "a reply cut by the read is left and marked; keys stay keys; after the probe nothing is taken" {
    U8[8] a = b"k\x1bP>|Dap";
    Bool[3] st = [true, false, false];
    assert(strip(a, 0, 8, st) == 8 && st[CUT]);
    U8[6] b = b"\x1b[Aq\x1b[";
    assert(strip(b, 0, 4, st) == 4 && !st[CUT]);
    st[PROBING] = false;
    U8[9] c = b"\x1b[?62;22c";
    assert(strip(c, 0, 9, st) == 9);
}

test "a chosen row becomes its key's byte on the desk; a dim row, an unknown id and another OSC go; keys stay" {
    U8[41] s = b"a\x1b]7770;chose;19\x07b\x1b]7770;chose;14\x07\x1b]2;x\x07c";
    Bool[3] st = [false, true, false];
    I64 e = strip(s, 0, 41, st);
    assert(e == 4 && s[0] == 'a' && s[1] == 19 && s[2] == 'b' && s[3] == 'c');
    U8[17] t = b"\x1b]7770;chose;23\x1b\\";
    assert(strip(t, 0, 17, st) == 1 && t[0] == 23);
}

test "a chosen row cut by the read is left and marked; off the desk nothing is taken" {
    U8[11] a = b"x\x1b]7770;cho";
    Bool[3] st = [false, true, false];
    assert(strip(a, 0, 11, st) == 11 && st[CUT]);
    U8[16] b = b"\x1b]7770;chose;19\x07";
    st[DAPHNIS] = false;
    assert(strip(b, 0, 16, st) == 16 && !st[CUT]);
}

test "the rows of frame 41: ids, labels, keys, marks; Word Wrap's dot" {
    U8[600] o;
    I64 n = rows_osc(o, false);
    U8[8] first = b"\x1b]7770;i";
    assert(equal(o[0..8], first));
    U8[38] nw = b"\x1b]7770;item;14;0;New Window;Ctrl+N;gd\x07";
    assert(equal(o[0..38], nw));
    I64 bels = 0;
    for i in 0..n {
        if (o[i] == 7) {
            bels += 1;
        }
    }
    assert(bels == N_ROWS);
    U8[31] ww = b"\x1b]7770;item;23;0;Word Wrap;;go\x07";
    I64 w = wrap_osc(o, true);
    assert(w == 31 && equal(o[0..31], ww));
    w = wrap_osc(o, false);
    assert(w == 30 && o[28] == 'g' && o[29] == 7);
    U8[33] rp = b"\x1b]7770;item;18;0;Replace;Ctrl+R;\x07";
    U8[600] all;
    I64 m = rows_osc(all, false);
    Bool found = false;
    for i in 0..m - 33 {
        if (equal(all[i..i + 33], rp)) {
            found = true;
        }
    }
    assert(found);
}
