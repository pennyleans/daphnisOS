U8[43] names = [69, 110, 103, 108, 105, 115, 104, 32, 40, 85, 83, 41, 69, 110, 103, 108, 105, 115, 104, 32, 40, 85, 75, 41, 71, 101, 114, 109, 97, 110, 70, 114, 101, 110, 99, 104, 83, 112, 97, 110, 105, 115, 104];
I64[6] name_at = [0, 12, 24, 30, 36, 43];
// END generated

I64 lay = US;
I64 dead = 0;   // the dead key waiting (1 to 9, as accent), 0 for none

// Choose layout k (US to ES); out of range keeps the layout. Either way no dead key waits.
export void set_layout(I64 k) {
    if (k >= 0 && k < LAYOUTS) { lay = k; }
    dead = 0;
}

export I64 layout() { return lay; }

// Whether KEY_RIGHTALT is AltGr in the layout, rather than Alt.
export Bool has_altgr() { return lay != US; }

export Bool dead_pending() { return dead != 0; }

// Drop a waiting dead key (a focus change, say).
export void dead_clear() { dead = 0; }

// The name of layout k for the Settings page into dst (at least 16 bytes); its length, 0 for no layout k.
export I64 layout_name(I64 k, inout U8[_] dst) {
    if (k < 0 || k >= LAYOUTS) { return 0; }
    I64 a = name_at[k];
    I64 n = name_at[k + 1] - a;
    for i in 0..n { dst[i] = names[a + i]; }
    return n;
}

// Code point cp as UTF-8 into dst at at; the index after it.
I64 put(I64 cp, inout U8[_] dst, I64 at) {
    if (cp < 0x80) {
        dst[at] = cp as U8;
        return at + 1;
    }
    if (cp < 0x800) {
        dst[at] = (0xC0 | (cp >> 6)) as U8;
        dst[at + 1] = (0x80 | (cp & 0x3F)) as U8;
        return at + 2;
    }
    if (cp < 0x10000) {
        dst[at] = (0xE0 | (cp >> 12)) as U8;
        dst[at + 1] = (0x80 | ((cp >> 6) & 0x3F)) as U8;
        dst[at + 2] = (0x80 | (cp & 0x3F)) as U8;
        return at + 3;
    }
    dst[at] = (0xF0 | (cp >> 18)) as U8;
    dst[at + 1] = (0x80 | ((cp >> 12) & 0x3F)) as U8;
    dst[at + 2] = (0x80 | ((cp >> 6) & 0x3F)) as U8;
    dst[at + 3] = (0x80 | (cp & 0x3F)) as U8;
    return at + 4;
}

// The waiting dead key's accent into dst at 0, dropping it; the count, 0 for none.
I64 flush(inout U8[_] dst) {
    if (dead == 0) { return 0; }
    I64 n = put(accent[dead] as I64, dst, 0);
    dead = 0;
    return n;
}

// The UTF-8 bytes of a press of key code in the layout, with the modifiers held, into dst (at least 8 bytes);
// their count, 0 for none (a dead key, or a key with no bytes).
export I64 key_utf8(I64 code, Bool shift, Bool ctrl, Bool altgr, inout U8[_] dst) {
    if (lay == US) { return seq_of(code, shift, ctrl, dst); }
    I64 row = -1;
    if (code >= 0 && code < 58) { row = code; }
    if (code == KEY_102ND) { row = 58; }
    if (ctrl || row < 0) {
        U8[6] seq;
        I64 n = seq_of(code, shift, ctrl, seq);
        if (n == 0) { return 0; }
        I64 at = flush(dst);
        for i in 0..n { dst[at + i] = seq[i]; }
        return at + n;
    }
    I64 lv = 0;
    if (shift) { lv = 1; }
    if (altgr) { lv = lv + 2; }
    I64 s = sym[((lay - 1) * ROWS + row) * LEVELS + lv] as I64;
    if (s == 0) { return 0; }
    if (s > DEAD) {
        I64 at = flush(dst);
        dead = s - DEAD;
        return at;
    }
    if (dead == 0) { return put(s, dst, 0); }
    I64 li = -1;
    if (s >= 'A' as I64 && s <= 'Z' as I64) { li = s - 'A' as I64; }
    if (s >= 'a' as I64 && s <= 'z' as I64) { li = s - 'a' as I64 + 26; }
    if (li >= 0) {
        I64 c = composed[(dead - 1) * 52 + li] as I64;
        if (c != 0) {
            dead = 0;
            return put(c, dst, 0);
        }
    }
    I64 at = flush(dst);
    if (s == ' ' as I64) { return at; }
    return put(s, dst, at);
}
