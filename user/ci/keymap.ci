// user/ci/keymap.ci: key codes to the bytes a terminal sends (W-4): the US layout of a PC keyboard, Shift, and
// Ctrl with a letter or one of @ [ \ ] ^ _ for its control byte. Enter sends CR (the pty's ICRNL makes it NL),
// Backspace DEL, Tab HT, Esc ESC. Keys with no byte (arrows, function keys, the modifiers) give -1. seq_of adds
// the xterm sequences of the arrows, Home, End, PgUp, PgDn, Insert, Delete and F3 (E-3, docs/specs/2026-11-06-e-editor.md
// section 6): ESC [ A for Up, ESC [ 1 ; m A with Shift (m 2), Ctrl (5) or both (6); ESC [ 5 ~ and ESC [ 5 ; m ~ for
// PgUp; ESC O R and ESC [ 1 ; m R for F3.
//
// K-11b (docs/specs/2026-11-07-k-kit2.md section 3h): byte_of and seq_of stay the US layout whatever the layout is.
// key_utf8 types in the chosen layout (US, GB, DE, FR, ES; pc105, the basic variants of xkeyboard-config 2.42) as
// UTF-8, with AltGr (KEY_RIGHTALT) and the ISO key (KEY_102ND), and dead keys: a dead key gives nothing and waits;
// then a letter it combines with gives the Latin-1 letter, space gives the accent, and any other key the accent and
// then that key (a second dead key gives the first's accent and waits in its place). A key with no bytes (Shift,
// Ctrl, AltGr, F1) leaves a dead key waiting. Ctrl gives seq_of's bytes, the US control byte by key position, with
// AltGr ignored; Shift with AltGr (level 4) gives nothing but on Esc, Backspace, Tab, Enter and Space.

export const I64 KEY_LEFTCTRL = 29;
export const I64 KEY_LEFTSHIFT = 42;
export const I64 KEY_RIGHTSHIFT = 54;
export const I64 KEY_RIGHTCTRL = 97;
export const I64 KEY_102ND = 86;       // the ISO key between left Shift and Z
export const I64 KEY_RIGHTALT = 100;   // AltGr in every layout but US

// the layouts, US first (the default)
export const I64 US = 0;
export const I64 GB = 1;
export const I64 DE = 2;
export const I64 FR = 3;
export const I64 ES = 4;
export const I64 LAYOUTS = 5;

// codes 0 to 57, plain and with Shift; 0 for no byte
U8[58] plain = [0, 27, '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 127, 9,
    'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 13, 0, 'a', 's',
    'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', 39, '`', 0, 92, 'z', 'x', 'c', 'v',
    'b', 'n', 'm', ',', '.', '/', 0, 0, 0, ' '];
U8[58] shifted = [0, 27, '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+', 127, 9,
    'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '{', '}', 13, 0, 'A', 'S',
    'D', 'F', 'G', 'H', 'J', 'K', 'L', ':', 34, '~', 0, '|', 'Z', 'X', 'C', 'V',
    'B', 'N', 'M', '<', '>', '?', 0, 0, 0, ' '];

// The byte of key code with the modifiers held, or -1.
export I64 byte_of(I64 code, Bool shift, Bool ctrl) {
    if (code < 0 || code >= 58) { return -1; }
    I64 b = plain[code] as I64;
    if (shift) { b = shifted[code] as I64; }
    if (b == 0) { return -1; }
    if (ctrl) {
        I64 u = b;
        if (u >= 'a' as I64 && u <= 'z' as I64) { u = u - 32; }
        if (u >= 64 && u <= 95) { return u - 64; }
        return -1;
    }
    return b;
}

// codes 102 to 111: Home, Up, PgUp, Left, Right, End, Down, PgDn, Insert, Delete; a final byte, or a digit before ~
U8[10] csi_key = ['H', 'A', '5', 'D', 'C', 'F', 'B', '6', '2', '3'];
const I64 KEY_F3 = 61;

// The bytes of key code with the modifiers held into dst (at least 6 bytes); their count, 0 for none.
export I64 seq_of(I64 code, Bool shift, Bool ctrl, inout U8[_] dst) {
    I64 b = byte_of(code, shift, ctrl);
    if (b >= 0) {
        dst[0] = b as U8;
        return 1;
    }
    U8 f = 'R';
    if (code >= 102 && code <= 111) {
        f = csi_key[code - 102];
    } else if (code != KEY_F3) {
        return 0;
    }
    I64 m = 1;
    if (shift) { m = m + 1; }
    if (ctrl) { m = m + 4; }
    dst[0] = 27;
    dst[1] = '[';
    if (f >= '0' && f <= '9') {
        dst[2] = f;
        if (m == 1) {
            dst[3] = '~';
            return 4;
        }
        dst[3] = ';';
        dst[4] = ('0' as I64 + m) as U8;
        dst[5] = '~';
        return 6;
    }
    if (m == 1) {
        if (code == KEY_F3) { dst[1] = 'O'; }
        dst[2] = f;
        return 3;
    }
    dst[2] = '1';
    dst[3] = ';';
    dst[4] = ('0' as I64 + m) as U8;
    dst[5] = f;
    return 6;
}

