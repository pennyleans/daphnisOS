// One decoded key in, caller-owned session tables out. No host capabilities.
//
// CV-2b (docs/specs/2026-11-07-cv-cvim.md section 5): a typed key runs, then the typeahead it left (a macro's keys, a
// repeat's keys), each through the same modes, as Vim's typeahead and stuff buffers do; a bell drops the rest of the
// typeahead (beep_flush). The window follows the cursor after every key (scroll.follow, Vim's update_topline).
import user.ced.keys;
import user.ci.cvim.buf;
import user.ci.cvim.text;
import user.ci.cvim.state;
import user.ci.cvim.motion;
import user.ci.cvim.mode;
import user.ci.cvim.op;
import user.ci.cvim.edit;
import user.ci.cvim.undo;
import user.ci.cvim.reg;
import user.ci.cvim.obj;
import user.ci.cvim.scroll;
import user.ci.cvim.blk;

export void init(inout I64[_] r, inout I64[_] x, I64 blocks, I64 chunk) {
    for i in 0..len(r) { r[i] = 0; }
    r[state.R_WANT] = -1;
    r[state.R_CHUNK] = chunk;
    // Vim's window on a terminal of 24 rows, until window() says otherwise.
    r[state.R_HEIGHT] = 23;
    r[state.R_SCROLL] = 11;
    for i in 0..26 { r[state.R_MARK0 + 2 * i] = -1; }
    buf.reset(x, blocks, chunk);
}

// The window's text rows (an input of the core): H M L and the scroll keys count in it; 'scroll' becomes half of it.
export void window(inout I64[_] r, I64 rows) {
    r[state.R_HEIGHT] = max(rows, 1);
    r[state.R_SCROLL] = max(rows / 2, 1);
}

export Bool load(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add) {
    r[state.R_ST_ORIG] = len(orig);
    if (!buf.load(x, orig, add, 0, len(orig))) { return false; }
    if (len(orig) > 0 && orig[len(orig) - 1] != '\n') {
        U8[1] lf; lf[0] = '\n';
        if (!buf.insert(x, r, orig, add, len(orig), lf)) { return false; }
    }
    r[state.R_PBOUND] = buf.pieces(x);
    return true;
}

void clear(inout I64[_] r) {
    r[state.R_OP] = 0;
    r[state.R_OPCOUNT] = 0;
    r[state.R_COUNT] = 0;
    r[state.R_PREFIX] = 0;
    r[state.R_REGNAME] = 0;
}

void unbound(inout I64[_] r, I64 k) {
    clear(r);
    r[state.R_BELL] = 1;
    r[state.R_MSG] = k;
}

// The command being typed changes the text: it becomes the repeat buffer when it ends (2: a Visual operator).
void changes(inout I64[_] r, I64 cnt, I64 kind) {
    r[state.R_DOT_CHANGED] = kind;
    r[state.R_DOT_PCOUNT] = cnt;
}

I64 op_key(I64 cmd) {
    if (cmd == op.OP_TILDE) { return '~'; }
    if (cmd == op.OP_LOWER) { return 'u'; }
    if (cmd == op.OP_UPPER) { return 'U'; }
    return cmd;
}

Bool scroll_key(I64 k) {
    return k == keys.M_CTRL + 'd' || k == keys.M_CTRL + 'u' || k == keys.M_CTRL + 'f' || k == keys.M_CTRL + 'b';
}

Bool is_motion(I64 k) {
    return motion.is_motion(k) || k == 'H' || k == 'M' || k == 'L';
}

void move(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
          inout I64[_] u, I64 m, I64 c, I64 rep, I64 raw) {
    I64 cmd = r[state.R_OP];
    r[state.R_USE_ONE] = 0;
    if (m == '%' || m == '{' || m == '}' || m == '`') { r[state.R_USE_ONE] = 1; }
    I64 q = motion.go(r, x, orig, add, m, c, rep, raw, cmd);
    if (cmd != 0) {
        if (r[state.R_MFAIL] == 0) {
            if (cmd != 'y') { changes(r, raw, 1); }
            op.range(r, x, orig, add, sp, u, cmd, q, r[state.R_MLINE] != 0, r[state.R_MINCL] != 0);
        } else { r[state.R_BELL] = 1; }
    } else {
        if (r[state.R_MFAIL] != 0) { r[state.R_BELL] = 1; }
        r[state.R_CUR] = text.normal_pos(x, orig, add, q);
        if (r[state.R_MWANT] == 0) { r[state.R_WANT] = -1; }
        else if (r[state.R_MWANT] == 2) { r[state.R_WANT] = state.WANT_END; }
    }
    clear(r);
    r[state.R_USE_ONE] = 0;
    if (r[state.R_MODE] == state.MODE_NORMAL) { undo.close_step(r); }
}

// An operator on a text object (d i w): the object from the cursor, then the operator on it.
void object(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
            inout I64[_] u, I64 k, Bool include, I64 rep, I64 raw) {
    I64 cmd = r[state.R_OP];
    if (!obj.find(r, x, orig, add, k, include, rep, false)) { clear(r); r[state.R_BELL] = 1; return; }
    if (cmd != 'y') { changes(r, raw, 1); }
    r[state.R_CUR] = r[state.R_OBJ_S];
    op.range(r, x, orig, add, sp, u, cmd, r[state.R_OBJ_E], r[state.R_OBJ_LINE] != 0, r[state.R_OBJ_INCL] != 0);
    clear(r);
    if (r[state.R_MODE] == state.MODE_NORMAL) { undo.close_step(r); }
}

void line_op(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
             inout I64[_] u, I64 k, I64 rep, I64 raw) {
    I64 l = text.lineof(x, orig, add, r[state.R_CUR]);
    I64 to = min(l + rep - 1, text.nlines(x) - 1);
    I64 saved_cur = r[state.R_CUR];
    if (k != 'y') { changes(r, raw, 1); }
    op.range(r, x, orig, add, sp, u, k, text.lstart(x, orig, add, to), true, false);
    if (k == 'y' || k == op.OP_TILDE || k == op.OP_LOWER || k == op.OP_UPPER) { r[state.R_CUR] = saved_cur; }
    clear(r);
    if (r[state.R_MODE] == state.MODE_NORMAL) { undo.close_step(r); }
}

// p and P from the register the command names.
void put(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
         inout I64[_] u, I64 name, Bool after, I64 rep) {
    I64 i = reg.reading(r, name);
    if (reg.kind_of(r, i) == state.KIND_BLOCK) { r[state.R_BELL] = 1; r[state.R_MSG] = 'p'; return; }
    r[state.R_REG_FROM] = reg.from_of(r, i);
    r[state.R_REG_TO] = reg.to_of(r, i);
    r[state.R_REG_LINE] = 0;
    if (reg.kind_of(r, i) == state.KIND_LINE) { r[state.R_REG_LINE] = 1; }
    op.paste(r, x, orig, add, sp, u, after, rep);
    reg.sync(r);
}

// Visual mode starts (kind 'v', 'V' or Ctrl+V) at the cursor.
void visual_begin(inout I64[_] r, I64 kind) {
    r[state.R_MODE] = state.MODE_VISUAL;
    r[state.R_VMODE] = kind;
    r[state.R_VSTART] = r[state.R_CUR];
}

// The selection is kept for gv; Normal mode, the cursor off a line's end.
void visual_end(inout I64[_] r, in I64[_] x, in U8[_] orig, in U8[_] add) {
    r[state.R_GV_MODE] = r[state.R_VMODE];
    I64 s = r[state.R_VSTART];
    I64 c = r[state.R_CUR];
    r[state.R_GV_START] = text.lineof(x, orig, add, s);
    r[state.R_GV_SCOL] = text.col(x, orig, add, s);
    r[state.R_GV_END] = text.lineof(x, orig, add, c);
    r[state.R_GV_ECOL] = text.col(x, orig, add, c);
    r[state.R_GV_WANT] = r[state.R_WANT];
    r[state.R_VMODE] = 0;
    if (r[state.R_MODE] == state.MODE_VISUAL) { r[state.R_MODE] = state.MODE_NORMAL; }
    r[state.R_CUR] = text.normal_pos(x, orig, add, r[state.R_CUR]);
}

I64 gv_pos(in I64[_] x, in U8[_] orig, in U8[_] add, I64 l, I64 c) {
    I64 ll = min(max(l, 0), text.nlines(x) - 1);
    return min(text.lstart(x, orig, add, ll) + c, text.lend(x, orig, add, ll));
}

// gv: the last selection again.
void reselect(inout I64[_] r, in I64[_] x, in U8[_] orig, in U8[_] add) {
    if (r[state.R_GV_MODE] == 0) { r[state.R_BELL] = 1; return; }
    I64 m = r[state.R_GV_MODE];
    I64 s = gv_pos(x, orig, add, r[state.R_GV_START], r[state.R_GV_SCOL]);
    I64 c = gv_pos(x, orig, add, r[state.R_GV_END], r[state.R_GV_ECOL]);
    I64 w = r[state.R_GV_WANT];
    if (r[state.R_MODE] == state.MODE_VISUAL) {
        r[state.R_GV_MODE] = r[state.R_VMODE];
        r[state.R_GV_START] = text.lineof(x, orig, add, r[state.R_VSTART]);
        r[state.R_GV_SCOL] = text.col(x, orig, add, r[state.R_VSTART]);
        r[state.R_GV_END] = text.lineof(x, orig, add, r[state.R_CUR]);
        r[state.R_GV_ECOL] = text.col(x, orig, add, r[state.R_CUR]);
        r[state.R_GV_WANT] = r[state.R_WANT];
    }
    r[state.R_MODE] = state.MODE_VISUAL;
    r[state.R_VMODE] = m;
    r[state.R_VSTART] = s;
    r[state.R_CUR] = c;
    r[state.R_WANT] = w;
}

// K_REDO_VISUAL of the repeat buffer: a selection of the size the repeated Visual operator had, from the cursor (Vim's
// redo_VIsual in do_pending_operator).
void redo_visual(inout I64[_] r, in I64[_] x, in U8[_] orig, in U8[_] add) {
    I64 p = r[state.R_CUR];
    I64 l = text.lineof(x, orig, add, p);
    I64 to = min(l + max(r[state.R_RV_LINES], 1) - 1, text.nlines(x) - 1);
    I64 m = r[state.R_RV_MODE];
    visual_begin(r, m);
    I64 vc = r[state.R_RV_VCOL];
    if (vc >= blk.END) {
        r[state.R_CUR] = text.lend(x, orig, add, to);
        r[state.R_WANT] = state.WANT_END;
    } else if (m == 'v') {
        I64 want = vc;
        if (r[state.R_RV_LINES] <= 1) { want = text.vcol(x, orig, add, p) + vc - 1; }
        r[state.R_CUR] = text.at_vcol(x, orig, add, to, want, true);
    } else if (m == 'V') {
        r[state.R_CUR] = text.at_vcol(x, orig, add, to, text.vcol(x, orig, add, p), false);
    } else {
        r[state.R_CUR] = text.at_vcol(x, orig, add, to, text.vcol(x, orig, add, p) + vc - 1, true);
    }
    r[state.R_RV_BUSY] = 1;
}

// The Visual operator of key k (c: r's character) on the selection, then Normal mode (or Insert mode for c, I, A).
void visual_apply(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
               inout I64[_] u, I64 k, I64 c, I64 raw) {
    I64 m = r[state.R_VMODE];
    I64 block = keys.M_CTRL + 'v';
    I64 cmd = k;
    if (k == 'x') { cmd = 'd'; }
    if (k == 's') { cmd = 'c'; }
    if (k == '~') { cmd = op.OP_TILDE; }
    if (k == 'u') { cmd = op.OP_LOWER; }
    if (k == 'U') { cmd = op.OP_UPPER; }
    I64 end_col = 0;
    if (k == 'X' || k == 'D' || k == 'C' || k == 'S' || k == 'R' || k == 'Y') {
        cmd = 'd';
        if (k == 'C' || k == 'S' || k == 'R') { cmd = 'c'; }
        if (k == 'Y') { cmd = 'y'; }
        if (m == block && (k == 'D' || k == 'C')) { end_col = 1; }
        else if (!(m == block && (k == 'X' || k == 'Y'))) { m = 'V'; }
    }
    I64 s = min(r[state.R_VSTART], r[state.R_CUR]);
    I64 e = max(r[state.R_VSTART], r[state.R_CUR]);
    I64 l0 = text.lineof(x, orig, add, s);
    I64 l1 = text.lineof(x, orig, add, e);
    I64 c0 = min(text.vcol(x, orig, add, r[state.R_VSTART]), text.vcol(x, orig, add, r[state.R_CUR]));
    I64 c1 = max(text.vcol(x, orig, add, r[state.R_VSTART]), text.vcol(x, orig, add, r[state.R_CUR]));
    if (r[state.R_WANT] == state.WANT_END || end_col != 0) { c1 = blk.END; }
    else if (r[state.R_RV_BUSY] != 0 && m == block) {
        // A repeated block keeps its width from its start, whatever the cursor's line holds.
        c0 = text.vcol(x, orig, add, r[state.R_VSTART]);
        c1 = c0 + r[state.R_RV_VCOL] - 1;
    }
    if (cmd != 'y') {
        // The repeat keeps this selection's size (Vim's resel_VIsual).
        r[state.R_RV_MODE] = m;
        r[state.R_RV_LINES] = l1 - l0 + 1;
        if (c1 >= blk.END) { r[state.R_RV_VCOL] = blk.END; }
        else if (m == block) { r[state.R_RV_VCOL] = c1 - c0 + 1; }
        else if (l1 == l0) { r[state.R_RV_VCOL] = text.vcol(x, orig, add, e) - text.vcol(x, orig, add, s) + 1; }
        else { r[state.R_RV_VCOL] = text.vcol(x, orig, add, e); }
        changes(r, raw, 2);
    }
    I64 rep = max(raw, 1);
    visual_end(r, x, orig, add);
    // The operator starts at the selection's start (do_pending_operator), where undo will put the cursor back.
    r[state.R_CUR] = s;
    if (m == block) { r[state.R_CUR] = text.normal_pos(x, orig, add, blk.pos_at(x, orig, add, l0, c0)); }
    if (m == block) {
        if (cmd == 'y') {
            if (blk.yank(r, x, orig, add, sp, u, 'y', l0, l1, c0, c1)) {
                r[state.R_CUR] = text.normal_pos(x, orig, add, blk.pos_at(x, orig, add, l0, c0));
            }
            return;
        }
        if (cmd == 'd' || cmd == 'c') {
            if (!blk.room(r, x, orig, add, sp, u, l0, l1, c0, c1)) { return; }
            if (!blk.yank(r, x, orig, add, sp, u, cmd, l0, l1, c0, c1)) { return; }
            if (!blk.delete(r, x, orig, add, sp, u, l0, l1, c0, c1)) { return; }
            if (cmd == 'c') {
                r[state.R_CUR] = blk.pos_at(x, orig, add, l0, c0);
                mode.begin(r, 'c', 1);
                r[state.R_BI_CMD] = 'c';
                r[state.R_BI_L0] = l0; r[state.R_BI_L1] = l1; r[state.R_BI_VCOL] = c0; r[state.R_BI_END] = c0;
                r[state.R_BI_LEN] = text.lend(x, orig, add, l0) - text.lstart(x, orig, add, l0);
                r[state.R_BI_POS] = r[state.R_CUR];
            }
            return;
        }
        if (cmd == 'I' || cmd == 'A') {
            I64 vc = c0;
            I64 bk = 'I';
            if (cmd == 'A') { vc = c1 + 1; bk = 'A'; if (c1 >= blk.END) { bk = '$'; } }
            if (bk == 'A') {
                I64 w = blk.width(x, orig, add, l0);
                if (w < vc) {
                    if (!edit.blanks(r, x, orig, add, u, text.lend(x, orig, add, l0), vc - w)) { return; }
                }
            }
            I64 p = blk.pos_at(x, orig, add, l0, vc);
            if (bk == '$') { p = text.lend(x, orig, add, l0); }
            r[state.R_BI_CMD] = bk;
            r[state.R_BI_L0] = l0; r[state.R_BI_L1] = l1; r[state.R_BI_VCOL] = vc; r[state.R_BI_END] = c0;
            r[state.R_BI_LEN] = text.lend(x, orig, add, l0) - text.lstart(x, orig, add, l0);
            r[state.R_BI_POS] = p;
            r[state.R_CUR] = p;
            mode.begin(r, 'i', 1);
            return;
        }
        if (cmd == op.OP_TILDE || cmd == op.OP_LOWER || cmd == op.OP_UPPER || cmd == 'r') {
            _ = blk.change_chars(r, x, orig, add, sp, u, cmd, c, l0, l1, c0, c1);
            return;
        }
        if (cmd == 'J') {
            r[state.R_CUR] = text.lstart(x, orig, add, l0);
            op.join(r, x, orig, add, sp, u, max(l1 - l0 + 1, 2));
            return;
        }
        if (cmd == '>' || cmd == '<') { _ = blk.shift(r, x, orig, add, sp, u, cmd, l0, l1, c0, rep); return; }
        if (cmd == '=') { op.apply(r, x, orig, add, sp, u, cmd, s, e, true, l0, l1, s); return; }
        r[state.R_BELL] = 1;
        r[state.R_MSG] = k;
        return;
    }
    if (cmd == 'I' || cmd == 'A') {
        // v_visop: I and A on a v or V selection insert before its first line or after its end character.
        I64 p = text.lstart(x, orig, add, l0);
        if (cmd == 'A') {
            p = e;
            if (text.ch(x, orig, add, e) != '\n') { p = text.nextc(x, orig, add, e); }
        }
        r[state.R_CUR] = p;
        mode.begin(r, 'i', 1);
        return;
    }
    if (cmd == 'J') {
        r[state.R_CUR] = text.lstart(x, orig, add, l0);
        op.join(r, x, orig, add, sp, u, max(l1 - l0 + 1, 2));
        return;
    }
    if (cmd == '>' || cmd == '<') { op.shift(r, x, orig, add, sp, u, cmd, l0, l1, rep); return; }
    if (cmd == '=') { op.apply(r, x, orig, add, sp, u, cmd, s, e, true, l0, l1, s); return; }
    if (m == 'V') {
        I64 lo = text.lstart(x, orig, add, l0);
        I64 hi = min(text.lend(x, orig, add, l1) + 1, buf.total(x));
        if (cmd == 'r') {
            if (op.replace_range(r, x, orig, add, sp, u, c, lo, hi)) { r[state.R_CUR] = text.normal_pos(x, orig, add, lo); }
            return;
        }
        op.apply(r, x, orig, add, sp, u, cmd, lo, hi, true, l0, l1, lo);
        return;
    }
    I64 hi = text.nextc(x, orig, add, e);
    I64 lb = l1;
    if (text.ch(x, orig, add, e) == '\n') {
        hi = e;
        if (l1 < text.nlines(x) - 1) { hi = e + 1; lb = l1 + 1; }
    }
    hi = min(hi, buf.total(x));
    if (cmd == 'r') {
        if (op.replace_range(r, x, orig, add, sp, u, c, s, hi)) { r[state.R_CUR] = text.normal_pos(x, orig, add, s); }
        return;
    }
    op.apply(r, x, orig, add, sp, u, cmd, s, hi, false, l0, lb, s);
}

// A refused Visual operator (a full table) leaves the selection and Visual mode as they were.
void visual_op(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
               inout I64[_] u, I64 k, I64 c, I64 raw) {
    I64[12] keep;
    keep[0] = r[state.R_MODE]; keep[1] = r[state.R_VMODE]; keep[2] = r[state.R_VSTART]; keep[3] = r[state.R_CUR];
    keep[4] = r[state.R_WANT]; keep[5] = r[state.R_GV_MODE]; keep[6] = r[state.R_GV_START]; keep[7] = r[state.R_GV_END];
    keep[8] = r[state.R_GV_WANT]; keep[9] = r[state.R_GV_SCOL]; keep[10] = r[state.R_GV_ECOL];
    keep[11] = r[state.R_BI_CMD];
    visual_apply(r, x, orig, add, sp, u, k, c, raw);
    if (r[state.R_FULL] != 0) {
        r[state.R_MODE] = keep[0]; r[state.R_VMODE] = keep[1]; r[state.R_VSTART] = keep[2]; r[state.R_CUR] = keep[3];
        r[state.R_WANT] = keep[4]; r[state.R_GV_MODE] = keep[5]; r[state.R_GV_START] = keep[6]; r[state.R_GV_END] = keep[7];
        r[state.R_GV_WANT] = keep[8]; r[state.R_GV_SCOL] = keep[9]; r[state.R_GV_ECOL] = keep[10];
        r[state.R_BI_CMD] = keep[11];
    }
}

// A motion in Visual mode: the cursor may stand on a line's end (Vim's one_more with 'selection' inclusive).
void visual_move(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, I64 m, I64 c, I64 rep, I64 raw) {
    I64 p = r[state.R_CUR];
    clear(r);
    if (m == 'l' || m == keys.K_RIGHT) {
        I64 q = p;
        for i in 0..rep {
            if (text.ch(x, orig, add, q) == '\n') { break; }
            q = text.nextc(x, orig, add, q);
        }
        if (q == p) { r[state.R_BELL] = 1; }
        r[state.R_CUR] = q;
        r[state.R_WANT] = -1;
        return;
    }
    I64 q = motion.go(r, x, orig, add, m, c, rep, raw, 0);
    if (r[state.R_MFAIL] != 0) { r[state.R_BELL] = 1; return; }
    if (m == 'j' || m == 'k' || m == keys.K_UP || m == keys.K_DOWN) {
        q = text.at_vcol(x, orig, add, text.lineof(x, orig, add, q), r[state.R_WANT], true);
    } else if (m == '$' || m == keys.K_END) {
        q = text.lend(x, orig, add, text.lineof(x, orig, add, q));
    } else {
        q = text.normal_pos(x, orig, add, q);
    }
    r[state.R_CUR] = q;
    if (r[state.R_MWANT] == 0) { r[state.R_WANT] = -1; }
    else if (r[state.R_MWANT] == 2) { r[state.R_WANT] = state.WANT_END; }
}

// In Visual mode.
void visual(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
            inout I64[_] u, I64 k) {
    I64 prefix = r[state.R_PREFIX];
    I64 raw = r[state.R_COUNT];
    I64 rep = max(raw, 1);
    if (prefix != 0) {
        r[state.R_PREFIX] = 0;
        if (prefix == '"') {
            if (reg.valid(k)) { r[state.R_REGNAME] = k; } else { unbound(r, k); }
            return;
        }
        if (prefix == 'g') {
            if (k == 'v') { reselect(r, x, orig, add); clear(r); return; }
            if (k == '~' || k == 'u' || k == 'U') {
                visual_op(r, x, orig, add, sp, u, k, 0, raw);
                clear(r);
                if (r[state.R_MODE] == state.MODE_NORMAL) { undo.close_step(r); }
                return;
            }
            if (k == 'g' || k == 'e' || k == 'E') {
                I64 m = state.M_GG;
                if (k == 'e') { m = state.M_GE; } else if (k == 'E') { m = state.M_GEB; }
                visual_move(r, x, orig, add, m, 0, rep, raw);
                return;
            }
            unbound(r, k);
            return;
        }
        if (prefix == 'i' || prefix == 'a') {
            if (!obj.is_object(k) || !obj.find(r, x, orig, add, k, prefix == 'a', rep, true)) {
                clear(r);
                r[state.R_BELL] = 1;
                return;
            }
            if (r[state.R_OBJ_LINE] != 0) {
                if (text.lineof(x, orig, add, r[state.R_VSTART]) != text.lineof(x, orig, add, r[state.R_OBJ_S])) {
                    r[state.R_VSTART] = r[state.R_OBJ_S];
                }
                r[state.R_VMODE] = 'V';
            } else {
                r[state.R_VSTART] = r[state.R_OBJ_S];
                if (r[state.R_VMODE] == 'V') { r[state.R_VMODE] = 'v'; }
            }
            r[state.R_CUR] = r[state.R_OBJ_E];
            r[state.R_WANT] = -1;
            clear(r);
            return;
        }
        if (prefix == 'r') {
            if (k >= 32 && k <= 1114111 && !(k >= 55296 && k <= 57343)) {
                visual_op(r, x, orig, add, sp, u, 'r', k, raw);
                clear(r);
                undo.close_step(r);
            } else { unbound(r, k); }
            return;
        }
        if (k >= 32 && k <= 1114111 && !(k >= 55296 && k <= 57343)) { visual_move(r, x, orig, add, prefix, k, rep, raw); }
        else { unbound(r, k); }
        return;
    }
    if (k == keys.K_ESC || k == keys.M_CTRL + '[') { visual_end(r, x, orig, add); clear(r); return; }
    if ((k >= '1' && k <= '9') || (k == '0' && raw != 0)) { r[state.R_COUNT] = min(raw * 10 + k - '0', 100000); return; }
    if (k == '"' || k == 'g' || k == 'f' || k == 'F' || k == 't' || k == 'T' || k == 'i' || k == 'a' || k == 'r'
        || k == '`' || k == '\'') {
        r[state.R_PREFIX] = k;
        return;
    }
    if (k == 'v' || k == 'V' || k == keys.M_CTRL + 'v') {
        if (r[state.R_VMODE] == k) { visual_end(r, x, orig, add); }
        else { r[state.R_VMODE] = k; }
        clear(r);
        return;
    }
    if (k == 'o') {
        I64 t = r[state.R_VSTART];
        r[state.R_VSTART] = r[state.R_CUR];
        r[state.R_CUR] = t;
        r[state.R_WANT] = -1;
        clear(r);
        return;
    }
    if (is_motion(k)) { visual_move(r, x, orig, add, k, 0, rep, raw); return; }
    if (scroll_key(k)) {
        Bool ok = false;
        if (k == keys.M_CTRL + 'd' || k == keys.M_CTRL + 'u') { ok = scroll.half(r, x, orig, add, k == keys.M_CTRL + 'd', raw); }
        else { ok = scroll.page(r, x, orig, add, k == keys.M_CTRL + 'f', rep); }
        if (!ok) { r[state.R_BELL] = 1; }
        clear(r);
        return;
    }
    if (k == 'd' || k == 'x' || k == 'X' || k == 'D' || k == 'c' || k == 's' || k == 'C' || k == 'S' || k == 'R'
        || k == 'y' || k == 'Y' || k == '>' || k == '<' || k == '=' || k == '~' || k == 'u' || k == 'U' || k == 'J'
        || k == 'I' || k == 'A') {
        visual_op(r, x, orig, add, sp, u, k, 0, raw);
        clear(r);
        if (r[state.R_MODE] == state.MODE_NORMAL) { undo.close_step(r); }
        return;
    }
    unbound(r, k);
}

Bool push(inout I64[_] r, I64 k) {
    if (r[state.R_TA_N] >= state.TA_MAX) { return false; }
    r[state.R_TA0 + r[state.R_TA_N]] = k;
    r[state.R_TA_N] += 1;
    return true;
}

// . (Vim's start_redo): the repeat buffer onto the typeahead's front, count in place of its count, a numbered
// register one higher ("1p then . puts "2).
void repeat(inout I64[_] r, I64 cnt) {
    I64 n = r[state.R_DOT_N];
    I64 head = 0;
    if (n >= 2 && r[state.R_DOT0] == '"') { head = 2; }
    else if (n >= 1 && r[state.R_DOT0] == state.K_REDO_VISUAL) { head = 1; }
    I64 digits = 0;
    I64 c = cnt;
    while (c > 0) { digits += 1; c = c / 10; }
    if (r[state.R_TA_N] + n + digits > state.TA_MAX) { r[state.R_BELL] = 1; return; }
    if (head == 2 && r[state.R_DOT0 + 1] >= '1' && r[state.R_DOT0 + 1] < '9') { r[state.R_DOT0 + 1] += 1; }
    for j in 0..n - head { _ = push(r, r[state.R_DOT0 + n - 1 - j]); }
    c = cnt;
    while (c > 0) { _ = push(r, '0' + c % 10); c = c / 10; }
    for j in 0..head { _ = push(r, r[state.R_DOT0 + head - 1 - j]); }
}

// Normal mode.
void normal(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
            inout I64[_] u, I64 k, Bool typed) {
    if (k == keys.K_ESC || k == keys.M_CTRL + '[') { clear(r); return; }
    if (k == state.K_REDO_VISUAL) { clear(r); redo_visual(r, x, orig, add); return; }
    I64 prefix = r[state.R_PREFIX];
    I64 raw = r[state.R_COUNT];
    I64 rep = max(raw, 1) * max(r[state.R_OPCOUNT], 1);
    I64 typed_count = raw;
    if (r[state.R_OPCOUNT] > 0) { typed_count = rep; }
    if (prefix != 0) {
        r[state.R_PREFIX] = 0;
        if (prefix == '"') {
            if (reg.valid(k)) { r[state.R_REGNAME] = k; } else { unbound(r, k); }
            return;
        }
        if (prefix == 'q') {
            if ((k >= 'a' && k <= 'z') || (k >= 'A' && k <= 'Z') || (k >= '0' && k <= '9') || k == '"') {
                clear(r);
                r[state.R_REC] = k;
                r[state.R_REC_N] = 0;
            } else { unbound(r, k); }
            return;
        }
        if (prefix == '@') {
            I64 name = k;
            if (k == '@') { name = r[state.R_LAST_AT]; }
            I64 i = reg.index(name);
            if (name == '"') { i = r[state.R_PREV]; }
            clear(r);
            if (i < 0) { r[state.R_BELL] = 1; return; }
            r[state.R_LAST_AT] = name;
            if (!reg.run(r, orig, add, sp, i, max(raw, 1))) { r[state.R_BELL] = 1; }
            return;
        }
        if (prefix == 'm') {
            clear(r);
            if (k >= 'a' && k <= 'z') {
                I64 p = r[state.R_CUR];
                I64 l = text.lineof(x, orig, add, p);
                r[state.R_MARK0 + 2 * (k - 'a')] = l;
                r[state.R_MARK0 + 2 * (k - 'a') + 1] = p - text.lstart(x, orig, add, l);
            } else { r[state.R_BELL] = 1; r[state.R_MSG] = k; }
            return;
        }
        if (prefix == 'g') {
            if (k == 'g') { move(r, x, orig, add, sp, u, state.M_GG, 0, rep, typed_count); }
            else if (k == 'e') { move(r, x, orig, add, sp, u, state.M_GE, 0, rep, typed_count); }
            else if (k == 'E') { move(r, x, orig, add, sp, u, state.M_GEB, 0, rep, typed_count); }
            else if (k == '~' || k == 'u' || k == 'U') {
                I64 code = op.OP_TILDE;
                if (k == 'u') { code = op.OP_LOWER; } else if (k == 'U') { code = op.OP_UPPER; }
                if (r[state.R_OP] == code) { line_op(r, x, orig, add, sp, u, code, rep, typed_count); }
                else if (r[state.R_OP] == 0) {
                    r[state.R_OP] = code;
                    r[state.R_OPCOUNT] = raw;
                    r[state.R_COUNT] = 0;
                } else { unbound(r, k); }
            } else if (k == 'v' && r[state.R_OP] == 0) { clear(r); reselect(r, x, orig, add); }
            else { unbound(r, k); }
            return;
        }
        if (prefix == 'r') {
            if (k == keys.K_ENTER || (k >= 32 && k <= 1114111)) {
                I64 c = k;
                if (k == keys.K_ENTER) { c = '\n'; }
                changes(r, raw, 1);
                op.replace(r, x, orig, add, sp, u, c, rep);
                undo.close_step(r);
                clear(r);
            } else { unbound(r, k); }
            return;
        }
        if (prefix == 'i' || prefix == 'a') {
            if (obj.is_object(k)) { object(r, x, orig, add, sp, u, k, prefix == 'a', rep, typed_count); }
            else { unbound(r, k); }
            return;
        }
        if (k >= 32 && k <= 1114111 && !(k >= 55296 && k <= 57343)) { move(r, x, orig, add, sp, u, prefix, k, rep, typed_count); }
        else { unbound(r, k); }
        return;
    }
    if ((k >= '1' && k <= '9') || (k == '0' && raw != 0)) {
        // Bound arithmetic and work before multiplication of the two rep slots.
        r[state.R_COUNT] = min(raw * 10 + k - '0', 100000);
        return;
    }
    if (k == 'q' && r[state.R_OP] == 0 && r[state.R_REC] != 0) {
        I64 name = r[state.R_REC];
        r[state.R_REC] = 0;
        if (typed && r[state.R_REC_N] > 0) { r[state.R_REC_N] -= 1; }
        // Vim drops what it read with the q: an r's K_IGNORE comes in with the next key (get_recorded).
        I64 n = r[state.R_REC_N];
        if (n >= 2 && r[state.R_REC0 + n - 1] == state.K_REC_IGNORE && r[state.R_REC0 + n - 2] != keys.K_ESC) {
            r[state.R_REC_N] = n - 1;
        }
        I64 i = reg.index(name);
        if (name == '"') { i = 0; }
        if (i >= 0) { _ = reg.record(r, add, sp, i, reg.appends(name)); }
        r[state.R_REC_N] = 0;
        clear(r);
        return;
    }
    if (k == 'g' || k == 'f' || k == 'F' || k == 't' || k == 'T' || k == '`' || k == '\'' || k == '"'
        || ((k == 'r' || k == 'q' || k == '@' || k == 'm') && r[state.R_OP] == 0)
        || ((k == 'i' || k == 'a') && r[state.R_OP] != 0)) {
        r[state.R_PREFIX] = k;
        return;
    }
    if (r[state.R_OP] != 0) {
        if (k == op_key(r[state.R_OP])) {
            line_op(r, x, orig, add, sp, u, r[state.R_OP], rep, typed_count);
        } else if (is_motion(k)) { move(r, x, orig, add, sp, u, k, 0, rep, typed_count); }
        else { unbound(r, k); }
        return;
    }
    if (k == 'd' || k == 'c' || k == 'y' || k == '>' || k == '<' || k == '=') {
        r[state.R_OP] = k;
        r[state.R_OPCOUNT] = raw;
        r[state.R_COUNT] = 0;
        return;
    }
    if (is_motion(k)) { move(r, x, orig, add, sp, u, k, 0, rep, raw); return; }
    I64 name = r[state.R_REGNAME];
    clear(r);
    r[state.R_REGNAME] = name;
    if (k == 'i' || k == 'a' || k == 'I' || k == 'A' || k == 'o' || k == 'O' || k == 'R') {
        changes(r, raw, 1);
        mode.enter(r, x, orig, add, sp, u, k, rep);
        r[state.R_REGNAME] = 0;
        return;
    }
    if (k == 'v' || k == 'V' || k == keys.M_CTRL + 'v') {
        r[state.R_REGNAME] = 0;
        visual_begin(r, k);
        return;
    }
    if (k == '.') {
        r[state.R_REGNAME] = 0;
        if (r[state.R_DOT_N] == 0) { r[state.R_BELL] = 1; return; }
        I64 cnt = r[state.R_DOT_COUNT];
        if (raw > 0) { cnt = raw; }
        repeat(r, cnt);
        return;
    }
    if (scroll_key(k)) {
        Bool ok = false;
        if (k == keys.M_CTRL + 'd' || k == keys.M_CTRL + 'u') { ok = scroll.half(r, x, orig, add, k == keys.M_CTRL + 'd', raw); }
        else { ok = scroll.page(r, x, orig, add, k == keys.M_CTRL + 'f', rep); }
        if (!ok) { r[state.R_BELL] = 1; }
        r[state.R_REGNAME] = 0;
        return;
    }
    if (k == 'u' || k == keys.M_CTRL + 'r') {
        for i in 0..rep { if (!undo.apply(r, x, orig, add, sp, u, k != 'u')) { break; } }
    } else if (k == 'p' || k == 'P') { changes(r, raw, 1); put(r, x, orig, add, sp, u, name, k == 'p', rep); }
    else if (k == 'J') { changes(r, raw, 1); op.join(r, x, orig, add, sp, u, rep); }
    else if (k == '~') { changes(r, raw, 1); op.toggle(r, x, orig, add, sp, u, rep); }
    else if (k == 'D' || k == 'C') {
        r[state.R_OP] = 'd';
        if (k == 'C') { r[state.R_OP] = 'c'; }
        move(r, x, orig, add, sp, u, '$', 0, rep, raw);
    } else if (k == 'Y' || k == 'S') {
        I64 l = text.lineof(x, orig, add, r[state.R_CUR]);
        I64 to = min(l + rep - 1, text.nlines(x) - 1);
        I64 cmd = 'y';
        if (k == 'S') { cmd = 'c'; changes(r, raw, 1); }
        I64 saved_cur = r[state.R_CUR];
        op.range(r, x, orig, add, sp, u, cmd, text.lstart(x, orig, add, to), true, false);
        if (k == 'Y') { r[state.R_CUR] = saved_cur; }
    } else if (k == 'x' || k == 'X' || k == 's' || k == keys.K_DELETE) {
        I64 p = r[state.R_CUR];
        I64 q = p;
        for i in 0..rep {
            if (k == 'X') { if (!text.off_start(x, orig, add, q)) { break; } q = text.prevc(x, orig, add, q); }
            else { if (text.ch(x, orig, add, q) == '\n') { break; } q = text.nextc(x, orig, add, q); }
        }
        changes(r, raw, 1);
        if (p != q) {
            I64 cmd = 'd';
            if (k == 's') { cmd = 'c'; }
            op.range(r, x, orig, add, sp, u, cmd, q, false, false);
        } else if (k == 's') { mode.begin(r, 's', rep); }
    } else { unbound(r, k); }
    r[state.R_REGNAME] = 0;
    if (r[state.R_MODE] == state.MODE_NORMAL) { undo.close_step(r); }
}

Bool idle(in I64[_] r) {
    return r[state.R_OP] == 0 && r[state.R_PREFIX] == 0 && r[state.R_COUNT] == 0 && r[state.R_REGNAME] == 0;
}

// One key through the mode it finds; the repeat buffer takes the keys of a change.
void one(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
         inout I64[_] u, I64 k, Bool typed) {
    r[state.R_BELL] = 0;
    r[state.R_MSG] = 0;
    r[state.R_MSG_PRE] = 0;
    r[state.R_FULL] = 0;
    I64 md = r[state.R_MODE];
    I64 prefix_in = r[state.R_PREFIX];
    I64 pend_n = r[state.R_PEND_N];
    I64 dot_n = r[state.R_DOT_N];
    I64 pend_old = 0;
    I64 dot_old = 0;
    I64 slot = -1;
    I64 dslot = -1;
    I64 pcount = r[state.R_DOT_PCOUNT];
    if (md == state.MODE_NORMAL || md == state.MODE_VISUAL) {
        Bool was_idle = idle(r);
        Bool count_digit = r[state.R_PREFIX] == 0 && ((k >= '1' && k <= '9') || (k == '0' && r[state.R_COUNT] != 0));
        I64 at = r[state.R_PEND_N];
        if (was_idle) { at = 0; }
        if (!count_digit && at < state.PEND_MAX) {
            slot = state.R_PEND0 + at;
            pend_old = r[slot];
            r[slot] = k;
            r[state.R_PEND_N] = at + 1;
        } else if (was_idle) { r[state.R_PEND_N] = 0; }
        r[state.R_DOT_CHANGED] = 0;
        if (md == state.MODE_NORMAL) { normal(r, x, orig, add, sp, u, k, typed); }
        else { visual(r, x, orig, add, sp, u, k); }
        if (r[state.R_BELL] != 0 && r[state.R_MSG] == k && prefix_in != 0) { r[state.R_MSG_PRE] = prefix_in; }
        if (r[state.R_BELL] != 0) {
            if (slot >= 0) { r[slot] = pend_old; }
            r[state.R_PEND_N] = pend_n;
            r[state.R_DOT_CHANGED] = 0;
            r[state.R_DOT_PCOUNT] = pcount;
        } else if (r[state.R_DOT_CHANGED] != 0 && r[state.R_PEND_N] < state.PEND_MAX) {
            I64 n = 0;
            if (r[state.R_DOT_CHANGED] == 2) { r[state.R_DOT0] = state.K_REDO_VISUAL; n = 1; }
            for j in 0..r[state.R_PEND_N] { r[state.R_DOT0 + n + j] = r[state.R_PEND0 + j]; }
            r[state.R_DOT_N] = n + r[state.R_PEND_N];
            r[state.R_DOT_COUNT] = r[state.R_DOT_PCOUNT];
            r[state.R_DOT_OPEN] = 0;
            r[state.R_DOT_ARROW] = 0;
            if (r[state.R_MODE] == state.MODE_INSERT || r[state.R_MODE] == state.MODE_REPLACE) { r[state.R_DOT_OPEN] = 1; }
            r[state.R_DOT_CHANGED] = 0;
        }
        if (r[state.R_MODE] != state.MODE_VISUAL) { r[state.R_RV_BUSY] = 0; }
    } else {
        Bool esc = k == keys.K_ESC || k == keys.M_CTRL + '[';
        Bool arrow = k == keys.K_LEFT || k == keys.K_RIGHT || k == keys.K_UP || k == keys.K_DOWN || k == keys.K_HOME
            || k == keys.K_END;
        I64 before = r[state.R_CUR];
        I64 dot0 = r[state.R_DOT0];
        I64 dcount = r[state.R_DOT_COUNT];
        I64 darrow = r[state.R_DOT_ARROW];
        if (r[state.R_DOT_OPEN] != 0 && !arrow) {
            if (r[state.R_DOT_ARROW] != 0) {
                // Vim's stop_arrow: typing after an arrow key starts the repeat again as "1i".
                r[state.R_DOT0] = 'i';
                r[state.R_DOT_N] = 1;
                r[state.R_DOT_COUNT] = 1;
                r[state.R_DOT_ARROW] = 0;
            }
            if (r[state.R_DOT_N] < state.DOT_MAX) {
                dslot = state.R_DOT0 + r[state.R_DOT_N];
                dot_old = r[dslot];
                r[dslot] = k;
                r[state.R_DOT_N] += 1;
            }
        }
        mode.step(r, x, orig, add, sp, u, k);
        if (r[state.R_BELL] != 0) {
            if (dslot >= 0) { r[dslot] = dot_old; }
            r[state.R_DOT_N] = dot_n;
            r[state.R_DOT0] = dot0;
            r[state.R_DOT_COUNT] = dcount;
            r[state.R_DOT_ARROW] = darrow;
        } else if (arrow && r[state.R_CUR] != before && r[state.R_DOT_OPEN] != 0) {
            r[state.R_DOT_ARROW] = 1;
        }
        if (esc && r[state.R_MODE] == state.MODE_NORMAL) {
            r[state.R_DOT_OPEN] = 0;
            r[state.R_DOT_ARROW] = 0;
            if (r[state.R_BI_CMD] != 0) { blk.finish(r, x, orig, add, sp, u); undo.close_step(r); }
        }
    }
    scroll.follow(r, x, orig, add);
}

export void step(inout I64[_] r, inout I64[_] x, in U8[_] orig, inout U8[_] add, inout I64[_] sp,
                 inout I64[_] u, I64 k) {
    I64 rec_slot = -1;
    I64 rec_old = 0;
    if (r[state.R_REC] != 0 && r[state.R_REC_N] < state.REC_MAX) {
        rec_slot = state.R_REC0 + r[state.R_REC_N];
        rec_old = r[rec_slot];
        r[rec_slot] = k;
        r[state.R_REC_N] += 1;
    }
    I64 mode0 = r[state.R_MODE];
    I64 prefix0 = r[state.R_PREFIX];
    one(r, x, orig, add, sp, u, k, true);
    if (r[state.R_REC] != 0 && r[state.R_REC_N] < state.REC_MAX && r[state.R_FULL] == 0) {
        Bool from_insert = (mode0 == state.MODE_INSERT || mode0 == state.MODE_REPLACE) && r[state.R_MODE] == state.MODE_NORMAL;
        Bool after_r = mode0 == state.MODE_NORMAL && prefix0 == 'r' && k != keys.K_ESC;
        if (from_insert || after_r) {
            r[state.R_REC0 + r[state.R_REC_N]] = state.K_REC_IGNORE;
            r[state.R_REC_N] += 1;
        }
    }
    I64 bell = r[state.R_BELL];
    I64 msg = r[state.R_MSG];
    I64 msg_pre = r[state.R_MSG_PRE];
    I64 full = r[state.R_FULL];
    if (full != 0 && rec_slot >= 0 && r[state.R_REC] != 0) {
        r[rec_slot] = rec_old;
        r[state.R_REC_N] -= 1;
    }
    if (bell != 0) { r[state.R_TA_N] = 0; }
    I64 work = 0;
    // A register run is one undo step, as Vim keeps the changes of the keys it runs together.
    I64 at0 = r[state.R_U_AT];
    I64 low = at0;
    if (r[state.R_U_OPEN] != 0) { at0 = -1; }
    while (r[state.R_TA_N] > 0) {
        if (work >= state.WORK_MAX) { r[state.R_TA_N] = 0; bell = 1; break; }
        work += 1;
        r[state.R_TA_N] -= 1;
        I64 kk = r[state.R_TA0 + r[state.R_TA_N]];
        one(r, x, orig, add, sp, u, kk, false);
        if (r[state.R_BELL] != 0) {
            r[state.R_TA_N] = 0;
            if (bell == 0) { msg = r[state.R_MSG]; msg_pre = r[state.R_MSG_PRE]; }
            bell = 1;
        }
        if (r[state.R_FULL] != 0) { full = 1; }
        low = min(low, r[state.R_U_AT]);
    }
    if (at0 >= 0 && low >= at0 && r[state.R_U_AT] - at0 >= 2 && r[state.R_U_OPEN] == 0) { undo.merge(r, u, at0); }
    r[state.R_BELL] = bell;
    r[state.R_MSG] = msg;
    r[state.R_MSG_PRE] = msg_pre;
    r[state.R_FULL] = full;
}
