// user/ci/cvim/test_pat.ci: pat.ci's matches against what Vim 9.1 finds for the same pattern and line (CV-4b):
// the leftmost match, the alternative Vim's engine prefers, groups, multis, classes, anchors, case.
import user.ci.cvim.pat;

// p against s from code point 0: the match's [start, end) (code points) or -1, -1; group g's when g > 0.
I64 at(inout I64[_] pt, in U8[_] p, in U8[_] s, Bool ic, I64 g, Bool want_end) {
    assert(pat.compile(pt, p, ic, true, 0) == pat.OK);
    assert(pat.load_line(pt, s));
    if (!pat.exec(pt, 0)) { return -1; }
    if (want_end) { return pt[pat.CAP + 2 * g + 1]; }
    return pt[pat.CAP + 2 * g];
}

Bool span(inout I64[_] pt, in U8[_] p, in U8[_] s, I64 a, I64 b) {
    return at(pt, p, s, false, 0, false) == a && at(pt, p, s, false, 0, true) == b;
}

test "literals, the leftmost match, and . on a whole code point" {
    I64[368640] pt;
    assert(span(pt, b"b", b"abcb", 1, 2));
    assert(span(pt, b"zz", b"abc", -1, -1) || at(pt, b"zz", b"abc", false, 0, false) == -1);
    assert(span(pt, b"a.c", b"xa\xc3\xa9c", 1, 4));   // . takes the two bytes of U+00E9 as one
}

test "greedy and lazy multis prefer what Vim prefers" {
    I64[368640] pt;
    assert(span(pt, b"a*", b"baaa", 0, 0));            // the empty match at 0 is leftmost
    assert(span(pt, b"a\\+", b"baaa", 1, 4));
    assert(span(pt, b"a\\\x7b-1,\x7d", b"baaa", 1, 2));
    assert(span(pt, b"a\\\x7b2\x7d", b"baaa", 1, 3));
    assert(span(pt, b"a\\\x7b,2\x7db", b"aaab", 1, 4));
    assert(span(pt, b"x\\=y", b"zy", 1, 2));
    assert(span(pt, b"a\\?b", b"ab", 0, 2));
    assert(span(pt, b"ab\\|abc", b"abc", 0, 2));       // the first alternative that matches, not the longest
}

test "groups for the replacement, and \\%( \\) takes none" {
    I64[368640] pt;
    assert(at(pt, b"\\(a\\)\\(b\\)", b"xab", false, 1, false) == 1);
    assert(at(pt, b"\\(a\\)\\(b\\)", b"xab", false, 2, true) == 3);
    assert(at(pt, b"\\%(a\\)\\(b\\)", b"xab", false, 1, false) == 2);
    assert(pat.compile(pt, b"\\(a", false, true, 0) == pat.E_PAREN_OPEN);
    assert(pat.compile(pt, b"a\\)", false, true, 0) == pat.E_PAREN_CLOSE);
}

test "anchors, word edges, classes and named classes" {
    I64[368640] pt;
    assert(span(pt, b"^a", b"aa", 0, 1));
    assert(span(pt, b"a$", b"aa", 1, 2));
    assert(span(pt, b"a$b", b"a$b", 0, 3));            // $ not at the end is itself
    assert(span(pt, b"\\<on", b"don on", 4, 6));
    assert(span(pt, b"on\\>", b"one on", 4, 6));
    assert(span(pt, b"[0-9]\\+", b"ab123c", 2, 5));
    assert(span(pt, b"[^a-c]", b"abcd", 3, 4));
    assert(span(pt, b"[]x]", b"a]", 1, 2));
    assert(span(pt, b"[[:digit:]]", b"x7", 1, 2));
    assert(span(pt, b"\\d\\+", b"v12", 1, 3));
    assert(span(pt, b"\\s", b"a b", 1, 2));
    assert(span(pt, b"\\w\\+", b"  ab_1 ", 2, 6));
    assert(span(pt, b"[abc", b"x[abc", 1, 5));          // no closing ]: the [ is itself
    assert(span(pt, b"*a", b"x*a", 1, 3));              // * first is itself
}

test "ignorecase with smartcase, the i and I flags, \\c and \\C" {
    I64[368640] pt;
    assert(at(pt, b"abc", b"xABC", true, 0, false) == 1);
    assert(at(pt, b"Abc", b"xABC", true, 0, false) == -1);   // an upper-case letter: case matters
    assert(pat.compile(pt, b"Abc", true, true, 1) == pat.OK);
    assert(pat.load_line(pt, b"xabc") && pat.exec(pt, 0));
    assert(pat.compile(pt, b"abc", true, true, 2) == pat.OK);
    assert(pat.load_line(pt, b"ABC") && !pat.exec(pt, 0));
    assert(at(pt, b"\\Cabc", b"ABC", true, 0, false) == -1);
    assert(at(pt, b"a\\cBC", b"Abc", false, 0, false) == 0);
}

test "refusals by name" {
    I64[368640] pt;
    assert(pat.compile(pt, b"a\\nb", false, true, 0) == pat.E_NOT_CVIM);
    assert(pat.compile(pt, b"\\va", false, true, 0) == pat.E_NOT_CVIM);
    assert(pat.compile(pt, b"\\+a", false, true, 0) == pat.E_NOTHING);
    assert(pat.compile(pt, b"a**", false, true, 0) == pat.E_NESTED);
    pat.set_tilde(pt, b"", false);
    assert(pat.compile(pt, b"~", false, true, 0) == pat.E_TILDE);
    pat.set_tilde(pt, b"xy", true);
    assert(span(pt, b"a~", b"zaxy", 1, 4));
}
