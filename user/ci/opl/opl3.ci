// user/ci/opl/opl3.ci: a Yamaha YMF262 (OPL3) in cint, ported from ymfm's ymf262 (Aaron Giles, BSD-3-Clause; the
// notice is user/ci/opl/NOTICE), integer throughout as the chip is (docs/specs/2026-11-06-au-audio.md section 4a).
// One chip, in module state. opl_reset() first; opl_write(port, data) is the bus (ports 0 and 2 take an address,
// 1 and 3 data); opl_sample(o) clocks the chip once and writes its four outputs A, B, C, D, each clamped to 16 bits,
// to o[0..4]. The rate is the chip's, clock / 288: 49,715.9 Hz from 14,318,180 Hz.
//
// The port keeps ymfm's structure and order: an engine clock prepares the operators when a register changed or
// after 4,096 quiet samples (cache, key state, active channels), then steps the envelope counter, the noise and
// the two LFOs, then every operator's envelope and phase; the output sums the active channels. ymfm's unsigned
// widths are kept by masks where a value can wrap: the phase (32 bits), the envelope counter (32 bits), the noise
// register (32 bits) and the LFO counters (16 bits). Timers and status do not reach the output and are not ported.

// ymfm's abs_sin_attenuation table: the log-sine of a quarter wave, 4.8 fixed point, as extracted from the die.
I64[256] SIN = [
    0x859, 0x6c3, 0x607, 0x58b, 0x52e, 0x4e4, 0x4a6, 0x471, 0x443, 0x41a, 0x3f5, 0x3d3, 0x3b5, 0x398, 0x37e, 0x365,
    0x34e, 0x339, 0x324, 0x311, 0x2ff, 0x2ed, 0x2dc, 0x2cd, 0x2bd, 0x2af, 0x2a0, 0x293, 0x286, 0x279, 0x26d, 0x261,
    0x256, 0x24b, 0x240, 0x236, 0x22c, 0x222, 0x218, 0x20f, 0x206, 0x1fd, 0x1f5, 0x1ec, 0x1e4, 0x1dc, 0x1d4, 0x1cd,
    0x1c5, 0x1be, 0x1b7, 0x1b0, 0x1a9, 0x1a2, 0x19b, 0x195, 0x18f, 0x188, 0x182, 0x17c, 0x177, 0x171, 0x16b, 0x166,
    0x160, 0x15b, 0x155, 0x150, 0x14b, 0x146, 0x141, 0x13c, 0x137, 0x133, 0x12e, 0x129, 0x125, 0x121, 0x11c, 0x118,
    0x114, 0x10f, 0x10b, 0x107, 0x103, 0x0ff, 0x0fb, 0x0f8, 0x0f4, 0x0f0, 0x0ec, 0x0e9, 0x0e5, 0x0e2, 0x0de, 0x0db,
    0x0d7, 0x0d4, 0x0d1, 0x0cd, 0x0ca, 0x0c7, 0x0c4, 0x0c1, 0x0be, 0x0bb, 0x0b8, 0x0b5, 0x0b2, 0x0af, 0x0ac, 0x0a9,
    0x0a7, 0x0a4, 0x0a1, 0x09f, 0x09c, 0x099, 0x097, 0x094, 0x092, 0x08f, 0x08d, 0x08a, 0x088, 0x086, 0x083, 0x081,
    0x07f, 0x07d, 0x07a, 0x078, 0x076, 0x074, 0x072, 0x070, 0x06e, 0x06c, 0x06a, 0x068, 0x066, 0x064, 0x062, 0x060,
    0x05e, 0x05c, 0x05b, 0x059, 0x057, 0x055, 0x053, 0x052, 0x050, 0x04e, 0x04d, 0x04b, 0x04a, 0x048, 0x046, 0x045,
    0x043, 0x042, 0x040, 0x03f, 0x03e, 0x03c, 0x03b, 0x039, 0x038, 0x037, 0x035, 0x034, 0x033, 0x031, 0x030, 0x02f,
    0x02e, 0x02d, 0x02b, 0x02a, 0x029, 0x028, 0x027, 0x026, 0x025, 0x024, 0x023, 0x022, 0x021, 0x020, 0x01f, 0x01e,
    0x01d, 0x01c, 0x01b, 0x01a, 0x019, 0x018, 0x017, 0x017, 0x016, 0x015, 0x014, 0x014, 0x013, 0x012, 0x011, 0x011,
    0x010, 0x00f, 0x00f, 0x00e, 0x00d, 0x00d, 0x00c, 0x00c, 0x00b, 0x00a, 0x00a, 0x009, 0x009, 0x008, 0x008, 0x007,
    0x007, 0x007, 0x006, 0x006, 0x005, 0x005, 0x005, 0x004, 0x004, 0x004, 0x003, 0x003, 0x003, 0x002, 0x002, 0x002,
    0x002, 0x001, 0x001, 0x001, 0x001, 0x001, 0x001, 0x001, 0x000, 0x000, 0x000, 0x000, 0x000, 0x000, 0x000, 0x000
];

// ymfm's attenuation_to_volume mantissas, in its order (reversed, so the input needs no NOT); POW holds
// (m | 0x400) << 2, the leading bit put in and shifted so that one right shift gives the 13-bit volume.
I64[256] POW_M = [
    0x3fa, 0x3f5, 0x3ef, 0x3ea, 0x3e4, 0x3df, 0x3da, 0x3d4, 0x3cf, 0x3c9, 0x3c4, 0x3bf, 0x3b9, 0x3b4, 0x3ae, 0x3a9,
    0x3a4, 0x39f, 0x399, 0x394, 0x38f, 0x38a, 0x384, 0x37f, 0x37a, 0x375, 0x370, 0x36a, 0x365, 0x360, 0x35b, 0x356,
    0x351, 0x34c, 0x347, 0x342, 0x33d, 0x338, 0x333, 0x32e, 0x329, 0x324, 0x31f, 0x31a, 0x315, 0x310, 0x30b, 0x306,
    0x302, 0x2fd, 0x2f8, 0x2f3, 0x2ee, 0x2e9, 0x2e5, 0x2e0, 0x2db, 0x2d6, 0x2d2, 0x2cd, 0x2c8, 0x2c4, 0x2bf, 0x2ba,
    0x2b5, 0x2b1, 0x2ac, 0x2a8, 0x2a3, 0x29e, 0x29a, 0x295, 0x291, 0x28c, 0x288, 0x283, 0x27f, 0x27a, 0x276, 0x271,
    0x26d, 0x268, 0x264, 0x25f, 0x25b, 0x257, 0x252, 0x24e, 0x249, 0x245, 0x241, 0x23c, 0x238, 0x234, 0x230, 0x22b,
    0x227, 0x223, 0x21e, 0x21a, 0x216, 0x212, 0x20e, 0x209, 0x205, 0x201, 0x1fd, 0x1f9, 0x1f5, 0x1f0, 0x1ec, 0x1e8,
    0x1e4, 0x1e0, 0x1dc, 0x1d8, 0x1d4, 0x1d0, 0x1cc, 0x1c8, 0x1c4, 0x1c0, 0x1bc, 0x1b8, 0x1b4, 0x1b0, 0x1ac, 0x1a8,
    0x1a4, 0x1a0, 0x19c, 0x199, 0x195, 0x191, 0x18d, 0x189, 0x185, 0x181, 0x17e, 0x17a, 0x176, 0x172, 0x16f, 0x16b,
    0x167, 0x163, 0x160, 0x15c, 0x158, 0x154, 0x151, 0x14d, 0x149, 0x146, 0x142, 0x13e, 0x13b, 0x137, 0x134, 0x130,
    0x12c, 0x129, 0x125, 0x122, 0x11e, 0x11b, 0x117, 0x114, 0x110, 0x10c, 0x109, 0x106, 0x102, 0x0ff, 0x0fb, 0x0f8,
    0x0f4, 0x0f1, 0x0ed, 0x0ea, 0x0e7, 0x0e3, 0x0e0, 0x0dc, 0x0d9, 0x0d6, 0x0d2, 0x0cf, 0x0cc, 0x0c8, 0x0c5, 0x0c2,
    0x0be, 0x0bb, 0x0b8, 0x0b5, 0x0b1, 0x0ae, 0x0ab, 0x0a8, 0x0a4, 0x0a1, 0x09e, 0x09b, 0x098, 0x094, 0x091, 0x08e,
    0x08b, 0x088, 0x085, 0x082, 0x07e, 0x07b, 0x078, 0x075, 0x072, 0x06f, 0x06c, 0x069, 0x066, 0x063, 0x060, 0x05d,
    0x05a, 0x057, 0x054, 0x051, 0x04e, 0x04b, 0x048, 0x045, 0x042, 0x03f, 0x03c, 0x039, 0x036, 0x033, 0x030, 0x02d,
    0x02a, 0x028, 0x025, 0x022, 0x01f, 0x01c, 0x019, 0x016, 0x014, 0x011, 0x00e, 0x00b, 0x008, 0x006, 0x003, 0x000
];

// ymfm's attenuation_increment table: eight 4-bit increments a rate, one for each step of the counter.
I64[64] INC = [
    0x00000000, 0x00000000, 0x10101010, 0x10101010,
    0x10101010, 0x10101010, 0x11101110, 0x11101110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x10101010, 0x10111010, 0x11101110, 0x11111110,
    0x11111111, 0x21112111, 0x21212121, 0x22212221,
    0x22222222, 0x42224222, 0x42424242, 0x44424442,
    0x44444444, 0x84448444, 0x84848484, 0x88848884,
    0x88888888, 0x88888888, 0x88888888, 0x88888888
];

// ymfm's opl_key_scale_atten: the top 4 bits of FNUM at block 7, in 0.75 dB units.
I64[16] KSL = [0, 24, 32, 37, 40, 43, 45, 47, 48, 50, 51, 52, 53, 54, 55, 56];

// The PM LFO's eight steps, as a 1.3 fraction and sign.
I64[8] PMS = [8, 4, 0, -4, -8, -4, 0, 4];

// ymfm's s_algorithm_ops for algorithms 8 to 11 (OPL3's four-operator connections, ALGORITHM(op2in, op3in, op4in,
// op1out, op2out, op3out)): bit 0 the input of operator 2, bits 1-3 of operator 3, bits 4-6 of operator 4, bits
// 7-9 which of operators 1-3 join the sum.
I64[4] ALG4 = [
    1 | (2 << 1) | (3 << 4),                 //  8: O1 -> O2 -> O3 -> O4 -> out (O4)
    0 | (2 << 1) | (3 << 4) | (1 << 7),      //  9: (O1 + (O2 -> O3 -> O4)) -> out (O1+O4)
    1 | (0 << 1) | (3 << 4) | (1 << 8),      // 10: ((O1 -> O2) + (O3 -> O4)) -> out (O2+O4)
    0 | (2 << 1) | (0 << 4) | (1 << 7) | (1 << 9)   // 11: (O1 + (O2 -> O3) + O4) -> out (O1+O3+O4)
];

export const I64 CHANNELS = 18;
export const I64 OPERATORS = 36;
export const I64 OUTPUTS = 4;
export const I64 CLOCK = 14318180;     // Hz, the YMF262's crystal on a sound card
export const I64 DIVIDER = 288;        // clocks a sample: 36 operators x prescale 8

const I64 ALL = 262143;                // (1 << 18) - 1
const I64 QUIET = 896;                 // 0x380: ymfm's EG_QUIET
const I64 ATTACK = 1;
const I64 DECAY = 2;
const I64 SUSTAIN = 3;
const I64 RELEASE = 4;
const I64 DYNAMIC = 1;                 // ymfm's PHASE_STEP_DYNAMIC: the step is computed each sample (PM on)
const I64 M32 = 4294967295;    // ymfm's uint32_t

I64[256] POW;
I64[8192] wave;        // eight waveforms of 1,024 entries: attenuation 4.8, bit 15 the sign
I64[512] reg;          // the register file; 0x100 to 0x1ff is the second bank
I64 address = 0;
I64 env_counter = 0;
I64 modified = 0;      // channels written since the last prepare
I64 prepare_count = 0;
I64 active = 0;        // channels sounding as of the last prepare
I64 am_counter = 0;
I64 pm_counter = 0;
I64 lfsr = 1;
I64 lfo_am = 0;

// operators, by number 0 to 35
I64[36] op_offs;       // register offset (ymfm's operator_offset)
I64[36] op_chan;       // register offset of the channel it is assigned to
I64[36] op_phase;      // 10.10, 32 bits
I64[36] op_att;        // envelope attenuation, 4.6, 0 to 0x3ff
I64[36] op_state;      // ATTACK, DECAY, SUSTAIN or RELEASE
I64[36] op_key;        // the key state the envelope saw
I64[36] op_live;       // bit 0 a normal key on, bit 1 a rhythm key on
I64[36] op_wf;         // cache: offset of the waveform in wave
I64[36] op_step;       // cache: phase step, or DYNAMIC
I64[36] op_tl;         // cache: total level x 8 plus key scale
I64[36] op_bf;         // cache: block and FNUM of the channel
I64[36] op_mult;       // cache: multiple, x.1
I64[36] op_sus;        // cache: sustain level, 5 bits << 5
I64[180] op_rate;      // cache: the 6-bit rate of each envelope state, op * 5 + state

// channels, by number 0 to 17
I64[18] ch_offs;       // register offset (ymfm's channel_offset)
I64[18] ch_fb0;
I64[18] ch_fb1;
I64[18] ch_fbin;
I64[72] ch_op;         // the operators of each channel, ch * 4 + slot, -1 for none

// ---- tables and reset ----

I64 abs_sin(I64 i) {
    if ((i & 256) != 0) { return SIN[255 - (i & 255)]; }
    return SIN[i & 255];
}

// The constructor and reset() of ymf262: the waveforms, the operator and channel map, every register 0, then the
// mode register written 0 (its timer effects do not reach the output).
export void opl_reset() {
    for i in 0..1024 {
        wave[i] = abs_sin(i) | (((i >> 9) & 1) << 15);
    }
    I64 zero = wave[0];
    for i in 0..1024 {
        Bool b9 = (i & 512) != 0;
        wave[1024 + i] = b9 ? zero : wave[i];
        wave[2048 + i] = wave[i] & 32767;
        wave[3072 + i] = (i & 256) != 0 ? zero : (wave[i] & 32767);
        wave[4096 + i] = b9 ? zero : wave[(i * 2) & 1023];
        wave[5120 + i] = b9 ? zero : wave[(i * 2) & 511];
        wave[6144 + i] = ((i >> 9) & 1) << 15;
        wave[7168 + i] = ((b9 ? (i ^ 5119) : i) << 3) & 65535;
    }
    for i in 0..256 { POW[i] = (POW_M[i] | 1024) << 2; }
    for i in 0..512 { reg[i] = 0; }
    for op in 0..36 {
        I64 o = op % 18;
        op_offs[op] = o + 2 * (o / 6) + 256 * (op / 18);
        op_chan[op] = 0;
        op_phase[op] = 0;
        op_att[op] = 1023;
        op_state[op] = RELEASE;
        op_key[op] = 0;
        op_live[op] = 0;
    }
    for ch in 0..18 {
        ch_offs[ch] = (ch % 9) + 256 * (ch / 9);
        ch_fb0[ch] = 0;
        ch_fb1[ch] = 0;
        ch_fbin[ch] = 0;
    }
    assign_operators();
    address = 0;
    env_counter = 0;
    prepare_count = 0;
    active = ALL;
    am_counter = 0;
    pm_counter = 0;
    lfsr = 1;
    lfo_am = 0;
    modified = ALL;
}

// ---- the bus ----

export void opl_write(I64 port, I64 data) {
    I64 p = port & 3;
    if (p == 0) {
        address = data;
    } else if (p == 2) {
        address = data | 256;
        if ((reg[261] & 1) == 0 && address != 261) { address = address & 255; }
    } else {
        write_reg(address, data);
    }
}

// A write through both ports: the address (port 0, or 2 from 0x100), then the data.
export void opl_reg(I64 r, I64 data) {
    if (r >= 256) {
        opl_write(2, r & 255);
        opl_write(3, data);
    } else {
        opl_write(0, r);
        opl_write(1, data);
    }
}

void write_reg(I64 index, I64 data) {
    modified = ALL;
    if (index == 4) {
        if ((data & 128) != 0) { reg[4] = reg[4] | 128; } else { reg[4] = data; }
        return;
    }
    reg[index] = data;
    if (index == 189) {   // 0xbd: the rhythm key ons
        I64 m = (data & 32) != 0 ? (data & 31) : 0;
        keyonoff(6, (m & 16) != 0 ? 3 : 0, 1);
        keyonoff(7, (m & 1) | (((m >> 3) & 1) << 1), 1);
        keyonoff(8, ((m >> 2) & 1) | (((m >> 1) & 1) << 1), 1);
        return;
    }
    if ((index & 240) == 176) {   // 0xb0 to 0xb8, and 0x1b0 to 0x1b8: the channel key ons
        I64 c = index & 15;
        if (c < 9) {
            c = c + 9 * ((index >> 8) & 1);
            keyonoff(c, (data & 32) != 0 ? 15 : 0, 0);
        }
    }
}

void keyonoff(I64 ch, I64 states, I64 kind) {
    for slot in 0..4 {
        I64 op = ch_op[ch * 4 + slot];
        if (op >= 0) {
            I64 on = (states >> slot) & 1;
            op_live[op] = (op_live[op] & (7 ^ (1 << kind))) | (on << kind);
        }
    }
}

// ---- operator assignment (ymfm's operator_map for OPL3) ----

void assign(I64 ch, I64 a, I64 b, I64 c, I64 d) {
    ch_op[ch * 4] = a;
    ch_op[ch * 4 + 1] = b;
    ch_op[ch * 4 + 2] = c;
    ch_op[ch * 4 + 3] = d;
    for slot in 0..4 {
        I64 op = ch_op[ch * 4 + slot];
        if (op >= 0) { op_chan[op] = ch_offs[ch]; }
    }
}

void assign_operators() {
    I64 fourop = reg[260] & 63;
    for p in 0..6 {
        I64 ch = p < 3 ? p : p + 6;
        I64 o = p < 3 ? p : p + 15;
        if (((fourop >> p) & 1) != 0) {
            assign(ch, o, o + 3, o + 6, o + 9);
            assign(ch + 3, -1, -1, -1, -1);
        } else {
            assign(ch, o, o + 3, -1, -1);
            assign(ch + 3, o + 6, o + 9, -1, -1);
        }
    }
    assign(6, 12, 15, -1, -1);
    assign(7, 13, 16, -1, -1);
    assign(8, 14, 17, -1, -1);
    assign(15, 30, 33, -1, -1);
    assign(16, 31, 34, -1, -1);
    assign(17, 32, 35, -1, -1);
}

// ---- the operator cache (ymfm's cache_operator_data for OPL) ----

I64 rate_of(I64 raw, I64 ksr) {
    if (raw == 0) { return 0; }
    if (raw + ksr > 63) { return 63; }
    return raw + ksr;
}

I64 phase_step(I64 bf, I64 mult, I64 pm) {
    I64 fnum = (bf & 1023) << 2;
    fnum = fnum + ((pm * ((bf >> 7) & 7)) >> 1);
    fnum = fnum & 4095;
    I64 step = (fnum << ((bf >> 10) & 7)) >> 2;
    return (step * mult) >> 1;
}

void cache(I64 op) {
    I64 c = op_chan[op];
    I64 o = op_offs[op];
    I64 newflag = reg[261] & 1;
    I64 r20 = reg[32 + o];
    I64 r40 = reg[64 + o];
    op_wf[op] = (reg[224 + o] & (newflag != 0 ? 7 : 3)) * 1024;
    I64 bf = ((reg[176 + c] & 31) << 8) | reg[160 + c];
    op_bf[op] = bf;
    I64 keycode = ((bf >> 10) & 7) << 1;
    keycode = keycode | ((bf >> (9 - ((reg[8] >> 6) & 1))) & 1);
    I64 m = r20 & 15;
    I64 mult = ((m & 14) | ((0xc2aa >> m) & 1)) * 2;   // 0.5, 1, 2, ..., 10, 10, 12, 12, 15, 15, as x.1
    if (mult == 0) { mult = 1; }
    op_mult[op] = mult;
    if ((r20 & 64) == 0) { op_step[op] = phase_step(bf, mult, 0); } else { op_step[op] = DYNAMIC; }
    I64 tl = (r40 & 63) << 3;
    I64 k = (r40 >> 6) & 3;
    I64 ksl = ((k >> 1) & 1) | ((k & 1) << 1);
    if (ksl != 0) {
        I64 a = KSL[(bf >> 6) & 15] - 8 * (((bf >> 10) & 7) ^ 7);
        if (a < 0) { a = 0; }
        tl = tl + (a << ksl);
    }
    op_tl[op] = tl;
    I64 sl = (reg[128 + o] >> 4) & 15;
    sl = sl | ((sl + 1) & 16);
    op_sus[op] = sl << 5;
    I64 ksrval = keycode >> (2 * (((r20 >> 4) & 1) ^ 1));
    I64 rr = rate_of((reg[128 + o] & 15) * 4, ksrval);
    op_rate[op * 5 + ATTACK] = rate_of(((reg[96 + o] >> 4) & 15) * 4, ksrval);
    op_rate[op * 5 + DECAY] = rate_of((reg[96 + o] & 15) * 4, ksrval);
    op_rate[op * 5 + SUSTAIN] = (r20 & 32) != 0 ? 0 : rr;
    op_rate[op * 5 + RELEASE] = rr;
}

// ---- the envelope and phase ----

void start_attack(I64 op) {
    if (op_state[op] == ATTACK) { return; }
    op_state[op] = ATTACK;
    op_phase[op] = 0;
    if (op_rate[op * 5 + ATTACK] >= 62) { op_att[op] = 0; }
}

// ymfm's fm_operator::prepare: the cache, then the key state; true while the operator sounds.
Bool prepare(I64 op) {
    cache(op);
    I64 ks = op_live[op] != 0 ? 1 : 0;
    if (ks != op_key[op]) {
        op_key[op] = ks;
        if (ks != 0) {
            start_attack(op);
        } else if (op_state[op] < RELEASE) {
            op_state[op] = RELEASE;
        }
    }
    op_live[op] = op_live[op] & 3;
    return op_state[op] != RELEASE || op_att[op] < QUIET;
}

void clock_envelope(I64 op, I64 counter) {
    I64 st = op_state[op];
    I64 att = op_att[op];
    if (st == ATTACK && att == 0) { st = DECAY; }
    if (st == DECAY && att >= op_sus[op]) { st = SUSTAIN; }
    op_state[op] = st;
    I64 rate = op_rate[op * 5 + st];
    I64 shift = rate >> 2;
    I64 c = counter << shift;
    if ((c & 2047) != 0) { return; }
    I64 at = shift <= 11 ? 11 : shift;
    I64 inc = (INC[rate] >> (4 * ((c >> at) & 7))) & 15;
    if (st == ATTACK) {
        if (rate < 62) { op_att[op] = att + ((-(att + 1) * inc) >> 4); }
    } else {
        att = att + inc;
        if (att >= 1024) { att = 1023; }
        op_att[op] = att;
    }
}

void clock_op(I64 op, I64 counter, I64 pm) {
    clock_envelope(op, counter);
    I64 step = op_step[op];
    if (step == DYNAMIC) {
        I64 p = (reg[32 + op_offs[op]] & 64) != 0 ? pm : 0;
        step = phase_step(op_bf[op], op_mult[op], p);
    }
    op_phase[op] = (op_phase[op] + step) & M32;
}

// ---- the engine clock ----

I64 clock_noise_and_lfo() {
    lfsr = (lfsr << 1) & M32;
    lfsr = lfsr | (((lfsr >> 23) ^ (lfsr >> 9) ^ (lfsr >> 8) ^ (lfsr >> 1)) & 1);
    I64 am = am_counter;
    am_counter = (am_counter + 1) & 65535;
    if (am >= 13439) { am_counter = 0; }
    I64 shift = 9 - 2 * ((reg[189] >> 7) & 1);
    I64 tri = am < 6720 ? am : 13503 - am;
    lfo_am = (tri >> shift) & 255;
    I64 pmc = pm_counter;
    pm_counter = (pm_counter + 1) & 65535;
    return PMS[(pmc >> 10) & 7] >> (((reg[189] >> 6) & 1) ^ 1);
}

void clock() {
    Bool prep = modified != 0;
    if (!prep) {
        prep = prepare_count >= 4096;
        prepare_count = prepare_count + 1;
    }
    if (prep) {
        assign_operators();
        active = 0;
        for ch in 0..18 {
            Bool on = false;
            for slot in 0..4 {
                I64 op = ch_op[ch * 4 + slot];
                if (op >= 0) {
                    if (prepare(op)) { on = true; }
                }
            }
            if (on) { active = active | (1 << ch); }
        }
        modified = 0;
        prepare_count = 0;
    }
    env_counter = (env_counter + 4) & M32;
    I64 pm = clock_noise_and_lfo();
    I64 counter = env_counter >> 2;
    for ch in 0..18 {
        ch_fb0[ch] = ch_fb1[ch];
        ch_fb1[ch] = ch_fbin[ch];
        for slot in 0..4 {
            I64 op = ch_op[ch * 4 + slot];
            if (op >= 0) { clock_op(op, counter, pm); }
        }
    }
}

// ---- the output ----

// ymfm's compute_volume: the 14-bit signed output of op at phase ph (the low 10 bits), with AM offset am.
I64 vol(I64 op, I64 ph, I64 am) {
    I64 att = op_att[op];
    if (att > QUIET) { return 0; }
    I64 s = wave[op_wf[op] + (ph & 1023)];
    I64 e = att;
    if ((reg[32 + op_offs[op]] & 128) != 0) { e = e + am; }
    e = e + op_tl[op];
    if (e > 1023) { e = 1023; }
    I64 x = (s & 32767) + (e << 2);
    I64 v = POW[x & 255] >> (x >> 8);
    if ((s & 32768) != 0) { return -v; }
    return v;
}

I64 phase(I64 op) {
    return op_phase[op] >> 10;
}

I64 clip(I64 v) {
    if (v < -32768) { return -32768; }
    if (v > 32767) { return 32767; }
    return v;
}

void mix(I64 c, inout I64[_] o, I64 v) {
    I64 r = reg[192 + c];
    if ((reg[261] & 1) == 0) {
        o[0] = o[0] + v;
        o[1] = o[1] + v;
        return;
    }
    if ((r & 16) != 0) { o[0] = o[0] + v; }
    if ((r & 32) != 0) { o[1] = o[1] + v; }
    if ((r & 64) != 0) { o[2] = o[2] + v; }
    if ((r & 128) != 0) { o[3] = o[3] + v; }
}

// Operator 1 with its self-feedback; stores the feedback input of the channel.
I64 op1(I64 ch, I64 c, I64 op, I64 am) {
    I64 mod = 0;
    I64 fb = (reg[192 + c] >> 1) & 7;
    if (fb != 0) { mod = (ch_fb0[ch] + ch_fb1[ch]) >> (10 - fb); }
    I64 v = vol(op, phase(op) + mod, am);
    ch_fbin[ch] = v;
    return v;
}

Bool sounds(I64 c) {
    return (reg[261] & 1) == 0 || (reg[192 + c] & 240) != 0;
}

void out_2op(I64 ch, inout I64[_] o) {
    I64 c = ch_offs[ch];
    I64 a = ch_op[ch * 4];
    I64 b = ch_op[ch * 4 + 1];
    I64 v1 = op1(ch, c, a, lfo_am);
    if (!sounds(c)) { return; }
    I64 r = 0;
    if ((reg[192 + c] & 1) == 0) {
        r = vol(b, phase(b) + (v1 >> 1), lfo_am);
    } else {
        r = clip(v1 + vol(b, phase(b), lfo_am));
    }
    mix(c, o, r);
}

I64 pick(I64 k, I64 v1, I64 v2, I64 v3) {
    if (k == 1) { return v1; }
    if (k == 2) { return v2; }
    if (k == 3) { return v3; }
    if (k == 5) { return v1 + v2; }
    if (k == 6) { return v1 + v3; }
    if (k == 7) { return v2 + v3; }
    return 0;
}

void out_4op(I64 ch, inout I64[_] o) {
    I64 c = ch_offs[ch];
    I64 v1 = op1(ch, c, ch_op[ch * 4], lfo_am);
    if (!sounds(c)) { return; }
    I64 alg = ALG4[(reg[192 + c] & 1) | ((reg[195 + c] & 1) << 1)];
    I64 b = ch_op[ch * 4 + 1];
    I64 v2 = vol(b, phase(b) + (pick(alg & 1, v1, 0, 0) >> 1), lfo_am);
    I64 d = ch_op[ch * 4 + 2];
    I64 v3 = vol(d, phase(d) + (pick((alg >> 1) & 7, v1, v2, 0) >> 1), lfo_am);
    I64 e = ch_op[ch * 4 + 3];
    I64 r = vol(e, phase(e) + (pick((alg >> 4) & 7, v1, v2, v3) >> 1), lfo_am);
    if ((alg & 128) != 0) { r = clip(r + v1); }
    if ((alg & 256) != 0) { r = clip(r + v2); }
    if ((alg & 512) != 0) { r = clip(r + v3); }
    mix(c, o, r);
}

// Rhythm: channel 6 the bass drum, 7 the high hat and snare, 8 the tom and cymbal.
void out_bd(inout I64[_] o) {
    I64 c = ch_offs[6];
    I64 v1 = op1(6, c, 12, lfo_am);
    I64 mod = (reg[192 + c] & 1) != 0 ? 0 : (v1 >> 1);
    mix(c, o, vol(15, phase(15) + mod, lfo_am) * 2);
}

void out_hh_sd(I64 sel, inout I64[_] o) {
    I64 noise = (lfsr >> 23) & 1;
    I64 p = (sel << 9) | (208 >> (2 * (noise ^ sel)));
    I64 r = vol(13, p, lfo_am);
    p = (256 << ((phase(13) >> 8) & 1)) ^ (noise << 8);
    r = clip(r + vol(16, p, lfo_am));
    mix(ch_offs[7], o, r * 2);
}

void out_tt_cy(I64 sel, inout I64[_] o) {
    I64 r = vol(14, phase(14), lfo_am);
    r = clip(r + vol(17, 256 | (sel << 9), lfo_am));
    mix(ch_offs[8], o, r * 2);
}

// One sample: clock the chip, then sum the active channels into o[0..4], each clamped to 16 bits.
export void opl_sample(inout I64[_] o) {
    clock();
    o[0] = 0;
    o[1] = 0;
    o[2] = 0;
    o[3] = 0;
    Bool rhythm = (reg[189] & 32) != 0;
    I64 sel = 0;
    if (rhythm) {
        I64 p13 = phase(13);
        I64 p17 = phase(17);
        sel = (((p13 >> 2) ^ (p13 >> 7)) & 1) | ((p13 >> 3) & 1) | (((p17 >> 5) ^ (p17 >> 3)) & 1);
    }
    for ch in 0..18 {
        if (((active >> ch) & 1) != 0) {
            if (rhythm && ch == 6) {
                out_bd(o);
            } else if (rhythm && ch == 7) {
                out_hh_sd(sel, o);
            } else if (rhythm && ch == 8) {
                out_tt_cy(sel, o);
            } else if (ch_op[ch * 4 + 2] >= 0) {
                out_4op(ch, o);
            } else {
                out_2op(ch, o);
            }
        }
    }
    for i in 0..4 { o[i] = clip(o[i]); }
}
