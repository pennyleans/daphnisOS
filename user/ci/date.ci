// user/ci/date.ci: date [-u] [-d @N] [+FORMAT] (docs/specs/2026-11-06-c-core.md, CT-4): the time (CLOCK_REALTIME: the
// virtual clock under Daphnis), or N seconds since 1970 with -d @N, in the machine's zone (RS-TZc: the city of
// /home/.daphnis-zone through user/ci/core/zonefile.ci; UTC without one, or with -u), as FORMAT (default
// `%a %b %e %H:%M:%S %Z %Y`) and a newline. FORMAT holds XCU's conversions, as musl's
// strftime writes them in the POSIX locale:
//   %a %A %b %B %h   day and month names, short and full     %c  %a %b %e %H:%M:%S %Y     %x %D  %m/%d/%y
//   %C %y %Y         century, year in it, year (4 digits)   %d %e  day (0 or blank padded) %X %T  %H:%M:%S
//   %H %I %M %S %p   hour (24, 12), minute, second, AM/PM   %j  day of the year           %r     %I:%M:%S %p
//   %m               month                                  %u %w  weekday (1-7 Mon, 0-6 Sun)  %R  %H:%M
//   %U %W            week of the year from Sunday, Monday   %V %G %g  ISO 8601 week and its year   %F  %Y-%m-%d
//   %s               seconds since 1970                      %z %Z  the offset and letters (-0500, EST)  %n %t %%
// with E and O modifiers allowed and ignored. Any other conversion, a flag or a width is refused by name; -d with
// anything but @N is refused, and so is an operand that would set the clock. Years 1 to 9,999 only (YEAR).
import user.ci.dev;
import user.ci.shctl;
import user.ci.corectl;
import user.ci.core.put;
import user.ci.core.msg;
import user.ci.core.args;
import user.ci.core.zonefile;
import user.ci.core.tz;
import user.ci.core.cal;
import user.ci.kit.clocktext;

I64 t = 0;       // seconds since 1970
I64 year = 0;
I64 mon = 0;     // 1 to 12
I64 mday = 0;
I64 yday = 0;    // 0 to 365
I64 wday = 0;    // 0 Sunday
I64 hour = 0;
I64 minute = 0;
I64 sec = 0;
I64 zone = -1;   // RS-TZc: the machine's zone, -1 UTC

I64 fdiv(I64 x, I64 y) {
    if (x >= 0) { return x / y; }
    return 0 - ((0 - x + y - 1) / y);
}

// Days since 1970-01-01 of y-m-d (H. Hinnant's days_from_civil).
I64 days_of(I64 y0, I64 m, I64 d) {
    I64 y = y0;
    if (m <= 2) { y = y - 1; }
    I64 era = fdiv(y, 400);
    I64 yoe = y - era * 400;
    I64 mp = m + 9;
    if (m > 2) { mp = m - 3; }
    I64 doy = (153 * mp + 2) / 5 + d - 1;
    I64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

// Fills the fields from t in the zone; false when t or its local time falls outside years 1 to 9999.
Bool split() {
    if (t < tz.FIRST || t > tz.LAST) { return false; }
    I64 o = tz.local(zone, t);
    if (t + o < tz.FIRST || t + o > tz.LAST) { return false; }
    year = cal.year();
    mon = cal.month();
    mday = cal.day();
    yday = cal.yearday();
    wday = cal.weekday();
    hour = cal.hour();
    minute = cal.minute();
    sec = cal.second();
    return true;
}

void num(I64 v, I64 width, U8 pad) {
    U8[24] d;
    I64 k = 0;
    I64 x = v;
    Bool neg = x < 0;
    if (neg) { x = 0 - x; }
    if (x == 0) {
        d[0] = '0';
        k = 1;
    }
    while (x > 0) {
        d[k] = ((x % 10) as U8) + 48;
        x = x / 10;
        k = k + 1;
    }
    if (neg) { put.byte('-'); }
    I64 p = width - k;
    if (neg) { p = p - 1; }
    while (p > 0) {
        put.byte(pad);
        p = p - 1;
    }
    while (k > 0) {
        k = k - 1;
        put.byte(d[k]);
    }
}

void name3(in U8[_] names, I64 i) {
    put.bytes(names[3 * i..3 * i + 3]);
}

void day_name(I64 full) {
    if (full == 0) {
        name3(b"SunMonTueWedThuFriSat", wday);
    } else if (wday == 0) { put.bytes(b"Sunday"); }
    else if (wday == 1) { put.bytes(b"Monday"); }
    else if (wday == 2) { put.bytes(b"Tuesday"); }
    else if (wday == 3) { put.bytes(b"Wednesday"); }
    else if (wday == 4) { put.bytes(b"Thursday"); }
    else if (wday == 5) { put.bytes(b"Friday"); }
    else { put.bytes(b"Saturday"); }
}

void month_name(I64 full) {
    if (full == 0) {
        name3(b"JanFebMarAprMayJunJulAugSepOctNovDec", mon - 1);
    } else if (mon == 1) { put.bytes(b"January"); }
    else if (mon == 2) { put.bytes(b"February"); }
    else if (mon == 3) { put.bytes(b"March"); }
    else if (mon == 4) { put.bytes(b"April"); }
    else if (mon == 5) { put.bytes(b"May"); }
    else if (mon == 6) { put.bytes(b"June"); }
    else if (mon == 7) { put.bytes(b"July"); }
    else if (mon == 8) { put.bytes(b"August"); }
    else if (mon == 9) { put.bytes(b"September"); }
    else if (mon == 10) { put.bytes(b"October"); }
    else if (mon == 11) { put.bytes(b"November"); }
    else { put.bytes(b"December"); }
}

// ISO 8601: the week's Thursday decides its year; the week number counts from that year's first Thursday.
I64 iso_year = 0;
I64 iso_week = 0;

void iso() {
    I64 days = days_of(year, mon, mday);
    I64 thu = days - (wday + 6) % 7 + 3;
    I64 y = year;
    if (thu < days_of(year, 1, 1)) { y = year - 1; }
    if (thu >= days_of(year + 1, 1, 1)) { y = year + 1; }
    iso_year = y;
    iso_week = (thu - days_of(y, 1, 1)) / 7 + 1;
}

void conv(U8 c) {
    if (c == 'a') { day_name(0); }
    else if (c == 'A') { day_name(1); }
    else if (c == 'b' || c == 'h') { month_name(0); }
    else if (c == 'B') { month_name(1); }
    else if (c == 'c') {
        conv('a'); put.byte(' '); conv('b'); put.byte(' '); conv('e'); put.byte(' '); conv('T'); put.byte(' ');
        conv('Y');
    }
    else if (c == 'C') { num(year / 100, 2, '0'); }
    else if (c == 'd') { num(mday, 2, '0'); }
    else if (c == 'D' || c == 'x') { conv('m'); put.byte('/'); conv('d'); put.byte('/'); conv('y'); }
    else if (c == 'e') { num(mday, 2, ' '); }
    else if (c == 'F') { conv('Y'); put.byte('-'); conv('m'); put.byte('-'); conv('d'); }
    else if (c == 'g') {
        iso();
        num(iso_year % 100, 2, '0');
    }
    else if (c == 'G') {
        iso();
        num(iso_year, 4, '0');
    }
    else if (c == 'H') { num(hour, 2, '0'); }
    else if (c == 'I') {
        I64 h = hour % 12;
        if (h == 0) { h = 12; }
        num(h, 2, '0');
    }
    else if (c == 'j') { num(yday + 1, 3, '0'); }
    else if (c == 'm') { num(mon, 2, '0'); }
    else if (c == 'M') { num(minute, 2, '0'); }
    else if (c == 'n') { put.byte('\n'); }
    else if (c == 'p') {
        if (hour < 12) { put.bytes(b"AM"); } else { put.bytes(b"PM"); }
    }
    else if (c == 'r') { conv('I'); put.byte(':'); conv('M'); put.byte(':'); conv('S'); put.byte(' '); conv('p'); }
    else if (c == 'R') { conv('H'); put.byte(':'); conv('M'); }
    else if (c == 's') { num(t, 0, '0'); }
    else if (c == 'S') { num(sec, 2, '0'); }
    else if (c == 't') { put.byte('\t'); }
    else if (c == 'T' || c == 'X') { conv('H'); put.byte(':'); conv('M'); put.byte(':'); conv('S'); }
    else if (c == 'u') {
        I64 u = wday;
        if (u == 0) { u = 7; }
        num(u, 0, '0');
    }
    else if (c == 'U') { num((yday + 7 - wday) / 7, 2, '0'); }
    else if (c == 'V') {
        iso();
        num(iso_week, 2, '0');
    }
    else if (c == 'w') { num(wday, 0, '0'); }
    else if (c == 'W') { num((yday + 7 - (wday + 6) % 7) / 7, 2, '0'); }
    else if (c == 'y') { num(year % 100, 2, '0'); }
    else if (c == 'Y') { num(year, 4, '0'); }
    else if (c == 'z') {
        U8[8] z;
        I64 n = clocktext.hhmm(z, 0, zone, t);
        put.bytes(z[0..n]);
    }
    else if (c == 'Z') {
        U8[16] z;
        I64 n = min(tz.abbr(zone, t, z), len(z));
        put.bytes(z[0..n]);
    }
    else if (c == '%') { put.byte('%'); }
}

Bool in_set(in U8[_] set, U8 c) {
    for k in 0..len(set) {
        if (set[k] == c) { return true; }
    }
    return false;
}

Bool known(U8 c) {
    return in_set(b"aAbBcCdDeFgGhHIjmMnprRsStTuUVwWxXyYzZ%", c);
}

void refuse_text(in U8[_] what) {
    msg.begin();
    msg.text(b"not supported: ");
    msg.text(what);
    msg.send();
    put.flush();
    dev.exit_now(2);
}

// Checks FORMAT before anything is written: each % has a known conversion, after at most one E or O.
void check(in U8[_] f) {
    I64 i = 0;
    while (i < len(f)) {
        if (f[i] == '%') {
            I64 j = i + 1;
            if (j < len(f) && (f[j] == 'E' || f[j] == 'O')) { j = j + 1; }
            if (j >= len(f) || !known(f[j])) {
                I64 e = j + 1;
                if (e > len(f)) { e = len(f); }
                refuse_text(f[i..e]);
            }
            i = j + 1;
        } else {
            i = i + 1;
        }
    }
}

void render(in U8[_] f) {
    I64 i = 0;
    while (i < len(f)) {
        if (f[i] == '%') {
            I64 j = i + 1;
            if (f[j] == 'E' || f[j] == 'O') { j = j + 1; }
            conv(f[j]);
            i = j + 1;
        } else {
            put.byte(f[i]);
            i = i + 1;
        }
    }
}

void main(in U8[_] a) {
    msg.name(b"date");
    args.parse(a, b"u", b"d");
    I64 n = args.operands();
    I64 fs = -1;
    I64 fe = -1;
    if (n > 0 && a[args.op_start(0)] == '+') {
        fs = args.op_start(0) + 1;
        fe = args.op_stop(a, 0);
    }
    if (n > 1 || (n == 1 && fs < 0)) {
        if (args.has('d') || n > 1) { msg.usage(b"extra operand"); }
        refuse_text(b"setting the time");
    }
    if (args.has('d')) {
        I64 s = args.val_start('d');
        I64 e = args.val_stop('d');
        if (e - s < 2 || a[s] != '@') { msg.refuse('d'); }
        I64 i = s + 1;
        Bool neg = false;
        if (a[i] == '-') {
            neg = true;
            i = i + 1;
        }
        if (i == e) { msg.refuse('d'); }
        I64 v = 0;
        while (i < e) {
            U8 d = a[i];
            if (d < '0' || d > '9') { msg.refuse('d'); }
            if (v > 300000000000) { msg.limit(b"YEAR"); }
            v = v * 10 + ((d - 48) as I64);
            i = i + 1;
        }
        t = v;
        if (neg) { t = 0 - v; }
    } else {
        t = fdiv(corectl.co_clock(0), 1000000000);
    }
    if (fs >= 0) { check(a[fs..fe]); }
    if (!args.has('u')) { zone = zonefile.city(); }
    if (!split()) { msg.limit(b"YEAR"); }
    if (fs >= 0) {
        render(a[fs..fe]);
    } else {
        render(b"%a %b %e %H:%M:%S %Z %Y");
    }
    put.byte('\n');
    msg.finish();
}
