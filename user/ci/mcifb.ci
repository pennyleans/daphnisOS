// user/ci/mcifb.ci: cint draws mfb's pattern (docs/specs/2026-11-05-f-surface.md section 3) on the
// surface through its runtime's rows: the kernel's surface digest must be F-1's pin, 5ce934ae...
import user.ci.dev;

U8[20480] row;      // one row of the widest screen (RES-1: 5120 px)

void main() {
    I64 st = dev.fb_open();
    if (st < 0) {
        "mcifb: no surface ({st})\n";
        dev.exit_now(3);
    }
    I64 w = dev.fb_word(0) as I64;
    I64 h = dev.fb_word(1) as I64;
    I64 stride = dev.fb_word(2) as I64;
    "mcifb: surface {w}x{h} stride {stride}\n";
    if (w > 5120 || h < 2 || w < 2) {
        dev.exit_now(4);
    }
    for y in 0..h {
        for x in 0..w {
            I64 r = x * 255 / (w - 1);
            I64 g = y * 255 / (h - 1);
            I64 b = (x ^ y) & 255;
            row[4 * x] = b as U8;
            row[4 * x + 1] = g as U8;
            row[4 * x + 2] = r as U8;
            row[4 * x + 3] = 0;
        }
        dev.fb_row(y, row[0..4 * w]);
    }
    "mcifb: drawn\n";
}
