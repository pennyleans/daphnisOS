// user/ci/http.ci: the HTTP/1.1 client kit (docs/specs/2026-11-07-bu5-fetch.md section 2). Bytes in, bytes out: no
// socket, no output. get() writes the request of a GET, busybox wget's bytes. The reader is A-1's state machine
// (user/ci/agent.ci) taken out whole: start(), then take(got, body) once per read, which writes the body bytes of got
// into body (never more than len(got)) and returns their count. The phases: 0 the status line and header fields,
// 1 a chunk's size line, 2 a chunk's data, 3 the end of a chunk's data, 4 a plain body, 5 done, 6 bad.
//   status(): the status code, 0 before the status line. status_line(to): the status line, without CRLF.
//   headed(): the header fields are read. done(): the body is whole by its framing (the last chunk, or
//   content-length bytes); a plain body without content-length ends only when the connection does.
//   length(): content-length, or -1. received(): body bytes so far. framed(): chunked, or a content-length.
//   is_chunked(): chunked. bad(): a line over LINE_MAX, a status line that is not `HTTP/x.y NNN`, a size that is not
//   hex, or a length that is not decimal. BU-5b: agent reads its responses with it.

const I64 LINE_MAX = 8192;
const I64 STATUS_MAX = 256;
const I64 DIGITS_MAX = 15;   // a size or a length of up to 15 digits fits a word, hex or decimal

U8[8192] line;               // the header line being assembled
I64 line_n = 0;
U8[256] sline;               // the status line, kept for the diagnostic
I64 sline_n = 0;
I64 phase = 0;
I64 code = 0;
I64 lines_seen = 0;
Bool chunked = false;
I64 clen = -1;
I64 got_n = 0;
I64 left = 0;                // bytes of the chunk still to come
I64 csize = 0;
I64 cdigits = 0;
Bool csize_done = false;
U8[4096] location_value;
I64 location_n = -1;

I64 put_s(inout U8[_] to, I64 at, in U8[_] s) {
    for i in 0..len(s) { to[at + i] = s[i]; }
    return at + len(s);
}

// The request for host (the URL's authority as written) and path into req: its length, or -1 when it does not fit.
export I64 get(in U8[_] host, in U8[_] path, inout U8[_] req) {
    if (4 + len(path) + 17 + len(host) + 41 > len(req)) { return -1; }
    I64 n = put_s(req, 0, b"GET ");
    n = put_s(req, n, path);
    n = put_s(req, n, b" HTTP/1.1\r\nHost: ");
    n = put_s(req, n, host);
    return put_s(req, n, b"\r\nUser-Agent: Wget\r\nConnection: close\r\n\r\n");
}

export void start() {
    line_n = 0;
    sline_n = 0;
    phase = 0;
    code = 0;
    lines_seen = 0;
    chunked = false;
    clen = -1;
    got_n = 0;
    left = 0;
    csize = 0;
    cdigits = 0;
    csize_done = false;
    location_n = -1;
}

export I64 status() { return code; }
export Bool headed() { return phase > 0 && phase != 6; }
export Bool done() { return phase == 5; }
export Bool bad() { return phase == 6; }
export I64 length() { return clen; }
export I64 received() { return got_n; }
export Bool framed() { return chunked || clen >= 0; }
export Bool is_chunked() { return chunked; }

// One complete Location field is kept. Missing, duplicate, and oversized
// fields return a negative result instead of a truncated navigation target.
export I64 location(inout U8[_] to) {
    if (location_n < 0) { return location_n; }
    if (location_n > len(to)) { return -2; }
    for i in 0..location_n { to[i] = location_value[i]; }
    return location_n;
}

export I64 status_line(inout U8[_] to) {
    I64 n = sline_n;
    if (n > len(to)) { n = len(to); }
    for i in 0..n { to[i] = sline[i]; }
    return n;
}

U8 folded(U8 b) {
    if (b >= 'A' && b <= 'Z') { return b + 32; }
    return b;
}

// The header line starts with name, a field name and its colon, in any case; the index after it and any blanks,
// or -1.
I64 field(in U8[_] name) {
    if (line_n < len(name)) { return -1; }
    for k in 0..len(name) {
        if (folded(line[k]) != name[k]) { return -1; }
    }
    I64 at = len(name);
    while (at < line_n && (line[at] == ' ' || line[at] == 9)) { at = at + 1; }
    return at;
}

// The status line in line: `HTTP/x.y NNN reason`.
void status_of() {
    for i in 0..line_n {
        if (sline_n < STATUS_MAX) {
            sline[sline_n] = line[i];
            sline_n = sline_n + 1;
        }
    }
    if (line_n < 12 || line[0] != 'H' || line[1] != 'T' || line[2] != 'T' || line[3] != 'P' || line[4] != '/'
        || line[8] != ' ') {
        phase = 6;
        return;
    }
    code = 0;
    for i in 9..12 {
        if (line[i] < '0' || line[i] > '9') {
            phase = 6;
            return;
        }
        code = 10 * code + (line[i] - '0') as I64;
    }
}

// One header line in line, its CRLF taken off.
void header_line() {
    lines_seen = lines_seen + 1;
    if (lines_seen == 1) {
        status_of();
        return;
    }
    if (line_n == 0) {
        if (chunked) {
            phase = 1;
        } else if (clen == 0) {
            phase = 5;
        } else {
            phase = 4;
        }
        return;
    }
    I64 at = field(b"location:");
    if (at >= 0) {
        I64 end = line_n;
        while (end > at && (line[end - 1] == ' ' || line[end - 1] == 9)) { end = end - 1; }
        if (location_n != -1 || end - at > len(location_value)) {
            location_n = -2;
        } else {
            location_n = end - at;
            for i in 0..location_n { location_value[i] = line[at + i]; }
        }
        return;
    }
    at = field(b"transfer-encoding:");
    if (at >= 0) {
        I64 e = line_n;
        while (e > at && (line[e - 1] == ' ' || line[e - 1] == 9)) { e = e - 1; }
        if (e - at == 7) {
            U8[7] c;
            c[0] = 'c';
            c[1] = 'h';
            c[2] = 'u';
            c[3] = 'n';
            c[4] = 'k';
            c[5] = 'e';
            c[6] = 'd';
            Bool same = true;
            for k in 0..7 {
                if (folded(line[at + k]) != c[k]) { same = false; }
            }
            if (same) { chunked = true; }
        }
        return;
    }
    at = field(b"content-length:");
    if (at >= 0) {
        I64 v = 0;
        I64 d = 0;
        I64 e = line_n;
        while (e > at && (line[e - 1] == ' ' || line[e - 1] == 9)) { e = e - 1; }
        for i in at..e {
            if (line[i] < '0' || line[i] > '9' || d == DIGITS_MAX) {
                phase = 6;
                return;
            }
            v = 10 * v + (line[i] - '0') as I64;
            d = d + 1;
        }
        if (d == 0) {
            phase = 6;
            return;
        }
        clen = v;
    }
}

I64 hexval(U8 b) {
    if (b >= '0' && b <= '9') { return (b - '0') as I64; }
    if (b >= 'a' && b <= 'f') { return (b - 'a') as I64 + 10; }
    if (b >= 'A' && b <= 'F') { return (b - 'A') as I64 + 10; }
    return -1;
}

// The body bytes of got into body: their count.
export I64 take(in U8[_] got, inout U8[_] body) {
    I64 n = 0;
    I64 i = 0;
    while (i < len(got) && phase != 5 && phase != 6) {
        U8 b = got[i];
        if (phase == 0) {
            if (b == 10) {
                if (line_n > 0 && line[line_n - 1] == 13) { line_n = line_n - 1; }
                header_line();
                line_n = 0;
            } else if (line_n < LINE_MAX) {
                line[line_n] = b;
                line_n = line_n + 1;
            } else {
                phase = 6;
            }
            i = i + 1;
        } else if (phase == 1) {
            if (b == 10) {
                if (cdigits == 0) {
                    phase = 6;
                } else if (csize == 0) {
                    phase = 5;
                } else {
                    left = csize;
                    phase = 2;
                }
            } else if (!csize_done) {
                I64 h = hexval(b);
                if (h < 0) {
                    csize_done = true;   // CR, or a chunk extension
                } else if (cdigits == DIGITS_MAX) {
                    phase = 6;
                } else {
                    csize = 16 * csize + h;
                    cdigits = cdigits + 1;
                }
            }
            i = i + 1;
        } else if (phase == 2) {
            // a run of the chunk's data at once
            I64 k = len(got) - i;
            if (k > left) { k = left; }
            for j in 0..k { body[n + j] = got[i + j]; }
            n = n + k;
            i = i + k;
            got_n = got_n + k;
            left = left - k;
            if (left == 0) { phase = 3; }
        } else if (phase == 3) {
            if (b == 10) {
                phase = 1;
                csize = 0;
                cdigits = 0;
                csize_done = false;
            }
            i = i + 1;
        } else {
            // phase 4: the plain body, up to content-length when there is one
            I64 k = len(got) - i;
            if (clen >= 0 && k > clen - got_n) { k = clen - got_n; }
            for j in 0..k { body[n + j] = got[i + j]; }
            n = n + k;
            i = i + k;
            got_n = got_n + k;
            if (clen >= 0 && got_n == clen) { phase = 5; }
        }
    }
    return n;
}
