// user/ci/wc.ci: wc [-c|-m] [-l] [-w] [FILE...] (docs/specs/2026-11-06-c-core.md, CT-0): newlines, words and bytes of
// each FILE (`-` or none: descriptor 0), in that column order, and a `total` line for two or more FILEs. No option
// means -l -w -c. -m counts characters of the POSIX locale, which are bytes. A word is a run of bytes that are not
// white space (space, \t, \n, \v, \f, \r), as POSIX says (busybox counts only printable ASCII: tests/core/DIFFS.md).
// One column for at most one FILE prints the bare number; otherwise each column is 9 wide, as busybox.
import user.ci.dev;
import user.ci.shctl;
import user.ci.core.put;
import user.ci.core.msg;
import user.ci.core.args;
import user.ci.core.get;   // user/ci/build.sh emits the modules in this order, each after what it imports

U8[4096] buf;
I64[4] cnt;      // lines, words, characters, bytes of one input
I64[4] tot;
Bool[4] col;
I64 width = 9;

void tally(I64 fd, in U8[_] name) {
    for k in 0..4 { cnt[k] = 0; }
    Bool inword = false;
    Bool going = true;
    while (going) {
        I64 r = get.read(fd, buf);
        if (r < 0) {
            msg.file(name, 0 - r);
            going = false;
        } else if (r == 0) {
            going = false;
        } else {
            for i in 0..r {
                U8 c = buf[i];
                if (c == '\n') { cnt[0] = cnt[0] + 1; }
                if (c == ' ' || (c >= 9 && c <= 13)) {
                    inword = false;
                } else if (!inword) {
                    inword = true;
                    cnt[1] = cnt[1] + 1;
                }
            }
            cnt[3] = cnt[3] + r;
        }
    }
    cnt[2] = cnt[3];
}

void row(in I64[_] v, in U8[_] name, Bool named) {
    Bool firstcol = true;
    for k in 0..4 {
        if (col[k]) {
            if (!firstcol) { put.byte(' '); }
            put.num(v[k], width);
            firstcol = false;
        }
    }
    if (named) {
        put.byte(' ');
        put.bytes(name);
    }
    put.byte('\n');
}

void one(in U8[_] name) {
    I64 fd = get.open(name);
    if (fd >= 0) {
        tally(fd, name);
        get.close(fd);
        row(cnt, name, true);
        for k in 0..4 { tot[k] = tot[k] + cnt[k]; }
    }
}

void main(in U8[_] a) {
    msg.name(b"wc");
    args.parse(a, b"clmw", b"");
    col[0] = args.has('l');
    col[1] = args.has('w');
    col[2] = args.has('m');
    col[3] = args.has('c');
    if (!col[0] && !col[1] && !col[2] && !col[3]) {
        col[0] = true;
        col[1] = true;
        col[3] = true;
    }
    I64 ncol = 0;
    for k in 0..4 {
        if (col[k]) { ncol = ncol + 1; }
        tot[k] = 0;
    }
    I64 n = args.operands();
    if (ncol == 1 && n <= 1) { width = 0; }
    if (n == 0) {
        tally(0, b"-");
        row(cnt, b"", false);
    }
    for i in 0..n {
        one(a[args.op_start(i)..args.op_stop(a, i)]);
    }
    if (n > 1) { row(tot, b"total", true); }
    msg.finish();
}
