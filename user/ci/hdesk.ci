I64 bin_n = 0;
I64 ix_fd = -1;             // /dev/fsidx, held while the desk runs on a volume (FF-1: one holder)
Bool ix_on = false;
I64[12] op_ent;             // the index entries the plane opened, newest first (recent's head)
I64 op_n = 0;
I64 op_walks = 0;
U8[4096] pbuf;
U8[4096] fbuf;

void put_word(inout U8[_] b, I64 i, I64 v) {
    for k in 0..4 {
        b[4 * i + k] = ((v >> (8 * k)) & 255) as U8;
    }
}

I64 word_at(in U8[_] b, I64 i) {
    return b[4 * i] as I64 | (b[4 * i + 1] as I64 << 8) | (b[4 * i + 2] as I64 << 16) | (b[4 * i + 3] as I64 << 24);
}

I64 bar_h() { return layout.BAR * sc; }

// An overlay is up: the switcher, the Super menu, the calendar, the kern prompt or the system panel.
Bool ov_up() {
    return sw_open || mn_open || cal_open || kp_open || sp_open || tr_open || pl_open || msg_on || rv_open ||
        ask_up() || ac_screen != 0 || keysheet.is_up();
}
I64 bw() { return B * sc; }
I64 plane_h() { return h - bar_h(); }

// HX-8: 1x up to 1440p, 2x above, by the screen's short side (a portrait 1080 x 1920 is 1x).
// K-2: how the terminals draw at the UI scale: Daphnis Mono's own 16 x 32 drawing (2) at an even scale, spread to
// sc / 2, and its 8 x 16 drawing (1) at an odd one, spread to sc. A cell is 8 * sc x 16 * sc pixels either way.
I64 tz() {
    if (sc % 2 == 0) { return 2; }
    return 1;
}

I64 auto_scale(I64 sw, I64 sh) {
    I64 m = sw;
    if (sh < m) { m = sh; }
    if (m > 1600) { return 2; }
    return 1;
}

// The 1x pixels row[x0..x0+n] spread to sc pixels each, in place from the right.
void expand(I64 x0, I64 n) { expand_by(x0, n, sc); }

// The pixels row[x0..x0+n] spread to m pixels each, in place from the right, a word a pixel.
void expand_by(I64 x0, I64 n, I64 m) {
    if (m == 1) { return; }
    for qq in 0..n {
        I64 q = n - 1 - qq;
        U32 v = row[x0 + q];
        for t in 0..m { row[x0 + m * q + t] = v; }
    }
}

// The focused window: the most recent on the active desktop, or -1.
I64 focused() {
    if (layout.entries(cur) == 0) { return -1; }
    return layout.entry(cur, 0);
}

// A window the person has: any but a terminal that only holds an app's process (lx_host).
Bool listed(I64 i) { return winroom.has(kind[i], lx_host[i]); }

Bool shown(I64 i) {
    return i < WINDOWS && listed(i) && !tin[i] && wdesk[i] == cur && wmode[i] != layout.MINIMIZED;
}

// K-12 (docs/specs/2026-11-07-ds-desk-speed.md section 4): what was just drawn, to the kernel's clock: 1 a drain,
// 2 a switcher frame.
void k12_mark(I64 what) {
    put_word(req, 0, what);
    I64 st = tilectl.tile_ctl(FBIO_TILE_MARK, req);
}

// SCHED-1 (docs/specs/2026-11-07-ds-desk-speed.md section 3): the focused window told to the kernel when it changed,
// a terminal by its pty's master, a pixel window by its pid, else none (kind 2).
I64 told_k = -1;
I64 told_id = -1;
void focus_tell() {
    I64 f = focused();
    I64 k = 2;
    I64 id = 0;
    if (f >= 0 && kind[f] == TERM) {
        k = 1;
        id = master[f];
    } else if (f >= 0 && kind[f] == PIXEL) {
        k = 0;
        id = pid[f];
    }
    if (k == told_k && id == told_id) { return; }
    told_k = k;
    told_id = id;
    I64 st = hdeskctl.tile_ask(FBIO_TILE_FOCUS, k, id, ask[0..64]);
}

// Window i's foreground process into vpid[i] and its comm into title (FBIO_TILE_INFO); false when it has none.
Bool info(I64 i) {
    I64 st = 0;
    if (kind[i] == FAULT) {
        for k in 0..16 { title[16 * i + k] = 0; }
        for k in 0..5 { title[16 * i + k] = b"fault"[k]; }
        vpid[i] = 0;
        gw[i] = 0;
        wask[i] = false;
        wmin[i] = false;
        return true;
    }
    if (kind[i] == SETTINGS) {
        for k in 0..16 { title[16 * i + k] = 0; }
        for k in 0..8 { title[16 * i + k] = b"settings"[k]; }
        vpid[i] = 0;
        gw[i] = 0;
        wask[i] = false;
        wmin[i] = false;
        return true;
    }
    if (kind[i] == TERM) {
        st = hdeskctl.tile_ask(FBIO_TILE_INFO, 1, master[i], ask[0..64]);
    } else {
        st = hdeskctl.tile_ask(FBIO_TILE_INFO, 0, pid[i], ask[0..64]);
    }
    if (st < 0) { return false; }
    vpid[i] = word_at(ask, 0);
    if (kind[i] == PIXEL) {
        psw[i] = (ask[4] as I64) | ((ask[5] as I64) << 8);
        psh[i] = (ask[6] as I64) | ((ask[7] as I64) << 8);
        var_take(i, ask);
    }
    gw[i] = (ask[8] as I64) & (3 | GRANT_KERN);
    wask[i] = (ask[12] & 1) != 0;   // SP-2: bit 32, the program asks for the tray
    wmin[i] = (ask[12] & 2) != 0;   // SP-6: bit 33, its window minimizes to the tray
    for k in 0..16 {
        if (title[16 * i + k] != ask[16 + k]) { tchg[i] = true; }
        title[16 * i + k] = ask[16 + k];
    }
    return true;
}

// A float's bar names its program as it is now (an exec, CVim from the Fault window): the bars of the windows
// whose title or variable info() saw change since, drawn again.
Bool[16] tchg;
void bars_named() {
    for i in 0..WINDOWS {
        if (tchg[i] && kind[i] != NONE && tb(i) > 0 && shown(i)) {
            paint_rows(layout.frame_y(i), layout.frame_y(i) + fi(i) + tb(i));
        }
        tchg[i] = false;
    }
}

// RS-TTL section 6: pixel window i's variable into wvar: its first 32 bytes from kind 0's answer a, the rest from kind
// 19 for pid[i] when the first 32 fill (none when the kernel answers no kind 19). A change marks the window's bar to
// be drawn again (tchg).
void var_take(I64 i, in U8[_] a) {
    U8[64] r;
    for k in 0..64 { r[k] = 0; }
    if (a[63] != 0) {                     // a name past 32 bytes: one call more
        if (hdeskctl.tile_ask(FBIO_TILE_INFO, 19, pid[i], r[0..64]) < 0) {
            for k in 0..64 { r[k] = 0; }
        }
    }
    for k in 0..WVAR {
        U8 b = r[k];
        if (k < 32) { b = a[32 + k]; }
        if (wvar[WVAR * i + k] != b) { tchg[i] = true; }
        wvar[WVAR * i + k] = b;
    }
}

// BP-6, RS-TTL section 6: a pixel window's variable changed (View's first name or its next picture's), or a program's
// name (NAMES-28: an exec, Read waiting silent on its input): every pixel and terminal window's read again, then the
// bar, and the window bars whose name or variable moved.
void vars_named() {
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL || kind[i] == TERM) { Bool got = info(i); }
    }
    bar(false);
    bars_named();
}

I64 title_len(I64 i) {
    I64 n = 0;
    while (n < 16 && title[16 * i + n] != 0) { n = n + 1; }
    return n;
}

// The content box of window i (inside the border): x, y, w, h.
// WB-1: a float's bar comes off the top (tb, DN-6's 32 px at the UI scale), inside its FB px ring (fi).
I64 tb(I64 i) {
    if (i < WINDOWS && wmode[i] == layout.FLOAT && kind[i] != NONE) {   // a terminal, a pixel client, Settings, Fault
        return WBAR * sc;
    }
    return 0;
}
I64 fi(I64 i) {
    if (tb(i) > 0) { return FB * sc; }
    return bw();
}
I64 cbx(I64 i) { return layout.frame_x(i) + fi(i); }
I64 cby(I64 i) { return layout.frame_y(i) + fi(i) + tb(i); }
I64 cbw(I64 i) { return layout.frame_w(i) - 2 * fi(i); }
I64 cbh(I64 i) { return layout.frame_h(i) - 2 * fi(i) - tb(i); }

// A pixel window's surface size: what FBIO_TILE_INFO said, the offer before that.
I64 surf_w(I64 i) {
    if (psw[i] > 0) { return psw[i]; }
    return OFFER_W;
}
I64 surf_h(I64 i) {
    if (psh[i] > 0) { return psh[i]; }
    return OFFER_H;
}

// A pixel client's scale: the largest k in 1..6 with its surface at k inside its content box (HX-4), at least 1.
I64 scale_of(I64 i) {
    I64 k = 6;
    while (k > 1 && (k * surf_w(i) > cbw(i) || k * surf_h(i) > cbh(i))) { k = k - 1; }
    return k;
}

// K-1: the switcher's cards to a row: four, or as many as the screen holds at 1x (at least one).
// DN-6 frame 10: the tiles the switcher's one row holds on this screen (116 px tiles 8 apart, 16 in, 32 from the
// screen's edges), at least one.
I64 sw_cols() {
    I64 c = (w / sc - 64 - 32 + 8) / (SW_T + 8);
    if (c < 1) { c = 1; }
    return c;
}

// The first tile shown: 0, or as far right as keeps the selected tile on the row.
I64 sw_first() {
    I64 c = sw_cols();
    if (sw_sel < c) { return 0; }
    return sw_sel - c + 1;
}

// The tiles shown.
I64 sw_shown() {
    I64 c = sw_cols();
    if (sw_n < c) { return sw_n; }
    return c;
}

// The overlay's frame: the switcher's card (K-1, E2-2: centered, its top at bar_h() + 120, kept on the screen), the
// Super menu under the mark, or the calendar under the clock.
void overlay() {
    if (ac_screen != 0) {
        layout.put(OV, cur, layout.FLOAT, 1000000, 0, bar_h(), w, plane_h());   // AC-1c: the whole plane covered
        return;
    }
    if (indextrash.is_up() && !kp_open) {   // frame 23: Storage's Empty Trash ask, centered, at the app menu's zoom
        I64 z = am_z();
        layout.put(OV, cur, layout.FLOAT, 1000000, (w - indextrash.W * z) / 2,
                   bar_h() + (plane_h() - indextrash.height() * z) / 2, indextrash.W * z, indextrash.height() * z);
        return;
    }
    if (unsaved.is_up() && !kp_open) {  // AM section 7: the unsaved ask, centered over the plane
        layout.put(OV, cur, layout.FLOAT, 1000000, (w - unsaved.W * sc) / 2,
                   bar_h() + (plane_h() - unsaved.height() * sc) / 2, unsaved.W * sc, unsaved.height() * sc);
        return;
    }
    if (acctform.is_up() && !kp_open) {   // RS-AQ: frame 49's form, centered over the plane
        layout.put(OV, cur, layout.FLOAT, 1000000, (w - acctform.W * sc) / 2,
                   bar_h() + (plane_h() - acctform.height() * sc) / 2, acctform.W * sc, acctform.height() * sc);
        return;
    }
    if (keysheet.is_up() && !kp_open) {  // frame 27: the shortcut sheet, centered over the plane
        layout.put(OV, cur, layout.FLOAT, 1000000, keysheet.left() * sc, bar_h() + keysheet.top() * sc,
                   keysheet.width() * sc, keysheet.height() * sc);
        return;
    }
    if (rv_open && !kp_open) {           // DN-10: the revert prompt, centered over the plane
        layout.put(OV, cur, layout.FLOAT, 1000000, (w - RV_W * sc) / 2, bar_h() + (plane_h() - RV_H * sc) / 2,
                   RV_W * sc, RV_H * sc);
        return;
    }
    if (kp_open) {
        layout.put(OV, cur, layout.FLOAT, 1000000, (w - KP_W * sc) / 2, bar_h() + (plane_h() - kp_h() * sc) / 2,
                   KP_W * sc, kp_h() * sc);               // R0-2: centered over the plane (KERN-Q1)
        return;
    }
    if (tr_open) {
        I64 tx = (tr_x + tr_w - tr_pw()) * sc;         // DN-15: 8 under the bar, its right edge with the slot's
        if (tx < 8 * sc) { tx = 8 * sc; }
        layout.put(OV, cur, layout.FLOAT, 1000000, tx, bar_h() + 8 * sc, tr_pw() * sc, tr_ph() * sc);
        return;
    }
    if (sp_open) {
        layout.put(OV, cur, layout.FLOAT, 1000000, w - (SP_W + 8) * sc, bar_h() + 8 * sc, SP_W * sc, sp_h() * sc);   // DN-6
        return;
    }
    if (msg_up()) {
        layout.put(OV, cur, layout.FLOAT, 1000000, (w - MSG_W * sc) / 2, bar_h() + 12 * sc, MSG_W * sc, MSG_H * sc);
        return;
    }
    if (pl_open) {
        pl_size();
        layout.put(OV, cur, layout.FLOAT, 1000000, 0, bar_h(), w, plane_h());
        return;
    }
    if (cal_open) {                    // RS-CAL: the plate and its shadow, see-through, kept on the screen
        I64 z = am_z();
        I64 th = tokens.theme();
        I64 x0 = max(0, calpop.area_left(z, th));
        I64 x1 = min(w, calpop.area_right(z, th));
        I64 y0 = max(bar_h(), calpop.area_top(z, th));
        I64 y1 = min(h, calpop.area_bottom(z, th));
        layout.put(OV, cur, layout.FLOAT, 1000000, x0, y0, x1 - x0, y1 - y0);
        return;
    }
    if (mn_open && mn_app) {           // AM-1: the plates and their shadows: the width under the bar, see-through
        I64 z = am_z();
        I64 b = ctxmenu.area_bottom(z, tokens.theme());
        if (b > h) { b = h; }
        layout.put(OV, cur, layout.FLOAT, 1000000, 0, bar_h(), w, b - bar_h());
        return;
    }
    if (mn_open) {
        I64 ox = 8 * sc;
        if (mn_app) { ox = 44 * sc; }                    // under the App pill
        if (ox > w - MW * sc) { ox = w - MW * sc; }
        layout.put(OV, cur, layout.FLOAT, 1000000, ox, bar_h(), MW * sc, (16 + MR * menu_rows()) * sc);
        return;
    }
    I64 k = sw_shown();
    I64 ow = (32 + SW_T * k + 8 * (k - 1)) * sc;          // DN-6 frame 10: one row of tiles, centered on the plane
    I64 oh = SW_H * sc;
    layout.put(OV, cur, layout.FLOAT, 1000000, (w - ow) / 2, bar_h() + (plane_h() - oh) / 2, ow, oh);
}

// Every window into the layout, the active desktop computed: frames and visible rectangles.
void relayout() {
    for i in 0..WINDOWS {
        if (kind[i] != NONE && (tin[i] || lx_host[i])) {
            layout.remove(i);          // SP-2: in the tray, off every desktop; RG-1: a host, on none
        } else if (kind[i] != NONE && i == ra_win && ra_running()) {
            I64[4] t = [wfx[i], wfy[i], wfw[i], wfh[i]];
            I64[4] o;
            winrule.frame_at(anim.progress(anim.OUT, ra_now() - ra_t0, anim.ms(winrule.RESTORE_MS)), ra_from, t, o);
            layout.put(i, wdesk[i], wmode[i], wrank[i], o[0], o[1], o[2], o[3]);
        } else if (kind[i] != NONE) {
            if (i == ra_win) { ra_win = -1; }
            layout.put(i, wdesk[i], wmode[i], wrank[i], wfx[i], wfy[i], wfw[i], wfh[i]);
        }
    }
    if (ov_up()) { overlay(); } else { layout.remove(OV); }
    layout.compute(cur);
}

void print_layout() {
    I64 f = focused();
    I64 dr = layout.direction_of(cur);
    "hdesk: layout desktop {cur} focus {f}";
    if (dr != 0) { " dir {dr}"; }
    if (sc != 1) { " scale {sc}"; }
    "\n";
    for i in 0..16 {
        if (layout.is_live(i)) {
            I64 n = layout.rects(i);
            I64 d = layout.desktop(i);
            I64 m = layout.mode_of(i);
            I64 x = layout.frame_x(i);
            I64 y = layout.frame_y(i);
            I64 fw = layout.frame_w(i);
            I64 fh = layout.frame_h(i);
            I64 r = 1000000;
            if (i < WINDOWS) { r = wrank[i]; }
            "hdesk: win {i} kind {kind[i]} desktop {d} mode {m} rank {r} frame {x},{y} {fw}x{fh} rects {n}";
            for k in 0..n {
                I64 rx = layout.rect_x(i, k);
                I64 ry = layout.rect_y(i, k);
                I64 rw = layout.rect_w(i, k);
                I64 rh = layout.rect_h(i, k);
                " {rx},{ry},{rw}x{rh}";
            }
            "\n";
        }
    }
}

// Pixel window i placed: its surface centered in the content box at its scale, its rectangles the visible ones
// cut to the scaled surface (none off the active desktop or minimized).
// A visible rectangle [x0, x1) x [y0, y1) as place_buf's n-th when not empty and room is left; the count.
I64 put_rect(I64 n, I64 x0, I64 y0, I64 x1, I64 y1) {
    if (x0 >= x1 || y0 >= y1 || n >= 32) { return n; }
    put_word(place_buf, 6 + 4 * n, x0);
    put_word(place_buf, 7 + 4 * n, y0);
    put_word(place_buf, 8 + 4 * n, x1 - x0);
    put_word(place_buf, 9 + 4 * n, y1 - y0);
    return n + 1;
}

void place(I64 i) {
    I64 k = scale_of(i);
    I64 pw = k * surf_w(i);
    I64 ph = k * surf_h(i);
    I64 sx = cbx(i) + (cbw(i) - pw) / 2 + sl_dx;   // MS-7: moved with its desktop mid slide
    I64 sy = cby(i) + (cbh(i) - ph) / 2;
    I64 n = 0;
    if (shown(i) && layout.rects(i) > 0 && !sh_sel && !any_moving()) {   // RS-SHOT: nothing copied over the held
        // screen; MS-8: off while windows move, placed again at rest
        for q in 0..layout.rects(i) {
            I64 x0 = max(layout.rect_x(i, q) + sl_dx, 0);
            I64 y0 = layout.rect_y(i, q);
            I64 x1 = min(layout.rect_x(i, q) + layout.rect_w(i, q) + sl_dx, w);
            I64 y1 = y0 + layout.rect_h(i, q);
            if (x0 < sx) { x0 = sx; }
            if (y0 < sy) { y0 = sy; }
            if (x1 > sx + pw) { x1 = sx + pw; }
            if (y1 > sy + ph) { y1 = sy + ph; }
            if (sheet_blocks(i)) {         // DN-43: the client's surface stays off its sheet (review on PR 272)
                I64[16] pc;
                I64 np = sheet_around(i, x0, y0, x1, y1, pc);
                for pi in 0..np { n = put_rect(n, pc[4 * pi], pc[4 * pi + 1], pc[4 * pi + 2], pc[4 * pi + 3]); }
            } else if (tip_on && tr_open) {   // SP-7: the client's surface stays off the tooltip
                I64 tx1 = tip_x + tip_w;
                I64 ty1 = tip_y + tooltip.H * sc;
                n = put_rect(n, x0, y0, x1, min(y1, tip_y));
                n = put_rect(n, x0, max(y0, ty1), x1, y1);
                n = put_rect(n, x0, max(y0, tip_y), min(x1, tip_x), min(y1, ty1));
                n = put_rect(n, max(x0, tx1), max(y0, tip_y), x1, min(y1, ty1));
            } else {
                n = put_rect(n, x0, y0, x1, y1);
            }
        }
    }
    if (sh_up) { n = sh_cut(n); }      // RS-SHOT: the client's surface stays off the shot's plate
    put_word(place_buf, 0, pid[i]);
    put_word(place_buf, 1, sx);
    put_word(place_buf, 2, sy);
    place_buf[12] = k as U8;
    place_buf[13] = 0;
    place_buf[14] = n as U8;
    place_buf[15] = 0;
    I64 st = tileplace.tile_place(place_buf[0..24 + 16 * n]);
    if (!sl_pass && !any_moving()) {   // MS-7, MS-8: a placement hidden for motion is named at rest
        "hdesk: place {i} at {sx},{sy} scale {k} rects {n} ({st})\n";
    }
}

// FONT-1 (K-2b): row r of terminal slot s into tline8 as UTF-8, a cell's code point as the screen draws it, the
// trailing blanks dropped as terms.text_of drops them; its length.
I64 row_utf8(I64 s, I64 r) {
    I64 n = terms.text_of(s, r, tline);
    I64 at = 0;
    for c in 0..n {
        I64 p = tline[c] as I64;
        if (tline[c] == '?') { p = terms.code(s, r, c); }
        if (p < 0x80) {
            tline8[at] = p as U8;
            at = at + 1;
        } else if (p < 0x800) {
            tline8[at] = (0xC0 | (p >> 6)) as U8;
            tline8[at + 1] = (0x80 | (p & 0x3F)) as U8;
            at = at + 2;
        } else if (p < 0x10000) {
            tline8[at] = (0xE0 | (p >> 12)) as U8;
            tline8[at + 1] = (0x80 | ((p >> 6) & 0x3F)) as U8;
            tline8[at + 2] = (0x80 | (p & 0x3F)) as U8;
            at = at + 3;
        } else {
            tline8[at] = (0xF0 | (p >> 18)) as U8;
            tline8[at + 1] = (0x80 | ((p >> 12) & 0x3F)) as U8;
            tline8[at + 2] = (0x80 | ((p >> 6) & 0x3F)) as U8;
            tline8[at + 3] = (0x80 | (p & 0x3F)) as U8;
            at = at + 4;
        }
    }
    return at;
}

// The bar's row y into `row`: the bar's ground, the mark, the App Title and pid of the focused window, desktops 1..9
// centered (the active one in the bar's slot, an occupied one framed), the bar's hairline on the last row (K-3, D-5).
U32 tok(I64 t) { return tokens.word(t); }

// FONT-1 (docs/specs/2026-11-07-k-kit2.md section 3e): the chrome's text is kit/ctext.ci's, by the roles of
// kit/faces.ci, at 1x as the rest of the chrome (spread by the UI scale). A line keeps the 16 px slot of the 8 x 16
// face, its top y0 and its baseline TBASE below, where every glyph of the 13 px and 12 px faces and the 11 px labels
// inks inside the slot. s[0..n] in role f from x0 on row y, none past x1; the pen.
const I64 TBASE = 13;
I64 txt(I64 y, I64 x0, I64 y0, I64 x1, in U8[_] s, I64 n, U32 c, I64 f) {
    return ctext.text(row, y, x0, y0 + TBASE, x1, s, n, c, f, 1);
}

// The width of s[0..n] in role f at 1x.
I64 txt_w(in U8[_] s, I64 n, I64 f) { return ctext.width(s, n, f, 1); }

// FONT-2 A (docs/specs/2026-11-07-k-kit2.md section 3i): the chrome draws its 1x geometry at a zoom through
// kit/pen.ci, natively at 2x: tz() at the UI scale (2 at an even one, 1 at an odd one), spread by sc / tz() as the
// terminal is (3x stays the 1x drawing spread by 3, since 2 does not divide it). txt through the pen: s[0..n] in role
// f from 1x x0, the 16 px slot's top y0, none past 1x x1, on the pen's row; the device pen.
I64 ptxt(I64 x0, I64 y0, I64 x1, in U8[_] s, I64 n, U32 c, I64 f) {
    return pen.text(row, x0, y0 + TBASE, x1, s, n, c, f);
}

// The same centered in the 1x span from x0 by its width at the zoom.
I64 ptxt_mid(I64 x0, I64 span, I64 y0, I64 x1, in U8[_] s, I64 n, U32 c, I64 f) {
    return pen.text_mid(row, x0, span, y0 + TBASE, x1, s, n, c, f);
}

Bool occupied(I64 d) {
    for i in 0..WINDOWS {
        if (listed(i) && wdesk[i] == d) { return true; }
    }
    return false;
}

// The color of grant word g (HX-6 item 1, WB-5's rings): ochre for the disk grant (ring 1), sienna for the
// network's (ring 2); -1 for none (the disk grant first: the grant tool sets one).
I64 grant_tok(I64 g) {
    if ((g & GRANT_KERN) != 0) { return tokens.CADMIUM; }   // R0-3: ring 0
    if ((g & 1) != 0) { return tokens.OCHRE; }
    if ((g & 2) != 0) { return tokens.SIENNA; }
    return -1;
}

// WB-5 (agy's ring table): a window's ring color, its grant's or ultramarine (ring 3, no grant); a focused window's
// outline and bar take it. Ring 0 is the kernel's: no window has it, and cadmium stays for faults (KD-4 A).
I64 ring_tok(I64 g) {
    I64 t = grant_tok(g);
    if (t < 0) { return tokens.ULTRAMARINE; }
    return t;
}

// A focused bar's ground for ring color r (ring 3's bar is the fill, its outline ultramarine) and the type on it.
I64 ring_fill(I64 r) {
    if (r == tokens.ULTRAMARINE) { return tokens.FILL; }
    return r;
}
I64 ring_type(I64 r) {
    if (r == tokens.OCHRE) { return tokens.ON_OCHRE; }
    return tokens.ON_FILL;
}

// The grant word of desktop d's windows together.
I64 desk_grant(I64 d) {
    I64 g = 0;
    for i in 0..WINDOWS {
        if (listed(i) && wdesk[i] == d) { g = g | gw[i]; }
    }
    return g;
}

// K-5: grant g's count, `DISK n`, `NET n` or `KERN n Xm`, at dst[0]; its length. DN-72 (l 2026-11-12 08:12Z): the bar
// draws no grant pill; the `hdesk: bar` line alone carries it, for the gates.
I64 pill_text(I64 g, inout U8[_] dst) {
    if (g == GRANT_KERN) {
        for k in 0..5 { dst[k] = b"KERN "[k]; }
        I64 n = digits(dst, 5, n_kern);
        if (kern_m == 0) {
            for k in 0..4 { dst[n + k] = b" <1m"[k]; }
            return n + 4;
        }
        if (kern_m > 0) {
            dst[n] = ' ';
            n = digits(dst, n + 1, kern_m);
            dst[n] = 'm';
            return n + 1;
        }
        return n;
    }
    if (g == 1) {
        for k in 0..5 { dst[k] = b"DISK "[k]; }
        return digits(dst, 5, n_disk);
    }
    for k in 0..4 { dst[k] = b"NET "[k]; }
    return digits(dst, 4, n_net);
}

// The 1x geometry of the bar's slots for a bar ww wide, right to left from 8 px in: the clock, the panel's squares,
// the tray's chevron, AUTH (DN-72: no grant pill).
// FONT-1: the bar's slots right of the desktops keep the spans the 8 x 16 face gave them, CELL px a byte and 16, so
// the pointer's targets stay put, each pill's text centered in its slot; the App Title's pill, fixed at 44, is its
// text's width and 16 (Inter's m and w are wider than a cell).
const I64 CELL = 8;
void bar_geom(I64 ww) {
    app_w = 0;
    if (bar_len > 0) { app_w = txt_w(bar_now, bar_len, faces.NAME) + 16; }   // l 11-08 14:42Z: no icon, no chevron
    clk_w = CELL * clk_len + 16;
    clk_x = ww - 8 - clk_w;
    sp_x = clk_x - 8 - 24;                       // SP-1: the four squares, left of the clock
    tr_w = 24;                   // DN-14: the chevron's 24 px slot, 8 px left of the panel's, always shown
    tr_x = sp_x - 8 - tr_w;
    auth_w = 0;
    if (bar_auth) {
        auth_w = face.W * 4 + 16;              // AC-D1: AUTH, left of the chevron, while a passphrase field is live
        auth_x = tr_x - 8 - auth_w;
    }
}

I64 auth_x = 0;
I64 auth_w = 0;

// DN-41 (a): what the bar shows on screen scr (SCR_NONE: a session): the roundel and the clock always; in a session
// also the App pill, the desktops, AUTH on a prompt (DN-72: no grant pill), the panel's squares and the tray; on login,
// lock and first boot (and a broken store) nothing else.
const I64 BAR_ROUNDEL = 1;
const I64 BAR_CLOCK = 2;
const I64 BAR_APP = 4;
const I64 BAR_DESKS = 8;
const I64 BAR_PILLS = 16;
const I64 BAR_PANEL = 32;
const I64 BAR_TRAY = 64;
I64 bar_items(I64 scr) {
    if (scr != 0) { return BAR_ROUNDEL | BAR_CLOCK; }
    return BAR_ROUNDEL | BAR_CLOCK | BAR_APP | BAR_DESKS | BAR_PILLS | BAR_PANEL | BAR_TRAY;
}

// A slot [x0, x0 + pw) on bar row y with its text 8 px in: filled the bar's full height in token bg, or (-1) the
// bar's own ground with no frame (WB-7, l 2026-11-08 00:34Z: the bar has no lines).
void pill(I64 y, I64 x0, I64 pw, in U8[_] t, I64 n, I64 bg, I64 fg, I64 f) {
    if (bg >= 0) { pen.rect(row, x0, 0, x0 + pw, layout.BAR, tok(bg)); }
    I64 e = ptxt_mid(x0, pw, 6, x0 + pw, t, n, tok(fg), f);   // centered in the slot, cut at its end (FONT-2 A)
}

// Bar row y at 1x across ww pixels, drawn through the pen at its zoom (FONT-2 A) and spread by the rest of the UI
// scale: the color mark, the App pill and the variable, the desktops, the grant pills, the clock; no rules (WB-7).
// DN-41 (a): on login, lock and first boot no status pill (DISK, NET, KERN, AUTH), no panel squares, no tray: the
// roundel at the left and the clock at the right. In a session the AUTH pill stays on a passphrase prompt.
void bar_row(I64 y, I64 ww) {
    pen.paint(row, 0, ww, tok(tokens.BAR));
    if ((bar_items(ac_screen) & BAR_PILLS) == 0) {   // DN-41 (a): an account screen: the clock (and the roundel)
        pill(y, clk_x, clk_w, clk_now, clk_len, -1, tokens.INK, faces.PATH);
        return;
    }
    I64 x0 = (ww - 9 * 24) / 2;
    if (app_w > 0) {
        pill(y, 44, app_w, bar_now, bar_len, -1, tokens.INK, faces.NAME);
        I64 e = ptxt(44 + app_w + 12, 6, x0 - 8, bar_var[0..bar_vl], bar_vl, tok(tokens.INK_DIM), faces.PATH);
    }
    for d in 1..10 {
        if (!strip_on()) { break; }        // FF 3g: the strip hidden by default
        I64 dx = x0 + (d - 1) * 24;
        U8[1] dg;
        dg[0] = (48 + d) as U8;
        I64 fg = tokens.INK;
        if (d == cur) {
            pen.round(row, dx + 1, 4, dx + 23, 24, 10, tok(tokens.FILL));   // FF 3g: this desktop, a pill
            fg = tokens.ON_FILL;
        } else if (occupied(d)) {
            pen.rect(row, dx + 11, 24, dx + 13, 26, tok(tokens.INK));   // a desktop with windows: a 2 x 2 dot
        }
        I64 e = ptxt_mid(dx, 24, 6, dx + 24, dg, 1, tok(fg), faces.NAME);   // centered in its 24 px cell
        I64 gt = grant_tok(desk_grant(d));
        if (gt >= 0) { pen.rect(row, dx + 18, 4, dx + 22, 8, tok(gt)); }   // the 4 x 4 pip (E2-1)
    }
    if (auth_w > 0) {
        I64 ac = tokens.FILL;                  // AC-D1: ring 3 for the account screens, the prompt's ring for it
        if (kp_open && kp_field) { ac = kp_color(); }
        pill(y, auth_x, auth_w, b"AUTH", 4, ac, ring_type(ac), faces.BODY);
    }
    if (sp_open) { pen.rect(row, sp_x, 0, sp_x + 24, layout.BAR, tok(tokens.BAR_SLOT)); }
    if (tr_open) { pen.round(row, tr_x, 4, tr_x + 24, 24, R_CTRL, tok(tokens.BAR_SLOT)); }   // DN-14: 24 x 20, radius 6
    U32 ci = tok(tokens.INK);
    if (n_tray == 0) { ci = blend.mix_px(tok(tokens.BAR), tok(tokens.INK_DIM), 128); }   // empty: INK_DIM at 50 percent
    chevron(y, tr_x + 12, 14, turn, ci);
    if (y >= 6 && y < 22) {
        I64 iy = y - 6;                          // SP-1: agy's 16 px icon, four 6 x 6 squares, ring 3, 2, 1, 0
        if (iy >= 1 && iy < 7) {
            pen.rect(row, sp_x + 5, 0, sp_x + 11, layout.BAR, tok(tokens.ULTRAMARINE));
            pen.rect(row, sp_x + 13, 0, sp_x + 19, layout.BAR, tok(tokens.SIENNA));
        }
        if (iy >= 9 && iy < 15) {
            pen.rect(row, sp_x + 5, 0, sp_x + 11, layout.BAR, tok(tokens.OCHRE));
            pen.rect(row, sp_x + 13, 0, sp_x + 19, layout.BAR, tok(tokens.CADMIUM));
        }
    }
    if (cal_open) {                    // frame 44: under the open calendar the clock sits on a pill 22 high, radius 11
        pen.round(row, clk_x, 3, clk_x + clk_w, 25, 11, tok(tokens.BAR_SLOT));
    }
    pill(y, clk_x, clk_w, clk_now, clk_len, -1, tokens.INK, faces.PATH);
}

// Digits of v >= 0 at dst[at]; the end.
I64 digits(inout U8[_] dst, I64 at, I64 v) {
    U8[20] dg;
    I64 n = 0;
    I64 q = v;
    if (q == 0) { dg[0] = '0'; n = 1; }
    while (q > 0) {
        dg[n] = (48 + q % 10) as U8;
        q = q / 10;
        n = n + 1;
    }
    for k in 0..n { dst[at + k] = dg[n - 1 - k]; }
    return at + n;
}

// v as two digits, 0 padded, at dst[at]; the end.
I64 two(inout U8[_] dst, I64 at, I64 v) {
    dst[at] = (48 + v / 10 % 10) as U8;
    dst[at + 1] = (48 + v % 10) as U8;
    return at + 2;
}

// K-6: the date again (FBIO_TILE_INFO kind 2, its u64 at byte 16).
void date() {
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 2, 0, ask[0..64]);
    if (st == 0) { now_s = word_at(ask, 4) | (word_at(ask, 5) << 32); }
}

// Day `days`'s weekday and month names and day at dst[at], `Www Mmm D`; the end.
I64 day_text(inout U8[_] dst, I64 at, I64 days) {
    I64[4] v;
    civil.from_days(days, v);
    for k in 0..3 { dst[at + k] = b"SunMonTueWedThuFriSat"[3 * v[3] + k]; }
    dst[at + 3] = ' ';
    for k in 0..3 { dst[at + 4 + k] = b"JanFebMarAprMayJunJulAugSepOctNovDec"[3 * (v[1] - 1) + k]; }
    dst[at + 7] = ' ';
    return digits(dst, at + 8, v[2]);
}

// The clock (E2-1), `Www Mmm D  HH:MM`, at dst[0]; its length.
I64 clock_text(inout U8[_] dst) { return clocktext.bar(dst, 0, ck_zone, now_s, ck_h24); }

// RS-TZb: what the bar clock and the calendars read: the machine's zone file (none: UTC) and the session account's
// 24-Hour Time and Week Starts On, from its settings as its own run read them (RG-1, pf_load: the desk cannot open a
// 0700 home); at boot, at a session's start and end, each minute, with the page and when that read ends. The clock
// prints again when either changed.
void clock_prefs() {
    ck_zone = zonefile.city();
    ck_h24 = false;
    ck_week = 0;
    U8[64] home;
    I64 hn = session_home(home);
    if (hn > 0 && pf_load() >= 0) {
        ck_h24 = settings.num(b"time.24-hour", 0) == 1;
        if (settings.num(b"calendar.week-starts", 0) == 1) { ck_week = 1; }   // anything else is Sunday
    }
}

// now_s on the wall clock of the machine's zone (kit/clocktext.ci local_s): its / 86400 is the local day.
I64 now_l() { return clocktext.local_s(ck_zone, now_s); }

// Window i's variable (HX-6: a terminal's OSC 2 title, a pixel client's FBIO_TILE_VAR, WVAR bytes) at v[0]; its length.
I64 var_of(I64 i, inout U8[256] v) {
    I64 vl = 0;
    if (kind[i] == TERM) { vl = terms.var_of(slot[i], v); }
    if (kind[i] == PIXEL) {               // printable ASCII and UTF-8's bytes (Index audit: /home/ci/Café read "Caf")
        while (vl < WVAR && wvar[WVAR * i + vl] >= 32 && wvar[WVAR * i + vl] != 127) {
            v[vl] = wvar[WVAR * i + vl];
            vl = vl + 1;
        }
        I64 c = vl;                       // a code point the WVAR bytes cut is left out whole
        while (c > 0 && (v[c - 1] & 0xC0) == 0x80) { c = c - 1; }
        if (c > 0 && v[c - 1] >= 0xC0) {
            I64 need = 2;
            if (v[c - 1] >= 0xE0) { need = 3; }
            if (v[c - 1] >= 0xF0) { need = 4; }
            if (vl - (c - 1) < need) { vl = c - 1; }
        }
    }
    return vl;
}

// The grant words of every window again (FBIO_TILE_INFO); true when one changed, printing `hdesk: grant i G`.
Bool grants() {
    Bool changed = false;
    for i in 0..WINDOWS {
        if (listed(i)) {
            I64 g = gw[i];
            if (info(i) && gw[i] != g) {
                "hdesk: grant {i} {gw[i]}\n";
                changed = true;
            }
        }
    }
    if (changed && sp_open) { sp_read(); }   // DN-6 frame 9: the open panel's grant rows follow (its next paint)
    return changed;
}

// The bar (K-5): the focused window's title and variable, the grant counts, the clock and the calendar's state; drawn
// and printed when one changed or `force`.
// FF 3g: the desktop strip 1..9 shows while the Super plane is open and for STRIP_HOLD_MS after a desktop switch.
Bool strip_on() { return pl_open || strip_sw; }

// A switch since the bar drew last shows the strip; true if it did.
Bool strip_note() {
    if (cur == strip_desk) { return false; }
    strip_desk = cur;
    strip_sw = true;
    strip_t0 = wall.wall_ns();
    strip_k = 0;
    "hdesk: strip shown {cur}\n";
    return true;
}

// The hold over (wall time, or STRIP_HOLD_MS / 10 stepped frames): the strip hides.
void strip_tick(Bool step) {
    if (!strip_sw) { return; }
    if (step) { strip_k = strip_k + 1; }
    if ((stepped && strip_k * 10 >= STRIP_HOLD_MS) || (!stepped && wall.wall_ns() - strip_t0 >= STRIP_HOLD_MS * 1000000)) {
        strip_sw = false;
        "hdesk: strip hidden\n";
        paint_bar();
    }
}

void bar(Bool force) {
    gr_track();                        // frame 21: when each grant was first seen
    Bool sw = strip_note();
    U8[16] t;
    U8[256] v;
    I64 n = 0;
    I64 vl = 0;
    I64 f = focused();
    if (f >= 0 && f < WINDOWS && ac_screen == 0 && info(f)) {   // L4: a locked desk names no window
        n = win_name(f, t);           // DN-23: an app's friendly name
        if (kind[f] != SETTINGS && kind[f] != FAULT) { vl = var_of(f, v); }
        if (kind[f] == SETTINGS) { vl = stside.name(stbox.page(), v); }   // frames 21, 31: Settings  Grants
    }
    I64 nd = 0;
    I64 nn = 0;
    I64 nk = 0;
    I64 km = -1;
    for i in 0..WINDOWS {
        if (listed(i) && (gw[i] & 1) != 0) { nd = nd + 1; }
        if (listed(i) && (gw[i] & 2) != 0) { nn = nn + 1; }
        if (listed(i) && (gw[i] & GRANT_KERN) != 0) {
            nk = nk + 1;
            I64 m = (whold[i] + 59) / 60;
            if (whold[i] > 0 && whold[i] < 60) { m = 0; }
            if (whold[i] > 0 && (km < 0 || m < km)) { km = m; }
        }
    }
    U8[24] ct;
    I64 cn = clock_text(ct);
    Bool tick = cn != clk_len;
    for k in 0..cn {
        if (!tick && ct[k] != clk_now[k]) { tick = true; }
    }
    if (tick) {
        for k in 0..cn { clk_now[k] = ct[k]; }
        clk_len = cn;
        "hdesk: clock |";
        I64 pc = ptyctl.pty_write(1, clk_now[0..cn]);
        "|\n";
    }
    Bool same = n == bar_len && vl == bar_vl && nd == n_disk && nn == n_net && nk == n_kern && km == kern_m &&
        cal_open == bar_cal && sp_open == bar_sp && n_tray == bar_tr && !tick && auth_live() == bar_auth;
    for k in 0..n {
        if (same && t[k] != bar_now[k]) { same = false; }
    }
    for k in 0..vl {
        if (same && v[k] != bar_var[k]) { same = false; }
    }
    if (same && !force && !sw) { return; }
    for k in 0..n { bar_now[k] = t[k]; }
    bar_len = n;
    for k in 0..vl { bar_var[k] = v[k]; }
    bar_vl = vl;
    n_disk = nd;
    n_net = nn;
    n_kern = nk;
    kern_m = km;
    bar_cal = cal_open;
    bar_sp = sp_open;
    bar_auth = auth_live();
    bar_geom(w / sc);
    tray_line();
    U8[24] p;
    "hdesk: bar desktop {cur} |";
    I64 put = ptyctl.pty_write(1, bar_now[0..n]);
    "| var |";
    U8[256] lv;                                     // RS-TTL section 2a: the program's word, ASCII with no '|'
    I64 ln = bartitle.logged(bar_var, vl, lv);
    I64 put2 = ptyctl.pty_write(1, lv[0..ln]);
    "| grants |";
    if (nk > 0) {
        I64 pk = pill_text(GRANT_KERN, p);
        I64 put5 = ptyctl.pty_write(1, p[0..pk]);
        if (nd > 0 || nn > 0) { "  "; }
    }
    if (nd > 0) {
        I64 pn = pill_text(1, p);
        I64 put3 = ptyctl.pty_write(1, p[0..pn]);
    }
    if (nd > 0 && nn > 0) { "  "; }
    if (nn > 0) {
        I64 pn = pill_text(2, p);
        I64 put4 = ptyctl.pty_write(1, p[0..pn]);
    }
    "|\n";
    paint_bar();
}

// The bar's rows to the screen.
void paint_bar() {
    if (sh_sel) { return; }            // RS-SHOT: the select's screen stays as it is held
    Bool was = arrow_off(0, bar_h());
    I64 z = tz();
    for y in 0..bar_h() {
        draw.paint(row, 0, w, tok(tokens.BAR));
        pen.at(0, 0, z, y / (sc / z));          // FONT-2 A: at 2x the bar is drawn at device pixels
        bar_row(y / sc, w / sc);
        expand_by(0, w / sc * z, sc / z);
        mark_row(y);
        I64 a = tilectl.fb_span(y, 0, row[0..w]);
    }
    arrow_back(was);
}

// AA-1: the bar's mark, the Albers d roundel, 20 px a side at 1x from (9, 4), drawn at the screen's scale (not
// spread) over the bar's ground, 64 samples a pixel. Its pixels are kept for the scale and theme they were made in.
U32[6400] mk_px;
I64 mk_key = -1;

void mark_row(I64 y) {
    I64 n = 20 * sc;
    if (n > 80 || y < 4 * sc || y >= 4 * sc + n) { return; }
    I64 key = sc * 2 + (tok(tokens.BAR) as I64) * 16;
    if (key != mk_key) {
        for j in 0..n { for i in 0..n { mk_px[j * n + i] = roundel.px(n, i, j, tok(tokens.BAR)); } }
        mk_key = key;
    }
    I64 j = y - 4 * sc;
    for i in 0..n { draw.put(row, 9 * sc + i, mk_px[j * n + i]); }
}

// SP-2, SP-3: `hdesk: tray bar N turn K open O` when the chevron's count, frame or state changed (tools/check-hdesk.py
// draws the chevron from it).
void tray_line() {
    I64 o = 0;
    if (tr_open) { o = 1; }
    if (n_tray == bar_tr && turn == bar_turn && o == bar_tro) { return; }
    bar_tr = n_tray;
    bar_turn = turn;
    bar_tro = o;
    "hdesk: tray bar {n_tray} turn {turn} open {o}\n";
}

// DN-49: whether the OV window draws the Super plane's scrim and plate now (widget_row's order: an account screen, the
// kern prompt, the unsaved ask and the revert prompt come before it, each on its own ground; the picker is opaque).
Bool plane_drawn() {
    return pl_open && !plane.picker_on() && ac_screen == SCR_NONE && !kp_open && !ask_up() && !rv_open &&
        !keysheet.is_up();
}

// Window i's part of plane row y into `row`, over what is there.
// Window i on row y: its body, then (WB-7) a float's rounded corners over what lay under them, and a resting
// tile's grant pip.
void win_row_span(I64 i, I64 y, I64 xa, I64 xb) {
    I64 fx0 = layout.frame_x(i);
    I64 fy0 = layout.frame_y(i);
    I64 fx1 = fx0 + layout.frame_w(i);
    I64 fy1 = fy0 + layout.frame_h(i);
    if (i < WINDOWS && !about.blocks(i) && !noanswer.blocks(i) && (y < fy0 || y >= fy1 || fx1 <= xa || fx0 >= xb)) {
        return;                        // MS-R5: nothing of window i on row y within [xa, xb)
    }
    Bool round = (tb(i) > 0 ||
                  (i == OV && (kp_open || sp_open || tr_open || msg_up() || sw_open || rv_open || ask_up() ||
                               keysheet.is_up()))) &&
        rounds(i, y);
    if (round) { keep_at(fx0, fx1, rad_of(i) * sc); }
    win_body_span(i, y, xa, xb);
    if (round) { cut_corners(i, y); }
    if (about.blocks(i)) { about.row_at(row, y, am_z(), tokens.theme()); }   // DN-43: the sheet over it, no dim (DN-69)
    if (noanswer.blocks(i)) { noanswer.row_at(row, y, am_z(), tokens.theme()); }   // DN-51 frame 25
    I64 gt = grant_tok(gw[i]);
    if (i < WINDOWS && tb(i) == 0 && i != focused() && gt >= 0 && (kind[i] == TERM || kind[i] == PIXEL)) {
        draw.rect(row, y, fx1 - 10 * sc, fy0 + 6 * sc, fx1 - 6 * sc, fy0 + 10 * sc, tok(gt));   // the ring's 4 x 4 pip
    }
}

void win_row(I64 i, I64 y) { win_row_span(i, y, 0, w); }

// WB-7, DN-6: window i's corner radius at 1x: RAD, a prompt's R_PLATE.
I64 rad_of(I64 i) {
    if (i == OV && (kp_open || sp_open || rv_open || ask_up())) { return R_PLATE; }
    if (i == OV && keysheet.is_up()) { return keysheet.RAD; }   // frame 27
    if (i == OV && sw_open && !mn_open && !cal_open && !tr_open && !pl_open) { return 16; }   // DN-6 frame 10
    if (i == OV && msg_up()) { return MSG_H / 2; }
    return RAD;
}

// MS-4 (MS section 3; DN-6, board 20261110T053139Z): window i's shadow level, 0 for none. A float (Settings among
// them) is Mid focused and Low at rest; the elevation and revert prompts, the system panel and the switcher's plate
// High; the bar message Low; the tray, the menus, the calendar and the plane none. A surface casts only where it is
// drawn rounded (rounds): whole on the screen, not maximized, its two corners across and within `under`.
I64 cast_level(I64 i) {
    I64 lv = 0;
    if (i == OV) {
        if (kp_open || rv_open || sp_open || keysheet.is_up()) {   // frame 27's sheet High too
            lv = 3;
        } else if (sw_open && !mn_open && !cal_open && !tr_open && !pl_open) {
            lv = 3;
        } else if (msg_up()) {
            lv = 1;
        }
    } else if (tb(i) > 0) {
        lv = 1;
        if (i == focused()) { lv = 2; }
    }
    if (lv == 0) { return 0; }
    I64 r = rad_of(i) * sc;
    I64 x0 = layout.frame_x(i);
    I64 x1 = x0 + layout.frame_w(i);
    I64 fh = layout.frame_h(i);
    if (2 * r > len(under) || x0 < 0 || x1 > w || x1 - x0 < 2 * r || fh < 2 * r || (x0 == 0 && x1 == w)) {
        return 0;
    }
    return lv;
}

// MS-4: window i's shadow on plane row y over [lo, hi) of `row` (MS-3's shade_row toward the theme's shadow color;
// nothing without tables for its radius at this scale, nothing on the bar).
void cast_row(I64 i, I64 y, I64 lo, I64 hi) {
    if (y < bar_h()) { return; }
    I64 lv = cast_level(i);
    if (lv == 0) { return; }
    I64 x0 = layout.frame_x(i);
    I64 y0 = layout.frame_y(i);
    if (i == OV && plate_moving()) {           // MS-5: an opening plate's shadow, scaled and faded with it
        I64 p = anim.value(an5_get(0), pt());
        cast_plate(x0, y0, x0 + layout.frame_w(i), y0 + layout.frame_h(i), rad_of(i) * sc, lv, ov_kind, p, y, lo,
                   hi);
        return;
    }
    shade.shade_row(row, lo, hi, y, x0, y0, x0 + layout.frame_w(i), y0 + layout.frame_h(i), rad_of(i), lv,
                    tokens.theme(), sc);
}

// MS-4: whether window i's shadow can reach [lo, hi) of row y: its frame grown by its level's reach.
Bool falls_on(I64 i, I64 y, I64 lo, I64 hi) {
    I64 lv = cast_level(i);
    if (lv == 0) { return false; }
    I64 x0 = layout.frame_x(i);
    I64 y0 = layout.frame_y(i);
    return shade.reaches(y, lo, hi, x0, y0, x0 + layout.frame_w(i), y0 + layout.frame_h(i), lv, tokens.theme(), sc);
}

// MS-4: the stacking key of a painted window, paint_rows's order: its layer, then its index among equal layers.
I64 stack_key(I64 i) { return 16 * layer_of(i) + i; }

// MS-4: whether any window painted above window i casts a shadow at all, tested once per term_rows call so a
// terminal under no caster pays nothing per span.
Bool caster_above(I64 i) {
    if (pl_open) { return false; }
    I64 k = stack_key(i);
    for j in 0..16 {
        if (((j == OV && ov_up()) || (j != OV && shown(j))) && stack_key(j) > k && cast_level(j) > 0) { return true; }
    }
    return false;
}

// MS-4: the shadows of the windows painted above window i on row y, bottom first, over [lo, hi) of `row`, for a
// terminal's rows drawn straight to the screen (term_rows); whether any could fall there.
Bool shade_above(I64 i, I64 y, I64 lo, I64 hi) {
    if (y < bar_h() || pl_open) { return false; }
    Bool any = false;
    I64 last = stack_key(i);
    Bool more = true;
    while (more) {
        I64 next = -1;
        for j in 0..16 {
            if (((j == OV && ov_up()) || (j != OV && shown(j))) && stack_key(j) > last &&
                (next < 0 || stack_key(j) < stack_key(next))) {
                next = j;
            }
        }
        if (next < 0) {
            more = false;
        } else {
            last = stack_key(next);
            if (falls_on(next, y, lo, hi)) {
                cast_row(next, y, lo, hi);
                any = true;
            }
        }
    }
    return any;
}

// DN-6 frame 9: the bar message holds the OV window (nothing else is up there).
// DN-24: only one surface wears a colored bar and ring at a time, the focused one; while a prompt is up (the kern
// or approval prompt, the revert prompt) the prompt is that surface and every window behind it draws at rest.
Bool prompt_up() { return kp_open || rv_open || ask_up(); }

// An ask on the OV plate: AM section 7's unsaved ask or RS-AQ's account form.
Bool ask_up() { return unsaved.is_up() || acctform.is_up() || indextrash.is_up(); }

Bool lit_of(Bool focus, Bool prompt) { return focus && !prompt; }

// MS-5 (MS section 4; kit/plate.ci): the plates' open and close and the bar message's in and out. The plate up now
// is one of these kinds; an5's first motion is its progress (0 shut, 1000 open). A plate that goes is drawn on from its record
// (gh_*) while it fades, its state already flipped; any plate that opens ends that record. With no motion running
// nothing here runs, so a screen at rest is what it was before MS-5.
const I64 K_PROMPT = 1;     // the elevation prompt
const I64 K_REVERT = 2;     // DN-10's revert prompt
const I64 K_PANEL = 3;      // the system panel
const I64 K_SWITCH = 4;     // the switcher's plate
const I64 K_MSG = 5;        // the bar message
I64[10] an5 = [0, 0, 1000, 1000, 0, 0, 0, 0, 0, 0];   // the two motions, 5 fields each (anim.Anim): 0 the plate up, 1 the plate going

anim.Anim an5_get(I64 k) {
    anim.Anim a = anim.rest(0);
    a.t0 = an5[5 * k];
    a.dur = an5[5 * k + 1];
    a.from = an5[5 * k + 2];
    a.to = an5[5 * k + 3];
    a.curve = an5[5 * k + 4];
    return a;
}

void an5_put(I64 k, anim.Anim a) {
    an5[5 * k] = a.t0;
    an5[5 * k + 1] = a.dur;
    an5[5 * k + 2] = a.from;
    an5[5 * k + 3] = a.to;
    an5[5 * k + 4] = a.curve;
}

I64 ov_kind = 0;
I64 pv_x = 0;               // the plate up now: its frame, kept for its record when it goes
I64 pv_y = 0;
I64 pv_w = 0;
I64 pv_h = 0;
I64 gh_kind = 0;            // the plate going, 0 none
I64 gh_x = 0;
I64 gh_y = 0;
I64 gh_w = 0;
I64 gh_h = 0;
I64 gh_top = 0;             // the rows and span it and its shadow cover
I64 gh_bot = 0;
I64 gh_left = 0;
I64 gh_right = 0;
I64 ms5_steps = 0;          // the gates' stepped frames for this motion (SP-3)
I64 mo_base = 0;            // MS-9a: ms5_steps when the motion under way began (none was running before it)
I64 mo_n = 0;               // MS-9a: how many motions have begun, so each step line is the transcript's only one
Bool ms5_live = false;      // frames are owed: motion ran since the last frame drawn at rest

// MS-9a: a motion on the motion clock (MS-5's plates, MS-8's windows) begins; when none ran before it, the gates count
// its steps from here (`hdesk: step N`). MS-7's slide keeps its own clock and step line (`hdesk: slide step`).
// ms8_live is declared below; it is only read here.
void mo_begin() {
    if (!ms5_live && !ms8_live) {
        mo_base = ms5_steps;
        mo_n = mo_n + 1;
    }
}

// The plate up now by kind, in widget_row's order, or 0 (the plane, the calendar, the tray, a menu: no MS-5 motion).
I64 up_kind() {
    if (kp_open) { return K_PROMPT; }
    if (rv_open) { return K_REVERT; }
    if (pl_open || cal_open) { return 0; }
    if (sp_open) { return K_PANEL; }
    if (tr_open) { return 0; }
    if (msg_up()) { return K_MSG; }
    if (mn_open) { return 0; }
    if (sw_open) { return K_SWITCH; }
    return 0;
}

// A plate kind's corner radius at 1x (rad_of's) and its shadow's level (cast_level's).
I64 kind_rad(I64 k) {
    if (k == K_SWITCH) { return 16; }
    if (k == K_MSG) { return MSG_H / 2; }
    return R_PLATE;
}

I64 kind_level(I64 k) {
    if (k == K_MSG) { return 1; }
    return 3;
}

// The motion's clock: CLOCK_BOOTTIME, or on the gates' stepped clock a step a Shift press.
I64 pt() {
    if (stepped) { return anim.steps(ms5_steps); }
    return wall.wall_ns();
}

// Whether rows [a, b) meet a shown pixel client's surface. paint_rows paints whole rows and only place() puts a
// pixel client back, so a plate in motion there would hide the client between its frames: such a plate opens and
// closes at once (MS-R3 A: shadows stop at a pixel client's surface; so does motion).
Bool pixel_rows(I64 a, I64 b) {
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL && shown(i)) {
            I64 ph = scale_of(i) * surf_h(i);
            I64 sy = cby(i) + (cbh(i) - ph) / 2;
            if (sy < b && sy + ph > a) { return true; }
        }
    }
    return false;
}

// Whether the frame [x, x + fw) x [y, y + fh) is whole on the screen (a plate moves only then: plate_mix indexes
// its whole width).
Bool on_screen(I64 x, I64 y, I64 fw, I64 fh) {
    return x >= 0 && y >= 0 && x + fw <= w && y + fh <= h;
}

Bool plate_moving() {
    return ov_kind != 0 && anim.running(an5_get(0), pt()) &&
        on_screen(layout.frame_x(OV), layout.frame_y(OV), layout.frame_w(OV), layout.frame_h(OV));
}

Bool ghost_moving() {
    return gh_kind != 0 && anim.running(an5_get(1), pt());
}

// Before each paint: a plate that appeared opens (the message comes in); one that went is kept as a record and
// closes (the message goes out); one that took another's place opens and ends any record.
void plate_sync() {
    I64 k = up_kind();
    I64 t = pt();
    if (!anim_on) {
        an5_put(0, anim.done(an5_get(0)));
        gh_kind = 0;
    }
    if (k != ov_kind) {
        pl_rle_ok = false;
        I64 lg = kind_level(ov_kind);
        I64 gt = pv_y - shade.reach_up(lg, tokens.theme(), sc);
        if (ov_kind == K_MSG) { gt = gt - plate.MSG_DROP * sc; }
        I64 gb = pv_y + pv_h + shade.reach_down(lg, tokens.theme(), sc);
        if (ov_kind != 0 && k == 0 && anim_on && on_screen(pv_x, pv_y, pv_w, pv_h) && !pixel_rows(gt, gb)) {
            gh_kind = ov_kind;
            gh_rle_ok = false;
            gh_x = pv_x;
            gh_y = pv_y;
            gh_w = pv_w;
            gh_h = pv_h;
            if (gh_kind == K_MSG) {
                an5_put(1, plate.msg_out(an5_get(0), t, true));
            } else {
                an5_put(1, plate.close(an5_get(0), t, true));
            }
            I64 lv = kind_level(gh_kind);
            I64 rs = shade.reach_side(lv, tokens.theme(), sc);
            gh_top = gh_y - shade.reach_up(lv, tokens.theme(), sc);
            gh_bot = gh_y + gh_h + shade.reach_down(lv, tokens.theme(), sc);
            gh_left = gh_x - rs;
            gh_right = gh_x + gh_w + rs;
            if (gh_top < bar_h()) { gh_top = bar_h(); }
            if (gh_bot > h) { gh_bot = h; }
            if (gh_left < 0) { gh_left = 0; }
            if (gh_right > w) { gh_right = w; }
            mo_begin();
            ms5_live = true;
        }
        if (k != 0) {
            anim.Anim from = anim.rest(0);
            if (gh_kind == k) { from = an5_get(1); }   // reopened while it closed: from where it stands
            gh_kind = 0;
            I64 lk = kind_level(k);
            I64 y0 = layout.frame_y(OV);
            I64 drop = 0;
            if (k == K_MSG) { drop = plate.MSG_DROP * sc; }
            Bool on = anim_on && !pixel_rows(y0 - shade.reach_up(lk, tokens.theme(), sc) - drop,
                                             y0 + layout.frame_h(OV) + shade.reach_down(lk, tokens.theme(), sc));
            if (k == K_MSG) {
                an5_put(0, plate.msg_in(from, t, on));
            } else {
                an5_put(0, plate.open(from, t, on));
            }
            if (on) { mo_begin(); }
            ms5_live = on;
        }
        ov_kind = k;
    }
    if (k != 0) {
        pv_x = layout.frame_x(OV);
        pv_y = layout.frame_y(OV);
        pv_w = layout.frame_w(OV);
        pv_h = layout.frame_h(OV);
    }
}

// The 4 x 4 samples of device pixel (x, y) inside the rounded rectangle [x0, x1) x [y0, y1) of corner radius r, 0
// to 16 (corners_at's count).
I64 cover16(I64 x, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r) {
    if (x < x0 || x >= x1 || y < y0 || y >= y1) { return 0; }
    I64 px = -1;
    if (x < x0 + r) {
        px = x - x0;
    } else if (x >= x1 - r) {
        px = x1 - 1 - x;
    }
    I64 py = -1;
    if (y < y0 + r) {
        py = y - y0;
    } else if (y >= y1 - r) {
        py = y1 - 1 - y;
    }
    if (px < 0 || py < 0) { return 16; }
    return shape.arc16(r, px, py);
}

// An animating plate's shadow on row y over [lo, hi): its frame [x0, x1) x [y0, y1) and device radius r scaled about
// the center (the message is not scaled; coming in, it drops), level lv, mixed over what lay under it by the plate's
// opacity.
void cast_plate(I64 x0, I64 y0, I64 x1, I64 y1, I64 r, I64 lv, I64 k, I64 p, I64 y, I64 lo, I64 hi) {
    if (lv <= 0 || lo >= hi) { return; }
    I64 a = plate.alpha(p);
    if (a <= 0) { return; }
    I64 th = tokens.theme();
    I64 ps = p;
    I64 d = 0;
    if (k == K_MSG) {
        ps = 1000;
        if (gh_kind != K_MSG) { d = plate.drop(p, sc); }
    }
    I64 ix = plate.inset(x1 - x0, ps);
    I64 iy = plate.inset(y1 - y0, ps);
    I64 sx0 = x0 + ix;
    I64 sy0 = y0 + iy + d;
    I64 sx1 = x1 - ix;
    I64 sy1 = y1 - iy + d;
    if (!shade.reaches(y, lo, hi, sx0, sy0, sx1, sy1, lv, th, sc)) { return; }
    I64 rs = shade.reach_side(lv, th, sc);
    I64 a0 = lo;
    if (sx0 - rs > a0) { a0 = sx0 - rs; }
    I64 b0 = hi;
    if (sx1 + rs < b0) { b0 = sx1 + rs; }
    if (a0 >= b0) { return; }
    copy(fade_a[a0..b0], row[a0..b0]);
    shade.shade_row_dev(row, a0, b0, y, sx0, sy0, sx1, sy1, plate.radius(r, ps), lv, th, sc);
    for x in a0..b0 {
        if (row[x] != fade_a[x]) { row[x] = blend.mix_px(fade_a[x], row[x], a); }
    }
}

// An animating plate drawn at full size over fade_b (the row under it): clipped to its frame scaled about the
// center (the corners of the scaled radius counted as cover16 counts them) and mixed over fade_b by its opacity.
void plate_mix_span(I64 x0, I64 y0, I64 x1, I64 y1, I64 r, I64 ps, I64 p, I64 y, I64 xa, I64 xb) {
    if (y < y0 || y >= y1) { return; }
    I64 a0 = x0;
    if (xa > a0) { a0 = xa; }
    I64 b0 = x1;
    if (xb < b0) { b0 = xb; }
    if (a0 >= b0) { return; }
    I64 ix = plate.inset(x1 - x0, ps);
    I64 iy = plate.inset(y1 - y0, ps);
    I64 sx0 = x0 + ix;
    I64 sy0 = y0 + iy;
    I64 sx1 = x1 - ix;
    I64 sy1 = y1 - iy;
    if (y < sy0 || y >= sy1 || sx0 >= sx1) {
        copy(row[a0..b0], fade_b[a0..b0]);
        return;
    }
    I64 rr = plate.radius(r, ps);
    I64 a = plate.alpha(p);
    I64 la = sx0;
    if (la < a0) { la = a0; }
    if (la > b0) { la = b0; }
    if (la > a0) { copy(row[a0..la], fade_b[a0..la]); }
    I64 rb = sx1;
    if (rb < a0) { rb = a0; }
    if (rb > b0) { rb = b0; }
    if (rb < b0) { copy(row[rb..b0], fade_b[rb..b0]); }
    if (la >= rb) { return; }
    Bool crn = rr > 0 && (y < sy0 + rr || y >= sy1 - rr);
    if (!crn) {
        if (a <= 0) {
            copy(row[la..rb], fade_b[la..rb]);
        } else if (a < 256) {
            for x in la..rb { row[x] = blend.mix_px(fade_b[x], row[x], a); }
        }
        return;
    }
    I64 ma = sx0 + rr;
    if (ma < la) { ma = la; }
    if (ma > rb) { ma = rb; }
    I64 mb = sx1 - rr;
    if (mb < ma) { mb = ma; }
    if (mb > rb) { mb = rb; }
    for x in la..ma {
        I64 q = cover16(x, y, sx0, sy0, sx1, sy1, rr);
        row[x] = blend.mix_px(fade_b[x], row[x], (a * q + 8) / 16);
    }
    if (ma < mb) {
        if (a <= 0) {
            copy(row[ma..mb], fade_b[ma..mb]);
        } else if (a < 256) {
            for x in ma..mb { row[x] = blend.mix_px(fade_b[x], row[x], a); }
        }
    }
    for x in mb..rb {
        I64 q = cover16(x, y, sx0, sy0, sx1, sy1, rr);
        row[x] = blend.mix_px(fade_b[x], row[x], (a * q + 8) / 16);
    }
}

// PR 285: a row of 24-bit pixels as runs, each word (n - 1) << 24 | color, at most 256 a run; rle_enc_row writes
// them to rle_tmp and returns their count, rle_dec_chunk paints nr of them from ch[of..] and returns the pixels.
U32[5120] rle_tmp;
I64 rle_enc_row(in U32[_] src, I64 sw) {
    I64 nr = 0;
    I64 x = 0;
    while (x < sw) {
        U32 c = src[x] & 0xFFFFFF;
        I64 lim = x + 256;
        if (lim > sw) { lim = sw; }
        I64 nx = x + 1;
        while (nx < lim && (src[nx] & 0xFFFFFF) == c) { nx = nx + 1; }
        rle_tmp[nr] = (((nx - x - 1) as U32) << 24) | c;
        nr = nr + 1;
        x = nx;
    }
    return nr;
}

I64 rle_dec_chunk(in U32[_] ch, I64 of, I64 nr, inout U32[_] dst) {
    I64 x = 0;
    for k in 0..nr {
        U32 w0 = ch[of + k];
        I64 n = ((w0 >> 24) as I64) + 1;
        U32 c = w0 & 0xFFFFFF;
        if (n == 1) {
            dst[x] = c;
        } else if (n == 2) {
            dst[x] = c;
            dst[x + 1] = c;
        } else if (n <= 16) {
            for j in 0..n { dst[x + j] = c; }
        } else {
            draw.paint(dst, x, x + n, c);
        }
        x = x + n;
    }
    return x;
}

const I64 PL_RLE_MAX = 65535;
U32[65535] pl_rle;
I64[1200] pl_rle_row;
I64 pl_rle_used = 0;
Bool pl_rle_ok = false;
I64 pl_ck = 0;
I64 pl_cx = 0;
I64 pl_cy = 0;
I64 pl_cw = 0;
I64 pl_ch = 0;
I64 pl_cth = -1;
I64 pl_csc = 0;

U32[65535] gh_rle;
I64[1200] gh_rle_row;
I64 gh_rle_used = 0;
Bool gh_rle_ok = false;
I64 gh_ck = 0;
I64 gh_cx = 0;
I64 gh_cy = 0;
I64 gh_cw = 0;
I64 gh_ch = 0;
I64 gh_cth = -1;
I64 gh_csc = 0;

Bool pl_cacheable(I64 k) {
    return !about.blocks(OV) && !(mn_open && mn_app) &&
        (k == K_PANEL || k == K_SWITCH || k == K_MSG || (k == K_PROMPT && !kp_field));
}

Bool gh_cacheable(I64 k) {
    return k == K_PANEL || k == K_SWITCH || k == K_MSG || (k == K_PROMPT && !kp_field);
}

void pl_store_row(I64 ly, in U32[_] src, I64 pw) {
    I64 nr = rle_enc_row(src, pw);
    if (ly > 0 && pl_rle_row[ly - 1] >= 0 && (pl_rle_row[ly - 1] & 65535) == nr) {
        I64 pst = pl_rle_row[ly - 1] >> 16;
        Bool eq = true;
        for k in 0..nr {
            if (eq && pl_rle[pst + k] != rle_tmp[k]) { eq = false; }
        }
        if (eq) {
            pl_rle_row[ly] = pl_rle_row[ly - 1];
            return;
        }
    }
    if (pl_rle_used + nr > PL_RLE_MAX) {
        pl_rle_row[ly] = -1;
        return;
    }
    I64 st = pl_rle_used;
    for k in 0..nr { pl_rle[st + k] = rle_tmp[k]; }
    pl_rle_row[ly] = (st << 16) | nr;
    pl_rle_used = st + nr;
}

Bool pl_dec_row(I64 ly, inout U32[_] dst, I64 pw) {
    I64 desc = pl_rle_row[ly];
    if (desc < 0) { return false; }
    I64 st = desc >> 16;
    I64 nr = desc & 65535;
    if (nr <= 0) { return pw == 0; }
    return rle_dec_chunk(pl_rle, st, nr, dst) == pw;
}

void gh_store_row(I64 ly, in U32[_] src, I64 pw) {
    I64 nr = rle_enc_row(src, pw);
    if (ly > 0 && gh_rle_row[ly - 1] >= 0 && (gh_rle_row[ly - 1] & 65535) == nr) {
        I64 pst = gh_rle_row[ly - 1] >> 16;
        Bool eq = true;
        for k in 0..nr {
            if (eq && gh_rle[pst + k] != rle_tmp[k]) { eq = false; }
        }
        if (eq) {
            gh_rle_row[ly] = gh_rle_row[ly - 1];
            return;
        }
    }
    if (gh_rle_used + nr > PL_RLE_MAX) {
        gh_rle_row[ly] = -1;
        return;
    }
    I64 st = gh_rle_used;
    for k in 0..nr { gh_rle[st + k] = rle_tmp[k]; }
    gh_rle_row[ly] = (st << 16) | nr;
    gh_rle_used = st + nr;
}

Bool gh_dec_row(I64 ly, inout U32[_] dst, I64 pw) {
    I64 desc = gh_rle_row[ly];
    if (desc < 0) { return false; }
    I64 st = desc >> 16;
    I64 nr = desc & 65535;
    if (nr <= 0) { return pw == 0; }
    return rle_dec_chunk(gh_rle, st, nr, dst) == pw;
}

// The OV plate on row y while it opens (or the message comes in, dropping): its shadow, then the plate drawn at
// full size, scaled and faded.
void plate_row_span(I64 y, I64 xa, I64 xb) {
    I64 p = anim.value(an5_get(0), pt());
    I64 x0 = layout.frame_x(OV);
    I64 y0 = layout.frame_y(OV);
    I64 pw = layout.frame_w(OV);
    I64 ph = layout.frame_h(OV);
    I64 x1 = x0 + pw;
    I64 y1 = y0 + ph;
    I64 ps = p;
    I64 d = 0;
    if (ov_kind == K_MSG) {
        ps = 1000;
        d = plate.drop(p, sc);
    }
    cast_row(OV, y, xa, xb);
    I64 py = y - d;
    if (py < y0 || py >= y1 || x1 <= xa || x0 >= xb) { return; }
    if (!about.blocks(OV) && !(mn_open && mn_app)) {
        I64 ix = plate.inset(pw, ps);
        I64 iy = plate.inset(ph, ps);
        if (plate.alpha(p) <= 0 || py < y0 + iy || py >= y1 - iy || pw <= 2 * ix) { return; }
    }
    I64 mx0 = x0;
    if (xa > mx0) { mx0 = xa; }
    I64 mx1 = x1;
    if (xb < mx1) { mx1 = xb; }
    copy(fade_b[mx0..mx1], row[mx0..mx1]);
    if (pl_cacheable(ov_kind) && pw > 0 && ph > 0 && ph <= 1200 && x0 >= 0 && x1 <= w) {
        I64 th = tokens.theme();
        if (!pl_rle_ok || pl_ck != ov_kind || pl_cx != x0 || pl_cy != y0 || pl_cw != pw || pl_ch != ph ||
            pl_cth != th || pl_csc != sc) {
            pl_rle_used = 0;
            for q in 0..ph { pl_rle_row[q] = -2; }
            pl_ck = ov_kind;
            pl_cx = x0;
            pl_cy = y0;
            pl_cw = pw;
            pl_ch = ph;
            pl_cth = th;
            pl_csc = sc;
            pl_rle_ok = true;
        }
        I64 ly = py - y0;
        Bool round = (kp_open || sp_open || tr_open || msg_up() || sw_open || rv_open || unsaved.is_up()) &&
            rounds(OV, py);
        if (round) { keep_at(x0, x1, rad_of(OV) * sc); }
        if (!pl_dec_row(ly, row[x0..x1], pw)) {
            win_body_span(OV, py, xa, xb);
            if (pl_rle_row[ly] == -2) { pl_store_row(ly, row[x0..x1], pw); }
        }
        if (round) { cut_corners(OV, py); }
    } else {
        win_row_span(OV, py, xa, xb);
    }
    plate_mix_span(x0, y0 + d, x1, y1 + d, rad_of(OV) * sc, ps, p, y, xa, xb);
}

// The plate going, from its record, on row y: drawn as win_row draws the OV window, at its recorded frame, with its
// kind's state set for this drawing only, then scaled and faded as it closes (the message only fades).
void ghost_row_span(I64 y, I64 xa, I64 xb) {
    if (y < bar_h()) { return; }
    I64 p = anim.value(an5_get(1), pt());
    I64 x1 = gh_x + gh_w;
    I64 y1 = gh_y + gh_h;
    I64 r = kind_rad(gh_kind) * sc;
    I64 ps = p;
    if (gh_kind == K_MSG) { ps = 1000; }
    cast_plate(gh_x, gh_y, x1, y1, r, kind_level(gh_kind), gh_kind, p, y, xa, xb);
    if (y < gh_y || y >= y1 || x1 <= xa || gh_x >= xb) { return; }
    I64 ix = plate.inset(gh_w, ps);
    I64 iy = plate.inset(gh_h, ps);
    if (plate.alpha(p) <= 0 || y < gh_y + iy || y >= y1 - iy || gh_w <= 2 * ix) { return; }
    I64 mx0 = gh_x;
    if (xa > mx0) { mx0 = xa; }
    I64 mx1 = x1;
    if (xb < mx1) { mx1 = xb; }
    copy(fade_b[mx0..mx1], row[mx0..mx1]);
    Bool rnd = r > 0 && 2 * r <= len(under) && gh_w >= 2 * r && gh_h >= 2 * r && (y < gh_y + r || y >= y1 - r);
    Bool hit = false;
    I64 ly = y - gh_y;
    Bool can_cache = gh_cacheable(gh_kind) && gh_w > 0 && gh_h > 0 && gh_h <= 1200 && gh_x >= 0 && x1 <= w;
    if (can_cache) {
        I64 th = tokens.theme();
        if (!gh_rle_ok || gh_ck != gh_kind || gh_cx != gh_x || gh_cy != gh_y || gh_cw != gh_w || gh_ch != gh_h ||
            gh_cth != th || gh_csc != sc) {
            gh_rle_used = 0;
            for q in 0..gh_h { gh_rle_row[q] = -2; }
            gh_ck = gh_kind;
            gh_cx = gh_x;
            gh_cy = gh_y;
            gh_cw = gh_w;
            gh_ch = gh_h;
            gh_cth = th;
            gh_csc = sc;
            gh_rle_ok = true;
        }
        if (gh_rle_row[ly] >= 0) {
            if (rnd) { keep_at(gh_x, x1, r); }
            hit = gh_dec_row(ly, row[gh_x..x1], gh_w);
            if (hit && rnd) {
                I64 b = 0;             // as the uncached row below: the prompt's ring
                U32 e = tok(tokens.RULE);
                if (gh_kind == K_PROMPT) {
                    e = tok(tokens.CADMIUM);
                    b = RING * sc;
                }
                corners_at(gh_x, gh_y, x1, y1, r, b, e, y);
            }
        }
    }
    if (!hit) {
        Bool[9] was = [kp_open, rv_open, pl_open, cal_open, sp_open, tr_open, msg_on, mn_open, sw_open];
        kp_open = gh_kind == K_PROMPT;
        rv_open = gh_kind == K_REVERT;
        pl_open = false;
        cal_open = false;
        sp_open = gh_kind == K_PANEL;
        tr_open = false;
        msg_on = gh_kind == K_MSG;
        mn_open = false;
        sw_open = gh_kind == K_SWITCH;
        if (rnd) { keep_at(gh_x, x1, r); }
        draw.paint(row, gh_x, x1, ov_ground());
        I64 z = tz();
        I64 ux1 = gh_x + gh_w / sc;
        pen.at(gh_x, gh_y, z, gh_y + (y - gh_y) / (sc / z));
        widget_row(OV, gh_x, gh_y, ux1, gh_y + gh_h / sc, gh_y + (y - gh_y) / sc);
        expand_by(gh_x, (ux1 - gh_x) * z, sc / z);
        if (can_cache && gh_rle_row[ly] == -2) { gh_store_row(ly, row[gh_x..x1], gh_w); }
        if (rnd) {
            I64 b = 0;                 // as cut_corners: the prompt's ring; the other plates have no outline
            U32 e = tok(tokens.RULE);
            if (kp_open) {
                e = tok(tokens.CADMIUM);
                b = RING * sc;
            }
            corners_at(gh_x, gh_y, x1, y1, r, b, e, y);
        }
        kp_open = was[0];
        rv_open = was[1];
        pl_open = was[2];
        cal_open = was[3];
        sp_open = was[4];
        tr_open = was[5];
        msg_on = was[6];
        mn_open = was[7];
        sw_open = was[8];
    }
    plate_mix_span(gh_x, gh_y, x1, y1, r, ps, p, y, xa, xb);
}

// MS-8 (MS section 4): window motion. A window whose frame changes (a move by key, a tile's new cell, a float, a
// monocle, fullscreen and back) goes from where it stands to its new frame over 200 ms on the curve out, position and
// size together; a pointer drag is not animated (the window follows the pointer), and a window that appears is there
// at once. One win_sync before each paint sees the changes. While windows move, each paint draws them at their frame
// of the moment (layout.put for the paint, the final frame put back after it), their content cut to it, and the rows
// they cover are painted again by damage only; the pixel clients and the terminals' own rows wait for the frame at
// rest. With nothing moving none of this runs. DN-21's restore and MS-7's slide are their own motion: a window
// they move is at its frame at once here.
I64[16] lf_x;               // each window's frame at rest as the last paint saw it: where it is going
I64[16] lf_y;
I64[16] lf_w;
I64[16] lf_h;
I64[16] lf_mode;            // each shown window's mode at the last paint (MS-R5: float to tile and back snaps)
Bool[16] lf_on;             // shown at the last paint
I64[16] mf_x;               // a motion's frame at its start: where it came from
I64[16] mf_y;
I64[16] mf_w;
I64[16] mf_h;
I64[16] df_x;               // each moving window's last drawn frame
I64[16] df_y;
I64[16] df_w;
I64[16] df_h;
Bool[16] df_move;           // drawn in motion on the previous step
I64[80] wm;                 // each window's motion, 5 fields (anim.Anim), progress 0 to 1000
Bool[16] wm_on;             // moving in the paint under way, drawn at its frame of the moment
I64[16] ax0;                // that frame
I64[16] ax1;
I64 lf_sw = 0;              // the screen and scale of the last paint: a change moves nothing
I64 lf_sh = 0;
I64 lf_sc = 0;
Bool ms8_live = false;

anim.Anim wm_get(I64 i) {
    anim.Anim a = anim.rest(0);
    a.t0 = wm[5 * i];
    a.dur = wm[5 * i + 1];
    a.from = wm[5 * i + 2];
    a.to = wm[5 * i + 3];
    a.curve = wm[5 * i + 4];
    return a;
}

void wm_put(I64 i, anim.Anim a) {
    wm[5 * i] = a.t0;
    wm[5 * i + 1] = a.dur;
    wm[5 * i + 2] = a.from;
    wm[5 * i + 3] = a.to;
    wm[5 * i + 4] = a.curve;
}

// Window i in motion now.
Bool win_moving(I64 i) {
    return ms8_live && lf_on[i] && anim.running(wm_get(i), pt());
}

Bool any_moving() {
    if (!ms8_live) { return false; }
    for i in 0..WINDOWS {
        if (win_moving(i)) { return true; }
    }
    return false;
}

// Before each paint: each shown window's frame at rest now; one that changed since the last paint starts moving from
// where it stands (its frame of the moment, if it was moving).
void win_sync() {
    Bool same = w == lf_sw && h == lf_sh && sc == lf_sc;
    lf_sw = w;
    lf_sh = h;
    lf_sc = sc;
    Bool ft_snap = false;       // MS-R5: a window switched between float and tiled since the last paint
    for i in 0..WINDOWS {
        if (shown(i) && lf_on[i] &&
            ((wmode[i] == layout.FLOAT && lf_mode[i] == layout.TILED) ||
             (wmode[i] == layout.TILED && lf_mode[i] == layout.FLOAT))) {
            ft_snap = true;
        }
    }
    I64 t = pt();
    for i in 0..WINDOWS {
        if (shown(i)) {
            I64 x = layout.frame_x(i);
            I64 y = layout.frame_y(i);
            I64 fw = layout.frame_w(i);
            I64 fh = layout.frame_h(i);
            if (lf_on[i] && same && anim_on && drag == 0 && !pl_open && !sliding() && !ft_snap && i != ra_win &&
                (x != lf_x[i] || y != lf_y[i] || fw != lf_w[i] || fh != lf_h[i])) {
                I64 p = 1000;
                if (anim.running(wm_get(i), t)) { p = anim.value(wm_get(i), t); }
                I64 cx = plate.between(mf_x[i], lf_x[i], p);
                I64 cy = plate.between(mf_y[i], lf_y[i], p);
                I64 cw = plate.between(mf_w[i], lf_w[i], p);
                I64 ch = plate.between(mf_h[i], lf_h[i], p);
                mf_x[i] = cx;
                mf_y[i] = cy;
                mf_w[i] = cw;
                mf_h[i] = ch;
                // a terminal draws its content at its final width from its moving origin: the furthest right origin
                // plus the wider frame must fit in `row`, else the window is at its new frame at once
                I64 xr = cx;
                if (x > xr) { xr = x; }
                I64 wr = cw;
                if (fw > wr) { wr = fw; }
                if (xr + wr <= len(row) && cx >= 0 && x >= 0) {
                    wm_put(i, plate.move(anim.rest(0), t, true));
                    df_x[i] = cx;
                    df_y[i] = cy;
                    df_w[i] = cw;
                    df_h[i] = ch;
                    df_move[i] = true;
                    mo_begin();
                    ms8_live = true;
                } else {
                    wm_put(i, anim.rest(1000));
                    df_move[i] = false;
                }
            } else if (!lf_on[i] || !same || !anim_on || drag != 0 || pl_open || sliding() || ft_snap || i == ra_win) {
                wm_put(i, anim.rest(1000));    // appeared, or a change that does not move: at its frame at once
                df_move[i] = false;
            }
            lf_x[i] = x;
            lf_y[i] = y;
            lf_w[i] = fw;
            lf_h[i] = fh;
            lf_mode[i] = wmode[i];
            lf_on[i] = true;
        } else {
            lf_on[i] = false;
            wm_put(i, anim.rest(1000));
            df_move[i] = false;
        }
    }
    if (!same || !anim_on || drag != 0 || pl_open || sliding() || ft_snap) {
        ms8_live = false;       // MS-R5: nothing moves past a snap, a new screen, a drag, the plane or a slide
    }
}

// For the paint under way: each moving window at its frame of the moment (on), or back at its frame at rest (off).
void win_apply(Bool on) {
    for i in 0..WINDOWS {
        if (on) { wm_on[i] = win_moving(i); }
        if (wm_on[i]) {
            I64 x = lf_x[i];
            I64 y = lf_y[i];
            I64 fw = lf_w[i];
            I64 fh = lf_h[i];
            if (on) {
                I64 p = anim.value(wm_get(i), pt());
                x = plate.between(mf_x[i], lf_x[i], p);
                y = plate.between(mf_y[i], lf_y[i], p);
                fw = plate.between(mf_w[i], lf_w[i], p);
                fh = plate.between(mf_h[i], lf_h[i], p);
                ax0[i] = x;
                ax1[i] = x + fw;
            }
            layout.put(i, wdesk[i], wmode[i], wrank[i], x, y, fw, fh);
        }
        if (!on) { wm_on[i] = false; }
    }
}

// Add [x0, x1) x [y0, y1) grown by shadow reach (rs, ru, rd) and clamped to the work area into rx0..ry1[nr].
I64 add_dmg_rect(I64 x0, I64 y0, I64 fw, I64 fh, I64 rs, I64 ru, I64 rd,
                 inout I64[32] rx0, inout I64[32] ry0, inout I64[32] rx1, inout I64[32] ry1, I64 nr) {
    if (nr >= 32) { return nr; }
    I64 a0 = x0 - rs;
    if (a0 < 0) { a0 = 0; }
    I64 b0 = x0 + fw + rs;
    if (b0 > w) { b0 = w; }
    I64 ya = y0 - ru;
    if (ya < bar_h()) { ya = bar_h(); }
    I64 yb = y0 + fh + rd;
    if (yb > h) { yb = h; }
    if (a0 >= b0 || ya >= yb) { return nr; }
    rx0[nr] = a0;
    ry0[nr] = ya;
    rx1[nr] = b0;
    ry1[nr] = yb;
    return nr + 1;
}

// MS-R5: a frame of window motion. Only the 2D union of each moving window's old and new rectangles (plus shadow
// reach) is painted; once none moves, finish_rest flushes dirty terminal rows and places pixel clients without a
// full-desk recompose.
void ms8_frame() {
    plate_sync();
    win_sync();
    if (sliding()) {
        paint_rows(bar_h(), h);
        settle();
        return;
    }
    I64 th = tokens.theme();
    I64 ru = shade.reach_up(2, th, sc);
    I64 rd = shade.reach_down(2, th, sc);
    I64 rs = shade.reach_side(2, th, sc);
    I64[32] rx0;
    I64[32] ry0;
    I64[32] rx1;
    I64[32] ry1;
    I64 nr = 0;
    I64 t = pt();
    Bool still = false;
    for i in 0..WINDOWS {
        Bool mv = win_moving(i);
        if (mv) { still = true; }
        if (df_move[i] || mv) {
            I64 nx = lf_x[i];
            I64 ny = lf_y[i];
            I64 nw = lf_w[i];
            I64 nh = lf_h[i];
            if (mv) {
                I64 p = anim.value(wm_get(i), t);
                nx = plate.between(mf_x[i], lf_x[i], p);
                ny = plate.between(mf_y[i], lf_y[i], p);
                nw = plate.between(mf_w[i], lf_w[i], p);
                nh = plate.between(mf_h[i], lf_h[i], p);
            }
            if (nx != df_x[i] || ny != df_y[i] || nw != df_w[i] || nh != df_h[i] || about.blocks(i)) {
                if (df_move[i]) {
                    nr = add_dmg_rect(df_x[i], df_y[i], df_w[i], df_h[i], rs, ru, rd, rx0, ry0, rx1, ry1, nr);
                }
                if (shown(i)) {
                    nr = add_dmg_rect(nx, ny, nw, nh, rs, ru, rd, rx0, ry0, rx1, ry1, nr);
                }
            }
            df_x[i] = nx;
            df_y[i] = ny;
            df_w[i] = nw;
            df_h[i] = nh;
            df_move[i] = mv;
        }
    }
    if (nr > 0) {
        I64[64] ys;
        I64 ny = 0;
        for m in 0..nr {
            ys[ny] = ry0[m];
            ys[ny + 1] = ry1[m];
            ny = ny + 2;
        }
        for i in 1..ny {
            I64 v = ys[i];
            I64 j = i;
            while (j > 0 && ys[j - 1] > v) {
                ys[j] = ys[j - 1];
                j = j - 1;
            }
            ys[j] = v;
        }
        I64 uy = 0;
        for i in 0..ny {
            if (uy == 0 || ys[i] != ys[uy - 1]) {
                ys[uy] = ys[i];
                uy = uy + 1;
            }
        }
        if (uy >= 2) {
            Bool full_w = plane_drawn();
            Bool was = arrow_off(ys[0], ys[uy - 1]);
            win_apply(true);
            for b in 0..uy - 1 {
                I64 ya = ys[b];
                I64 yb = ys[b + 1];
                if (full_w) {
                    rows_span(ya, yb, 0, w);
                } else {
                    I64[32] ix0;
                    I64[32] ix1;
                    I64 ni = 0;
                    for m in 0..nr {
                        if (ry0[m] <= ya && ry1[m] >= yb) {
                            ix0[ni] = rx0[m];
                            ix1[ni] = rx1[m];
                            ni = ni + 1;
                        }
                    }
                    for i in 1..ni {
                        I64 v0 = ix0[i];
                        I64 v1 = ix1[i];
                        I64 j = i;
                        while (j > 0 && ix0[j - 1] > v0) {
                            ix0[j] = ix0[j - 1];
                            ix1[j] = ix1[j - 1];
                            j = j - 1;
                        }
                        ix0[j] = v0;
                        ix1[j] = v1;
                    }
                    I64 k = 0;
                    while (k < ni) {
                        I64 xa = ix0[k];
                        I64 xb = ix1[k];
                        k = k + 1;
                        while (k < ni && ix0[k] <= xb) {
                            if (ix1[k] > xb) { xb = ix1[k]; }
                            k = k + 1;
                        }
                        rows_span(ya, yb, xa, xb);
                        if (uy == 2) { clean_full_terms(ya, yb, xa, xb); }
                    }
                }
            }
            if (nr == 2 && rx0[0] == 0 && rx1[0] == w && ry0[0] <= bar_h() && ry1[0] >= h) {
                clean_full_terms(bar_h(), h, 0, w);
            }
            win_apply(false);
            arrow_back(was);
        }
    }
    if (still) {
        settle();
    } else {
        ms8_live = false;
        finish_rest();
    }
}

// A frame of the motion: the box of the plate up (its shadow and the message's drop) and of the plate going,
// painted again at the clock's time; once nothing moves, one last frame at rest, and no more are asked.
void plate_frame() {
    I64 a = h;
    I64 b = 0;
    I64 xa = w;
    I64 xb = 0;
    if (ov_kind != 0 && ov_up()) {
        a = ov_top;
        b = ov_bot;
        xa = ov_left;
        xb = ov_right;
    }
    if (gh_kind != 0) {
        if (gh_top < a) { a = gh_top; }
        if (gh_bot > b) { b = gh_bot; }
        if (gh_left < xa) { xa = gh_left; }
        if (gh_right > xb) { xb = gh_right; }
        if (!ghost_moving()) { gh_kind = 0; }
    }
    if (!plate_moving() && gh_kind == 0) { ms5_live = false; }
    if (a < bar_h()) { a = bar_h(); }
    if (xa < 0) { xa = 0; }
    if (xb > w) { xb = w; }
    if (a < b && xa < xb) { paint_span(a, b, xa, xb); }   // no pixel client shares these rows (pixel_rows)
    settle();
}

Bool msg_up() {
    return msg_on && !sw_open && !mn_open && !cal_open && !kp_open && !sp_open && !tr_open && !pl_open && !rv_open &&
        !ask_up() && !keysheet.is_up();
}

// DN-6: the OV window's ground: the panel's SURF2, the message's SURF1, else PAPER.
U32 ov_ground() {
    if (rv_open || kp_open || ask_up()) { return tok(tokens.PAPER); }
    if (sp_open || tr_open) { return tok(tokens.SURF2); }   // DN-15: the tray's plate too
    if (keysheet.is_up()) { return tok(tokens.SURF2); }     // frame 27: the sheet's plate
    if (msg_up()) { return tok(tokens.SURF1); }
    if (sw_open && !mn_open && !cal_open && !tr_open && !pl_open) { return tok(tokens.SURF2); }
    return tok(tokens.PAPER);
}

// WB-7: whether row y crosses float i's top or bottom rad_of rows, with the frame whole on the row and the two
// corner spans within `under`.
Bool rounds(I64 i, I64 y) {
    I64 r = rad_of(i) * sc;
    I64 x0 = layout.frame_x(i);
    I64 y0 = layout.frame_y(i);
    I64 x1 = x0 + layout.frame_w(i);
    I64 y1 = y0 + layout.frame_h(i);
    if (2 * r > len(under) || x0 < 0 || x1 > w || x1 - x0 < 2 * r || y1 - y0 < 2 * r) { return false; }
    if (x0 == 0 && x1 == w) { return false; }   // FF 3g: a maximized window stays square at the screen's edge
    return (y >= y0 && y < y0 + r) || (y >= y1 - r && y < y1);
}

// What lies under the r device pixels at each end of [x0, x1) on the row, kept in `under` before a rounded
// surface is drawn over them.
void keep_at(I64 x0, I64 x1, I64 r) {
    for k in 0..r {
        under[k] = row[x0 + k];
        under[r + k] = row[x1 - r + k];
    }
}

// Channel c (0 blue, 1 green, 2 red) of the color in b at pixel k.
I64 chan(in U32[_] b, I64 k, I64 c) { return ((b[k] >> ((8 * c) as U32)) & 255) as I64; }

// WB-7: float i's four corners on row y (corners_at, its ring's band and color).
void cut_corners(I64 i, I64 y) {
    I64 b = bw();
    U32 e = tok(tokens.RULE);
    if (i == OV && kp_open) {
        e = tok(kp_color());           // AC-1c: the asked ring's color (L8); cadmium for kern
        b = 0;                         // DN-36: the prompt is one shape in its color; no stroke round its header
    } else if (i == OV && (sp_open || msg_up() || sw_open || rv_open || tr_open || ask_up() || keysheet.is_up())) {
        b = 0;                         // DN-6 frame 9: the panel and the message have no outline; DN-15 the tray
    } else if (i == OV) {
        e = tok(tokens.ULTRAMARINE);   // SP-2: the tray's outline, ring 3
    } else if (lit_of(i == focused() && !about.blocks(i), prompt_up())) {
        e = tok(ring_tok(gw[i]));
        b = 2 * sc;                    // DN-6 frame 8: a focused float's ring is 2 px
        if (RIMLESS) {
            e = tok(tokens.FILL);
            b = 0;                     // DN-36: no stroke; the ring is the window's own shape beside the body
            if (tb(i) == 0) { b = RING * sc; }   // a tile has no bar: its ring is its outline
        }   // DN-24 B, DN-27: the ring the bar's FILL, never a grant's color
    } else if (RIMLESS) {
        b = 0;                         // DN-24 B: a float at rest has no ring and no outline
    }
    corners_at(layout.frame_x(i), layout.frame_y(i), layout.frame_x(i) + layout.frame_w(i),
               layout.frame_y(i) + layout.frame_h(i), rad_of(i) * sc, b, e, y);
}

// WB-7, DN-6: the four corners of the device rectangle [x0, x1) x [y0, y1) on row y, quarter circles of radius r
// whose outline is a band b wide in e (b 0: none), `under` holding what lay under each end (keep_at). Each corner
// pixel takes 4 x 4 samples, counted as under the surface (past the arc), on the outline, or inside it; the pixel
// is those three colors mixed by their counts, in whole numbers.
void corners_at(I64 x0, I64 y0, I64 x1, I64 y1, I64 r, I64 b, U32 e, I64 y) {
    if (y < y0 || y >= y1 || (y >= y0 + r && y < y1 - r)) { return; }
    I64 py = y - y0;
    if (y >= y1 - r) { py = y1 - 1 - y; }
    U32[1] ec;
    ec[0] = e;
    for px in 0..r {
        I64 nu = 0;
        I64 no = 0;
        I64 ni = 0;
        if (b == 0) {
            ni = shape.arc16(r, px, py);
            nu = 16 - ni;
        } else if (b > 0 && b <= r) {
            I64 cov = shape.arc16(r, px, py);
            nu = 16 - cov;
            ni = shape.arc16(r - b, px - b, py - b);
            no = cov - ni;
        } else {
            for s in 0..4 {
                for t in 0..4 {
                    I64 dx = 8 * r - (8 * px + 2 * s + 1);
                    I64 dy = 8 * r - (8 * py + 2 * t + 1);
                    I64 d2 = dx * dx + dy * dy;
                    if (d2 > 64 * r * r) {
                        nu = nu + 1;
                    } else if (d2 > 64 * (r - b) * (r - b)) {
                        no = no + 1;
                    }
                }
            }
            ni = 16 - nu - no;
        }
        for side in 0..2 {
            I64 x = x0 + px;
            I64 k = px;
            if (side == 1) {
                x = x1 - 1 - px;
                k = 2 * r - 1 - px;
            }
            if (ni == 16) {
                if (x >= 0 && x < len(row)) { row[x] = row[x] & 0xFFFFFF; }
            } else if (nu == 16) {
                draw.put(row, x, under[k]);
            } else if (no == 16) {
                draw.put(row, x, e);
            } else {
                I64 c = 0;
                for ch in 0..3 {
                    I64 v = (nu * chan(under, k, ch) + no * chan(ec, 0, ch) + ni * chan(row, x, ch) + 8) / 16;
                    c = c | (v << (8 * ch));
                }
                draw.put(row, x, c as U32);
            }
        }
    }
}

void win_body_span(I64 i, I64 y, I64 xa, I64 xb) {
    I64 x0 = layout.frame_x(i);
    I64 y0 = layout.frame_y(i);
    I64 x1 = x0 + layout.frame_w(i);
    I64 y1 = y0 + layout.frame_h(i);
    if (y < y0 || y >= y1) { return; }
    if (i == OV && mn_open && mn_app) {   // AM-1: no ground: the plates and their shadows mix over what lies under
        ctxmenu.row_at(row, y, am_z(), tokens.theme(), 1000);
        return;
    }
    if (i == OV && cal_open) {         // RS-CAL: no ground: the plate and its shadow mix over what lies under
        calpop.row_at(row, y, am_z(), tokens.theme());
        return;
    }
    U32 ground = tok(tokens.PAPER);
    if (kind[i] == TERM) { ground = tokens.term_paper(); }   // a terminal is dark in both themes (K-DT)
    if (i == OV) { ground = ov_ground(); }
    if (!(i == OV && plane_drawn())) {   // DN-49: the plane mixes its scrim over the windows
        draw.paint(row, x0, x1, ground);
    }
    if (kind[i] == SETTINGS) {
        // DN-10: Settings is a float with the desk's bar; its content box through the pen at its zoom, spread
        if (tb(i) > 0) {
            float_bar(i, y);
        } else {
            draw.frame(row, y, x0, y0, x1, y1, bw(), tok(tokens.RULE));
        }
        if (y >= cby(i) && y < cby(i) + cbh(i)) {
            I64 z = tz();
            I64 cx = cbx(i);
            I64 cy = cby(i);
            I64 ux1 = cx + cbw(i) / sc;
            pen.at(cx, cy, z, cy + (y - cy) / (sc / z));
            settings_row(cx, cy, ux1, cy + cbh(i) / sc, cy + (y - cy) / sc);
            expand_by(cx, (ux1 - cx) * z, sc / z);
        }
        return;
    }
    if (kind[i] == FAULT) {            // DN-51 frame 23: the desk's bar, the body at the UI scale (kit/faultwin.ci)
        float_bar(i, y);
        faultwin.row_at(row, y, cbx(i), cby(i), cbw(i) / sc, cbh(i) / sc, sc);
        return;
    }
    if (i == OV) {
        // the desk's own windows: their 1x geometry from the frame's top left, drawn through the pen at its zoom
        // (FONT-2 A: native at 2x) and spread by the rest of the UI scale; the Super plane (kit/plane.ci, FF 3g) too,
        // placed at the same zoom (pl_size)
        I64 z = tz();
        if (ac_screen == SCR_BROKEN) { z = 1; }   // the broken store's card is a 1x drawing; frame 12 draws through the pen
        I64 ux1 = x0 + (x1 - x0) / sc;
        if (plane_drawn() && sc / z > 1) {   // DN-49: the windows under the scrim at the pen's zoom
            for q in 0..(ux1 - x0) * z { row[x0 + q] = row[x0 + (sc / z) * q]; }
        }
        pen.at(x0, y0, z, y0 + (y - y0) / (sc / z));
        widget_row(i, x0, y0, ux1, y0 + (y1 - y0) / sc, y0 + (y - y0) / sc);
        expand_by(x0, (ux1 - x0) * z, sc / z);
        return;
    }
    if (tb(i) > 0) {
        float_bar(i, y);                                                  // DN-6 frame 8: the ring and the bar
    } else if (lit_of(i == focused() && !about.blocks(i), prompt_up())) {
        I64 rc = ring_tok(gw[i]);                                         // WB-5: the outline is the ring
        if (RIMLESS) { rc = tokens.FILL; }                                // DN-27: FILL, never a grant's color
        draw.frame(row, y, x0, y0, x1, y1, bw(), tok(rc));
    } else {
        draw.frame(row, y, x0, y0, x1, y1, bw(), tok(tokens.RULE));       // WB-7: at rest, the rule alone
    }
    if (kind[i] == TERM) {
        I64 s = slot[i];
        I64 cx = tcx(i);
        I64 ty = y - tcy(i);
        if (ty >= 0 && ty < face.H * sc * terms.height(s)) {
            I64 la = xa;               // MS-R5: the columns within [xa, xb), and a moving window's frame of the moment
            I64 lb = xb;
            if (i < WINDOWS && wm_on[i]) {
                if (ax0[i] > la) { la = ax0[i]; }
                if (ax1[i] < lb) { lb = ax1[i]; }
            }
            I64 cw = face.W * sc;
            I64 ncols = terms.width(s);
            I64 c0 = 0;
            if (la > cx) { c0 = (la - cx) / cw; }
            I64 c1 = ncols;
            if (lb <= cx) {
                c1 = 0;
            } else {
                I64 ce = (lb - cx + cw - 1) / cw;
                if (ce < c1) { c1 = ce; }
            }
            if (c0 < c1) {
                I64 z = tz();
                I64 dx = cx + cw * c0;
                I64 sw = face.W * z * (c1 - c0);
                terms.draw_row_cols(s, row[dx..dx + sw], ty / (sc / z), z, c0, c1);
                expand_by(dx, sw, sc / z);
                if (noanswer.blocks(i)) {      // DN-51 frame 25: under the sheet at 40 percent
                    blend.mix(row, dx, dx + cw * (c1 - c0), tokens.term_paper(), NR_DIM);
                }
            }
        }
    }
}

// DN-55: the HOME this session's terminals get (new_term): /home/NAME as the account, /home on a volume, else /.
I64 home_of(inout U8[_] hb) {
    if (ac_on && s_acct >= 0) {
        I64 n = put_text(hb, 0, b"/home/");
        for k in 0..acct.name_len(s_acct) { hb[n + k] = acct.name_byte(s_acct, k); }
        return n + acct.name_len(s_acct);
    }
    if (sys_flags() % 2 == 1) { return put_text(hb, 0, b"/home"); }
    return put_text(hb, 0, b"/");
}

void win_body(I64 i, I64 y) { win_body_span(i, y, 0, w); }

// DN-6 frame 8: float i's ring and bar on row y (float_row with its state).
void float_bar(I64 i, I64 y) {
    I64 x0 = layout.frame_x(i);
    I64 y0 = layout.frame_y(i);
    I64 x1 = x0 + layout.frame_w(i);
    I64 y1 = y0 + layout.frame_h(i);
    if (y < y0 || y >= y1) { return; }
    Bool lit = lit_of(i == focused() && !about.blocks(i), prompt_up());
    U32 ground = tok(tokens.PAPER);
    if (kind[i] == TERM) { ground = tokens.term_paper(); }
    if (y >= y0 + (FB + WBAR) * sc) {
        if (RIMLESS) {
            if (lit) {
                if (y < y1 - RAD * sc && x0 + 2 * RING * sc < x1) {
                    U32 fc = tok(tokens.FILL) & 0xFFFFFF;
                    for k in 0..RING * sc {
                        if (x0 + k >= 0 && x0 + k < len(row)) { row[x0 + k] = fc; }
                        if (x1 - 1 - k >= 0 && x1 - 1 - k < len(row)) { row[x1 - 1 - k] = fc; }
                    }
                } else {
                    draw.paint(row, x0, x1, tok(tokens.FILL));
                    shape.lower_rounded(row, y, x0 + RING * sc, y0 + WBAR * sc, x1 - RING * sc, y1 - RING * sc,
                                        (RAD - RING) * sc, ground);
                }
            }
            return;
        }
        I64 rt = 1;
        U32 e = tok(tokens.RULE);
        if (lit) {
            rt = 2;
            e = tok(ring_tok(gw[i]));
        }
        draw.frame(row, y, x0, y0, x1, y1, rt * sc, e);
        return;
    }
    U8[16] t;
    I64 n = win_name(i, t);
    U8[256] v;
    I64 vl = 0;
    if (kind[i] != SETTINGS && kind[i] != FAULT) { vl = var_of(i, v); }
    if (is_index(i) && wvar[WVAR * i + WVAR - 1] != 0) {
        vl = 0;                           // a path that filled the variable may be cut: the app's name (Index audit)
    } else if (vl > 0 && is_index(i)) {   // DN-55: Index's window bar names its folder, the path left to the bar
        U8[64] hp;
        I64 hn = home_of(hp);
        n = indexui.folder_name(v[0..vl], hp[0..hn], t);
        vl = 0;
    }
    Bool term = kind[i] == TERM;          // RS-TTL: a document's name in the bar (Read, Edit, View); a terminal's dot
    I64 p = bartitle.parts(shows_doc(i), vl, term && terms.menu_unsaved(slot[i]));
    I64 held = -1;
    if (bb_win == i) { held = bb_btn; }
    I64 hov = -1;
    if (bh_win == i) { hov = bh_btn; }
    I64 ic = win_icon3(i);
    if (kind[i] == FAULT) { ic = -1; }   // frame 23: a dialog's bar, its name and the close button alone
    float_row(x0, y0, x1, y1, sc, lit, ring_tok(gw[i]), ic, t, n, v, vl, p, held, hov, ground, y);   // DN-5's icon, as the plane's
}

// DN-36: ground is the body's color (the body is drawn here for a focused float, the ring its shape beside it).
// DN-6 frame 8 (design note 6, l 2026-11-10 04:48Z): a float's ring and bar on device row y, its frame the device
// rectangle [x0, x1) x [y0, y1) at UI scale s, the content's ground already on the row. Focused (lit): a 2 px ring
// in rk (ULTRAMARINE, or the grant's or ring 0's color, WB-5 and R0-3) and a FILL bar in ON_FILL; at rest a 1 px
// RULE ring over 1 px of the ground and a SURF1 bar in INK_DIM. The bar is WBAR px under the FB px inset; the ring's
// corners are corners_at's (radius RAD).
void float_row(I64 x0, I64 y0, I64 x1, I64 y1, I64 s, Bool lit, I64 rk, I64 ic, in U8[_] nm, I64 nl, in U8[_] v,
               I64 vl, I64 p, I64 held, I64 hov, U32 ground, I64 y) {
    if (y < y0 || y >= y1) { return; }
    if (RIMLESS) {
        // DN-24 B: ring and bar one solid shape in one color, no seam at any Size: focused, both FILL (DN-27: never a
        // grant's or ring 0's color; grants show in the system panel and the tiles' pips) with the bar's type in its
        // ink; at rest no ring and no outline, a SURF1 bar.
        I64 c = tokens.SURF1;
        I64 ink = tokens.INK_DIM;
        if (lit) {
            c = tokens.FILL;           // DN-27 (l 14:29Z, B): an app window's bar and ring never take a grant's color
            ink = ring_type(c);
        }
        if (y < y0 + WBAR * s) {       // DN-36: the bar, the shape's top WBAR px; nothing on its edges
            draw.paint(row, x0, x1, tok(c));
            bar_glyphs(x0 + FB * s, (x1 - x0) / s - 2 * FB, s, c, ink, ic, nm, nl, v, vl, p, held, hov, y - y0);
        } else if (lit) {              // DN-36: the shape beside and below the body, the body inset RING
            draw.paint(row, x0, x1, tok(c));
            shape.lower_rounded(row, y, x0 + RING * s, y0 + WBAR * s, x1 - RING * s, y1 - RING * s, (RAD - RING) * s,
                                ground);
        }
        return;
    }
    I64 rt = 1;
    U32 e = tok(tokens.RULE);
    I64 g = tokens.SURF1;
    I64 fg = tokens.INK_DIM;
    if (lit) {
        rt = 2;
        e = tok(rk);
        g = tokens.FILL;
        fg = tokens.ON_FILL;
    }
    if (y >= y0 + s && y < y0 + (FB + WBAR) * s) {
        draw.paint(row, x0 + s, x1 - s, tok(g));
        I64 dy = y - y0 - FB * s;
        if (dy >= 0) { bar_glyphs(x0 + FB * s, (x1 - x0) / s - 2 * FB, s, g, fg, ic, nm, nl, v, vl, p, held, hov, dy); }
    }
    draw.frame(row, y, x0, y0, x1, y1, rt * s, e);
}

// DN-6 frame 8, DN-23: the bar's device row dy (0..WBAR * s) from device x cx, uw px wide at 1x: its 1x geometry
// through the pen at zoom z (FONT-2 A: native at 2x) spread by s / z, then the buttons' glyphs at device pixels. The
// 16 px icon 8 px in, the name 8 px after it in NAME_BOLD (Inter 13 px 600, DN-23), the variable 8 px after the name
// in PATH, both cut 8 px before the buttons; four 24 px buttons of radius 6, no gap, the last 4 px from the window's
// right edge (2 from the bar's, inside the ring): minimize, full screen, tile, close. A button under the pointer
// (hov) takes the glyph's color at 12 percent, a pressed one (held) at 16, through MS-1's blend; the glyphs are
// kit/wbglyph.ci's 1.5 px strokes in a 12 px box at the UI scale s, ON_FILL on a focused bar and INK_DIM at rest.
// p is bartitle.parts' (RS-TTL): ICON, NAME and VAR as above; FILE (frame 40) the variable alone 12 px in, in
// NAME_BOLD, with no icon; DOT a 6 px round dot in the title's color 8 px before it, so the title moves to 26 px.
// A dialog's bar (ic < 0, frame 23): no icon, the name 8 px in, the close button alone.
void bar_glyphs(I64 cx, I64 uw, I64 s, I64 g, I64 fg, I64 ic, in U8[_] nm, I64 nl, in U8[_] v, I64 vl, I64 p,
                I64 held, I64 hov, I64 dy) {
    I64 z = 1;
    if (s % 2 == 0) { z = 2; }
    pen.at(cx, 0, z, dy / (s / z));
    pen.paint(row, cx, cx + uw, tok(g));
    I64 bx = cx + uw - 2 - 4 * BTN_W;
    I64 k0 = 0;
    if (ic < 0) { k0 = 3; }
    for k in k0..4 {
        I64 a = 0;
        if (hov == k) { a = 31; }
        if (held == k) { a = 41; }
        if (a > 0) { pen.round(row, bx + BTN_W * k, 4, bx + BTN_W * (k + 1), 28, R_CTRL, blend.mix_px(tok(g), tok(fg), a)); }
    }
    if ((p & bartitle.FILE) != 0) {
        I64 tx = cx + 12;
        if ((p & bartitle.DOT) != 0) {
            pen.round(row, tx, 13, tx + 6, 19, 3, tok(fg));
            tx = tx + 14;
        }
        I64 f = pen.text(row, tx, 8 + TBASE, bx - 8, v, vl, tok(fg), faces.NAME_BOLD);
    } else {
        I64 nx = cx + 8;
        if (ic >= 0) {
            icons3.icon_at(row, pen.row_y(), pen.x(cx + 8), pen.y(8), ic, 16, z, tok(g));
            nx = cx + 32;
        }
        I64 e = pen.text(row, nx, 8 + TBASE, bx - 8, nm, nl, tok(fg), faces.NAME_BOLD);
        if ((p & bartitle.VAR) != 0 && vl > 0) {
            e = ctext.text(row, pen.row_y(), e + 8 * z, pen.y(8 + TBASE), pen.x(bx - 8), v, vl, tok(fg), faces.PATH,
                           z);
        }
    }
    expand_by(cx, uw * z, s / z);
    I64 gy = dy - 10 * s;
    if (gy < 0 || gy >= 12 * s) { return; }
    for k in k0..4 {
        I64 gx = cx + s * (uw - 2 - 4 * BTN_W + BTN_W * k + 6);
        for q in 0..12 * s {
            I64 c = wbglyph.at(k, s, q, gy);
            if (c > 0) { row[gx + q] = blend.mix_px(row[gx + q], tok(fg), 16 * c); }
        }
    }
}

// Window i's program as kit/apps.ci names programs, into p; its length (kit/winname.ci prog: the title's first word,
// an image program's member path under the root, else under /bin; the session shell is cish).
I64 prog_path(I64 i, inout U8[40] p) { return winname.prog(title[16 * i..16 * i + title_len(i)], p); }

// DN-23, DN-22: window i's label on the bar and its window bar: its app's name in the app list (kit/winname.ci name:
// `Console`, `Edit`, `Index`; Settings), else its title as the kernel names it (`bin/cat`); into t, its length.
I64 win_name(I64 i, inout U8[_] t) {
    if (kind[i] == FAULT) { return put_text(t, 0, b"Fault"); }
    return winname.name(title[16 * i..16 * i + title_len(i)], kind[i] == SETTINGS, t);
}

// RS-TTL section 4.3: whether window i's app shows a document (Edit, Read; View, section 6), by its program as
// win_name names it.
Bool shows_doc(I64 i) {
    if (kind[i] != TERM && kind[i] != PIXEL) { return false; }
    U8[40] p;
    I64 n = prog_path(i, p);
    I64 a = apps.by_program(p[0..n]);
    return a != apps.NONE && apps.shows_doc(a);
}

// The switcher, the Super menu or Settings (window i), row y of the 1x frame x0, y0, x1, y1, into `row`.
// AC-V (docs/specs/2026-11-11-ac-v-prompt-words.md): the icon of the asking window by the desk's record: Settings
// for the desk's own window, else the icon of the app kp_title names.
I64 kp_icon_of() {
    if (kp_win >= 0 && kind[kp_win] == SETTINGS) { return icons3.SETTINGS; }
    return kp_icon;
}

// AC-V-R1 A (docs/specs/2026-11-11-ac-v-prompt-words.md edition 3): frame 17's subject into t, the desk's record
// of what asks: Settings for the desk's own window; with AC-T2 the asking program's own image (an app's name, else
// its path, `/bin/grant`); else the AC-T title for a terminal, the kernel's pid when no window of the desk asks.
// Never the request text, which is the asker's claim and is drawn only in frame 8's field.
I64 kp_subject(inout U8[_] t) {
    if (kp_win >= 0 && kind[kp_win] == SETTINGS) { return cat(t, 0, b"Settings"); }
    I64 n = prompttitle.subject(kp_exe, t);
    if (n > 0) { return n; }
    if (kp_win >= 0) {
        while (n < 16 && n < len(t) && kp_title[n] != 0) {
            t[n] = kp_title[n];
            n = n + 1;
        }
        return n;
    }
    n = cat(t, 0, b"pid ");
    return digits(t, n, kp_vp);
}

// R0-2, DN-6 frame 8 (design note 6): the kern prompt's row y at 1x from (x0, y0) (prompt_at with its state). The
// desk draws it; no program can draw over it or answer it (R0-R3 A).
void prompt_row(I64 x0, I64 y0, I64 y) {
    U8[96] t;
    I64 n = 0;
    I64 ic = icons3.TERMINAL;
    if (kp_win >= 0) {                 // AC-V: the desk's record alone, never the window's variable
        ic = kp_icon_of();
        while (n < 16 && kp_title[n] != 0) {
            t[n] = kp_title[n];
            n = n + 1;
        }
    }
    U8[24] pd;
    for k in 0..4 { pd[k] = b"pid "[k]; }
    I64 pn = digits(pd, 4, kp_vp);
    prompt_at(x0, y0, kp_text, kp_len, t, n, ic, pd, pn, y);
}

// DN-6 frame 8: the elevation prompt's plate, KP_W x KP_H at 1x from (x0, y0) through the pen: PAPER (the OV
// window's ground), a 36 px CADMIUM header with KERNEL ELEVATION REQUEST centered, 16 px in: the command c in a
// 36 px SURF2 field of radius 6, `requested from:`, the asking window's 16 px icon, its title and variable w and its
// pid p right aligned, then two 36 px buttons of radius 6, `Super+Enter Run` on CADMIUM at the left and `Esc Refuse`
// on SURF1 at the right, each key on a 20 px keycap of radius 4; DN-36: the plate one CADMIUM shape, the body PAPER inset 1 (its
// corners are corners_at's, radius 12). The sheet's Inter 600 and JetBrains Mono 13 and 11 draw as NAME and PATH.
void prompt_at(I64 x0, I64 y0, in U8[_] c, I64 cn, in U8[_] who, I64 wn, I64 ic, in U8[_] p, I64 pn, I64 y) {
    I64 x1 = x0 + KP_W;
    pen.rect(row, x0, y0, x1, y0 + KP_H, tok(tokens.CADMIUM));   // DN-36: one CADMIUM shape, the header its top 36
    pen.lower_round(row, x0 + RING, y0 + 36, x1 - RING, y0 + KP_H - RING, R_PLATE - RING, tok(tokens.PAPER));
    I64 e = ptxt_mid(x0, KP_W, y0 + 10, x1, b"KERNEL ELEVATION REQUEST", 24, tok(tokens.ON_FILL), faces.LABEL);
    pen.round(row, x0 + 16, y0 + 52, x1 - 16, y0 + 88, R_CTRL, tok(tokens.SURF2));
    e = ptxt(x0 + 28, y0 + 62, x1 - 28, c, cn, tok(tokens.INK), faces.PATH);
    e = ptxt(x0 + 16, y0 + 100, x1 - 16, b"requested from:", 15, tok(tokens.INK_DIM), faces.BODY);
    if (y >= y0 + 128 && y < y0 + 144) {
        icons3.icon_at(row, pen.row_y(), pen.x(x0 + 16), pen.y(y0 + 128), ic, 16, pen.zoom(), tok(tokens.PAPER));
    }
    I64 px = pen.x(x1 - 16) - pen.width(p, pn, faces.PATH);   // the pid right aligned, at the zoom
    e = ctext.text(row, pen.row_y(), pen.x(x0 + 40), pen.y(y0 + 128 + TBASE), px - 8 * pen.zoom(), who, wn,
                   tok(tokens.INK), faces.PATH, pen.zoom());
    e = pen.text_right(row, x1 - 16, y0 + 128 + TBASE, p, pn, tok(tokens.INK_DIM), faces.PATH);
    I64 kw = txt_w(b"Super+Enter", 11, faces.PATH) + 12;
    I64 rw = 12 + kw + 10 + txt_w(b"Run", 3, faces.NAME) + 12;
    pen.round(row, x0 + 16, y0 + 160, x0 + 16 + rw, y0 + 196, R_CTRL, tok(tokens.CADMIUM));
    pen.ring(row, x0 + 28, y0 + 168, x0 + 28 + kw, y0 + 188, R_KEY, 1, tok(tokens.ON_FILL));
    e = ptxt_mid(x0 + 28, kw, y0 + 170, x0 + 28 + kw, b"Super+Enter", 11, tok(tokens.ON_FILL), faces.PATH);
    e = ptxt(x0 + 38 + kw, y0 + 170, x0 + 16 + rw, b"Run", 3, tok(tokens.ON_FILL), faces.NAME);
    I64 ew = txt_w(b"Esc", 3, faces.PATH) + 12;
    I64 fw = 12 + ew + 10 + txt_w(b"Refuse", 6, faces.NAME) + 12;
    pen.round(row, x1 - 16 - fw, y0 + 160, x1 - 16, y0 + 196, R_CTRL, tok(tokens.SURF1));
    pen.ring(row, x1 - 4 - fw, y0 + 168, x1 - 4 - fw + ew, y0 + 188, R_KEY, 1, tok(tokens.RULE));
    e = ptxt_mid(x1 - 4 - fw, ew, y0 + 170, x1 - 4 - fw + ew, b"Esc", 3, tok(tokens.INK_DIM), faces.PATH);
    e = ptxt(x1 + 6 - fw + ew, y0 + 170, x1 - 16, b"Refuse", 6, tok(tokens.INK), faces.NAME);
}

// R0-3: each terminal's hold, the seconds its shell has left in ring 0 (FBIO_TILE_INFO kind 4); a hold that ended
// is said once. RG-1: a pixel window's too, so the bar keeps the minutes of an app whose terminal is a host (lx_host).
void holds() {
    for i in 0..WINDOWS {
        I64 was = whold[i];
        whold[i] = 0;
        if (kind[i] == TERM || kind[i] == PIXEL) {
            I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 4, pid[i], ask[0..64]);
            if (st == 0) { whold[i] = word_at(ask, 0); }
        }
        if (was > 0 && whold[i] == 0) { "hdesk: kern hold {i} ended\n"; }
    }
}

// A prompt remains bound to the oldest live kernel request.
Bool kern_live() {
    if (!kp_open) { return false; }
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 6, 0, ask[0..64]);
    return st == 0 && word_at(ask, 0) == kp_vp && word_at(ask, 1) == kp_want && word_at(ask, 2) == kp_uid;
}

void kern_clear() {
    ah_generation = 0;
    kp_retry = false;
    if (kp_field) {
        wipe_fields();
        ac_notel = 0;
    }
    kp_field = false;
    kp_open = false;
}

void kern_refresh() {
    if (kp_open && !ac_op_up && !deskask.up() && !kern_live()) {   // RS-AQ, the desk's asks: no kernel request
        "hdesk: kern gone pid {kp_vp}\n";
        kern_clear();
        redraw();
        kern_next();
    }
}

// R0-2: the oldest request the desk has not answered, if any, on the prompt.
void kern_next() {
    if (ac_screen != 0) { kp_retry = false; return; }
    if (kp_open) { return; }
    kp_retry = false;
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 3, 0, ask[0..64]);
    if (st != 0) { return; }
    kp_want = GRANT_KERN;
    kp_uid = 0;
    if (ac_on) {
        st = hdeskctl.tile_ask(FBIO_TILE_INFO, 6, 0, ask[0..64]);
        if (st != 0) { kp_retry = true; return; }
        kp_vp = word_at(ask, 0);
        kp_want = word_at(ask, 1);
        kp_uid = word_at(ask, 2);
        st = hdeskctl.tile_ask(FBIO_TILE_INFO, 3, 0, ask[0..64]);
        if (st != 0 || word_at(ask, 0) != kp_vp) { kp_retry = true; return; }
    } else {
        kp_vp = word_at(ask, 0);
    }
    kp_len = reqtext.clean(ask[8..64], word_at(ask, 1), kp_text);   // AC-V-R1: printable ASCII only, prompt and log
    kp_win = -1;
    for i in 0..WINDOWS {
        if (kp_win < 0 && kind[i] == TERM && info(i) && vpid[i] == kp_vp) { kp_win = i; }
    }
    for k in 0..64 { kp_exe[k] = 0; }
    if (kp_vp > 0 && hdeskctl.tile_ask(FBIO_TILE_INFO, 13, kp_vp, ask[0..64]) == 0 && word_at(ask, 0) == kp_vp) {
        for k in 0..64 { kp_exe[k] = ask[k]; }   // AC-T2: what the asker runs, as the kernel loaded it
    }
    for k in 0..16 { kp_title[k] = 0; }
    kp_icon = icons3.TERMINAL;
    if (kp_win >= 0) {
        if (hdeskctl.tile_ask(FBIO_TILE_INFO, 13, pid[kp_win], ask[0..64]) != 0) { for k in 0..64 { ask[k] = 0; } }
        I64 tl = prompttitle.title(lx_app[kp_win] - 1, ask[0..64], kp_title);   // AC-T2: the image only withdraws it
        kp_icon = prompttitle.icon(lx_app[kp_win] - 1, ask[0..64]);             // AC-V: the icon of that record
    }
    kp_field = ac_on;
    if (ac_on) {
        if (kp_win >= 0 && kp_win == cool_win && now_ns() < cool_until) {
            I64 r = hdeskctl.tile_ask(FBIO_TILE_KERN, kp_vp, 0, ask[0..64]);   // AC-D4: refused, no prompt
            "hdesk: refused at once pid {kp_vp}\n";
            kern_next();
            return;
        }
        I64 ua = acct_of_uid(kp_uid);
        kp_parent_hdr = !(ua >= 0 && acct.role_of(ua) == acct.PARENT && kp_want == GRANT_KERN);
        if (kp_parent_hdr) { kp_appr = acct.next_parent(-1); } else { kp_appr = ua; }   // L9: a parent's own passphrase
        if (kp_appr < 0) {
            I64 r = hdeskctl.tile_ask(FBIO_TILE_KERN, kp_vp, 0, ask[0..64]);
            "hdesk: no parent to ask, refused pid {kp_vp}\n";
            return;
        }
        kp_deadline = now_ns() + TIMEOUT_NS;
        wipe_fields();
        ac_notel = 0;
        "hdesk: approval ask want {kp_want} uid {kp_uid}\n";
    }
    if (grab >= 0) { ungrab(); }
    sw_open = false;
    mn_open = false;
    mn_app = false;
    cal_open = false;
    sp_open = false;
    tr_open = false;
    if (kp_generation == 0xFFFFFFFFFFFFFFFF) {
        I64 denied = hdeskctl.tile_ask(FBIO_TILE_KERN, kp_vp, 0, ask[0..64]);
        kern_clear();
        "hdesk: approval generations exhausted\n";
        return;
    }
    kp_generation = kp_generation + 1;
    kp_open = true;
    "hdesk: kern ask {kp_win} pid {kp_vp} |";
    I64 put = ptyctl.pty_write(1, kp_text[0..kp_len]);
    "|\n";
    redraw();
}

// R0-2: the person's answer: Super+Enter confirms (the bit on the asking process, and R0-R4 B, the window's shell
// held for 5 minutes), Esc or a click off the prompt refuses.
void kern_answer(Bool yes) {
    if (!kp_open) { return; }
    if (ac_op_up) {                    // RS-AQ: Esc, a click off, the deadline, a lock or a log out
        ac_op_cancel();
        return;
    }
    if (deskask.up()) {                // the desk's own ask: the same ways out
        kq_cancel();
        return;
    }
    if (yes && !kern_live()) {
        kern_clear();
        redraw();
        kern_next();
        return;
    }
    I64 st = 0;
    if (yes) {
        if (kp_field && now_ns() >= kp_deadline) {
            kern_answer(false);
            return;
        }
        st = hdeskctl.tile_ask(FBIO_TILE_KERN, kp_vp, 1, ask[0..64]);
        if (st == 0 && kp_field) {
            ac_fails[kp_appr] = 0;
            "hdesk: approved by ";
            put_name(kp_appr);
            "\n";
        }
        if (st == 0 && kp_want == GRANT_KERN) {
            "hdesk: kern {kp_win} pid {kp_vp}\n";
            if (kp_win >= 0) { st = hdeskctl.tile_ask(FBIO_TILE_KERN, pid[kp_win], 2, ask[0..64]); }
        } else if (st == 0) {
            "hdesk: grant {kp_want} to pid {kp_vp}\n";   // AC-1a: the bits on the asking process's tree only (L2)
        }
        if (st == 0) { gr_asked(kp_win, kp_want); }   // frame 21: the object the desk said yes to
    } else {
        st = hdeskctl.tile_ask(FBIO_TILE_KERN, kp_vp, 0, ask[0..64]);
        "hdesk: kern refused pid {kp_vp}\n";
        if (kp_field) {
            cool_win = kp_win;                 // AC-D4: 30 s without a prompt for this window
            cool_until = now_ns() + COOL_NS;
        }
    }
    kern_clear();
    Bool g = grants();
    holds();
    redraw();
    kern_next();
}

// FBIO_TILE_SYNC 9: a request waits, or a hold ended or turned a minute.
void kern_event() {
    kern_refresh();
    Bool g = grants();
    holds();
    bar(false);
    if (g) { redraw(); }
    kern_next();
}

// --- AC-1c (docs/specs/2026-11-08-ac-accounts.md): accounts, login, lock and the approval prompt ---
// Accounts are on when the desk runs on a volume set up for them (`/home/.daphnis`, made by tools/mkdisk.sh
// --accounts). Without one the desk is today's single desk of uid 0 and nothing below runs (AC-D11): no gate that
// boots without that directory moves.

const I64 KEY_L = 38;
const I64 AC_CW = 380;               // the account cards, 380 wide at 1x
const I64 KP_H2 = 300;               // AC-1c, DN-6 frame 8: the prompt with its passphrase field (L2, L9)
const I64 SCR_NONE = 0;
const I64 SCR_FIRST = 1;             // first boot: the parent account (L1)
const I64 SCR_LOGIN = 2;             // the names, then the passphrase (L3)
const I64 SCR_LOCK = 3;              // L4: the plane covered (DN-41 (a): the bar the roundel and the clock only)
const I64 SCR_BROKEN = 4;            // the store is there and cannot be read: no first boot, only shut down
const I64 AH_NONE = 0;
const I64 AH_LOGIN = 1;
const I64 AH_UNLOCK = 2;
const I64 AH_ENROLL = 3;
const I64 AH_APPROVE = 4;
const I64 AH_ACCOUNT = 5;            // RS-AQ: an Accounts page operation (acctask)
const I64 AH_DESK = 6;               // the desk's own ask (kit/deskask.ci): an approver's password, checked
const I64 DS6_M = 65536;             // DS-6: Argon2id, 64 MiB, 3 passes, for every account the desk enrolls
const I64 DS6_T = 3;
const I64 TIMEOUT_NS = 120000000000; // AC-D4: an unanswered prompt refuses itself after 120 s
const I64 COOL_NS = 30000000000;     // and the same window's next request within 30 s is refused without one
Bool ac_on = false;
I64 ac_screen = 0;
I64 s_acct = -1;                     // the account logged in, -1 for none
I64 s_uid = -1;                      // LO-1: the uid the seat names, kept apart from the store's index (a lost account)
I64 ac_sel = 0;                      // the login screen's chosen row (acct.shown order)
I64 ac_top = 0;                      // the first of the 8 rows the login screen shows
I64 ac_focus = 0;                    // first boot's field: 0 name, 1 passphrase, 2 again
U8[32] ac_name;
I64 ac_nl = 0;
U8[256] ac_p1;
I64 ac_p1n = 0;
U8[256] ac_p2;
I64 ac_p2n = 0;
U8[48] ac_note;
I64 ac_notel = 0;
Bool ac_note_bad = true;      // frame 12: the note line in OCHRE (a refusal) or INK_DIM
I64[16] ac_fails;                    // AC-D2: wrong passphrases in a row, per account, in memory only
I64[16] ac_until;                    // the wall clock (ns) until which that account's field waits
I64 ac_shown_s = -1;                 // the whole seconds of wait last drawn
Bool ah_busy = false;
I64 ah_what = 0;
I64 ah_acct = -1;
U64 ah_generation = 0;
I64 ah_requester = -1;
I64 ah_uid = -1;
I64 ah_want = 0;
U64 ah_session = 0;
U64 session_generation = 0;
I64 ah_screen = 0;                   // the account screen a verify was asked from
U64 ah_epoch = 0;                    // auth_epoch when the verify was asked
U64 auth_epoch = 0;                  // bumped by logout() and lock_now(): a verify in flight across either is stale
U8[256] ah_ans;
I64 ah_n = 0;
U8[640] ah_req;                      // RS-R4: authreq.REQ_MAX is 593; host.c auth_start sends up to 640
U8[4096] ac_sbuf;
Bool kp_field = false;               // the prompt asks a passphrase (accounts on)
I64 kp_want = GRANT_KERN;            // AC-1a's request word: GRANT_KERN for kern, else grant bits
I64 kp_uid = 0;
I64 kp_appr = -1;                    // the account whose passphrase the prompt takes
Bool kp_parent_hdr = false;          // PARENT APPROVAL (a child's request, or a grant past a ceiling) or KERNEL ELEVATION
I64 kp_deadline = 0;
I64 cool_win = -1;
I64 cool_until = 0;
Bool bar_auth = false;

Bool auth_live() { return ac_screen == SCR_FIRST || ac_screen == SCR_LOGIN || ac_screen == SCR_LOCK || (kp_open && kp_field); }

I64 now_ns() { return wall.wall_ns(); }

// DN-37: authd is checking a passphrase: the note line shows the wheel, unknown, in place of any words.
Bool ac_checking = false;
I64 ac_check_t0 = 0;
I64 ac_check_ph = -1;
const I64 CHECK_FRAME_MS = 50;         // the wheel redrawn when it has turned this far (DN-37: a turn in 1.2 s)

void checking() {
    ac_notel = 0;
    ac_checking = true;
    ac_check_t0 = now_ns();
    ac_check_ph = -1;
}

Bool checking_now() { return ac_checking && ah_busy; }

I64 check_ms() { return (now_ns() - ac_check_t0) / 1000000; }

void note(in U8[_] s) {
    ac_checking = false;
    ac_note_bad = true;                // frame 12: a refusal's line in OCHRE; note_ok for the others
    ac_notel = len(s);
    if (ac_notel > 48) { ac_notel = 48; }
    for k in 0..ac_notel { ac_note[k] = s[k]; }
}

// A note that is no refusal (making the account): INK_DIM on frame 12.
void note_ok(in U8[_] s) {
    note(s);
    ac_note_bad = false;
}

void wipe_fields() {
    for k in 0..256 {
        ac_p1[k] = 0;
        ac_p2[k] = 0;
    }
    ac_p1n = 0;
    ac_p2n = 0;
    kp_bad = false;                    // FV-1: a wiped field (sent, or a new prompt) is no longer the wrong one
}

// The ring color of the prompt now: cadmium for ring 0, ochre for a disk grant, sienna for the others (L8).
I64 kp_color() {
    if (!kp_field || kp_want == GRANT_KERN) { return tokens.CADMIUM; }
    if ((kp_want & 1) != 0) { return tokens.OCHRE; }
    return tokens.SIENNA;
}

I64 kp_h() {
    if (kp_field) { return KP_H2; }
    return KP_H;
}

// We select a complete account store before choosing login, recovery or enrollment.
I64 store_read() { return acctio.load(ac_sbuf); }

// The store written whole (section 4) by the one writer authd and /bin/accounts use (RS-AQ): accounts.new.PID made
// new, the file in place kept as accounts.prev only when it was read whole, the rename, the sync.
Bool store_write() {
    I64 n = acct.write_text(ac_sbuf);
    return acctput.save(ac_sbuf, n, acctio.from_primary()) == 0;
}

void ac_init() {
    I64[16] st;
    ac_on = sys_flags() % 2 == 1 && corectl.co_stat(b"/home/.daphnis", 1, st) == 0 && (st[2] & 0xF000) == 0x4000;
    if (!ac_on) {
        _ = hdeskctl.seat(0);                  // LO-1: accounts off, every process is uid 0
        return;
    }
    _ = hdeskctl.seat(-1);                     // LO-1: no session until a login names one
    I64 n = store_read();
    if (n == 0) {
        ac_screen = SCR_FIRST;
        "hdesk: accounts first boot\n";
    } else if (n < 0) {
        ac_screen = SCR_BROKEN;
        "hdesk: accounts store unreadable\n";
    } else {
        ac_screen = SCR_LOGIN;
        "hdesk: accounts {n}\n";
    }
}

void put_name(I64 i) {
    I64 n = acct.name_len(i);
    U8[32] t;
    for k in 0..n { t[k] = acct.name_byte(i, k); }
    I64 put = ptyctl.pty_write(1, t[0..n]);
}

// AC-D8: authd started on req's first n bytes; the desk's copies of the passphrase are wiped at once.
void ah_start(I64 what, I64 a, I64 n) {
    for k in 0..4 { put_word(req, k, 0); }
    I64 none = tilectl.tile_ctl(FBIO_TILE_NEXT, req);   // authd, this process's child, takes no tile
    I64 st = hdeskctl.auth_start(ah_req[0..n]);
    for k in 0..640 { ah_req[k] = 0; }
    wipe_fields();
    offer();
    if (st != 0) {
        "hdesk: auth not started ({st})\n";
        note(b"authd could not start");
        return;
    }
    ah_busy = true;
    ah_what = what;
    ah_acct = a;
    ah_generation = 0;
    ah_session = session_generation;   // every verify is bound to the session, screen and epoch that asked it
    ah_screen = ac_screen;
    ah_epoch = auth_epoch;
    if (what == AH_APPROVE) {
        ah_generation = kp_generation;
        ah_requester = kp_vp;
        ah_uid = kp_uid;
        ah_want = kp_want;
    }
    if (what == AH_DESK) { ah_generation = kp_generation; }   // bound to the prompt it was typed on
    ah_n = 0;
    "hdesk: auth start {what}\n";
}

I64 req_put(I64 at, in U8[_] s) {
    for k in 0..len(s) { ah_req[at + k] = s[k]; }
    return at + len(s);
}

I64 req_num(I64 at, I64 v) {
    U8[20] d;
    I64 e = digits(d, 0, v);
    for k in 0..e { ah_req[at + k] = d[k]; }
    return at + e;
}

// The verify request for account a and the passphrase in ac_p1.
void ah_verify(I64 what, I64 a) {
    I64 at = req_put(0, b"verify ");
    at = req_num(at, acct.m_of(a));
    ah_req[at] = 32;
    at = req_num(at + 1, acct.t_of(a));
    ah_req[at] = 32;
    at = at + 1;
    for k in 0..32 { ah_req[at + k] = acct.salt_byte(a, k); }
    ah_req[at + 32] = 32;
    at = at + 33;
    for k in 0..64 { ah_req[at + k] = acct.ver_byte(a, k); }
    ah_req[at + 64] = 10;
    at = at + 65;
    for k in 0..ac_p1n { ah_req[at + k] = ac_p1[k]; }
    ah_start(what, a, at + ac_p1n);
}

Bool waiting(I64 a) { return a >= 0 && a < 16 && now_ns() < ac_until[a]; }

void failed(I64 a) {
    if (a < 0 || a >= 16) { return; }
    ac_fails[a] = ac_fails[a] + 1;
    I64 d = acct.delay_s(ac_fails[a]);
    ac_until[a] = now_ns() + d * 1000000000;
    note(b"Wrong password");          // DN-52 (b): the screen word is Password
    if (kp_open && kp_field && a == kp_appr) {   // FV-1: the prompt's field turns CADMIUM and shakes
        kp_bad = true;
        kp_shake_t0 = wall.wall_ns();
        ac_notel = 0;
    }
}

// A session for account i: its home made if it is not there, then its first terminal through login (AC-1a).
void start_session(I64 i) {
    if (session_generation == 0xFFFFFFFFFFFFFFFF) {
        ac_screen = SCR_BROKEN;
        redraw();
        return;
    }
    // FS-3: the home first, made 0700 as the account or checked by the kernel; a refused home starts nothing
    U8[48] hp;
    I64 n = 0;
    for k in 0..6 { hp[k] = b"/home/"[k]; }
    n = 6;
    for k in 0..acct.name_len(i) { hp[n + k] = acct.name_byte(i, k); }
    n = n + acct.name_len(i);
    I64 hm = hdeskctl.home(hp[0..n], acct.uid_of(i), acct.gid_of(i));
    if (hm != 0) {
        "hdesk: home refused ";
        put_name(i);
        " ({hm})\n";
        ac_screen = SCR_LOGIN;
        wipe_fields();
        note(b"this account's home folder cannot be used");
        redraw();
        return;
    }
    sh_drop();                                 // RS-SHOT: no plate of an earlier session
    s_uid = acct.uid_of(i);
    _ = hdeskctl.seat(s_uid);                  // LO-1: the offered tile is this account's alone
    session_generation = session_generation + 1;
    s_acct = i;
    st_storage_forget();
    ac_fails[i] = 0;
    ac_screen = SCR_NONE;
    ac_notel = 0;
    "hdesk: login ";
    put_name(i);
    " uid {acct.uid_of(i)}\n";
    I64 t = new_term(true, apps.NONE);   // the session's first terminal, a tile as at boot (DN-20, HX-7)
    clock_prefs();                     // RS-TZb: this account's 24-Hour Time
    rn_queue(RUN_PREFS);               // RG-1: its settings, read as the account (pf_end reads them again)
    redraw();
    kern_next();
}

// The session ends with its first terminal's shell (L1's log out): every window closed, back to the names.
// LO-1 (FE-1): no process takes the offered tile from here to the next login; right after the SIGTERMs every process
// of the account ends (sweep), whatever its session or what it ignores, so the session is over when this returns. No
// hold between them: Daphnis runs no signal handler (rt_sigaction records SIG_IGN alone), and the kernel ends each
// target inside the call that signals it (kill) or right after it (TIOCSIGSESS, tty_signals), so a SIGTERM has landed
// before the sweep. It never asks and cannot be cancelled: the forced ends call it too.
void logout() {
    rn_clear();                        // first: no run as the account that leaves (P1, PR 412's line read)
    sh_drop();                         // RS-SHOT: the held screen let go; no shot of the account shows its plate
    if (indextrash.is_up()) { indextrash.close(); }   // and no Empty Trash ask left up for the next account
    keysheet.close();                                  // frame 27: nor the shortcut sheet
    if (unsaved.is_up()) { unsaved.close(); }         // nor AM section 7's: the next account's Restart scans its own
    st_storage_forget();
    ac_screen = SCR_LOGIN;
    ah_generation = 0;
    auth_stale();
    _ = hdeskctl.seat(-1);
    "hdesk: logout ";
    if (s_acct >= 0) { put_name(s_acct); }
    "\n";
    for i in 0..WINDOWS {
        if (kind[i] == TERM) { I64 st = hdeskctl.pty_sigsess(master[i], SIGTERM); }
        if (kind[i] == PIXEL && info(i)) { I64 st = tilectl.stop(vpid[i], SIGTERM); }
    }
    if (s_uid >= 1) {                          // the session's uid, even when its account is gone from the store
        I64 gone = hdeskctl.sweep(s_uid);
        "hdesk: sweep uid {s_uid} ended {gone}\n";
    }
    s_uid = -1;
    for i in 0..WINDOWS {
        if (kind[i] != NONE) { close_window(i); }
    }
    if (kp_open) { kern_answer(false); }
    s_acct = -1;
    clock_prefs();                     // RS-TZb: no account's hours at the names
    ac_sel = 0;
    ac_top = 0;
    ac_screen = SCR_LOGIN;
    I64 na = store_read();                     // the store again: `kern accounts` may have changed it
    if (na < 1) { ac_screen = SCR_BROKEN; }
    "hdesk: accounts {na}\n";
    redraw();
}

// AC-D5: the idle lock. route() notes the time of every input; as the clock's minute turns, a session whose
// account has gone its idle minutes (acct.idle_of, 10 unless a parent set it with `kern accounts idle`) without
// input locks as Super+L does. Without a live date there is no minute and no idle lock (K-6).
I64 idle_last = 0;

void idle_check() {
    if (ac_screen != SCR_NONE || s_acct < 0) { return; }
    if (!acct.idle_due(now_ns(), idle_last, acct.idle_of(s_acct))) { return; }
    "hdesk: idle lock after {acct.idle_of(s_acct)} min\n";
    lock_now();
}

// AC-D5: Super+L. Every window's ring 0 hold ends now (running commands keep what they hold until they end); an
// open prompt is refused; the plane is covered.
void lock_now() {
    sh_drop();                         // RS-SHOT: the held screen let go, no plate on the lock screen
    ac_screen = SCR_LOCK;
    ah_generation = 0;
    auth_stale();
    for i in 0..WINDOWS {
        if (kind[i] == TERM && whold[i] > 0) { I64 st = hdeskctl.tile_ask(FBIO_TILE_KERN, pid[i], 3, ask[0..64]); }
    }
    if (kp_open) { kern_answer(false); }
    ac_form_end();                     // RS-AQ: the form ends with the session's screen
    if (indextrash.is_up()) { indextrash.close(); }   // frame 23's ask too, refused as the prompt is: nothing emptied
    keysheet.close();                  // frame 27: the shortcut sheet too
    if (grab >= 0) { ungrab(); }
    sw_open = false;
    mn_open = false;
    cal_open = false;
    sp_open = false;
    tr_open = false;
    pl_open = false;
    holds();
    wipe_fields();
    ac_notel = 0;
    ac_screen = SCR_LOCK;
    "hdesk: lock ";
    put_name(s_acct);
    "\n";
    redraw();
}

// A verify in flight across a log out or a lock answers nothing: its result is dropped when it comes.
void auth_stale() {
    if (auth_epoch == 0xFFFFFFFFFFFFFFFF) { auth_epoch = 1; } else { auth_epoch = auth_epoch + 1; }
}

// A login, unlock or enrollment answer counts only on the screen, session and account it was asked for.
Bool ah_current(I64 a) {
    if (ah_epoch != auth_epoch || ah_session != session_generation || ah_screen != ac_screen) { return false; }
    if (ah_what == AH_LOGIN) { return ac_screen == SCR_LOGIN && s_acct < 0; }
    if (ah_what == AH_UNLOCK) { return ac_screen == SCR_LOCK && s_acct >= 0 && a == s_acct; }
    if (ah_what == AH_ENROLL) { return ac_screen == SCR_FIRST && s_acct < 0; }
    return false;
}

// authd's answer, whole: what was asked goes on.
void ah_done() {
    ah_busy = false;
    ac_checking = false;
    Bool ok = ah_n >= 3 && ah_ans[0] == 111 && ah_ans[1] == 107 && ah_ans[2] == 10;   // "ok\n"
    I64 a = ah_acct;
    if (ah_what == AH_ACCOUNT) {         // RS-AQ: judged by the session, not the screen (a lock keeps it)
        ac_op_done(a);
        return;
    }
    if (ah_what == AH_DESK) {
        kq_auth(ok, a);
        return;
    }
    if (ah_what != AH_APPROVE && !ah_current(a)) {
        "hdesk: auth stale ignored\n";
        redraw_overlay();
        return;
    }
    if (ah_what == AH_ENROLL) {
        // "salt HEX\nverifier HEX\n"
        Bool good = ah_n >= 5 + 32 + 1 + 9 + 64 && ah_ans[0] == 115;
        if (good) {
            U8[32] salt;
            U8[64] ver;
            for k in 0..32 { salt[k] = ah_ans[5 + k]; }
            for k in 0..64 { ver[k] = ah_ans[47 + k]; }
            I64 u = acct.next_uid();
            I64 i = acct.add(ac_name, ac_nl, acct.PARENT, u, u, DS6_M, DS6_T, salt, ver, 7, salt);
            if (i >= 0 && store_write()) {
                "hdesk: first parent ";
                put_name(i);
                " uid {u}\n";
                start_session(i);
                return;
            }
        }
        I64 el = 0;
        while (el < ah_n && el < 48 && ah_ans[el] != 10) { el = el + 1; }
        "hdesk: enroll failed |";
        I64 pe = ptyctl.pty_write(1, ah_ans[0..el]);   // authd's error line (no passphrase is ever in it)
        "|\n";
        if (el >= 14 && ah_ans[6] == 103) {
            note(b"no entropy source for the salt");
        } else {
            note(b"the account could not be made");
        }
        redraw();
        return;
    }
    if (ah_what == AH_APPROVE) {
        if (!kp_open || !kp_field || ac_screen != SCR_NONE || ah_generation == 0 ||
            ah_generation != kp_generation || ah_requester != kp_vp || ah_uid != kp_uid ||
            ah_want != kp_want || ah_session != session_generation || a != kp_appr ||
            now_ns() >= kp_deadline || !kern_live()) {
            "hdesk: approval stale ignored\n";
            return;
        }
        if (ok) {
            kern_answer(true);
            return;
        }
        "hdesk: approval wrong passphrase\n";
        failed(a);
        redraw_overlay();
        return;
    }
    if (ok && ah_what == AH_LOGIN) {
        start_session(a);
        return;
    }
    if (ok && ah_what == AH_UNLOCK) {
        ac_fails[a] = 0;
        ac_screen = SCR_NONE;
        ac_notel = 0;
        "hdesk: unlock ";
        put_name(a);
        "\n";
        redraw();
        kern_next();
        return;
    }
    "hdesk: auth refused ";
    put_name(a);
    "\n";
    failed(a);
    redraw_overlay();
}

// --- RS-AQ (docs/specs/2026-11-11-rs-accounts-page.md): the Accounts page's requests to authd ---
// user/ci/acctask.ci holds the operation; the prompt is frame 17's PARENT APPROVAL with its field, raised by the
// desk itself (no kernel request: kp_vp 0); the request goes through ah_start as a verify does.
Bool ac_op_up = false;               // the prompt on screen is an Accounts operation's
U64 ac_op_session = 0;               // the session the request was sent from

// The Settings host's call for kit/stacct.ci's ADD to REMOVE: arg the account in the store's order (the host feeds
// the page in that order), arg2 the role or the ceiling word.
void ac_op_page(I64 a, I64 k, I64 v) {
    if (!ac_on || s_acct < 0 || ac_screen != SCR_NONE || kp_open || ah_busy || ask_up()) { return; }
    I64 ph = acctask.begin(a, k, v, s_acct);
    if (ph != acctask.PROMPT && ph != acctask.FORM) {
        "hdesk: accounts op {a} cannot work\n";
        return;
    }
    ac_shut();
    if (ph == acctask.FORM) {          // Add Account, Change Password: frame 49 first
        acctform.open();
        "hdesk: accounts form {a}\n";
        redraw();
        return;
    }
    ac_op_prompt();
}

// What else is open closes for the operation's form or prompt.
void ac_shut() {
    if (grab >= 0) { ungrab(); }
    sw_open = false;
    mn_open = false;
    mn_app = false;
    cal_open = false;
    sp_open = false;
    tr_open = false;
}

// Frame 17's PARENT APPROVAL for the operation at PROMPT.
void ac_op_prompt() {
    ac_op_up = true;
    kp_open = true;
    kp_field = true;
    kp_parent_hdr = true;
    kp_want = 0;                       // the ring SIENNA, a parent's approval (L8)
    kp_uid = acct.uid_of(s_acct);
    kp_vp = 0;
    kp_win = st_win;
    kp_appr = acctask.approver();
    kp_deadline = now_ns() + TIMEOUT_NS;
    wipe_fields();
    ac_notel = 0;
    "hdesk: accounts ask {acctask.operation()}\n";
    redraw();
}

// The form's answer r (acctform.STAY, DONE or CANCEL): DONE raises the prompt.
void af_answer(I64 r) {
    if (r == acctform.DONE) {
        ac_op_prompt();
        return;
    }
    if (r == acctform.CANCEL) {
        "hdesk: accounts form closed\n";
        redraw();
        kern_next();
        return;
    }
    redraw_overlay();
}

// The form ends without an answer (a click off, a lock, the Settings window closing).
void ac_form_end() {
    if (!acctform.is_up()) { return; }
    acctask.cancel();
    acctform.close();
}

// Enter on the prompt: the request built from the field, then authd. The account removed is the one signed in:
// its session ends first (RS-ROLE), and the answer comes to the names.
void ac_op_send() {
    if (ac_p1n == 0 || kp_appr < 0 || waiting(kp_appr)) { return; }
    I64 a = kp_appr;
    I64 n = acctask.request(ah_req, ac_p1, ac_p1n);
    if (n < 0) {
        wipe_fields();
        redraw_overlay();
        return;
    }
    "hdesk: accounts by ";
    put_name(a);
    "\n";
    if (acctask.ends_first()) {
        ac_op_down();
        logout();
    } else {
        checking();
    }
    ac_op_session = session_generation;
    ah_start(AH_ACCOUNT, a, n);
    if (!ah_busy) {                    // authd did not start: no answer will come, so nothing was asked
        acctask.cancel();
        ac_op_down();
        kern_next();
    }
    redraw_overlay();
}

// The store read again with the session's account and AC-D2's counts kept by uid: an index moves when an account
// before it is removed.
I64 ac_reread() {
    I64[16] fu;
    I64[16] ff;
    I64[16] fw;
    I64 su = -1;
    if (s_acct >= 0) { su = acct.uid_of(s_acct); }
    I64 n0 = acct.accounts();
    for i in 0..16 {
        fu[i] = -1;
        if (i < n0) { fu[i] = acct.uid_of(i); }
        ff[i] = ac_fails[i];
        fw[i] = ac_until[i];
        ac_fails[i] = 0;
        ac_until[i] = 0;
    }
    I64 na = store_read();
    for i in 0..16 {
        I64 j = -1;
        if (fu[i] >= 0) { j = acct_of_uid(fu[i]); }
        if (j >= 0) {
            ac_fails[j] = ff[i];
            ac_until[j] = fw[i];
        }
    }
    if (su >= 0) { s_acct = acct_of_uid(su); }
    return na;
}

void ac_op_down() {
    if (!ac_op_up) { return; }
    ac_op_up = false;
    kp_open = false;
    kp_field = false;
    kp_bad = false;
    wipe_fields();
    ac_notel = 0;
}

// --- the desk's own asks (kit/deskask.ci): Settings' Date and Time, Set and the zone, on frame 17 ---
// Raised by the desk itself, as an Accounts operation is (no kernel request: kp_vp 0): PARENT APPROVAL with the
// field, the signed-in account's own password when it is a parent, else the first parent's (Tab: the next parent).
// The password goes to authd as a verify (AH_DESK), bound to the session, the screen and this prompt's generation.
// Approved, the act waits for the desk's tick (kp_done), which makes the call itself, as uid 0. With accounts off
// the desk asks no one (AC-D11).

// Act a (deskask.CLOCK or ZONE) with arg g, asked from the Settings window: true when the prompt is up, or, with
// accounts off, when the act already waits for kp_done; false, and nothing shown, when it cannot be asked now.
Bool kp_ask_for(I64 a, I64 g) {
    if (!deskask.valid(a, g) || st_win < 0) { return false; }
    if (!ac_on) {
        Bool on = deskask.grant(a, g, session_generation);
        "hdesk: desk ask {a}, no accounts\n";
        return on;
    }
    if (s_acct < 0 || ac_screen != SCR_NONE || kp_open || ah_busy || ask_up()) { return false; }
    I64 ap = s_acct;
    if (acct.role_of(ap) != acct.PARENT) { ap = acct.next_parent(-1); }
    if (ap < 0 || kp_generation == 0xFFFFFFFFFFFFFFFF) { return false; }
    kp_generation = kp_generation + 1;
    if (!deskask.open(a, g, session_generation, kp_generation)) { return false; }
    ac_shut();
    kp_open = true;
    kp_field = true;
    kp_parent_hdr = true;
    kp_want = 0;                       // the ring SIENNA, a parent's approval (L8)
    kp_uid = acct.uid_of(s_acct);
    kp_vp = 0;
    kp_win = st_win;
    kp_appr = ap;
    kp_deadline = now_ns() + TIMEOUT_NS;
    wipe_fields();
    ac_notel = 0;
    "hdesk: desk ask {a}\n";
    redraw();
    return true;
}

// The approved act, once, for the desk's tick to do now, as uid 0: deskask.CLOCK or ZONE, its arg in g[0]; 0 for
// none. An approval never outlives the session that gave it.
I64 kp_done(inout I64[_] g) {
    if (ac_on && s_acct < 0) {
        deskask.drop();
        return 0;
    }
    return deskask.take(session_generation, g);
}

// The desk's tick: the approved act done now by the desk itself, as uid 0 (RS-CLK; TZ-R1 A), then the date read
// again and the Date and Time page fed.
void kp_tick() {
    I64[1] g;
    I64 a = kp_done(g);
    if (a == 0) { return; }
    I64 r = 0;
    if (a == deskask.CLOCK) {
        r = corectl.co_settime(g[0]);
    } else {
        r = zoneput.put(g[0]);
    }
    "hdesk: desk act {a} {r}\n";
    date();
    if (st_win >= 0 && stbox.page() == stside.DATETIME) { st_time(); }
    bar(false);
    redraw();
}

// authd's answer to the desk's own ask (approver a). ok gives the act to kp_done, but only on the prompt, session,
// screen and epoch that asked, before its deadline, with a still a parent; a wrong password counts for AC-D2 in the
// session that typed it, and keeps the prompt.
void kq_auth(Bool ok, I64 a) {
    Bool here = deskask.up() && kp_open && kp_field && ac_screen == SCR_NONE && ah_epoch == auth_epoch &&
        ah_session == session_generation && a == kp_appr && now_ns() < kp_deadline;
    if (!ok) {
        if (ah_session == session_generation) { failed(a); }   // AC-D2, even when the prompt is gone
        if (!here) { ac_notel = 0; }
        "hdesk: desk ask wrong password\n";
        redraw_overlay();
        return;
    }
    if (!here || acct.role_of(a) != acct.PARENT || !deskask.approve(ah_session, ah_generation)) {
        "hdesk: desk ask stale ignored\n";
        return;
    }
    ac_fails[a] = 0;
    kq_down();
    "hdesk: desk ask approved by ";
    put_name(a);
    "\n";
    redraw();
    kern_next();
}

// The prompt of the desk's own ask comes down; the ask ends.
void kq_down() {
    deskask.close();
    kp_open = false;
    kp_field = false;
    wipe_fields();
    ac_notel = 0;
}

// Refused: Esc, a click off, the deadline, a lock, a log out, the Settings window closed.
void kq_cancel() {
    kq_down();
    "hdesk: desk ask refused\n";
    redraw();
    kern_next();
}

// The prompt refused: what was asked ends unless authd holds it already.
void ac_op_cancel() {
    if (acctask.phase() != acctask.SENT) { acctask.cancel(); }
    ac_op_down();
    "hdesk: accounts refused\n";
    redraw();
    kern_next();
}

// authd's answer to an Accounts operation (approver a): AC-D2 for a wrong passphrase, which keeps the prompt; else
// the prompt closes, the store is read again and the page fed again; a cut of the session's own ceiling (RS-R2) or
// its own demotion (RS-DM1) ends it, by the log out, when the session that asked is still the one in use, locked
// or not: its terminals logged in with the old ceiling and Parent flag, and nothing else takes them back.
void ac_op_done(I64 a) {
    I64 code = authreq.code_of(ah_ans, ah_n);
    I64 o = acctask.answer(code);
    Bool here = s_acct >= 0 && ac_op_session == session_generation;
    "hdesk: accounts answer {code}\n";
    if (o == acctask.O_WRONG) {
        failed(a);                     // AC-D2 counts it even when the prompt is gone
        if (!(here && ac_op_up)) {
            acctask.cancel();
            ac_notel = 0;              // and says nothing on a screen that did not ask
        }
        redraw_overlay();
        return;
    }
    ac_op_down();
    Bool had = s_acct >= 0;
    I64 na = ac_reread();
    "hdesk: accounts {na}\n";
    if ((had && s_acct < 0) || na < 1) {   // the session's account is gone, or no store reads: the session ends
        acctask.cancel();                  // as a log out ends it (SCR_BROKEN when no store reads), never a lock
        "hdesk: accounts lost, session ends\n";   // screen with no account to unlock it
        logout();
        return;
    }
    if (o == acctask.O_FORM) {         // authd refused an entry: back to the form, that entry ringed
        if (here && st_win >= 0 && ac_screen == SCR_NONE) {
            acctform.reopen();
        } else {
            acctask.cancel();
        }
        redraw();
        return;
    }
    st_accounts();                     // the Accounts page fed again from the store as it is now
    if (o == acctask.O_END && here) {
        "hdesk: own ceiling or role cut, session ends\n";
        logout();
        return;
    }
    redraw();
    kern_next();
}

// SYNC 8 while authd works, a field waits or a prompt has a deadline.
Bool ac_ticking() {
    return kp_retry || ah_busy || (kp_open && kp_field) ||
        ((ac_screen == SCR_LOGIN || ac_screen == SCR_LOCK) && ac_until_any());
}

Bool ac_until_any() {
    I64 t = now_ns();
    for k in 0..16 {
        if (ac_until[k] > t) { return true; }
    }
    return ac_shown_s > 0;
}

void ac_tick() {
    if (kp_retry) { kern_next(); }
    kern_refresh();
    if (kp_open && kp_field && now_ns() >= kp_deadline) {
        "hdesk: prompt timed out pid {kp_vp}\n";
        kern_answer(false);
    }
    if (checking_now() && check_ms() / CHECK_FRAME_MS != ac_check_ph) {   // DN-37: the wheel's next frame
        ac_check_ph = check_ms() / CHECK_FRAME_MS;
        redraw_overlay();
    }
    if (ah_busy) {
        I64 r = hdeskctl.auth_poll(ah_ans[ah_n..256]);
        while (r > 0) {
            ah_n = ah_n + r;
            if (ah_n >= 256) { r = 0; } else { r = hdeskctl.auth_poll(ah_ans[ah_n..256]); }
        }
        if (r == 0) {
            ah_done();
            for k in 0..256 { ah_ans[k] = 0; }
            ah_n = 0;
            ah_generation = 0;
        }
        return;
    }
    I64 a = ac_target();
    I64 s = 0;
    if (waiting(a)) { s = (ac_until[a] - now_ns()) / 1000000000 + 1; }
    if (s != ac_shown_s) {
        ac_shown_s = s;
        redraw_overlay();
    }
}

// The account the screen's passphrase is for: the chosen name, the locked session's, or the prompt's approver.
I64 ac_target() {
    if (ac_screen == SCR_LOGIN) { return acct.shown(ac_sel); }
    if (ac_screen == SCR_LOCK) { return s_acct; }
    if (kp_open && kp_field) { return kp_appr; }
    return -1;
}

// One typed byte into a field: printable ASCII only; a name takes lowercase letters, digits and `-`.
void field_key(I64 code, Bool is_name, inout U8[_] buf, inout I64[_] n) {
    if (code == KEY_BACKSPACE) {
        if (n[0] > 0) {
            n[0] = n[0] - 1;
            buf[n[0]] = 0;
        }
        return;
    }
    I64 b = keymap.byte_of(code, shift, false);
    if (b < 32 || b > 126) { return; }
    if (is_name && !((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45)) { return; }
    if (n[0] < len(buf)) {
        buf[n[0]] = b as U8;
        n[0] = n[0] + 1;
    }
}

// A key on first boot, the login screen or the lock (keys go to the desk only: AC-D1).
void auth_key(I64 code) {
    if (meta && code == KEY_ESC && (ac_screen != SCR_LOCK || acscreen.LOCK_POWER)) {   // DN-56: lock too
        "hdesk: shut down from the account screen\n";
        I64 e = hdeskctl.power(1);
        return;
    }
    if (ah_busy || ac_screen == SCR_BROKEN) { return; }
    I64[1] n;
    if (ac_screen == SCR_FIRST) {
        if (code == KEY_TAB || (code == KEY_ENTER && ac_focus < 2)) {
            ac_focus = (ac_focus + 1) % 3;
        } else if (code == KEY_ENTER) {
            first_submit();
            return;
        } else if (ac_focus == 0) {
            n[0] = ac_nl;
            field_key(code, true, ac_name, n);
            ac_nl = n[0];
        } else if (ac_focus == 1) {
            n[0] = ac_p1n;
            field_key(code, false, ac_p1, n);
            ac_p1n = n[0];
        } else {
            n[0] = ac_p2n;
            field_key(code, false, ac_p2, n);
            ac_p2n = n[0];
        }
        redraw_overlay();
        return;
    }
    I64 a = ac_target();
    if (ac_screen == SCR_LOGIN && (code == KEY_UP || code == KEY_DOWN)) {
        I64 d = 1;
        if (code == KEY_UP) { d = acct.accounts() - 1; }
        ac_sel = (ac_sel + d) % acct.accounts();
        ac_top = acct.list_top(ac_sel, ac_top, acct.accounts(), ac_rows());   // the names the screen shows
        wipe_fields();
        ac_notel = 0;
        redraw_overlay();
        return;
    }
    if (waiting(a)) { return; }
    if (code == KEY_ENTER) {
        if (ac_p1n == 0) { return; }
        I64 what = AH_LOGIN;
        if (ac_screen == SCR_LOCK) { what = AH_UNLOCK; }
        "hdesk: auth ";
        put_name(a);
        "\n";
        checking();
        ah_verify(what, a);
        redraw_overlay();
        return;
    }
    n[0] = ac_p1n;
    field_key(code, false, ac_p1, n);
    ac_p1n = n[0];
    redraw_overlay();
}

// First boot's fields against the rules (AC-D3): 0 they pass, 1 the name, 2 the first password's length, 3 the two
// passwords differ. One check for the Create button's state on frame 12 and for Enter, so the two never part.
I64 first_check() {
    if (!acct.name_ok(ac_name, ac_nl)) { return 1; }
    if (!acct.pass_ok(acct.PARENT, ac_p1n)) { return 2; }
    if (ac_p1n != ac_p2n || !same_pass()) { return 3; }
    return 0;
}

// First boot's Enter on the last field: first_check, then authd enrolls.
void first_submit() {
    I64 c = first_check();
    if (c == 1) {
        note(b"a name: a-z, 0-9 and -, up to 32");
    } else if (c == 2) {
        U8[32] t;                      // DN-52 (c): the rule line's own words, from the store's minimum
        I64 n = acscreen.rule_text(acct.PARENT_MIN, t);
        note(t[0..n]);
    } else if (c == 3) {
        note(b"the two passwords differ");
    } else {
        I64 at = req_put(0, b"enroll ");
        at = req_num(at, DS6_M);
        ah_req[at] = 32;
        at = req_num(at + 1, DS6_T);
        ah_req[at] = 10;
        at = at + 1;
        for k in 0..ac_p1n { ah_req[at + k] = ac_p1[k]; }
        note_ok(b"making the account");
        "hdesk: first boot enroll\n";
        ah_start(AH_ENROLL, -1, at + ac_p1n);
    }
    redraw_overlay();
}

Bool same_pass() {
    for k in 0..ac_p1n {
        if (ac_p1[k] != ac_p2[k]) { return false; }
    }
    return true;
}

// A key on the prompt with its field: typing, Tab for another parent (PARENT APPROVAL), Enter or Super+Enter asks
// authd, Esc refuses.
void prompt_key(I64 code) {
    if (code == KEY_ESC) {
        kern_answer(false);
        return;
    }
    if (ah_busy) { return; }
    if (code == KEY_TAB && ac_op_up) {  // RS-AQ: the next account that may approve
        kp_appr = acctask.next_approver();
        wipe_fields();
        ac_notel = 0;
        redraw_overlay();
        return;
    }
    if (code == KEY_TAB && kp_parent_hdr) {
        kp_appr = acct.next_parent(kp_appr);
        wipe_fields();
        ac_notel = 0;
        redraw_overlay();
        return;
    }
    if (waiting(kp_appr)) { return; }
    if (code == KEY_ENTER && ac_op_up) {
        ac_op_send();
        return;
    }
    if (code == KEY_ENTER && deskask.up()) {   // the desk's own ask: the approver's password, as a verify
        if (ac_p1n == 0 || kp_appr < 0) { return; }
        checking();
        ah_verify(AH_DESK, kp_appr);
        redraw_overlay();
        return;
    }
    if (code == KEY_ENTER) {
        if (ac_p1n == 0 || kp_appr < 0) { return; }
        checking();
        ah_verify(AH_APPROVE, kp_appr);
        redraw_overlay();
        return;
    }
    I64[1] n;
    n[0] = ac_p1n;
    field_key(code, false, ac_p1, n);
    ac_p1n = n[0];
    kp_bad = false;                    // FV-1: typing again
    redraw_overlay();
}

// The account of uid u, or -1.
I64 acct_of_uid(I64 u) {
    for i in 0..acct.accounts() {
        if (acct.uid_of(i) == u) { return i; }
    }
    return -1;
}

// --- AC-1c drawing: the cards at 1x, centered in the plane; agy's frames (studio-assets PR 33), the kit's parts ---

I64 cat(inout U8[_] t, I64 at, in U8[_] s) {
    for k in 0..len(s) { t[at + k] = s[k]; }
    return at + len(s);
}

I64 ac_txt(I64 y, I64 x, I64 ty, I64 x1, in U8[_] s, I64 c) {
    return draw.text(row, y, x, ty, x1, s, len(s), tok(c));
}

void button_at(I64 y, I64 x, I64 ty, I64 bw0, in U8[_] s, I64 bg, I64 fg, Bool framed) {
    draw.rect(row, y, x, ty, x + bw0, ty + 26, tok(bg));
    if (framed) { draw.frame(row, y, x, ty, x + bw0, ty + 26, 1, tok(tokens.RULE)); }
    I64 e = draw.text(row, y, x + (bw0 - len(s) * face.W) / 2, ty + 5, x + bw0, s, len(s), tok(fg));
}

I64 card_h() { return 120; }          // the broken store's card (AC-1c), the one account card left

// Login: the names the account screen shows, the most that fit its height (acscreen.rows_fit, 1 to 8): the drawing and
// the scrolling (acct.list_top) take this one count.
I64 ac_rows() {
    I64 y0 = layout.frame_y(OV);
    return acscreen.rows_fit(y0, y0 + layout.frame_h(OV) / sc, acct.accounts());
}

// Frame 12's state from the desk's, before a row is drawn (kit/acscreen.ci): the screen, the clock and the date, the
// names in view or the locked account, the fields as lengths, the note line, first boot's check and the rule line.
void ac_sync() {
    I64 k = acscreen.LOGIN;
    if (ac_screen == SCR_LOCK) { k = acscreen.LOCK; }
    if (ac_screen == SCR_FIRST) { k = acscreen.FIRST; }
    acscreen.set_screen(k);
    U8[40] t;
    I64 l = now_l();                   // the machine's zone, as the bar
    I64 d = l % 86400;
    I64 n = two(t, 0, d / 3600);
    t[n] = ':';
    n = two(t, n + 1, d % 3600 / 60);
    acscreen.set_clock(t, n);
    I64[4] v;
    civil.from_days(l / 86400, v);
    n = acscreen.date_text(v[3], v[1], v[2], t);
    acscreen.set_date(t, n);
    U8[32] nmv;
    if (k == acscreen.LOGIN) {
        I64 r = ac_rows();                     // the most names that fit the screen (acscreen.rows_fit)
        I64 top = acct.list_top(ac_sel, ac_top, acct.accounts(), r);
        acscreen.set_rows(r, ac_sel - top);
        for q in 0..r {
            I64 i = acct.shown(top + q);
            I64 m = acct.name_len(i);
            for b in 0..m { nmv[b] = acct.name_byte(i, b); }
            acscreen.set_row(q, nmv, m, acct.role_of(i) == acct.PARENT);
        }
    }
    if (k == acscreen.LOCK) {
        I64 m = acct.name_len(s_acct);
        for b in 0..m { nmv[b] = acct.name_byte(s_acct, b); }
        acscreen.set_who(nmv, m);
    }
    if (k == acscreen.FIRST) {
        acscreen.set_first(ac_name, ac_nl, ac_focus, first_check() == 0);
        acscreen.set_len(1, ac_p1n);
        acscreen.set_len(2, ac_p2n);
        n = acscreen.rule_text(acct.PARENT_MIN, t);
        acscreen.set_rule(t, n);
    } else {
        acscreen.set_len(0, ac_p1n);
    }
    I64 a = ac_target();
    if (checking_now() && !waiting(a)) {
        acscreen.set_note(t, 0, false);          // DN-37: the wheel stands on the note line (auth_row)
    } else if (waiting(a)) {                     // DN-52 (b): AC-D2's wait after a wrong password, counted down
        U8[48] wt;
        I64 wn = acscreen.wait_text((ac_until[a] - now_ns()) / 1000000000 + 1, wt);
        acscreen.set_note(wt, wn, true);
    } else {
        acscreen.set_note(ac_note, ac_notel, ac_note_bad);
    }
}

// Row y of an account screen over the whole plane (x0, y0)-(x1, y1) at 1x: frame 12 through the pen (kit/acscreen.ci),
// or the broken store's card.
void auth_row(I64 x0, I64 y0, I64 x1, I64 y1, I64 y) {
    if (ac_screen == SCR_BROKEN) {
        draw.rect(row, y, x0, y0, x1, y1, tok(tokens.MANTLE));
        I64 ch = card_h();
        I64 cx = x0 + (x1 - x0 - AC_CW) / 2;
        I64 cy = y0 + (y1 - y0 - ch) / 2;
        I64 cx1 = cx + AC_CW;
        draw.rect(row, y, cx, cy, cx1, cy + ch, tok(tokens.PAPER));
        draw.frame(row, y, cx, cy, cx1, cy + ch, 1, tok(tokens.RULE));
        I64 x = cx + 16;
        I64 e = ac_txt(y, x, cy + 20, cx1 - 16, b"The account store cannot be read.", tokens.INK);
        e = ac_txt(y, x, cy + 44, cx1 - 16, b"Restore it from accounts.prev.", tokens.INK_DIM);
        button_at(y, x, cy + 78, AC_CW - 32, b"Super+Esc  Shut down", tokens.SURF2, tokens.INK, true);
        return;
    }
    ac_sync();
    acscreen.row_at(row, x0, y0, x1, y1);
    if (checking_now() && !waiting(ac_target())) {   // DN-37: the wheel, no words (DN-46), on the note line
        wheel.row_at(row, pen.row_y(), pen.x((x0 + x1) / 2 - 8), pen.y(acscreen.note_top(y0, y1) - 2), wheel.S16,
                     pen.zoom(), tokens.theme(), wheel.UNKNOWN, check_ms(), anim_on);
    }
}

// Frame 12: a click on an account screen takes Restart or Shut Down and nothing else (keys stay the desk's, AC-D1).
void ac_click() {
    if (ac_screen == SCR_BROKEN || ac_screen == SCR_NONE) { return; }
    ac_sync();
    I64 x0 = layout.frame_x(OV);
    I64 y0 = layout.frame_y(OV);
    I64 x1 = x0 + layout.frame_w(OV) / sc;
    I64 y1 = y0 + layout.frame_h(OV) / sc;
    I64 a = acscreen.pill_at(x0, y0, x1, y1, x0 + (mx - x0) / sc, y0 + (my - y0) / sc);
    if (a == acscreen.ACT_SHUTDOWN) {
        "hdesk: shut down from the account screen\n";
        I64 e = hdeskctl.power(1);
    } else if (a == acscreen.ACT_RESTART) {
        "hdesk: restart from the account screen\n";
        I64 e = hdeskctl.power(2);
    }
}

// AC-1c with DN-6 frame 8, laid out as FV-1's draft (frame 17, under l's review): the prompt with its field (KP_W x
// KP_H2 at 1x). PARENT APPROVAL in the grant's ring color (L8), or KERNEL ELEVATION REQUEST in CADMIUM for a parent's
// own kern (L9), one layout. The desk's state gathered for prompt_ac_at; the passphrase goes as its length only, so
// the drawing never holds a byte of it.
void prompt_row_ac(I64 x0, I64 y0, I64 y) {
    I64 c = kp_color();
    U8[24] hd;
    I64 hn = 0;
    if (kp_parent_hdr) { hn = cat(hd, 0, b"PARENT APPROVAL"); } else { hn = cat(hd, 0, b"KERNEL ELEVATION REQUEST"); }
    U8[16] t;
    I64 n = 0;
    U8[32] v;
    I64 vl = 0;
    I64 ic = icons3.TERMINAL;
    if (kp_win >= 0) {                 // AC-V: the desk's record alone; v stays empty, the variable is not drawn
        ic = kp_icon_of();
        while (n < 16 && kp_title[n] != 0) {
            t[n] = kp_title[n];
            n = n + 1;
        }
    }
    U8[64] sb;
    I64 sn = 0;
    U8[32] kd;
    I64 kn = 0;
    U8[40] rt;
    I64 rn = 0;
    I64 ua = acct_of_uid(kp_uid);
    if (kp_parent_hdr) {
        sn = kp_subject(sb);               // AC-V-R1 A: the desk's record of the app, never the request text
        if (kp_want == GRANT_KERN) {
            kn = cat(kd, 0, b"Ring 0");
        } else if ((kp_want & 1) != 0) {
            kn = cat(kd, 0, b"Disk");
        } else if ((kp_want & 2) != 0) {
            kn = cat(kd, 0, b"Network");
        } else {
            kn = cat(kd, 0, b"Audio");
        }
        if (ua >= 0) {
            rn = acct.name_len(ua);
            for k in 0..rn { rt[k] = acct.name_byte(ua, k); }
        }
    } else {
        for k in 0..kp_len { sb[k] = kp_text[k]; }
        sn = kp_len;
        for k in 0..4 { rt[k] = b"pid "[k]; }
        rn = digits(rt, 4, kp_vp);
    }
    if (ac_op_up) {                    // RS-AQ: frame 34's control, the account it is for, from Settings by NAME
        sn = acctask.subject(sb);
        kn = acctask.target(kd);
        n = cat(t, 0, b"Settings");
        vl = 0;
    }
    if (deskask.up()) {                // the desk's own ask: frame 36's control, what it sets, from Settings
        sn = deskask.subject(sb);
        kn = deskask.target(kd);
        n = cat(t, 0, b"Settings");
        vl = 0;
    }
    U8[64] nt;
    I64 nn = kp_note_text(ua, nt);
    U8[16] ky;
    I64 yn = 0;
    U8[16] go;
    I64 gn = 0;
    if (kp_parent_hdr) {
        yn = cat(ky, 0, b"Enter");
        gn = cat(go, 0, b"Approve");
    } else {
        yn = cat(ky, 0, b"Super+Enter");
        gn = cat(go, 0, b"Run");
    }
    prompt_ac_at(x0, y0, c, hd, hn, kp_parent_hdr, sb, sn, kd, kn, t, n, v, vl, ic, rt, rn, ac_p1n, kp_bad,
                 kp_shake_dx(), nt, nn, ky, yn, go, gn, y);
    if (checking_now()) {              // DN-37: the wheel on the note line, at the pen's zoom
        wheel.row_at(row, pen.row_y(), pen.x(x0 + 16), pen.y(y0 + KP_WHEEL_Y), wheel.S16, pen.zoom(), tokens.theme(),
                     wheel.UNKNOWN, check_ms(), anim_on);
    }
}

const I64 KP_WHEEL_Y = 199;            // the prompt's note line, its wheel's top (the line's text top is 201)

// FV-1: the note line as text into t: AC-D2's `wait N s` while the approver's field waits; after a wrong passphrase
// `That passphrase did not match.`; a note of the desk's own (`checking`, authd's failure); else the prompt's line,
// `Your passphrase, not NAME's.` for a child's ask (NAME the asker, account ua) or `Your passphrase runs this once as
// the kernel user.` for a parent's own kern.
I64 kp_note_text(I64 ua, inout U8[_] t) {
    if (checking_now()) { return 0; }  // DN-37: the wheel stands where the line was (kern_at)
    if (kp_appr >= 0 && waiting(kp_appr)) {
        I64 n = cat(t, 0, b"wait ");
        n = digits(t, n, (ac_until[kp_appr] - now_ns()) / 1000000000 + 1);
        return cat(t, n, b" s");
    }
    if (kp_bad) { return cat(t, 0, b"That password did not match."); }
    if (ac_notel > 0) {
        I64 n = ac_notel;
        if (n > len(t)) { n = len(t); }
        for k in 0..n { t[k] = ac_note[k]; }
        return n;
    }
    if ((ac_op_up || deskask.up()) && kp_appr == ua) { return 0; }   // the one signed in approves its own ask
    if (!kp_parent_hdr) { return cat(t, 0, b"Your password runs this once as the kernel user."); }
    I64 n = cat(t, 0, b"Your password, not ");
    if (ua >= 0) {
        I64 l = acct.name_len(ua);
        for k in 0..l {
            if (n < len(t)) { t[n] = acct.name_byte(ua, k); n = n + 1; }
        }
    }
    return cat(t, n, b"'s.");
}

// FV-1: the wrong passphrase's shake, 3 times by 6 px over 240 ms (MS-2's OUT curve on each 40 ms leg); none while
// UI animations are off or the frames are stepped (the gates).
Bool kp_bad = false;                 // the last passphrase on the prompt did not match (failed)
I64 kp_shake_t0 = 0;
Bool kp_shook = false;               // a shake frame was drawn; one more at rest follows
const I64 SHAKE_MS = 240;

I64 shake_at(I64 e) {
    if (e < 0 || e >= SHAKE_MS * anim.MS) { return 0; }
    I64[7] kf;
    kf[0] = 0;
    kf[1] = 6;
    kf[2] = 0 - 6;
    kf[3] = 6;
    kf[4] = 0 - 6;
    kf[5] = 6;
    kf[6] = 0;
    I64 leg = SHAKE_MS * anim.MS / 6;
    I64 s = e / leg;
    I64 p = anim.progress(anim.OUT, e - s * leg, leg);
    return kf[s] + ((kf[s + 1] - kf[s]) * p) / 1000;
}

Bool kp_shaking() { return kp_open && kp_bad && anim_on && !stepped && wall.wall_ns() - kp_shake_t0 < SHAKE_MS * anim.MS; }

I64 kp_shake_dx() {
    if (!kp_shaking()) { return 0; }
    return shake_at(wall.wall_ns() - kp_shake_t0);
}

// AC-1c with DN-6 frame 8 and FV-1's draft (frame 17; the values wait on l's review): the prompt's plate, KP_W x
// KP_H2 at 1x from (x0, y0) through the pen, ring color rc. PAPER (the OV window's ground); a 36 px header in rc with
// hd[0..hn] centered in LABEL (rc's own ink); 16 px in, the subject field, 36 px SURF2 of radius 6: for a parent's
// approval (par) an 8 px dot in rc, the desk's record sb in NAME_BOLD and the grant's kind kd in INK_DIM at the
// right, else the command sb in PATH; `requested from:`; the asking window's 16 px icon, its title and variable w in
// PATH and rt (the asker's name, or the pid) at the right in INK_DIM; the passphrase field, 36 px SURF2 of radius 6
// with a 2 px ring, ULTRAMARINE (AC-D1's focus) or CADMIUM after a wrong passphrase (bad), np 8 px dots 6 px apart
// and a 2 x 18 caret, the field moved dx px (the shake); the note nt in SMALL in INK_DIM; two 36 px buttons
// of radius 6, key ky and word go on rc at the left, `Esc Refuse` on SURF1 at the right, each key on a 20 px keycap
// of radius 4; DN-36: the plate one shape in rc, the body PAPER inset 1 (corners 11); radius 12. Shadow High is MS-4's.
void prompt_ac_at(I64 x0, I64 y0, I64 rc, in U8[_] hd, I64 hn, Bool par, in U8[_] sb, I64 sn, in U8[_] kd, I64 kn,
                  in U8[_] ti, I64 tn, in U8[_] fd, I64 fn, I64 ic, in U8[_] rt, I64 rn, I64 np, Bool bad, I64 dx,
                  in U8[_] nt, I64 nn, in U8[_] ky, I64 yn, in U8[_] go, I64 gn, I64 y) {
    I64 x1 = x0 + KP_W;
    I64 on = ring_type(rc);
    pen.rect(row, x0, y0, x1, y0 + KP_H2, tok(rc));   // DN-36: one shape in rc, the header its top 36
    pen.lower_round(row, x0 + RING, y0 + 36, x1 - RING, y0 + KP_H2 - RING, R_PLATE - RING, tok(tokens.PAPER));
    I64 e = ptxt_mid(x0, KP_W, y0 + 10, x1, hd, hn, tok(on), faces.LABEL);
    pen.round(row, x0 + 16, y0 + 52, x1 - 16, y0 + 88, R_CTRL, tok(tokens.SURF2));
    if (par) {
        pen.round(row, x0 + 28, y0 + 66, x0 + 36, y0 + 74, 4, tok(rc));
        I64 kx = pen.x(x1 - 28) - pen.width(kd, kn, faces.BODY);
        e = ctext.text(row, pen.row_y(), pen.x(x0 + 44), pen.y(y0 + 62 + TBASE), kx - 8 * pen.zoom(), sb, sn,
                       tok(tokens.INK), faces.NAME_BOLD, pen.zoom());
        e = pen.text_right(row, x1 - 28, y0 + 62 + TBASE, kd, kn, tok(tokens.INK_DIM), faces.BODY);
    } else {
        e = ptxt(x0 + 28, y0 + 62, x1 - 28, sb, sn, tok(tokens.INK), faces.MONO_BOLD);   // DN-26: mono 13/600
    }
    e = ptxt(x0 + 16, y0 + 100, x1 - 16, b"requested from:", 15, tok(tokens.INK_DIM), faces.BODY);
    if (y >= y0 + 125 && y < y0 + 141) {
        icons3.icon_at(row, pen.row_y(), pen.x(x0 + 16), pen.y(y0 + 125), ic, 16, pen.zoom(), tok(tokens.PAPER));
    }
    // DN-26: the title, then 8 px on the folder, both mono 12 INK; the folder cut from its left behind `...` when the
    // row is short; the title never cut; the pid or the asker's name at the right in INK_DIM.
    I64 z = pen.zoom();
    I64 px = pen.x(x1 - 16) - pen.width(rt, rn, faces.PATH);
    I64 bl = pen.y(y0 + 125 + TBASE);
    I64 tx = pen.x(x0 + 40);
    e = ctext.text(row, pen.row_y(), tx, bl, px - 8 * z, ti, tn, tok(tokens.INK), faces.PATH, z);
    I64 fx = tx + pen.width(ti, tn, faces.PATH) + 8 * z;
    I64 room = px - 8 * z - fx;
    if (fn > 0 && room > 0) {
        U8[40] f;
        I64 k = 0;
        I64 m = 0;
        if (pen.width(fd, fn, faces.PATH) > room) {
            for q in 0..3 { f[q] = '.'; }
            m = 3;
            k = 1;
            while (k < fn && pen.width(b"...", 3, faces.PATH) + pen.width(fd[k..fn], fn - k, faces.PATH) > room) {
                k = k + 1;
            }
        }
        for q in k..fn { f[m + q - k] = fd[q]; }
        e = ctext.text(row, pen.row_y(), fx, bl, px - 8 * z, f, m + fn - k, tok(tokens.INK), faces.PATH, z);
    }
    e = pen.text_right(row, x1 - 16, y0 + 125 + TBASE, rt, rn, tok(tokens.INK_DIM), faces.PATH);
    I64 fr = tokens.ULTRAMARINE;
    if (bad) { fr = tokens.CADMIUM; }
    pen.round(row, x0 + 16 + dx, y0 + 157, x1 - 16 + dx, y0 + 193, R_CTRL, tok(tokens.SURF2));
    pen.ring(row, x0 + 16 + dx, y0 + 157, x1 - 16 + dx, y0 + 193, R_CTRL, 2, tok(fr));
    I64 d = np;
    if (d > (KP_W - 56) / 14) { d = (KP_W - 56) / 14; }
    for k in 0..d {
        pen.round(row, x0 + 28 + dx + 14 * k, y0 + 171, x0 + 36 + dx + 14 * k, y0 + 179, 4, tok(tokens.INK));
    }
    pen.rect(row, x0 + 28 + dx + 14 * d, y0 + 166, x0 + 30 + dx + 14 * d, y0 + 184, tok(tokens.INK));
    e = ptxt(x0 + 16, y0 + 201, x1 - 16, nt, nn, tok(tokens.INK_DIM), faces.SMALL);
    I64 kw = txt_w(ky, yn, faces.PATH) + 12;
    I64 rw = 12 + kw + 10 + txt_w(go, gn, faces.NAME) + 12;
    pen.round(row, x0 + 16, y0 + 248, x0 + 16 + rw, y0 + 284, R_CTRL, tok(rc));
    pen.ring(row, x0 + 28, y0 + 256, x0 + 28 + kw, y0 + 276, R_KEY, 1, tok(on));
    e = ptxt_mid(x0 + 28, kw, y0 + 258, x0 + 28 + kw, ky, yn, tok(on), faces.PATH);
    e = ptxt(x0 + 38 + kw, y0 + 258, x0 + 16 + rw, go, gn, tok(on), faces.NAME);
    I64 ew = txt_w(b"Esc", 3, faces.PATH) + 12;
    I64 fw = 12 + ew + 10 + txt_w(b"Refuse", 6, faces.NAME) + 12;
    pen.round(row, x1 - 16 - fw, y0 + 248, x1 - 16, y0 + 284, R_CTRL, tok(tokens.SURF1));
    pen.ring(row, x1 - 4 - fw, y0 + 256, x1 - 4 - fw + ew, y0 + 276, R_KEY, 1, tok(tokens.RULE));
    e = ptxt_mid(x1 - 4 - fw, ew, y0 + 258, x1 - 4 - fw + ew, b"Esc", 3, tok(tokens.INK_DIM), faces.PATH);
    e = ptxt(x1 + 6 - fw + ew, y0 + 258, x1 - 16, b"Refuse", 6, tok(tokens.INK), faces.NAME);
}

void widget_row(I64 i, I64 x0, I64 y0, I64 x1, I64 y1, I64 y) {
    if (i == OV && ac_screen != SCR_NONE) {
        auth_row(x0, y0, x1, y1, y);
        return;
    }
    if (i == OV && kp_open && kp_field) {
        prompt_row_ac(x0, y0, y);
        return;
    }
    if (i == OV && kp_open) {
        prompt_row(x0, y0, y);
        return;
    }
    if (i == OV && indextrash.is_up() && !kp_open) {   // frame 23: the plate from its device top left (PR 428)
        indextrash.plate_row(row, pen.row_y(), layout.frame_x(OV), layout.frame_y(OV), am_z());
        return;
    }
    if (i == OV && unsaved.is_up() && !kp_open) {   // AM section 7: x0, y0 the plate's device top left
        unsaved.row_at(row, pen.row_y(), layout.frame_x(OV), layout.frame_y(OV), sc);
        return;
    }
    if (i == OV && acctform.is_up() && !kp_open) {   // RS-AQ: frame 49, x0, y0 the plate's device top left
        acctform.row_at(row, pen.row_y(), layout.frame_x(OV), layout.frame_y(OV), sc);
        return;
    }
    if (i == OV && keysheet.is_up() && !kp_open) {   // frame 27: x0, y0 the plate's device top left; no dim under it
        keysheet.plate_row(row, pen.row_y(), layout.frame_x(OV), layout.frame_y(OV), sc);
        return;
    }
    if (i == OV && rv_open) {
        revert_at(x0, y0, rv_w, rv_h, rv_left(), y);
        return;
    }
    if (i == OV && pl_open) {
        plane.paint(row, pen.row_y() - y0);   // FF 3g: the plane's device row at the pen's zoom
        return;
    }
    if (i == OV && sp_open) {
        panel_row(x0, y0, y);
        return;
    }
    if (i == OV && tr_open) {
        tray_row(x0, y0, y);
        return;
    }
    if (i == OV && msg_up()) {
        msg_at(x0, y0, msg_text, msg_len, y);
        return;
    }
    if (i == OV && mn_open) {
        menu_row(x0, y0, y);
        return;
    }
    if (i == OV) {
        I64[16] ic;
        U8[256] nm;
        I64[16] nl;
        I64 f = sw_first();
        I64 k = sw_shown();
        for q in 0..k {
            I64 e = sw_list[f + q];
            ic[q] = win_icon3(e);
            U8[16] t;
            nl[q] = win_name(e, t);
            for c in 0..nl[q] { nm[16 * q + c] = t[c]; }
        }
        switcher_at(x0, y0, k, ic, nm, nl, sw_sel - f, y);
        return;
    }
    if (lit_of(i == focused() && !about.blocks(i), prompt_up())) {
        pen.frame(row, x0, y0, x1, y1, B, tok(tokens.ULTRAMARINE));
    } else {
        pen.frame(row, x0, y0, x1, y1, 1, tok(tokens.RULE));
    }
    settings_row(x0 + B, y0 + B, x1 - B, y1 - B, y);
}

// Windows on the active desktop in the order they are painted: bottom first (layout.ci's layers, ties by number).
I64 layer_of(I64 i) {
    return layout.layer_for(i, wmode[i], wrank[i]);   // HX-1: layout.ci's order, the overlay above all
}

// K-7 (E2-3, KD-2 B): the emblem's side, the color mark centered on the plane: 480 px on a portrait screen and 440
// on a landscape one at 1x, times the UI scale, no larger than the plane. K-3 (D-4): it is drawn on an empty
// desktop only, in the lockup's words in both themes.
I64 emblem_side() {
    I64 e = 440 * sc;
    if (h > w) { e = 480 * sc; }
    if (e > w) { e = w; }
    if (e > plane_h()) { e = plane_h(); }
    return e;
}

// The emblem's part of plane row y into `row`, where none of the nw windows of `order` has its frame: a covered run
// is skipped whole, so a full desk computes only its gaps.
void emblem_row_span(I64 y, in I64[16] order, I64 nw, I64 xa, I64 xb) {
    I64 e = emblem_side();
    I64 ex = (w - e) / 2;
    I64 ey = bar_h() + (plane_h() - e) / 2;
    if (y < ey || y >= ey + e) { return; }
    I64 x = ex;
    if (xa > x) { x = xa; }
    I64 xend = ex + e;
    if (xb < xend) { xend = xb; }
    U32[64] er;                        // MS-R5: the mark's row as runs, kept by kit/cmark.ci
    I64 nr = cmark.runs(e, y - ey, er);
    I64 r = 0;
    while (x < xend) {
        I64 past = x;
        for k in 0..nw {
            I64 i = order[k];
            I64 x0 = layout.frame_x(i);
            I64 y0 = layout.frame_y(i);
            I64 x1 = x0 + layout.frame_w(i);
            if (y >= y0 && y < y0 + layout.frame_h(i) && x >= x0 && x1 > past) { past = x1; }
        }
        if (past > x) {
            x = past;
        } else if (nr < 0) {
            I64 t = cmark.at(e, x - ex, y - ey);
            if (t >= 0) { row[x] = tokens.lockup(t) & 0xFFFFFF; }
            x = x + 1;
        } else {                       // to the run's end, the next window's left edge or the span's end
            while (ex + ((er[r] >> 16) as I64) <= x) { r = r + 1; }
            I64 nb = ex + ((er[r] >> 16) as I64);
            if (xend < nb) { nb = xend; }
            for k in 0..nw {
                I64 i = order[k];
                I64 x0 = layout.frame_x(i);
                I64 y0 = layout.frame_y(i);
                if (y >= y0 && y < y0 + layout.frame_h(i) && x0 > x && x0 < nb) { nb = x0; }
            }
            I64 t = ((er[r] & 0xFFFF) as I64) - 1;
            if (t >= 0) { draw.paint(row, x, nb, tokens.lockup(t)); }
            x = nb;
        }
    }
}

// Plane rows y0..y1 painted again: the mantle, the emblem on an empty desktop, then each shown window bottom first;
// then the pixel clients placed and the screen settled, so a pinned digest never depends on when the kernel's
// copies ran.
// MS-R5: paint_span paints only [xa, xb) of those rows (the whole width while the plane or a slide is drawn).
void paint_span(I64 ya, I64 yb, I64 xa_in, I64 xb_in) {
    if (!sl_own) { slide.clear(); }    // MS-R5: something changed on the desk: the slide's kept rows go
    if (sh_sel) { return; }            // RS-SHOT: the select's screen stays as it is held; redraw() follows it
    plate_sync();               // MS-5: a plate that opened, went or changed since the last paint
    win_sync();                 // MS-8: windows whose frames changed since the last paint
    Bool was = arrow_off(ya, yb);
    win_apply(true);            // MS-8: moving windows at their frames of the moment, for this paint
    I64 xa = xa_in;
    I64 xb = xb_in;
    if (plane_drawn() || sliding() || xa < 0) { xa = 0; }
    if (plane_drawn() || sliding() || xb > w) { xb = w; }
    if (sliding()) { slide_rows(ya, yb); } else if (xa < xb) { rows_span(ya, yb, xa, xb); }
    win_apply(false);
    arrow_back(was);
}

void paint_rows(I64 ya, I64 yb) { paint_span(ya, yb, 0, w); }

// Rows ya to yb of the active desktop, moved sl_dx px while a slide paints (MS-7), to the framebuffer.
void rows_at(I64 ya, I64 yb) { rows_span(ya, yb, 0, w); }

// MS-R5: shown terminals whose whole content box lies unclipped inside [xa, xb) x [ya, yb), marked clean (painted).
void clean_full_terms(I64 ya, I64 yb, I64 xa, I64 xb) {
    for i in 0..WINDOWS {
        if (kind[i] == TERM && shown(i)) {
            I64 s = slot[i];
            I64 cx = tcx(i);
            I64 cy = tcy(i);
            I64 cw = face.W * sc * terms.width(s);
            I64 ch = face.H * sc * terms.height(s);
            Bool unclipped = !wm_on[i] || (ax0[i] <= cx && ax1[i] >= cx + cw);
            if (unclipped && cx >= xa && cx + cw <= xb && cy >= ya && cy + ch <= yb) {
                for r in 0..terms.height(s) { terms.clean(s, r); }
            }
        }
    }
}

// The active desktop's paint order, bottom first (the overlay among the windows when up): its count; empty[0] when
// no window shows.
I64 rows_order(inout I64[_] order, inout Bool[_] empty) {
    I64 n = 0;
    empty[0] = true;
    for i in 0..16 {
        if (shown(i)) { empty[0] = false; }
        if ((i == OV && (ov_up())) || shown(i)) {
            I64 at = n;
            while (at > 0 && (layer_of(order[at - 1]) > layer_of(i))) {
                order[at] = order[at - 1];
                at = at - 1;
            }
            order[at] = i;
            n = n + 1;
        }
    }
    return n;
}

// Rows ya to yb of the active desktop across [xa, xb) (MS-R5), moved sl_dx px while a slide paints (MS-7, whole
// rows then), to the framebuffer.
void rows_span(I64 ya, I64 yb, I64 xa, I64 xb) {
    I64[16] order;
    Bool[1] empty = [true];
    I64 n = rows_order(order, empty);
    for y in ya..yb {
        row_compose(y, order, n, empty[0], xa, xb);
        row_put(y, xa, xb);
    }
}

// Row y of the active desktop across [xa, xb) in `row`, as it stands before a slide moves it.
// DN-49: the plane is a plate over a 45 percent scrim: the windows are painted under it, the plane last
void row_compose(I64 y, in I64[_] order, I64 n, Bool empty, I64 xa, I64 xb) {
    bg_row(y);                     // BG-1: the account's background, else the mantle
    if (empty) { emblem_row_span(y, order, n, xa, xb); }
    for k in 0..n {
        if (order[k] == OV && plate_moving()) {
            plate_row_span(y, xa, xb);     // MS-5: the plate opening, scaled and faded
        } else if (order[k] < WINDOWS && wm_on[order[k]]) {
            I64 i = order[k];          // MS-8: a moving window, its content cut to its frame of the moment
            cast_row(i, y, xa, xb);
            I64 fy0 = layout.frame_y(i);
            I64 fy1 = fy0 + layout.frame_h(i);
            if ((ax1[i] > xa && ax0[i] < xb && y >= fy0 && y < fy1) || about.blocks(i) || noanswer.blocks(i)) {
                copy(fade_b[xa..xb], row[xa..xb]);
                win_row_span(i, y, xa, xb);
                I64 ca = ax0[i];
                if (ca < xa) { ca = xa; }
                if (ca > xb) { ca = xb; }
                if (ca > xa) { copy(row[xa..ca], fade_b[xa..ca]); }
                I64 cb = ax1[i];
                if (cb < xa) { cb = xa; }
                if (cb > xb) { cb = xb; }
                if (cb < xb) { copy(row[cb..xb], fade_b[cb..xb]); }
            }
        } else {
            cast_row(order[k], y, xa, xb);   // MS-4: the window's shadow over what lies under it, then the window
            win_row_span(order[k], y, xa, xb);
        }
    }
    if (gh_kind != 0) { ghost_row_span(y, xa, xb); }   // MS-5: the plate going, over everything
    if (tip_on && tr_open) { tip_row(y); }   // SP-7: over every window
    if (drag == 1 && zone > 0) {
        draw.frame(row, y, zx, zy, zx + zw, zy + zh, sc, tok(tokens.ULTRAMARINE));   // WB-2: where it would go
    }
}

// Row y's [xa, xb) from `row` to the framebuffer, moved sl_dx px while a slide paints (MS-7).
void row_put(I64 y, I64 xa, I64 xb) {
    if (sl_dx == 0) {
        I64 e = xb;
        if (sh_up && y >= shotsel.plate_lo() && y < shotsel.plate_hi() && sh_x0() < e) { e = sh_x0(); }   // RS-SHOT: the plate stays
        if (xa < e) { I64 a = tilectl.fb_span(y, xa, row[xa..e]); }
    } else if (sl_dx > 0) {
        I64 a = tilectl.fb_span(y, sl_dx, row[0..w - sl_dx]);
    } else {
        I64 a = tilectl.fb_span(y, 0, row[0 - sl_dx..w]);
    }
}

// MS-7 (DN-54): the slide's clock: the wall, or on the gates' stepped clock a step a Shift press.
I64 sl_now() {
    if (stepped) { return anim.steps(sl_steps); }
    return wall.wall_ns();
}

Bool sliding() { return sl_from > 0 && sl_now() - sl_t0 < anim.ms(slide.SLIDE_MS); }

// MS-7 (DN-54): desktop d shown. With motion on, the desks slide there over 240 ms on the out curve, a higher number
// in from the right, passing over the ones between, the bar still; window i (or -1) takes focus when the slide ends.
// With motion off, a cut. A switch during a slide starts from the desktop the last one was going to.
void desk_to(I64 d, I64 i) {
    if (d != cur && anim_on) {
        sl_from = cur;
        sl_steps = 0;                  // stepped: each slide counts its own frames
        sl_t0 = sl_now();
        sl_win = i;
        slide.clear();                 // MS-R5: each slide keeps its own rows
        "hdesk: slide {cur} to {d}\n";
    } else if (i >= 0) {
        _ = raise(i);
    }
    cur = d;
}

// MS-R5: nothing on the desk moves by itself between the slide's frames (a plate, a window, the shake, the revert
// prompt's count, a shot's plate, the tooltip, a drop zone), so the rows of a desktop drawn on one frame hold on the next.
Bool sl_quiet() {
    return !plate_moving() && gh_kind == 0 && !any_moving() && !kp_shaking() && !rv_open && !sh_up && !(tip_on && tr_open) &&
           !(drag == 1 && zone > 0);
}

// Rows ya to yb mid slide: each desktop that shows, laid out and painted moved to where the strip holds it, its
// pixel windows placed there too; then the layout of the desktop the slide goes to. MS-R5: on the slide's own frames,
// with the desk quiet, each desktop's rows come from the slide cache (kit/slide.ci); one desktop not yet kept is
// drawn whole and kept a frame, the other only where it shows, so no frame draws two whole desktops.
void slide_rows(I64 ya, I64 yb) {
    I64 to = cur;
    I64 p = anim.progress(anim.OUT, sl_now() - sl_t0, anim.ms(slide.SLIDE_MS));
    Bool keep = sl_own && sl_quiet();
    if (!keep) { slide.clear(); }
    I64[2] ds;
    I64 nd = 0;
    for d in 1..10 {
        if (slide.shows(sl_from, to, d, w, p)) {
            ds[nd] = d;
            nd = nd + 1;
        }
    }
    I64 take = -1;                     // the desktop kept this frame: the one that shows the most
    if (keep) {
        I64 most = -1;
        for k in 0..nd {
            I64 vis = w - abs(slide.at(sl_from, to, ds[k], w, p));
            if (slide.held(ds[k]) < 0 && vis > most) {
                most = vis;
                take = ds[k];
            }
        }
    }
    sl_pass = true;
    for k in 0..nd {
        I64 d = ds[k];
        cur = d;
        relayout();
        sl_dx = slide.at(sl_from, to, d, w, p);
        I64 s = -1;
        if (keep) { s = slide.held(d); }
        if (keep && s < 0 && d == take) {
            I64 other = 0;
            if (nd == 2) { other = ds[1 - k]; }
            s = slide.take(d, other, w);
        }
        if (s >= 0) {
            kept_rows(ya, yb, s);
        } else if (!keep) {
            rows_at(ya, yb);
        } else if (sl_dx > 0) {
            rows_span(ya, yb, 0, w - sl_dx);   // where it shows: its first w - sl_dx columns
        } else {
            rows_span(ya, yb, 0 - sl_dx, w);
        }
        for i in 0..WINDOWS {
            if (kind[i] == PIXEL && wdesk[i] == d) { place(i); }
        }
    }
    sl_dx = 0;
    sl_pass = false;
    cur = to;
    relayout();
}

// MS-R5: rows ya to yb of the active desktop moved sl_dx px, each from slot s of the slide cache, else drawn and kept.
// A row kept as the row above is already in `row`.
void kept_rows(I64 ya, I64 yb, I64 s) {
    I64[16] order;
    Bool[1] empty = [true];
    I64 n = rows_order(order, empty);
    I64 had = -1;                      // the code of the row `row` holds
    for y in ya..yb {
        I64 c = slide.code(s, y);
        if (c < 0 || c != had) {
            if (c >= 0 && slide.load(s, y, row, w)) {
                had = c;
            } else {
                row_compose(y, order, n, empty[0], 0, w);
                slide.store(s, y, row, w);
                had = slide.code(s, y);
            }
        }
        row_put(y, 0, w);
    }
}

// MS-7: the slide's next frame, or its end: the window it was for focused and the desk drawn at rest.
void slide_tick() {
    if (sliding()) {
        sl_own = true;                 // MS-R5: the slide's own frame, painted from its kept rows
        paint_rows(bar_h(), h);
        sl_own = false;
        settle();
        if (stepped) {                 // the gate's mark: this frame is drawn
            "hdesk: slide step {sl_steps} at {anim.progress(anim.OUT, sl_now() - sl_t0, anim.ms(slide.SLIDE_MS))}\n";
        }
        return;
    }
    sl_from = 0;
    slide.clear();
    if (sl_win >= 0 && sl_win < WINDOWS && kind[sl_win] != NONE && wdesk[sl_win] == cur) { _ = raise(sl_win); }
    sl_win = -1;
    "hdesk: slide ended desktop {cur}\n";
    redraw();
}

void settle() {
    put_word(req, 0, SETTLE);
    I64 st = tilectl.tile_ctl(FBIO_TILE_SYNC, req);
}

// Rest-state bookkeeping after MS-7 or MS-8 finishes its damage pass: layout transcript, resize notifications, dirty
// terminal rows, bar, pixel placements, and overlay bounds, without repainting the whole plane.
void finish_rest() {
    relayout();
    print_layout();
    resizes();
    for i in 0..WINDOWS {
        if (kind[i] == TERM && shown(i)) {
            I64 c = max(1, (cbw(i) - 2 * TPAD * sc) / (face.W * sc));
            I64 r = max(1, (cbh(i) - 2 * TPAD * sc) / (face.H * sc));
            if (c > terms.MAX_COLS) { c = terms.MAX_COLS; }
            if (r > terms.MAX_ROWS) { r = terms.MAX_ROWS; }
            if (c != terms.width(slot[i]) || r != terms.height(slot[i])) {
                terms.resize(slot[i], c, r);
                I64 st = hdeskctl.pty_winsize(master[i], c, r);
            }
            term_rows(i);
        }
    }
    bar(true);
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL) { place(i); }
    }
    settle();
    ov_rows();
}

// The whole desk again: layout, terminals' sizes, the plane, the bar, the placements.
void redraw() {
    pl_rle_ok = false;
    gh_rle_ok = false;
    relayout();
    print_layout();
    resizes();
    for i in 0..WINDOWS {
        if (kind[i] == TERM && shown(i)) {
            I64 c = max(1, (cbw(i) - 2 * TPAD * sc) / (face.W * sc));
            I64 r = max(1, (cbh(i) - 2 * TPAD * sc) / (face.H * sc));
            if (c > terms.MAX_COLS) { c = terms.MAX_COLS; }
            if (r > terms.MAX_ROWS) { r = terms.MAX_ROWS; }
            if (c != terms.width(slot[i]) || r != terms.height(slot[i])) {
                terms.resize(slot[i], c, r);
                I64 st = hdeskctl.pty_winsize(master[i], c, r);
            }
        }
    }
    paint_rows(bar_h(), h);
    bar(true);
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL && !sliding()) { place(i); }   // MS-7: mid slide, slide_rows placed them
    }
    settle();
    ov_rows();
}

// The rows and horizontal span the overlay covers now, its shadow's reach included (MS-4), into ov_top..ov_right.
void ov_rows() {
    ov_top = 0;
    ov_bot = 0;
    ov_left = 0;
    ov_right = 0;
    if (ov_up()) {
        ov_top = layout.frame_y(OV);
        ov_bot = ov_top + layout.frame_h(OV);
        ov_left = layout.frame_x(OV);
        ov_right = ov_left + layout.frame_w(OV);
        I64 lv = cast_level(OV);
        if (lv > 0) {                  // MS-4: a plate's shadow is painted again with it
            I64 rs = shade.reach_side(lv, tokens.theme(), sc);
            ov_top = ov_top - shade.reach_up(lv, tokens.theme(), sc);
            ov_bot = ov_bot + shade.reach_down(lv, tokens.theme(), sc);
            ov_left = ov_left - rs;
            ov_right = ov_right + rs;
            if (ov_top < bar_h()) { ov_top = bar_h(); }
            if (ov_bot > h) { ov_bot = h; }
            if (ov_left < 0) { ov_left = 0; }
            if (ov_right > w) { ov_right = w; }
        }
        if (msg_up() && anim_on) { ov_top = ov_top - plate.MSG_DROP * sc; }   // MS-5: the message drops in
        if (ov_top < bar_h()) { ov_top = bar_h(); }
        if (ov_left < 0) { ov_left = 0; }
        if (ov_right > w) { ov_right = w; }
    }
    if (tip_on) {                      // SP-7: the tooltip's box
        if (ov_top == ov_bot || tip_y < ov_top) { ov_top = tip_y; }
        if (tip_y + tooltip.H * sc > ov_bot) { ov_bot = tip_y + tooltip.H * sc; }
        if (ov_left == ov_right || tip_x < ov_left) { ov_left = tip_x; }
        if (tip_x + tip_w > ov_right) { ov_right = tip_x + tip_w; }
    }
}

// The overlay alone changed (opened, moved, filtered, or closed with no other change): only the box it covers now
// or covered before is painted again, since a whole plane is seconds under TCG.
void redraw_overlay() {
    pl_rle_ok = false;
    I64 oa = ov_top;
    I64 ob = ov_bot;
    I64 ox0 = ov_left;
    I64 ox1 = ov_right;
    Bool rec = gh_kind != 0;           // MS-5: a plate going may be dropped in this paint; its box goes with it
    I64 ga = gh_top;
    I64 gb = gh_bot;
    I64 gx0 = gh_left;
    I64 gx1 = gh_right;
    relayout();
    print_layout();
    ov_rows();
    I64 a = h;
    I64 b = 0;
    I64 xa = w;
    I64 xb = 0;
    if (oa < ob && ox0 < ox1) {
        if (oa < a) { a = oa; }
        if (ob > b) { b = ob; }
        if (ox0 < xa) { xa = ox0; }
        if (ox1 > xb) { xb = ox1; }
    }
    if (ov_top < ov_bot && ov_left < ov_right) {
        if (ov_top < a) { a = ov_top; }
        if (ov_bot > b) { b = ov_bot; }
        if (ov_left < xa) { xa = ov_left; }
        if (ov_right > xb) { xb = ov_right; }
    }
    if (rec && ga < gb && gx0 < gx1) {
        if (ga < a) { a = ga; }
        if (gb > b) { b = gb; }
        if (gx0 < xa) { xa = gx0; }
        if (gx1 > xb) { xb = gx1; }
    }
    if (a < b && xa < xb) { paint_span(a, b, xa, xb); }
    bar(false);
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL) { place(i); }
    }
    settle();
}

// Terminal window i's first cell's device top left: its content box's, TPAD in (frames 40, 43, 44).
I64 tcx(I64 i) { return cbx(i) + TPAD * sc; }
I64 tcy(I64 i) { return cby(i) + TPAD * sc; }

// Terminal window i's changed rows drawn again within its visible rectangles: each of a cell row's 16 pixel rows
// drawn once at the UI scale, then put to each of its sc screen rows within each rectangle (D-ROW).
void term_rows(I64 i) {
    I64 s = slot[i];
    if (sh_sel || any_moving()) { return; }   // RS-SHOT, MS-8: its rows stay dirty until the select or the motion ends
    if (!shown(i)) {
        for r in 0..terms.height(s) { terms.clean(s, r); }
        return;
    }
    I64 x0 = tcx(i);
    I64 y0 = tcy(i);
    Bool blk = sheet_blocks(i);        // DN-43: under its sheet, output goes around the sheet (no dim, DN-69)
    Bool dim = noanswer.blocks(i);     // DN-51 frame 25: under "not answering" at 40 percent
    Bool shaded = caster_above(i);     // MS-4: shade_above only under a caster
    Bool was = arrow_off(y0, y0 + cbh(i));
    for r in 0..terms.height(s) {
        if (terms.is_dirty(s, r)) {
            terms.clean(s, r);
            I64 z = tz();
            I64 m = sc / z;
            I64 xw = x0 + face.W * sc * terms.width(s);
            I64 xz = x0 + face.W * z * terms.width(s);
            for gy in face.H * z * r..face.H * z * (r + 1) {
                Bool drawn = false;        // D-ROW: a source row drawn once, put to each of its m screen rows
                for y in y0 + m * gy..y0 + m * (gy + 1) {
                    for q in 0..layout.rects(i) {
                        I64 rx = layout.rect_x(i, q);
                        I64 ry = layout.rect_y(i, q);
                        if (y >= ry && y < ry + layout.rect_h(i, q)) {
                            if (!drawn) {
                                terms.draw_row(s, row[x0..xz], gy, z);
                                expand_by(x0, face.W * z * terms.width(s), m);
                                if (dim) { blend.mix(row, x0, xw, tokens.term_paper(), NR_DIM); }
                                drawn = true;
                            }
                            I64 a = x0;
                            I64 b = xw;
                            if (a < rx) { a = rx; }
                            if (b > rx + layout.rect_w(i, q)) { b = rx + layout.rect_w(i, q); }
                            if (a < b) {
                                // MS-4: the shadows of the windows above over this span; the source row is then
                                // drawn afresh for the next screen row
                                if (shaded && shade_above(i, y, a, b)) { drawn = false; }
                                if (blk) {
                                    I64[16] pc;
                                    I64 np = sheet_around(i, a, y, b, y + 1, pc);
                                    for pi in 0..np {
                                        I64 pp = tilectl.fb_span(y, pc[4 * pi], row[pc[4 * pi]..pc[4 * pi + 2]]);
                                    }
                                } else {
                                    sh_put(y, a, b);   // RS-SHOT: short of the plate while it is up
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    arrow_back(was);
}

// The next pixel client's tile: 320 x 200 at the plane's corner, hidden until it is placed.
void offer() {
    put_word(req, 0, OFFER_W);
    put_word(req, 1, OFFER_H);
    put_word(req, 2, 0);
    put_word(req, 3, bar_h());
    I64 st = tilectl.tile_ctl(FBIO_TILE_NEXT, req);
    for k in 0..24 { place_arg[k] = 0; }
    place_arg[12] = 1;
    I64 hid = tileplace.tile_place(place_arg);
}

// A free window number, or -1.
I64 free_window() {
    for i in 0..WINDOWS {
        if (kind[i] == NONE) { return i; }
    }
    return -1;
}

// DN-21: window i floating on the active desktop for app a (or apps.NONE), asking askw x askh device px (0: none):
// the app's last frame this session when wholly on screen, else its size at the next place of the desktop's cascade.
void float_open(I64 i, I64 a, I64 askw, I64 askh) {
    wmode[i] = layout.FLOAT;
    I64 ay = bar_h();
    I64 ah = plane_h();
    if (a >= 0 && a < 16 && ap_has[a] && winrule.on_area(ap_x[a], ap_y[a], ap_w[a], ap_h[a], 0, ay, w, ah)) {
        wfx[i] = ap_x[a];
        wfy[i] = ap_y[a];
        wfw[i] = ap_w[a];
        wfh[i] = ap_h[a];
    } else {
        I64[2] z;
        winrule.float_size(askw, askh, w, ah, sc, z);
        I64[2] q;
        winrule.place_next(cas_any[cur], cas_x[cur], cas_y[cur], z[0], z[1], 0, ay, w, ah, sc, q);
        wfx[i] = q[0];
        wfy[i] = q[1];
        wfw[i] = z[0];
        wfh[i] = z[1];
        cas_any[cur] = true;
        cas_x[cur] = q[0];
        cas_y[cur] = q[1];
    }
    keep_float(i);
    "hdesk: float {i} app {a} frame {wfx[i]},{wfy[i]} {wfw[i]}x{wfh[i]}\n";
}

// DN-21: the restore's clock: the wall, or on the gates' stepped clock a step a Shift press.
I64 ra_now() {
    if (stepped) { return anim.steps(ra_steps); }
    return wall.wall_ns();
}

Bool ra_running() { return ra_win >= 0 && ra_now() - ra_t0 < anim.ms(winrule.RESTORE_MS); }

// DN-21: maximized window j back to its floating frame from before maximizing, moving there over 200 ms on the out
// curve (at once with animations off).
void restore_float(I64 j) {
    ra_from[0] = layout.frame_x(j);
    ra_from[1] = layout.frame_y(j);
    ra_from[2] = layout.frame_w(j);
    ra_from[3] = layout.frame_h(j);
    wmode[j] = layout.FLOAT;
    keep_float(j);
    if (anim_on && ra_from[2] > 0) {
        ra_win = j;
        ra_t0 = ra_now();
    }
    "hdesk: restore {j} frame {wfx[j]},{wfy[j]} {wfw[j]}x{wfh[j]}\n";
}

// DN-20: a Super chord opens a tile: a maximized float on the active desktop goes back to its floating frame.
void unmax_for_tile() {
    for j in 0..WINDOWS {
        if (listed(j) && wdesk[j] == cur && wmode[j] == layout.MONOCLE && wprev[j] == layout.FLOAT) {
            restore_float(j);
        }
    }
}

// A new terminal on the active desktop: /sh on a fresh pty; its window number, or -1. DN-20: tiled when a Super chord
// opens it (or the desk's first terminal at boot, HX-7), else a float placed by DN-21 for app (kit/apps.ci). RG-1:
// for an app in its own window (apps.WINDOW) the terminal only holds the app's process (lx_host): it is never placed
// or focused, and the app's window, when it binds, is the one the person sees.
I64 new_term(Bool tiled, I64 app) {
    if (ac_on && s_acct < 0) {
        "hdesk: no session, no shell\n";   // with accounts on, a shell starts only as a session's account
        return -1;
    }
    I64 i = free_window();
    I64 s = -1;
    for k in 0..terms.SLOTS {
        if (s < 0 && !slot_used[k]) { s = k; }
    }
    if (i < 0 || s < 0) {
        "hdesk: no room for a terminal\n";
        U8[48] t;
        I64 n = winroom.full(i < 0, winroom.seen(kind, lx_host, WINDOWS), t);   // RG-1: the windows the person has
        msg_show(t[0..n]);          // DN-6 frame 9: one sentence under the bar
        return -1;
    }
    I64 m = ptyctl.pty_open(80, 25);
    if (m < 0) {
        "hdesk: no pty ({m})\n";
        return -1;
    }
    I64 nb = hdeskctl.pty_nonblock(m);
    terms.init(s, 80, 25);
    for k in 0..4 { put_word(req, k, 0); }
    I64 none = tilectl.tile_ctl(FBIO_TILE_NEXT, req);   // the shell, this process's child, takes no tile at its fork
    // ced is the editor (E-6); one /bin (BU-2c); FS-3: the shell starts where the desk did, the home on the volume
    // (the kernel's fs.home), and HOME names it; without a volume HOME is the root
    I64 p = -1;
    if (ac_on && s_acct >= 0) {
        // AC-1c: the session's terminals start through login (AC-1a), as the account, in its home
        U8[160] env;
        I64 en = cat(env, 0, b"PATH=/bin\x00HOME=/home/");
        for k in 0..acct.name_len(s_acct) { env[en + k] = acct.name_byte(s_acct, k); }
        en = en + acct.name_len(s_acct);
        en = cat(env, en, b"\x00EDITOR=/bin/ced\x00VISUAL=/bin/ced\x00TERM_PROGRAM=daphnis\x00");   // AM-3: a desk terminal
        U64 c = 7;
        if (acct.role_of(s_acct) != acct.PARENT) { c = acct.ceil_of(s_acct); }
        p = hdeskctl.spawn_as(b"/sh", env[0..en], m, acct.uid_of(s_acct), acct.gid_of(s_acct), c as I64);
    } else if (sys_flags() % 2 == 1) {
        p = ptyctl.pty_spawn(b"/sh", b"PATH=/bin\x00HOME=/home\x00EDITOR=/bin/ced\x00VISUAL=/bin/ced\x00TERM_PROGRAM=daphnis\x00", m);
    } else {
        p = ptyctl.pty_spawn(b"/sh", b"PATH=/bin\x00HOME=/\x00EDITOR=/bin/ced\x00VISUAL=/bin/ced\x00TERM_PROGRAM=daphnis\x00", m);
    }
    offer();
    if (p < 0) {
        "hdesk: cannot start the shell ({p})\n";
        return -1;
    }
    slot_used[s] = true;
    kind[i] = TERM;
    slot[i] = s;
    master[i] = m;
    pid[i] = p;
    lx_len[i] = 0;                     // a shell until pl_run names the program it was opened for
    lx_app[i] = 0;
    lx_host[i] = app != apps.NONE && apps.runs_in(app) == apps.WINDOW;
    wdesk[i] = cur;
    ranks = ranks + 1;
    wrank[i] = ranks;
    "hdesk: terminal {i} slot {s} pid {p}\n";
    if (lx_host[i]) {
        "hdesk: terminal {i} holds an app\n";
        return i;
    }
    if (tiled) {
        wmode[i] = layout.TILED;
        unmax_for_tile();
    } else {
        float_open(i, app, 0, 0);
    }
    layout.focus(i);
    return i;
}

// A process took the offered tile at its open, or a window's client asked its own surface size (FBIO_TILE_WANT):
// a new pixel window on the active desktop, focused, or the sizes read again and the windows placed again.
void bound() {
    Bool sized = false;
    for j in 0..WINDOWS {
        if (kind[j] == PIXEL) {
            if (info(j) && (surf_w(j) != asw[j] || surf_h(j) != ash[j])) {
                // RS-SURF: a client's own first ask (fb_open's WANT) that came after the desk laid out the tile it
                // took at its open: its float was sized for the offer and never told, so it floats again at the ask,
                // as it would have had the ask come first (View from the screenshot plate opened 320 x 200, cut)
                Bool late = wmode[j] == layout.FLOAT && asw[j] == OFFER_W && ash[j] == OFFER_H &&
                    (rbw[j] == 0 || (rbw[j] == OFFER_W && rbh[j] == OFFER_H));
                asw[j] = surf_w(j);    // against what was announced: a redraw's info() may have read the new size first
                ash[j] = surf_h(j);
                "hdesk: pixel {j} size {asw[j]}x{ash[j]}\n";
                if (late) {
                    float_open(j, win_app(j), psw[j] * sc + 2 * FB * sc, psh[j] * sc + 2 * FB * sc + WBAR * sc);
                    rbw[j] = 0;        // its first layout again: told only if the box cuts the ask
                    rbh[j] = 0;
                }
                sized = true;
            }
        }
    }
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 0, 0, ask[0..64]);
    I64 vp = word_at(ask, 0);
    Bool known = false;
    for j in 0..WINDOWS {
        if (kind[j] == PIXEL && pid[j] == vp) { known = true; }
    }
    if (st >= 0 && known) {
        redraw();                     // its placement went with the size it asked: placed again
        return;
    }
    I64 i = free_window();
    if (i < 0 || st < 0) {
        "hdesk: a pixel client with no window ({st})\n";
        offer();
        if (sized) { redraw(); }
        return;
    }
    kind[i] = PIXEL;
    pid[i] = vp;
    ptr_ask[i] = 0;
    psw[i] = (ask[4] as I64) | ((ask[5] as I64) << 8);
    psh[i] = (ask[6] as I64) | ((ask[7] as I64) << 8);
    var_take(i, ask);
    rbw[i] = 0;
    rbh[i] = 0;
    wdesk[i] = cur;
    if (dl_float) { dl_float = false; }   // SP-7: Index at the downloads opens floating, as every app now does (DN-20, DN-21)
    pixels = pixels + 1;
    ranks = ranks + 1;
    wrank[i] = ranks;
    asw[i] = surf_w(i);
    ash[i] = surf_h(i);
    if (first_monocle && pixels == 1) {
        wmode[i] = layout.MONOCLE;
    } else {                           // DN-20: an app opens floating, its surface the ask (DN-21)
        Bool named = info(i);
        I64 aw = 0;
        I64 ah = 0;
        if (psw[i] > 0 && psh[i] > 0) {
            aw = psw[i] * sc + 2 * FB * sc;
            ah = psh[i] * sc + 2 * FB * sc + WBAR * sc;
        }
        float_open(i, win_app(i), aw, ah);
    }
    "hdesk: pixel {i} pid {pid[i]} size {asw[i]}x{ash[i]}\n";
    busy_stop();                       // DN-37: the window is here
    if (info(i)) { pins_tell(i); }     // DN-46 (c): a new Index gets the pins
    layout.focus(i);
    offer();
    redraw();
}

void close_window(I64 i) {
    I64 a = win_app(i);                // DN-21: the app's last floating frame, for its next open this session
    if (a >= 0 && a < 16 && (wmode[i] == layout.FLOAT || (wmode[i] == layout.MONOCLE && wprev[i] == layout.FLOAT))) {
        ap_has[a] = true;
        ap_x[a] = wfx[i];
        ap_y[a] = wfy[i];
        ap_w[a] = wfw[i];
        ap_h[a] = wfh[i];
    }
    if (ra_win == i) { ra_win = -1; }
    if ((ac_op_up || deskask.up()) && kp_win == i) { kern_answer(false); }   // Settings gone, its ask with it
    if (i == cool_win) { cool_win = -1; }   // AC-D4: the cooldown is the tree's; a new window in this slot is asked
    if (kp_open && !ac_op_up && !deskask.up() && kp_win == i) { kp_win = -1; }   // a kernel ask: no window to hold
    if (st_win == i) { ac_form_end(); }   // and its form
    if (kind[i] == TERM) { slot_used[slot[i]] = false; }
    if (kind[i] == TERM) {
        slot_used[slot[i]] = false;
        I64 c = shctl.fd_close(master[i]);   // the pair goes back to the kernel's 8 (src/pty.ci PTYS)
        master[i] = -1;
    }
    if (kind[i] == FAULT) { fw_win = -1; }
    if (i == fw_jump) { fw_jump = -1; }
    for k in 0..16 { title[16 * i + k] = 0; }   // the next window in this slot never shows this one's name
    if (kind[i] == SETTINGS) {
        st_win = -1;
        rn_stop();                     // a run as the account for a page no one sees: killed and reaped
    }
    kind[i] = NONE;
    lx_app[i] = 0;                // AC-T: the next window in this slot is no one's app until pl_run says so
    lx_host[i] = false;           // RG-1: nor a host
    wask[i] = false;              // SP-2: out of the tray with its window
    wtray[i] = false;
    tin[i] = false;
    layout.forget(i);
    layout.remove(i);
    about.forget(i);              // DN-43: its sheet goes with it (review on PR 272)
    noanswer.forget(i);           // DN-51 frame 25
    nr_on[i] = false;
    gr_forget(i);                 // frame 21: its grants' times and request text
    if (sw_open) {
        sw_build();
        if (sw_n == 0) { sw_open = false; }
    }
    if (mn_open) {
        menu_items();
        menu_filter();
    }
    if (pl_open) { pl_machine(); }
}

// The switcher's entries: the active desktop's windows most recent first (HX-11), with `sw_same` only those with
// the focused window's title (Alt+`).
void sw_build() {
    sw_n = 0;
    I64 f = focused();
    for k in 0..layout.entries(cur) {
        I64 e = layout.entry(cur, k);
        Bool got = info(e);
        Bool keep = true;
        if (sw_same && f >= 0) {
            keep = title_len(e) == title_len(f);
            for q in 0..title_len(e) {
                if (keep && title[16 * e + q] != title[16 * f + q]) { keep = false; }
            }
        }
        if (keep) {
            sw_list[sw_n] = e;
            sw_n = sw_n + 1;
        }
    }
    if (sw_sel >= sw_n) { sw_sel = sw_n - 1; }
    if (sw_sel < 0) { sw_sel = 0; }
}

void switcher_close(Bool choose) {
    I64 e = -1;
    if (sw_sel < sw_n) { e = sw_list[sw_sel]; }
    sw_open = false;
    if (choose && e >= 0) {
        if (wmode[e] == layout.MINIMIZED) { wmode[e] = layout.TILED; }
        Bool up = raise(e);
        if (sw_sticky) { "hdesk: switcher chose {e} (sticky)\n"; } else { "hdesk: switcher chose {e}\n"; }
    } else {
        "hdesk: switcher closed\n";
        redraw_overlay();
        return;
    }
    redraw();
}

void switcher_show() {
    I64 e = -1;
    if (sw_sel < sw_n) { e = sw_list[sw_sel]; }
    "hdesk: switcher {sw_sel} of {sw_n}, window {e}\n";
    redraw_overlay();
    k12_mark(2);
}

// Opened by the key `key` (its release chooses, unless sticky); the second entry selected, the last for d < 0.
void switcher_open(I64 key, I64 d, Bool sticky, Bool same) {
    ungrab();                          // HX-11: Alt+Tab ends a pointer grab
    cal_open = false;
    sp_open = false;
    tr_open = false;
    sw_key = key;
    sw_sticky = sticky;
    sw_same = same;
    sw_sel = 0;
    sw_build();
    if (sw_n == 0) { return; }
    sw_open = true;
    if (sw_n > 1) { sw_sel = 1; }
    if (d < 0) { sw_sel = sw_n - 1; }
    if (sticky) { "hdesk: switcher sticky\n"; }
    switcher_show();
}

// DN-6 frame 10: the switcher is one row, so Up goes to the first tile and Down to the last (d = -1 or 1).
void switcher_row(I64 d) {
    sw_build();
    if (sw_n == 0) {
        switcher_close(false);
        return;
    }
    sw_sel = 0;
    if (d > 0) { sw_sel = sw_n - 1; }
    switcher_show();
}

void switcher_move(I64 d) {
    sw_build();
    if (sw_n == 0) {
        switcher_close(false);
        return;
    }
    sw_sel = (sw_sel + d + sw_n) % sw_n;
    switcher_show();
}

// DN-6 frame 10 (design note 6): the switcher's row y at 1x from (x0, y0) on SURF2 (the OV window's ground,
// radius 16): n tiles of 116 x 116, 16 px in and 8 apart, each the window's icon (56 px, centered on 46 px down)
// over its name (BODY, INK); the selected tile, sel, FILL with radius 12, a 64 px icon and its name in NAME on
// ON_FILL. Nothing else.
void switcher_at(I64 x0, I64 y0, I64 n, in I64[16] ic, in U8[_] nm, in I64[16] nl, I64 sel, I64 y) {
    for k in 0..n {
        I64 tx = x0 + 16 + (SW_T + 8) * k;
        I64 ty = y0 + 16;
        U8[16] t;
        for c in 0..nl[k] { t[c] = nm[16 * k + c]; }
        I64 s = 56;
        U32 g = tok(tokens.SURF2);
        I64 e = 0;
        if (k == sel) {
            s = 64;
            g = tok(tokens.FILL);
            pen.round(row, tx, ty, tx + SW_T, ty + SW_T, 12, g);
            e = ptxt_mid(tx, SW_T, ty + 82, tx + SW_T, t, nl[k], tok(tokens.ON_FILL), faces.NAME_BOLD);
        } else {
            e = ptxt_mid(tx, SW_T, ty + 82, tx + SW_T, t, nl[k], tok(tokens.INK), faces.BODY);
        }
        I64 iy = ty + 46 - s / 2;
        if (y >= iy && y < iy + s) {
            icons3.icon_at(row, pen.row_y(), pen.x(tx + (SW_T - s) / 2), pen.y(iy), ic[k], s, pen.zoom(), g);
        }
    }
}

// --- the Super menu (HX-6 item 4) ---

Bool lower_eq(U8 a, U8 b) {
    I64 x = a as I64;
    I64 y = b as I64;
    if (x >= 65 && x <= 90) { x = x + 32; }
    if (y >= 65 && y <= 90) { y = y + 32; }
    return x == y;
}

// How entry k matches the query: 0 a prefix, 1 a subsequence, 2 not at all.
I64 mn_match(I64 k) {
    I64 n = it_len[k];
    Bool pre = qlen <= n;
    for q in 0..qlen {
        if (pre && !lower_eq(it_label[96 * k + q], query[q])) { pre = false; }
    }
    if (pre) { return 0; }
    I64 at = 0;
    for c in 0..n {
        if (at < qlen && lower_eq(it_label[96 * k + c], query[at])) { at = at + 1; }
    }
    if (at == qlen) { return 1; }
    return 2;
}

// The entries the query keeps: by section, in each the prefixes then the subsequences, ties in list order; the rows.
void menu_filter() {
    n_shown = 0;
    n_rows = 1;
    row_what[0] = -1;
    for sec in 1..4 {
        Bool head = false;
        for m in 0..2 {
            for k in 0..n_items {
                if (it_kind[k] == sec && mn_match(k) == m) {
                    if (!head) {
                        row_what[n_rows] = -2 - sec;
                        n_rows = n_rows + 1;
                        head = true;
                    }
                    shown_it[n_shown] = k;
                    n_shown = n_shown + 1;
                    row_what[n_rows] = k;
                    n_rows = n_rows + 1;
                }
            }
        }
    }
    if (mn_sel >= n_shown) { mn_sel = n_shown - 1; }
    if (mn_sel < 0) { mn_sel = 0; }
}

I64 menu_rows() { return n_rows; }

void add_item(I64 kd, I64 ref, in U8[_] text, I64 n) {
    for q in 0..n { it_label[96 * n_items + q] = text[q]; }
    it_kind[n_items] = kd;
    it_ref[n_items] = ref;
    it_len[n_items] = n;
    n_items = n_items + 1;
}

// The menu's entries: the App menu's (DN-72: no grant pill opens a list).
void menu_items() {
    n_items = 0;
    if (mn_app) { app_items(); }
}

// The App dropdown's entries (HX-6 item 3), all for the focused window: float or tile, minimize, monocle, each other
// desktop to move it to, terminate. Moving and resizing by arrows are chords with no entry.
void app_items() {
    add_item(3, KEY_F, b"float or tile", 13);
    add_item(3, KEY_M, b"minimize", 8);
    add_item(3, KEY_Z, b"monocle", 7);
    for d in 1..10 {
        if (d != cur) {
            U8[16] t;
            for q in 0..11 { t[q] = b"to desktop "[q]; }
            t[11] = (48 + d) as U8;
            add_item(3, 0 - (d + 1), t, 12);      // Super+Shift+d: key code d + 1
        }
    }
    add_item(3, KEY_Q, b"terminate", 9);
}

// A command's keycaps (HX-6 item 3) at dst[0]; the length.
I64 caps_of(I64 ref, inout U8[_] dst) {
    if (ref >= CMD_SETTINGS) { return 0; }
    for q in 0..7 { dst[q] = b"[SUPER]"[q]; }
    I64 n = 7;
    if (ref < 0) {
        for q in 0..8 { dst[n + q] = b" [SHIFT]"[q]; }
        n = n + 8;
    }
    I64 r = ref;
    if (r < 0) { r = 0 - r; }
    if (r == KEY_ENTER) {
        for q in 0..8 { dst[n + q] = b" [ENTER]"[q]; }
        return n + 8;
    }
    dst[n] = ' ';
    dst[n + 1] = '[';
    if (r == KEY_F) { dst[n + 2] = 'F'; }
    if (r == KEY_Z) { dst[n + 2] = 'Z'; }
    if (r == KEY_M) { dst[n + 2] = 'M'; }
    if (r == KEY_Q) { dst[n + 2] = 'Q'; }
    if (r >= 2 && r <= 10) { dst[n + 2] = (47 + r) as U8; }   // a digit key, 1..9
    dst[n + 3] = ']';
    return n + 4;
}

// Menu row y of the plane (the frame at x0, y0): a 2 px rule frame; the query; the headings in dim ink; the entries,
// the selected one filled; a command's keycaps at the right, terminate in ink as the rest (KD-4 A).
void menu_row(I64 x0, I64 y0, I64 y) {
    pen.frame(row, x0, y0, x0 + MW, y0 + 16 + MR * n_rows, 2, tok(tokens.RULE));
    I64 r = (y - y0 - 8) / MR;
    if (y < y0 + 8 || r >= n_rows) { return; }
    I64 ry = y0 + 8 + MR * r;
    I64 what = row_what[r];
    U32 fg = tok(tokens.INK);
    if (what == -1) {
        U8[34] t;
        t[0] = '>';
        t[1] = ' ';
        for q in 0..qlen { t[2 + q] = query[q]; }
        t[2 + qlen] = '_';
        I64 a = ptxt(x0 + 12, ry + 2, x0 + MW - 12, t, 3 + qlen, fg, faces.BODY);
        return;
    }
    if (what < -1) {
        I64 sec = -2 - what;
        U32 hc = tok(tokens.INK_DIM);
        if (sec == 1) { I64 a = ptxt(x0 + 12, ry + 2, x0 + MW - 12, b"MINIMIZED", 9, hc, faces.LABEL); }
        if (sec == 2) { I64 a = ptxt(x0 + 12, ry + 2, x0 + MW - 12, b"WINDOWS", 7, hc, faces.LABEL); }
        if (sec == 3) { I64 a = ptxt(x0 + 12, ry + 2, x0 + MW - 12, b"COMMANDS", 8, hc, faces.LABEL); }
        return;
    }
    if (n_shown > 0 && shown_it[mn_sel] == what) {
        pen.round(row, x0 + 6, ry, x0 + MW - 6, ry + MR, MR / 2, tok(tokens.FILL));   // FF 3g: a full pill inset 6
        fg = tok(tokens.ON_FILL);
    }
    I64 a = ptxt(x0 + 12, ry + 2, x0 + MW - 12, it_label[96 * what..96 * what + 96], it_len[what], fg, faces.NAME);
    if (it_kind[what] == 3) {
        U8[24] c;
        I64 n = caps_of(it_ref[what], c);
        I64 e = pen.text_right(row, x0 + MW - 12, ry + 2 + TBASE, c, n, fg, faces.PATH);
    }
}

void menu_show() {
    "hdesk: menu |";
    I64 put = ptyctl.pty_write(1, query[0..qlen]);
    "| sel {mn_sel} of {n_shown}\n";
    for q in 0..n_shown {
        I64 k = shown_it[q];
        "hdesk: item {k} kind {it_kind[k]} |";
        I64 put2 = ptyctl.pty_write(1, it_label[96 * k..96 * k + it_len[k]]);
        "|\n";
    }
    redraw_overlay();
}

// AM-1 (docs/specs/2026-11-10-am-app-menu.md section 3, design notes 17 and 18): the App Title's menu for the
// focused window, drawn by the menu kit (kit/ctxmenu.ci, APP_MENU): About APP; Settings (AM-2); the app's own rows
// (AM-4, frame 41); Window (DN-58: Tiled, Floating, Full Screen, the current one dotted / Minimize); Exit. The plate
// is 216 wide, shadow High, 8 px under the bar, its left edge on the name's slot; it is the OV window's only drawing,
// mixed over what lies under it (no ground). The kit draws at zoom am_z() (1 or 2: at UI scale 3 the plate is drawn
// at 2x).
I64 am_z() {
    if (sc >= 2) { return 2; }
    return 1;
}

// AM-2: the app menu's window and what its program declared (section 4): About's name, version and text, the
// Settings item's id (-1 none). A terminal's from its OSC 7770 (terms), a pixel program's from FBIO_TILE_INFO kinds 8
// and 10 (FBIO_TILE_MENU).
I64 am_win = -1;
I64 am_set = -1;
Bool am_set_off = false;    // declared dimmed: drawn at 35 percent, never chosen
Bool am_by_key = false;     // DN-43: the menu was answered by a key (the sheet shows OK's ring)
U8[24] am_nm;
I64 am_nn = 0;
U8[16] am_ver;
I64 am_vn = 0;
U8[128] am_txt;
I64 am_tn = 0;
const I64 EV_MENU = 7;       // AM-2: a chosen item to a pixel program: type 7, code its id, value 1

I64 nul_len(in U8[_] b, I64 at, I64 cap) {
    I64 n = 0;
    while (n < cap && b[at + n] != 0) { n = n + 1; }
    return n;
}

void am_declared(I64 i) {
    am_set = -1;
    am_set_off = false;
    am_nn = 0;
    am_vn = 0;
    am_tn = 0;
    if (kind[i] == TERM) {
        I64 s = slot[i];
        am_nn = terms.menu_name(s, am_nm);
        am_vn = terms.menu_version(s, am_ver);
        am_tn = terms.menu_text(s, am_txt);
        am_set = terms.menu_settings(s);
        am_set_off = terms.menu_settings_off(s);
        return;
    }
    if (kind[i] == SETTINGS) {         // AM-3: the desk's own window declares here
        U8[8] sn = [83, 101, 116, 116, 105, 110, 103, 115];                        // Settings
        U8[5] sv = [48, 46, 49, 46, 48];                                           // 0.1.0
        U8[53] st = [84, 104, 101, 32, 100, 101, 115, 107, 39, 115, 32, 115, 101, 116, 116, 105, 110, 103, 115, 58, 32,
                     100, 105, 115, 112, 108, 97, 121, 44, 32, 100, 101, 115, 107, 44, 32, 115, 111, 117, 110, 100, 32,
                     97, 110, 100, 32, 103, 114, 97, 110, 116, 115, 46];
        am_nn = 8;
        for k in 0..8 { am_nm[k] = sn[k]; }
        am_vn = 5;
        for k in 0..5 { am_ver[k] = sv[k]; }
        am_tn = 53;
        for k in 0..53 { am_txt[k] = st[k]; }
        return;
    }
    if (kind[i] != PIXEL) { return; }
    if (hdeskctl.tile_ask(FBIO_TILE_INFO, 8, pid[i], ask[0..64]) == 0) {
        if ((ask[4] & 1) != 0) { am_set = word_at(ask, 2); }
        am_set_off = (ask[4] & 2) != 0;    // kind 1 | 4 << 8 in the record: Settings declared dimmed
        am_nn = nul_len(ask, 16, 24);
        for k in 0..am_nn { am_nm[k] = ask[16 + k]; }
        am_vn = nul_len(ask, 40, 16);
        for k in 0..am_vn { am_ver[k] = ask[40 + k]; }
    }
    if (hdeskctl.tile_ask(FBIO_TILE_INFO, 10, pid[i], ask[0..64]) == 0) {
        am_tn = nul_len(ask, 4, 60);
        for k in 0..am_tn { am_txt[k] = ask[4 + k]; }
    }
}

// AM-4 (docs/specs/2026-11-11-am4-appitems.md section 4.3): a terminal's own rows (kit/appitems.ci) after Settings:
// row k on the menu has action APP + k and opens a submenu when row_opens; a child is a submenu row of action SUB + k
// under its parent's. Each row's id and whether a choice goes to the program are kept as the menu opens, so a row the
// program changes while the menu is open cannot redirect a choice.
I64 am_rows = 0;
I64[16] am_ids;
Bool[16] am_ok;

// AM-4 section 5 (kernel B's layout, 2026-11-12 09:13Z): a pixel window's rows, read one at a time with
// FBIO_TILE_INFO kind 15 + 256 k by its pid: byte 4 the count, 8 the u16 id, 10 the u16 parent, 12 the marks (1 divider,
// 2 dot, 4 dimmed), 13 and 14 the label's and the keys' lengths, 16 the label, 40 the keys. A kernel without the unit
// answers none, so the menu keeps About, Settings, Window and Exit.
I64[16] px_par;
I64[16] px_mk;
U8[384] px_lb;
I64[16] px_ln;
U8[256] px_kb;
I64[16] px_kn;

I64 px_find(I64 n, I64 id) {
    for j in 0..n {
        if (am_ids[j] == id) { return j; }
    }
    return -1;
}

void am_pixel(I64 f) {
    if (hdeskctl.tile_ask(FBIO_TILE_INFO, 15, pid[f], ask[0..64]) != 0) { return; }
    I64 n = min(ask[4] as I64, 16);
    I64 got = 0;
    Bool more = true;
    for k in 0..n {
        if (more && (k == 0 || hdeskctl.tile_ask(FBIO_TILE_INFO, 15 + 256 * k, pid[f], ask[0..64]) == 0)) {
            am_ids[k] = (ask[8] as I64) | ((ask[9] as I64) << 8);
            px_par[k] = (ask[10] as I64) | ((ask[11] as I64) << 8);
            px_mk[k] = ask[12] as I64;
            px_ln[k] = min(ask[13] as I64, 24);
            px_kn[k] = min(ask[14] as I64, 16);
            for q in 0..px_ln[k] { px_lb[24 * k + q] = ask[16 + q]; }
            for q in 0..px_kn[k] { px_kb[16 * k + q] = ask[40 + q]; }
            got = k + 1;
        } else {
            more = false;
        }
    }
    am_rows = got;
    for k in 0..got {
        Bool d = (px_mk[k] & 4) != 0;
        Bool opens = false;
        if (px_par[k] == 0 && !d) {
            for j in 0..got {
                if (px_par[j] == am_ids[k]) { opens = true; }
            }
        }
        I64 q = -1;
        if (px_par[k] != 0) { q = px_find(got, px_par[k]); }
        am_ok[k] = !d && !opens && (px_par[k] == 0 || (q >= 0 && (px_mk[q] & 4) == 0));
        U8[24] ilb;
        U8[16] ikb;
        I64 ln = px_ln[k];
        I64 kn = px_kn[k];
        for c in 0..ln { ilb[c] = px_lb[24 * k + c]; }
        for c in 0..kn { ikb[c] = px_kb[16 * k + c]; }
        Bool g = (px_mk[k] & 1) != 0;
        Bool o = (px_mk[k] & 2) != 0;
        Bool took = false;
        if (px_par[k] == 0) {
            took = ctxmenu.item_row(ilb[0..ln], ln, ikb[0..kn], kn, ctxmenu.APP + k, opens, g, o, d);
        } else if (q >= 0) {
            took = ctxmenu.item_sub(ctxmenu.APP + q, ilb[0..ln], ln, ikb[0..kn], kn, ctxmenu.SUB + k, g, o, !am_ok[k]);
        }
        if (!took) { am_ok[k] = false; }
    }
}

void am_items(I64 f) {
    am_rows = 0;
    if (kind[f] == PIXEL) {
        am_pixel(f);
        return;
    }
    if (kind[f] != TERM) { return; }
    I64 s = slot[f];
    am_rows = min(appitems.rows(s), 16);
    U8[24] ilb;
    U8[16] ikb;
    for k in 0..am_rows {
        am_ids[k] = appitems.row_id(s, k);
        am_ok[k] = appitems.row_chosen(s, k);
        I64 ln = min(appitems.row_label(s, k, ilb), 24);
        I64 kn = min(appitems.row_keys(s, k, ikb), 16);
        I64 mk = appitems.row_marks(s, k);
        Bool g = (mk & appitems.GROUP) != 0;
        Bool o = (mk & appitems.ON) != 0;
        Bool d = (mk & appitems.DIM) != 0;
        I64 p = appitems.row_parent(s, k);
        Bool took = false;
        if (p == 0) {
            took = ctxmenu.item_row(ilb[0..ln], ln, ikb[0..kn], kn, ctxmenu.APP + k, appitems.row_opens(s, k), g, o, d);
        } else {                       // under a dimmed parent nothing opens, so its children are not added
            I64 q = appitems.find(s, p);
            took = ctxmenu.item_sub(ctxmenu.APP + q, ilb[0..ln], ln, ikb[0..kn], kn, ctxmenu.SUB + k, g, o, !am_ok[k]);
        }
        if (!took) { am_ok[k] = false; }
    }
}

void app_open() {
    I64 f = focused();
    if (f < 0) { return; }
    am_win = f;
    am_declared(f);
    cal_open = false;
    sp_open = false;
    tr_open = false;
    mn_open = true;
    mn_app = true;
    qlen = 0;
    mn_sel = 0;
    ctxmenu.begin(ctxmenu.APP_MENU, false);
    if (am_nn > 0) { ctxmenu.about(am_nm[0..am_nn], am_nn); } else { ctxmenu.about(bar_now[0..bar_len], bar_len); }
    if (am_set >= 0) { ctxmenu.settings(am_set_off); }   // AM-2: the Settings item, when declared
    am_items(f);                                 // AM-4: the app's own rows
    if (wmode[f] == layout.FLOAT) {
        ctxmenu.current(ctxmenu.FLOATING);
    } else if (wmode[f] == layout.MONOCLE) {
        ctxmenu.current(ctxmenu.FULL_SCREEN);
    } else {
        ctxmenu.current(ctxmenu.TILED);
    }
    I64 z = am_z();
    ctxmenu.open_at(44 * sc / z, (bar_h() + 8 * sc) / z, 0, bar_h() / z, w / z, h / z, false);
    "hdesk: app menu open\n";
    relayout();
    redraw();
}

// AM-1: what the app menu answered: an action (the menu closed), STAY (drawn again) or CLOSE.
void am_answer(I64 a) {
    if (a == ctxmenu.STAY) {
        redraw_overlay();
        return;
    }
    mn_open = false;
    mn_app = false;
    ctxmenu.close();
    if (a == ctxmenu.CLOSE) {
        "hdesk: menu closed\n";
        relayout();
        redraw();
        return;
    }
    U8[64] t;
    I64 n = ctxmenu.label(a, t);
    "hdesk: app menu chose {a} |";
    I64 put = ptyctl.pty_write(1, t[0..n]);
    "|\n";
    I64 f = focused();
    relayout();
    if (f >= 0) {
        if (a == ctxmenu.TILED && wmode[f] != layout.TILED) {
            if (wmode[f] == layout.FLOAT) { chord(KEY_F, false, false); } else { chord(KEY_Z, false, false); }
        } else if (a == ctxmenu.FLOATING && wmode[f] != layout.FLOAT) {
            chord(KEY_F, false, false);
        } else if (a == ctxmenu.FULL_SCREEN && wmode[f] != layout.MONOCLE) {
            chord(KEY_Z, false, false);
        } else if (a == ctxmenu.MINIMIZE) {
            chord(KEY_M, false, false);
        } else if (a == ctxmenu.EXIT) {
            chord(KEY_Q, false, false);    // AM-1: today's terminate; the quit event first is AM-2's
        } else if (a == ctxmenu.ABOUT && f == am_win) {   // DN-43: the About sheet over the app's own window
            I64 z = am_z();
            U8[24] nm;
            I64 nn = am_nn;
            for k in 0..nn { nm[k] = am_nm[k]; }
            if (nn == 0) {
                nn = bar_len;
                if (nn > 24) { nn = 24; }
                for k in 0..nn { nm[k] = bar_now[k]; }
            }
            about.open(f, layout.frame_x(f) / z, layout.frame_y(f) / z, layout.frame_w(f) / z, layout.frame_h(f) / z,
                       win_icon3(f), nm, nn, am_ver, am_vn, am_txt, am_tn, am_by_key);
            "hdesk: about {f}\n";
        } else if (a == ctxmenu.APP_SETTINGS && f == am_win && am_set >= 0 && !am_set_off) {   // AM-2: the program's own Settings
            if (kind[f] == TERM) {
                U8[32] o;
                I64 on = put_text(o, 0, b"\x1b]7770;chose;");
                on = digits(o, on, am_set);
                o[on] = 7;
                I64 wr = ptyctl.pty_write(master[f], o[0..on + 1]);
            } else {
                forward(EV_MENU, am_set, 1);
            }
            "hdesk: app menu settings {f} id {am_set}\n";
        } else if (a >= ctxmenu.APP && a < ctxmenu.SUB + 16 && f == am_win && (kind[f] == TERM || kind[f] == PIXEL)) {
            I64 k = a - ctxmenu.APP;   // AM-4: own row; a pixel program has it as EV_MENU with the row's id
            if (a >= ctxmenu.SUB) { k = a - ctxmenu.SUB; }
            if (k < am_rows && am_ok[k]) {
                if (kind[f] == TERM) {
                    U8[32] o;
                    I64 on = put_text(o, 0, b"\x1b]7770;chose;");
                    on = digits(o, on, am_ids[k]);
                    o[on] = 7;
                    I64 wr = ptyctl.pty_write(master[f], o[0..on + 1]);
                } else {
                    forward(EV_MENU, am_ids[k], 1);
                }
                "hdesk: app menu item {f} id {am_ids[k]}\n";
            }
        }
    }
    redraw();
}

void menu_close() {
    mn_open = false;
    mn_app = false;
    "hdesk: menu closed\n";
    redraw_overlay();
}

// --- the system panel (SP-1, docs/specs/2026-11-08-sp-system-panel.md, section 4) ---

// The audio and network record (FBIO_TILE_INFO kind 5) into au_*; au_fl 0 when the tiler gives none. P2-c: the desk
// reads it at start too, so the Sound page and the Volume row know the device before the panel has opened.
I64 au_read() {
    for k in 0..16 { au_comm[k] = 0; }
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 5, 0, ask[0..64]);
    if (st != 0) {
        au_fl = 0;
        return st;
    }
    au_fl = word_at(ask, 0);
    au_lv = word_at(ask, 1);
    au_vp = word_at(ask, 2);
    au_n = word_at(ask, 3);
    au_ip = word_at(ask, 4);
    for k in 0..16 { au_comm[k] = ask[32 + k]; }
    return 0;
}

// The panel's record again, and its line.
void sp_read() {
    gr_list();                  // DN-6 frame 9: the panel's grant rows
    if (au_read() != 0) { return; }
    I64 cn = 0;
    while (cn < 16 && au_comm[cn] != 0) { cn = cn + 1; }
    "hdesk: panel audio {au_fl & 1} level {au_lv} player {au_vp} |";
    I64 put = ptyctl.pty_write(1, au_comm[0..cn]);
    I64 an = 0;
    if (anim_on) { an = 1; }
    "| streams {au_n} net {(au_fl >> 1) & 1} animations {an}\n";
}

void sp_show() {
    if (sw_open || kp_open) { return; }
    mn_open = false;
    mn_app = false;
    cal_open = false;
    sp_open = true;
    "hdesk: panel open\n";
    sp_read();
    bar(false);
    redraw_overlay();
}

void sp_close() {
    sp_open = false;
    tr_open = false;
    "hdesk: panel closed\n";
    bar(false);
    redraw_overlay();
}

// The mix's level to l, kept to 0..100 (FBIO_TILE_AUDIO); nothing with no audio device.
void sp_volume(I64 l) {
    if ((au_fl & 1) == 0) { return; }
    I64 v = l;
    if (v < 0) { v = 0; }
    if (v > 100) { v = 100; }
    I64 st = hdeskctl.tile_ask(FBIO_TILE_AUDIO, v, 0, ask[0..64]);
    "hdesk: volume {v} ({st})\n";
    sp_read();
    redraw_overlay();
}

// DN-6 frame 9: the grant rows the panel lists, a window and one grant bit each (ring 0, disk, network), at most 8.
I64[8] gr_win;
I64[8] gr_bit;
I64 gr_n = 0;

void gr_list() {
    gr_n = 0;
    for i in 0..WINDOWS {
        if (listed(i)) {
            for b in 0..3 {
                I64 bit = 2;
                if (b == 0) { bit = GRANT_KERN; }
                if (b == 1) { bit = 1; }
                if ((gw[i] & bit) != 0 && gr_n < 8) {
                    gr_win[gr_n] = i;
                    gr_bit[gr_n] = bit;
                    "hdesk: panel grant {gr_n} window {i} bit {bit} |";
                    I64 put = ptyctl.pty_write(1, title[16 * i..16 * i + title_len(i)]);
                    "|\n";
                    gr_n = gr_n + 1;
                }
            }
        }
    }
}

// The panel's height at 1x: 330 and 40 a grant row, one row (None active) at least (DN-24: NOW PLAYING's 76).
I64 sp_h() {
    return 346;                        // DN-34: the Grants pill in place of the list: NOW PLAYING at 68, and 278 more
}

// A click in the panel (its 1x layout, panel_at): on the volume's slider sets the level where it lands, on the
// theme's segments picks Dark or Light; the Grants pill opens Settings on Grants (DN-34). Wi-Fi and Bluetooth are inert
// (SP-R2 B).
void sp_click() {
    I64 lx = (mx - layout.frame_x(OV)) / sc;
    I64 ly = (my - layout.frame_y(OV)) / sc;
    I64 at = sp_hit(lx, ly, txt_w(b"Sound Settings", 14, faces.SMALL) + 14);
    if (at == 1) {                     // DN-34: the Grants pill opens Settings on Grants
        "hdesk: panel grants\n";
        sp_close();
        settings_open(false);
        st_show(stside.GRANTS);
        redraw();
        return;
    }
    if (at == 2) {
        "hdesk: panel sound settings\n";
        sp_close();
        settings_open(false);
        st_show(stside.SOUND);         // the Sound page
        redraw();
        return;
    }
    if (at == 3) {
        sp_volume(((lx - 26) * 100 + 126) / 252);
        return;
    }
    if (at == 4) {
        I64 t = tokens.DARK;
        if (lx >= SP_W / 2) { t = tokens.LIGHT; }
        if (t != tokens.theme()) { theme_set(t); }
    }
}

// DN-34: what a click at (lx, ly) in the panel's 1x layout lands on: 1 the Grants pill, 2 the Sound Settings link (lw
// its width with the chevron), 3 the volume's slider, 4 the theme's segments, 0 nothing that acts.
I64 sp_hit(I64 lx, I64 ly, I64 lw) {
    if (lx < 16 || lx >= SP_W - 16) { return 0; }
    if (ly >= 16 && ly < 48) { return 1; }
    if (ly >= 66 && ly < 86 && lx >= SP_W - 16 - lw) { return 2; }
    if (ly >= 170 && ly < 190) { return 3; }
    if (ly >= 234 && ly < 266) { return 4; }
    return 0;
}

// DN-34: how many windows hold a grant (the pill's apps): gr_win's distinct windows.
I64 grant_apps() {
    I64 n = 0;
    for k in 0..gr_n {
        Bool seen = false;
        for j in 0..k {
            if (gr_win[j] == gr_win[k]) { seen = true; }
        }
        if (!seen) { n = n + 1; }
    }
    return n;
}

// The grant list's rows from the desk's state (grant_rows'); their count.
I64 grants_of(inout I64[8] gt, inout U8[_] nm, inout I64[8] nl) {
    for k in 0..gr_n {
        I64 i = gr_win[k];
        nl[k] = title_len(i);
        for q in 0..nl[k] { nm[16 * k + q] = title[16 * i + q]; }
        gt[k] = gr_bit[k];
    }
    return gr_n;
}

// The panel's row y at 1x (panel_at with the desk's state).
void panel_row(I64 x0, I64 y0, I64 y) {
    I64 lv = -1;
    if ((au_fl & 1) != 0) { lv = au_lv; }
    I64 cn = 0;
    while (cn < 16 && au_comm[cn] != 0) { cn = cn + 1; }
    I64 np = 0 - 1;                    // DN-24: no device
    if ((au_fl & 1) != 0) { np = 0; }
    if ((au_fl & 1) != 0 && au_vp > 0) { np = 1; }
    U8[24] bp;
    I64 bn = put_text(bp, 0, b"/bin/");
    for q in 0..cn { bp[bn + q] = au_comm[q]; }
    I64 ai = apps.by_program(bp[0..bn + cn]);
    I64 ic = icons3.PROGRAM;
    if (ai >= 0) { ic = apps.icon(ai); }
    U8[24] pd;
    I64 pn = digits(pd, put_text(pd, 0, b"pid "), au_vp);
    panel_at(x0, y0, grant_apps(), lv, tokens.theme(), np, au_comm[0..cn], ic, pd[0..pn], 0, y);   // AU-6: no controls
}

// DN-34: the Grants pill's count of n apps: `None`, `1 app`, `N apps`.
I64 grants_text(I64 n, inout U8[_] t) {
    if (n <= 0) { return put_text(t, 0, b"None"); }
    I64 k = digits(t, 0, n);
    if (n == 1) { return put_text(t, k, b" app"); }
    return put_text(t, k, b" apps");
}

// DN-34: the per-app grant list, as the panel drew it before the pill (DN-6 frame 9; its layout waits on the design):
// from x0 to x1 and y0 at 1x, n pill rows 32 px high, 8 px apart, an 8 px dot in the grant's color, the window's
// name, the kind at the right; none: one row, None active.
void grant_rows(I64 x0, I64 x1, I64 y0, I64 n, in I64[8] gt, in U8[_] nm, in I64[8] nl, I64 y) {
    I64 e = 0;
    I64 k = n;
    if (k < 1) { k = 1; }
    for r in 0..k {
        I64 ry = y0 + 40 * r;
        if (y >= ry && y < ry + 32) {
            pen.round(row, x0, ry, x1, ry + 32, 16, tok(tokens.PAPER));
            if (n == 0) {
                e = ptxt(x0 + 12, ry + 8, x1 - 12, b"None active", 11, tok(tokens.INK_DIM), faces.BODY);
            } else {
                I64 c = tokens.SIENNA;
                if (gt[r] == 1) { c = tokens.OCHRE; }
                if (gt[r] == 8) { c = tokens.CADMIUM; }
                pen.round(row, x0 + 12, ry + 12, x0 + 20, ry + 20, 4, tok(c));
                U8[16] t;
                for q in 0..nl[r] { t[q] = nm[16 * r + q]; }
                if (gt[r] == 2) {
                    e = pen.text_right(row, x1 - 12, ry + 8 + TBASE, b"Network", 7, tok(tokens.INK_DIM), faces.BODY);
                } else if (gt[r] == 1) {
                    e = pen.text_right(row, x1 - 12, ry + 8 + TBASE, b"Disk", 4, tok(tokens.INK_DIM), faces.BODY);
                } else {
                    e = pen.text_right(row, x1 - 12, ry + 8 + TBASE, b"Ring 0", 6, tok(tokens.INK_DIM), faces.BODY);
                }
                e = ptxt(x0 + 30, ry + 8, x1 - 80, t, nl[r], tok(tokens.INK), faces.NAME);
            }
        }
    }
}

// DN-6 frame 9 (design notes 6 and 24): the system panel's row y at 1x from (x0, y0), SP_W wide, on SURF2 (the OV
// window's ground), 16 px in, sections 20 px apart: DN-34's Grants pill (32 px, radius 16, PAPER, padding 0 10 0 12,
// gaps 10: the 16 px key symbol, `Grants` in NAME, n apps at the right in INK_DIM (grants_text), the 12 px forward
// chevron; a click opens Settings on Grants, where the per-app list went); NOW PLAYING (DN-24) with
// `Sound Settings` and a 10 px chevron at the right of its label (DN-25: a click opens Settings' Sound page), over a
// 32 px PAPER pill: np 1, the player's 16 px icon ic, its name pn in NAME and its pid pd in PATH INK_DIM, and the
// transport buttons ctl offers (bit 0 previous, bit 1 play or pause, bit 2 next, bit 3 playing: pause shown) at the
// right; np 0 `Nothing playing`, np -1 `Not available`, dim, alone; VOLUME over a 20 px pill slider,
// its fill ULTRAMARINE and a 16 px ON_FILL knob at level lv (lv < 0, no audio device: the track alone and Not
// available); THEME over a 32 px segmented pill (seg_at) on theme th; Wi-Fi and Bluetooth, dim, Not available.
// Labels in LABEL; the grant rows and the track on PAPER. The plate's corners are corners_at's (radius 12).
void panel_at(I64 x0, I64 y0, I64 n, I64 lv, I64 th, I64 np, in U8[_] pn, I64 ic, in U8[_] pd, I64 ctl, I64 y) {
    I64 x1 = x0 + SP_W;
    I64 e = 0;
    if (y >= y0 + 16 && y < y0 + 48) {             // DN-34 (frame 9): the Grants pill
        pen.round(row, x0 + 16, y0 + 16, x1 - 16, y0 + 48, 16, tok(tokens.PAPER));
        symbols.row_at(row, pen.row_y(), pen.x(x0 + 28), pen.y(y0 + 24), symbols.KEY, pen.zoom(), tok(tokens.INK), th,
                       256);
        U8[16] t;
        I64 tn = grants_text(n, t);
        I64 tw = txt_w(t, tn, faces.BODY);
        e = ptxt(x0 + 54, y0 + 24, x1 - 58 - tw, b"Grants", 6, tok(tokens.INK), faces.NAME);
        e = pen.text_right(row, x1 - 48, y0 + 24 + TBASE, t, tn, tok(tokens.INK_DIM), faces.BODY);
        glyph_at(y, x1 - 32, y0 + 32, 5, tok(tokens.INK_DIM));
    }
    I64 ny = y0 + 68;                               // DN-24: NOW PLAYING
    e = ptxt(x0 + 16, ny, x1 - 16, b"NOW PLAYING", 11, tok(tokens.INK_DIM), faces.LABEL);
    // right aligned at the pen's own zoom: a width measured at 1x clipped the last glyph at 2x
    e = pen.text_right(row, x1 - 30, ny + 1 + TBASE, b"Sound Settings", 14, tok(tokens.INK_DIM), faces.SMALL);
    if (y >= ny + 3 && y < ny + 13) { glyph_at(y, x1 - 21, ny + 8, 4, tok(tokens.INK_DIM)); }   // the 10 px chevron
    I64 py = ny + 24;
    if (y >= py && y < py + 32) {
        pen.round(row, x0 + 16, py, x1 - 16, py + 32, 16, tok(tokens.PAPER));
        if (np < 1) {
            if (np == 0) {
                e = ptxt(x0 + 28, py + 8, x1 - 28, b"Nothing playing", 15, tok(tokens.INK_DIM), faces.BODY);
            } else {
                e = ptxt(x0 + 28, py + 8, x1 - 28, b"Not available", 13, tok(tokens.INK_DIM), faces.BODY);
            }
        } else {
            if (y >= py + 8 && y < py + 24) {
                icons3.icon_at(row, pen.row_y(), pen.x(x0 + 28), pen.y(py + 8), ic, 16, pen.zoom(), tok(tokens.PAPER));
            }
            I64 bx = x1 - 20;
            if ((ctl & 4) != 0) { bx = bx - 24; }
            if ((ctl & 2) != 0) { bx = bx - 24; }
            if ((ctl & 1) != 0) { bx = bx - 24; }
            I64 tx = ptxt(x0 + 52, py + 8, bx - 8, pn, len(pn), tok(tokens.INK), faces.NAME);
            e = ptxt(x0 + 60 + txt_w(pn, len(pn), faces.NAME), py + 9, bx - 8, pd, len(pd), tok(tokens.INK_DIM),
                     faces.PATH);
            if ((ctl & 1) != 0) {
                glyph_at(y, bx + 12, py + 16, 0, tok(tokens.INK));
                bx = bx + 24;
            }
            if ((ctl & 2) != 0) {
                pen.round(row, bx, py + 4, bx + 24, py + 28, 12, tok(tokens.FILL));
                I64 g = 2;
                if ((ctl & 8) != 0) { g = 1; }
                glyph_at(y, bx + 12, py + 16, g, tok(tokens.ON_FILL));
                bx = bx + 24;
            }
            if ((ctl & 4) != 0) { glyph_at(y, bx + 12, py + 16, 3, tok(tokens.INK)); }
        }
    }
    I64 vy = ny + 76;
    I64 vt = tokens.INK_DIM;
    e = ptxt(x0 + 16, vy, x1 - 16, b"VOLUME", 6, tok(vt), faces.LABEL);
    if (lv < 0) {
        e = pen.text_right(row, x1 - 16, vy + TBASE, b"Not available", 13, tok(tokens.INK_DIM), faces.BODY);
    }
    if (y >= vy + 26 && y < vy + 46) {
        pen.round(row, x0 + 16, vy + 26, x1 - 16, vy + 46, 10, tok(tokens.PAPER));
        if (lv >= 0) {
            I64 fw = 20 + (SP_W - 52) * lv / 100;
            pen.round(row, x0 + 16, vy + 26, x0 + 16 + fw, vy + 46, 10, tok(tokens.ULTRAMARINE));
            pen.round(row, x0 + fw - 2, vy + 28, x0 + fw + 14, vy + 44, 8, tok(tokens.ON_FILL));
        }
    }
    I64 ty = vy + 66;
    e = ptxt(x0 + 16, ty, x1 - 16, b"THEME", 5, tok(tokens.INK_DIM), faces.LABEL);
    if (y >= ty + 24 && y < ty + 56) { seg_at(x0 + 16, ty + 24, SP_W - 32, b"Dark|Light", 2, th); }
    I64 wy = ty + 76;
    e = ptxt(x0 + 16, wy, x1 - 16, b"Wi-Fi", 5, tok(tokens.INK_DIM), faces.BODY);
    e = pen.text_right(row, x1 - 16, wy + TBASE, b"Not available", 13, tok(tokens.INK_DIM), faces.BODY);
    e = ptxt(x0 + 16, wy + 28, x1 - 16, b"Bluetooth", 9, tok(tokens.INK_DIM), faces.BODY);
    e = pen.text_right(row, x1 - 16, wy + 28 + TBASE, b"Not available", 13, tok(tokens.INK_DIM), faces.BODY);
}

// DN-24: the transport's glyphs and the link's chevron, each in a 12 px box centered on (cx, cy) of row y, stroked
// 1.5 px with round caps and joins, no fill, 4 x 4 samples a pixel, at the pen's zoom (as chevron): 0 previous
// (M9.5 2.5L4.5 6L9.5 9.5Z, M2.5 2.5V9.5), 1 pause (M4.25 2.5V9.5, M7.75 2.5V9.5), 2 play (M4 2.5L9.5 6L4 9.5Z),
// 3 next (M2.5 2.5L7.5 6L2.5 9.5Z, M9.5 2.5V9.5), 4 the link's 10 px right chevron (M4 2L8 6L4 10 in a 12 box,
// scaled 10/12: M3.5 2.5L6.5 6L3.5 9.5). Segments in eighths of a pixel from the box's center.
I64[64] GLYPH_SEG = [28, -28, -12, 0, -12, 0, 28, 28, 28, 28, 28, -28, -28, -28, -28, 28,
                     -14, -28, -14, 28, 14, -28, 14, 28, 0, 0, 0, 0, 0, 0, 0, 0,
                     -16, -28, 28, 0, 28, 0, -16, 28, -16, 28, -16, -28, 0, 0, 0, 0,
                     -28, -28, 12, 0, 12, 0, -28, 28, -28, 28, -28, -28, 28, -28, 28, 28];
I64[5] GLYPH_N = [4, 2, 3, 4, 2];

void glyph_at(I64 y, I64 cx, I64 cy, I64 gk, U32 ink) {
    if (y < cy - 6 || y >= cy + 6) { return; }
    U32[1] ic;
    ic[0] = ink;
    I64 z = pen.zoom();
    I64 ox = pen.x(cx);
    I64 oy = pen.y(cy);
    for px in pen.x(cx - 6)..pen.x(cx + 6) {
        I64 cov = 0;
        for s in 0..4 {
            for t in 0..4 {
                I64 u = 8 * (px - ox) + 2 * s + 1 - 4 * z;
                I64 v = 8 * (pen.row_y() - oy) + 2 * t + 1 - 4 * z;
                Bool hit = false;
                if (gk == 4) {
                    hit = seg_d2(u, v, -20 * z, -28 * z, 4 * z, 0) <= 36 * z * z ||
                          seg_d2(u, v, 4 * z, 0, -20 * z, 28 * z) <= 36 * z * z;
                } else if (gk == 5) {          // DN-34: the Grants pill's 12 px forward chevron, M4 2L8 6L4 10
                    hit = seg_d2(u, v, -16 * z, -32 * z, 16 * z, 0) <= 36 * z * z ||
                          seg_d2(u, v, 16 * z, 0, -16 * z, 32 * z) <= 36 * z * z;
                } else {
                    for q in 0..GLYPH_N[gk] {
                        I64 b = 16 * gk + 4 * q;
                        if (seg_d2(u, v, GLYPH_SEG[b] * z, GLYPH_SEG[b + 1] * z, GLYPH_SEG[b + 2] * z,
                                   GLYPH_SEG[b + 3] * z) <= 36 * z * z) { hit = true; }
                    }
                }
                if (hit) { cov = cov + 1; }
            }
        }
        if (cov > 0) {
            I64 c = 0;
            for ch in 0..3 {
                I64 o = (cov * chan(ic, 0, ch) + (16 - cov) * chan(row, px, ch) + 8) / 16;
                c = c | (o << (8 * ch));
            }
            draw.put(row, px, c as U32);
        }
    }
}

// DN-6, DN-10: a segmented pill 32 px high and wd wide at 1x from (x0, y0) through the pen: a MANTLE track of
// radius 16, n segments 2 px in, labs their labels separated by `|`; segment sel FILL, radius 14, its label in
// NAME on ON_FILL, the others in BODY, INK_DIM.
void seg_at(I64 x0, I64 y0, I64 wd, in U8[_] labs, I64 n, I64 sel) {
    pen.round(row, x0, y0, x0 + wd, y0 + 32, 16, tok(tokens.MANTLE));
    I64 sw = (wd - 4) / n;
    I64 at = 0;
    for k in 0..n {
        I64 b = at;
        while (b < len(labs) && labs[b] != '|') { b = b + 1; }
        U8[24] t;
        for q in at..b { t[q - at] = labs[q]; }
        I64 sx = x0 + 2 + sw * k;
        I64 e = 0;
        if (k == sel) {
            pen.round(row, sx, y0 + 2, sx + sw, y0 + 30, 14, tok(tokens.FILL));
            e = ptxt_mid(sx, sw, y0 + 8, sx + sw, t, b - at, tok(tokens.ON_FILL), faces.NAME);
        } else {
            e = ptxt_mid(sx, sw, y0 + 8, sx + sw, t, b - at, tok(tokens.INK_DIM), faces.BODY);
        }
        at = b + 1;
    }
}

// DN-6 frame 9: the bar message, one sentence on a 320 x 36 pill of radius 18 (the OV window, SURF1), centered 12
// px under the bar; it holds MSG_HOLD_MS (DN-11: 4 s), or MSG_HOLD_MS / 10 stepped frames, then goes.
Bool msg_on = false;
U8[64] msg_text;
I64 msg_len = 0;
I64 msg_t0 = 0;
I64 msg_k = 0;

void msg_show(in U8[_] t) {
    msg_len = len(t);
    if (msg_len > 64) { msg_len = 64; }
    for k in 0..msg_len { msg_text[k] = t[k]; }
    msg_on = true;
    msg_t0 = wall.wall_ns();
    msg_k = 0;
    "hdesk: message |";
    I64 put = ptyctl.pty_write(1, msg_text[0..msg_len]);
    "|\n";
    redraw_overlay();
}

void msg_tick(Bool step) {
    if (!msg_on) { return; }
    if (step) { msg_k = msg_k + 1; }
    if ((stepped && msg_k * 10 >= MSG_HOLD_MS) || (!stepped && wall.wall_ns() - msg_t0 >= MSG_HOLD_MS * 1000000)) {
        msg_on = false;
        "hdesk: message gone\n";
        redraw_overlay();
    }
}

// The message's row y at 1x from (x0, y0): a 6 px INK dot and the sentence in NAME, centered together.
void msg_at(I64 x0, I64 y0, in U8[_] t, I64 n, I64 y) {
    I64 tw = pen.width(t, n, faces.NAME);
    I64 z = pen.zoom();
    I64 dx = pen.x(x0) + (MSG_W * z - (16 * z + tw)) / 2;
    if (y >= y0 + 15 && y < y0 + 21) {
        shape.rounded(row, pen.row_y(), dx, pen.y(y0 + 15), dx + 6 * z, pen.y(y0 + 21), 3 * z, tok(tokens.INK));
    }
    I64 e = ctext.text(row, pen.row_y(), dx + 16 * z, pen.y(y0 + 10 + TBASE), pen.x(x0 + MSG_W - 16), t, n,
                       tok(tokens.INK), faces.NAME, z);
}

// --- the tray (SP-2, SP-R3 A) and the chevron's turn (SP-3, SP-R5 A) ---

// SP-6 (DN-16): a window is in the tray while its program asks for it (bit 32), or while it is minimized there because
// its program asked that it minimize to the tray (bit 33) and it has not been restored.
Bool tray_member(Bool ask_now, Bool min_to_tray, Bool in_tray) { return ask_now || (min_to_tray && in_tray); }

// SP-6: the cells' order: the k-th of the windows in the tray by when each came in (tr_seq), oldest first; -1 none.
I64 tray_order(in Bool[16] member, in I64[16] seq, I64 k) {
    I64 last = 0;
    I64 at = -1;
    for c in 0..k + 1 {
        at = -1;
        for i in 0..16 {
            if (member[i] && seq[i] > last && (at < 0 || seq[i] < seq[at])) { at = i; }
        }
        if (at < 0) { return -1; }
        last = seq[at];
    }
    return at;
}

// Each window's ask against what the desk last did with it: a new ask hides the window in the tray, a dropped one
// (the program left the tray, or a process without the ask came to the terminal's foreground) gives it back.
Bool tray_scan() {
    Bool changed = false;
    I64 n = 0;
    for i in 0..WINDOWS {
        Bool a = listed(i) && tray_member(wask[i], wmin[i], tin[i]);   // SP-6
        if (a && !wtray[i]) {
            tin[i] = true;
            tr_seq_n = tr_seq_n + 1;
            tr_seq[i] = tr_seq_n;          // SP-6: the cells keep the order the windows came in
            "hdesk: tray {i} in\n";
            changed = true;
        }
        if (!a && wtray[i]) {
            tin[i] = false;
            "hdesk: tray {i} out\n";
            changed = true;
        }
        wtray[i] = a;
        if (a) { n = n + 1; }
    }
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 12, 0, ask[0..64]);   // SP-7: the downloads
    if (st == 0) {
        dl_s = word_at(ask, 0);
        dl_d = word_at(ask, 1);
    }
    Bool d = dl_s > dl_bs || dl_d > dl_bd;
    if (d && !dl_on) {
        tr_seq_n = tr_seq_n + 1;
        dl_seq = tr_seq_n;             // design note 20: tray entries by arrival
        "hdesk: tray downloads in\n";
        changed = true;
    }
    if (!d && dl_on) {
        "hdesk: tray downloads out\n";
        changed = true;
    }
    dl_on = d;
    if (d) { n = n + 1; }
    n_tray = n;
    if (n_tray == 0) {
        tr_open = false;               // the last resident window went: the chevron points down, dim (DN-14)
        turn_to = 0;
        turn = 0;
        tr_an = anim.rest(0);
        tr_sel = 0 - 1;
        tr_hov = 0 - 1;
    }
    return changed;
}

// FBIO_TILE_SYNC 10 (FF-6c, FF-R8 A): a window's program (Finder) asked the desk to open a file: the path read by
// FBIO_TILE_INFO kind 7, 56 bytes a read, and opened as the plane opens one (pl_path) when the asking process is a
// pixel window's (`hdesk: open |PATH| window I`), else refused (`hdesk: open refused pid P`). A path that is empty or
// holds a control byte or DEL is refused before any use, by a line with no program byte (AC-R1, plane.asked_path_ok).
void open_event() {
    U8[256] p;
    I64 n = 0;
    I64 from = 0;
    I64 total = 1;
    while (n < total) {
        I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 7, n, ask[0..64]);
        if (st != 1) { return; }
        from = word_at(ask, 0);
        total = word_at(ask, 1);
        if (total < 1 || total > 256) { return; }
        I64 c = total - n;
        if (c > 56) { c = 56; }
        for k in 0..c { p[n + k] = ask[8 + k]; }
        n = n + c;
    }
    I64 win = -1;
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL && info(i) && vpid[i] == from) { win = i; }
    }
    if (win < 0) {
        "hdesk: open refused pid {from}\n";
        return;
    }
    if (n > 1 && (p[0] == 1 || p[0] == 2) && n - 1 > plane.TEXT) {
        "hdesk: taskbar refused, {n - 1} bytes, window {win}\n";   // P1: longer than a pin holds; no program byte
        return;
    }
    if (n > 1 && (p[0] == 1 || p[0] == 2) && !plane.asked_path_ok(p[1..n])) {
        "hdesk: taskbar refused, control byte, window {win}\n";    // AC-R1: no program byte
        return;
    }
    if (n > 1 && (p[0] == 1 || p[0] == 2)) {   // DN-46 (c): Index's Pin to Taskbar (1) or Unpin (2), provisional
        Bool want = p[0] == 1;
        Bool on = plane.on_taskbar(p[1..n]);
        if (on != want) {
            I64[16] st;
            Bool dir = corectl.co_stat(p[1..n], 1, st) == 0 && is_dir(st[corectl.ST_MODE]);
            on = plane.taskbar_toggle(p[1..n], dir);
        }
        "hdesk: taskbar {on as I64} |";
        I64 tp = ptyctl.pty_write(1, p[1..n]);
        "| window {win}\n";
        pins_tell_all();
        bar(true);
        if (pl_open) { pl_show(); }
        return;
    }
    if (!plane.asked_path_ok(p[0..n])) {
        "hdesk: open refused, control byte, window {win}\n";       // AC-R1: no program byte
        return;
    }
    "hdesk: open |";
    I64 put = ptyctl.pty_write(1, p[0..n]);
    "| window {win}\n";
    pl_path(p[0..n], -1);
}

// FBIO_TILE_SYNC 7: a program asked for the tray or left it.
void tray_event() {
    Bool g = grants();
    Bool c = tray_scan();
    if (c && pl_open) { pl_machine(); }
    bar(false);
    if (c || g) { redraw(); }
}

// DN-14: the chevron toward turn_to over TURN_MS on MS-2's out curve, at once with animations off; its clock is
// CLOCK_BOOTTIME, or on the gates' stepped clock a 10 ms step a Shift press.
I64 tr_now() {
    if (stepped) { return anim.steps(tr_steps); }
    return wall.wall_ns();
}

void turn_start() {
    tr_an = anim.toward(tr_an, tr_now(), turn_to, anim.ms(TURN_MS), anim.OUT, anim_on);
    tr_k = 0;
    turn = anim.value(tr_an, tr_now());
    tray_line();
}

// Whether the turn still runs: its 160 ms not yet over (16 stepped frames, the last at the end angle).
Bool tr_moving() { return anim.running(tr_an, tr_now()); }

// The turn's next frame: `hdesk: turn step K angle A`.
void turn_step() {
    turn = anim.value(tr_an, tr_now());
    tr_k = tr_k + 1;
    "hdesk: turn step {tr_k} angle {turn}\n";
    tray_line();
    paint_bar();
}

void tray_show() {
    if (sw_open || kp_open || n_tray == 0) { return; }
    mn_open = false;
    mn_app = false;
    cal_open = false;
    sp_open = false;
    tr_open = true;
    turn_to = TURN;
    tr_sel = 0 - 1;
    tr_hov = 0 - 1;
    "hdesk: tray open {n_tray}\n";
    U8[96] t;
    for k in 0..n_tray {
        I64 i = tray_item(k);
        if (i == DL_ITEM) {
            I64 dn = dl_text(dl_d - dl_bd, t);
            "hdesk: tray row {k} downloads |";
            I64 dput = ptyctl.pty_write(1, t[0..dn]);
            "|\n";
            I64 fi3 = prog_icon3(b"fetch");
            "hdesk: tray icon {k} {fi3}\n";
            continue;
        }
        Bool got = info(i);
        I64 n = tray_text(i, t);
        "hdesk: tray row {k} window {i} ring {ring_of(gw[i])} |";
        I64 put = ptyctl.pty_write(1, t[0..n]);
        "|\n";
        "hdesk: tray icon {k} {win_icon3(i)}\n";   // DN-15: the cell's icon (the twin draws it)
    }
    turn_start();
    bar(true);
    redraw_overlay();
}

void tray_close() {
    tip_off();
    tr_open = false;
    turn_to = 0;
    "hdesk: tray closed\n";
    turn_start();
    bar(true);
    redraw_overlay();
}

// The tray's k-th resident window, in window order, or -1.
I64 tray_at(I64 k) { return tray_order(wtray, tr_seq, k); }   // SP-6: in the order they came

// SP-7: the tray's k-th entry, windows and Downloads by arrival: a window's number, DL_ITEM, or -1.
I64 tray_item(I64 k) {
    if (!dl_on) { return tray_at(k); }
    I64 before = 0;
    for i in 0..16 {
        if (wtray[i] && tr_seq[i] < dl_seq) { before = before + 1; }
    }
    return tray_slot(k, before, tray_at(k), tray_at(k - 1));
}

// The k-th entry with Downloads after `before` windows: the k-th window (at_k) before it, DL_ITEM at it, the
// (k - 1)-th (at_k1) after it.
I64 tray_slot(I64 k, I64 before, I64 at_k, I64 at_k1) {
    if (k < before) { return at_k; }
    if (k == before) { return DL_ITEM; }
    return at_k1;
}

// SP-7: the entry's tooltip text: "Fetch" before a download finished since the last click, else the count.
I64 dl_text(I64 done, inout U8[_] t) {
    if (done <= 0) { return put_text(t, 0, b"Fetch"); }
    I64 n = digits(t, 0, done);
    if (done == 1) { return put_text(t, n, b" download finished"); }
    return put_text(t, n, b" downloads finished");
}

// DN-15: the plate's size at 1x: 4 px padding round a grid 5 across of 32 px cells, no gap.
I64 tr_pw() { return 8 + 32 * min(max(n_tray, 1), 5); }
I64 tr_ph() { return 8 + 32 * ((max(n_tray, 1) + 4) / 5); }

// The cell under the pointer on the open plate, or -1.
I64 tray_cell() {
    I64 lx = (mx - layout.frame_x(OV)) / sc - 4;
    I64 ly = (my - layout.frame_y(OV)) / sc - 4;
    if (lx < 0 || ly < 0 || lx >= 32 * 5 || ly >= tr_ph() - 8) { return 0 - 1; }
    I64 k = (ly / 32) * 5 + lx / 32;
    if (lx / 32 >= min(n_tray, 5) || k >= n_tray) { return 0 - 1; }
    return k;
}

// The pointer moved over the open plate: its cell under the pointer, SURF1 (`hdesk: tray hover K`).
void tray_hover() {
    I64 k = tray_cell();
    if (k == tr_hov) { return; }
    tr_hov = k;
    "hdesk: tray hover {k}\n";
    tip_off();
    if (k >= 0 && tray_item(k) == DL_ITEM) {   // SP-7: the tooltip after 400 ms on the entry
        tip_wait = true;
        tip_t0 = tip_now();
    }
    redraw_overlay();
}

// SP-7: the tooltip's clock: the wall, or on the gates' stepped clock 10 ms a Shift press.
I64 tip_now() {
    if (stepped) { return anim.steps(tip_steps); }
    return wall.wall_ns();
}

void tip_off() {
    tip_wait = false;
    tip_on = false;
}

// The tooltip up under the hovered cell (`hdesk: tray tip |TEXT|`), kept on the screen.
void tip_show() {
    tip_wait = false;
    if (!tr_open || tr_hov < 0) { return; }
    tip_n = dl_text(dl_d - dl_bd, tip_t);
    tip_w = tooltip.width(tip_t, tip_n, sc);
    tip_x = layout.frame_x(OV) + (4 + 32 * (tr_hov % 5)) * sc;
    tip_y = layout.frame_y(OV) + (4 + 32 * (tr_hov / 5) + 32 + TIP_GAP) * sc;
    if (tip_x + tip_w > w - 8 * sc) { tip_x = w - 8 * sc - tip_w; }
    tip_on = true;
    "hdesk: tray tip |";
    I64 put = ptyctl.pty_write(1, tip_t[0..tip_n]);
    "| at {tip_x},{tip_y} {tip_w}x{tooltip.H * sc}\n";
    redraw_overlay();
}

// Row y of the tooltip over what is there (DN-44: kit/tooltip.ci, the same plate in both themes).
void tip_row(I64 y) {
    if (tip_on) { tooltip.row_at(row, y, tip_x, tip_y, tip_w, tip_t, tip_n, sc); }
}

// SP-7: the entry clicked (or Enter on it): Index floating at the downloads, the entry gone until the next download.
void dl_open() {
    "hdesk: tray downloads opened {dl_d - dl_bd}\n";
    dl_bs = dl_s;
    dl_bd = dl_d;
    tip_off();
    tr_open = false;
    turn_to = 0;
    turn_start();
    Bool c = tray_scan();
    dl_float = true;
    pl_run(b"finder /home/downloads");
}

// Window i back from the tray where it was: out of the tray until its program asks again; the plate closes.
void tray_restore(I64 i) {
    if (i == DL_ITEM) {
        dl_open();
        return;
    }
    tip_off();
    "hdesk: tray opened {i}\n";
    tin[i] = false;
    tr_open = false;
    turn_to = 0;
    turn_start();
    desk_to(wdesk[i], -1);             // MS-7: the switch slides
    if (wmode[i] == layout.MINIMIZED) { wmode[i] = layout.TILED; }
    Bool c = tray_scan();              // SP-6: a window minimized to the tray leaves it here (its ask may stay)
    relayout();
    Bool up = raise(i);
    bar(true);
    redraw();
}

// A click on a cell: the left button restores its window, the right one quits it (WB-4: every process of the
// window); a click on the plate between cells does nothing.
void tray_click(I64 code) {
    I64 k = tray_cell();
    if (k < 0) { return; }
    I64 i = tray_item(k);
    if (i < 0 || (i == DL_ITEM && code == BTN_RIGHT)) { return; }
    if (code == BTN_RIGHT) {
        "hdesk: tray quit {i}\n";
        tray_close();
        end_window(i);
        return;
    }
    tray_restore(i);
}

// DN-15's keys on the open plate: the arrows move the selection (FILL) across and down the grid, Enter restores its
// window, Esc closes.
void tray_key(I64 code) {
    if (code == KEY_ESC) {
        tray_close();
        return;
    }
    if (code == KEY_ENTER) {
        if (tr_sel >= 0) { tray_restore(tray_item(tr_sel)); }
        return;
    }
    I64 k = tr_sel;
    if (k < 0) {
        k = 0;
    } else if (code == KEY_LEFT && k > 0) {
        k = k - 1;
    } else if (code == KEY_RIGHT && k + 1 < n_tray) {
        k = k + 1;
    } else if (code == KEY_UP && k >= 5) {
        k = k - 5;
    } else if (code == KEY_DOWN && k + 5 < n_tray) {
        k = k + 5;
    }
    if (k == tr_sel) { return; }
    tr_sel = k;
    "hdesk: tray sel {k}\n";
    redraw_overlay();
}

// DN-15 (design note 15): the tray's plate at 1x from (x0, y0), its row y: the n resident windows' 16 px icons ic,
// one centered a 32 px cell, 5 across from 4 px in, left to right then down; the keyboard's cell sel FILL and the
// pointer's hov SURF1, each radius 6 (SURF2 is the OV window's ground). No names, no count.
void tray_at_row(I64 x0, I64 y0, I64 n, in I64[_] ic, I64 sel, I64 hov, I64 y) {
    for k in 0..n {
        I64 cx = x0 + 4 + 32 * (k % 5);
        I64 cy = y0 + 4 + 32 * (k / 5);
        if (y >= cy && y < cy + 32) {
            I64 g = tokens.SURF2;
            if (k == sel) {
                g = tokens.FILL;
            } else if (k == hov) {
                g = tokens.SURF1;
            }
            if (g != tokens.SURF2) { pen.round(row, cx, cy, cx + 32, cy + 32, R_CTRL, tok(g)); }
            if (y >= cy + 8 && y < cy + 24) {
                icons3.icon_at(row, pen.row_y(), pen.x(cx + 8), pen.y(cy + 8), ic[k], 16, pen.zoom(), tok(g));
            }
        }
    }
}

// The plate's row y at 1x with the desk's state (tray_at_row).
void tray_row(I64 x0, I64 y0, I64 y) {
    I64[16] ic;
    I64 n = min(n_tray, 15);
    for k in 0..n {
        I64 i = tray_item(k);
        if (i == DL_ITEM) { ic[k] = prog_icon3(b"fetch"); } else { ic[k] = win_icon3(i); }
    }
    tray_at_row(x0, y0, n, ic, tr_sel, tr_hov, y);
}

// Window i's row in the tray, `TITLE - VARIABLE` (no variable: TITLE), at t[0]; its length.
I64 tray_text(I64 i, inout U8[96] t) {
    I64 n = title_len(i);
    for q in 0..n { t[q] = title[16 * i + q]; }
    U8[256] v;
    I64 vl = bartitle.fit(v, var_of(i, v), 96 - n - 3);
    if (vl > 0) {
        n = put_text(t, n, b" - ");
        for q in 0..vl { t[n + q] = v[q]; }
        n = n + vl;
    }
    return n;
}

// --- the Super plane (FF-5, docs/specs/2026-11-07-ff-super-plane.md sections 3 and 3c) ---

// The plane: the screen under the bar at the pen's zoom (FONT-2 A, FF 3g: native at 2x), the rest of the UI scale
// spread by win_body.
void pl_size() {
    I64 z = tz();
    plane.place(w / (sc / z), plane_h() / (sc / z), z);
}

// MS-6: the plane's clock, CLOCK_BOOTTIME, or on the gates' stepped clock a step a Shift press; its motion follows
// the animations setting (SP-R5 A).
I64 pl_steps = 0;

void pl_clock() {
    plane.motion(anim_on);
    if (stepped) {
        plane.set_time(anim.steps(pl_steps));
    } else {
        plane.set_time(wall.wall_ns());
    }
}

// FF 3h: how many items one listing of the session's Trash holds ($HOME/.trash/items, user/ci/trash.ci's; past 4 KB of
// names it still counts the ones that fit, so a full trash never reads as empty), 0 when it is not there or does not
// read: the rail's icon only.
I64 trash_items() {
    U8[80] p;
    I64 n = put_text(p, 0, b"/home/");
    if (ac_on && s_acct >= 0) {
        for k in 0..acct.name_len(s_acct) { p[n + k] = acct.name_byte(s_acct, k); }
        n = n + acct.name_len(s_acct);
    } else {
        n = n - 1;                             // no accounts: HOME is /home
    }
    n = put_text(p, n, b"/.trash/items");
    U8[4096] b;
    I64 got = dirctl.dir_names(p[0..n], b);   // the names that fit: a trash past one listing reads as full
    I64 c = 0;
    I64 s = 0;
    while (s < got) {
        I64 e = s;
        while (e < got && b[e] != 0) { e = e + 1; }
        I64 l = e - s;
        if (l > 0 && !(l == 1 && b[s] == '.') && !(l == 2 && b[s] == '.' && b[s + 1] == '.')) { c = c + 1; }
        s = e + 1;
    }
    return c;
}

// FF 3g: app i of kit/apps.ci opened from the grid or the list: Settings on the desk, the terminal, else its
// program in a new terminal.
void pl_app(I64 i) {
    if (i == plane.TRASH) {                    // DN-49, FF 3h: the rail's Trash opens Index at the Trash place
        "hdesk: ff trash\n";
        pl_run(b"finder --trash");
        return;
    }
    if (i >= plane.PIN_FILE) {                 // DN-46 (c): a pinned file or folder on the Taskbar
        pl_pinned(i - plane.PIN_FILE);
        return;
    }
    U8[32] p;
    I64 n = apps.field(i, 1, p);
    "hdesk: ff app {i} |";
    I64 put = ptyctl.pty_write(1, p[0..n]);
    "|\n";
    if (apps.runs_in(i) == apps.LABEL) {
        "hdesk: ff app {i} not built\n";   // DN-31: Web Browser is listed, not built
    } else if (apps.runs_in(i) == apps.DESK) {
        pl_shut(true);
        settings_open(false);
    } else if (bytes_eq(p[0..n], b"/bin/cish")) {
        pl_run(b"");
    } else if (n > 5) {
        pl_run(p[5..n]);
    }
}

// Enter with the field empty: the selected cell's app, recent file or window.
void pl_rest_enter() {
    I64 kd = plane.sel_kind();
    I64 ref = plane.sel_ref();
    if (kd == plane.ON_ALLAPPS) {
        pk_open();
    } else if (kd == plane.ON_CELL) {
        pl_app(ref);
    } else if (kd == plane.ON_RECENT) {
        U8[96] t;
        I64 n = plane.recent_path(ref, t);
        pl_path(t[0..n], -1);
    } else if (kd == plane.ON_WINDOW) {
        "hdesk: ff chose window {ref}\n";
        pl_window(ref);
    }
}

// The button released over the plane: the pressed cell opens if the pointer is still on it, else it springs back.
void pl_release() {
    pl_clock();
    I64 c = plane.pressed();
    plane.press(false);
    if (c >= 0 && c == plane.hover(mx / sc, (my - bar_h()) / sc)) {
        if (plane.picker_on()) {
            pl_app(plane.picker_app(c));
        } else if (plane.cell_app(c) == plane.ALL) {
            pk_open();
        } else {
            pl_app(plane.cell_app(c));
        }
        return;
    }
    redraw_overlay();
}

// DN-5: the All Apps picker opened on the plane, and its state as a line.
void pk_open() {
    plane.open_picker();
    pk_show();
}

void pk_show() {
    U8[32] t;
    I64 n = plane.picker_query(t);
    "hdesk: ff picker |";
    I64 put = ptyctl.pty_write(1, t[0..n]);
    "| apps {plane.picker_count()} sel {plane.picker_item()} app {plane.picker_selected()}\n";
    redraw_overlay();
}

// A key in the picker: Esc back to the plane, arrows move, Enter opens, Backspace and a printable key edit its query.
void pk_key(I64 code) {
    if (code == KEY_ESC) {
        plane.close_picker();
        "hdesk: ff picker closed\n";
        pl_show();
    } else if (code == KEY_ENTER) {
        I64 a = plane.picker_selected();
        if (a != apps.NONE) { pl_app(a); }
    } else if (code == KEY_UP || code == KEY_DOWN || code == KEY_LEFT || code == KEY_RIGHT) {
        I64 dx = 0;
        I64 dy = 0;
        if (code == KEY_LEFT) { dx = -1; }
        if (code == KEY_RIGHT) { dx = 1; }
        if (code == KEY_UP || code == KEY_DOWN) { dy = dy_of(code); }
        I64 k = plane.picker_nav(dx, dy);
        pk_show();
    } else if (code == KEY_BACKSPACE) {
        if (plane.picker_erase()) { pk_show(); }
    } else {
        I64 b = keymap.byte_of(code, shift, ctrl);
        if (b >= 32 && b <= 126 && plane.picker_typed(b as U8)) { pk_show(); }
    }
}

// The pointer over the open plane: the cell under it hovered.
void pl_hover() {
    pl_clock();
    if (plane.pin_menu_on()) {
        if (plane.pin_menu_hover(mx / sc, (my - bar_h()) / sc)) { redraw_overlay(); }
        return;
    }
    I64 o = plane.hovered();
    Bool pw = plane.power_hover(mx / sc, (my - bar_h()) / sc);   // DN-47: the power button and its rows
    if (plane.hover(mx / sc, (my - bar_h()) / sc) != o || pw) { redraw_overlay(); }
}

// DN-47: a row of the power menu taken: Restart (2), Shut Down (3), Lock (4, only where a session can lock).
// Shut Down and Restart would ask only when something is unsaved; nothing tells the desk of unsaved work yet.
void power_do(I64 a) {
    "hdesk: ff power row {a}\n";
    plane.arm(-1);
    if (a == plane.ACT_RESTART || a == plane.ACT_SHUTDOWN || a == plane.ACT_LOCK) { pl_action(a); }   // Lock as Super+L (AC-D5)
}

Bool is_dir(I64 mode) { return (mode & 0xF000) == 0x4000; }

I64 prog_icon(in U8[_] name) {
    if (bytes_eq(name, b"cish") || bytes_eq(name, b"sh")) { return icons.TERMINAL; }
    if (bytes_eq(name, b"ced") || bytes_eq(name, b"cvim")) { return icons.EDITOR; }
    I64 k = icons.named(name);
    if (k < 0) { k = icons.PROGRAM; }
    return k;
}

Bool bytes_eq(in U8[_] a, in U8[_] b) {
    if (len(a) != len(b)) { return false; }
    for k in 0..len(a) {
        if (a[k] != b[k]) { return false; }
    }
    return true;
}

// DN-5: a program's icon in kit/icons3.ci for the plane: its app's, the shell's Terminal, else Program.
I64 prog_icon3(in U8[_] name) {
    if (bytes_eq(name, b"cish") || bytes_eq(name, b"sh")) { return icons3.TERMINAL; }   // DN-30: cvim is CVim's, by apps
    U8[40] p;
    I64 n = put_text(p, 0, b"/bin/");
    for k in 0..len(name) {
        if (n < 40) {
            p[n] = name[k];
            n = n + 1;
        }
    }
    I64 a = apps.by_program(p[0..n]);
    if (a != apps.NONE) { return apps.icon(a); }
    return icons3.PROGRAM;
}

// Window i's icon in kit/icons3.ci by its program, as its name (kit/winname.ci icon, P2-b): CVim in a terminal is
// CVim's, a terminal running no app's program the Terminal.
I64 win_icon3(I64 i) {
    return winname.icon(title[16 * i..16 * i + title_len(i)], kind[i] == SETTINGS, kind[i] == TERM);
}

// DN-39 (e): window i's app in kit/apps.ci: Settings for Settings, the program's app by its name, and a terminal
// running no app's program is a Console's window; apps.NONE when neither.
I64 win_app(I64 i) {
    if (kind[i] == SETTINGS) {
        for a in 0..apps.N {
            if (apps.runs_in(a) == apps.DESK) { return a; }
        }
        return apps.NONE;
    }
    U8[40] p;
    I64 n = prog_path(i, p);
    I64 a = apps.by_program(p[0..n]);
    if (a == apps.NONE && kind[i] == TERM) { a = apps.by_program(b"/bin/cish"); }
    return a;
}

// Window i's icon in kit/icons.ci (the machine region's window rows), by its program as win_icon3 (P2-b): a terminal
// running CVim or Edit shows the Editor, a terminal running no named program the Terminal.
I64 win_icon(I64 i) {
    if (kind[i] == SETTINGS) { return icons.SETTINGS; }
    U8[40] p;
    I64 n = prog_path(i, p);
    I64 s = 0;
    for k in 0..n {
        if (p[k] == '/') { s = k + 1; }
    }
    I64 k = prog_icon(p[s..n]);
    if (k == icons.PROGRAM && kind[i] == TERM) { return icons.TERMINAL; }
    return k;
}

// Window i as the window lists name it (the plane's rows, Grants, the menu): its app's name and ` - ` and its
// variable when it has one (kit/winname.ci text).
I64 win_text(I64 i, inout U8[_] dst) {
    U8[256] v;
    I64 vl = 0;
    if (kind[i] != SETTINGS) { vl = var_of(i, v); }
    return winname.text(title[16 * i..16 * i + title_len(i)], kind[i] == SETTINGS, v[0..vl], dst);
}

// A grant word's ring (WB-R5 A, R0): 0 ring 0, 1 the disk, 2 the network, else 3.
I64 ring_of(I64 g) {
    if ((g & GRANT_KERN) != 0) { return 0; }
    if ((g & 1) != 0) { return 1; }
    if ((g & 2) != 0) { return 2; }
    return 3;
}

// DN-14: the chevron turned a degrees (0 points down, TURN up, clockwise) about (cx, cy) of bar row y, in ink: the
// path M2.5 4.25 L6 7.75 L9.5 4.25 of a 12 px box, stroked 1.75 px with round caps and joins, each pixel 4 x 4
// samples, ink over what the row holds by the samples it covers. At the pen's zoom z, each device pixel sampled in
// eighths of a device pixel (8 z an 1x pixel), the path z times the size.
void chevron(I64 y, I64 cx, I64 cy, I64 a, U32 ink) {
    if (y < cy - 6 || y >= cy + 6) { return; }
    U32[1] ic;
    ic[0] = ink;
    I64 z = pen.zoom();
    I64 ox = pen.x(cx);
    I64 oy = pen.y(cy);
    I64 c = cos_d(a);
    I64 s = sin_d(a);
    for px in pen.x(cx - 6)..pen.x(cx + 6) {
        I64 cov = 0;
        for i in 0..4 {
            for j in 0..4 {
                I64 x8 = 8 * (px - ox) + 2 * i + 1;
                I64 y8 = 8 * (pen.row_y() - oy) + 2 * j + 1;
                I64 u = (x8 * c + y8 * s) / 4096;   // the sample turned back by the angle
                I64 v = (y8 * c - x8 * s) / 4096;
                if (near_v(u, v, z)) { cov = cov + 1; }
            }
        }
        if (cov > 0) {
            I64 o = 0;
            for ch in 0..3 {
                I64 q = (cov * chan(ic, 0, ch) + (16 - cov) * chan(row, px, ch) + 8) / 16;
                o = o | (q << (8 * ch));
            }
            draw.put(row, px, o as U32);
        }
    }
}

// sin and cos of a whole number of degrees, 0 to 180, times 4096.
I64 sin_d(I64 a) {
    if (a <= 90) { return tsin[a]; }
    return tsin[180 - a];
}

I64 cos_d(I64 a) {
    if (a <= 90) { return tsin[90 - a]; }
    return 0 - tsin[a - 90];
}

I64 pid_text(I64 i, inout U8[_] dst) {
    if (kind[i] == SETTINGS) { return put_text(dst, 0, b"desk"); }
    return digits(dst, put_text(dst, 0, b"pid "), vpid[i]);
}

// /bin's programs, by name, once at start (the image's /bin does not change while the desk runs).
void bin_read() {
    U8[4096] p;
    path.walk_order(path.BY_NAME, false);
    path.walk_start(b"/bin", true, false, false);
    if (path.walk_next() != path.W_PRE) { return; }
    I64 wk = path.walk_next();
    while (wk != path.W_END) {
        if (wk == path.W_PRE) {
            path.walk_skip();
        } else if (wk == path.W_FILE && bin_n < BINS) {
            I64 pl = path.walk_path(p);
            I64 b0 = path.base_start(p[0..pl]);
            if (pl - b0 <= 32) {
                for k in 0..pl - b0 { bin_name[32 * bin_n + k] = p[b0 + k]; }
                bin_len[bin_n] = pl - b0;
                bin_n = bin_n + 1;
            }
        }
        wk = path.walk_next();
    }
}

Bool has_bin(in U8[_] name) {
    for j in 0..bin_n {
        if (bytes_eq(bin_name[32 * j..32 * j + bin_len[j]], name)) { return true; }
    }
    return false;
}

// At start: /bin read; on a volume, /dev/fsidx taken and the index of /home built (FF-1); the first boot's pins
// (finder first once it is in /bin, FF-6; terminal, editor, settings).
void pl_init() {
    bin_read();
    if (sys_flags() % 2 == 1) {
        ix_fd = shctl.sh_open(b"/dev/fsidx", O_CLOEXEC, 0);
        ix_on = index.build(b"/home");
    }
    I64 r = opener.load_default();
    for i in 0..apps.N {                 // FF 3g: the desk's apps: Settings, Terminal (a new terminal, whatever /bin
        U8[32] p;                        // calls its shell: the images install cish as sh), and every app in /bin
        I64 n = apps.field(i, 1, p);
        if (apps.runs_in(i) == apps.DESK || apps.runs_in(i) == apps.LABEL || bytes_eq(p[0..n], b"/bin/cish") ||
            (n > 5 && has_bin(p[5..n]))) {   // DN-31: a listed label shows with no program
            plane.app(i);
        }
    }
    for i in 0..3 { Bool p = plane.pin_app(i); }   // DN-5: the first boot's pins, APPS-1's first three
    "hdesk: ff programs {bin_n} index {ix_on} ring {ix_fd >= 0}\n";
}

// The ring read to its end into the index (the plane reads it when it opens: nothing polls).
void ix_drain() {
    if (ix_fd < 0) { return; }
    U8[64] e;
    I64 got = shctl.fd_read(ix_fd, e);
    while (got == 64) {
        index.apply(e);
        got = shctl.fd_read(ix_fd, e);
    }
    ix_on = index.entries() > 0;
}

// The windows and programs the list may show: every window but the tray's (SP-R3 A: the chevron lists those),
// Settings, then /bin's programs.
void pl_sources() {
    U8[96] t;
    U8[24] sd;
    for i in 0..WINDOWS {
        if (listed(i) && !tin[i]) {
            Bool got = info(i);
            I64 n = win_text(i, t);
            I64 sl = pid_text(i, sd);
            plane.source(plane.WIN, i, win_icon3(i), t, n, sd, sl, wrank[i]);
        }
    }
    plane.source(plane.PROG, CMD_SETTINGS, icons3.SETTINGS, b"settings", 8, b"Super+,", 7, 0);
    for j in 0..bin_n {
        I64 n = put_text(t, 0, b"/bin/");
        for k in 0..bin_len[j] { t[n + k] = bin_name[32 * j + k]; }
        n = n + bin_len[j];
        plane.source(plane.PROG, j, prog_icon3(bin_name[32 * j..32 * j + bin_len[j]]), t, n, b"/bin", 4, 0);
    }
}

// Recent: the files the plane opened, newest first, then the index's files by their last change, newest first.
void pl_recent() {
    if (!ix_on || !recent_on) { return; }   // BG-1: desk.recent-files 0 keeps none
    if (index.walks() != op_walks) {
        op_n = 0;
        op_walks = index.walks();
    }
    I64[12] got;
    I64 gn = 0;
    for k in 0..op_n {
        got[gn] = op_ent[k];
        gn = gn + 1;
    }
    I64 n = index.sorted();
    I64 last = -1;
    Bool more = true;
    while (more && gn < plane.RECENT) {
        I64 best = -1;
        I64 bs = 0;
        for k in 0..n {
            I64 i = index.sorted_at(k);
            I64 s = index.seq_of(i);
            if (s > bs && (last < 0 || s < last) && !is_dir(index.mode_of(i))) {
                best = i;
                bs = s;
            }
        }
        if (best < 0) {
            more = false;
        } else {
            last = bs;
            Bool dup = false;
            for q in 0..gn {
                if (got[q] == best) { dup = true; }
            }
            if (!dup) {
                got[gn] = best;
                gn = gn + 1;
            }
        }
    }
    for k in 0..gn {
        I64 pl = index.path_of(got[k], pbuf);
        if (pl > 0) { plane.recent(pbuf, pl, index.size_of(got[k]), false); }
    }
}

// The machine region's windows: by desktop, then by number; none hidden in the tray (SP-R3 A).
void pl_machine() {
    pl_mn = 0;
    for d in 1..10 {
        for i in 0..WINDOWS {
            if (listed(i) && !tin[i] && wdesk[i] == d) {
                pl_mwin[pl_mn] = i;
                pl_mn = pl_mn + 1;
            }
        }
    }
    if (pl_msel >= pl_mn) { pl_msel = pl_mn - 1; }
    if (pl_msel < 0) { pl_msel = 0; }
    U8[256] v;
    for k in 0..pl_mn {                  // FF 3g: the band's WINDOWS and GRANTS
        I64 i = pl_mwin[k];
        I64 vl = bartitle.fit(v, var_of(i, v), plane.TEXT);
        plane.window(i, win_icon3(i), title[16 * i..16 * i + title_len(i)], title_len(i), v, vl, wdesk[i],
                     wmode[i] == layout.MINIMIZED);
        plane.window_app(win_app(i));   // DN-39 (e): the app it is a window of
    }
    I64[32] gwin;
    I64[32] gg;
    I64 gn = grant_list(gwin, gg);
    U8[96] t;
    for q in 0..gn {
        I64 n = win_text(gwin[q], t);
        plane.grant(gwin[q], gg[q], t, n);
    }
}

// The list again from the field: the sources, then each file of the index; the kept files' rows filled.
void pl_filter() {
    plane.filter_begin();
    if (ix_on && plane.query_len() > 0) {
        I64 n = index.sorted();
        for k in 0..n {
            I64 i = index.sorted_at(k);
            I64 pl = index.path_of(i, pbuf);
            if (pl > 0) { plane.offer_file(i, pbuf[0..pl], index.seq_of(i)); }
        }
    }
    I64 r = plane.filter_end();
    for k in 0..r {
        if (plane.row_kind(k) == plane.FILE) {
            I64 i = plane.row_ref(k);
            I64 pl = index.path_of(i, pbuf);
            if (pl > 0) { plane.fill_file(k, pbuf, pl, index.size_of(i), is_dir(index.mode_of(i))); }
        }
    }
}

// Whether (u, v), in eighths of a pixel about the chevron's center, lies within 0.75 px of the V's two strokes,
// (-4, -2) to (0, 2) and (0, 2) to (4, -2), each length times the zoom z.
Bool near_v(I64 u, I64 v, I64 z) {   // DN-14: (2.5, 4.25), (6, 7.75), (9.5, 4.25) from the box's center, 0.875 wide
    return seg_d2(u, v, -28 * z, -14 * z, 0, 14 * z) <= 49 * z * z || seg_d2(u, v, 28 * z, -14 * z, 0, 14 * z) <= 49 * z * z;
}

// The squared distance from (u, v) to the segment (ax, ay) to (ex, ey), in whole numbers.
I64 seg_d2(I64 u, I64 v, I64 ax, I64 ay, I64 ex, I64 ey) {
    I64 dx = ex - ax;
    I64 dy = ey - ay;
    I64 l2 = dx * dx + dy * dy;
    I64 t = (u - ax) * dx + (v - ay) * dy;
    if (t <= 0) { return (u - ax) * (u - ax) + (v - ay) * (v - ay); }
    if (t >= l2) { return (u - ex) * (u - ex) + (v - ey) * (v - ey); }
    I64 px = u - ax;
    I64 py = v - ay;
    return px * px + py * py - t * t / l2;
}

I64 kind_word(I64 kd, inout U8[_] dst) {
    if (kd == plane.FILE) { return put_text(dst, 0, b"file"); }
    if (kd == plane.DIR) { return put_text(dst, 0, b"dir"); }
    if (kd == plane.PROG || kd == plane.APP) { return put_text(dst, 0, b"prog"); }
    return put_text(dst, 0, b"win");
}

// `hdesk: ff |QUERY| rows N sel S` and a line a row, `hdesk: ff row K KIND |TEXT| |SIDE|`, or the machine's
// selection with the field empty; then the plane painted again.
void pl_show() {
    U8[96] t;
    I64 qn = plane.query(t);
    "hdesk: ff |";
    I64 put = ptyctl.pty_write(1, t[0..qn]);
    if (qn == 0) {
        "| item {plane.rest_item()} kind {plane.sel_kind()} ref {plane.sel_ref()} of {plane.cells()} apps {pl_mn} windows\n";
    } else {
        "| rows {plane.rows()} sel {plane.selected()}\n";
        for k in 0..plane.rows() {
            U8[8] kw;
            I64 kn = kind_word(plane.row_kind(k), kw);
            "hdesk: ff row {k} ";
            I64 p1 = ptyctl.pty_write(1, kw[0..kn]);
            " |";
            I64 n = plane.row_text(k, t);
            I64 p2 = ptyctl.pty_write(1, t[0..n]);
            "| |";
            n = plane.row_side(k, t);
            I64 p3 = ptyctl.pty_write(1, t[0..n]);
            "|\n";
        }
    }
    redraw_overlay();
}

// Opened by a clean Super tap or a click on the mark: the ring read, the sources, recent and the machine again.
void pl_open_now() {
    ungrab();
    if (sw_open) { return; }
    cal_open = false;
    sp_open = false;
    tr_open = false;
    mn_open = false;
    mn_app = false;
    ix_drain();
    pl_clock();
    plane.reset();
    pl_sources();
    pl_recent();
    pl_msel = 0;
    pl_machine();
    plane.set_lock(ac_on && s_acct >= 0);   // AC-D5, DN-47: Lock in the power menu while an account's session is up
    plane.set_trash_full(trash_items() > 0);   // DN-46 (d), FF 3h: the rail's Trash, empty or full
    pl_open = true;
    I64 g = 0;
    for i in 0..WINDOWS {
        if (listed(i) && gw[i] != 0) { g = g + 1; }
    }
    "hdesk: ff open pins {plane.pinned_count()} recent {plane.recents()} grants {g} windows {pl_mn}\n";
    pl_show();
}

// Closed: by Esc, a second tap or a click on the margin (`hdesk: ff closed`), or by an open (the caller redraws).
void pl_shut(Bool quiet) {
    pl_open = false;
    plane.pin_menu_close();             // DN-39 (d): a pin's menu goes with the plane
    if (quiet) { return; }
    "hdesk: ff closed\n";
    redraw();
}

// A new terminal on the active desktop for cmd, the one way the desk starts a program (board 20261111T170652Z): the
// tray's Downloads (dl_open), a pinned program, folder or file (pl_pinned), an app (pl_app, a pin menu's New
// Window), a /bin row of the query (pl_choose), and a path (pl_path: a query row, a pinned file, FF-6c's open from
// Index, its right-click Open included). kit/launch.ci types an app as `exec CMD`, so it takes the shell's place
// and the terminal ends with it; a command (DN-60: Fetch, a /bin program that is no app) is typed as is and keeps
// its Console; an empty cmd (or cish alone) is Console, the shell itself. A program not in /bin opens nothing and
// the bar says so; an app the shell still cannot start ends the terminal with 126 or 127, and the reap says so.
I64 pl_last = -1;                      // the window pl_run last opened (Open in CVim's, DN-51)
void pl_run(in U8[_] cmd) {
    pl_shut(true);
    if (len(cmd) > 0 && !shquote.plain(cmd)) {   // AC-Q: a line that could be more than one command is never typed
        "hdesk: launch refused\n";
        redraw();
        return;
    }
    U8[72] pp;                         // DN-21: the app the command's first word runs, else Console
    I64 pn = launch.program(cmd, pp);
    U8[262] c;
    I64 cn = launch.typed(cmd, c);
    U8[32] nm;
    I64 nn = launch.name(cmd, nm);
    I64[16] st;
    if (cn < 0 || (cn > 0 && (pn == 0 || corectl.co_stat(pp[0..pn], 1, st) < 0))) {
        "hdesk: launch none |";
        I64 put = ptyctl.pty_write(1, cmd);
        "|\n";
        U8[64] t;
        I64 tn = launch.note(nm[0..nn], t);
        msg_show(t[0..tn]);            // DN-6 frame 9: one sentence under the bar; no terminal opens
        redraw();
        return;
    }
    I64 app = apps.NONE;
    if (pn > 0) { app = apps.by_program(pp[0..pn]); }
    if (app == apps.NONE) { app = apps.by_program(b"/bin/cish"); }
    I64 t = new_term(false, app);      // DN-20: opened from the plane, a float
    pl_last = t;
    if (t >= 0 && cn > 0) {
        I64 put = ptyctl.pty_write(master[t], c[0..cn]);
        if (launch.replaces(cmd)) {        // a command's shell stays: its failure is on its own screen
            for k in 0..nn { lx_name[32 * t + k] = nm[k]; }
            lx_len[t] = nn;
        }
        lx_app[t] = prompttitle.record(cmd);   // AC-T: an app only for a line the shell reads as that one program
        if (launches_window(cmd)) { busy_start(); }   // DN-37: busy until its window binds
    }
    redraw();
}

// DN-37 (docs/specs/2026-11-10-busy-pointer.md): the Busy pointer, from a launch of an app in its own window until
// a pixel window binds or BUSY_MS pass; the dark wheel beside the arrow (FBIO_TILE_BUSY), a frame every
// BUSY_FRAME_MS while animations are on.
const I64 FBIO_TILE_BUSY = 0x4693;
const I64 BUSY_MS = 5000;
const I64 BUSY_FRAME_MS = 50;
Bool busy = false;
I64 busy_t0 = 0;
I64 busy_ph = -1;
U8[9236] busy_buf;

I64 busy_ms() { return (wall.wall_ns() - busy_t0) / 1000000; }

void busy_send() {
    I64 side = wheel.sprite(busy_buf, 20, sc, busy_ms(), anim_on);
    put_word(busy_buf, 0, 1);
    put_word(busy_buf, 1, side);
    put_word(busy_buf, 2, side);
    put_word(busy_buf, 3, wheel.BUSY_X * sc);
    put_word(busy_buf, 4, wheel.BUSY_Y * sc);
    I64 st = tilectl.tile_big(FBIO_TILE_BUSY, busy_buf[0..20 + 4 * side * side]);
}

void busy_start() {
    if (!busy) { "hdesk: busy on\n"; }
    busy = true;
    busy_t0 = wall.wall_ns();
    busy_ph = 0;
    busy_send();
}

void busy_stop() {
    if (!busy) { return; }
    busy = false;
    for k in 0..20 { busy_buf[k] = 0; }
    I64 st = tilectl.tile_big(FBIO_TILE_BUSY, busy_buf[0..20]);
    "hdesk: busy off\n";
}

// A frame tick: the wheel's next frame, or the end of the wait.
void busy_tick() {
    if (!busy) { return; }
    if (busy_ms() >= BUSY_MS) {
        busy_stop();
        return;
    }
    if (anim_on && busy_ms() / BUSY_FRAME_MS != busy_ph) {
        busy_ph = busy_ms() / BUSY_FRAME_MS;
        busy_send();
    }
}

// Whether cmd starts an app that runs in its own window (apps.WINDOW): its first word as /bin/WORD.
Bool launches_window(in U8[_] cmd) {
    U8[72] p;
    I64 pn = launch.program(cmd, p);
    if (pn == 0) { return false; }
    I64 a = apps.by_program(p[0..pn]);
    return a != apps.NONE && apps.runs_in(a) == apps.WINDOW;
}

// Window i focused on its desktop, restored when minimized (as the switcher chooses).
// DN-39 (d): a right press on the plane: on a pin, its menu (its windows, New Window, Unpin from Taskbar, Close All
// Windows) 12 right of and 14 under the press; elsewhere nothing.
void pl_rclick() {
    pl_clock();
    if (plane.picker_on() || plane.query_len() > 0) { return; }
    I64 px = mx / sc;
    I64 py = (my - bar_h()) / sc;
    if (plane.power_open()) {
        plane.power_close();
        plane.arm(-1);
    }
    I64 c = plane.cell_at(px, py);
    if (c >= 0 && plane.pin_menu_open(c, px, py)) {
        "hdesk: ff pin menu {c} rows {plane.pin_menu_rows()}\n";
    } else {
        plane.pin_menu_close();
    }
    redraw_overlay();
}

// DN-39 (d): row r of a pin's menu taken: a window reached on its desktop or a minimized one restored here; New
// Window runs the app; Unpin from Taskbar (the kit unpins, every Index learns); Close All Windows ends the app's.
void pl_menu_take(I64 r) {
    I64[12] js;
    I64 a = -1;
    I64 k = plane.pin_menu_choose(r, cur);
    a = plane.pin_menu_app();
    "hdesk: ff pin menu take {k} app {a}\n";
    if (k == plane.AM_WINDOW) {
        I64 wr = plane.act_ref();
        if (plane.act_kind() == plane.RESTORE_HERE && wr >= 0 && wr < WINDOWS && kind[wr] != NONE) {
            wdesk[wr] = cur;                // a minimized window comes to this desktop
        }
        pl_window(wr);
        return;
    }
    if (k == plane.AM_NEW) {
        pl_app(a);
        return;
    }
    if (k == plane.AM_UNPIN) {
        pins_tell_all();
        pl_show();
        return;
    }
    if (k == plane.AM_CLOSE_ALL && a >= 0 && a < apps.N) {
        I64 n = plane.app_windows(a, js);
        I64[12] refs;
        for q in 0..n { refs[q] = plane.window_ref(js[q]); }
        pl_shut(true);
        for q in 0..n {
            if (refs[q] >= 0 && refs[q] < WINDOWS && kind[refs[q]] != NONE) { end_window(refs[q]); }
        }
        redraw();
        return;
    }
    redraw_overlay();
}

// DN-54 (design note 50): window i chosen from a window list: the desks slide to its desktop and it takes focus when
// the slide ends (MS-7); a minimized window restores on the active desktop with no slide.
void jump_to(I64 i) {
    if (wmode[i] == layout.MINIMIZED) {
        wmode[i] = layout.TILED;
        wdesk[i] = cur;
        _ = raise(i);
        return;
    }
    desk_to(wdesk[i], i);
}

void pl_window(I64 i) {
    pl_shut(true);
    if (i >= 0 && i < WINDOWS && kind[i] != NONE) {
        jump_to(i);
        Bool up = raise(i);            // HX-1: focusing a window raises it
    }
    redraw();
}

// The field set to text (a directory opened: the list shows what is in it).
void pl_field(in U8[_] text) {
    while (plane.erase()) { }
    for k in 0..len(text) { Bool kept = plane.typed(text[k]); }
    pl_filter();
    pl_show();
}

// A path opened (FF-3): a directory sets the field to it; a file opens in the program its extension names, or in the
// editor when it is text with none; else the plane stays, `hdesk: ff no program`. Only a regular file is opened,
// without waiting (kit/openas.ci of_mode, O_NONBLOCK): a device or a pipe is `hdesk: ff not a file`. RG-1: a path the
// desk cannot stat with its own rights (a file in a 0700 home: the desk is uid 0 with no ring 0) is peeked as the
// session's account (pk_ask) and opened when the peek ends (pk_end); the program runs in a terminal of the session, so
// it opens the file as the account. The desk's own rights do not change.
void pl_path(in U8[_] p, I64 ent) {
    I64[16] r;
    if (corectl.co_stat(p, 1, r) < 0) {
        if (pk_ask(p, ent)) { return; }
        "hdesk: ff gone\n";
        return;
    }
    I64 kd = openas.of_mode(r[corectl.ST_MODE]);
    if (kd == openas.DIR) {
        pl_dir(p);
        return;
    }
    if (kd != openas.FILE) {               // a device or a pipe: never opened, so it cannot hold the desk
        "hdesk: ff not a file\n";
        return;
    }
    U8[512] head;
    I64 hn = 0;
    I64 fd = shctl.sh_open(p, O_CLOEXEC + openas.O_NONBLOCK, 0);
    if (fd >= 0) {
        I64[16] fs;
        Bool reg = fdctl.fd_stat(fd, fs) >= 0 && openas.of_mode(fs[corectl.ST_MODE]) == openas.FILE;
        if (reg) { hn = shctl.fd_read(fd, head); }
        I64 c = shctl.fd_close(fd);
        if (!reg) {                        // swapped for a device between the stat and the open
            "hdesk: ff not a file\n";
            return;
        }
    }
    if (hn < 0) { hn = 0; }
    pl_file(p, ent, head[0..hn]);
}

// A directory opened: the plane's field set to it.
void pl_dir(in U8[_] p) {
    U8[64] t;
    I64 n = len(p);
    if (n > 31) { n = 31; }
    for k in 0..n { t[k] = p[k]; }
    t[n] = '/';
    pl_field(t[0..n + 1]);
}

// File p, its first bytes head, opened in its program in a new terminal of the session (kit/openas.ci command).
// The path is one single-quoted shell word (kit/shquote.ci quote, AC-Q), so the shell sees exactly one argument
// whatever bytes the name holds; a leading hyphen gets ./ so the program cannot read it as an option. A control byte
// (the terminal would read it before the shell) and a line past the 255 bytes of a command (launch.MAX; pl_run types
// `exec `, them and Enter) are refused before any recent-list change or terminal starts.
void pl_file(in U8[_] p, I64 ent, in U8[_] head) {
    U8[256] cmd;
    I64 cn = openas.command(p, head, cmd, launch.MAX);
    if (cn == 0) {
        "hdesk: ff no program\n";
        return;
    }
    if (cn < 0) {
        "hdesk: ff path refused\n";
        return;
    }
    if (ent >= 0) {
        I64 n = op_n;
        if (n == plane.RECENT) { n = n - 1; }
        I64 at = n;
        while (at > 0) {
            op_ent[at] = op_ent[at - 1];
            at = at - 1;
        }
        op_ent[0] = ent;
        op_n = n + 1;
    }
    "hdesk: ff runs |";
    I64 put = ptyctl.pty_write(1, cmd[0..cn]);
    "|\n";
    pl_run(cmd[0..cn]);
}

// The selected row opened (Enter, or a click on it).
void pl_choose(I64 k) {
    if (k < 0 || k >= plane.rows()) { return; }
    U8[96] t;
    I64 n = plane.row_text(k, t);
    U8[8] kw;
    I64 kn = kind_word(plane.row_kind(k), kw);
    "hdesk: ff chose ";
    I64 p1 = ptyctl.pty_write(1, kw[0..kn]);
    " |";
    I64 p2 = ptyctl.pty_write(1, t[0..n]);
    I64 kd = plane.row_kind(k);
    I64 ref = plane.row_ref(k);
    if (kd == plane.WIN) { "| window {ref}\n"; } else { "|\n"; }
    if (kd == plane.WIN) {
        pl_window(ref);
    } else if (kd == plane.APP) {
        pl_app(ref);
    } else if (kd == plane.PROG && ref == CMD_SETTINGS) {
        pl_shut(true);
        settings_open(false);
    } else if (kd == plane.PROG) {
        pl_run(bin_name[32 * ref..32 * ref + bin_len[ref]]);
    } else {
        pl_path(t[0..n], ref);
    }
}

// Pinned cell k opened: Settings, a program, or a path.
void pl_pinned(I64 k) {
    U8[96] t;
    I64 n = plane.pin_sub(k, t);
    // AC-Q: a pin with a control byte would forge a log line, and it opens nothing anyway (quote and word refuse it)
    if (!shquote.printable(t[0..n])) {
        "hdesk: ff pinned {k} refused\n";
        return;
    }
    "hdesk: ff pinned {k} |";
    I64 put = ptyctl.pty_write(1, t[0..n]);
    "|\n";
    if (bytes_eq(t[0..n], b"Super+,")) {
        pl_shut(true);
        settings_open(false);
    } else if (bytes_eq(t[0..n], b"/bin/cish")) {
        pl_run(b"");
    } else if (n > 5 && bytes_eq(t[0..5], b"/bin/")) {
        if (shquote.word(t[5..n])) {           // AC-Q: one program of /bin by its bare name, or nothing
            pl_run(t[5..n]);
        } else {
            "hdesk: ff pinned refused\n";
        }
    } else {
        I64[16] st;                            // DN-46 (c): a folder opens in Index, as Index would open it
        if (corectl.co_stat(t[0..n], 1, st) == 0 && is_dir(st[corectl.ST_MODE])) {
            U8[256] c;                         // AC-Q: the path as one quoted word, as pl_path types a file's
            I64 cn = shquote.quote(t[0..n], c, put_text(c, 0, b"finder "), launch.MAX);
            if (cn > 0) {
                pl_run(c[0..cn]);
            } else {
                "hdesk: ff pinned refused\n";
            }
        } else {
            pl_path(t[0..n], -1);
        }
    }
}

// Super+P: the selected row pinned, or unpinned when it is.
void pl_pin() {
    I64 a = apps.NONE;                    // DN-5: Super+P pins or unpins an app: the picker's, the hit's or the cell's
    if (plane.picker_on()) {
        a = plane.picker_selected();
    } else if (plane.query_len() > 0) {
        I64 k = plane.selected();
        if (k < plane.rows()) { a = plane.row_app(k); }
    } else if (plane.sel_kind() == plane.ON_CELL) {
        a = plane.sel_ref();
    }
    if (a == apps.NONE && !plane.picker_on() && plane.query_len() > 0) {
        I64 k = plane.selected();              // DN-46 (c): a file or folder row pins to the Taskbar
        if (k < plane.rows() && (plane.row_kind(k) == plane.FILE || plane.row_kind(k) == plane.DIR)) {
            U8[96] t;
            I64 n = plane.row_text(k, t);
            Bool fon = plane.taskbar_toggle(t[0..n], plane.row_kind(k) == plane.DIR);
            "hdesk: ff taskbar {fon as I64} |";
            I64 put = ptyctl.pty_write(1, t[0..n]);
            "|\n";
            pins_tell_all();
            pl_show();
            return;
        }
    }
    if (a == apps.NONE) {
        "hdesk: ff pin none\n";
        return;
    }
    Bool on = plane.toggle_pin(a);
    pins_tell_all();
    "hdesk: ff pin {a} {on as I64} pins {plane.pinned_count()}\n";
    if (plane.picker_on()) { pk_show(); } else { pl_show(); }
}

// Tab: the preview shown or hidden; shown on a file row, its first lines (at most 4 KiB, plane.LINES lines).
void pl_preview() {
    Bool on = plane.toggle_preview();
    I64 k = plane.selected();
    if (on && k < plane.rows() && plane.row_kind(k) == plane.FILE) {
        U8[96] t;
        I64 n = plane.row_text(k, t);
        plane.preview_begin(t, n);
        I64 fd = shctl.sh_open(t[0..n], O_CLOEXEC, 0);
        I64 got = 0;
        if (fd >= 0) {
            got = shctl.fd_read(fd, fbuf);
            I64 c = shctl.fd_close(fd);
        }
        I64 at = 0;
        I64 lines = 0;
        while (at < got && lines < plane.LINES) {
            I64 e = at;
            while (e < got && fbuf[e] != 10) { e = e + 1; }
            plane.preview_line(fbuf[at..e], e - at);
            lines = lines + 1;
            at = e + 1;
        }
        "hdesk: ff preview |";
        I64 put = ptyctl.pty_write(1, t[0..n]);
        "| lines {lines}\n";
    } else {
        I64 o = 0;
        if (on) { o = 1; }
        "hdesk: ff preview {o}\n";
    }
    redraw_overlay();
}

// The actions: 0 new terminal, 1 settings, 2 restart, 3 shut down, 4 lock (AC-D5, offered only in a session).
void pl_action(I64 a) {
    "hdesk: ff action {a}\n";
    pl_shut(true);
    if (a == 4) {
        if (ac_on && s_acct >= 0 && ac_screen == SCR_NONE) { lock_now(); }   // as Super+L
        return;
    }
    if ((a == 2 || a == 3) && !uv_go && uv_ask(a)) { return; }   // AM section 7: unsaved work asks first
    uv_go = false;
    if (a == 0) {
        I64 t = new_term(false, apps.by_program(b"/bin/cish"));   // DN-20: opened from the plane, a float
        redraw();
    } else if (a == 1) {
        settings_open(false);
    } else {
        I64 how = 1;
        if (a == 2) { how = 2; }
        I64 e = hdeskctl.power(how);      // FF-4: every process ends, then the desk; the kernel ends the machine
        "hdesk: power refused {0 - e}\n";
        redraw();
    }
}

// AM section 7 (DN-47): the windows that report unsaved work, the first unsaved.ROWS named into names (24 bytes
// each) and lens; their count. A terminal's from its OSC 7770 dirty (terms), a pixel program's from FBIO_TILE_INFO
// kind 8, byte 5.
I64 uv_scan(inout U8[_] names, inout I64[_] lens) {
    I64 n = 0;
    for i in 0..WINDOWS {
        Bool un = false;
        if (kind[i] == TERM) { un = terms.menu_unsaved(slot[i]); }
        if (kind[i] == PIXEL && hdeskctl.tile_ask(FBIO_TILE_INFO, 8, pid[i], ask[0..64]) == 0) { un = ask[5] != 0; }
        if (un) {
            if (n < unsaved.ROWS) {
                U8[16] t;
                I64 tl = win_name(i, t);
                for k in 0..tl { names[24 * n + k] = t[k]; }
                lens[n] = tl;
            }
            n = n + 1;
        }
    }
    return n;
}

Bool uv_go = false;                   // AM section 7: the ask was answered with the action: act without asking

// Restart (2) or Shut Down (3): when a window reports unsaved work, the ask opens instead; true when it did.
Bool uv_ask(I64 a) {
    U8[96] nm;
    I64[4] nl;
    I64 n = uv_scan(nm, nl);
    if (!unsaved.gate(n)) { return false; }
    unsaved.open(a, nm, nl, n);
    "hdesk: unsaved ask {a} windows {n}\n";
    redraw_overlay();
    return true;
}

// The ask's answer r (unsaved.GO, CANCEL or STAY).
void uv_answer(I64 r) {
    if (r == unsaved.STAY) {
        redraw_overlay();
        return;
    }
    I64 a = unsaved.action();
    unsaved.close();
    if (r == unsaved.CANCEL) {
        "hdesk: unsaved cancel\n";
        redraw_overlay();
        return;
    }
    "hdesk: unsaved go {a}\n";
    uv_go = true;
    pl_action(a);
}

// FF-R6 B: power chord a (2 Restart, 3 Shut Down). The first press opens the plane with the action's chord slot
// reading `again to ...`; the same chord again within 2 s acts as a click on the action; past 2 s the slot reads its
// chord again (pw_expire, on the frames asked for while an action is armed).
void pw_chord(I64 a) {
    I64 t = wall.wall_ns();
    if (pl_open && plane.armed_action() == a && t - pw_at <= PW_NS) {
        pl_action(a);
        return;
    }
    if (!pl_open) { pl_open_now(); }
    if (!pl_open) { return; }
    plane.arm(a);
    "hdesk: ff armed {a}\n";
    redraw_overlay();
    pw_at = wall.wall_ns();            // the 2 s run from when the prompt shows (a slow paint under TCG takes seconds)
}

void pw_expire() {
    if (!pl_open || plane.armed_action() < 0 || wall.wall_ns() - pw_at <= PW_NS) { return; }
    plane.arm(-1);
    "hdesk: ff disarmed\n";
    redraw_overlay();
}

// A key while the plane is open (FF-5): Esc closes; Enter opens the selected row, or the machine's window with the
// field empty; Up and Down move; Tab the preview; Backspace and a printable key edit the field.
void pl_key(I64 code) {
    pl_clock();
    if (plane.picker_on()) {
        pk_key(code);
        return;
    }
    if (plane.pin_menu_on()) {               // DN-39 (d): a pin's menu takes the keys while it shows
        I64 k = -1;
        if (code == KEY_ESC) { k = plane.PK_ESC; }
        if (code == KEY_UP) { k = plane.PK_UP; }
        if (code == KEY_DOWN) { k = plane.PK_DOWN; }
        if (code == KEY_ENTER) { k = plane.PK_ENTER; }
        if (k >= 0) {
            I64 r = plane.pin_menu_key(k);
            if (r >= 0) {
                pl_menu_take(r);
                return;
            }
        }
        redraw_overlay();
        return;
    }
    if (plane.power_open()) {                // DN-47: the power menu takes the keys while it shows
        I64 k = -1;
        if (code == KEY_ESC) { k = plane.PK_ESC; }
        if (code == KEY_UP) { k = plane.PK_UP; }
        if (code == KEY_DOWN) { k = plane.PK_DOWN; }
        if (code == KEY_ENTER) { k = plane.PK_ENTER; }
        if (k >= 0) {
            I64 r = plane.power_key(k);
            if (r >= plane.ACT_RESTART) { power_do(r); }
            redraw_overlay();
            return;
        }
    }
    if (plane.power_focused()) {             // after Esc out of the menu: Enter opens it again
        if (code == KEY_ENTER) {
            plane.power_toggle(true);
            redraw_overlay();
            return;
        }
        plane.power_unfocus();
    }
    if (code == KEY_ESC) {
        pl_shut(false);
    } else if (code == KEY_ENTER) {
        if (plane.query_len() > 0) {
            pl_choose(plane.selected());
        } else {
            pl_rest_enter();
        }
    } else if (code == KEY_UP || code == KEY_DOWN || code == KEY_LEFT || code == KEY_RIGHT) {
        I64 dx = 0;
        if (code == KEY_LEFT) { dx = -1; }
        if (code == KEY_RIGHT) { dx = 1; }
        if (plane.query_len() > 0) {
            if (dx == 0) {
                I64 m = plane.move(dy_of(code));
                if (plane.preview_on()) { Bool off = plane.toggle_preview(); }
            }
        } else if (dx == 0) {
            I64 r = plane.nav(0, dy_of(code));
        } else {
            I64 r = plane.nav(dx, 0);
        }
        pl_show();
    } else if (code == KEY_TAB) {
        pl_preview();
    } else if (code == KEY_BACKSPACE) {
        if (plane.erase()) {
            pl_filter();
            pl_show();
        }
    } else {
        I64 b = keymap.byte_of(code, shift, ctrl);
        if (b >= 32 && b <= 126 && plane.typed(b as U8)) {
            pl_filter();
            pl_show();
        }
    }
}

// A left click on the plane at the pointer: an action, a pinned cell, a row, a machine window; the margin closes.
void pl_click() {
    pl_clock();
    I64 px = mx / sc;
    I64 py = (my - bar_h()) / sc;
    if (plane.pin_menu_on()) {               // DN-39 (d): a pin's menu takes the press; off it, it shuts
        I64 r = plane.pin_menu_at(px, py);
        if (r >= 0) {
            pl_menu_take(r);
        } else {
            plane.pin_menu_close();
            redraw_overlay();
        }
        return;
    }
    I64 c = plane.hover(px, py);
    if (c >= 0) {
        plane.press(true);                // MS-6: the icon dips to 56 px; the cell opens on the release over it
        redraw_overlay();
        return;
    }
    if (plane.picker_on()) { return; }   // DN-5: the picker's cells alone take a click
    I64 wr = plane.window_at(px, py);
    if (wr >= 0) {
        "hdesk: ff chose window {wr}\n";
        pl_window(wr);
        return;
    }
    I64 pa = plane.power_at(px, py);         // DN-47: the power button opens its menu; a row acts
    if (pa == 1) {
        plane.power_toggle(false);
        "hdesk: ff power menu\n";
        redraw_overlay();
        return;
    }
    if (pa >= plane.ACT_RESTART) {
        power_do(pa);
        return;
    }
    if (plane.power_open()) {
        plane.power_close();
        plane.arm(-1);
        redraw_overlay();
        return;
    }
    I64 p = plane.pin_at(px, py);
    if (p >= 0) {
        pl_pinned(p);
        return;
    }
    I64 r = plane.row_at(px, py);
    if (r >= 0) {
        pl_choose(r);
        return;
    }
    I64 m = mach_at(px, py);
    if (m >= 0) {
        "hdesk: ff chose window {pl_mwin[m]}\n";
        pl_window(pl_mwin[m]);
        return;
    }
    if (px < 16 || py < 16 || px >= w / sc - 16 || py >= plane_h() / sc - 16) { pl_shut(false); }
}

// --- the machine region's body (FF-5, section 3: desktops, grants, the month, the windows) ---

const I64 WS_H = 42;        // a desktop's cell
const I64 GR_H = 34;        // a grant's row
const I64 MW_H = 38;        // a window's row
const I64 MC_W = 28;        // the month's day cell
const I64 MC_H = 20;

I64 m_cells_y(in I64[4] b) { return plane.body_y(b[1]) + 8 + 18; }
I64 m_grants_y(in I64[4] b) { return m_cells_y(b) + WS_H + 16; }
I64 m_split(in I64[4] b) { return b[0] + 10 + (b[2] - b[0] - 20) * 56 / 100; }

// The granted windows, one entry a grant held: the window into wins[k] and its grant (1 disk, 2 net) into gs[k],
// the disk's first, each by window number; the count. The one list of who holds what (KD-1 A): the machine region
// draws it, and the system panel (SP-4) reads it.
I64 grant_list(inout I64[32] wins, inout I64[32] gs) {
    I64 n = 0;
    for g in 1..3 {
        for i in 0..WINDOWS {
            if (listed(i) && (gw[i] & g) != 0) {
                wins[n] = i;
                gs[n] = g;
                n = n + 1;
            }
        }
    }
    return n;
}

I64 m_grant_rows() {
    I64[32] wins;
    I64[32] gs;
    return grant_list(wins, gs);
}

// The windows' list top: under the grants or the month, whichever is longer.
I64 m_wins_y(in I64[4] b) {
    I64 g = m_grant_rows();
    if (g < 1) { g = 1; }
    I64 gh = 18 + GR_H * g;
    I64 ch = 18 + MC_H * 7;
    if (ch > gh) { gh = ch; }
    return m_grants_y(b) + gh + 16;
}

// The machine window row under (x, y), or -1 (the field empty).
I64 mach_at(I64 x, I64 y) {
    if (plane.query_len() != 0) { return -1; }
    I64[4] b;
    plane.machine_box(b);
    I64 top = m_wins_y(b) + 18;
    if (x < b[0] + 10 || x >= b[2] - 10 || y < top) { return -1; }
    I64 k = (y - top) / MW_H;
    if (k >= pl_mn || top + MW_H * (k + 1) > b[3]) { return -1; }
    return k;
}

void m_text(I64 y, I64 x0, I64 ty, I64 x1, in U8[_] t, I64 n, U32 c, I64 f) {
    I64 e = txt(y, x0, ty, x1, t, n, c, f);
}

void m_icon(I64 y, I64 x0, I64 y0, I64 k) {
    U32[7] pal;
    pal[0] = 0;
    pal[1] = tok(tokens.PAPER);
    pal[2] = tok(tokens.INK);
    pal[3] = tok(tokens.ULTRAMARINE);
    pal[4] = tok(tokens.SIENNA);
    pal[5] = tok(tokens.OCHRE);
    pal[6] = tok(tokens.CADMIUM);
    icons.icon_at(row, y, x0, y0, k, 32, pal);
}

// Row y (the plane's, 1x) of the machine region's body.
void machine_row(I64 y) {
    I64[4] b;
    plane.machine_box(b);
    I64 x0 = b[0] + 10;
    I64 x1 = b[2] - 10;
    I64 top = plane.body_y(b[1]) + 8;
    if (y < top || y >= b[3] - 1) { return; }
    U32 ink = tok(tokens.INK);
    U32 dim = tok(tokens.INK_DIM);
    U8[96] t;
    I64 n = 0;
    m_text(y, x0, top, x1, b"WORKSPACES (1..9)", 17, dim, faces.LABEL);
    I64 cy = m_cells_y(b);
    I64 cw = (x1 - x0) / 9;
    for d in 1..10 {
        I64 cx = x0 + cw * (d - 1);
        I64 c = 0;
        for i in 0..WINDOWS {
            if (listed(i) && wdesk[i] == d) { c = c + 1; }
        }
        U32 fg = dim;
        if (c > 0) { fg = ink; }
        if (d == cur) {
            draw.rect(row, y, cx, cy, cx + cw - 4, cy + WS_H, tok(tokens.FILL));
            fg = tok(tokens.ON_FILL);
        } else {
            draw.frame(row, y, cx, cy, cx + cw - 4, cy + WS_H, 1, tok(tokens.RULE));
        }
        t[0] = '#';
        t[1] = (48 + d) as U8;
        m_text(y, cx + 6, cy + 5, cx + cw - 6, t, 2, fg, faces.NAME);
        n = put_text(t, digits(t, 0, c), b"w");
        m_text(y, cx + 6, cy + 22, cx + cw - 6, t, n, fg, faces.PATH);
    }
    I64 gy = m_grants_y(b);
    I64 gx1 = m_split(b);
    m_text(y, x0, gy, gx1, b"ACTIVE GRANTS (KD-1 A)", 22, dim, faces.LABEL);
    I64 ry = gy + 18;
    I64[32] gwin;
    I64[32] gg;
    I64 gn = grant_list(gwin, gg);
    if (gn == 0) { m_text(y, x0 + 4, ry + 8, gx1, b"none", 4, dim, faces.BODY); }
    for q in 0..gn {
        I64 i = gwin[q];
        I64 g = gg[q];
        draw.frame(row, y, x0, ry, gx1, ry + GR_H - 4, 1, tok(grant_tok(g)));
        draw.rect(row, y, x0, ry, x0 + 4, ry + GR_H - 4, tok(grant_tok(g)));
        if (g == 1) { n = put_text(t, 0, b"[DISK] "); } else { n = put_text(t, 0, b"[NET] "); }
        U8[96] wt;
        I64 wn = win_text(i, wt);
        for k in 0..wn {
            if (n < 96) {
                t[n] = wt[k];
                n = n + 1;
            }
        }
        m_text(y, x0 + 12, ry + 9, gx1 - 90, t, n, ink, faces.NAME);
        U8[24] sd;
        I64 sl = pid_text(i, sd);
        m_text(y, gx1 - 8 - txt_w(sd, sl, faces.PATH), ry + 9, gx1 - 8, sd, sl, dim, faces.PATH);
        ry = ry + GR_H;
    }
    machine_month(y, gx1 + 16, gy, x1);
    I64 wy = m_wins_y(b);
    I64 we = txt(y, x0, wy, x1, b"WINDOWS", 7, dim, faces.LABEL);   // the heading, then its note in BODY
    m_text(y, we + 8, wy, x1, b"(by desktop . Enter restores and focuses)", 41, dim, faces.BODY);
    for k in 0..pl_mn {
        I64 i = pl_mwin[k];
        I64 my0 = wy + 18 + MW_H * k;
        if (my0 + MW_H <= b[3] && y >= my0 && y < my0 + MW_H - 2) {
            if (k == pl_msel) {
                draw.rect(row, y, x0, my0, x1, my0 + MW_H - 2, tok(tokens.SURF2));
                draw.frame(row, y, x0, my0, x1, my0 + MW_H - 2, 1, tok(tokens.ULTRAMARINE));
            }
            m_icon(y, x0 + 4, my0 + 2, win_icon(i));
            t[0] = '#';
            t[1] = (48 + wdesk[i]) as U8;
            m_text(y, x0 + 44, my0 + 11, x0 + 70, t, 2, dim, faces.NAME);
            n = win_text(i, t);
            m_text(y, x0 + 76, my0 + 11, x1 - 200, t, n, ink, faces.NAME);
            U8[24] sd;
            I64 sl = pid_text(i, sd);
            I64 pw = txt_w(sd, sl, faces.PATH);
            m_text(y, x1 - 8 - pw, my0 + 11, x1 - 8, sd, sl, dim, faces.PATH);
            if (wmode[i] == layout.MINIMIZED) {   // 24 px left of the pid
                I64 mx1 = x1 - 8 - pw - 24;
                m_text(y, mx1 - txt_w(b"minimized", 9, faces.BODY), my0 + 11, mx1, b"minimized", 9, tok(tokens.OCHRE),
                       faces.BODY);
            }
        }
    }
}

// The month of today (K-6) from x0, its top y0, to x1: the month and year, the weekdays, the weeks, today filled.
void machine_month(I64 y, I64 x0, I64 y0, I64 x1) {
    if (y < y0 || y >= y0 + 18 + MC_H * 7) { return; }
    I64[4] v;
    civil.from_days(now_l() / 86400, v);
    U8[32] t;
    for k in 0..9 { t[k] = b"JANUARY  FEBRUARY MARCH    APRIL    MAY      JUNE     JULY     AUGUST   SEPTEMBEROCTOBER  NOVEMBER DECEMBER "[9 * (v[1] - 1) + k]; }
    I64 n = 9;
    while (t[n - 1] == ' ') { n = n - 1; }
    t[n] = ' ';
    n = digits(t, n + 1, v[0]);
    m_text(y, x0, y0, x1, t, n, tok(tokens.INK_DIM), faces.LABEL);
    for d in 0..7 {
        t[0] = b"SuMoTuWeThFrSa"[2 * ((d + ck_week) % 7)];   // Week Starts On: Monday's column first
        t[1] = b"SuMoTuWeThFrSa"[2 * ((d + ck_week) % 7) + 1];
        m_text(y, x0 + MC_W * d, y0 + 18, x0 + MC_W * (d + 1), t, 2, tok(tokens.INK_DIM), faces.BODY);
    }
    I64[4] f;
    civil.from_days(civil.epoch_seconds(v[0], v[1], 1, 0, 0, 0) / 86400, f);
    I64 days = civil.month_days(v[0], v[1]);
    for day in 1..days + 1 {
        I64 c = (f[3] - ck_week + 7) % 7 + day - 1;
        I64 cx = x0 + MC_W * (c % 7);
        I64 cy = y0 + 18 + MC_H * (1 + c / 7);
        U32 fg = tok(tokens.INK);
        if (day == v[2]) {
            draw.rect(row, y, cx - 2, cy - 2, cx + MC_W - 4, cy + MC_H - 4, tok(tokens.FILL));
            fg = tok(tokens.ON_FILL);
        }
        n = digits(t, 0, day);
        m_text(y, cx, cy, cx + MC_W, t, n, fg, faces.PATH);
    }
}

// --- the calendar (RS-CAL, frame 44: kit/calpop.ci) ---

// The month shown, logged: `hdesk: calendar Y-MM first F days N today T` (F the 1st's weekday, 0 Sunday).
void cal_show() {
    I64 cy = calpop.year();
    I64 cm = calpop.month();
    "hdesk: calendar {cy}-{cm:02} first {calpop.first()} days {calpop.days()} today {calpop.today()}\n";
    redraw_overlay();
}

// Opened on today's month under the bar's clock (its right edge 8 in from the screen's, its top 8 under the bar), in
// the machine's zone (RS-TZc, /home/.daphnis-zone; UTC without one), the first column the account's Week Starts On;
// not over the switcher, in place of the menu.
I64 cal_zone = -1;

void cal_show_now() {
    if (sw_open) { return; }
    mn_open = false;
    mn_app = false;
    sp_open = false;
    tr_open = false;
    I64 z = am_z();
    cal_zone = zonefile.city();
    calpop.open(cal_zone, now_s, ck_week, (w - 8 * sc) / z, (bar_h() + 8 * sc) / z);
    cal_open = true;
    "hdesk: calendar open\n";
    relayout();
    cal_show();
}

void cal_close() {
    calpop.close();
    cal_open = false;
    "hdesk: calendar closed\n";
    redraw_overlay();
}

// What a press or a key answered: CLOSE closes it; DRAW shows the month it now shows.
void cal_answer(I64 r) {
    if (r == calpop.CLOSE) {
        cal_close();
    } else if (r == calpop.DRAW) {
        cal_show();
    }
}

// A press in the calendar: a chevron steps the month, the month's name goes to today's month (kit/calpop.ci).
void cal_click() {
    I64 z = am_z();
    cal_answer(calpop.click(mx / z, my / z));
}

// The window nearest the focused one's center in the direction of the arrow, or -1.
I64 toward(I64 code) {
    I64 f = focused();
    if (f < 0) { return -1; }
    I64 fx = 2 * layout.frame_x(f) + layout.frame_w(f);
    I64 fy = 2 * layout.frame_y(f) + layout.frame_h(f);
    I64 best = -1;
    I64 bd = 0;
    for i in 0..WINDOWS {
        if (shown(i) && i != f) {
            I64 x = 2 * layout.frame_x(i) + layout.frame_w(i);
            I64 y = 2 * layout.frame_y(i) + layout.frame_h(i);
            Bool ok = (code == KEY_LEFT && x < fx) || (code == KEY_RIGHT && x > fx) || (code == KEY_UP && y < fy) ||
                (code == KEY_DOWN && y > fy);
            I64 d = (x - fx) * (x - fx) + (y - fy) * (y - fy);
            if (ok && (best < 0 || d < bd)) {
                best = i;
                bd = d;
            }
        }
    }
    return best;
}

// A float's frame kept on the plane, at least 8 x 3 cells and at most the plane.
void keep_float(I64 i) {
    if (wfw[i] < 8 * SNAP_W * sc) { wfw[i] = 8 * SNAP_W * sc; }
    if (wfh[i] < 3 * SNAP_H * sc + WBAR * sc) { wfh[i] = 3 * SNAP_H * sc + WBAR * sc; }   // and its bar (WB-1)
    if (wfw[i] > w) { wfw[i] = w; }
    if (wfh[i] > plane_h()) { wfh[i] = plane_h(); }
    if (wfx[i] < 0) { wfx[i] = 0; }
    if (wfy[i] < bar_h()) { wfy[i] = bar_h(); }
    if (wfx[i] + wfw[i] > w) { wfx[i] = w - wfw[i]; }
    if (wfy[i] + wfh[i] > h) { wfy[i] = h - wfh[i]; }
}

Bool arrow(I64 code) { return code == KEY_LEFT || code == KEY_RIGHT || code == KEY_UP || code == KEY_DOWN; }
I64 dx_of(I64 code) {
    if (code == KEY_LEFT) { return -1; }
    if (code == KEY_RIGHT) { return 1; }
    return 0;
}
I64 dy_of(I64 code) {
    if (code == KEY_UP) { return -1; }
    if (code == KEY_DOWN) { return 1; }
    return 0;
}

// A Super chord (or the menu's command) with Shift `sh` and Ctrl `ct`.
void chord(I64 code, Bool sh, Bool ct) {
    I64 f = focused();
    if (arrow(code) && sh && f >= 0) {
        if (wmode[f] == layout.FLOAT) {
            wfx[f] = wfx[f] + SNAP_W * sc * dx_of(code);
            wfy[f] = wfy[f] + SNAP_H * sc * dy_of(code);
            keep_float(f);
        } else if (wmode[f] == layout.TILED) {
            I64 t = toward(code);
            if (t < 0 || wmode[t] != layout.TILED) { return; }
            I64 r = wrank[t];        // the two swap cells
            wrank[t] = wrank[f];
            wrank[f] = r;
            "hdesk: swap {f} {t}\n";
        } else {
            return;
        }
    } else if (arrow(code) && ct && f >= 0) {
        if (wmode[f] != layout.FLOAT) { return; }
        wfw[f] = wfw[f] + SNAP_W * sc * dx_of(code);
        wfh[f] = wfh[f] + SNAP_H * sc * dy_of(code);
        keep_float(f);
    } else if (code == KEY_C) {
        if (cal_open) { cal_close(); } else { cal_show_now(); }
        return;
    } else if (code == KEY_SLASH) {
        ks_open();                     // frame 27: the shortcut sheet
        return;
    } else if (code == KEY_COMMA) {
        settings_open(true);           // FF-5: Settings' chord, as the plane names it; DN-20: a Super chord tiles
        return;
    } else if (code == KEY_ENTER) {
        I64 t = new_term(true, apps.NONE);   // DN-20: a Super chord opens a tile
    } else if ((code == KEY_Q || code == KEY_R) && sh) {
        I64 a = 3;
        if (code == KEY_R) { a = 2; }
        pw_chord(a);                   // FF-R6 B: Super+Shift+Q shuts down, Super+Shift+R restarts, each pressed twice
        return;
    } else if (code == KEY_Q && f >= 0 && (kind[f] == SETTINGS || kind[f] == FAULT)) {
        close_window(f);
    } else if (code == KEY_Q && f >= 0) {
        if (info(f)) {
            "hdesk: end {f} pid {vpid[f]}\n";
            I64 st = tilectl.stop(vpid[f], SIGTERM);
        }
        return;
    } else if (code == KEY_LEFT || code == KEY_RIGHT || code == KEY_UP || code == KEY_DOWN) {
        I64 t = toward(code);
        if (t < 0) { return; }
        Bool up = raise(t);
    } else if (code >= 2 && code <= 10 && sh && f >= 0) {
        wdesk[f] = code - 1;
        desk_to(code - 1, f);          // MS-7: the window rides the slide to its desktop
    } else if (code >= 2 && code <= 10) {
        desk_to(code - 1, -1);         // MS-7 (DN-54): Super+1 to 9 slide
    } else if (code == KEY_F && f >= 0) {
        ranks = ranks + 1;
        if (wmode[f] == layout.FLOAT) {
            wmode[f] = layout.TILED;
            wrank[f] = ranks;          // a float snapped back takes the last cell
        } else {
            wmode[f] = layout.FLOAT;
            wrank[f] = ranks;
            wfw[f] = w / 2;
            wfh[f] = plane_h() / 2;
            wfx[f] = (w - wfw[f]) / 2;
            wfy[f] = bar_h() + (plane_h() - wfh[f]) / 2;
        }
    } else if ((code == KEY_EQUAL && sc < SCALES) || (code == KEY_MINUS && sc > 1)) {
        sc = sc + 1;
        if (code == KEY_MINUS) { sc = sc - 2; }
        set_scale();
        return;
    } else if (code == KEY_Z && f >= 0) {
        if (wmode[f] == layout.MONOCLE && wprev[f] == layout.FLOAT) {
            restore_float(f);          // DN-21: its frame from before, over 200 ms
            "hdesk: fullscreen {f} off\n";
        } else if (wmode[f] == layout.MONOCLE) {
            // WB-1: back as it was, tiled, in its cell
            wrank[f] = stack.unfull(wmode[f], wprev[f], wrank[f], wtrank[f]);
            wmode[f] = wprev[f];
            "hdesk: fullscreen {f} off\n";
        } else {
            wprev[f] = wmode[f];
            wtrank[f] = wrank[f];
            wmode[f] = layout.MONOCLE;
            "hdesk: fullscreen {f} on\n";
            Bool up = raise(f);        // HX-1: over the floats
        }
    } else if (code == KEY_M && sh) {
        I64 best = -1;
        for i in 0..WINDOWS {
            if (listed(i) && wdesk[i] == cur && wmode[i] == layout.MINIMIZED && (best < 0 || minned[i] > minned[best])) {
                best = i;
            }
        }
        if (best < 0) { return; }
        wmode[best] = layout.TILED;
        Bool up = raise(best);
    } else if (code == KEY_M && f >= 0 && wmin[f]) {
        tin[f] = true;                 // SP-6 (DN-16): its program asked that it minimize to the tray
        "hdesk: tray {f} minimized\n";
        Bool c = tray_scan();
        relayout();
        bar(true);
        redraw();
    } else if (code == KEY_M && f >= 0) {
        mins = mins + 1;
        minned[f] = mins;
        wrank[f] = stack.unfull(wmode[f], wprev[f], wrank[f], wtrank[f]);   // a fullscreen tile: its cell back
        wmode[f] = layout.MINIMIZED;
        I64 n = layout.entries(cur);
        I64 next = -1;
        for k in 0..n {
            I64 e = layout.entry(cur, k);
            if (next < 0 && e != f && wmode[e] != layout.MINIMIZED) { next = e; }
        }
        if (next >= 0) { Bool up = raise(next); }   // the next most recent shown window takes the focus
    } else {
        return;
    }
    redraw();
}

// Each pixel window whose content box changed since its client was last told: EV_WIN_RESIZE (code w, value h) into
// its queue; the kernel delivers it only to a client that asked FBIO_TILE_RESIZE (1 otherwise). The box is in 1x
// pixels (the device box over the UI scale), the surface a client asks to fill it at that scale (RS-SURF). A
// window's first layout is told only when its box is not the surface it asked (opened tiled or maximized) (HX-4).
void resizes() {
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL && layout.is_live(i) && wmode[i] != layout.MINIMIZED) {
            I64 cw = cbw(i) / sc;
            I64 ch = cbh(i) / sc;
            Bool moved = rbw[i] > 0 && (cw != rbw[i] || ch != rbh[i]);
            Bool first = rbw[i] == 0 && psw[i] > 0 && (cw != psw[i] || ch != psh[i]);
            if (moved || first) {
                put_word(req, 0, pid[i]);
                put_word(req, 1, EV_WIN_RESIZE | (cw << 16));
                put_word(req, 2, ch);
                I64 st = tilectl.tile_ctl(FBIO_TILE_INPUT, req);
                "hdesk: resize {i} {cw}x{ch} ({st})\n";
            }
            rbw[i] = cw;
            rbh[i] = ch;
        }
    }
}

void forward(I64 k, I64 code, I64 value) {
    I64 f = focused();
    if (f < 0 || kind[f] != PIXEL) { return; }
    put_word(req, 0, pid[f]);
    put_word(req, 1, k | (code << 16));
    put_word(req, 2, value & 0xFFFFFFFF);
    I64 st = tilectl.tile_ctl(FBIO_TILE_INPUT, req);
}

// The menu's selected entry acted on: a window focused on its desktop (restored when minimized), or a command.
void menu_choose() {
    if (n_shown == 0) {
        menu_close();
        return;
    }
    I64 k = shown_it[mn_sel];
    mn_open = false;
    mn_app = false;
    "hdesk: menu chose {k} |";
    I64 put = ptyctl.pty_write(1, it_label[96 * k..96 * k + it_len[k]]);
    "|\n";
    I64 r = it_ref[k];
    if (it_kind[k] == 3) {
        if (r < 0) { chord(0 - r, true, false); } else { chord(r, false, false); }
        redraw();
        return;
    }
    if (kind[r] != NONE) {
        jump_to(r);
        Bool up = raise(r);            // HX-1
    }
    redraw();
}

// A click in the open menu (H-4): the entry under the arrow chosen; a heading or the query, nothing.
void menu_click() {
    if (mn_app) {                      // AM-1: the kit's hit; outside the plates it closes
        am_by_key = false;
        I64 z = am_z();
        am_answer(ctxmenu.click(mx / z, my / z));
        return;
    }
    I64 r = (my - layout.frame_y(OV) - 8 * sc) / (MR * sc);
    if (my < layout.frame_y(OV) + 8 * sc || r >= n_rows || row_what[r] < 0) { return; }
    for q in 0..n_shown {
        if (shown_it[q] == row_what[r]) { mn_sel = q; }
    }
    menu_choose();
}

void menu_key(I64 code) {
    if (mn_app) {                      // AM-1: the kit's keys
        am_by_key = true;
        am_answer(ctxmenu.key(code));
        return;
    }
    if (code == KEY_ESC) {
        menu_close();
    } else if (code == KEY_ENTER) {
        menu_choose();
    } else if (code == KEY_UP || code == KEY_DOWN) {
        if (n_shown > 0) { mn_sel = (mn_sel + dy_of(code) + n_shown) % n_shown; }
        menu_show();
    } else if (code == KEY_BACKSPACE) {
        if (qlen > 0) { qlen = qlen - 1; }
        mn_sel = 0;
        menu_filter();
        menu_show();
    } else {
        I64 b = keymap.byte_of(code, shift, ctrl);
        if (b >= 32 && b <= 126 && qlen < 31) {
            query[qlen] = b as U8;
            qlen = qlen + 1;
            mn_sel = 0;
            menu_filter();
            menu_show();
        }
    }
}

// --- Settings (HX-13, HX-14) ---

// Settings opened, or brought forward when open: DN-20, a tile when a Super chord (Super+,) opens it, else a float
// (the panel's link, the Grants pill, the plane).
void settings_open(Bool tiled) {
    if (st_win >= 0) {
        desk_to(wdesk[st_win], -1);    // MS-7: the switch slides
        if (wmode[st_win] == layout.MINIMIZED) { wmode[st_win] = layout.FLOAT; }
        Bool up = raise(st_win);
        redraw();
        return;
    }
    I64 i = free_window();
    if (i < 0) {
        "hdesk: no room for settings\n";
        return;
    }
    kind[i] = SETTINGS;
    wdesk[i] = cur;
    // DN-6 frame 11: a 720 x 480 float, its ask; DN-21 places it
    if (tiled) {
        wmode[i] = layout.TILED;
        unmax_for_tile();
    } else {
        float_open(i, win_app(i), ST_W * sc, ST_H * sc);
    }
    ranks = ranks + 1;
    wrank[i] = ranks;
    st_win = i;
    st_menu = false;
    st_opening = true;                 // frame 48: opened on Display at its first box; stbox.open decides where the
    st_open_p = stside.DISPLAY;        // keyboard starts (ST-K1)
    st_shape = res_group(w, h);
    // HX-13: one firmware mode (no Bochs display) answers any switch -95 before its bounds; with one, 0 x 0 is
    // refused (-22) before the display is touched. The kernel hides the arrow for the ask, so it is shown again.
    I64 pr = hdeskctl.tile_ask(FBIO_TILE_MODE, 0, 0, ask[0..32]);
    st_fixed = pr == -95;
    pshown = false;
    if (pvis) { pointer(true); }
    "hdesk: settings {i}\n";
    if (st_fixed) { "hdesk: settings one mode\n"; }
    layout.focus(i);
    redraw();
}

// HX-8: the UI scale is sc now: the plane starts under the taller bar, every terminal reflows to the larger face.
void set_scale() {
    layout.set_scale(sc);
    "hdesk: scale {sc}\n";
    bar_len = -1;
    redraw();
    if (pvis) { pointer(true); }         // the arrow at the new scale
}

// HX-13, DN-10: the screen switched to nw x nh (not saved: FBIO_TILE_SAVE on Keep, PR 248); the desk maps the
// framebuffer again and lays itself out at it. A
// refused size (-95: one firmware mode, HX-13; -22: outside rt/fb.c's bounds) leaves the old mode, with no revert
// prompt; one firmware mode makes Settings read-only from then on. The status.
I64 apply_mode(I64 nw, I64 nh) {
    if (!mode_fits(nw, nh)) {
        "hdesk: mode {nw}x{nh} refused (RES-1)\n";   // not asked: the kernel would say -22
        return -22;
    }
    sh_drop();                         // RS-SHOT: the held screen is the old size, and so is the plate's place
    st_last = hdeskctl.tile_ask(FBIO_TILE_MODE, nw, nh, ask[0..32]);
    "hdesk: mode {nw}x{nh} ({st_last})\n";
    if (st_last == -95) { st_fixed = true; }
    if (st_last != 0) {
        redraw();
        return st_last;
    }
    I64 rm = hdeskctl.fb_remap();
    w = dev.fb_word(0) as I64;
    h = dev.fb_word(1) as I64;
    layout.resize(w, h);
    sc = auto_scale(w, h);
    layout.set_scale(sc);
    pshown = false;                    // the kernel hid the arrow at the switch
    if (mx > w - 1) { mx = w - 1; }
    if (my > h - 1) { my = h - 1; }
    "hdesk: screen {w}x{h} plane {w}x{plane_h()} ({rm})\n";
    if (st_win >= 0) {
        wfw[st_win] = ST_W * sc;
        wfh[st_win] = ST_H * sc;
        wfx[st_win] = (w - wfw[st_win]) / 2;
        wfy[st_win] = bar_h() + (plane_h() - wfh[st_win]) / 2;
        keep_float(st_win);
    }
    offer();
    bar_len = -1;
    redraw();
    if (pvis) { pointer(true); }
    return 0;
}

// DN-10's revert rule: a new size asks "Keep this resolution?"; Enter keeps it, Esc or 15 s (RV_MS, or 1500 stepped
// frames) bring the old one back. `hdesk: revert ask WxH from WxH`, `hdesk: revert kept`, `hdesk: revert back (S)`.
void res_pick(I64 k) {
    I64 ow = w;
    I64 oh = h;
    if (RES_W[k] == w && RES_H[k] == h) { return; }
    if (apply_mode(RES_W[k], RES_H[k]) != 0) { return; }
    rv_open = true;
    rv_w = ow;
    rv_h = oh;
    rv_t0 = wall.wall_ns();
    rv_k = 0;
    "hdesk: revert ask {w}x{h} from {ow}x{oh}\n";
    redraw_overlay();
}

// DN-10, RES-1 (PR 248): what the revert prompt does for key (KEY_ENTER, KEY_ESC, or 0 for a tick) at ms
// milliseconds after it asked: RV_WAIT, RV_KEEP (save the size: FBIO_TILE_SAVE) or RV_BACK (switch back, no save).
// The 15 s are up before any key.
I64 rv_plan(I64 key, I64 ms) {
    if (rv_secs(ms) == 0) { return RV_BACK; }
    if (key == KEY_ENTER) { return RV_KEEP; }
    if (key == KEY_ESC) { return RV_BACK; }
    return RV_WAIT;
}

// The bar message for FBIO_TILE_SAVE's status st into t (0: none); its length.
I64 rv_note(I64 st, inout U8[_] t) {
    if (st == 0) { return 0; }
    return put_text(t, 0, b"Couldn't save the resolution.");
}

// The revert prompt answered by key (0: a tick). A switch never saves: Keep asks the kernel to write the size
// (FBIO_TILE_SAVE: 0, -30 no writable volume, -5 the write failed), and a failed save says so on the bar; Esc or
// the 15 s switch back with no save.
void rv_answer(I64 key) {
    if (!rv_open) { return; }
    I64 ms = rv_k * 10;
    if (!stepped) { ms = (wall.wall_ns() - rv_t0) / 1000000; }
    I64 a = rv_plan(key, ms);
    if (a == RV_WAIT) { return; }
    rv_open = false;
    if (a == RV_KEEP) {
        I64 sv = hdeskctl.tile_ask(FBIO_TILE_SAVE, 0, 0, ask[0..32]);
        "hdesk: revert kept, saved ({sv})\n";
        U8[48] t;
        I64 n = rv_note(sv, t);
        if (n > 0) {
            msg_show(t[0..n]);
            return;
        }
        redraw_overlay();
        return;
    }
    I64 st = apply_mode(rv_w, rv_h);
    "hdesk: revert back ({st})\n";
    st_shape = res_group(w, h);
    redraw_overlay();
}

// The seconds the revert prompt has left, 15 to 1.
I64 rv_left() {
    I64 ms = rv_k * 10;
    if (!stepped) { ms = (wall.wall_ns() - rv_t0) / 1000000; }
    return rv_secs(ms);
}

void rv_tick(Bool step) {
    if (!rv_open) { return; }
    if (step) { rv_k = rv_k + 1; }
    I64 was = rv_shown;
    rv_shown = rv_left();
    if (rv_shown == 0) {
        rv_answer(0);
        return;
    }
    if (rv_shown != was) { redraw_overlay(); }
}

// K-3: theme t (tokens.DARK or LIGHT) from now on: the bar, the plane, every window and its terminal drawn again.
void theme_set(I64 t) {
    tokens.set_theme(t);
    "hdesk: theme {t}\n";
    bar_len = -1;
    redraw();
}

// RES-1: rt/fbmode.h's fb_mode_fits: whether the kernel programs mw x mh.
Bool mode_fits(I64 mw, I64 mh) {
    if (mw < 640 || mw > MODE_W_MAX || mw % 8 != 0 || mh < 480 || mh > MODE_H_MAX) { return false; }
    return mw * mh <= MODE_PX_MAX;
}

// DN-10: the revert prompt's seconds left after ms milliseconds, 15 down to 0 at RV_MS.
I64 rv_secs(I64 ms) {
    I64 s = (RV_MS - ms + 999) / 1000;
    if (s < 0) { s = 0; }
    return s;
}

// RES-1: the group (0 landscape, 1 ultrawide, 2 portrait, 3 legacy) holding w x h, else by its shape.
I64 res_group(I64 rw, I64 rh) {
    for g in 0..4 {
        for k in RES_AT[g]..RES_AT[g + 1] {
            if (RES_W[k] == rw && RES_H[k] == rh) { return g; }
        }
    }
    if (rh > rw) { return 2; }
    if (rw * 9 > rh * 21) { return 1; }
    return 0;
}

// --- Settings' frame and pages (frame 48, DN-58, DN-66: kit/stbox.ci, kit/stside.ci, kit/stpage.ci) ---
// The window's content box holds kit/stbox.ci's frame: the sidebar in DN-58's order and the page shown. Six pages are
// kits (Desk, Keyboard, Network, Date and Time, Storage, Accounts); Display, Sound, Grants and About are the desk's
// own rows (st_line), laid on the page kit's rhythm here. Every key goes to stbox first, then to the page (the host
// contract of the Tab order: Shift+Tab as stpage.K_BACKTAB; ENTER and ENTER_LAST move the keyboard into the page,
// and a page with no stop sends it back; BACK returns it to the sidebar); after a key the page takes, the frame
// reveals its focus. A page's own action (stpage.ACT and up) is st_act's.

// The page shown by the desk (a panel's link), opened at its top with no focus: a kit page by kit/sthost.ci, the
// desk's own here; before the first box, the page Settings opens on.
void st_show(I64 p) {
    if (st_opening) {
        st_open_p = p;
        "hdesk: settings page {p}\n";
        return;
    }
    sthost.show(p);
    st_opened(true);
}

// Settings' content box (x0, y0) to (xr, yb) at 1x: the first opens Settings in it (stbox.open), the rest place it.
void st_box(I64 x0, I64 y0, I64 xr, I64 yb) {
    if (st_opening) {
        st_opening = false;
        sthost.open(x0, y0, xr, yb, st_open_p);
        st_opened(false);
        return;
    }
    stbox.place(x0, y0, xr, yb);
}

// Window i's content box, for a key or a press before a row is drawn.
void st_box_of(I64 i) { st_box(cbx(i), cby(i), cbx(i) + cbw(i) / sc, cby(i) + cbh(i) / sc); }

// The page shown changed (say: log it): the desk's own page reset, its height given to the frame; a kit page fed
// what the desk knows.
void st_opened(Bool say) {
    I64 p = stbox.page();
    st_menu = false;
    dp_fs = 0;
    dp_kbd = false;
    if (sthost.desk_page(p)) { stbox.set_tall(dp_tall(p)); }
    if (say) { "hdesk: settings page {p}\n"; }
    if (p == stside.STORAGE) { st_storage(); }
    if (p == stside.NETWORK) {        // KF-3c: the network record, facts kind 3 (none on a kernel without it)
        U8[64] nb;
        sthost.network(factsctl.co_facts(3, 0, nb), nb);
    }
    if (p == stside.KEYBOARD) {       // RS-KR: the repeat, live when EVIOCGREP answers, faded on a kernel without it
        I64[2] kv;
        I64 kr = hdeskctl.rep_get(kv);
        if (kr == 0) {
            kr_delay = kv[0];
            kr_period = kv[1];
        }
        sthost.key_repeat(kr, kv);
    }
    if (p == stside.DATETIME) { st_time(); }
    if (p == stside.DESK) { st_pins(); }
    if (p == stside.ACCOUNTS) { st_accounts(); }
    if (p == stside.ABOUT) { st_about(); }
    if (p == stside.GRANTS) { st_grants(); }
}

// Storage (frame 38): the volume from statfs (none on a kernel without the call), then what the home holds and the
// Trash's entries, each read by a run as the account (user/ci/runas.h); the page draws as they come.
void st_storage() {
    I64[8] rec;
    sthost.volume(factsctl.co_statfs(b"/home", rec), rec);
    rn_queue(RUN_DU);
    rn_queue(RUN_TRASH_COUNT);
}

// The Storage page's facts are the session's own: the last account's walk and Trash count forgotten, so the page
// shows no row and Empty Trash stays dimmed (frame 23 never asks) until this session's runs as the account read
// them (logout and start_session; PR 412).
void st_storage_forget() {
    st_trash_n = 0;
    ststore.set_trash_entries(0);
    homeuse.start(b"", 0);             // no home walked: no part, no total
    ststore.walk_started();
    ststore.walk_done();               // the page takes that empty walk: no row shows
}

// --- BG-1: the account's background and Recent Files, from its own settings ---
// desk.background is swatch-0 to swatch-5 (frame 33's literal colors) or the absolute path of a PNG; anything else
// is the default, the mantle. The desk never opens the picture: bgread fits it as the account (RUN_PICTURE) and
// the desk takes its stream only when it is whole: the header's size the screen's, every pixel, status 0; else the
// default, with no message (DN-46). desk.recent-files 0 keeps no Recent Files in the plane. The settings are read
// again when a session begins, when the settings file's time moves (checked each minute and when the Desk page
// opens; the fsidx ring is drained only when the plane opens, FF-1), and when the Desk page changes one.
I64 st_trash_n = 0;                 // Storage: the Trash's entries, as finder --trash-count told them
I64 kr_delay = 500;                 // RS-KR: the repeat as last read or set, in ms
I64 kr_period = 33;
const I64 BG_MANTLE = 0;
const I64 BG_SWATCH = 1;
const I64 BG_PICTURE = 2;
const Bool BG_PICTURES = bgpic.PICTURES;   // colors only while false (option 3, until l's call): no picture run
I64 bg_kind = 0;
I64 bg_sw = 0;
U8[4097] bg_path;
I64 bg_pn = 0;
U8[8] bg_head;
I64 bg_got = 0;                     // the stream's bytes so far
I64 bg_w = 0;
I64 bg_h = 0;
Bool bg_ok = false;
Bool recent_on = true;
U64 bg_gen = 0;                     // the session whose settings were read
I64 bg_mtime = -1;                  // the settings file's time when they were read

// The picture's argument for RUN_PICTURE, "PATH\0W\0H", into a; its length, 0 with none.
I64 bg_arg(inout U8[_] a) {
    if (bg_kind != BG_PICTURE || bg_pn < 2 || w < 1 || h < 1 || w > 3840 || h > 3840 || w * h > 3840 * 2160) {
        return 0;
    }
    for k in 0..bg_pn { a[k] = bg_path[k]; }
    I64 n = bg_pn;
    a[n] = 0;
    n = digits(a, n + 1, w);
    a[n] = 0;
    return digits(a, n + 1, h);
}

// Bytes of the picture's stream: the header read, every byte counted. The pixels are not kept yet: a global holds
// at most 65536 elements in this cint, and the desk's own picture buffer waits for a plan call; until it lands a
// picture is drawn as the mantle, its stream still checked whole.
void bg_take(in U8[_] b) {
    for k in 0..len(b) {
        I64 at = bg_got + k;
        if (at < 8) {
            bg_head[at] = b[k];
            if (at == 7) { bg_size(); }
        }
    }
    bg_got = bg_got + len(b);
}

// The header's width and height, little-endian u32 each.
void bg_size() {
    bg_w = 0;
    bg_h = 0;
    for q in 0..4 {
        bg_w = bg_w | ((bg_head[q] as I64) << (8 * q));
        bg_h = bg_h | ((bg_head[4 + q] as I64) << (8 * q));
    }
}

// The ground of screen row y: the picture's row, the swatch, or the mantle.
void bg_row(I64 y) {
    if (bg_kind == BG_SWATCH) {
        draw.paint(row, 0, w, stdesk.swatch(bg_sw));
        return;
    }
    draw.paint(row, 0, w, tok(tokens.MANTLE));
}

// The settings file's time, -1 when it cannot be had.
I64 bg_file_time() {
    U8[64] home;
    I64 hn = session_home(home);
    if (hn == 0) { return -1; }
    U8[4200] p;
    I64 pn = setfile.path(home[0..hn], p);
    if (pn < 0) { return -1; }
    I64[16] rec;
    if (corectl.co_stat(p[0..pn], 0, rec) != 0) { return -1; }
    return rec[corectl.ST_MTIME];
}

// The account's background and Recent Files read again, when the session or the file's time changed (or always);
// whether they were. The caller draws again (never from inside a draw).
Bool bg_check(Bool always) {
    I64 mt = bg_file_time();
    if (!always && bg_gen == session_generation && mt == bg_mtime) { return false; }
    bg_gen = session_generation;
    bg_mtime = mt;
    bg_reload();
    return true;
}

void bg_reload() {
    bg_kind = BG_MANTLE;
    recent_on = true;
    U8[64] home;
    I64 hn = session_home(home);
    if (hn > 0 && pf_load() >= 0) {
        U8[4097] v;
        I64 vn = settings.get(b"desk.background", v);
        if (vn == 8 && v[0] == 's' && v[1] == 'w' && v[2] == 'a' && v[3] == 't' && v[4] == 'c' && v[5] == 'h'
            && v[6] == '-' && v[7] >= '0' && v[7] <= '5') {
            bg_kind = BG_SWATCH;
            bg_sw = v[7] as I64 - 48;
        } else if (BG_PICTURES && vn >= 2 && vn <= 4096 && v[0] == '/') {
            bg_kind = BG_PICTURE;
            for k in 0..vn { bg_path[k] = v[k]; }
            bg_pn = vn;
            bg_ok = false;
            rn_queue(RUN_PICTURE);
        }
        recent_on = settings.num(b"desk.recent-files", 1) != 0;
    }
    if (!recent_on) { plane.recents_clear(); }
    "hdesk: background {bg_kind} recent {recent_on as I64}\n";
}

// --- runs as the account (user/ci/runas.h, hdeskctl's run rows) ---

const I64 RUN_DU = 0;               // runas.h's fixed table
const I64 RUN_TRASH_COUNT = 1;
const I64 RUN_TRASH_EMPTY = 2;
const I64 RUN_SET = 3;
const I64 RUN_PICTURE = 4;
const I64 RUN_PEEK = 5;             // RG-1: finder --peek PATH, an open the desk cannot stat
U8[256] pk_path;                    // the path being peeked (a command line holds no longer one), its length, 0 none
I64 pk_n = 0;
I64 pk_ent = -1;                    // the index entry it came from, or -1 (pl_path's ent)
U8[513] pk_out;                     // the peek's answer: d, or f and a file's first 512 bytes
const I64 RUN_PREFS = 6;            // RG-1: setkey --print, the account's settings as its own process reads them
U8[8192] pf_text;                   // their text as the last read gave it (kit/settings.ci SIZE), pf_n bytes
I64 pf_n = 0;
U8[8192] pf_in;                     // the running read's bytes, pf_got of them, kept only when it ends whole
I64 pf_got = 0;
Bool pf_ok = false;                 // a read ended whole this session
I64 pk_got = 0;
U8[4200] rn_arg;                    // RUN_SET's "KEY\0VALUE" as kit/runq.ci gives it
const I64 RUN_END = 0 - 4096;       // run_poll's end: RUN_END less the exit status
U8[512] rn_line;                    // a line of the run's output being gathered
I64 rn_ln = 0;
Bool rn_long = false;               // the line passed rn_line: dropped whole

// The session's login record given to the runs (uid, gid, ceiling, home), as a terminal of the session gets it,
// keyed on the session's generation (kit/runrec.ci): a later session at the same index of the store gets its own;
// false with no account session (the record is then cleared).
Bool rn_record() {
    if (!ac_on || s_acct < 0) {
        rn_clear();
        return false;
    }
    I64 gen = session_generation as I64;
    if (!runrec.need(gen)) { return true; }
    U8[64] home;
    I64 n = cat(home, 0, b"/home/");
    for k in 0..acct.name_len(s_acct) { home[n + k] = acct.name_byte(s_acct, k); }
    n = n + acct.name_len(s_acct);
    U64 c = 7;
    if (acct.role_of(s_acct) != acct.PARENT) { c = acct.ceil_of(s_acct); }
    I64 r = hdeskctl.run_session(acct.uid_of(s_acct), acct.gid_of(s_acct), c as I64, home[0..n]);
    if (r != 0) {
        "hdesk: run record refused ({r})\n";
        runrec.cleared();
        return false;
    }
    runrec.given(gen, acct.uid_of(s_acct));
    return true;
}

// RG-1: path p (from pl_path, its entry ent) peeked as the session's account (runas.h RUN_PEEK); false with no
// account session or a path no command line could hold, and the open is then gone as before.
Bool pk_ask(in U8[_] p, I64 ent) {
    if (len(p) < 2 || len(p) > 256 || p[0] != '/' || !rn_record()) { return false; }
    if (pk_n > 0) {                        // one peek at a time: a second open while one is out is refused
        "hdesk: ff peek busy\n";
        return true;
    }
    for k in 0..len(p) { pk_path[k] = p[k]; }
    pk_n = len(p);
    pk_ent = ent;
    "hdesk: ff peek as uid {s_uid}\n";
    rn_queue(RUN_PEEK);
    return true;
}

// RG-1: the peek ended with status st: a folder sets the plane's field to it while the plane is open; a file opens
// in its program as pl_path opens one; a path the account cannot stat either is gone.
void pk_end(I64 st) {
    I64 n = pk_n;
    pk_n = 0;
    I64 got = pk_got;
    if (got > 513) { got = 0; }
    I64 kd = openas.GONE;
    if (st == 0 && n > 0) { kd = openas.kind(pk_out, got); }
    "hdesk: ff peeked {kd}\n";
    if (kd == openas.DIR) {
        if (pl_open) { pl_dir(pk_path[0..n]); }
    } else if (kd == openas.FILE) {
        pl_file(pk_path[0..n], pk_ent, pk_out[1..got]);
    } else {
        "hdesk: ff gone\n";
    }
    redraw();
}

// RG-1: the account's settings into kit/settings.ci's store, as its own run read them (RUN_PREFS); 0, or -1 before a
// read ended whole this session (the store empty: every reader runs on its defaults, as for a missing file).
I64 pf_load() {
    settings.clear();
    if (!pf_ok) { return -1; }
    I64 n = settings.read(pf_text[0..pf_n]);
    return 0;
}

// RG-1: the settings read ended with status st: kept when whole (status 0, within the cap), and the bar clock, the
// calendars, the background and Recent Files and Date and Time read them; a failed read keeps the last good one.
void pf_end(I64 st) {
    Bool same = pf_ok && st == 0 && pf_got == pf_n;
    if (st == 0 && pf_got <= 8192) {
        for k in 0..pf_got {
            if (same && pf_text[k] != pf_in[k]) { same = false; }
            pf_text[k] = pf_in[k];
        }
        pf_ok = true;
        pf_n = pf_got;
    }
    "hdesk: settings read {st} {pf_ok as I64} {pf_n}\n";
    clock_prefs();
    if (!same) { Bool b = bg_check(true); }   // the background and Recent Files: only when the text changed
    if (st_win >= 0 && stbox.page() == stside.DATETIME) {
        sttime.set_24(ck_h24);
        sttime.set_week(ck_week);
    }
    redraw();
}

// The session ended (logout, and every forced end through it): any run killed and reaped, the queue emptied, and
// the record cleared, so nothing more runs as the account that left.
void rn_clear() {
    pf_ok = false;                     // the settings of the account that left are never read again
    pf_n = 0;
    pk_n = 0;                          // a peek of the account that left is never opened
    I64 s0 = hdeskctl.run_stop();      // whatever runs, a write too, killed and reaped
    runq.clear();
    I64 r = hdeskctl.run_session(-1, 0, 0, b"");
    runrec.cleared();
}

// A setting of the account's own (U-SET) to write as the account: key k and value v as setkey's two words.
void rn_set(in U8[_] k, in U8[_] v) {
    Bool q = runq.set(k, v);           // the newest value per key waits; none is lost while another run goes
    rn_next();
}

// Job j queued (once), and the next started when none runs.
void rn_queue(I64 j) {
    Bool q = runq.want(j);
    rn_next();
}

// Job j queued (once), started by the caller's own rn_next (rn_end).
void rn_queue_only(I64 j) { Bool q = runq.want(j); }

void rn_next() {
    I64 j = runq.next();
    Bool going = j >= 0;
    while (going) {
        if (!rn_record()) {
            runq.clear();              // no account session: nothing can run as it
            pk_n = 0;
            return;
        }
        I64 r = 0 - 22;
        if (j == RUN_SET) {
            I64 n = runq.arg(rn_arg);
            if (n >= 0) { r = hdeskctl.run_start(j, rn_arg[0..n]); }
        } else if (j == RUN_PICTURE) {
            I64 n = bg_arg(rn_arg);
            if (n > 0) { r = hdeskctl.run_start(j, rn_arg[0..n]); }
            bg_got = 0;
        } else if (j == RUN_PEEK) {
            if (pk_n > 0) { r = hdeskctl.run_start(j, pk_path[0..pk_n]); }
            pk_got = 0;
        } else if (j == RUN_PREFS) {
            r = hdeskctl.run_start(j, b"");
            pf_got = 0;
        } else {
            r = hdeskctl.run_start(j, b"");
        }
        "hdesk: run {j} ({r})\n";
        if (r == 0) {
            runq.started(j);
            rn_ln = 0;
            rn_long = false;
            if (j == RUN_DU) {
                U8[64] home;
                I64 n = cat(home, 0, b"/home/");
                for k in 0..acct.name_len(s_acct) { home[n + k] = acct.name_byte(s_acct, k); }
                homeuse.start(home, n + acct.name_len(s_acct));
                ststore.walk_started();
            }
            going = false;
        } else {
            runq.refused(j);
            if (j == RUN_PEEK) {           // refused: the open is gone, and the next open may peek
                pk_n = 0;
                "hdesk: ff gone\n";
            }
            j = runq.next();
            going = j >= 0;
        }
    }
}

// Settings closed: the reads queued are dropped and a running read is stopped; a setkey run, Empty Trash and the
// settings still waiting go on (kit/runq.ci).
void rn_stop() {
    if (runq.close()) {
        I64 r = hdeskctl.run_stop();
        runq.ended();
    }
    rn_next();
}

// One whole line of the run's output: data for the page, never a path the desk opens.
void rn_take(in U8[_] l, I64 n) {
    if (runq.running() == RUN_DU) { Bool t = homeuse.line(l, n); }
    if (runq.running() == RUN_TRASH_COUNT) {
        I64 c = sthost.count_of(l, n);
        if (c >= 0) {
            ststore.set_trash_entries(c);
            st_trash_n = c;
        }
    }
}

// The run's output so far, line by line (a picture's stream counted); at its end the page is told and the next job
// starts. Drained once a tick, to the pipe's end: Daphnis's nanosleep only moves the caller's clock (and FS-R3's
// stamps), so the desk never sleeps here; RUN_PICTURE's total bound already allows a pipe's least rate.
U8[65536] rn_buf;
void rn_poll() {
    I64 g = hdeskctl.run_poll(rn_buf);
    while (g > 0) {
        if (runq.running() == RUN_PICTURE) {
            bg_take(rn_buf[0..g]);
        } else if (runq.running() == RUN_PEEK) {
            for k in 0..g {
                if (pk_got < 513) { pk_out[pk_got] = rn_buf[k]; }
                pk_got = pk_got + 1;   // past 513: runas.h's cap kills the run first (-E2BIG)
            }
        } else if (runq.running() == RUN_PREFS) {
            for k in 0..g {
                if (pf_got < 8192) { pf_in[pf_got] = rn_buf[k]; }
                pf_got = pf_got + 1;   // past 8192: runas.h's cap kills the run first (-E2BIG)
            }
        } else {
            for k in 0..g {
                if (rn_buf[k] == '\n') {
                    if (!rn_long) { rn_take(rn_line, rn_ln); }
                    rn_ln = 0;
                    rn_long = false;
                } else if (rn_ln < 512) {
                    rn_line[rn_ln] = rn_buf[k];
                    rn_ln = rn_ln + 1;
                } else {
                    rn_long = true;
                }
            }
        }
        g = hdeskctl.run_poll(rn_buf);
    }
    if (g < 0) { rn_end(g); }
}

// The run ended with g (RUN_END less its status, or a failure below it): the page told, the next job started.
void rn_end(I64 g) {
    I64 j = runq.running();
    runq.ended();
    I64 st = RUN_END - g;
    if (g > RUN_END) { st = g; }       // -E2BIG, -ETIMEDOUT and the like: the run was killed
    "hdesk: run {j} ended ({st})\n";
    if (j == RUN_DU) {
        homeuse.done();
        ststore.walk_done();
    }
    if (j == RUN_TRASH_EMPTY && st_win >= 0) {   // the page's numbers again, only while Settings is open
        rn_queue(RUN_TRASH_COUNT);
        rn_queue(RUN_DU);
    }
    if (j == RUN_PEEK) { pk_end(st); }
    if (j == RUN_SET && st == 0) { rn_queue_only(RUN_PREFS); }   // a setting written: read them again
    if (j == RUN_PREFS) { pf_end(st); }
    if (j == RUN_PICTURE) {
        bg_ok = st == 0 && bg_got == 8 + 4 * w * h && bg_w == w && bg_h == h;   // whole, exact, status 0
        "hdesk: background picture {bg_ok as I64} {bg_got}\n";
        redraw();
    }
    if (st_win >= 0) { redraw(); }
    rn_next();
}

// The focused row of the desk's own page shown, from its top, or -1.
I64 dp_focus_top() {
    if (dp_fs == 0) { return -1; }
    return stpage.row_y(stpage.BODY, dp_fs - 1);
}

I64 dp_focus_bottom() {
    if (dp_fs == 0) { return -1; }
    return stpage.row_y(stpage.BODY, dp_fs - 1) + stpage.ROW;
}

// A page's own action a (stpage.ACT and up): what each page asks the desk to do. Not wired yet: logged.
void st_act(I64 p, I64 a) {
    if (p == stside.DATETIME && (a == sttime.HOUR24 || a == sttime.WEEK)) {
        I64 v = sttime.arg();          // 24-Hour Time (1 or 0), Week Starts On (0 Sunday, 1 Monday): the account's
        U8[24] k = b"time.24-hour            ";   // own settings, written as the account by setkey (U-SET)
        I64 kn = 12;
        if (a == sttime.WEEK) {
            U8[24] wk2 = b"calendar.week-starts    ";
            for q in 0..24 { k[q] = wk2[q]; }
            kn = 20;
            sttime.set_week(v);
            ck_week = v % 2;           // the calendars at once; the read after setkey's write confirms it
        } else {
            sttime.set_24(v == 1);
            ck_h24 = v == 1;           // the bar clock at once, as the page
        }
        U8[2] d;
        d[0] = (48 + v % 10) as U8;
        rn_set(k[0..kn], d[0..1]);
        return;
    }
    if (p == stside.DATETIME && a == sttime.ZONE) {   // RS-ASK: the zone a parent approves (frame 17); the desk
        Bool asked = kp_ask_for(deskask.ZONE, sttime.arg());   // writes /home/.daphnis-zone at its tick (TZ-R1)
        "hdesk: settings zone {sttime.arg()} asked {asked as I64}\n";
        return;
    }
    if (p == stside.ACCOUNTS && a >= stacct.ADD && a <= stacct.REMOVE) {   // frame 34: through the accounts
        ac_op_page(a, stacct.arg(), stacct.arg2());   // operation (RS-AQ): its form, frame 17's approval, authd
        return;
    }
    if (p == stside.STORAGE && a == ststore.EMPTY && st_trash_n > 0) {   // frame 23 asks first (DN-69's words)
        indextrash.ask(indextrash.EMPTY_TRASH, st_trash_n, b"");
        "hdesk: empty trash ask {st_trash_n}\n";
        relayout();
        redraw();
        return;
    }
    if (p == stside.KEYBOARD && (a == stkeys.DELAY || a == stkeys.RATE)) {   // RS-KR: the desk sets the repeat
        if (a == stkeys.DELAY) { kr_delay = stkeys.arg(); }
        if (a == stkeys.RATE && stkeys.arg() > 0) { kr_period = 1000 / stkeys.arg(); }
        I64 r = hdeskctl.rep_set(kr_delay, kr_period);
        "hdesk: settings repeat {kr_delay} {kr_period} ({r})\n";
        return;
    }
    if (p == stside.DESK && a == stdesk.BG) {      // BG-1: a swatch, shown now and written as the account
        I64 k = stdesk.arg();
        if (k >= 0 && k <= 5) {
            bg_kind = BG_SWATCH;
            bg_sw = k;
            U8[8] v = b"swatch-0";
            v[7] = (48 + k) as U8;
            rn_set(b"desk.background", v);
            stdesk.set_background(k);
            redraw();
        }
        return;
    }
    if (p == stside.DESK && a == stdesk.RECENT) {  // BG-1: Recent Files on or off, kept none while off
        recent_on = stdesk.arg() == 1;
        if (!recent_on) { plane.recents_clear(); }
        if (recent_on) { rn_set(b"desk.recent-files", b"1"); } else { rn_set(b"desk.recent-files", b"0"); }
        stdesk.set_recent(recent_on);
        return;
    }
    if (p == stside.DESK && a == stdesk.UNPIN) {   // frame 33: off the Taskbar, as the plane's own Unpin
        I64 k = stdesk.arg();
        I64 s0 = plane.pinned_at(k);
        if (s0 >= plane.PIN_FILE) { plane.unpin(s0 - plane.PIN_FILE); }
        if (s0 >= 0 && s0 < plane.PIN_FILE) { Bool u = plane.unpin_app(s0); }
        "hdesk: settings unpin {k}\n";
        pins_tell_all();
        st_pins();
        stdesk.unpinned(k);
        return;
    }
    if (p == stside.DESK && a == stdesk.MOVE) {    // frame 33: a pin dragged to a new place in the list
        if (plane.pin_move(stdesk.arg(), stdesk.arg2())) {
            "hdesk: settings pin {stdesk.arg()} to {stdesk.arg2()}\n";
            pins_tell_all();
        }
        st_pins();
        return;
    }
    if (p == stside.KEYBOARD && a == stkeys.SHORTCUTS) {   // frame 27: Show All opens the shortcut sheet
        ks_open();
        return;
    }
    if (p == stside.ABOUT && a == stabout.LICENSES) {      // frame 31: the image's notices in Read
        "hdesk: settings licenses\n";
        pl_run(b"cless /etc/notices.txt");
        return;
    }
    if (p == stside.GRANTS && a == stgrant.REVOKE) {       // frame 21: one window's grants back (GV-R3)
        gr_revoke(stgrant.arg());
        gr_after();
        return;
    }
    if (p == stside.GRANTS && a == stgrant.REVOKE_ALL) {   // and every window's, one at a time
        for i in 0..WINDOWS { gr_revoke(i); }
        gr_after();
        return;
    }
    "hdesk: settings act {p} {a - stpage.ACT} not wired\n";
}

// Accounts (frame 34): the store's accounts in its order (ac_op_page's numbers), each its name, uid, role and
// ceiling word, the session's own marked; no passphrase or field of the store passes. Nothing with no store.
void st_accounts() {
    stacct.accounts_clear();
    if (ac_on) {
        for i in 0..acct.accounts() {
            U8[32] nm;
            I64 n = min(acct.name_len(i), 32);
            for k in 0..n { nm[k] = acct.name_byte(i, k); }
            Bool b = stacct.account(nm[0..n], n, acct.uid_of(i), acct.role_of(i), acct.ceil_of(i) as I64, i == s_acct);
        }
    }
    stacct.refreshed();
}

// Frame 23's answer r (indextrash.GO, CANCEL or STAY): Enter or the blue button empties the Trash as the account
// (runas.h RUN_TRASH_EMPTY, then the count and the walk again); Esc, Cancel or a click off it keeps everything.
void et_answer(I64 r) {
    if (r == indextrash.STAY) {
        redraw_overlay();
        return;
    }
    indextrash.close();
    if (r == indextrash.GO) {
        "hdesk: empty trash go\n";
        rn_queue(RUN_TRASH_EMPTY);
    } else {
        "hdesk: empty trash cancel\n";
    }
    relayout();
    redraw();
}

// Desk (frame 33): the Taskbar's pins in the plane's order, each its name and icon as the plane has them.
void st_pins() {
    if (ac_on && s_acct >= 0) { Bool c = bg_check(false); }
    I64 k = 0;                         // the swatch ringed: the one chosen, else the theme's mantle (dark 0, light 5)
    if (tokens.theme() != tokens.DARK) { k = 5; }
    if (bg_kind == BG_SWATCH) { k = bg_sw; }
    if (bg_kind == BG_PICTURE) { k = -1; }
    stdesk.set_background(k);
    stdesk.set_recent(recent_on);
    stdesk.set_pick_live(bgpic.PICTURES);   // Choose Picture faded and inert while pictures are off
    stdesk.pins_clear();
    for j in 0..plane.pinned_count() {
        I64 a = plane.pinned_at(j);
        U8[96] t;
        I64 n = plane.slot_name(a, t);
        Bool b = stdesk.pin(t[0..n], n, plane.slot_icon(a));
    }
}

// Date and Time (frames 36 and 47): the clock, the machine's zone (none: UTC), 24-Hour Time and Week Starts On from
// the account's own settings, as the account's run read them (RG-1, pf_load). Set is inert in 0.1.0
// (SETCLK-1: frame 36 draws no way to enter a time), faded with no caption. A zone choice asks a parent first.
void st_time() {
    clock_prefs();                     // RS-TZb: the bar clock reads as the page does
    sttime.set_now(now_s);
    sttime.set_zone(ck_zone);
    sttime.set_can_set(false);         // SETCLK-1: Set ships inert in 0.1.0, at 40 percent, no caption
    sttime.set_24(ck_h24);             // clock_prefs read both from the account's settings (pf_load)
    sttime.set_week(ck_week);
}

// The session's home, /home/NAME, into buf; its length, 0 with no account session.
I64 session_home(inout U8[64] buf) {
    if (!ac_on || s_acct < 0) { return 0; }
    I64 n = cat(buf, 0, b"/home/");
    for k in 0..acct.name_len(s_acct) { buf[n + k] = acct.name_byte(s_acct, k); }
    return n + acct.name_len(s_acct);
}

// --- frame 31: the About page's facts; frame 21: the Grants page's lines; frame 27: the shortcut sheet ---

// About (frame 31): version, build and compiler from the image's /etc/daphnis (tools/mkabout.py), the processor from
// facts kind 1, memory from sysinfo, the display's mode, the disk from statfs of /home when a volume is there. A fact
// the image or the kernel does not give is a row the page leaves out. Copy Details stays at 40 percent until the desk
// has a clipboard; Licenses works when the image holds its notices and Read.
void st_about() {
    stabout.clear();
    U8[256] b;
    I64 n = 0;
    I64 fd = shctl.sh_open(b"/etc/daphnis", 0, 0);
    if (fd >= 0) {
        n = shctl.fd_read(fd, b);
        I64 c = shctl.fd_close(fd);
    }
    I64 at = 0;
    while (at < n) {
        I64 e = at;
        while (e < n && b[e] != '\n') { e = e + 1; }
        I64 sp = at;
        while (sp < e && b[sp] != ' ') { sp = sp + 1; }
        if (sp < e) {
            I64 r = -1;
            if (sp - at == 7 && b[at] == 'v') { r = stabout.R_VERSION; }
            if (sp - at == 5 && b[at] == 'b') { r = stabout.R_BUILD; }
            if (sp - at == 8 && b[at] == 'c') { r = stabout.R_COMPILER; }
            if (r >= 0) { stabout.set_row(r, b[sp + 1..e], e - sp - 1); }
        }
        at = e + 1;
    }
    U8[80] cpu;
    I64 cr = factsctl.co_facts(1, 0, cpu);
    if (cr >= 56) {
        I64 th = 0;
        for k in 0..8 { th = th | ((cpu[48 + k] as I64) << (8 * k)); }
        stabout.set_processor(cpu[0..48], th);
    }
    I64[5] si;
    if (sysinfoctl.co_sysinfo(si) == 0) { stabout.set_memory(si[sysinfoctl.SI_TOTALRAM] * si[sysinfoctl.SI_MEM_UNIT]); }
    stabout.set_display(w, h);
    I64[8] rec;
    if (factsctl.co_statfs(b"/home", rec) == 0 && rec[factsctl.SF_TYPE] != factsctl.RAMFS && rec[factsctl.SF_BSIZE] > 0
        && rec[factsctl.SF_BSIZE] % 1024 == 0) {
        I64 u = rec[factsctl.SF_BSIZE] / 1024;
        stabout.set_disk(rec[factsctl.SF_BLOCKS] * u, rec[factsctl.SF_BAVAIL] * u);
    }
    I64[16] st;
    stabout.set_copy_live(false);
    stabout.set_licenses_live(corectl.co_stat(b"/etc/notices.txt", 1, st) >= 0 && corectl.co_stat(b"/bin/cless", 1, st) >= 0);
    "hdesk: settings about {cr} {stabout.row_len(stabout.R_BUILD)}\n";
}

// Frame 21 (GV-2): each window's grant word and when each bit was first seen are kit/grtrack.ci's; here the request
// text the desk's yes gave the window, with the bits that yes granted.
U8[896] g_req;                         // 56 bytes a window
Bool g_paint = false;                  // the Grants page changed while shown: main's loop paints it
I64[16] g_req_n;
I64[16] g_req_bits;

I64 g_bit(I64 b) { return grtrack.bit(b); }

// Each window's grant word against the one seen last: a new bit takes the time now; the Grants page follows.
void gr_track() {
    Bool ch = false;
    for i in 0..WINDOWS {
        I64 g = 0;
        if (kind[i] != NONE) { g = gw[i] & (3 | GRANT_KERN); }
        if (grtrack.track(i, g, now_s)) {
            ch = true;
            g_req_bits[i] = g_req_bits[i] & g;
        }
    }
    if (ch) { gr_shown(); }
}

// The Grants page told again while it is shown, and painted before the desk next waits (a review's finding: a grant
// that came or went while the page was open showed only at the next full redraw).
void gr_shown() {
    if (st_win < 0 || stbox.page() != stside.GRANTS) { return; }
    st_grants();
    g_paint = true;
}

void gr_forget(I64 i) {
    g_req_n[i] = 0;
    g_req_bits[i] = 0;
    if (grtrack.forget(i)) { gr_shown(); }   // its rows leave the open page
}

// The desk said yes to window i's ask for bits: its request text (kp_text, AC-V-R1's clean bytes) is their object.
void gr_asked(I64 i, I64 bits) {
    if (i < 0 || i >= WINDOWS) { return; }
    g_req_n[i] = kp_len;
    for k in 0..kp_len { g_req[56 * i + k] = kp_text[k]; }
    g_req_bits[i] = bits;
}

// Time t as the bar's clock draws it, HH:MM, on t's day; before it, the day as the bar names it.
// clock_text's own words for t (its zone and hours): its time after the two spaces, or before t's day, its date.
I64 gr_time(inout U8[_] o, I64 t) {
    U8[48] a;
    U8[48] b;
    I64 keep = now_s;
    I64 an = clock_text(a);
    now_s = t;
    I64 bn = clock_text(b);
    now_s = keep;
    I64 ad = gr_gap(a, an);
    I64 bd = gr_gap(b, bn);
    Bool day = ad == bd;
    for k in 0..min(ad, bd) {
        if (a[k] != b[k]) { day = false; }
    }
    I64 n = 0;
    if (day) {
        for k in bd + 2..bn {
            if (n < len(o)) { o[n] = b[k]; n = n + 1; }
        }
        return n;
    }
    for k in 0..min(bd, len(o)) { o[k] = b[k]; }
    return min(bd, len(o));
}

// Where a clock text's date ends: its two spaces.
I64 gr_gap(in U8[_] c, I64 n) {
    for k in 0..n - 1 {
        if (c[k] == ' ' && c[k + 1] == ' ') { return k; }
    }
    return n;
}

// Window i's variable as frame 21's object when the desk asked nothing for the grant (a session's grant, as the bar
// shows it beside the name): printable ASCII only, at most 56 bytes; the length.
I64 gr_var(I64 i, inout U8[_] o) {
    U8[256] v;
    I64 vl = 0;
    if (kind[i] == TERM) { vl = terms.var_of(slot[i], v); }
    if (kind[i] == PIXEL) {
        while (vl < WVAR && wvar[WVAR * i + vl] != 0) {
            v[vl] = wvar[WVAR * i + vl];
            vl = vl + 1;
        }
    }
    I64 n = 0;
    for k in 0..min(vl, 256) {
        if (n < min(56, len(o)) && v[k] >= 32 && v[k] < 127) {
            o[n] = v[k];
            n = n + 1;
        }
    }
    return n;
}

// The Grants page's lines: the windows in the order of their oldest grant, a window's grants oldest first.
void st_grants() {
    gr_track();
    stgrant.lines_clear();
    Bool[16] done;
    for i in 0..WINDOWS { done[i] = grtrack.seen(i) == 0; }
    Bool more = true;
    while (more) {
        I64 best = -1;
        I64 bt = 0;
        for i in 0..WINDOWS {
            if (!done[i]) {
                I64 t = gr_oldest(i);
                if (best < 0 || t < bt) {
                    best = i;
                    bt = t;
                }
            }
        }
        more = best >= 0;
        if (more) {
            done[best] = true;
            gr_lines(best);
        }
    }
    stgrant.refreshed();
    if (st_win >= 0 && stbox.page() == stside.GRANTS) { stbox.set_tall(stgrant.tall()); }
}

I64 gr_oldest(I64 i) { return grtrack.oldest(i); }

void gr_lines(I64 i) {
    U8[16] nm;
    I64 nn = win_name(i, nm);
    Bool[3] put;
    for b in 0..3 { put[b] = (grtrack.seen(i) & g_bit(b)) == 0; }
    for q in 0..3 {
        I64 c = -1;
        for b in 0..3 {
            if (!put[b] && (c < 0 || grtrack.at(i, b) < grtrack.at(i, c))) { c = b; }
        }
        if (c >= 0) {
            put[c] = true;
            U8[16] tt;
            I64 tn = gr_time(tt, grtrack.at(i, c));
            if ((g_req_bits[i] & g_bit(c)) != 0) {
                Bool ok = stgrant.line(i, nm, nn, g_bit(c), tt, tn, g_req[56 * i..56 * i + 56], g_req_n[i]);
            } else {
                U8[56] ob;
                I64 on = gr_var(i, ob);
                Bool ok = stgrant.line(i, nm, nn, g_bit(c), tt, tn, ob, on);
            }
        }
    }
}

// Window i's grants taken back (GV-R3: the whole window number): revoke (1008) for disk and network, the hold's end
// (FBIO_TILE_KERN 3) for ring 0.
void gr_revoke(I64 i) {
    if (i < 0 || i >= WINDOWS || kind[i] == NONE) { return; }
    I64 wd = gw[i] & 3;
    if (wd != 0) {
        I64 r = revokectl.co_revoke(vpid[i], wd);
        "hdesk: revoke {i} pid {vpid[i]} word {wd} ({r})\n";
    }
    if ((gw[i] & GRANT_KERN) != 0) {
        I64 st = hdeskctl.tile_ask(FBIO_TILE_KERN, pid[i], 3, ask[0..64]);
        "hdesk: revoke {i} ring 0 ({st})\n";
    }
}

void gr_after() {
    Bool g = grants();
    holds();
    st_grants();
    bar(true);
    redraw();
}

// Frame 27: the shortcut sheet, centered over the plane; Super+/, Show All, Esc or a press off it closes it.
void ks_open() {
    if (keysheet.is_up()) {
        ks_close();
        return;
    }
    keysheet.open(w / sc, plane_h() / sc);
    "hdesk: shortcuts\n";
    relayout();
    redraw();
}

void ks_close() {
    keysheet.close();
    "hdesk: shortcuts closed\n";
    relayout();
    redraw();
}

// --- the desk's own pages: Display, Sound ---

I64 dp_fs = 0;              // the focused row (1 up), 0 for none
Bool dp_kbd = false;        // a Tab or an arrow since the page opened or was clicked: the ring shows

I64 dp_put(inout I64[8] k, I64 n, I64 v) {
    k[n] = v;
    return n + 1;
}

// Page p's rows by kind (st_line's: 1 Theme, 2 Size, 3 Motion, 4 Screen shape, 5 Resolution, 7 Volume, 12 Output,
// 13 Now playing; 11 Restore Defaults, a button row) into k; how many. With one firmware mode Screen shape is left
// out (HX-13). Grants and About are kit pages (kit/stgrant.ci, kit/stabout.ci).
I64 dp_rows(I64 p, inout I64[8] k) {
    I64 n = 0;
    if (p == stside.DISPLAY) {
        n = dp_put(k, n, 1);
        n = dp_put(k, n, 2);
        n = dp_put(k, n, 3);
        if (!st_fixed) { n = dp_put(k, n, 4); }
        n = dp_put(k, n, 5);
        n = dp_put(k, n, 11);
    } else if (p == stside.SOUND) {
        n = dp_put(k, n, 12);
        n = dp_put(k, n, 7);
        n = dp_put(k, n, 13);
        n = dp_put(k, n, 11);
    }
    return n;
}

// Whether a row of kind what takes the keyboard: Resolution with more than one mode, Volume with a device.
Bool dp_stop(I64 what) {
    if (what == 1 || what == 2 || what == 3 || what == 4 || what == 11) { return true; }
    if (what == 5) { return !st_fixed; }
    if (what == 7) { return (au_fl & 1) != 0; }
    return false;
}

// The rows of page p that take the keyboard, a bit each (stpage.tab_to's mask).
I64 dp_can(I64 p) {
    I64[8] k;
    I64 n = dp_rows(p, k);
    I64 can = 0;
    for r in 0..n {
        if (dp_stop(k[r])) { can = can | (1 << r); }
    }
    return can;
}

Bool dp_enter(I64 p, Bool last) {
    dp_kbd = true;
    I64[8] k;
    I64 n = dp_rows(p, k);
    I64 d = 1;
    if (last) { d = -1; }
    dp_fs = stpage.tab_to(-1, d, n, dp_can(p)) + 1;
    return dp_fs > 0;
}

I64 dp_tall(I64 p) {
    I64[8] k;
    I64 n = dp_rows(p, k);
    if (n == 0) { return stpage.BODY + stpage.FOOT; }
    return stpage.row_y(stpage.BODY, n - 1) + stpage.ROW + stpage.FOOT;
}

// The Resolution menu's keys while it is open: Up and Down choose, Enter switches, Esc closes it.
I64 dp_menu_key(I64 code) {
    I64 a = RES_AT[st_shape];
    I64 n = RES_AT[st_shape + 1] - a;
    if (code == KEY_ESC) {
        st_menu = false;
    } else if (code == KEY_UP || code == KEY_DOWN) {
        st_msel = (st_msel - a + dy_of(code) + n) % n + a;
    } else if (code == KEY_ENTER || code == stpage.K_SPACE) {
        st_menu = false;
        "hdesk: settings resolution {RES_W[st_msel]}x{RES_H[st_msel]}\n";
        res_pick(st_msel);
    }
    return stpage.DRAW;
}

void dp_res_open() {
    st_menu = true;
    st_msel = RES_AT[st_shape];
    for k in RES_AT[st_shape]..RES_AT[st_shape + 1] {
        if (RES_W[k] == w && RES_H[k] == h) { st_msel = k; }
    }
}

// Row kind what changed by d (Left -1, Right 1) or pressed (Space, Enter); whether it did anything.
Bool dp_change(I64 what, I64 d, Bool press) {
    if (what == 1 && d != 0) {
        I64 t = tokens.DARK;
        if (d > 0) { t = tokens.LIGHT; }
        if (t != tokens.theme()) { theme_set(t); }
        return true;
    }
    if (what == 2 && d != 0) {
        I64 sz = sc + d;
        if (sz >= 1 && sz <= SCALES) {
            sc = sz;
            set_scale();
        }
        return true;
    }
    if (what == 3 && (d != 0 || press)) {
        anim_on = !anim_on;            // SP-R5 A: UI animations
        if (anim_on) { "hdesk: animations on\n"; } else { "hdesk: animations off\n"; }
        return true;
    }
    if (what == 4 && d != 0) {
        st_shape = (st_shape + d + 4) % 4;
        "hdesk: settings shape {st_shape}\n";
        return true;
    }
    if (what == 5 && press && !st_fixed) {
        dp_res_open();
        return true;
    }
    if (what == 7 && d != 0 && (au_fl & 1) != 0) {
        sp_volume(au_lv + 5 * d);      // DN-25: the Sound page's slider, 5 of 100 a press, the panel's level
        return true;
    }
    if (what == 11 && press) {
        st_defaults();
        return true;
    }
    return false;
}

// A key on page p (the desk's own): Tab and Shift+Tab step through the rows that take the keyboard and past either
// end go back to the sidebar (BACK); Left and Right change the focused row's pick, slider or switch; Space and Enter
// press it. Up and Down move nothing inside a page (the Tab order of the desk).
I64 dp_key(I64 p, I64 code) {
    if (stpage.is_tab(code) || stpage.is_arrow(code)) { dp_kbd = true; }
    if (st_menu) { return dp_menu_key(code); }
    I64[8] k;
    I64 n = dp_rows(p, k);
    if (stpage.is_tab(code)) {
        dp_fs = stpage.tab_to(dp_fs - 1, stpage.tab_d(code), n, dp_can(p)) + 1;
        if (dp_fs > 0) { return stpage.DRAW; }
        return stpage.BACK;
    }
    if (dp_fs == 0) {
        if (stpage.is_arrow(code)) {
            dp_fs = stpage.tab_to(-1, 1, n, dp_can(p)) + 1;
            if (dp_fs > 0) { return stpage.DRAW; }
        }
        return stpage.NONE;
    }
    I64 d = 0;
    if (code == KEY_LEFT) { d = -1; }
    if (code == KEY_RIGHT) { d = 1; }
    if (dp_change(k[dp_fs - 1], d, stpage.is_press(code))) { return stpage.DRAW; }
    if (stpage.is_arrow(code)) { return stpage.DRAW; }
    return stpage.NONE;
}

// A press at (px, py) on page p (the desk's own): the control under it takes it, as a key would.
I64 dp_click(I64 p, I64 cx, I64 y0, I64 cr, I64 yb, I64 px, I64 py) {
    dp_kbd = false;
    I64[8] k;
    I64 n = dp_rows(p, k);
    if (st_menu) {                     // the Resolution menu: a row switches, a press elsewhere closes it
        I64 a = RES_AT[st_shape];
        I64 mn = RES_AT[st_shape + 1] - a;
        I64 mb = dp_res_bottom(y0, k, n);
        I64 mt = mb - (12 + 28 * mn + 2 * (mn - 1));
        st_menu = false;
        if (px >= cr - 240 && px < cr && py >= mt + 6 && py < mb - 6) {
            I64 r = (py - mt - 6) / 30;
            if (r >= 0 && r < mn) {
                st_msel = a + r;
                "hdesk: settings resolution {RES_W[st_msel]}x{RES_H[st_msel]}\n";
                res_pick(st_msel);
            }
        }
        return stpage.DRAW;
    }
    for r in 0..n {
        I64 ry = stpage.row_y(y0 + stpage.BODY, r);
        if (py >= ry && py < ry + stpage.ROW) {
            I64 what = k[r];
            if (dp_stop(what)) { dp_fs = r + 1; }
            if ((what == 1 || what == 2) && px >= cr - 176) {
                I64 parts = 2;
                if (what == 2) { parts = 3; }
                I64 g = stpage.seg_hit(cr - 176, 176, parts, px);
                if (what == 1 && g >= 0) { Bool c1 = dp_change(1, 2 * g - 1, false); }
                if (what == 2 && g >= 0 && g + 1 != sc) { Bool c2 = dp_change(2, g + 1 - sc, false); }
            } else if (what == 3 && px >= cr - 44) {
                Bool c3 = dp_change(3, 0, true);
            } else if (what == 4 && px >= cr - 336) {
                I64 g = stpage.seg_hit(cr - 336, 336, 4, px);
                if (g >= 0) {
                    st_shape = g;
                    "hdesk: settings shape {st_shape}\n";
                }
            } else if (what == 5 && px >= cr - 176) {
                Bool c5 = dp_change(5, 0, true);
            } else if (what == 7 && px >= cr - 240 && (au_fl & 1) != 0) {
                I64 lv = (px - (cr - 240)) * 100 / 240;
                sp_volume(lv - lv % 5);
            } else if (what == 11) {
                U8[16] t = b"Restore Defaults";
                if (px >= cr - stpage.bw(t, 16, faces.NAME)) { st_defaults(); }
            }
            return stpage.DRAW;
        }
    }
    return stpage.NONE;
}

// The Resolution menu's bottom: the top of its button (the Resolution row's top and 4).
I64 dp_res_bottom(I64 y0, in I64[8] k, I64 n) {
    I64 r = 0;
    for q in 0..n {
        if (k[q] == 5) { r = q; }
    }
    return stpage.row_y(y0 + stpage.BODY, r) + 4;
}

// The desk's state for st_line (as DN-10 drew it): 2 theme, 3 size, 4 motion, 5 screen shape, 6 and 7 the screen,
// 8 one firmware mode, 9 the menu open, 10 its selected size, 11 the desktop's tiling, 12 a volume, 13 the level or
// -1, 14 the player (1, 0 none, -1 no device), 15 its pid.
void dp_state(inout I64[16] s) {
    s[0] = stbox.page();
    s[1] = -1;
    s[2] = tokens.theme();
    s[3] = sc;
    s[4] = 0;
    if (anim_on) { s[4] = 1; }
    s[5] = st_shape;
    s[6] = w;
    s[7] = h;
    s[8] = 0;
    if (st_fixed) { s[8] = 1; }
    s[9] = 0;
    if (st_menu) { s[9] = 1; }
    s[10] = st_msel;
    s[11] = layout.direction_of(cur);
    s[12] = sys_flags() % 2;
    s[13] = -1;
    if ((au_fl & 1) != 0) { s[13] = au_lv; }
    s[14] = 0 - 1;                     // DN-25: the player, as the panel's NOW PLAYING has it
    if ((au_fl & 1) != 0) { s[14] = 0; }
    if ((au_fl & 1) != 0 && au_vp > 0) { s[14] = 1; }
    s[15] = au_vp;
}

// Page p's row y (the desk's own): its title, then its rows on the page kit's rhythm (40 high, 49 apart, a 1 px
// SURF1 rule between), Restore Defaults a button at the right of its row, the Resolution menu over the rows.
void dp_row(I64 p, I64 cx, I64 y0, I64 cr, I64 yb, I64 y) {
    U8[24] t;
    I64 tn = stside.name(p, t);
    stpage.title(row, cx, y0, cr, t, tn, y);
    I64[8] k;
    I64 n = dp_rows(p, k);
    I64[16] s;
    dp_state(s);
    I64 cn = 0;
    while (cn < 16 && au_comm[cn] != 0) { cn = cn + 1; }
    for r in 0..n {
        I64 ry = stpage.row_y(y0 + stpage.BODY, r);
        if (r > 0) { stpage.rule_before(row, cx, y0 + stpage.BODY, cr, r); }
        Bool focus = dp_kbd && r + 1 == dp_fs;
        if (y >= ry - 4 && y < ry + stpage.ROW + 4) {
            if (k[r] == 11) {
                if (y >= ry && y < ry + stpage.ROW) {
                    I64 bl = stpage.row_button(row, cr, ry, b"Restore Defaults", 16);
                }
                if (focus) {
                    I64 bw2 = stpage.bw(b"Restore Defaults", 16, faces.NAME);
                    stpage.focus(row, cr - bw2, ry + 4, cr, ry + 4 + stpage.BTN, stpage.R_CTRL);
                }
            } else if (y >= ry && y < ry + stpage.ROW) {
                st_line(cx, ry, cr, k[r], focus, s, au_comm[0..cn], y);
            }
        }
    }
    if (st_menu && p == stside.DISPLAY) {
        I64 mb = dp_res_bottom(y0, k, n);
        menu_shadow(st_bx0, st_bx1, cr, mb, s);
        res_menu(cr, mb, s, y);
    }
}

// Restore Defaults: on the Sound page the volume's default, 100 (DN-25); else Dark, the size the screen picks,
// motion on.
void st_defaults() {
    if (stbox.page() == stside.SOUND) {
        sp_volume(100);
        "hdesk: settings defaults\n";
        return;
    }
    if (tokens.theme() != tokens.DARK) { theme_set(tokens.DARK); }
    anim_on = true;
    I64 a = auto_scale(w, h);
    if (a != sc) {
        sc = a;
        set_scale();
    }
    "hdesk: settings defaults\n";
}

// A key in Settings (its window focused): the revert prompt's first; then kit/sthost.ci's contract, the desk's own
// pages run here when it answers DESK_. Esc that nothing takes closes Settings.
void settings_key(I64 code) {
    if (rv_open) {
        rv_answer(code);
        return;
    }
    if (st_win >= 0) { st_box_of(st_win); }
    if (!ctrl) {                       // a letter for the zone plate's find field (frame 47), when it is open
        I64 zb = keymap.byte_of(code, shift, ctrl);
        if (zb >= 32 && zb <= 126 && sthost.typed(zb as U8) != sthost.NONE) {
            redraw();
            return;
        }
    }
    I64 p = stbox.page();
    I64 r = sthost.key(code, shift);
    if (r == sthost.DESK_ENTER || r == sthost.DESK_ENTER_LAST) {
        sthost.entered(dp_enter(p, r == sthost.DESK_ENTER_LAST), dp_focus_top(), dp_focus_bottom());
        r = sthost.DRAW;
    } else if (r == sthost.DESK_KEY) {
        I64 a = dp_key(p, sthost.fold(code, shift));
        r = sthost.answered(a, code, dp_tall(p), dp_focus_top(), dp_focus_bottom());
    }
    if (r == sthost.CLOSE) {
        I64 sw_i = st_win;
        close_window(sw_i);
        redraw();
        "hdesk: settings closed\n";
        return;
    }
    if (r == sthost.PAGE) { st_opened(true); }
    if (r >= stpage.ACT) { st_act(p, r); }
    redraw();
}

// DN-51 frame 26 with frame 33: a pin of the Desk page's Taskbar list pressed in Settings window st_win.
Bool st_pin_drag() { return st_win >= 0 && stbox.page() == stside.DESK && stdesk.dragging(); }

// The pin dragged off the list, where its drop is refused: the Not here pointer.
Bool st_pin_off() { return st_pin_drag() && stdesk.refused(); }

// The pointer moved with the pin held: where it would land, drawn again when that changed.
void st_pin_move() {
    I64 cx = cbx(st_win);
    I64 cy = cby(st_win);
    I64 px = cx + (mx - cx) / sc;
    I64 py = cy + (my - cy) / sc;
    st_box_of(st_win);
    if (stdesk.move(stbox.cx(), stbox.y0_at(py), stbox.cr(), stbox.yb_at(py), px, py)) { redraw(); }
}

// The button released over the pin's drag: MOVE where it landed, nothing where it was refused.
void st_pin_release() {
    I64 r = stdesk.release();
    if (r >= stpage.ACT) { st_act(stside.DESK, r); }
    "hdesk: settings pin release ({r})\n";
    redraw();
}

// DN-51 frame 26: whether the pointer is on one of the desk's own text fields (the Text pointer): the plane's
// field, the account screens' fields, Add Account's and Change Password's fields, the Time Zone picker's find field.
// A program's own fields keep the arrow in 0.1.0.
Bool text_field_at() {
    if (ac_screen != 0) {
        I64 x0 = layout.frame_x(OV);
        I64 y0 = layout.frame_y(OV);
        return acscreen.field_at(x0, y0, x0 + layout.frame_w(OV) / sc, y0 + layout.frame_h(OV) / sc,
                                 x0 + (mx - x0) / sc, y0 + (my - y0) / sc);
    }
    if (acctform.is_up() && !kp_open && window_at(mx, my) == OV) {
        return acctform.field_at((mx - layout.frame_x(OV)) / sc, (my - layout.frame_y(OV)) / sc);
    }
    if (pl_open && !plane.pin_menu_on()) {
        I64 px = mx / sc;
        I64 py = (my - bar_h()) / sc;
        return px >= plane.col_x0() && px < plane.col_x1() && py >= plane.field_y0() && py < plane.field_y1();
    }
    if (layout.is_live(OV) && window_at(mx, my) == OV) { return false; }
    I64 i = window_at(mx, my);
    if (i >= 0 && i < WINDOWS && kind[i] == SETTINGS && stbox.page() == stside.DATETIME && sttime.picking()) {
        I64 cx = cbx(i);
        I64 cy = cby(i);
        I64 px = cx + (mx - cx) / sc;
        I64 py = cy + (my - cy) / sc;
        st_box_of(i);
        return sttime.find_at(stbox.y0_at(py), stbox.cr(), px, py);
    }
    return false;
}

// A press in Settings' content box at device (mx, my), window i: the frame's, else the page's (kit/sthost.ci).
void settings_click(I64 i) {
    I64 cx = cbx(i);
    I64 cy = cby(i);
    I64 px = cx + (mx - cx) / sc;
    I64 py = cy + (my - cy) / sc;
    st_box_of(i);
    I64 p = stbox.page();
    I64 r = sthost.click(px, py);
    if (r == sthost.DESK_CLICK) {
        I64 a = dp_click(p, stbox.cx(), stbox.y0_at(py), stbox.cr(), stbox.yb_at(py), px, py);
        r = sthost.answered(a, -1, dp_tall(p), -1, -1);
    }
    if (r == sthost.PAGE) { st_opened(true); }
    if (r >= stpage.ACT) { st_act(p, r); }
    redraw();
}

I64 sys_flags() {
    I64 st = hdeskctl.tile_ask(FBIO_TILE_INFO, 2, 0, ask[0..32]);
    if (st < 0) { return 0; }
    return word_at(ask, 2);
}

I64 put_text(inout U8[_] dst, I64 at, in U8[_] t) {
    for q in 0..len(t) { dst[at + q] = t[q]; }
    return at + len(t);
}

// "W x H" of RES-1 size k (or the screen's, k < 0) into dst at at; the end.
I64 res_text(inout U8[_] dst, I64 at, I64 rw, I64 rh) {
    I64 n = digits(dst, at, rw);
    n = put_text(dst, n, b" x ");
    return digits(dst, n, rh);
}

// Settings' content box row y at 1x from (x0, y0) to (x1, yb), through the pen at its zoom: kit/stbox.ci's frame,
// the page shown in it (its head at y0_at, the rest lifted), the laid sidebar over it (kit/sthost.ci).
void settings_row(I64 x0, I64 y0, I64 x1, I64 yb, I64 y) {
    st_bx0 = x0;
    st_bx1 = x1;
    st_box(x0, y0, x1, yb);
    I64 p = stbox.page();
    if (sthost.desk_page(p)) { stbox.set_tall(dp_tall(p)); } else { stbox.set_tall(sthost.tall(p)); }
    sthost.ground_row(row, y);
    if (sthost.desk_page(p)) {
        dp_row(p, stbox.cx(), stbox.y0_at(y), stbox.cr(), stbox.yb_at(y), y);
    } else {
        sthost.page_row(row, y);
    }
    sthost.top_row(row, pen.x(x0), pen.x(x1), y);
}

// MS-4 (DN-10, mini 20261110T055857Z): the Resolution menu's shadow, High, radius RAD, over Settings' content
// between x0 and x1 on the pen's row, at the pen's zoom (spread with the content at a larger UI scale); the menu's
// right edge cr and bottom yb at 1x, as res_menu places it.
void menu_shadow(I64 x0, I64 x1, I64 cr, I64 yb, in I64[16] s) {
    I64 n = RES_AT[s[5] + 1] - RES_AT[s[5]];
    I64 mh = 12 + 28 * n + 2 * (n - 1);
    shade.shade_row(row, pen.x(x0), pen.x(x1), pen.row_y(), pen.x(cr - 240), pen.y(yb - mh), pen.x(cr), pen.y(yb), RAD,
                    3, tokens.theme(), pen.zoom());
}

// One 40 px row from ry (DN-46: one line, no helper sentence), the content between cx and cr: label and control by
// what (row_is).
void st_line(I64 cx, I64 ry, I64 cr, I64 what, Bool focus, in I64[16] s, in U8[_] pn, I64 y) {
    U8[48] t;
    I64 n = 0;
    I64 e = 0;
    if (what == 1) {
        e = ptxt(cx, ry + 12, cr - 184, b"Theme", 5, tok(tokens.INK), faces.NAME);
        if (y >= ry + 4 && y < ry + 36) { seg_at(cr - 176, ry + 4, 176, b"Dark|Light", 2, s[2]); }
    } else if (what == 2) {
        e = ptxt(cx, ry + 12, cr - 184, b"Size", 4, tok(tokens.INK), faces.NAME);
        if (y >= ry + 4 && y < ry + 36) { seg_at(cr - 176, ry + 4, 176, b"1x|2x|3x", 3, s[3] - 1); }
    } else if (what == 3) {
        e = ptxt(cx, ry + 12, cr - 52, b"Motion", 6, tok(tokens.INK), faces.NAME);
        if (y >= ry + 8 && y < ry + 32) {
            if (s[4] == 1) {
                pen.round(row, cr - 44, ry + 8, cr, ry + 32, 12, tok(tokens.FILL));
                pen.round(row, cr - 22, ry + 10, cr - 2, ry + 30, 10, tok(tokens.ON_FILL));
            } else {
                pen.round(row, cr - 44, ry + 8, cr, ry + 32, 12, tok(tokens.SURF1));
                pen.round(row, cr - 42, ry + 10, cr - 22, ry + 30, 10, tok(tokens.INK_DIM));
            }
        }
    } else if (what == 4) {
        e = ptxt(cx, ry + 12, cr - 344, b"Screen shape", 12, tok(tokens.INK), faces.NAME);
        if (y >= ry + 4 && y < ry + 36) {
            seg_at(cr - 336, ry + 4, 336, b"Landscape|Ultrawide|Portrait|Legacy", 4, s[5]);
        }
    } else if (what == 5) {
        e = ptxt(cx, ry + 12, cr - 184, b"Resolution", 10, tok(tokens.INK), faces.NAME);
        n = res_text(t, 0, s[6], s[7]);
        if (s[8] == 1) {
            e = pen.text_right(row, cr, ry + 12 + TBASE, t, n, tok(tokens.INK_DIM), faces.PATH);
        } else {
            if (y >= ry + 4 && y < ry + 36) { pen.round(row, cr - 176, ry + 4, cr, ry + 36, R_CTRL, tok(tokens.SURF1)); }
            e = ptxt(cr - 164, ry + 12, cr - 24, t, n, tok(tokens.INK), faces.PATH);
            if (s[9] == 1) {
                e = ptxt_mid(cr - 24, 14, ry + 12, cr - 10, b"^", 1, tok(tokens.INK), faces.BODY);
            } else {
                e = ptxt_mid(cr - 24, 14, ry + 12, cr - 10, b"v", 1, tok(tokens.INK), faces.BODY);
            }
        }
    } else if (what == 6) {
        e = ptxt(cx, ry + 12, cr - 344, b"Tiling", 6, tok(tokens.INK), faces.NAME);
        if (y >= ry + 4 && y < ry + 36) { seg_at(cr - 336, ry + 4, 336, b"Long side|Columns|Rows", 3, s[11]); }
    } else if (what == 7) {
        U32 lc = tok(tokens.INK);      // DN-25: dimmed and disabled with no device
        if (s[13] < 0) { lc = tok(tokens.INK_DIM); }
        e = ptxt(cx, ry + 12, cr - 248, b"Volume", 6, lc, faces.NAME);
        if (y >= ry + 10 && y < ry + 30) {   // a 240 x 20 pill: MANTLE, the level ULTRAMARINE, a 16 px INK knob 2 in
            pen.round(row, cr - 240, ry + 10, cr, ry + 30, 10, tok(tokens.MANTLE));
            if (s[13] >= 0) {
                I64 fw = 20 + 220 * s[13] / 100;
                pen.round(row, cr - 240, ry + 10, cr - 240 + fw, ry + 30, 10, tok(tokens.ULTRAMARINE));
                pen.round(row, cr - 258 + fw, ry + 12, cr - 242 + fw, ry + 28, 8, tok(tokens.INK));
            }
        }
    } else if (what == 12) {
        e = ptxt(cx, ry + 12, cr - 184, b"Output", 6, tok(tokens.INK), faces.NAME);
        if (s[13] < 0) {
            e = pen.text_right(row, cr, ry + 12 + TBASE, b"Not available", 13, tok(tokens.INK_DIM), faces.BODY);
        } else {
            e = pen.text_right(row, cr, ry + 12 + TBASE, b"Built-in audio", 14, tok(tokens.INK_DIM), faces.BODY);
        }
    } else if (what == 13) {
        e = ptxt(cx, ry + 12, cr - 248, b"Now playing", 11, tok(tokens.INK), faces.NAME);
        if (s[14] == 1) {
            n = digits(t, put_text(t, 0, b"pid "), s[15]);
            I64 pw = pen.width(t, n, faces.PATH);
            e = pen.text_right(row, cr, ry + 12 + TBASE, t, n, tok(tokens.INK_DIM), faces.PATH);
            I64 nx = pen.x(cr) - pw - 8 * pen.zoom() - pen.width(pn, len(pn), faces.NAME);
            e = ctext.text(row, pen.row_y(), nx, pen.y(ry + 12 + TBASE), pen.x(cr) - pw - 8 * pen.zoom(), pn, len(pn),
                           tok(tokens.INK), faces.NAME, pen.zoom());
        } else if (s[14] == 0) {
            e = pen.text_right(row, cr, ry + 12 + TBASE, b"Nothing playing", 15, tok(tokens.INK_DIM), faces.BODY);
        } else {
            e = pen.text_right(row, cr, ry + 12 + TBASE, b"Not available", 13, tok(tokens.INK_DIM), faces.BODY);
        }
    } else if (what == 8) {
        e = ptxt(cx, ry + 12, cr - 184, b"Version", 7, tok(tokens.INK), faces.NAME);
        e = pen.text_right(row, cr, ry + 12 + TBASE, b"Daphnis 0.1.0", 13, tok(tokens.INK_DIM), faces.BODY);
    } else if (what == 9) {
        e = ptxt(cx, ry + 12, cr - 184, b"Screen", 6, tok(tokens.INK), faces.NAME);
        n = res_text(t, 0, s[6], s[7]);
        e = pen.text_right(row, cr, ry + 12 + TBASE, t, n, tok(tokens.INK_DIM), faces.PATH);
    } else if (what == 10) {
        e = ptxt(cx, ry + 12, cr - 184, b"Storage", 7, tok(tokens.INK), faces.NAME);
        if (s[12] == 1) {
            e = pen.text_right(row, cr, ry + 12 + TBASE, b"Volume on /home", 15, tok(tokens.INK_DIM), faces.BODY);
        } else {
            e = pen.text_right(row, cr, ry + 12 + TBASE, b"No volume", 9, tok(tokens.INK_DIM), faces.BODY);
        }
    }
    if (focus && y >= ry + 0 && y < ry + 40) {
        // DN-40: a segmented control holds a FILL segment: its focus ring is outside it, on the page's PAPER
        if (what == 1 || what == 2) {
            pen.focus_ring(row, cr - 176, ry + 4, cr, ry + 36, 16, tok(tokens.PAPER), tok(tokens.ULTRAMARINE));
        }
        if (what == 4 || what == 6) {
            pen.focus_ring(row, cr - 336, ry + 4, cr, ry + 36, 16, tok(tokens.PAPER), tok(tokens.ULTRAMARINE));
        }
        if (what == 5 && s[8] == 0) {      // DN-42: the Resolution button's focus, outside it
            pen.focus_ring(row, cr - 176, ry + 4, cr, ry + 36, R_CTRL, tok(tokens.PAPER), tok(tokens.ULTRAMARINE));
        }
        if (what == 7 && s[13] >= 0) { pen.ring(row, cr - 242, ry + 8, cr + 2, ry + 32, 12, 2, tok(tokens.ULTRAMARINE)); }
    }
    if (focus && what == 3 && y >= ry + 6 && y < ry + 34) {
        pen.ring(row, cr - 46, ry + 6, cr + 2, ry + 34, 14, 2, tok(tokens.ULTRAMARINE));
    }
}

// DN-10: the Resolution menu, 240 wide at its right edge cr and its bottom at yb: SURF1, radius 8, 6 px in, a 28 px
// pill row a size of the shape's group (RES-1), 2 apart, `W x H` in PATH, the selected FILL; dim tags Full HD on
// 1920 x 1080 and 4K on 3840 x 2160.
void res_menu(I64 cr, I64 yb, in I64[16] s, I64 y) {
    I64 a = RES_AT[s[5]];
    I64 n = RES_AT[s[5] + 1] - a;
    I64 mh = 12 + 28 * n + 2 * (n - 1);
    I64 x0 = cr - 240;
    I64 y0 = yb - mh;
    if (y < y0 || y >= yb) { return; }
    pen.round(row, x0, y0, cr, yb, RAD, tok(tokens.SURF1));
    for k in 0..n {
        I64 ry = y0 + 6 + 30 * k;
        U32 fg = tok(tokens.INK);
        U32 dim = tok(tokens.INK_DIM);
        if (a + k == s[10]) {
            if (y >= ry && y < ry + 28) { pen.round(row, x0 + 6, ry, cr - 6, ry + 28, 14, tok(tokens.FILL)); }
            fg = tok(tokens.ON_FILL);
            dim = fg;
        }
        U8[24] t;
        I64 m = res_text(t, 0, RES_W[a + k], RES_H[a + k]);
        I64 e = ptxt(x0 + 16, ry + 6, cr - 16, t, m, fg, faces.PATH);
        if (RES_W[a + k] == 1920 && RES_H[a + k] == 1080) {
            e = pen.text_right(row, cr - 16, ry + 6 + TBASE, b"Full HD", 7, dim, faces.BODY);
        }
        if (RES_W[a + k] == 3840 && RES_H[a + k] == 2160) {
            e = pen.text_right(row, cr - 16, ry + 6 + TBASE, b"4K", 2, dim, faces.BODY);
        }
    }
}

// DN-10: the revert prompt's plate (the elevation prompt's, radius 12; RV_W x RV_H at 1x from (x0, y0)) on PAPER:
// `Keep this resolution?` in TITLE, `Back to W x H in N s` (the old size, the seconds left), `Enter Keep` on FILL at
// the left and `Esc Revert` on SURF1 at the right, 36 px buttons of radius 6 with 20 px keycaps.
void revert_at(I64 x0, I64 y0, I64 ow, I64 oh, I64 left, I64 y) {
    I64 x1 = x0 + RV_W;
    I64 e = 0;
    if (y >= y0 + 16 && y < y0 + 44) {
        e = pen.text(row, x0 + 24, y0 + 39, x1 - 24, b"Keep this resolution?", 21, tok(tokens.INK), faces.TITLE);
    }
    U8[48] t;
    I64 n = put_text(t, 0, b"Back to ");
    n = res_text(t, n, ow, oh);
    n = put_text(t, n, b" in ");
    n = digits(t, n, left);
    n = put_text(t, n, b" s");
    e = ptxt(x0 + 24, y0 + 64, x1 - 24, t, n, tok(tokens.INK_DIM), faces.BODY);
    I64 kw = txt_w(b"Enter", 5, faces.PATH) + 12;
    I64 rw = 12 + kw + 10 + txt_w(b"Keep", 4, faces.NAME) + 12;
    pen.round(row, x0 + 24, y0 + 104, x0 + 24 + rw, y0 + 140, R_CTRL, tok(tokens.FILL));
    pen.ring(row, x0 + 36, y0 + 112, x0 + 36 + kw, y0 + 132, R_KEY, 1, tok(tokens.ON_FILL));
    e = ptxt_mid(x0 + 36, kw, y0 + 114, x0 + 36 + kw, b"Enter", 5, tok(tokens.ON_FILL), faces.PATH);
    e = ptxt(x0 + 46 + kw, y0 + 114, x0 + 24 + rw, b"Keep", 4, tok(tokens.ON_FILL), faces.NAME);
    I64 ew = txt_w(b"Esc", 3, faces.PATH) + 12;
    I64 fw = 12 + ew + 10 + txt_w(b"Revert", 6, faces.NAME) + 12;
    pen.round(row, x1 - 24 - fw, y0 + 104, x1 - 24, y0 + 140, R_CTRL, tok(tokens.SURF1));
    pen.ring(row, x1 - 12 - fw, y0 + 112, x1 - 12 - fw + ew, y0 + 132, R_KEY, 1, tok(tokens.RULE));
    e = ptxt_mid(x1 - 12 - fw, ew, y0 + 114, x1 - 12 - fw + ew, b"Esc", 3, tok(tokens.INK_DIM), faces.PATH);
    e = ptxt(x1 - 2 - fw + ew, y0 + 114, x1 - 24, b"Revert", 6, tok(tokens.INK), faces.NAME);
}

// --- RS-SHOT (docs/handoff/20261111-rs-shot-wiring.md; spec stage RS): the three keys, the held screen, the area
// select, the plate, and each shot's child reaped. kit/shotdesk.ci keeps the numbers; kit/shotsel.ci draws. ---

U8[20480] sh_line;          // a row as fb_peek gives it, 4 bytes a pixel of the widest screen (RES-1: 5120)
Bool sh_sel = false;        // the area select holds the screen: the pointer and the keys are its alone
Bool sh_up = false;         // the newest shot's plate is on the screen
I64 sh_t0 = 0;              // when it showed (CLOCK_BOOTTIME ns)
I64 sh_k = 0;               // the gates' stepped frames since
Bool sh_swallow = false;    // the release of the press that opened the shot
U8[64] sh_file;             // the shown plate's file in Pictures, as shot_end gave it
I64 sh_fn = 0;

// The session's ceiling, as its terminals get it: 7 for a parent.
I64 sh_ceil() {
    U64 c = 7;
    if (acct.role_of(s_acct) != acct.PARENT) { c = acct.ceil_of(s_acct); }
    return c as I64;
}

// The session's account name into nm: its length.
I64 sh_name(inout U8[_] nm) {
    I64 n = acct.name_len(s_acct);
    for k in 0..n { nm[k] = acct.name_byte(s_acct, k); }
    return n;
}

// A shot key the desk takes (Print, Alt+Print, Super+Shift+S): its press acts when an account may shoot, and its
// release and repeats are taken too; false for any other key. On the login and lock screens and without Disk in the
// ceiling it does nothing at all.
Bool sh_key(I64 code, I64 value) {
    I64 what = shotdesk.which(code, alt, meta, shift);
    if (what == shotdesk.NONE) { return false; }
    I64 c = 0;
    Bool on = ac_on && s_acct >= 0;
    if (on) { c = sh_ceil(); }
    if (value == 1 && !sh_sel && shotdesk.may(on, ac_screen != SCR_NONE, c)) { sh_take(what); }
    return true;
}

// The whole screen, or the focused window's frame (its bar in, its shadow out), held and given to shot_as; the area
// select begun for AREA. The arrow is drawn into the screen (src/tile.ci), so it goes before the hold.
void sh_take(I64 what) {
    if (sh_up) { sh_hide(); }          // a plate up is no part of the next shot
    if (what == shotdesk.AREA) {
        sh_select();
        return;
    }
    I64[4] r;
    r[0] = 0;
    r[1] = 0;
    r[2] = w;
    r[3] = h;
    if (what == shotdesk.WINDOW) {
        I64 f = focused();
        if (f < 0 || f >= WINDOWS || !shown(f) || !shotdesk.clip(layout.frame_x(f), layout.frame_y(f),
                                                                 layout.frame_w(f), layout.frame_h(f), w, h, r)) {
            "hdesk: shot window none\n";
            return;
        }
        settle();                      // the window's last frame on the screen first
    }
    Bool was = pshown;
    if (was) { pointer(false); }
    I64 hd = hdeskctl.fb_hold(1);
    if (hd == 0) {
        sh_shoot(what, r[0], r[1], r[2], r[3]);
    } else {
        "hdesk: shot hold refused ({hd})\n";
    }
    I64 off = hdeskctl.fb_hold(0);
    if (was) { pointer(true); }
}

// The held rectangle to shot_as as the session's account, then the plate's picture made from it while it is held;
// the plate shows when the child ends with status 0 (sh_done).
void sh_shoot(I64 what, I64 x, I64 y, I64 rw, I64 rh) {
    U8[32] nm;
    I64 nn = sh_name(nm);
    U8[48] hm;
    I64 hn = shotdesk.home(nm[0..nn], hm);
    I64 p = hdeskctl.shot_as(x, y, rw, rh, acct.uid_of(s_acct), acct.gid_of(s_acct), sh_ceil(), hm[0..hn]);
    "hdesk: shot ";
    if (what == shotdesk.SCREEN) { "screen"; }
    if (what == shotdesk.WINDOW) { "window"; }
    if (what == shotdesk.AREA) { "area"; }
    " {x},{y} {rw}x{rh} pid {p}\n";
    if (p <= 0) { return; }
    if (sh_up) { sh_hide(); }          // a newer shot replaces the plate shown
    I64 n = shotdesk.began(p, now_ns() / 1000000);
    shotsel.plate_begin(rw, rh, sc, w, h);
    I64 sy = shotsel.plate_next();
    while (sy >= 0) {
        I64 got = hdeskctl.fb_peek(x, y + sy, sh_line[0..4 * rw]);
        shotsel.plate_feed(sh_line[0..4 * rw]);
        sy = shotsel.plate_next();
    }
}

// Super+Shift+S: the screen held, every client's copy stopped, the arrow off; the held screen dimmed with the
// crosshair at the pointer, drawn whole once.
void sh_select() {
    Bool was = pshown;
    if (was) { pointer(false); }
    I64 hd = hdeskctl.fb_hold(1);
    if (hd != 0) {
        "hdesk: shot hold refused ({hd})\n";
        if (was) { pointer(true); }
        return;
    }
    sh_sel = true;
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL) { place(i); }   // no rectangles: no client's copy lands on the held screen
    }
    shotsel.begin(w, h, sc);
    I64 r = shotsel.point(mx, my);
    "hdesk: shot select\n";
    sh_rows(0, h);
}

// Rows [a, b) of the held screen with the select over them.
void sh_rows(I64 a, I64 b) {
    for y in max(0, a)..min(h, b) {
        I64 got = hdeskctl.fb_peek(0, y, sh_line[0..4 * w]);
        if (got == w) {
            shotsel.unpack(sh_line[0..4 * w], row, w);
            shotsel.row_at(row[0..w], y);
            I64 put = tilectl.fb_span(y, 0, row[0..w]);
        }
    }
}

// An event while the select runs: the pointer's motion and the left button to it, the keys to it (the modifiers
// kept, and no Super tap after it); nothing reaches a window or the desk.
void sh_route(I64 k, I64 code, I64 value) {
    if (k == EV_REL) {
        if (code == 0) { mx = max(0, min(w - 1, mx + value)); }
        if (code == 1) { my = max(0, min(h - 1, my + value)); }
        if (code == 0 || code == 1) { sh_answer(shotsel.point(mx, my)); }
        return;
    }
    if (k != 1) { return; }
    if (code == BTN_LEFT) {
        if (value == 1) { sh_answer(shotsel.press(mx, my)); }
        if (value == 0) { sh_answer(shotsel.release(mx, my)); }
        return;
    }
    if (code == keymap.KEY_LEFTSHIFT || code == keymap.KEY_RIGHTSHIFT) { shift = value != 0; }
    if (code == keymap.KEY_LEFTCTRL || code == keymap.KEY_RIGHTCTRL) { ctrl = value != 0; }
    if (code == KEY_LEFTALT || code == KEY_RIGHTALT) { alt = value != 0; }
    if (code == KEY_LEFTMETA || code == KEY_RIGHTMETA) { meta = value != 0; }
    meta_clean = false;
    if (value == 1) { sh_answer(shotsel.key(code)); }
}

void sh_answer(I64 r) {
    if (r == shotsel.DRAW) {
        sh_rows(shotsel.lo(), shotsel.hi());
    } else if (r == shotsel.TAKE) {
        sh_shoot(shotdesk.AREA, shotsel.area_x(), shotsel.area_y(), shotsel.area_w(), shotsel.area_h());
        sh_end();
    } else if (r == shotsel.CANCEL) {
        "hdesk: shot select cancelled\n";
        sh_end();
    }
}

// The select over: the screen let go and drawn again from the desk's own state, the clients placed again.
void sh_end() {
    I64 off = hdeskctl.fb_hold(0);
    sh_sel = false;
    redraw();
    if (sh_up) { sh_paint(); }         // a plate that came during the select
    if (pvis) { pointer(true); }
}

// Section 6: the held screen let go and no plate: the lock, a logout, a new session, a mode change, the desk's end.
// No shot running then shows its plate. The caller draws the screen again.
void sh_drop() {
    shotdesk.forget();
    sh_up = false;
    sh_swallow = false;
    if (sh_sel) {
        I64 off = hdeskctl.fb_hold(0);
        sh_sel = false;
        if (pvis) { pointer(true); }
    }
}

// Every shot's child that ended: reaped, its name taken (shot_end closes the pipe whatever the status).
void sh_reap() {
    for k in 0..shotdesk.SLOTS {
        I64 p = shotdesk.child(k);
        if (p != 0) {
            I64 r = tilectl.reap(p, true);
            if (r != 0 - EAGAIN) { sh_done(p, r); }
        }
    }
}

void sh_done(I64 p, I64 r) {
    U8[64] nm;
    I64 n = hdeskctl.shot_end(p, nm);
    Bool show = shotdesk.ended(p, r, n > 0);
    "hdesk: shot pid {p} ended, status {r}";
    if (n > 0) {
        " |";
        I64 put = ptyctl.pty_write(1, nm[0..n]);
        "|";
    }
    "\n";
    if (!show) { return; }
    for k in 0..n { sh_file[k] = nm[k]; }
    sh_fn = n;
    sh_up = true;
    sh_t0 = now_ns();
    sh_k = 0;
    "hdesk: shot plate\n";
    sh_paint();
}

// The plate's 4 s (stepped: 10 ms a Shift press of the gates), and a child past its 20 s stopped and reaped.
void sh_tick(Bool step) {
    if (sh_up) {
        if (step) { sh_k = sh_k + 1; }
        if ((stepped && sh_k * 10 >= shotsel.HOLD_MS) ||
            (!stepped && now_ns() - sh_t0 >= shotsel.HOLD_MS * 1000000)) {
            sh_hide();
        }
    }
    I64 lp = shotdesk.late(now_ns() / 1000000);
    if (lp > 0) {
        I64 st = tilectl.stop(lp, 9);
        I64 r = tilectl.reap(lp, true);
        if (r != 0 - EAGAIN) { sh_done(lp, r); }
    }
}

void sh_hide() {
    if (!sh_up) { return; }
    sh_up = false;
    "hdesk: shot plate gone\n";
    sh_paint();
}

// The plate drawn over the screen as it stands (every client whole first, the arrow off), so its shadow falls on what
// is there, a client's pixels too; then the clients placed around its box, which paint_rows leaves as it is. Gone: the
// rows drawn again from the desk's state and the clients placed back. During the select the plate waits for sh_end.
void sh_paint() {
    if (sh_sel) { return; }
    I64 a = max(bar_h(), shotsel.plate_lo());
    I64 b = shotsel.plate_hi();
    if (sh_up) {
        sh_up = false;                 // the rows and every client whole first: what the shadow falls on
        if (a < b) { paint_rows(a, b); }
        for i in 0..WINDOWS {
            if (kind[i] == PIXEL) { place(i); }
        }
        settle();
        sh_up = true;
        Bool was = arrow_off(a, b);
        I64 x0 = sh_x0();
        for y in a..b {
            I64 got = hdeskctl.fb_peek(0, y, sh_line[0..4 * w]);
            if (got == w) {
                shotsel.unpack(sh_line[0..4 * w], row, w);
                shotsel.plate_row_at(row[0..w], y);
                I64 put = tilectl.fb_span(y, x0, row[x0..w]);
            }
        }
        arrow_back(was);
    } else if (a < b) {
        paint_rows(a, b);
    }
    for i in 0..WINDOWS {
        if (kind[i] == PIXEL) { place(i); }
    }
    settle();
}

// The plate's box with its shadow: from its shadow's left edge to the screen's right, rows plate_lo to plate_hi.
I64 sh_x0() { return shotsel.plate_x0() - shade.reach_side(2, 0, sc); }

// A terminal's span [a, b) of row y to the screen, short of the plate's box while the plate is up.
void sh_put(I64 y, I64 a, I64 b) {
    I64 e = b;
    if (sh_up && y >= shotsel.plate_lo() && y < shotsel.plate_hi()) { e = min(b, sh_x0()); }
    if (a < e) { I64 put = tilectl.fb_span(y, a, row[a..e]); }
}

// place()'s n rectangles cut around the plate's box: each into what lies above it, below it and left of it.
I64 sh_cut(I64 n) {
    I64[128] r;
    for q in 0..n {
        for j in 0..4 { r[4 * q + j] = word_at(place_buf, 6 + 4 * q + j); }
    }
    I64 bx = sh_x0();
    I64 by0 = shotsel.plate_lo();
    I64 by1 = shotsel.plate_hi();
    I64 m = 0;
    for q in 0..n {
        I64 x0 = r[4 * q];
        I64 y0 = r[4 * q + 1];
        I64 x1 = x0 + r[4 * q + 2];
        I64 y1 = y0 + r[4 * q + 3];
        m = put_rect(m, x0, y0, x1, min(y1, by0));
        m = put_rect(m, x0, max(y0, by1), x1, y1);
        m = put_rect(m, x0, max(y0, by0), min(x1, bx), min(y1, by1));
    }
    return m;
}

// A press on the plate opens the shot in View (sh_open); its release is taken too.
Bool sh_click(I64 value) {
    if (value == 0 && sh_swallow) {
        sh_swallow = false;
        return true;
    }
    if (value != 1 || !sh_up || !shotsel.plate_hit(mx, my)) { return false; }
    sh_swallow = true;
    U8[32] nm;
    I64 nn = sh_name(nm);
    U8[128] p;
    I64 n = shotdesk.path(nm[0..nn], sh_file[0..sh_fn], p);
    sh_hide();
    "hdesk: shot open\n";
    sh_open(p[0..n]);
    return true;
}

// The saved file opened as pl_path opens a file once it has its kind. The desk cannot stat a file in a home (0700,
// the account's), so the kind is the opener's rule for the name shot gave, a .png: View.
void sh_open(in U8[_] p) {
    I64 kd = opener.kind_of(p, false, p[0..0]);
    U8[32] pr;
    I64 pn = 0;
    if (kd >= 0) { pn = opener.prog_of(kd, pr); }
    U8[256] cmd;
    for k in 0..pn { cmd[k] = pr[k]; }
    cmd[pn] = ' ';
    I64 cn = shquote.quote(p, cmd, pn + 1, launch.MAX);
    if (pn == 0 || cn < 0) {
        "hdesk: ff no program\n";
        return;
    }
    "hdesk: ff runs |";
    I64 put = ptyctl.pty_write(1, cmd[0..cn]);
    "|\n";
    pl_run(cmd[0..cn]);
}

// The pointer to the kernel: at (mx, my) at the UI scale in the shape shape_now() names, shown or not
// (FBIO_TILE_CURSOR; DN-51 frame 26). `hdesk: shape S` when the shape changes.
void pointer(Bool on) {
    put_word(creq, 0, mx);
    put_word(creq, 1, my);
    put_word(creq, 2, sc);
    put_word(creq, 3, 0);
    if (on) {
        I64 k = shape_now();
        if (k != pkind) { "hdesk: shape {k}\n"; }
        pkind = k;
        put_word(creq, 3, k);
    }
    I64 st = tilectl.tile_ctl(FBIO_TILE_CURSOR, creq);
    pshown = on;
}

// Shape k's box at 1x: the rows above the hot spot, and its height (src/cursor.ci).
I64 ps_hot(I64 k) {
    if (k == PS_ARROW) { return 0; }
    return 12;
}
I64 ps_h(I64 k) {
    if (k == PS_ARROW) { return 16; }
    return 24;
}

// The resize shape of a grab on edges e (RZ_ bits), or 0 for none.
I64 rz_shape(I64 e) {
    if (e == RZ_LEFT || e == RZ_RIGHT) { return PS_WIDTH; }
    if (e == RZ_TOP || e == RZ_BOTTOM) { return PS_HEIGHT; }
    if (e == (RZ_LEFT | RZ_TOP) || e == (RZ_RIGHT | RZ_BOTTOM)) { return PS_NWSE; }
    if (e == (RZ_RIGHT | RZ_TOP) || e == (RZ_LEFT | RZ_BOTTOM)) { return PS_NESW; }
    return 0;
}

// The edges of float i that a press at (x, y) grabs (RZ_ bits), 0 for none: within RZ_IN inside or RZ_OUT outside an
// edge, a corner's RZ_CORNER square (RZ_OUT of it outside) taking both edges; a bar button is never a grab.
I64 rz_edges_of(I64 i, I64 x, I64 y) {
    I64 x0 = layout.frame_x(i);
    I64 y0 = layout.frame_y(i);
    I64 x1 = x0 + layout.frame_w(i);
    I64 y1 = y0 + layout.frame_h(i);
    I64 o = RZ_OUT * sc;
    I64 n = RZ_IN * sc;
    I64 c = (RZ_CORNER - RZ_OUT) * sc;
    if (x < x0 - o || x >= x1 + o || y < y0 - o || y >= y1 + o) { return 0; }
    if (on_bar(i) && bar_button(i) >= 0) { return 0; }
    I64 e = 0;
    Bool cl = x < x0 + c;
    Bool cr = x >= x1 - c;
    Bool ct = y < y0 + c;
    Bool cb = y >= y1 - c;
    if ((cl || cr) && (ct || cb)) {
        if (cl) { e = e | RZ_LEFT; } else { e = e | RZ_RIGHT; }
        if (ct) { e = e | RZ_TOP; } else { e = e | RZ_BOTTOM; }
        return e;
    }
    if (x < x0 + n) { e = e | RZ_LEFT; }
    if (x >= x1 - n) { e = e | RZ_RIGHT; }
    if (y < y0 + n) { e = e | RZ_TOP; }
    if (y >= y1 - n) { e = e | RZ_BOTTOM; }
    return e;
}

// DN-51 frame 26: the float whose resize grab holds the pointer, its edges into rz_hit; -1 for none. Floats only
// (no tile, no Full Screen), the desk's Fault window none, nothing while an overlay or an account screen is up: the
// window under the pointer, or a float the pointer is just outside of with nothing above it there.
I64 rz_hit = 0;
I64 rz_at() {
    rz_hit = 0;
    if (ac_screen != 0 || layout.is_live(OV) || my < bar_h()) { return -1; }
    I64 u = window_at(mx, my);
    I64 best = -1;
    for i in 0..WINDOWS {
        if (shown(i) && wmode[i] == layout.FLOAT && kind[i] != FAULT && (u < 0 || u == i || wmode[u] != layout.FLOAT ||
            wrank[u] < wrank[i]) && (best < 0 || wrank[i] > wrank[best])) {
            I64 e = rz_edges_of(i, mx, my);
            if (e != 0 && (u == i || mx < layout.frame_x(i) || my < layout.frame_y(i) ||
                mx >= layout.frame_x(i) + layout.frame_w(i) || my >= layout.frame_y(i) + layout.frame_h(i))) {
                best = i;
                rz_hit = e;
            }
        }
    }
    if (best < 0) { rz_hit = 0; }
    return best;
}

// DN-51 frame 26: the shape the pointer takes now. The Busy wheel goes beside the arrow (DN-37); a drag names its
// own (Move, a resize's edges, Not here for a pin off the Desk page's Taskbar list); else a float's resize grab, the
// desk's own text fields and a terminal's content are Text, and the rest the arrow.
I64 shape_now() {
    if (busy) { return PS_ARROW; }
    if (drag == 1) { return PS_MOVE; }
    if (drag == 2) { return PS_NWSE; }
    if (drag == 3) { return rz_shape(rz_edges); }
    if (st_pin_off()) { return PS_NOT_HERE; }
    if (text_field_at()) { return PS_TEXT; }
    I64 f = rz_at();
    if (f >= 0) { return rz_shape(rz_hit); }
    I64 i = window_at(mx, my);
    if (i >= 0 && i < WINDOWS && kind[i] == TERM && !sheet_blocks(i) && mx >= cbx(i) && mx < cbx(i) + cbw(i) &&
        my >= cby(i) && my < cby(i) + cbh(i)) {
        return PS_TEXT;
    }
    return PS_ARROW;
}

// Before the desk writes screen rows ya..yb: the pointer off them; true when it was taken off (section 5 item 2
// (b)). The shape's box: the arrow from its tip, the others about their center (DN-51 frame 26).
Bool arrow_off(I64 ya, I64 yb) {
    I64 ptop = my - ps_hot(pkind) * sc;
    if (!pshown || ptop >= yb || ptop + ps_h(pkind) * sc <= ya) { return false; }
    pointer(false);
    return true;
}

void arrow_back(Bool was) {
    if (was) { pointer(true); }
}

// The window whose visible rectangle holds screen pixel (x, y) on the active desktop, or -1.
I64 window_at(I64 x, I64 y) {
    for i in 0..16 {
        if (layout.is_live(i) && (i == OV || shown(i))) {
            for k in 0..layout.rects(i) {
                I64 rx = layout.rect_x(i, k);
                I64 ry = layout.rect_y(i, k);
                if (x >= rx && x < rx + layout.rect_w(i, k) && y >= ry && y < ry + layout.rect_h(i, k)) { return i; }
            }
        }
    }
    return -1;
}

// The grab ends (a clean Super tap, Alt+Tab, the window gone): the arrow back where it was.
void ungrab() {
    if (grab < 0) { return; }
    "hdesk: grab {grab} released\n";
    grab = -1;
    pvis = true;
    pointer(true);
}

// WB-2: the zone under the pointer during a move: a corner of the plane within 32 px (at 1x) is a quadrant (3 top
// left, 4 top right, 5 bottom left, 6 bottom right); else within 8 px of the left or right edge, 1 or 2; within 8 px
// of the plane's top, 7 (fullscreen); else 0. The bar's desktop numbers stay a drop on a desktop (H-4).
I64 zone_at() {
    I64 e = 8 * sc;
    I64 c = 32 * sc;
    I64 py = bar_h();
    I64 lx = mx / sc;
    I64 x0 = (w / sc - 9 * 24) / 2;
    if (my < py && lx >= x0 && lx < x0 + 9 * 24) { return 0; }
    Bool l = mx < c;
    Bool r = mx >= w - c;
    Bool t = my < py + c;
    Bool b = my >= h - c;
    if (l && t) { return 3; }
    if (r && t) { return 4; }
    if (l && b) { return 5; }
    if (r && b) { return 6; }
    if (mx < e) { return 1; }
    if (mx >= w - e) { return 2; }
    if (my < py + e) { return 7; }
    return 0;
}

// WB-2 (WB-R1 A): window i dropped in zone z. Left makes it the first tile, right the last, a quadrant the first,
// second, third or last (the nearest where the desktop has fewer tiles); the tiles keep their order and take new
// ranks. Top is fullscreen; the float's frame is its frame before the drag, for the way back.
void zone_apply(I64 i, I64 z) {
    if (z == 7) {
        wfx[i] = d0x;
        wfy[i] = d0y;
        wfw[i] = d0w;
        wfh[i] = d0h;
        wprev[i] = layout.FLOAT;
        wmode[i] = layout.MONOCLE;
        return;
    }
    I64[16] t;
    I64 n = 0;
    I64 last = -1;
    for k in 0..WINDOWS {
        I64 best = -1;
        for j in 0..WINDOWS {
            if (j != i && shown(j) && wdesk[j] == wdesk[i] && wmode[j] == layout.TILED && wrank[j] > last &&
                (best < 0 || wrank[j] < wrank[best])) {
                best = j;
            }
        }
        if (best >= 0) {
            t[n] = best;
            n = n + 1;
            last = wrank[best];
        }
    }
    I64 at = 0;
    if (z == 2) { at = n; }
    if (z >= 3) { at = z - 3; }
    if (at > n) { at = n; }
    I64 r = ranks;
    for k in 0..n + 1 {
        r = r + 1;
        if (k < at) { wrank[t[k]] = r; }
        if (k == at) { wrank[i] = r; }
        if (k > at) { wrank[t[k - 1]] = r; }
    }
    ranks = r;
    wmode[i] = layout.TILED;
}

// WB-2: the zone of a move drag of window i and its outline: the layout laid out as the drop would leave it, and back.
void zone_show(I64 i) {
    zone = zone_at();
    if (zone == 0) { return; }
    I64[16] rk;
    for k in 0..WINDOWS { rk[k] = wrank[k]; }
    I64 m = wmode[i];
    I64 pr = wprev[i];
    I64 rs = ranks;
    I64 fx = wfx[i];
    I64 fy = wfy[i];
    I64 fw = wfw[i];
    I64 fh = wfh[i];
    zone_apply(i, zone);
    relayout();
    zx = layout.frame_x(i);
    zy = layout.frame_y(i);
    zw = layout.frame_w(i);
    zh = layout.frame_h(i);
    for k in 0..WINDOWS { wrank[k] = rk[k]; }
    wmode[i] = m;
    wprev[i] = pr;
    ranks = rs;
    wfx[i] = fx;
    wfy[i] = fy;
    wfw[i] = fw;
    wfh[i] = fh;
}

// A drag's frame from the press's frame and the motion, a snap unit at a time (HX-3); an edge's resize (drag 3,
// DN-51 frame 26) live, a pixel at a time, its far edges held, the frame no smaller than RZ_MIN_W x RZ_MIN_H.
void drag_apply() {
    I64 i = drag_w;
    I64 ux = SNAP_W * sc;
    I64 uy = SNAP_H * sc;
    if (drag == 3) {
        I64 mw = max(RZ_MIN_W * sc, 8 * SNAP_W * sc);
        I64 mh = max(RZ_MIN_H * sc, 3 * SNAP_H * sc + WBAR * sc);
        if ((rz_edges & RZ_RIGHT) != 0) { wfw[i] = max(mw, min(d0w + dsx, w - d0x)); }
        if ((rz_edges & RZ_BOTTOM) != 0) { wfh[i] = max(mh, min(d0h + dsy, h - d0y)); }
        if ((rz_edges & RZ_LEFT) != 0) {
            I64 nx = max(0, min(d0x + dsx, d0x + d0w - mw));
            wfw[i] = d0x + d0w - nx;
            wfx[i] = nx;
        }
        if ((rz_edges & RZ_TOP) != 0) {
            I64 ny = max(bar_h(), min(d0y + dsy, d0y + d0h - mh));
            wfh[i] = d0y + d0h - ny;
            wfy[i] = ny;
        }
        keep_float(i);
        redraw();
        return;
    }
    if (drag == 1) {
        wfx[i] = d0x + (dsx / ux) * ux;
        wfy[i] = d0y + (dsy / uy) * uy;
    } else {
        wfw[i] = d0w + (dsx / ux) * ux;
        wfh[i] = d0h + (dsy / uy) * uy;
    }
    keep_float(i);
    zone = 0;
    if (drag == 1) { zone_show(i); }
    redraw();
}

// BP-6: EV_ABS code (0 x, 1 y) with value v into window i's queue; 0 queued, 1 the window did not ask.
I64 point_to(I64 i, I64 code, I64 v) {
    put_word(req, 0, pid[i]);
    put_word(req, 1, 3 | (code << 16));
    put_word(req, 2, v & 0xFFFFFFFF);
    return tilectl.tile_ctl(FBIO_TILE_INPUT, req);
}

// BP-6: the arrow's place to the focused pixel window that asked, in its surface's pixels while the arrow is over
// its surface, and -1, -1 once when it leaves (or the focus moves).
void point_track() {
    I64 f = focused();
    I64 lx = -1;
    I64 ly = -1;
    if (f >= 0 && f < WINDOWS && kind[f] == PIXEL && ptr_ask[f] != 2 && window_at(mx, my) == f) {
        I64 k = scale_of(f);
        I64 sx = cbx(f) + (cbw(f) - k * surf_w(f)) / 2;
        I64 sy = cby(f) + (cbh(f) - k * surf_h(f)) / 2;
        if (mx >= sx && my >= sy && mx < sx + k * surf_w(f) && my < sy + k * surf_h(f)) {
            lx = (mx - sx) / k;
            ly = (my - sy) / k;
        }
    }
    if (ptr_in >= 0 && (ptr_in != f || lx < 0)) {
        if (kind[ptr_in] == PIXEL) {
            I64 a = point_to(ptr_in, 0, -1);
            I64 b = point_to(ptr_in, 1, -1);
        }
        ptr_in = -1;
    }
    if (lx < 0) { return; }
    if (point_to(f, 0, lx) == 1) {
        ptr_ask[f] = 2;
        return;
    }
    ptr_ask[f] = 1;
    I64 st = point_to(f, 1, ly);
    ptr_in = f;
}

// EV_REL: the grabbed window's, else the arrow's (clamped to the screen after each event), a drag's too.
void motion(I64 code, I64 value) {
    if (grab >= 0 && focused() == grab && kind[grab] == PIXEL) {
        forward(EV_REL, code, value);
        return;
    }
    if (grab >= 0) { ungrab(); }
    I64 ox = mx;
    I64 oy = my;
    if (code == 0) { mx = mx + value; }
    if (code == 1) { my = my + value; }
    if (mx < 0) { mx = 0; }
    if (my < 0) { my = 0; }
    if (mx > w - 1) { mx = w - 1; }
    if (my > h - 1) { my = h - 1; }
    pvis = true;
    pointer(true);
    if (drag == 0 && (mx != ox || my != oy)) { point_track(); }
    if (pl_open && (mx != ox || my != oy)) { pl_hover(); }   // FF 3g: hover grows the cell's icon (MS-6)
    if (tr_open && (mx != ox || my != oy)) { tray_hover(); }   // DN-15: the cell under the pointer
    if (cal_open && (mx != ox || my != oy) && calpop.hover(mx / am_z(), my / am_z())) { redraw_overlay(); }
    if (mn_open && mn_app && (mx != ox || my != oy) && ctxmenu.hover(mx / am_z(), my / am_z())) {
        relayout();                    // AM-1: a submenu may open: the OV window grows to hold it
        redraw();
    }
    if (drag == 0 && (mx != ox || my != oy)) { bar_hover(); }   // DN-23: a bar button under the pointer
    if (drag != 0 && (mx != ox || my != oy)) {
        dsx = dsx + mx - ox;
        dsy = dsy + my - oy;
        drag_apply();
    }
    if (drag == 0 && st_pin_drag() && (mx != ox || my != oy)) {
        st_pin_move();                 // frame 33: the pin follows; off the list, Not here (frame 26)
        pointer(true);
    }
}

// DN-23: the float bar button under the pointer, its tint drawn again when it changes.
void bar_hover() {
    I64 wi = -1;
    I64 k = -1;
    I64 i = window_at(mx, my);
    if (i >= 0 && i < WINDOWS && on_bar(i)) {
        k = bar_button(i);
        if (k >= 0) { wi = i; }
    }
    if (wi == bh_win && k == bh_btn) { return; }
    I64 was = bh_win;
    bh_win = wi;
    bh_btn = k;
    if (was >= 0 && was < WINDOWS && kind[was] != NONE) {
        paint_rows(layout.frame_y(was), layout.frame_y(was) + fi(was) + tb(was));
    }
    if (wi >= 0 && wi != was) { paint_rows(layout.frame_y(wi), layout.frame_y(wi) + fi(wi) + tb(wi)); }
}

// A click on the bar (K-5): the mark toggles the Super plane (FF-5), the App pill its dropdown, a desktop's pill switches to it,
// a grant pill toggles its list (KD-1 A), the clock the calendar (K-6).
void bar_click() {
    I64 lx = mx / sc;
    I64 x0 = (w / sc - 9 * 24) / 2;
    if (lx < 36) {
        if (pl_open) { pl_shut(false); } else { pl_open_now(); }
        return;
    }
    if (pl_open) { pl_shut(true); }
    I64 vx = 44 + app_w + 12;
    if (app_w > 0 && lx >= 44 && lx < 44 + app_w) {
        if (mn_open) { menu_close(); } else { app_open(); }
    } else if (app_w > 0 && bar_vl > 0 && lx >= vx && lx < vx + txt_w(bar_var, bar_vl, faces.PATH)) {
        bar_path();                    // DN-7: the bar's path is not a field
    } else if (strip_on() && lx >= x0 && lx < x0 + 9 * 24) {   // DN-22: the strip takes clicks only while shown
        desk_to((lx - x0) / 24 + 1, -1);   // MS-7
        "hdesk: desktop {cur} by click\n";
        redraw();
    } else if (tr_w > 0 && lx >= tr_x && lx < tr_x + tr_w) {
        if (tr_open) { tray_close(); } else { tray_show(); }   // SP-2: the tray's list
    } else if (lx >= sp_x && lx < sp_x + 24) {
        if (sp_open) { sp_close(); } else { sp_show(); }   // SP-1: the system panel
    } else if (lx >= clk_x && lx < clk_x + clk_w) {
        if (cal_open) { cal_close(); } else { cal_show_now(); }
    }
}

// Whether window i is an Index (its program finder).
Bool is_index(I64 i) {
    if (kind[i] != PIXEL || title_len(i) != 6) { return false; }
    for k in 0..6 {
        if (title[16 * i + k] != b"finder"[k]) { return false; }
    }
    return true;
}

// DN-46 (c): the pins to Index window i (kit/taskbar.ci): PIN_CLEAR, then each pin's key.
void pins_tell(I64 i) {
    if (!is_index(i)) { return; }
    put_word(req, 0, pid[i]);
    put_word(req, 1, taskbar.EV_PIN | (taskbar.PIN_CLEAR << 16));
    put_word(req, 2, 0);
    I64 st = tilectl.tile_ctl(FBIO_TILE_INPUT, req);
    for k in 0..plane.pins() {
        U8[96] t;
        I64 n = plane.pin_sub(k, t);
        put_word(req, 0, pid[i]);
        put_word(req, 1, taskbar.EV_PIN | (taskbar.PIN_ADD << 16));
        put_word(req, 2, taskbar.key(t[0..n]));
        st = tilectl.tile_ctl(FBIO_TILE_INPUT, req);
    }
}

// DN-46 (c): after a pin changes anywhere, every Index learns the new set.
void pins_tell_all() {
    for i in 0..WINDOWS { pins_tell(i); }
}

// DN-7 (design note 7): a click on the bar's path focuses the focused Finder's path pill with its text selected,
// as Ctrl+L does (the desk sends it the chord); for any other program it does nothing.
void bar_path() {
    I64 f = focused();
    if (f < 0 || kind[f] != PIXEL || title_len(f) != 6) { return; }
    for k in 0..6 {
        if (title[16 * f + k] != b"finder"[k]) { return; }
    }
    "hdesk: bar path to window {f}\n";
    forward(1, keymap.KEY_LEFTCTRL, 1);
    forward(1, KEY_L, 1);
    forward(1, KEY_L, 0);
    forward(1, keymap.KEY_LEFTCTRL, 0);
}

// WB-1: the event's time in ms (its timeval, as the kernel stamped it).
I64 ev_ms() {
    I64 sec = 0;
    I64 us = 0;
    for k in 0..4 {
        sec = sec | (ev[k] as I64 << (8 * k));
        us = us | (ev[8 + k] as I64 << (8 * k));
    }
    return sec * 1000 + us / 1000;
}

// WB-1: the pointer on window i's bar.
Bool on_bar(I64 i) {
    I64 y0 = layout.frame_y(i) + fi(i);
    return tb(i) > 0 && my >= y0 && my < y0 + tb(i) && mx >= cbx(i) && mx < cbx(i) + cbw(i);
}

// The bar button under the pointer (0 minimize, 1 fullscreen, 2 tile, 3 close), or -1.
I64 bar_button(I64 i) {
    I64 lx = (mx - cbx(i)) / sc - (cbw(i) / sc - 2 - 4 * BTN_W);   // DN-23: four 24 px buttons ending 4 in
    if (lx < 0 || lx >= 4 * BTN_W) { return -1; }
    if (kind[i] == FAULT && lx / BTN_W != 3) { return -1; }        // frame 23: the close button alone
    return lx / BTN_W;
}

// DN-51 frame 25 (design answers 2026-11-12 08:23Z): "NAME is not answering." A window the desk opened for an app
// (a terminal typed with exec, lx_len; a pixel window of an app of kit/apps.ci) is watched after input reaches the
// desk: input waiting unread with none taken (FBIO_TILE_INFO kinds 17 and 18) for NR_FIRST_MS puts the sheet over
// that window alone. Wait takes it away and asks again after NR_AGAIN_MS more; input taken takes it away by itself;
// Close NAME ends the program at once, no second ask. Never a Console's command or the desk's own windows.
const I64 NR_FIRST_MS = 5000;
const I64 NR_AGAIN_MS = 15000;
const I64 NR_POLL_MS = 250;
const I64 NR_DIM = 154;               // the content toward its ground by 60 percent: drawn at 40
const I64 SIGKILL = 9;
Bool nr_any = false;                  // a window may hold unread input: frames come and nr_tick polls
I64 nr_last = 0;
Bool[16] nr_on;                       // window i holds unread input, since nr_t0 with nr_tk taken
I64[16] nr_t0;
I64[16] nr_tk;
I64[16] nr_lim;

I64 nr_owner = -1;                    // the window the sheet was last put over

// Window i's sheet, About's or not answering's: whether one blocks it, and the parts of [x0, x1) x [y0, y1) outside it.
Bool sheet_blocks(I64 i) { return about.blocks(i) || noanswer.blocks(i); }
I64 sheet_around(I64 i, I64 x0, I64 y0, I64 x1, I64 y1, inout I64[16] pc) {
    if (about.blocks(i)) { return about.around(x0, y0, x1, y1, am_z(), tokens.theme(), pc); }
    return noanswer.around(x0, y0, x1, y1, am_z(), tokens.theme(), pc);
}

Bool nr_app(I64 i) {
    if (kind[i] == TERM) { return lx_len[i] > 0 && !lx_host[i]; }   // RG-1: a host is never shown; its app's window is watched
    if (kind[i] == PIXEL) { return win_app(i) != apps.NONE; }
    return false;
}

void nr_tick() {
    I64 now = wall.wall_ns() / 1000000;
    if (now - nr_last < NR_POLL_MS) { return; }
    nr_last = now;
    Bool any = false;
    for i in 0..WINDOWS {
        if (nr_app(i)) {
            I64 st = 0;
            if (kind[i] == TERM) {
                st = hdeskctl.tile_ask(FBIO_TILE_INFO, 18, master[i], ask[0..64]);
            } else {
                st = hdeskctl.tile_ask(FBIO_TILE_INFO, 17, pid[i], ask[0..64]);
            }
            I64 un = 0;
            I64 tk = 0;
            if (st >= 0) {
                for k in 0..4 { un = un | (ask[4 + k] as I64 << (8 * k)); }
                for k in 0..7 { tk = tk | (ask[8 + k] as I64 << (8 * k)); }
            }
            if (un == 0) {
                nr_on[i] = false;
                if (noanswer.blocks(i)) { nr_leave(i, b"read"); }
            } else if (!nr_on[i]) {
                nr_on[i] = true;
                nr_t0[i] = now;
                nr_tk[i] = tk;
                nr_lim[i] = NR_FIRST_MS;
            } else if (tk != nr_tk[i]) {
                nr_t0[i] = now;
                nr_tk[i] = tk;
                nr_lim[i] = NR_FIRST_MS;
                if (noanswer.blocks(i)) { nr_leave(i, b"read"); }
            } else if (now - nr_t0[i] >= nr_lim[i] && !noanswer.is_up()) {
                nr_show(i, un);
            }
            if (nr_on[i]) { any = true; }
        } else {
            nr_on[i] = false;
        }
    }
    nr_any = any;
}

void nr_show(I64 i, I64 un) {
    U8[24] t;
    I64 n = 0;
    if (kind[i] == TERM) {
        n = min(lx_len[i], 24);
        for k in 0..n { t[k] = lx_name[32 * i + k]; }
    } else {
        n = win_name(i, t);
    }
    I64 z = am_z();
    noanswer.open(i, cbx(i) / z, cby(i) / z, cbw(i) / z, cbh(i) / z, t[0..n]);
    nr_owner = i;
    "hdesk: not answering {i} unread {un}\n";
    redraw();
}

void nr_leave(I64 i, in U8[_] why) {
    noanswer.close();
    "hdesk: answering {i} (";
    I64 put = ptyctl.pty_write(1, why);
    ")\n";
    redraw();
}

// The sheet's answer: Wait asks again after NR_AGAIN_MS more unread; Close NAME ends the window's program at once.
void nr_answer(I64 r) {
    I64 i = noanswer.window();
    if (r == noanswer.STAY) {
        redraw();
        return;
    }
    if (i < 0) {                       // the sheet closed itself on the answer: its window is the last shown
        i = nr_owner;
    }
    if (r == noanswer.WAIT && i >= 0) {
        nr_t0[i] = wall.wall_ns() / 1000000;
        nr_lim[i] = NR_AGAIN_MS;
        "hdesk: not answering {i} wait\n";
    }
    if (r == noanswer.END && i >= 0) {
        I64 st = 0;
        if (kind[i] == TERM) { st = hdeskctl.pty_sigsess(master[i], SIGKILL); }
        if (kind[i] == PIXEL && info(i)) { st = tilectl.stop(vpid[i], SIGKILL); }
        "hdesk: not answering {i} close ({st})\n";
    }
    redraw();
}

// DN-51 frame 23 (design answers 2026-11-12 08:23Z): window i, a terminal the desk opened for an app (lx_len, the
// app typed with exec), ended after its program sent its fault record (OSC 7770 fault, user/ci/main.c): the record
// to kit/faultwin.ci under the name the bar gave the app, and the source line at its position when the session's
// account can read it. A Console's command keeps its report in its own terminal (it has no lx_len).
void fault_take(I64 i) {
    I64 s = slot[i];
    U8[384] vals;
    I64[6] lens;
    for f in 0..faultwin.FIELDS {
        U8[64] v;
        lens[f] = terms.fault_field(s, f, v);
        for k in 0..lens[f] { vals[64 * f + k] = v[k]; }
    }
    faultwin.open(lx_name[32 * i..32 * i + min(lx_len[i], 24)], vals, lens);
    U8[200] at;
    I64[2] lc;
    I64 an = faultwin.position(at, lc);
    fw_pn = 0;
    if (an > 0 && lc[0] > 0) { fw_pn = fault_path(at[0..an], fw_path); }
    U8[160] t;
    I64 tn = -1;
    if (fw_pn > 0) { tn = fault_line(fw_path[0..fw_pn], lc[0], t); }
    I64[16] st;
    Bool cv = corectl.co_stat(b"/bin/cvim", 1, st) >= 0;
    if (tn >= 0) {
        I64 a = 0;                     // the line's indent left out, the fault's column kept in view
        while (a < tn && a + 1 < lc[1] && (t[a] == ' ' || t[a] == 9)) { a = a + 1; }
        if (lc[1] - a > FW_VIEW) { a = lc[1] - FW_VIEW; }
        faultwin.source(lc[0], lc[1] - a, t[a..tn], cv && lc[1] > 0);
    }
    U8[64] c;
    I64 cn = terms.fault_field(s, 0, c);
    if (!shquote.printable(c[0..cn])) { cn = 0; }   // the program's bytes in the desk's log: one line, never two
    "hdesk: fault {i} code ";
    I64 put = ptyctl.pty_write(1, c[0..cn]);
    " source {tn} open {faultwin.live()}\n";
}

const I64 FW_VIEW = 40;               // the source line's most characters before the fault's column
const I64 FW_SCAN = 1048576;          // the most bytes read to find the fault's line
const I64 FW_READ = 0x20800;          // O_RDONLY | O_NONBLOCK | O_NOFOLLOW (FS-5, as kit/setfile.ci)

// The record's path p as the desk opens it into dst: as is when absolute, else under the session's home (where a
// program the account built names its source); the length, 0 when it does not fit or holds a control byte.
I64 fault_path(in U8[_] p, inout U8[_] dst) {
    if (len(p) == 0 || !shquote.printable(p)) { return 0; }
    I64 n = 0;
    if (p[0] != '/') {
        U8[64] hb;
        I64 hn = home_of(hb);
        while (hn > 1 && hb[hn - 1] == '/') { hn = hn - 1; }
        if (hn > 1) { n = put_text(dst, 0, hb[0..hn]); }
        dst[n] = '/';
        n = n + 1;
    }
    if (n + len(p) > len(dst)) { return 0; }
    return put_text(dst, n, p);
}

// Line l (1-based) of file p into t, cut at len(t), tabs as spaces; its length, or -1. The file is read only as the
// session's account's own regular file (FS-5's way, kit/setfile.ci load): no link is followed and the descriptor is
// asked its kind and owner, so what is checked is what is read; with no account (the desk's own run) any regular
// file the desk can read. At most FW_SCAN bytes are read.
I64 fault_line(in U8[_] p, I64 l, inout U8[_] t) {
    I64 fd = shctl.sh_open(p, FW_READ, 0);
    if (fd < 0) { return -1; }
    I64[16] st;
    I64 s = fdctl.fd_stat(fd, st);
    if (s >= 0 && (st[corectl.ST_MODE] & corectl.S_IFMT) != corectl.S_IFREG) { s = -1; }
    if (s >= 0 && ac_on && st[corectl.ST_UID] != s_uid) { s = -1; }
    if (s < 0) {
        _ = shctl.fd_close(fd);
        return -1;
    }
    U8[512] blk;
    I64 at = 1;
    I64 n = 0;
    I64 seen = 0;
    Bool done = false;
    I64 got = shctl.fd_read(fd, blk);
    while (got > 0 && !done) {
        for k in 0..got {
            if (!done) {
                U8 b = blk[k];
                if (b == 10) {
                    if (at == l) { done = true; }
                    at = at + 1;
                } else if (at == l && n < len(t)) {
                    if (b == 9) { b = 32; }
                    t[n] = b;
                    n = n + 1;
                }
            }
        }
        seen = seen + got;
        if (!done && seen < FW_SCAN) { got = shctl.fd_read(fd, blk); } else { done = true; }
    }
    _ = shctl.fd_close(fd);
    if (at < l || (at == l && n == 0 && !done)) { return -1; }
    return n;
}

// DN-51 frame 23: the Fault window for the record fault_take kept, a float centered on the plane, focused.
void fault_show() {
    I64 i = fw_win;
    if (i < 0 || kind[i] != FAULT) { i = free_window(); }
    if (i < 0) {
        "hdesk: no room for fault\n";
        return;
    }
    kind[i] = FAULT;
    wdesk[i] = cur;
    wmode[i] = layout.FLOAT;
    wfw[i] = faultwin.FW * sc;
    wfh[i] = faultwin.FH * sc;
    wfx[i] = (w - wfw[i]) / 2;
    wfy[i] = bar_h() + (plane_h() - wfh[i]) / 2;
    keep_float(i);
    ranks = ranks + 1;
    wrank[i] = ranks;
    fw_win = i;
    "hdesk: fault window {i} frame {wfx[i]},{wfy[i]} {wfw[i]}x{wfh[i]}\n";
    _ = raise(i);
    redraw();
}

// A key or press in the Fault window: Open in CVim starts CVim at the record's file (pl_run, so as the session's
// account) and puts it at the line and column once it declares itself; Close closes the window.
void fault_act(I64 r) {
    if (r == faultwin.STAY) {
        redraw();
        return;
    }
    I64 i = fw_win;
    if (r == faultwin.OPEN && faultwin.live() && fw_pn > 0) {
        U8[300] c;
        I64 cn = shquote.quote(fw_path[0..fw_pn], c, put_text(c, 0, b"cvim "), launch.MAX);
        if (cn > 0) {
            fw_jl = faultwin.line();
            I64[2] lc;
            U8[8] at;
            I64 an = faultwin.position(at, lc);
            fw_jc = lc[1];
            if (i >= 0) { close_window(i); }
            pl_last = -1;
            pl_run(c[0..cn]);
            fw_jump = pl_last;
            "hdesk: fault open in cvim window {fw_jump} at {fw_jl}:{fw_jc}\n";
            return;
        }
    }
    if (i >= 0) { close_window(i); }
    "hdesk: fault closed\n";
    redraw();
}

// After a drain: CVim, started by Open in CVim, declared itself (it reads keys now): `LINE G 0`, then `COL-1 l`.
void fault_jump() {
    if (fw_jump < 0 || kind[fw_jump] != TERM) { return; }
    U8[24] nm;
    if (terms.menu_name(slot[fw_jump], nm) == 0) { return; }
    U8[48] k;
    I64 n = digits(k, 0, fw_jl);
    k[n] = 'G';
    k[n + 1] = '0';
    n = n + 2;
    if (fw_jc > 1) {
        n = digits(k, n, fw_jc - 1);
        k[n] = 'l';
        n = n + 1;
    }
    I64 put = ptyctl.pty_write(master[fw_jump], k[0..n]);
    "hdesk: fault jump {fw_jump} ({put})\n";
    fw_jump = -1;
}

// WB-4 (WB-R4 A): the close button ends every process of window i: a terminal's whole session (TIOCSIGSESS on its
// master), a pixel client's process; the window goes when they end. Super+q stays the foreground process alone.
void end_window(I64 i) {
    if (kind[i] == FAULT) {            // frame 23: the record goes with its window
        close_window(i);
        redraw();
        "hdesk: fault closed\n";
        return;
    }
    if (kind[i] == SETTINGS) {         // DN-10: the desk's own window closes
        close_window(i);
        redraw();
        "hdesk: settings closed\n";
        return;
    }
    if (!info(i)) { return; }
    I64 st = 0;
    if (kind[i] == TERM) { st = hdeskctl.pty_sigsess(master[i], SIGTERM); }
    if (kind[i] == PIXEL) { st = tilectl.stop(vpid[i], SIGTERM); }
    "hdesk: close {i} ({st})\n";
}

// HX-1: focusing a window raises it. A float or a fullscreen window takes the top rank; a tile keeps its cell, under
// them. A raise that would cut a window past layout.RECTS rectangles is refused, and the order stays. True when the
// order changed.
Bool raise(I64 i) {
    Bool up = false;
    I64 nr = stack.raised(wmode[i], wrank[i], ranks);
    if (nr != wrank[i]) {
        relayout();
        I64 was = cut_past();
        I64 r = wrank[i];
        wrank[i] = nr;
        relayout();
        if (cut_past() > was) {
            wrank[i] = r;
            relayout();
        } else {
            ranks = nr;
            up = true;
        }
    }
    layout.focus(i);
    if (up) { "hdesk: raise {i} rank {wrank[i]}\n"; }
    return up;
}

// The windows cut past layout.RECTS rectangles on the active desktop.
I64 cut_past() {
    I64 n = 0;
    for i in 0..WINDOWS {
        if (kind[i] != NONE && shown(i) && layout.rects(i) < 0) { n = n + 1; }
    }
    return n;
}

// A left press on float i's bar: a button is held until its release; a second still click is fullscreen; else a move.
void bar_press(I64 i) {
    Bool moved = i != focused();
    if (raise(i)) { moved = true; }
    I64 k = bar_button(i);
    if (k >= 0) {
        bb_win = i;
        bb_btn = k;
        redraw();
        return;
    }
    I64 t = ev_ms();
    if (bar_last == i && t - bar_t <= DCLICK && kind[i] != FAULT) {
        bar_last = -1;
        "hdesk: bar double {i}\n";
        chord(KEY_Z, false, false);
        return;
    }
    drag_w = i;
    drag = 1;
    bar_drag = true;
    dsx = 0;
    dsy = 0;
    d0x = wfx[i];
    d0y = wfy[i];
    d0w = wfw[i];
    d0h = wfh[i];
    "hdesk: drag {i} kind 1 bar\n";
    if (moved) { redraw(); }   // a press on the focused float's bar changes nothing yet
}

// The release of a press on button bb_btn of bb_win: on the same button it acts on the window, now focused.
void bar_release() {
    I64 i = bb_win;
    I64 k = bb_btn;
    bb_win = -1;
    bb_btn = -1;
    if (kind[i] == NONE || window_at(mx, my) != i || !on_bar(i) || bar_button(i) != k) {
        redraw();
        return;
    }
    "hdesk: bar button {k} window {i}\n";
    if (k == 0) { chord(KEY_M, false, false); }
    if (k == 1) { chord(KEY_Z, false, false); }
    if (k == 2) { chord(KEY_F, false, false); }
    if (k == 3) { end_window(i); }
}

// A mouse button: to the grabbed window; else a press focuses the window under the arrow (click to focus), a
// press in the focused pixel window grabs the pointer, Super with a press drags (left moves, right resizes).
void button(I64 code, I64 value) {
    if (grab >= 0 && focused() == grab && kind[grab] == PIXEL) {
        if (swallow_up && code == BTN_LEFT && value == 0) {
            swallow_up = false;
            return;
        }
        forward(1, code, value);
        return;
    }
    if (grab >= 0) { ungrab(); }
    if (ac_screen != 0) {                    // AC-1c: the account screens are keys, but for frame 12's power pills
        if (value == 1 && code == BTN_LEFT) { ac_click(); }
        return;
    }
    if (kp_open) {
        if (value == 1 && window_at(mx, my) != OV) { kern_answer(false); }   // R0-2: a click off the prompt refuses
        return;
    }
    if (code == BTN_LEFT && sh_click(value)) { return; }   // RS-SHOT: a click on the plate opens the shot in View
    if (value == 0 && pl_open && code == BTN_LEFT && plane.pressed() >= 0) {
        pl_release();                     // FF 3g: a cell opens on the release
        return;
    }
    if (value == 0 && ptr_btn == code) {
        ptr_btn = -1;
        I64 f = focused();
        if (f >= 0 && f < WINDOWS && kind[f] == PIXEL && ptr_ask[f] == 1) { forward(1, code, 0); }
        return;
    }
    if (value == 0) {
        if (bb_win >= 0 && code == BTN_LEFT) {
            bar_release();
            return;
        }
        if (code == BTN_LEFT && st_pin_drag()) {
            st_pin_release();          // frame 33's drag of a pin ends; DN-51 frame 26: a refused drop moves nothing
            if (pvis && grab < 0) { pointer(true); }
            return;
        }
        if (drag != 0 && code != BTN_MIDDLE) {
            I64 i = drag_w;
            I64 drag_kind = drag;
            drag = 0;
            bar_last = -1;
            Bool still = bar_drag && dsx == 0 && dsy == 0;
            if (still) {
                bar_last = i;              // a still click on the bar: the first of a double click
                bar_t = ev_ms();
            }
            bar_drag = false;
            I64 z = 0;
            if (drag_kind == 1 && (dsx != 0 || dsy != 0)) { z = zone_at(); }   // a moved window only
            zone = 0;
            if (z > 0) {
                zone_apply(i, z);
                "hdesk: zone {i} {z}\n";
            }
            if (my < bar_h()) {
                I64 x0 = (w / sc - 9 * 24) / 2;
                I64 lx = mx / sc;
                if (strip_on() && lx >= x0 && lx < x0 + 9 * 24) {
                    wdesk[i] = (lx - x0) / 24 + 1;   // dropped on a desktop's number (DN-22: while the strip shows)
                }
            }
            "hdesk: drop {i} desktop {wdesk[i]} frame {wfx[i]},{wfy[i]} {wfw[i]}x{wfh[i]}\n";
            if (!still) { redraw(); }
            if (pvis && grab < 0) { pointer(true); }   // DN-51 frame 26: the drag's shape ends with it
        }
        return;
    }
    if (value != 1) { return; }
    meta_clean = false;
    if (my < bar_h() && !meta) {
        bar_click();
        return;
    }
    I64 i = window_at(mx, my);
    "hdesk: click {mx},{my} button {code - BTN_LEFT} window {i}\n";
    if (keysheet.is_up() && !kp_open) {             // frame 27: a press off the sheet closes it; on it, nothing
        if (i != OV) { ks_close(); }
        return;
    }
    if (indextrash.is_up() && !kp_open) {           // frame 23: a click off the ask cancels it
        I64 ea = indextrash.CANCEL;
        if (i == OV && code == BTN_LEFT) {
            I64 z = am_z();
            ea = indextrash.press((mx - layout.frame_x(OV)) / z, (my - layout.frame_y(OV)) / z);
        } else {
            indextrash.close();
        }
        et_answer(ea);
        return;
    }
    if (unsaved.is_up() && !kp_open) {              // AM section 7: a click off the ask cancels it
        I64 ua = unsaved.CANCEL;
        if (i == OV && code == BTN_LEFT) {
            ua = unsaved.click((mx - layout.frame_x(OV)) / sc, (my - layout.frame_y(OV)) / sc);
        } else {
            unsaved.close();
        }
        uv_answer(ua);
        return;
    }
    if (acctform.is_up() && !kp_open) {             // RS-AQ: a click off the form cancels it
        I64 fa = acctform.CANCEL;
        if (i == OV && code == BTN_LEFT) {
            fa = acctform.click((mx - layout.frame_x(OV)) / sc, (my - layout.frame_y(OV)) / sc);
        } else {
            ac_form_end();
        }
        af_answer(fa);
        return;
    }
    if (i == OV) {
        if (pl_open && code == BTN_LEFT) { pl_click(); }
        if (pl_open && code == BTN_RIGHT) { pl_rclick(); }
        if (mn_open && code == BTN_LEFT) { menu_click(); }
        if (cal_open && code == BTN_LEFT) { cal_click(); }
        if (sp_open && code == BTN_LEFT) { sp_click(); }
        if (tr_open && (code == BTN_LEFT || code == BTN_RIGHT)) { tray_click(code); }
        return;
    }
    if (sw_open) { switcher_close(false); }
    if (mn_open) { menu_close(); }
    if (cal_open) { cal_close(); }
    if (sp_open) { sp_close(); }
    if (tr_open) { tray_close(); }
    I64 rz = -1;
    if (code == BTN_LEFT && !meta) { rz = rz_at(); }
    if (rz >= 0) {                     // DN-51 frame 26: a press in a float's resize grab resizes it from those edges
        drag_w = rz;
        drag = 3;
        rz_edges = rz_hit;
        dsx = 0;
        dsy = 0;
        d0x = wfx[rz];
        d0y = wfy[rz];
        d0w = wfw[rz];
        d0h = wfh[rz];
        _ = raise(rz);
        "hdesk: drag {rz} kind 3 edges {rz_edges}\n";
        pointer(true);
        redraw();
        return;
    }
    if (i < 0 || i >= WINDOWS) { return; }
    if (meta && code != BTN_MIDDLE) {
        drag_w = i;
        drag = 1;
        if (code == BTN_RIGHT) { drag = 2; }
        dsx = 0;
        dsy = 0;
        if (wmode[i] != layout.FLOAT) {
            wfx[i] = layout.frame_x(i);
            wfy[i] = layout.frame_y(i);
            wfw[i] = layout.frame_w(i);
            wfh[i] = layout.frame_h(i);
            wmode[i] = layout.FLOAT;
            ranks = ranks + 1;
            wrank[i] = ranks;
        }
        d0x = wfx[i];
        d0y = wfy[i];
        d0w = wfw[i];
        d0h = wfh[i];
        Bool up = raise(i);            // HX-1: a Super drag raises the float it moves
        "hdesk: drag {i} kind {drag}\n";
        redraw();
        return;
    }
    if (code == BTN_LEFT && on_bar(i)) {
        bar_press(i);
        return;
    }
    Bool other = i != focused();
    if (raise(i) || other) {           // HX-1: a press raises its window
        redraw();
        return;
    }
    if (noanswer.blocks(i)) {          // DN-51 frame 25: a press on the blocked window is the sheet's
        I64 z = am_z();
        if (code == BTN_LEFT) { nr_answer(noanswer.click(mx / z, my / z)); }
        return;
    }
    if (about.blocks(i)) {             // DN-43: a press on the blocked window is the sheet's (OK closes it)
        I64 z = am_z();
        if (code == BTN_LEFT && about.click(mx / z, my / z) == about.CLOSE) {
            "hdesk: about closed\n";
            redraw();
        }
        return;
    }
    if (kind[i] == SETTINGS && code == BTN_LEFT) {   // frame 48: the sidebar, the narrow button, the page
        settings_click(i);
        return;
    }
    if (kind[i] == FAULT) {
        if (code == BTN_LEFT) {
            fault_act(faultwin.click((mx - cbx(i)) / sc, (my - cby(i)) / sc, cbw(i) / sc, cbh(i) / sc));
        }
        return;
    }
    if (kind[i] == PIXEL && ptr_ask[i] == 0) {
        if (point_to(i, 0, -1) == 1) {   // BP-6: a press before any motion over the surface asks the window first
            ptr_ask[i] = 2;
        } else {
            ptr_ask[i] = 1;
            I64 st = point_to(i, 1, -1);
            point_track();
        }
    }
    if (kind[i] == PIXEL && ptr_ask[i] == 1) {
        ptr_btn = code;                // BP-6: a window that asked for the pointer takes its clicks, ungrabbed
        forward(1, code, 1);
        return;
    }
    if (kind[i] == PIXEL && code == BTN_LEFT) {
        grab = i;
        swallow_up = true;
        pvis = false;
        pointer(false);
        "hdesk: grab {i}\n";
    }
}

void route() {
    if (dev.ev_read(ev) != 1) { return; }
    idle_last = now_ns();              // AC-D5: any key, button or motion is input
    I64 k = ev[16] as I64 | (ev[17] as I64 << 8);
    I64 code = ev[18] as I64 | (ev[19] as I64 << 8);
    I64 value = ev[20] as I64 | (ev[21] as I64 << 8) | (ev[22] as I64 << 16) | (ev[23] as I64 << 24);
    if (value >= 0x80000000) { value = value - 0x100000000; }
    if (sh_sel) {                      // RS-SHOT: the area select has the pointer and the keys, nothing else does
        sh_route(k, code, value);
        return;
    }
    if (k == EV_REL) {
        motion(code, value);
        return;
    }
    if (k == 1 && code >= BTN_LEFT && code <= BTN_MIDDLE) {
        button(code, value);
        return;
    }
    if (k != 1) {
        if (!mn_open && !kp_open && !pl_open && ac_screen == 0) { forward(k, code, value); }
        return;
    }
    Bool is_meta = code == KEY_LEFTMETA || code == KEY_RIGHTMETA;
    if (value == 1 && !is_meta) { meta_clean = false; }   // a clean Super tap has no other key in it (HX-6)
    if (code == keymap.KEY_LEFTSHIFT || code == keymap.KEY_RIGHTSHIFT) { shift = value != 0; }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1 && tr_moving()) {
        tr_steps = tr_steps + 1;       // DN-14: the gates' frame, 10 ms of the turn
        turn_step();
    }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1 && tip_wait) {
        tip_steps = tip_steps + 1;     // SP-7: the tooltip's 400 ms, 40 Shift presses on the gates' clock
        if (tip_now() - tip_t0 >= anim.ms(TIP_MS)) { tip_show(); }
    }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1 && (ms5_live || ms8_live)) {
        ms5_steps = ms5_steps + 1;     // MS-5, MS-8: a plate's, the message's or a window's frame on the stepped clock,
        if (ms5_live) { plate_frame(); }   // before the holds tick, so the press that ends the message's hold starts
        if (ms8_live) { ms8_frame(); }     // its fade at step 0
        "hdesk: step {ms5_steps - mo_base} of motion {mo_n}\n";   // MS-9a: this step's frame is on the screen (the gates' dumps wait on it)
    }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1) {
        strip_tick(true);      // FF 3g: the strip's hold, stepped
        msg_tick(true);        // DN-6: the message's
        rv_tick(true);         // DN-10: the revert prompt's, 1500 steps
        sh_tick(true);         // RS-SHOT: the plate's 4 s
    }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1 && sl_from > 0) {
        sl_steps = sl_steps + 1;       // MS-7: the slide's frame on the stepped clock
        slide_tick();
    }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1 && ra_win >= 0) {
        ra_steps = ra_steps + 1;       // DN-21: the restore's frame on the stepped clock
        redraw();
    }
    if (stepped && code == keymap.KEY_LEFTSHIFT && value == 1 && pl_open && plane.moving()) {
        pl_steps = pl_steps + 1;       // MS-6: the plane's frame on the stepped clock
        pl_clock();
        redraw_overlay();
    }
    if (code == keymap.KEY_LEFTCTRL || code == keymap.KEY_RIGHTCTRL) { ctrl = value != 0; }
    if (code == KEY_LEFTALT || code == KEY_RIGHTALT) {
        alt = value != 0;
        if (!alt && sw_open && sw_key == KEY_LEFTALT && !sw_sticky) { switcher_close(true); }
        if (!sw_open && !mn_open && !kp_open && !pl_open && ac_screen == 0) { forward(k, code, value); }
        return;
    }
    if (is_meta) {
        if (value == 1) { meta_clean = !meta; }
        meta = value != 0;
        if (value == 0) {
            if (sw_open && sw_key == KEY_LEFTMETA && !sw_sticky) {
                switcher_close(true);
            } else if (meta_clean && grab >= 0) {
                ungrab();                  // HX-10 A: a clean Super tap ends the grab, the menu stays as it was
            } else if (meta_clean && !sw_open && !kp_open && ac_screen == 0) {
                if (pl_open) {
                    pl_shut(false);            // FF-5: a second tap closes the plane
                } else if (mn_open) {
                    menu_close();
                } else {
                    pl_open_now();
                }
            }
            meta_clean = false;
        }
        return;
    }
    if (sh_key(code, value)) { return; }   // RS-SHOT: Print, Alt+Print, Super+Shift+S, on every screen
    if (ac_screen != 0) {
        if (value != 0) { auth_key(code); }   // AC-1c, AC-D1: the account screens take every key
        return;
    }
    if (value == 1 && meta && code == KEY_L && ac_on && s_acct >= 0) {
        lock_now();
        return;
    }
    if (kp_open && kp_field) {
        if (value != 0) { prompt_key(code); }   // AC-1c: the passphrase, then Enter (or Super+Enter)
        return;
    }
    if (kp_open) {
        // R0-R3 A: Super+Enter runs, Esc refuses; no key reaches a program while the prompt is up
        if (value == 1 && code == KEY_ENTER && meta) {
            kern_answer(true);
        } else if (value == 1 && code == KEY_ESC) {
            kern_answer(false);
        }
        return;
    }
    if ((code == KEY_TAB && (alt || meta)) || (code == KEY_GRAVE && alt)) {
        if (value == 0) { return; }
        I64 d = 1;
        if (shift) { d = -1; }
        if (sw_open) {
            switcher_move(d);
            return;
        }
        if (mn_open) { mn_open = false; }
        I64 key = KEY_LEFTMETA;
        if (alt) { key = KEY_LEFTALT; }
        switcher_open(key, d, alt && ctrl && code == KEY_TAB, code == KEY_GRAVE);
        return;
    }
    if (sw_open) {
        if (value == 0) { return; }
        if (code == KEY_ESC) { switcher_close(false); }
        if (code == KEY_ENTER) { switcher_close(true); }
        if (code == KEY_LEFT) { switcher_move(-1); }
        if (code == KEY_RIGHT) { switcher_move(1); }
        if (code == KEY_UP) { switcher_row(-1); }
        if (code == KEY_DOWN) { switcher_row(1); }
        if (code == KEY_DELETE && sw_sel < sw_n) {
            I64 e = sw_list[sw_sel];
            if (info(e)) {
                "hdesk: end {e} pid {vpid[e]}\n";
                I64 st = tilectl.stop(vpid[e], SIGTERM);
            }
        }
        return;
    }
    if (pl_open) {
        if (value == 0) { return; }
        if (!meta) {
            pl_key(code);
        } else if (code == KEY_P) {
            pl_pin();
        } else if (code == keymap.KEY_LEFTSHIFT || code == keymap.KEY_RIGHTSHIFT || code == keymap.KEY_LEFTCTRL ||
                   code == keymap.KEY_RIGHTCTRL) {
            // FF-4b: a modifier with Super is a chord not yet whole; it closes nothing (Super+Shift+Q again)
        } else if ((code == KEY_Q || code == KEY_R) && shift) {
            chord(code, shift, ctrl);  // FF-R6 B: the power chords arm or act in the open plane
        } else {
            pl_shut(true);             // any other chord: the plane closes, the chord acts
            chord(code, shift, ctrl);
            redraw();
        }
        return;
    }
    if (mn_open) {
        if (value != 0 && !meta) { menu_key(code); }
        return;
    }
    if (tr_open && !meta && (code == KEY_ESC || code == KEY_ENTER || code == KEY_LEFT || code == KEY_RIGHT ||
                             code == KEY_UP || code == KEY_DOWN)) {
        if (value != 0) { tray_key(code); }   // DN-15: arrows, Enter, Esc
        return;
    }
    if (sp_open && !meta && (code == KEY_ESC || code == KEY_LEFT || code == KEY_RIGHT)) {
        if (value == 0) { return; }
        if (code == KEY_ESC) { sp_close(); } else { sp_volume(au_lv + 5 * dx_of(code)); }   // SP-1: 5 % a press
        return;
    }
    if (cal_open && !meta && (code == KEY_ESC || code == KEY_LEFT || code == KEY_RIGHT)) {
        if (value == 0) { return; }
        cal_answer(calpop.key(code));      // RS-CAL: Left and Right step a month, Esc closes
        return;
    }
    if (acctform.is_up() && !kp_open) {            // RS-AQ: the form has the keys; Super+L still locks
        if (meta && value == 1 && ac_on && s_acct >= 0 && code == KEY_L) {
            lock_now();
        } else if (!meta && value != 0) {
            af_answer(acctform.key(code, keymap.byte_of(code, shift, false), shift));
        }
        return;
    }
    if (keysheet.is_up() && !kp_open) {            // frame 27: Esc or Super+/ closes the sheet; Super+L locks
        if (value == 1 && meta && ac_on && s_acct >= 0 && code == KEY_L) {
            lock_now();
        } else if (value == 1 && (keysheet.key(code) == keysheet.CLOSE || (meta && code == KEY_SLASH))) {
            ks_close();
        }
        return;
    }
    if (indextrash.is_up() && !kp_open) {          // frame 23: the ask has the keys (Enter empties, Esc cancels)
        if (value == 1) { et_answer(indextrash.key(code)); }
        return;
    }
    if (unsaved.is_up() && !kp_open) {             // AM section 7: the ask has the keys
        if (value == 1) { uv_answer(unsaved.key(code)); }
        return;
    }
    if (rv_open && !meta && !kp_open && (code == KEY_ENTER || code == KEY_ESC)) {
        if (value == 1) { rv_answer(code); }   // DN-10: Enter keeps the size, Esc reverts
        return;
    }
    if (meta) {
        if (value == 1 && ac_on && s_acct >= 0 && code == KEY_L) {
            lock_now();                    // AC-D5: Super+L
        } else if (value == 1) {
            chord(code, shift, ctrl);
        }
        return;
    }
    if (code == KEY_F11 && grab < 0) {
        if (value == 1) { chord(KEY_Z, false, false); }   // WB-R2 A: F11 is fullscreen
        return;
    }
    I64 f = focused();
    if (f < 0) { return; }
    // DN-43: the sheet has the blocked window's keys, whatever its kind (review on PR 272: a terminal's and Settings'
    // keys went to the window under the sheet, so Enter could run a shell line there).
    if (noanswer.blocks(f)) {          // DN-51 frame 25: the window's keys are the sheet's
        if (value == 1) { nr_answer(noanswer.key(code)); }
        return;
    }
    if (about.blocks(f)) {
        if (value == 1 && about.key(code) == about.CLOSE) {
            "hdesk: about closed\n";
            redraw();
        } else if (value == 1) {
            redraw();
        }
        return;
    }
    if (kind[f] == SETTINGS) {
        if (value != 0) { settings_key(code); }
        return;
    }
    if (kind[f] == FAULT) {
        if (value == 1) { fault_act(faultwin.key(code)); }
        return;
    }
    if (kind[f] == TERM) {
        if (value != 0) {
            I64 n = keymap.seq_of(code, shift, ctrl, kb);
            if (n > 0) { I64 put = ptyctl.pty_write(master[f], kb[0..n]); }
        }
        return;
    }
    forward(k, code, value);
}

// Every terminal's master read until it has nothing, or DRAIN_MAX bytes of it this sync (a flood's rest at the
// next, board 20261110T234031Z: the keys and the other windows in between): the bytes into its slot, its changed
// rows drawn.
const I64 DRAIN_MAX = 65536;

// RS-TTL: what float i's bar drew last (its name, its title, the dot), so that a program's exec or OSC between whole
// redraws paints the bar's rows again: Edit's bar names its file, not the shell that ran it.
I64[15] wb_sig;
void bar_again(I64 i) {
    Bool got = info(i);
    U8[16] t;
    I64 n = win_name(i, t);
    U8[256] v;
    I64 vl = var_of(i, v);
    I64 g = n;
    for k in 0..n { g = (g * 31 + t[k] as I64) % 1000000007; }
    g = (g * 31 + vl) % 1000000007;
    for k in 0..vl { g = (g * 31 + v[k] as I64) % 1000000007; }
    if (terms.menu_unsaved(slot[i])) { g = g + 1000000007; }
    if (g == wb_sig[i]) { return; }
    wb_sig[i] = g;
    I64 y0 = layout.frame_y(i);
    paint_rows(y0, y0 + (FB * sc + tb(i)));
}

U8[4096] pty_buf;   // PR 285: 4 KiB reads (was 512)
void drain() {
    for i in 0..WINDOWS {
        if (kind[i] == TERM) {
            I64 taken = 0;
            I64 got = ptyctl.pty_read(master[i], pty_buf);
            while (got > 0) {
                if (i == 0) { tbytes = tbytes + got; }
                terms.feed_bytes(slot[i], pty_buf, got);
                U8[64] rb;                     // AM section 7.2: the terminal's answers (DA1, XTVERSION) back
                I64 rn = terms.replies(slot[i], rb);
                if (rn > 0) { I64 rw = ptyctl.pty_write(master[i], rb[0..rn]); }
                taken += got;
                got = 0;
                if (taken < DRAIN_MAX) { got = ptyctl.pty_read(master[i], pty_buf); }
            }
            if (taken > 0) {
                pl_rle_ok = false;
                gh_rle_ok = false;
                slide.clear();         // MS-R5: a terminal's text changed under the slide's kept rows
            }
            term_rows(i);
            if (taken > 0 && tb(i) > 0 && shown(i)) { bar_again(i); }
        }
    }
    fault_jump();
    if (grants()) {
        redraw();
    } else {
        bar(false);
    }
    bars_named();
    k12_mark(1);
}

void usage() {
    "hdesk: usage: hdesk [--run TEXT] [--monocle]\n";
    dev.exit_now(2);
}

// Argument k (from 0) into `word`: its length, or -1 past the last.
I64 arg(in U8[_] args, I64 k) {
    I64 at = 0;
    I64 i = 0;
    while (i < k) {
        if (at >= len(args)) { return -1; }
        if (args[at] == 0) { i = i + 1; }
        at = at + 1;
    }
    if (at >= len(args)) { return -1; }
    I64 n = 0;
    while (args[at + n] != 0) {
        if (n == len(word)) { usage(); }
        word[n] = args[at + n];
        n = n + 1;
    }
    return n;
}

Bool is(I64 n, in U8[_] s) {
    if (n != len(s)) { return false; }
    for i in 0..n {
        if (word[i] != s[i]) { return false; }
    }
    return true;
}

void main(in U8[_] args) {
    I64 k = 0;
    I64 an = arg(args, k);
    while (an >= 0) {
        if (is(an, b"--monocle")) {
            first_monocle = true;
        } else if (is(an, b"--run") && run_len == 0) {
            I64 p = arg(args, k + 1);
            if (p < 1) { usage(); }
            for q in 0..p { run_text[q] = word[q]; }
            run_text[p] = 10;
            run_len = p + 1;
            k = k + 1;
        } else {
            usage();
        }
        k = k + 1;
        an = arg(args, k);
    }
    if (dev.fb_open() != 0) {
        "hdesk: no framebuffer\n";
        dev.exit_now(2);
    }
    w = dev.fb_word(0) as I64;
    h = dev.fb_word(1) as I64;
    if (w > MODE_W_MAX || h > MODE_H_MAX || w * h > MODE_PX_MAX) {
        "hdesk: {w}x{h} is past RES-1's 5120 x 3840 and 3840 x 2160 pixels\n";   // what the row and the map hold
        dev.exit_now(2);
    }
    I64 st = tilectl.tile_ctl(FBIO_TILER, req);
    if (st < 0) {
        "hdesk: the screen is taken ({st})\n";
        dev.exit_now(2);
    }
    sc = auto_scale(w, h);
    layout.screen(w, h, sc);
    date();
    stepped = (sys_flags() & 2) != 0;   // SP-3: the gates step the chevron's frames by Shift
    pl_init();
    mx = w / 2;
    my = h / 2;
    "hdesk: screen {w}x{h} plane {w}x{plane_h()}\n";
    clock_prefs();                     // RS-TZb: the machine's zone before the first bar
    I64 au = au_read();                // P2-c: Sound knows the device before the panel opens
    "hdesk: audio {au_fl & 1} net {(au_fl >> 1) & 1} ({au})\n";
    ac_init();
    if (!ac_on) {
        I64 t0 = new_term(true, apps.NONE);  // HX-7: the desk's first terminal stays a tile (DN-20)
        if (t0 != 0) { dev.exit_now(2); }
    }
    if (run_len > 0 && kind[0] == TERM) {
        I64 put = ptyctl.pty_write(master[0], run_text[0..run_len]);
        "hdesk: run typed ({put})\n";
    }
    redraw();
    I64 ws = 0 - EAGAIN;
    while (ws == 0 - EAGAIN) {
        focus_tell();
        put_word(req, 0, 0);
        if (tr_moving() && !stepped) { put_word(req, 0, 2); }   // DN-14: FRAME, the chevron is turning
        if (strip_sw && !stepped) { put_word(req, 0, 2); }          // FF 3g: until the strip's hold ends
        if (msg_on && !stepped) { put_word(req, 0, 2); }            // DN-6: until the message's hold ends
        if (rv_open && !stepped) { put_word(req, 0, 2); }           // DN-10: the revert prompt's count
        if (pl_open && plane.armed_action() >= 0) { put_word(req, 0, 2); }   // FF-R6 B: until the armed chord lapses
        if (ac_on && ac_ticking()) { put_word(req, 0, 2); }   // AC-1c: authd at work, a wait, a prompt's deadline
        if (deskask.waiting()) { put_word(req, 0, 2); }       // RS-ASK: an approved act, done at the next tick
        if (runq.running() >= 0 || runq.next() >= 0) { put_word(req, 0, 2); }   // a run as the account, polled
        if (kp_shaking()) { put_word(req, 0, 2); }             // FV-1: the wrong passphrase's shake
        if (pl_open && plane.moving() && !stepped) { put_word(req, 0, 2); }   // MS-6: the plane's motion
        if (busy && !stepped) { put_word(req, 0, 2); }                       // DN-37: the Busy wheel's frames
        if (tip_wait && !stepped) { put_word(req, 0, 2); }                  // SP-7: until the tooltip's 400 ms
        if (ra_win >= 0 && !stepped) { put_word(req, 0, 2); }               // DN-21: a float on its way back
        if (sl_from > 0 && !stepped) { put_word(req, 0, 2); }               // MS-7: the desks sliding
        if ((ms5_live || ms8_live) && !stepped) { put_word(req, 0, 2); }      // MS-5, MS-8: a plate's or a window's motion
        if (nr_any) { put_word(req, 0, 2); }                                   // DN-51 frame 25: input to watch
        if (g_paint) {                 // frame 21: the Grants page told again since the last paint
            g_paint = false;
            redraw();
        }
        if (shotdesk.running() || (sh_up && !stepped)) { put_word(req, 0, 2); }   // RS-SHOT: the 20 s, the 4 s
        I64 s = tilectl.tile_ctl(FBIO_TILE_SYNC, req);
        if (s == 1) {
            route();
            nr_any = true;             // DN-51 frame 25: whatever reached an app is watched until it is taken
        } else if (s == 3) {
            drain();
        } else if (s == 4) {
            bound();
        } else if (s == 9) {
            kern_event();              // R0-2: ring 0's news
        } else if (s == 7) {
            tray_event();              // SP-2: a program asked for the tray or left it
        } else if (s == 10) {
            open_event();              // FF-6c: a window asked to open a file
        } else if (s == 8) {
            busy_tick();               // DN-37
            if (nr_any) { nr_tick(); }   // DN-51 frame 25
            if (tr_moving() && !stepped) { turn_step(); }   // DN-14: the chevron's next frame (stepped: Shift's)
            pw_expire();               // FF-R6 B: an armed power chord past its 2 s
            if (ac_on) { ac_tick(); }  // AC-1c
            kp_tick();                 // the desk's own ask, approved: done now
            if (runq.running() >= 0) { rn_poll(); }   // the runs as the account (Settings' pages)
            if (kp_shaking() || kp_shook) {    // FV-1: the shake's next frame, then one at rest
                kp_shook = kp_shaking();
                redraw_overlay();
            }
            strip_tick(false);         // FF 3g: the strip's hold
            msg_tick(false);           // DN-6 frame 9: the bar message's hold
            rv_tick(false);            // DN-10: the revert prompt's 15 s
            if (pl_open && plane.moving()) {
                pl_clock();            // MS-6: the plane's next frame
                redraw_overlay();
            }
            if (tip_wait && tip_now() - tip_t0 >= anim.ms(TIP_MS)) { tip_show(); }   // SP-7
            if (ra_win >= 0) { redraw(); }   // DN-21: the restore's next frame
            if (sl_from > 0) { slide_tick(); }   // MS-7: the slide's next frame, or its end
            if (ms5_live) { plate_frame(); }   // MS-5: a plate's next frame
            if (ms8_live) { ms8_frame(); }     // MS-8: the moving windows
            sh_tick(false);            // RS-SHOT: the plate's hold, a child past its 20 s
        } else if (s == 5) {
            date();                    // K-6: the minute turned (a live date only)
            clock_prefs();             // RS-TZb: a zone or 24-Hour Time set since
            if (ac_on && s_acct >= 0 && bg_check(false)) { redraw(); }   // BG-1: a new session, or the file changed
            if (st_win >= 0 && stbox.page() == stside.DATETIME) {   // the Date and Time page's clock
                sttime.set_now(now_s);
                redraw();
            }
            bar(false);
            if (ac_on) { idle_check(); }   // AC-D5: the idle lock, checked as the minute turns
            if (cal_open && calpop.set_now(cal_zone, now_s)) { redraw_overlay(); }   // RS-CAL: today moves at midnight
            if (ac_screen == SCR_LOGIN || ac_screen == SCR_LOCK) { redraw_overlay(); }   // frame 12: the clock, the date
        } else if (s == 6) {
            pl_rle_ok = false;
            gh_rle_ok = false;
            vars_named();              // BP-6: a window's variable changed (cview's name, its next image's); NAMES-28: a name
        } else if (s == 2) {
            drain();
            sh_reap();                 // RS-SHOT: a shot's child, reaped and its name taken
            if (!ac_on || kind[0] == TERM) { ws = tilectl.reap(pid[0], true); }
            if (ac_on && ws != 0 - EAGAIN) {
                logout();                  // AC-1c: the session's first shell ended; the desk stays, at the names
                ws = 0 - EAGAIN;
            }
            Bool changed = false;
            for i in 1..WINDOWS {
                if (kind[i] == TERM) {
                    I64 r = tilectl.reap(pid[i], true);
                    if (r != 0 - EAGAIN) {
                        "hdesk: terminal {i} ended, status {r}\n";
                        U8[64] t;              // board 20261111T170652Z: the shell could not start its program
                        I64 tn = 0;
                        if (lx_len[i] > 0 && launch.failed(r)) {
                            tn = launch.note(lx_name[32 * i..32 * i + lx_len[i]], t);
                        }
                        Bool fl = lx_len[i] > 0 && terms.faulted(slot[i]);   // DN-51 frame 23
                        if (fl) { fault_take(i); }
                        close_window(i);
                        changed = true;
                        if (fl) {
                            busy_stop();       // no window will bind
                            fault_show();
                        }
                        if (tn > 0) {
                            busy_stop();       // DN-37: no window will bind
                            msg_show(t[0..tn]);
                        }
                    }
                } else if (kind[i] == PIXEL && !info(i)) {
                    "hdesk: pixel {i} ended\n";
                    close_window(i);
                    changed = true;
                }
            }
            if (changed && ws == 0 - EAGAIN) { redraw(); }
        } else if (s < 0) {
            "hdesk: sync failed ({s})\n";
            dev.exit_now(2);
        }
    }
    sh_drop();                         // RS-SHOT: the desk's end lets the held screen go
    settle();
    "hdesk: shell ended, status {ws}\n";
    "hdesk: term bytes {tbytes}\n";
    I64 s0 = slot[0];
    for r in 0..terms.height(s0) {
        I64 n = row_utf8(s0, r);
        "hdesk: term {r:02} |";
        I64 put = ptyctl.pty_write(1, tline8[0..n]);
        "|\n";
    }
    I64 ccx = terms.cursor_x(s0);
    I64 ccy = terms.cursor_y(s0);
    "hdesk: cursor {ccx},{ccy}\n";
    I64 on = 0;
    if (pshown) { on = 1; }
    "hdesk: pointer {mx},{my} shown {on}\n";
}
