const I64 RAD = 8;           // WB-7: a float's corner radius at 1x; FF 3g: 7 became 8, the panels' and windows' radius
const I64 STRIP_HOLD_MS = 800;   // FF 3g: the desktop strip's hold after a switch; not ruled (DECISIONS.md, Open, SP-H)
const I64 R_KEY = 4;
// DN-24 B (design's reading of l's remark; false gives frame 8's rims back): no line rims a bar. A focused
// window's ring and bar are one FILL shape (DN-27: never a grant's color), a window at rest has neither ring nor
// outline; prompts draw ring and header in one color, their own (a grant's or CADMIUM).
const Bool RIMLESS = true;
// DN-36 (design note 36, l 2026-11-10 15:15Z; corrects DN-24 and DN-29): no stroke is ever drawn round a bar. A
// window is one rounded rectangle in its bar's color (RAD; a prompt's R_PLATE), the bar its top WBAR px (a prompt's
// header 36), nothing drawn on the bar's top, left or right edge; the body a second rectangle in the body's color
// inset 1 px (RING, times the UI scale) left, right and below, from the bar's lower edge exactly, its top corners
// square and its bottom corners the outer radius less 1. The 1 px ring is the first rectangle showing beside and
// below the body. At rest the bar is SURF1 and the body flush: no ring.
// DN-29: the ring below a bar and round a prompt is 1 px at 1x (times the UI scale, so never
// under a device pixel), in the bar's or the header's color; bars are unchanged. The content box keeps its FB inset,
// the pixel between the ring and it the window's own ground. The corners' inner radius is the plate radius less 1.
const I64 RING = 1;         // FF 3g: the three radii, keycaps, controls and fields, panels and windows (RAD)
const I64 R_CTRL = 6;
const I64 DCLICK = 500;      // WB-1: a double click on the bar, ms
const I64 KEY_LEFTALT = 56;
const I64 KEY_RIGHTALT = 100;
const I64 KEY_UP = 103;
const I64 KEY_LEFT = 105;
const I64 KEY_RIGHT = 106;
const I64 KEY_DOWN = 108;
const I64 KEY_LEFTMETA = 125;
const I64 KEY_RIGHTMETA = 126;
const I64 SIGTERM = 15;
const I64 EAGAIN = 11;

