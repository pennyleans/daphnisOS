// user/ci/cish/cond.ci: `test` and `[` (CS-2, XCU test): by the count of operands, 0 false, 1 a non-empty string, 2
// `!` or a unary operator, 3 a binary operator, `!` or a parenthesized operand, 4 `!` or parentheses; past 4, `!`,
// `-a`, `-o` and parentheses by precedence. Unary: -b -c -d -e -f -g -h -L -n -p -r -s -S -u -w -x -z; binary: = ==
// != -eq -ne -lt -le -gt -ge. Status 0 true, 1 false, 2 an error (said). Integers are checked I64.
import user.ci.shctl;
import user.ci.cish.msg;

const I64 S_IFMT = 0xF000;

I64 err = 0;   // 2 once an error was said

Bool is(in U8[_] f, in U8[_] s) {
    if (len(f) != len(s)) { return false; }
    for i in 0..len(s) {
        if (f[i] != s[i]) { return false; }
    }
    return true;
}

void fail(in U8[_] what, in U8[_] f) {
    if (err == 0) {
        msg.begin();
        msg.text(b"test: ");
        msg.text(what);
        msg.text(f);
        msg.send();
    }
    err = 2;
}

Bool unary_op(in U8[_] f) {
    if (len(f) != 2 || f[0] != '-') { return false; }
    U8 c = f[1];
    return c == 'b' || c == 'c' || c == 'd' || c == 'e' || c == 'f' || c == 'g' || c == 'h' || c == 'L' || c == 'n'
        || c == 'p' || c == 'r' || c == 's' || c == 'S' || c == 'u' || c == 'w' || c == 'x' || c == 'z';
}

Bool binary_op(in U8[_] f) {
    return is(f, b"=") || is(f, b"==") || is(f, b"!=") || is(f, b"-eq") || is(f, b"-ne") || is(f, b"-lt")
        || is(f, b"-le") || is(f, b"-gt") || is(f, b"-ge");
}

// f as a checked integer, or an error.
I64 number(in U8[_] f) {
    I64 i = 0;
    while (i < len(f) && (f[i] == ' ' || f[i] == '\t')) { i = i + 1; }
    Bool neg = false;
    if (i < len(f) && (f[i] == '-' || f[i] == '+')) {
        neg = f[i] == '-';
        i = i + 1;
    }
    I64 start = i;
    I64 v = 0;
    while (i < len(f) && f[i] >= '0' && f[i] <= '9') {
        if (i - start >= 18) {
            fail(b"number too large: ", f);
            return 0;
        }
        v = v * 10 + (f[i] - '0') as I64;
        i = i + 1;
    }
    while (i < len(f) && (f[i] == ' ' || f[i] == '\t')) { i = i + 1; }
    if (i == start || i != len(f)) {
        fail(b"bad number: ", f);
        return 0;
    }
    if (neg) { return 0 - v; }
    return v;
}

Bool unary(in U8[_] op, in U8[_] f) {
    U8 c = op[1];
    if (c == 'n') { return len(f) > 0; }
    if (c == 'z') { return len(f) == 0; }
    if (c == 'r' || c == 'w' || c == 'x') {
        I64 m = 4;
        if (c == 'w') { m = 2; }
        if (c == 'x') { m = 1; }
        return shctl.sh_access(f, m) == 0;
    }
    U8[12] st;
    I64 follow = 1;
    if (c == 'h' || c == 'L') { follow = 0; }
    if (shctl.sh_stat(f, follow, st) < 0) { return false; }
    I64 mode = (st[0] as I64) | ((st[1] as I64) << 8) | ((st[2] as I64) << 16);
    I64 kind = mode & S_IFMT;
    if (c == 'e') { return true; }
    if (c == 'f') { return kind == 0x8000; }
    if (c == 'd') { return kind == 0x4000; }
    if (c == 'h' || c == 'L') { return kind == 0xA000; }
    if (c == 'p') { return kind == 0x1000; }
    if (c == 'S') { return kind == 0xC000; }
    if (c == 'b') { return kind == 0x6000; }
    if (c == 'c') { return kind == 0x2000; }
    if (c == 'u') { return (mode & 0x800) != 0; }
    if (c == 'g') { return (mode & 0x400) != 0; }
    // -s: a size over 0
    for i in 4..12 {
        if (st[i] != 0) { return true; }
    }
    return false;
}

Bool binary(in U8[_] l, in U8[_] op, in U8[_] r) {
    if (is(op, b"=") || is(op, b"==")) { return is(l, r); }
    if (is(op, b"!=")) { return !is(l, r); }
    I64 a = number(l);
    I64 b = number(r);
    if (is(op, b"-eq")) { return a == b; }
    if (is(op, b"-ne")) { return a != b; }
    if (is(op, b"-lt")) { return a < b; }
    if (is(op, b"-le")) { return a <= b; }
    if (is(op, b"-gt")) { return a > b; }
    return a >= b;
}

// The operands are fields first..first+n of the block.
U8[1] none;

Bool one(in U8[_] ab, in I64[_] fo, in I64[_] fe, I64 i) { return fe[i] > fo[i]; }

Bool two(in U8[_] ab, in I64[_] fo, in I64[_] fe, I64 i) {
    if (is(ab[fo[i]..fe[i]], b"!")) { return !one(ab, fo, fe, i + 1); }
    if (unary_op(ab[fo[i]..fe[i]])) { return unary(ab[fo[i]..fe[i]], ab[fo[i + 1]..fe[i + 1]]); }
    fail(b"unknown operator: ", ab[fo[i]..fe[i]]);
    return false;
}

Bool three(in U8[_] ab, in I64[_] fo, in I64[_] fe, I64 i) {
    if (binary_op(ab[fo[i + 1]..fe[i + 1]])) {
        return binary(ab[fo[i]..fe[i]], ab[fo[i + 1]..fe[i + 1]], ab[fo[i + 2]..fe[i + 2]]);
    }
    if (is(ab[fo[i + 1]..fe[i + 1]], b"-a")) { return one(ab, fo, fe, i) && one(ab, fo, fe, i + 2); }
    if (is(ab[fo[i + 1]..fe[i + 1]], b"-o")) { return one(ab, fo, fe, i) || one(ab, fo, fe, i + 2); }
    if (is(ab[fo[i]..fe[i]], b"!")) { return !two(ab, fo, fe, i + 1); }
    if (is(ab[fo[i]..fe[i]], b"(") && is(ab[fo[i + 2]..fe[i + 2]], b")")) { return one(ab, fo, fe, i + 1); }
    fail(b"unknown operator: ", ab[fo[i + 1]..fe[i + 1]]);
    return false;
}

// Past four operands: or := and ('-o' and)*; and := not ('-a' not)*; not := '!' not | '(' or ')' | primary.
I64 at = 0;
I64 end = 0;

Bool primary(in U8[_] ab, in I64[_] fo, in I64[_] fe) {
    if (at >= end) {
        fail(b"argument expected", none[0..0]);
        return false;
    }
    if (is(ab[fo[at]..fe[at]], b"!")) {
        at = at + 1;
        return !primary(ab, fo, fe);
    }
    if (is(ab[fo[at]..fe[at]], b"(")) {
        at = at + 1;
        Bool v = or_(ab, fo, fe);
        if (at >= end || !is(ab[fo[at]..fe[at]], b")")) {
            fail(b"missing )", none[0..0]);
            return false;
        }
        at = at + 1;
        return v;
    }
    if (at + 1 < end && unary_op(ab[fo[at]..fe[at]])) {
        Bool v = unary(ab[fo[at]..fe[at]], ab[fo[at + 1]..fe[at + 1]]);
        at = at + 2;
        return v;
    }
    if (at + 2 < end + 0 && binary_op(ab[fo[at + 1]..fe[at + 1]])) {
        Bool v = binary(ab[fo[at]..fe[at]], ab[fo[at + 1]..fe[at + 1]], ab[fo[at + 2]..fe[at + 2]]);
        at = at + 3;
        return v;
    }
    Bool v = fe[at] > fo[at];
    at = at + 1;
    return v;
}

Bool and_(in U8[_] ab, in I64[_] fo, in I64[_] fe) {
    Bool v = primary(ab, fo, fe);
    while (at < end && is(ab[fo[at]..fe[at]], b"-a")) {
        at = at + 1;
        Bool w = primary(ab, fo, fe);
        v = v && w;
    }
    return v;
}

Bool or_(in U8[_] ab, in I64[_] fo, in I64[_] fe) {
    Bool v = and_(ab, fo, fe);
    while (at < end && is(ab[fo[at]..fe[at]], b"-o")) {
        at = at + 1;
        Bool w = and_(ab, fo, fe);
        v = v || w;
    }
    return v;
}

// test with fields 1..nf; bracket: `[`, whose last field must be `]`.
export I64 run(in U8[_] ab, in I64[_] fo, in I64[_] fe, I64 nf, Bool bracket) {
    err = 0;
    I64 n = nf - 1;
    if (bracket) {
        if (n < 1 || !is(ab[fo[nf - 1]..fe[nf - 1]], b"]")) {
            msg.begin();
            msg.text(b"[: missing ]");
            msg.send();
            return 2;
        }
        n = n - 1;
    }
    Bool v = false;
    if (n == 1) {
        v = one(ab, fo, fe, 1);
    } else if (n == 2) {
        v = two(ab, fo, fe, 1);
    } else if (n == 3) {
        v = three(ab, fo, fe, 1);
    } else if (n == 4 && is(ab[fo[1]..fe[1]], b"!")) {
        v = !three(ab, fo, fe, 2);
    } else if (n == 4 && is(ab[fo[1]..fe[1]], b"(") && is(ab[fo[4]..fe[4]], b")")) {
        v = two(ab, fo, fe, 2);
    } else if (n >= 4) {
        at = 1;
        end = 1 + n;
        v = or_(ab, fo, fe);
        if (at < end) { fail(b"extra argument: ", ab[fo[at]..fe[at]]); }
    }
    if (err != 0) { return 2; }
    if (v) { return 0; }
    return 1;
}
