// user/ci/core/md5.ci: MD5 (RFC 1321 section 3) in checked cint, for md5sum (docs/specs/2026-11-06-c-core.md, CT-5,
// CORE-5 C). The shape of src/sha256.ci: a state struct, init, update and final. Words use the wrapping `+%` and
// `<<%` and the logical `>>` of U32; every other operation is checked. Little endian throughout, as the RFC says.
// The sine table T[1..64] (section 3.4) is a local, as src/sha256.ci keeps its round constants.

export const I64 MD5_DIGEST_BYTES = 16;
export const I64 MD5_BLOCK_BYTES = 64;

export struct Md5 {
    U32[4] h;
    U8[64] block;
    I64 fill;
    I64 total;
}

U32 turn(U32 x, I64 s) {
    return (x <<% s) | (x >> (32 - s));
}

void compress(inout Md5[_] m) {
    U32[64] t;
    U32[16] x;
    I64[16] r;
    t[0] = 0xd76aa478;
    t[1] = 0xe8c7b756;
    t[2] = 0x242070db;
    t[3] = 0xc1bdceee;
    t[4] = 0xf57c0faf;
    t[5] = 0x4787c62a;
    t[6] = 0xa8304613;
    t[7] = 0xfd469501;
    t[8] = 0x698098d8;
    t[9] = 0x8b44f7af;
    t[10] = 0xffff5bb1;
    t[11] = 0x895cd7be;
    t[12] = 0x6b901122;
    t[13] = 0xfd987193;
    t[14] = 0xa679438e;
    t[15] = 0x49b40821;
    t[16] = 0xf61e2562;
    t[17] = 0xc040b340;
    t[18] = 0x265e5a51;
    t[19] = 0xe9b6c7aa;
    t[20] = 0xd62f105d;
    t[21] = 0x02441453;
    t[22] = 0xd8a1e681;
    t[23] = 0xe7d3fbc8;
    t[24] = 0x21e1cde6;
    t[25] = 0xc33707d6;
    t[26] = 0xf4d50d87;
    t[27] = 0x455a14ed;
    t[28] = 0xa9e3e905;
    t[29] = 0xfcefa3f8;
    t[30] = 0x676f02d9;
    t[31] = 0x8d2a4c8a;
    t[32] = 0xfffa3942;
    t[33] = 0x8771f681;
    t[34] = 0x6d9d6122;
    t[35] = 0xfde5380c;
    t[36] = 0xa4beea44;
    t[37] = 0x4bdecfa9;
    t[38] = 0xf6bb4b60;
    t[39] = 0xbebfbc70;
    t[40] = 0x289b7ec6;
    t[41] = 0xeaa127fa;
    t[42] = 0xd4ef3085;
    t[43] = 0x04881d05;
    t[44] = 0xd9d4d039;
    t[45] = 0xe6db99e5;
    t[46] = 0x1fa27cf8;
    t[47] = 0xc4ac5665;
    t[48] = 0xf4292244;
    t[49] = 0x432aff97;
    t[50] = 0xab9423a7;
    t[51] = 0xfc93a039;
    t[52] = 0x655b59c3;
    t[53] = 0x8f0ccc92;
    t[54] = 0xffeff47d;
    t[55] = 0x85845dd1;
    t[56] = 0x6fa87e4f;
    t[57] = 0xfe2ce6e0;
    t[58] = 0xa3014314;
    t[59] = 0x4e0811a1;
    t[60] = 0xf7537e82;
    t[61] = 0xbd3af235;
    t[62] = 0x2ad7d2bb;
    t[63] = 0xeb86d391;
    r[0] = 7;
    r[1] = 12;
    r[2] = 17;
    r[3] = 22;
    r[4] = 5;
    r[5] = 9;
    r[6] = 14;
    r[7] = 20;
    r[8] = 4;
    r[9] = 11;
    r[10] = 16;
    r[11] = 23;
    r[12] = 6;
    r[13] = 10;
    r[14] = 15;
    r[15] = 21;
    for i in 0..16 {
        I64 j = 4 * i;
        x[i] = (m[0].block[j] as U32) | ((m[0].block[j + 1] as U32) << 8)
            | ((m[0].block[j + 2] as U32) << 16) | ((m[0].block[j + 3] as U32) << 24);
    }
    U32 a = m[0].h[0];
    U32 b = m[0].h[1];
    U32 c = m[0].h[2];
    U32 d = m[0].h[3];
    for i in 0..64 {
        I64 q = i / 16;
        U32 f = 0;
        I64 g = i;
        if (q == 0) {
            f = (b & c) | (~b & d);
        } else if (q == 1) {
            f = (d & b) | (~d & c);
            g = (5 * i + 1) % 16;
        } else if (q == 2) {
            f = b ^ c ^ d;
            g = (3 * i + 5) % 16;
        } else {
            f = c ^ (b | ~d);
            g = (7 * i) % 16;
        }
        U32 e = d;
        d = c;
        c = b;
        b = b +% turn(a +% f +% t[i] +% x[g], r[4 * q + i % 4]);
        a = e;
    }
    m[0].h[0] = m[0].h[0] +% a;
    m[0].h[1] = m[0].h[1] +% b;
    m[0].h[2] = m[0].h[2] +% c;
    m[0].h[3] = m[0].h[3] +% d;
}

// The initial words A B C D (section 3.3) and an empty message.
export void md5_init(inout Md5[_] m) {
    m[0].h[0] = 0x67452301;
    m[0].h[1] = 0xefcdab89;
    m[0].h[2] = 0x98badcfe;
    m[0].h[3] = 0x10325476;
    m[0].fill = 0;
    m[0].total = 0;
}

// Appends data[start..start + nbytes) to the message.
export void md5_update[n](inout Md5[_] m, in U8[n] data, I64 start, I64 nbytes) {
    for i in start..start + nbytes {
        m[0].block[m[0].fill] = data[i];
        m[0].fill += 1;
        if (m[0].fill == MD5_BLOCK_BYTES) {
            compress(m);
            m[0].fill = 0;
        }
    }
    m[0].total += nbytes;
}

// Pads the message (sections 3.1 and 3.2) and writes the digest to digest[0..16).
export void md5_final[d](inout Md5[_] m, inout U8[d] digest) {
    U64 bits = (m[0].total * 8) as U64;
    m[0].block[m[0].fill] = 0x80;
    m[0].fill += 1;
    if (m[0].fill > 56) {
        while (m[0].fill < MD5_BLOCK_BYTES) {
            m[0].block[m[0].fill] = 0;
            m[0].fill += 1;
        }
        compress(m);
        m[0].fill = 0;
    }
    while (m[0].fill < 56) {
        m[0].block[m[0].fill] = 0;
        m[0].fill += 1;
    }
    for i in 0..8 {
        m[0].block[56 + i] = (bits >> (8 * i)) as% U8;
    }
    compress(m);
    m[0].fill = 0;
    for i in 0..4 {
        U32 v = m[0].h[i];
        digest[4 * i] = v as% U8;
        digest[4 * i + 1] = (v >> 8) as% U8;
        digest[4 * i + 2] = (v >> 16) as% U8;
        digest[4 * i + 3] = (v >> 24) as% U8;
    }
}
