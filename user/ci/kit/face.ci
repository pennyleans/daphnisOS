// Row y (0 to 15) of glyph c as a byte, column 0 in bit 7.
export I64 row(I64 c, I64 y) {
    I64 k = c - 32;
    if (k < 0 || k > 94) { k = 31; }
    U64 word = bits[2 * k + y / 8];
    return ((word >> (8 * (7 - y % 8)) as U64) & 255) as I64;
}
