// user/ci/kit/shape.ci: the desk's rounded shapes on draw.ci's row contract (FF edition 14, section 3g; the corners
// of the 0.1.0 polish): a filled rounded rectangle, a ring inside one, an icon at any slot size, and the field's
// search glyph. Every coordinate is a device pixel; the caller multiplies its 1x units by the scale. An edge pixel
// takes 16 samples, 4 x 4 at (8 x + 2 i + 1) / 8, each tested exactly in eighths of a pixel, and moves toward the
// color by the one blend (MS-1, kit/blend.ci) at 16 a sample inside, so a pixel all inside is the color and one all
// outside is left. tools/check-hdesk.py's shape functions are the twin.
import user.ci.kit.draw;
import user.ci.kit.blend;
import user.ci.kit.icons;

// The larger of 0, a and b.
I64 out_of(I64 a, I64 b) {
    if (a > 0 && a >= b) { return a; }
    if (b > 0) { return b; }
    return 0;
}

// Sample (u, v), in eighths of a pixel, inside [x0, x1) x [y0, y1) with corners of radius r.
Bool inside(I64 u, I64 v, I64 x0, I64 y0, I64 x1, I64 y1, I64 r) {
    if (u < 8 * x0 || u >= 8 * x1 || v < 8 * y0 || v >= 8 * y1) { return false; }
    I64 dx = out_of(8 * (x0 + r) - u, u - 8 * (x1 - r));
    I64 dy = out_of(8 * (y0 + r) - v, v - 8 * (y1 - r));
    return dx * dx + dy * dy <= 64 * r * r;
}

// The radius kept to half the shorter side.
I64 fit(I64 x0, I64 y0, I64 x1, I64 y1, I64 r) {
    I64 k = r;
    if (2 * k > x1 - x0) { k = (x1 - x0) / 2; }
    if (2 * k > y1 - y0) { k = (y1 - y0) / 2; }
    if (k < 0) { k = 0; }
    return k;
}

// Pixel x moved toward c by n of 16 samples.
void cover(inout U32[_] row, I64 x, U32 c, I64 n) {
    if (x < 0 || x >= len(row) || n == 0) { return; }
    if (n == 16) {
        row[x] = c & 0xFFFFFF;
        return;
    }
    row[x] = blend.mix_px(row[x], c, 16 * n);
}

// Quarter-circle 4 x 4 subpixel coverage LUT: 8 slots of 64 x 64 bytes (radii 1 to 64).
U8[32768] arc_lut;
I64[8] arc_r;
I64 arc_hand = 0;
I64 arc_last = 0;

// The 4 x 4 subpixel samples (0 to 16) at corner offset (px, py) from the outer edge of a quarter circle of radius r.
export I64 arc16(I64 r, I64 px, I64 py) {
    if (r <= 0 || px < 0 || py < 0) { return 0; }
    if (px >= r || py >= r) { return 16; }
    if (r > 64) {
        I64 q = 0;
        for s in 0..4 {
            for t in 0..4 {
                I64 dx = 8 * r - (8 * px + 2 * s + 1);
                I64 dy = 8 * r - (8 * py + 2 * t + 1);
                if (dx * dx + dy * dy <= 64 * r * r) { q = q + 1; }
            }
        }
        return q;
    }
    if (arc_r[arc_last] == r) {
        return arc_lut[(arc_last << 12) + (py << 6) + px] as I64;
    }
    I64 slot = -1;
    for k in 0..8 {
        if (arc_r[k] == r) { slot = k; }
    }
    if (slot < 0) {
        slot = arc_hand;
        arc_hand = (arc_hand + 1) & 7;
        arc_r[slot] = r;
        I64 base = slot << 12;
        I64 lim = 64 * r * r;
        for y in 0..r {
            I64 row_off = base + (y << 6);
            for x in y..r {
                I64 q = 0;
                for s in 0..4 {
                    I64 dx = 8 * r - (8 * x + 2 * s + 1);
                    I64 dx2 = dx * dx;
                    for t in 0..4 {
                        I64 dy = 8 * r - (8 * y + 2 * t + 1);
                        if (dx2 + dy * dy <= lim) { q = q + 1; }
                    }
                }
                arc_lut[row_off + x] = q as U8;
                arc_lut[base + (x << 6) + y] = q as U8;
            }
        }
    }
    arc_last = slot;
    return arc_lut[(slot << 12) + (py << 6) + px] as I64;
}

// Coverage of pixel (x, y) inside [x0, x1) x [y0, y1) when 0 <= r and 2 * r fits both sides.
I64 rect_cov16(I64 x, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r) {
    if (x < x0 || x >= x1 || y < y0 || y >= y1) { return 0; }
    I64 px = -1;
    if (x < x0 + r) {
        px = x - x0;
    } else if (x >= x1 - r) {
        px = x1 - 1 - x;
    }
    I64 py = -1;
    if (y < y0 + r) {
        py = y - y0;
    } else if (y >= y1 - r) {
        py = y1 - 1 - y;
    }
    if (px < 0 || py < 0) { return 16; }
    return arc16(r, px, py);
}

// The samples of pixel (x, y) inside the rounded rectangle.
I64 samples(I64 x, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r) {
    if (r >= 0 && 2 * r <= x1 - x0 && 2 * r <= y1 - y0) {
        return rect_cov16(x, y, x0, y0, x1, y1, r);
    }
    I64 n = 0;
    for j in 0..4 {
        for i in 0..4 {
            if (inside(8 * x + 2 * i + 1, 8 * y + 2 * j + 1, x0, y0, x1, y1, r)) { n = n + 1; }
        }
    }
    return n;
}

// [x0, x1) x [y0, y1) with corners of radius r, in c, on row y.
export void rounded(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r, U32 c) {
    if (y < y0 || y >= y1 || x0 >= x1) { return; }
    I64 k = fit(x0, y0, x1, y1, r);
    if (y >= y0 + k && y < y1 - k) {
        draw.paint(row, x0, x1, c);
        return;
    }
    draw.paint(row, x0 + k, x1 - k, c);
    I64 py = y - y0;
    if (y >= y1 - k) { py = y1 - 1 - y; }
    for px in 0..k { cover(row, x0 + px, c, arc16(k, px, py)); }
    for px in 0..k { cover(row, x1 - k + px, c, arc16(k, k - 1 - px, py)); }
}

// DN-36 (design note 36): [x0, x1) x [y0, y1) with square top corners and bottom corners of radius r, in c, on row
// y: a window's or a prompt's body under its bar. The bottom corners are rounded's, taken from a rectangle that
// reaches far enough up that its own top corners lie above y0.
export void lower_rounded(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r, U32 c) {
    if (y < y0 || y >= y1 || x0 >= x1) { return; }
    I64 k = r;
    if (2 * k > x1 - x0) { k = (x1 - x0) / 2; }
    if (k < 0) { k = 0; }
    if (y < y1 - k) {
        draw.paint(row, x0, x1, c);
        return;
    }
    rounded(row, y, x0, y1 - 2 * k - 2, x1, y1, k, c);
}

// DN-40 (design note 40, provisional on frame 24): the keyboard focus of a FILL control, [x0, x1) x [y0, y1) with
// corners of radius r, on row y: a 2 px gap in ground (the surface the control sits on) and a 2 px ring in rc outside
// it, the ring's outer radius r + 4; u device pixels to 1x pixel. Never inset, never touching the control.
export void focus_ring(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r, I64 u, U32 ground, U32 rc) {
    ring(row, y, x0 - 4 * u, y0 - 4 * u, x1 + 4 * u, y1 + 4 * u, r + 4 * u, 2 * u, rc);
    ring(row, y, x0 - 2 * u, y0 - 2 * u, x1 + 2 * u, y1 + 2 * u, r + 2 * u, 2 * u, ground);
}

// A ring t pixels thick inside [x0, x1) x [y0, y1) with corners of radius r: what lies inside the shape and not
// inside the one inset t with radius r - t, in c, on row y.
export void ring(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 x1, I64 y1, I64 r, I64 t, U32 c) {
    if (y < y0 || y >= y1 || x0 >= x1) { return; }
    I64 k = fit(x0, y0, x1, y1, r);
    I64 ki = k - t;
    if (ki < 0) { ki = 0; }
    if (y >= y0 + k && y < y1 - k) {
        if (y < y0 + t || y >= y1 - t) {
            draw.paint(row, x0, x1, c);
            return;
        }
        draw.paint(row, x0, x0 + t, c);
        draw.paint(row, x1 - t, x1, c);
        return;
    }
    if (y < y0 + t || y >= y1 - t) { draw.paint(row, x0 + k, x1 - k, c); }
    if (t >= 0) {
        for x in x0..x0 + k {
            I64 n = rect_cov16(x, y, x0, y0, x1, y1, k) - rect_cov16(x, y, x0 + t, y0 + t, x1 - t, y1 - t, ki);
            cover(row, x, c, n);
        }
        for x in x1 - k..x1 {
            I64 n = rect_cov16(x, y, x0, y0, x1, y1, k) - rect_cov16(x, y, x0 + t, y0 + t, x1 - t, y1 - t, ki);
            cover(row, x, c, n);
        }
        return;
    }
    for x in x0..x1 {
        if (x < x0 + k || x >= x1 - k) {
            I64 n = 0;
            for j in 0..4 {
                for i in 0..4 {
                    I64 u = 8 * x + 2 * i + 1;
                    I64 v = 8 * y + 2 * j + 1;
                    if (inside(u, v, x0, y0, x1, y1, k) && !inside(u, v, x0 + t, y0 + t, x1 - t, y1 - t, ki)) {
                        n = n + 1;
                    }
                }
            }
            cover(row, x, c, n);
        }
    }
}

// Icon k in an s x s slot from (x0, y0), on row y: the drawing of that size when there is one (32 or 64), else
// the nearest of the 64 drawing (the 32 one below 32): pixel (x, y) is the drawing's (x * d / s, y * d / s). Token
// t in pal[t]; a clear pixel is left.
export void icon(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 k, I64 s, in U32[_] pal) {
    if (y < y0 || y >= y0 + s || s <= 0) { return; }
    if (s == 32 || s == 64) {
        icons.icon_at(row, y, x0, y0, k, s, pal);
        return;
    }
    I64 d = 64;
    if (s < 32) { d = 32; }
    I64 sy = (y - y0) * d / s;
    for x in 0..s {
        I64 t = icons.tok(k, d, x * d / s, sy);
        if (t != icons.CLEAR) { draw.put(row, x0 + x, pal[t]); }
    }
}

// The square of the distance from (u, v) to the segment (ax, ay) to (ex, ey), times its squared length l2, when
// (u, v) lies across it (butt ends); -1 when it lies past an end.
I64 across(I64 u, I64 v, I64 ax, I64 ay, I64 ex, I64 ey) {
    I64 dx = ex - ax;
    I64 dy = ey - ay;
    I64 l2 = dx * dx + dy * dy;
    I64 t = (u - ax) * dx + (v - ay) * dy;
    if (t < 0 || t > l2) { return -1; }
    I64 pu = u - ax;
    I64 pv = v - ay;
    return (pu * pu + pv * pv) * l2 - t * t;
}

// The field's search glyph in a 16 z square from (x0, y0), on row y (the frame's drawing at 1x: a ring about
// (6.5, 6.5), radius 5, 2 px thick, and a 2 px stroke from (10.5, 10.5) to (15, 15)).
export void lens(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 z, U32 c) {
    I64 s = 16 * z;
    if (y < y0 || y >= y0 + s) { return; }
    I64 c0 = 52 * z;
    I64 ri = 32 * z;
    I64 ro = 48 * z;
    I64 a = 84 * z;
    I64 e = 120 * z;
    I64 w = 8 * z;
    I64 l2 = 2 * (e - a) * (e - a);
    for x in x0..x0 + s {
        I64 n = 0;
        for j in 0..4 {
            for i in 0..4 {
                I64 u = 8 * (x - x0) + 2 * i + 1;
                I64 v = 8 * (y - y0) + 2 * j + 1;
                I64 d2 = (u - c0) * (u - c0) + (v - c0) * (v - c0);
                I64 q = across(u, v, a, a, e, e);
                if ((d2 >= ri * ri && d2 <= ro * ro) || (q >= 0 && q <= w * w * l2)) { n = n + 1; }
            }
        }
        cover(row, x, c, n);
    }
}
