// Row y (0 to 31) of glyph c as 16 bits, column 0 in bit 15.
export I64 row(I64 c, I64 y) {
    I64 k = c - 32;
    if (k < 0 || k > 94) { k = 31; }
    U64 word = bits[8 * k + y / 4];
    return ((word >> (16 * (3 - y % 4)) as U64) & 65535) as I64;
}
