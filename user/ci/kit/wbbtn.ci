// Pixel (x, y) of button k at n x n (n 16 or 32): inked or not.
export Bool at(I64 k, I64 n, I64 x, I64 y) {
    if (n == 32) { return ((b32[32 * k + y] as I64 >> (31 - x)) & 1) == 1; }
    return ((b16[16 * k + y] as I64 >> (15 - x)) & 1) == 1;
}
