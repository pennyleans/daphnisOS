I64 at(I64 c) {
    I64 k = c - 32;
    if (k < 0 || k > 94) { k = 31; }
    return k;
}

// Glyph c's advance in pixels.
export I64 advance(I64 c) { return adv[at(c)] as I64; }

// Row y (0 to 15) of glyph c, column 0 in bit 15.
export I64 row(I64 c, I64 y) {
    U64 word = bits[4 * at(c) + y / 4];
    return ((word >> (16 * (3 - y % 4)) as U64) & 65535) as I64;
}
