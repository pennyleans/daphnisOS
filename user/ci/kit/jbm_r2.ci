    0xefffff92ffffffe2, 0x4fffffffffffff40, 0x06ffff61cffff600, 0x008fff95dfff8000,
    0x000afffffffa0000, 0x0001cfffffc10000, 0x00001dfffd100000, 0x000003dfd3000000,
    0x0000001410000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
    0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
];

// The glyph of code point cp, or the stand-in's.
export I64 index(I64 cp) {
    I64 lo = 0;
    I64 hi = N;
    while (lo < hi) {
        I64 mid = (lo + hi) / 2;
        if ((codes[mid] as I64) < cp) { lo = mid + 1; } else { hi = mid; }
    }
    if (lo < N && (codes[lo] as I64) == cp) { return lo; }
    return MISSING;
}

// Coverage 0 to 15 of pixel (x, y) of glyph g, 0 <= x < W, 0 <= y < H.
export I64 at(I64 g, I64 x, I64 y) {
    I64 bit = (y * W + x) * 4;
    U64 word = cov[g * 32 + bit / 64];
    return ((word >> ((60 - bit % 64) as U64)) & 15) as I64;
}
