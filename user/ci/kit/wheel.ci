I64[361] SIN = [
    0, 286, 572, 858, 1144, 1430, 1716, 2001, 2287, 2573, 2859, 3144,
    3430, 3715, 4001, 4286, 4572, 4857, 5142, 5427, 5712, 5997, 6281, 6566,
