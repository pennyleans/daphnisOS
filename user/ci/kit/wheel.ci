// user/ci/kit/wheel.ci: the loading wheel (DN-37, DN-38; l "let it be our signature loading bar"), Daphnis's one sign
// of waiting: it replaces every progress bar and spinner (volume level bars stay bars).
//
// In a 24-unit box: a disc at 12,12 r10.25 under a 1.5 edge, and an arc r6 of stroke 3.5 with round caps from 12
// o'clock clockwise. Dark: disc #141413, edge #f3efe6, arc #fabd2f; light: disc #e8eaee, edge #141413, arc #c98f00.
// A known share draws the arc as that share of the circle (the full ring at 100). Unknown (share < 0): a quarter arc
// turning clockwise, one turn per TURN_MS, linear; with motion off a still quarter arc at 12 o'clock. Sizes 16, 24
// and 32 px (S16, S24, S32, in quarter pixels) at every UI scale. The Busy pointer (busy_row) is the arrow with the
// dark wheel at r4.5 beside it, in both themes.
//
// Integer only. A box of q quarter pixels at zoom z has n = q * z samples across, 4 x 4 a device pixel; a pixel takes
// the colors of its samples by their count (the kit's coverage). Coordinates are in units of 1 / (8 n) box units, so
// every sample center and radius is an integer; angles are quarter degrees clockwise from 12 o'clock, by the tan and
// sin tables below (tools/wheel.py writes them, checks them and is the twin).

export const I64 S16 = 64;            // sizes in quarter pixels
export const I64 S24 = 96;
export const I64 S32 = 128;
export const I64 BUSY_Q = 42;         // the Busy pointer's wheel: r4.5 (10.5 px box)
export const I64 BUSY_X = 9;          // its box's top left from the arrow's hot spot, 1x
export const I64 BUSY_Y = 10;
export const I64 TURN_MS = 1200;      // one turn of the unknown arc (DN-37), linear
export const I64 QUARTER = 360;       // the unknown arc's length, quarter degrees
export const I64 UNKNOWN = -1;        // the share of a wait whose end is not known

export const I64 DARK = 0;
export const I64 LIGHT = 1;

const I64 ONE = 65536;
const U32 PAPER = 0x00f3efe6 as U32;  // the arrow's outline and ink (src/cursor.ci's pens)
const U32 INK = 0x00141413 as U32;

U8[16] arrow_edge = [0x80, 0xC0, 0xA0, 0x90, 0x88, 0x84, 0x82, 0x81, 0x87, 0x94, 0xAA, 0xCA, 0x85, 0x05, 0x02, 0x00];
U8[16] arrow_body = [0x00, 0x00, 0x40, 0x60, 0x70, 0x78, 0x7C, 0x7E, 0x78, 0x68, 0x44, 0x04, 0x02, 0x02, 0x00, 0x00];

// --- tables (tools/wheel.py) ---
