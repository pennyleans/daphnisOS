// --- end of tables ---

U32 disc_of(I64 th) {
    if (th == LIGHT) { return 0x00e8eaee as U32; }
    return 0x00141413 as U32;
}

U32 edge_of(I64 th) {
    if (th == LIGHT) { return 0x00141413 as U32; }
    return 0x00f3efe6 as U32;
}

U32 arc_of(I64 th) {
    if (th == LIGHT) { return 0x00c98f00 as U32; }
    return 0x00fabd2f as U32;
}

// u >= 0, v > 0: the angle of (u, v) from +v toward +u, 0..359.
I64 atan_q(I64 u, I64 v) {
    if (u > v) { return 360 - atan_q(v, u); }
    I64 t = u * ONE / v;
    I64 lo = 0;
    I64 hi = 180;
    while (lo < hi) {
        I64 mid = (lo + hi + 1) / 2;
        if (TAN[mid] <= t) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    if (lo < 180 && TAN[lo + 1] - t < t - TAN[lo]) { lo = lo + 1; }
    return lo;
}

// The angle of (u, v) (v up) clockwise from 12 o'clock, 0..1439.
I64 angle(I64 u0, I64 v0) {
    I64 u = u0;
    I64 v = v0;
    I64 q = 0;
    while (!(u >= 0 && v > 0)) {
        I64 w = u;
        u = 0 - v;
        v = w;
        q = q + 1;
    }
    return (q * 360 + atan_q(u, v)) % 1440;
}

I64 sin_q(I64 a0) {
    I64 a = a0 % 1440;
    if (a <= 360) { return SIN[a]; }
    if (a <= 720) { return SIN[720 - a]; }
    if (a <= 1080) { return 0 - SIN[a - 720]; }
    return 0 - SIN[1440 - a];
}

I64 cos_q(I64 a) { return sin_q(a + 360); }

// The arc's start and length (quarter degrees) into sl: length 0 none, 1440 the full ring.
void span(I64 share, I64 t_ms, Bool motion, inout I64[2] sl) {
    sl[0] = 0;
    if (share >= 0) {
        sl[1] = min(share, 100) * 1440 / 100;
        return;
    }
    sl[1] = QUARTER;
    if (motion) { sl[0] = (t_ms % TURN_MS) * 1440 / TURN_MS; }
}

// The sample at (u, v) from the center: 0 outside, 1 disc, 2 edge, 3 arc.
I64 classify(I64 u, I64 v, I64 n, I64 st, I64 ln) {
    I64 d2 = u * u + v * v;
    if (ln > 0) {
        if (d2 >= 34 * n * 34 * n && d2 <= 62 * n * 62 * n) {
            if (ln >= 1440) { return 3; }
            I64 a = 0;
            if (d2 > 0) { a = angle(u, v); }
            if (((a - st) % 1440 + 1440) % 1440 < ln) { return 3; }
        }
        if (ln < 1440) {
            for k in 0..2 {
                I64 e = st + k * ln;
                I64 cu = 48 * n * sin_q(e) / ONE;
                I64 cv = 48 * n * cos_q(e) / ONE;
                if ((u - cu) * (u - cu) + (v - cv) * (v - cv) <= 14 * n * 14 * n) { return 3; }
            }
        }
    }
    if (d2 >= 76 * n * 76 * n && d2 <= 88 * n * 88 * n) { return 2; }
    if (d2 <= 82 * n * 82 * n) { return 1; }
    return 0;
}

U32 channel_mix(U32 bg, U32 a, U32 b, U32 c, I64 na, I64 nb, I64 nc, I64 sh) {
    I64 s = sh as I64;
    I64 acc = (((bg >> (s as U64)) & 255) as I64) * (16 - na - nb - nc);
    acc = acc + (((a >> (s as U64)) & 255) as I64) * na + (((b >> (s as U64)) & 255) as I64) * nb;
    acc = acc + (((c >> (s as U64)) & 255) as I64) * nc;
    return ((acc / 16) as U32) << (s as U64);
}

// Device row y of a wheel whose box (q quarter pixels at zoom z) has its top left at device (x0, y0), on theme th,
// over row: share 0..100, or UNKNOWN with t_ms the time since the wait began and motion the Motion setting.
export void row_at(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 q, I64 z, I64 th, I64 share, I64 t_ms, Bool motion) {
    row_in(row, y, x0, y0, q, z, th, share, t_ms, motion, arc_of(th));
}

// row_at for a known share with the arc in c: Monitor's gauge, its arc the part's color (DN-58 item 4).
export void part_row(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 q, I64 z, I64 th, I64 share, U32 c) {
    row_in(row, y, x0, y0, q, z, th, share, 0, false, c);
}

void row_in(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 q, I64 z, I64 th, I64 share, I64 t_ms, Bool motion, U32 ca) {
    I64 n = q * z;
    I64 px = (n + 3) / 4;
    if (y < y0 || y >= y0 + px) { return; }
    I64[2] sl;
    span(share, t_ms, motion, sl);
    U32 cd = disc_of(th);
    U32 ce = edge_of(th);
    I64 x1 = min(x0 + px, len(row));
    I64 xs = max(x0, 0);
    for x in xs..x1 {
        I64 nd = 0;
        I64 ne = 0;
        I64 na = 0;
        for j in 0..4 {
            I64 sy = 4 * (y - y0) + j;
            for i in 0..4 {
                I64 sx = 4 * (x - x0) + i;
                if (sx < n && sy < n) {
                    I64 c = classify(192 * sx + 96 - 96 * n, 96 * n - (192 * sy + 96), n, sl[0], sl[1]);
                    if (c == 1) { nd = nd + 1; }
                    if (c == 2) { ne = ne + 1; }
                    if (c == 3) { na = na + 1; }
                }
            }
        }
        if (nd + ne + na > 0) {
            U32 bg = row[x];
            row[x] = channel_mix(bg, cd, ce, ca, nd, ne, na, 16) | channel_mix(bg, cd, ce, ca, nd, ne, na, 8) |
                channel_mix(bg, cd, ce, ca, nd, ne, na, 0);
        }
    }
}

// The coverage word of pixel (px, py) of a wheel's box (q quarter pixels at zoom z): 0xAARRGGBB, AA the covered
// samples in sixteenths (0 to 16), RRGGBB the covered part's color (FBIO_TILE_BUSY's pixel word).
export I64 sprite_px(I64 px, I64 py, I64 q, I64 z, I64 th, I64 share, I64 t_ms, Bool motion) {
    I64 n = q * z;
    I64[2] sl;
    span(share, t_ms, motion, sl);
    I64 nd = 0;
    I64 ne = 0;
    I64 na = 0;
    for j in 0..4 {
        I64 sy = 4 * py + j;
        for i in 0..4 {
            I64 sx = 4 * px + i;
            if (sx < n && sy < n) {
                I64 c = classify(192 * sx + 96 - 96 * n, 96 * n - (192 * sy + 96), n, sl[0], sl[1]);
                if (c == 1) { nd = nd + 1; }
                if (c == 2) { ne = ne + 1; }
                if (c == 3) { na = na + 1; }
            }
        }
    }
    I64 tot = nd + ne + na;
    if (tot == 0) { return 0; }
    I64 w = tot << 24;
    U32 cd = disc_of(th);
    U32 ce = edge_of(th);
    U32 ca = arc_of(th);
    for k in 0..3 {
        U64 sh = (8 * k) as U64;
        I64 v = ((cd >> sh) & 255) as I64 * nd + ((ce >> sh) & 255) as I64 * ne + ((ca >> sh) & 255) as I64 * na;
        w = w | ((v / tot) << (8 * k));
    }
    return w;
}

// The coverage word px over under, a channel at a time: (c * a + under * (16 - a)) / 16 (src/cursor.ci's blend).
export U32 blend(U32 under, I64 px) {
    I64 a = (px >> 24) & 255;
    if (a <= 0) { return under; }
    if (a > 16) { a = 16; }
    I64 mixed = 0;
    for k in 0..3 {
        I64 c = (px >> (8 * k)) & 255;
        I64 u = ((under >> ((8 * k) as U64)) & 255) as I64;
        mixed = mixed | (((c * a + u * (16 - a)) / 16) << (8 * k));
    }
    return mixed as U32;
}

// The Busy pointer's wheel sprite at zoom z into buf from byte at, as FBIO_TILE_BUSY takes it: side x side pixel
// words, row by row, little end first (the dark wheel, unknown); side, its width and height in device pixels.
export I64 sprite(inout U8[_] buf, I64 at, I64 z, I64 t_ms, Bool motion) {
    I64 side = (BUSY_Q * z + 3) / 4;
    for py in 0..side {
        for px in 0..side {
            I64 w = sprite_px(px, py, BUSY_Q, z, DARK, UNKNOWN, t_ms, motion);
            I64 o = at + 4 * (py * side + px);
            for k in 0..4 { buf[o + k] = ((w >> (8 * k)) & 255) as U8; }
        }
    }
    return side;
}

// Device row y of the Busy pointer, its hot spot at device (x0, y0), at zoom z, as the kernel draws it
// (docs/specs/2026-11-10-busy-pointer.md): the dark wheel's sprite blended at (BUSY_X, BUSY_Y) times z, then the
// arrow (src/cursor.ci's) on top.
export void busy_row(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 z, I64 t_ms, Bool motion) {
    I64 side = (BUSY_Q * z + 3) / 4;
    I64 sx0 = x0 + BUSY_X * z;
    I64 sy0 = y0 + BUSY_Y * z;
    if (y >= sy0 && y < sy0 + side) {
        for px in 0..side {
            I64 x = sx0 + px;
            if (x >= 0 && x < len(row)) {
                row[x] = blend(row[x], sprite_px(px, y - sy0, BUSY_Q, z, DARK, UNKNOWN, t_ms, motion));
            }
        }
    }
    if (y >= y0) {
        I64 j = (y - y0) / z;
        if (j < 16) {
            for i in 0..8 {
                I64 m = 0x80 >> (i as U64);
                Bool b = ((arrow_body[j] as I64) & m) != 0;
                Bool e = ((arrow_edge[j] as I64) & m) != 0;
                if (b || e) {
                    for k in 0..z {
                        I64 x = x0 + i * z + k;
                        if (x >= 0 && x < len(row)) {
                            if (b) { row[x] = INK; } else { row[x] = PAPER; }
                        }
                    }
                }
            }
        }
    }
}
