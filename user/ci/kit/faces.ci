    if (f == 11) { if (z == 2) { return jbm40_s2.advance(g); } return jbm40_s1.advance(g); }
    if (f == 12) { if (z == 2) { return inter11_r2.advance(g); } return inter11_r1.advance(g); }
    if (f == 13) { if (z == 2) { return inter12_m2.advance(g); } return inter12_m1.advance(g); }
    if (f == 14) { if (z == 2) { return inter11_r2.advance(g); } return inter11_r1.advance(g); }
    if (f == 15) { if (z == 2) { return inter10_r2.advance(g); } return inter10_r1.advance(g); }
    return 0;
}

