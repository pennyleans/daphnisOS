}

export I64 height(I64 f, I64 z, I64 g) {
    if (f == 0) { if (z == 2) { return jbm28_s2.height(g); } return jbm28_s1.height(g); }
    if (f == 1) { if (z == 2) { return jbm32_s2.height(g); } return jbm32_s1.height(g); }
    if (f == 2) { if (z == 2) { return inter17_m2.height(g); } return inter17_m1.height(g); }
    if (f == 3) { if (z == 2) { return jbm13_r2.height(g); } return jbm13_r1.height(g); }
    if (f == 4) { if (z == 2) { return inter12_s2.height(g); } return inter12_s1.height(g); }
    return 0;
}

// Coverage 0 to 15 of pixel (x, y) of glyph g's box.
export I64 at(I64 f, I64 z, I64 g, I64 x, I64 y) {
    if (f == 0) { if (z == 2) { return jbm28_s2.at(g, x, y); } return jbm28_s1.at(g, x, y); }
    if (f == 1) { if (z == 2) { return jbm32_s2.at(g, x, y); } return jbm32_s1.at(g, x, y); }
    if (f == 2) { if (z == 2) { return inter17_m2.at(g, x, y); } return inter17_m1.at(g, x, y); }
    if (f == 3) { if (z == 2) { return jbm13_r2.at(g, x, y); } return jbm13_r1.at(g, x, y); }
    if (f == 4) { if (z == 2) { return inter12_s2.at(g, x, y); } return inter12_s1.at(g, x, y); }
    return 0;
}

// The face's line box above and below the baseline, whole pixels.
export I64 ascent(I64 f, I64 z) {
    if (f == 0) { if (z == 2) { return jbm28_s2.ASCENT; } return jbm28_s1.ASCENT; }
    if (f == 1) { if (z == 2) { return jbm32_s2.ASCENT; } return jbm32_s1.ASCENT; }
    if (f == 2) { if (z == 2) { return inter17_m2.ASCENT; } return inter17_m1.ASCENT; }
    if (f == 3) { if (z == 2) { return jbm13_r2.ASCENT; } return jbm13_r1.ASCENT; }
    if (f == 4) { if (z == 2) { return inter12_s2.ASCENT; } return inter12_s1.ASCENT; }
    return 0;
}

export I64 descent(I64 f, I64 z) {
    if (f == 0) { if (z == 2) { return jbm28_s2.DESCENT; } return jbm28_s1.DESCENT; }
    if (f == 1) { if (z == 2) { return jbm32_s2.DESCENT; } return jbm32_s1.DESCENT; }
    if (f == 2) { if (z == 2) { return inter17_m2.DESCENT; } return inter17_m1.DESCENT; }
    if (f == 3) { if (z == 2) { return jbm13_r2.DESCENT; } return jbm13_r1.DESCENT; }
    if (f == 4) { if (z == 2) { return inter12_s2.DESCENT; } return inter12_s1.DESCENT; }
    return 0;
}
