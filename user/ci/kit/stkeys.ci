// user/ci/kit/stkeys.ci: Settings' Keyboard page (RS-SET5 of stage RS; frame 37, approved by DN-58, l 2026-11-11
// 17:15Z), a page module on kit/stpage.ci. Rows: Layout (a menu button, US; layouts other than US stay out of 0.1.0),
// Repeat Delay (Short to Long) and Repeat Rate (Slow to Fast), two sliders, and Shortcuts (Show All, the shortcut
// sheet).
//
// The sliders step as RS-KR's input control takes them: the delay from 250 to 1000 ms by 50, the rate from 5 to 40
// keys a second by 5. The defaults, 500 ms and 30 a second, sit where frame 37 draws the knobs. The host tells the
// values (set_delay, set_rate); a press, a drag or an arrow key returns DELAY (arg the ms) or RATE (arg keys a second)
// for the host to give the input control, which only the desk may set. Show All returns SHORTCUTS.
import user.ci.kit.tokens;
import user.ci.kit.faces;
import user.ci.kit.pen;
import user.ci.kit.stpage;

export const I64 DELAY = 16;           // stpage.ACT + 0
export const I64 RATE = 17;
export const I64 SHORTCUTS = 18;

export const I64 DELAY_MIN = 250;      // ms
export const I64 DELAY_MAX = 1000;
export const I64 DELAY_STEP = 50;
export const I64 DELAY_DEFAULT = 500;
export const I64 RATE_MIN = 5;         // keys a second
export const I64 RATE_MAX = 40;
export const I64 RATE_STEP = 5;
export const I64 RATE_DEFAULT = 30;

export const I64 F_NONE = 0;
export const I64 F_LAYOUT = 1;
export const I64 F_DELAY = 2;
export const I64 F_RATE = 3;
export const I64 F_SHOW = 4;

I64 delay = DELAY_DEFAULT;
I64 rate = RATE_DEFAULT;
I64 fs = F_NONE;
Bool kbd = false;
Bool menu_open = false;
I64 drag = F_NONE;                     // the slider the pointer holds
I64 a1 = 0;
Bool live = true;                      // the repeat rows take effect: the host's EVIOCSREP answers (PR 372)

I64[2] US_AT = [0, 2];

U32 tok(I64 t) { return tokens.word(t); }

export void set_delay(I64 ms) { delay = max(DELAY_MIN, min(ms, DELAY_MAX)); }
export void set_rate(I64 per_s) { rate = max(RATE_MIN, min(per_s, RATE_MAX)); }
export I64 arg() { return a1; }
export I64 focused() { return fs; }
export Bool menu_shown() { return menu_open; }

// Whether Repeat Delay and Repeat Rate can work (the kernel sets key repeat); when not, both rows are drawn at 40
// percent and inert: Tab passes them, a press on them does nothing (note 58, DN-46: no caption says why).
export void set_live(Bool on) {
    live = on;
    if (live) { return; }
    drag = F_NONE;
    if (fs == F_DELAY || fs == F_RATE) { fs = F_NONE; }
}

export void open() {
    fs = F_NONE;
    kbd = false;
    menu_open = false;
    drag = F_NONE;
}

// The keyboard moves in from the sidebar, at the first stop (Tab) or the last (Shift+Tab); whether a stop took it.
export Bool enter() {
    kbd = true;
    fs = F_NONE;
    return tab(1);
}

export Bool enter_last() {
    kbd = true;
    fs = F_NONE;
    return tab(-1);
}

// The stops in reading order: Layout, Repeat Delay, Repeat Rate, Show All (F_LAYOUT to F_SHOW less one).
Bool tab(I64 d) {
    I64 can = 15;
    if (!live) { can = 9; }
    I64 t = stpage.tab_to(fs - 1, d, 4, can);
    fs = t + 1;
    return t >= 0;
}

// --- the sliders' steps ---

I64 vmax(I64 s) {
    if (s == F_DELAY) { return (DELAY_MAX - DELAY_MIN) / DELAY_STEP; }
    return (RATE_MAX - RATE_MIN) / RATE_STEP;
}

// Slider s's step now.
export I64 step_of(I64 s) {
    if (s == F_DELAY) { return (delay - DELAY_MIN + DELAY_STEP / 2) / DELAY_STEP; }
    return (rate - RATE_MIN + RATE_STEP / 2) / RATE_STEP;
}

// Slider s at step v: the action that asks for it, or NONE when nothing changes.
I64 to_step(I64 s, I64 v) {
    I64 c = max(0, min(v, vmax(s)));
    if (c == step_of(s)) { return stpage.NONE; }
    if (s == F_DELAY) {
        a1 = DELAY_MIN + DELAY_STEP * c;
        return DELAY;
    }
    a1 = RATE_MIN + RATE_STEP * c;
    return RATE;
}

// --- geometry ---

I64 row_y(I64 y0, I64 k) { return stpage.row_y(y0 + stpage.BODY, k); }

// Frame 48: the page's height from y0; a box less tall scrolls it (kit/stbox.ci).
export I64 tall() { return row_y(0, 3) + stpage.ROW + stpage.FOOT; }

// Frame 48: the keyboard's row, from the page's top (y0 = 0): its top and bottom, -1 while the keyboard is not in the
// page. The host gives them to kit/stbox.ci reveal after each key, so the row stays whole under the head.
export I64 focus_top() {
    if (!kbd || fs == F_NONE) { return -1; }
    return row_y(0, fs - F_LAYOUT);
}

export I64 focus_bottom() {
    if (!kbd || fs == F_NONE) { return -1; }
    return row_y(0, fs - F_LAYOUT) + stpage.ROW;
}
I64 menu_x(I64 cr) { return cr - stpage.MENU_W; }
I64 track_x(I64 cr, I64 s) {
    if (s == F_DELAY) { return stpage.slider_x(cr, b"Long", 4); }
    return stpage.slider_x(cr, b"Fast", 4);
}
I64 show_w() { return stpage.bw(b"Show All", 8, faces.NAME); }

// --- drawing ---

void slider_row(inout U32[_] row, I64 cx, I64 cr, I64 ry, I64 s) {
    I64 x0 = track_x(cr, s);
    if (s == F_DELAY) {
        stpage.label(row, cx, ry, stpage.ROW, x0 - 60, b"Repeat Delay", 12);
        stpage.slider_words(row, x0, ry + 10, b"Short", 5, b"Long", 4);
    } else {
        stpage.label(row, cx, ry, stpage.ROW, x0 - 60, b"Repeat Rate", 11);
        stpage.slider_words(row, x0, ry + 10, b"Slow", 4, b"Fast", 4);
    }
    stpage.slider(row, x0, ry + 10, stpage.SL_W, step_of(s), vmax(s));
}

// The 1x row y of the page from (cx, y0) to (cr, yb), through the pen.
export void row_at(inout U32[_] row, I64 cx, I64 y0, I64 cr, I64 yb, I64 y) {
    stpage.title(row, cx, y0, cr, b"Keyboard", 8, y);
    I64 ry = row_y(y0, 0);
    if (stpage.on(y, ry - 4, stpage.ROW + 8)) {
        stpage.label(row, cx, ry, stpage.ROW, menu_x(cr) - 8, b"Layout", 6);
        if (stpage.on(y, ry + 4, stpage.BTN)) { stpage.menu_button(row, menu_x(cr), ry + 4, stpage.MENU_W, b"US", 2, faces.BODY); }
        if (kbd && fs == F_LAYOUT && !menu_open) { stpage.focus(row, menu_x(cr), ry + 4, cr, ry + 36, stpage.R_CTRL); }
    }
    for k in 1..3 {
        stpage.rule_before(row, cx, y0 + stpage.BODY, cr, k);
        ry = row_y(y0, k);
        I64 s = F_DELAY + k - 1;
        if (stpage.on(y, ry - 4, stpage.ROW + 8)) {
            if (stpage.on(y, ry, stpage.ROW)) { slider_row(row, cx, cr, ry, s); }
            if (!live && stpage.on(y, ry, stpage.ROW)) { stpage.fade(row, cx, cr); }
            if (kbd && fs == s) { stpage.focus(row, track_x(cr, s), ry + 10, track_x(cr, s) + stpage.SL_W, ry + 30, 10); }
        }
    }
    stpage.rule_before(row, cx, y0 + stpage.BODY, cr, 3);
    ry = row_y(y0, 3);
    if (stpage.on(y, ry - 4, stpage.ROW + 8)) {
        stpage.label(row, cx, ry, stpage.ROW, cr - show_w() - 8, b"Shortcuts", 9);
        I64 bx = stpage.row_button(row, cr, ry, b"Show All", 8);
        if (kbd && fs == F_SHOW) { stpage.focus(row, bx, ry + 4, cr, ry + 36, stpage.R_CTRL); }
    }
    if (menu_open) {                                           // over the rows below, its shadow within the page
        I64 my = row_y(y0, 0) + 40;
        stpage.menu(row, pen.x(cx - stpage.PAD), pen.x(cr + stpage.PAD), menu_x(cr), my, stpage.MENU_W, b"US", US_AT, 1, 0, 1, 0,
                    faces.BODY, y);
    }
}

// --- the pointer ---

// A press at (px, py): the Layout menu, a slider (it may be dragged), Show All.
export I64 click(I64 cx, I64 y0, I64 cr, I64 yb, I64 px, I64 py) {
    kbd = false;
    I64 ry = row_y(y0, 0);
    if (menu_open) {
        menu_open = false;
        return stpage.DRAW;                                    // US, the one row, or a press outside: the menu closes
    }
    if (py >= ry + 4 && py < ry + 36 && px >= menu_x(cr) && px < cr) {
        fs = F_LAYOUT;
        menu_open = true;
        return stpage.DRAW;
    }
    for k in 1..3 {
        ry = row_y(y0, k);
        I64 s = F_DELAY + k - 1;
        I64 x0 = track_x(cr, s);
        if (live && py >= ry + 6 && py < ry + 34 && px >= x0 - 4 && px < x0 + stpage.SL_W + 4) {
            fs = s;
            drag = s;
            I64 a = to_step(s, stpage.slider_at(x0, stpage.SL_W, vmax(s), px));
            if (a == stpage.NONE) { return stpage.DRAW; }
            return a;
        }
    }
    ry = row_y(y0, 3);
    if (py >= ry + 4 && py < ry + 36 && px >= cr - show_w() && px < cr) {
        fs = F_SHOW;
        return SHORTCUTS;
    }
    return stpage.NONE;
}

// The pointer moves with the button down: the held slider follows it.
export I64 move(I64 cx, I64 y0, I64 cr, I64 yb, I64 px, I64 py) {
    if (drag == F_NONE) { return stpage.NONE; }
    return to_step(drag, stpage.slider_at(track_x(cr, drag), stpage.SL_W, vmax(drag), px));
}

export void release() { drag = F_NONE; }
export Bool dragging() { return drag != F_NONE; }

// --- the keyboard ---

// A key: Tab and Shift+Tab step through Layout, Repeat Delay, Repeat Rate and Show All, past either end to the
// sidebar (BACK); on a slider Left and Right step it, Home and End take its ends; Enter or Space opens the Layout menu
// (Enter, Space, Esc or Tab closes it) and presses Show All. An arrow with no stop shows the ring on the first.
export I64 key(I64 code) {
    if (stpage.is_tab(code) || stpage.is_arrow(code)) { kbd = true; }
    if (menu_open) {
        if (stpage.is_press(code) || code == stpage.K_ESC || stpage.is_tab(code)) { menu_open = false; }
        if (!stpage.is_tab(code)) {
            if (menu_open) { return stpage.NONE; }
            return stpage.DRAW;
        }
    }
    if (stpage.is_tab(code)) {
        if (tab(stpage.tab_d(code))) { return stpage.DRAW; }
        return stpage.BACK;
    }
    if (fs == F_NONE) {
        if (stpage.is_arrow(code) && tab(1)) { return stpage.DRAW; }
        return stpage.NONE;
    }
    if (fs == F_DELAY || fs == F_RATE) {
        if (code == stpage.K_LEFT) { return to_step(fs, step_of(fs) - 1); }
        if (code == stpage.K_RIGHT) { return to_step(fs, step_of(fs) + 1); }
        if (code == stpage.K_HOME) { return to_step(fs, 0); }
        if (code == stpage.K_END) { return to_step(fs, vmax(fs)); }
        if (stpage.is_arrow(code)) { return stpage.DRAW; }
        return stpage.NONE;
    }
    if (stpage.is_arrow(code)) { return stpage.DRAW; }       // nothing to move inside a button: the ring shows
    if (!stpage.is_press(code)) { return stpage.NONE; }
    if (fs == F_LAYOUT) {
        menu_open = true;
        return stpage.DRAW;
    }
    return SHORTCUTS;
}
