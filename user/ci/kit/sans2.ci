U8[95] adv = [
    8, 8, 12, 16, 14, 16, 16, 8, 10, 10, 14, 14, 8, 12, 8, 14, 14, 14, 14,
    14, 14, 14, 14, 14, 14, 14, 8, 8, 14, 14, 14, 14, 18, 16, 14, 14, 14, 14,
    14, 14, 14, 10, 14, 14, 14, 18, 14, 14, 14, 14, 14, 14, 14, 14, 14, 18, 14,
    14, 14, 10, 14, 10, 14, 14, 10, 14, 14, 14, 16, 14, 12, 14, 14, 8, 10, 14,
    8, 18, 14, 14, 14, 16, 12, 14, 12, 14, 14, 18, 14, 14, 14, 10, 8, 10, 14
];

I64 at(I64 c) {
    I64 k = c - 32;
    if (k < 0 || k > 94) { k = 31; }
    return k;
}

// Glyph c's advance in pixels.
export I64 advance(I64 c) { return adv[at(c)] as I64; }

// Row y (0 to 31) of glyph c, column 0 in bit 31.
export I64 row(I64 c, I64 y) {
    U64 word = bits[16 * at(c) + y / 2];
    return ((word >> (32 * (1 - y % 2)) as U64) & 4294967295) as I64;
}
