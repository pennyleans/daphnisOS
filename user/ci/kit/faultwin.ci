// user/ci/kit/faultwin.ci: the Fault window's body (frame 23, DN-51, approved 2026-11-11; design answers 2026-11-12
// 08:23Z). The desk opens it as its own float (`Fault` on its bar, the close button alone) when a window it opened
// for an app ends on a fault: the app's program sent its record (user/ci/main.c, OSC 7770 fault) before it ended.
// This module keeps the record the desk gives it and draws the body on draw.ci's row contract; it reads no file and
// no clock.
//
// The body, logical pixels from the content box's top left, PAD in: the warning symbol (16 px, stroked 1.5 in INK,
// its dot OCHRE), 10 px, `NAME stopped on a fault.` in NAME_BOLD INK, 10 px, `Nothing else was affected.` in BODY
// INK_DIM. 12 below, the record on MANTLE, radius 6, 10 in at top and bottom and 12 at the sides: a ROW_H row a
// field, the label in PATH INK_DIM, the value LABEL_W from it in PATH INK (the code in OCHRE); a field the record
// lacks is a row left out. 8 below, the source line on MANTLE, CODE_H high, radius 6, 12 in: its number in INK_DIM,
// 12 px, the line in PATH INK, the character at the fault's column on OCHRE (radius 2) in MANTLE. At the foot, PAD
// in, BTN_H high, radius 6: at the left `Enter Open in CVim` on FILL; at the right `Copy Report` and `Esc Close` on
// SURF1, 8 apart. Open in CVim is live with a position, a readable source and /bin/cvim; else it is drawn at 40
// percent and Close takes FILL and Enter. Copy Report waits on the clipboard (l's choice): 40 percent, no input.
// Enter takes the blue button, Esc closes; the focus starts on the blue button and its ring shows only once Tab,
// Left or Right is pressed (the ask rule of frame 23); Space takes the focused button. No caption explains anything
// (DN-46).
import user.ci.kit.tokens;
import user.ci.kit.blend;
import user.ci.kit.shape;
import user.ci.kit.stroke;
import user.ci.kit.faces;
import user.ci.kit.ctext;

export const I64 FW = 504;            // the window's frame at 1x, its bar included (frame 23)
export const I64 FH = 346;
export const I64 PAD = 14;
const I64 ROW_H = 20;
const I64 LABEL_W = 88;
const I64 CODE_H = 32;
const I64 BTN_H = 36;
const I64 BTN_SIDE = 12;
const I64 KEY_H = 20;
const I64 KEY_SIDE = 6;
const I64 KEY_GAP = 10;
const I64 DIM = 102;                   // 40 percent of 256

export const I64 FIELDS = 6;           // code, operation, operands, exact, limit, at (user/ci/terms.ci fault_field)
export const I64 F_AT = 5;
export const I64 STAY = 0;
export const I64 CLOSE = 1;
export const I64 OPEN = 2;             // Open in CVim

const I64 K_ESC = 1;
const I64 K_TAB = 15;
const I64 K_ENTER = 28;
const I64 K_SPACE = 57;
const I64 K_LEFT = 105;
const I64 K_RIGHT = 106;

U8[24] nm;                             // the app's name
I64 nn = 0;
U8[384] fv;                            // FIELDS values, 64 bytes each
I64[6] fl;
U8[160] src;                           // the source line at the fault, as read
I64 sn = 0;
I64 line_no = 0;
I64 col = 0;                           // 1-based, 0 for none
Bool can_open = false;
Bool on_open = true;                   // the focus: Open in CVim, else Close
Bool kbd = false;

// The record of app name for the window: field k's value is vals[64 * k .. 64 * k + lens[k]].
export void open(in U8[_] nmv, in U8[_] vals, in I64[_] lens) {
    nn = min(len(nmv), 24);
    for k in 0..nn { nm[k] = nmv[k]; }
    for f in 0..FIELDS {
        fl[f] = min(lens[f], 64);
        for k in 0..fl[f] { fv[64 * f + k] = vals[64 * f + k]; }
    }
    sn = 0;
    line_no = 0;
    col = 0;
    can_open = false;
    on_open = false;
    kbd = false;
}

// The source line the desk read at the record's position: line number l, column c (1-based), its text t; and
// whether Open in CVim can open it there.
export void source(I64 l, I64 c, in U8[_] t, Bool ok) {
    line_no = l;
    col = c;
    sn = min(len(t), 160);
    for k in 0..sn { src[k] = t[k]; }
    can_open = ok && l > 0;
    on_open = can_open;
}

export I64 name(inout U8[_] dst) {
    for k in 0..min(nn, len(dst)) { dst[k] = nm[k]; }
    return min(nn, len(dst));
}
export Bool live() { return can_open; }
export I64 line() { return line_no; }
export I64 column() { return col; }

// The record's position, path:line:column, split: the path into dst (its length, 0 for none), the line and column
// into lc[0], lc[1] (0 when absent).
export I64 position(inout U8[_] dst, inout I64[2] lc) {
    I64 n = fl[F_AT];
    lc[0] = 0;
    lc[1] = 0;
    I64 c2 = -1;
    I64 c1 = -1;
    for k in 0..n {
        if (fv[64 * F_AT + k] == ':') {
            c1 = c2;
            c2 = k;
        }
    }
    if (c1 <= 0 || c2 <= c1 + 1 || c2 >= n - 1) { return 0; }
    lc[0] = num(64 * F_AT + c1 + 1, 64 * F_AT + c2);
    lc[1] = num(64 * F_AT + c2 + 1, 64 * F_AT + n);
    I64 pn = min(c1, len(dst));
    for k in 0..pn { dst[k] = fv[64 * F_AT + k]; }
    return pn;
}

I64 num(I64 a, I64 b) {
    I64 v = 0;
    for k in a..b {
        U8 c = fv[k];
        if (c < '0' || c > '9' || v > 100000000) { return 0; }
        v = v * 10 + (c - '0') as I64;
    }
    return v;
}

// A key: OPEN, CLOSE or STAY.
export I64 key(I64 c) {
    if (c == K_ESC) { return CLOSE; }
    if (c == K_ENTER) {
        if (can_open) { return OPEN; }
        return CLOSE;
    }
    if (c == K_SPACE) {
        if (on_open) { return OPEN; }
        return CLOSE;
    }
    if (c == K_TAB || c == K_LEFT || c == K_RIGHT) {
        if (kbd && can_open) { on_open = !on_open; }
        kbd = true;
    }
    return STAY;
}

// --- geometry (logical, from the content box's top left; cw x ch the box) ---

I64 rows() {
    I64 r = 0;
    for f in 0..FIELDS {
        if (fl[f] > 0) { r = r + 1; }
    }
    return r;
}
I64 rec_y() { return PAD + 16 + 12; }
I64 rec_h() { return 20 + ROW_H * rows(); }
I64 code_y() { return rec_y() + rec_h() + 8; }
I64 btn_y(I64 ch) { return ch - PAD - BTN_H; }

export I64 key_w(in U8[_] k) { return KEY_SIDE + ctext.width(k, len(k), faces.SHORTCUT, 1) + KEY_SIDE; }
I64 bw(in U8[_] k, in U8[_] s) {
    I64 kw = 0;
    if (len(k) > 0) { kw = key_w(k) + KEY_GAP; }
    return BTN_SIDE + kw + ctext.width(s, len(s), faces.NAME_BOLD, 1) + BTN_SIDE;
}
I64 open_w() { return bw(b"Enter", b"Open in CVim"); }
I64 close_key_w() {
    if (can_open) { return bw(b"Esc", b"Close"); }
    return bw(b"Enter", b"Close");
}
I64 close_x0(I64 cw) { return cw - PAD - close_key_w(); }
I64 copy_x0(I64 cw) { return close_x0(cw) - 8 - bw(b"", b"Copy Report"); }

// A press at (px, py) of the body (cw x ch): OPEN, CLOSE or STAY.
export I64 click(I64 px, I64 py, I64 cw, I64 ch) {
    I64 bt = btn_y(ch);
    if (py < bt || py >= bt + BTN_H) { return STAY; }
    if (can_open && px >= PAD && px < PAD + open_w()) { return OPEN; }
    if (px >= close_x0(cw) && px < cw - PAD) { return CLOSE; }
    return STAY;
}

// --- drawing ---

U32 tok(I64 t) { return tokens.word(t); }

I64 base_in(I64 t, I64 h, I64 f) {
    I64 a = ctext.ascent(f, 1);
    I64 d = ctext.descent(f, 1);
    return t + (h - a - d) / 2 + a;
}

// The warning symbol (frame 23: M8 2.5 L14 13 H2 Z and M8 6.5 V9.5, stroked 1.5; the dot at 8, 11.25 of radius 0.8 in
// OCHRE), 16 units at zoom z from device (x0, y0).
I64[20] tri = [128, 40, 224, 208, 224, 208, 32, 208, 32, 208, 128, 40, 128, 104, 128, 152, 128, 180, 128, 180];
void warn_row(inout U32[_] row, I64 y, I64 x0, I64 y0, I64 z) {
    stroke.path_row(row, y, x0, y0, z, 1, tri[0..16], 4, 24, tok(tokens.INK));
    stroke.path_row(row, y, x0, y0, z, 1, tri[16..20], 1, 26, tok(tokens.OCHRE));
}

// Button [x, x + w) at device top left (ox, oy), zoom z, row y: ground g, its keycap for k (none when empty), word s
// in ink; a = 256 drawn whole, DIM at 40 percent over the body; ring: DN-40's.
void button(inout U32[_] row, I64 y, I64 ox, I64 oy, I64 x, I64 bt, I64 w, in U8[_] k, in U8[_] s, I64 g, I64 ink,
            I64 ke, I64 a, Bool ring, I64 z) {
    I64 x0 = ox + x * z;
    I64 y0 = oy + bt * z;
    I64 x1 = ox + (x + w) * z;
    I64 y1 = oy + (bt + BTN_H) * z;
    U32 paper = tok(tokens.PAPER);
    if (y >= y0 && y < y1) {
        shape.rounded(row, y, x0, y0, x1, y1, 6 * z, blend.mix_px(paper, tok(g), a));
        U32 ic = blend.mix_px(paper, tok(ink), a);
        I64 wx = x + BTN_SIDE;
        if (len(k) > 0) {
            I64 kw = key_w(k);
            I64 ky = bt + (BTN_H - KEY_H) / 2;
            shape.ring(row, y, ox + wx * z, oy + ky * z, ox + (wx + kw) * z, oy + (ky + KEY_H) * z, 4 * z, z,
                       blend.mix_px(paper, tok(ke), a));
            if (y >= oy + ky * z && y < oy + (ky + KEY_H) * z) {
                I64 e = ctext.text(row, y, ox + (wx + KEY_SIDE) * z, oy + base_in(ky, KEY_H, faces.SHORTCUT) * z,
                                   ox + (wx + kw) * z, k, len(k), ic, faces.SHORTCUT, z);
            }
            wx = wx + kw + KEY_GAP;
        }
        I64 e2 = ctext.text(row, y, ox + wx * z, oy + base_in(bt, BTN_H, faces.NAME_BOLD) * z, x1, s, len(s), ic,
                            faces.NAME_BOLD, z);
    }
    if (ring && y >= y0 - 4 * z && y < y1 + 4 * z) {
        shape.focus_ring(row, y, x0, y0, x1, y1, 6 * z, z, paper, tok(tokens.ULTRAMARINE));
    }
}

// Device row y of the body, its content box at device (ox, oy), cw x ch logical, zoom z; the ground (PAPER) is the
// caller's.
export void row_at(inout U32[_] row, I64 y, I64 ox, I64 oy, I64 cw, I64 ch, I64 z) {
    if (y < oy || y >= oy + ch * z) { return; }
    I64 x1 = ox + (cw - PAD) * z;
    if (y < oy + (PAD + 16) * z) {     // the head
        warn_row(row, y, ox + PAD * z, oy + PAD * z, z);
        U8[48] t;
        I64 n = min(nn, 24);
        for k in 0..n { t[k] = nm[k]; }
        U8[20] w = b" stopped on a fault.";
        for k in 0..20 { t[n + k] = w[k]; }
        I64 bt = oy + base_in(PAD, 16, faces.NAME_BOLD) * z;
        I64 e = ctext.text(row, y, ox + (PAD + 26) * z, bt, x1, t[0..n + 20], n + 20, tok(tokens.INK),
                           faces.NAME_BOLD, z);
        I64 e2 = ctext.text(row, y, e + 10 * z, oy + base_in(PAD, 16, faces.BODY) * z, x1,
                            b"Nothing else was affected.", 26, tok(tokens.INK_DIM), faces.BODY, z);
    }
    I64 ry = rec_y();
    if (rows() > 0 && y >= oy + ry * z && y < oy + (ry + rec_h()) * z) {
        shape.rounded(row, y, ox + PAD * z, oy + ry * z, x1, oy + (ry + rec_h()) * z, 6 * z, tok(tokens.MANTLE));
        I64 r = 0;
        for f in 0..FIELDS {
            if (fl[f] > 0) {
                I64 top = ry + 10 + ROW_H * r;
                if (y >= oy + top * z && y < oy + (top + ROW_H) * z) {
                    I64 b = oy + base_in(top, ROW_H, faces.PATH) * z;
                    U8[12] lb;
                    I64 ln = label(f, lb);
                    I64 e = ctext.text(row, y, ox + (PAD + 12) * z, b, x1, lb[0..ln], ln, tok(tokens.INK_DIM),
                                       faces.PATH, z);
                    I64 vc = tokens.INK;
                    if (f == 0) { vc = tokens.OCHRE; }
                    e = ctext.text(row, y, ox + (PAD + 12 + LABEL_W) * z, b, x1 - 12 * z, fv[64 * f..64 * f + fl[f]],
                                   fl[f], tok(vc), faces.PATH, z);
                }
                r = r + 1;
            }
        }
    }
    I64 cy = code_y();
    if (line_no > 0 && sn >= 0 && y >= oy + cy * z && y < oy + (cy + CODE_H) * z) {
        shape.rounded(row, y, ox + PAD * z, oy + cy * z, x1, oy + (cy + CODE_H) * z, 6 * z, tok(tokens.MANTLE));
        U8[12] d;
        I64 dn = digits(line_no, d);
        I64 b = oy + base_in(cy, CODE_H, faces.PATH) * z;
        I64 e = ctext.text(row, y, ox + (PAD + 12) * z, b, x1, d[0..dn], dn, tok(tokens.INK_DIM), faces.PATH, z);
        I64 tx = e + 12 * z;
        if (col >= 1 && col <= sn) {   // the character at the fault on OCHRE, radius 2, 1 px above and below
            I64 hx0 = tx + ctext.width(src[0..col - 1], col - 1, faces.PATH, z) - 2 * z;
            I64 hx1 = tx + ctext.width(src[0..col], col, faces.PATH, z) + 2 * z;
            I64 hy0 = oy + (cy + 7) * z;
            I64 hy1 = oy + (cy + CODE_H - 7) * z;
            if (y >= hy0 && y < hy1) { shape.rounded(row, y, hx0, hy0, hx1, hy1, 2 * z, tok(tokens.OCHRE)); }
        }
        I64 e2 = ctext.text(row, y, tx, b, x1 - 12 * z, src[0..sn], sn, tok(tokens.INK), faces.PATH, z);
        if (col >= 1 && col <= sn) {   // the character itself in MANTLE over its ochre
            I64 hx = tx + ctext.width(src[0..col - 1], col - 1, faces.PATH, z);
            e2 = ctext.text(row, y, hx, b, x1 - 12 * z, src[col - 1..col], 1, tok(tokens.MANTLE), faces.PATH, z);
        }
    }
    I64 bt = btn_y(ch);
    if (y < oy + (bt - 4) * z || y >= oy + (bt + BTN_H + 4) * z) { return; }
    I64 oa = 256;
    I64 og = tokens.FILL;
    I64 oi = tokens.ON_FILL;
    if (!can_open) {
        oa = DIM;
    }
    button(row, y, ox, oy, PAD, bt, open_w(), b"Enter", b"Open in CVim", og, oi, tokens.ON_FILL, oa,
           kbd && can_open && on_open, z);
    button(row, y, ox, oy, copy_x0(cw), bt, bw(b"", b"Copy Report"), b"", b"Copy Report", tokens.SURF1, tokens.INK,
           tokens.RULE, DIM, false, z);
    if (can_open) {
        button(row, y, ox, oy, close_x0(cw), bt, close_key_w(), b"Esc", b"Close", tokens.SURF1, tokens.INK,
               tokens.RULE, 256, kbd && !on_open, z);
    } else {
        button(row, y, ox, oy, close_x0(cw), bt, close_key_w(), b"Enter", b"Close", tokens.FILL, tokens.ON_FILL,
               tokens.ON_FILL, 256, kbd, z);
    }
}

I64 label(I64 f, inout U8[12] t) {
    if (f == 0) { return put(b"code", t); }
    if (f == 1) { return put(b"operation", t); }
    if (f == 2) { return put(b"operands", t); }
    if (f == 3) { return put(b"exact", t); }
    if (f == 4) { return put(b"limit", t); }
    return put(b"at", t);
}

I64 put(in U8[_] s, inout U8[12] t) {
    for k in 0..len(s) { t[k] = s[k]; }
    return len(s);
}

I64 digits(I64 v, inout U8[12] d) {
    U8[12] r;
    I64 n = 0;
    I64 q = v;
    if (q <= 0) {
        d[0] = '0';
        return 1;
    }
    while (q > 0 && n < 12) {
        r[n] = (48 + q % 10) as U8;
        q = q / 10;
        n = n + 1;
    }
    for k in 0..n { d[k] = r[n - 1 - k]; }
    return n;
}
