// user/ci/kit/monpad.ci: Monitor's body (stage RS, RS-MON; frames 42 and 45 approved by DN-58, design note 59, DN-58
// item 4), on draw.ci's row contract. The program (user/ci/monitor.ci) reads the system's counts once a second and
// tells them here; this module keeps a minute of each part's history, makes every share and rate from two readings
// (the kernel keeps neither), and draws. The hosted tests drive it the same way.
//
// The parts sit at the left, each with its symbol, live figure and a small graph; the chosen part fills the right:
// its name and what it is, the wheel (only where there is a true share: Processor, Memory, Disk) and the figure (for
// Disk the space used, as its wheel: design note 68), one minute of history, its facts, then for Processor and Memory
// the processes sorted by that part; a short box shortens the graph so the list keeps a whole row. Each part has one
// color, for its symbol, wheel arc, graphs and list column; the colors are literal in each theme (design note 62).
// Graphics has no load figure without a driver: the mode and the card, no graph, no list. A part whose call is
// absent (Graphics Memory always; Disk with no disk; Network with no network device, or no facts kind 3) is drawn at
// 40 percent, name and symbol, and cannot be chosen (DN-58 item 12). A device that is there is drawn at full strength
// however idle: Network with no link or no traffic reads 0 B/s, its graph flat, its Link "Not connected" (design note
// 68). The parts never reorder. A fact that is missing closes the facts row up; every graph starts empty and fills
// from the right. The list is what facts kind 2 gives the caller, a Child's own processes or a Parent's all (DN-69
// item 5), with no word for what it leaves out (DN-46); the totals are the machine's. End Process ends the chosen one.
//
// The layout is one function of the box (box(w, h)), so a surface of another size takes one call. Geometry is in 1x
// pixels; row_at draws at zoom z.
import user.ci.kit.tokens;
import user.ci.kit.blend;
import user.ci.kit.shape;
import user.ci.kit.shade;
import user.ci.kit.stroke;
import user.ci.kit.faces;
import user.ci.kit.ctext;
import user.ci.kit.appfaces;
import user.ci.kit.apptext;
import user.ci.kit.wheel;
import user.ci.kit.icons3;
import user.ci.kit.apps;
import user.ci.kit.winname;   // note 28: a process's app by its program, the desk's one mapping

export const I64 W = 758;              // frame 42's window body: 760 less its sides, 620 less the bar and the bottom
export const I64 H = 587;
export const I64 CPU = 0;              // the parts, in the sidebar's order
export const I64 MEM = 1;
export const I64 DISK = 2;
export const I64 NET = 3;
export const I64 GPU = 4;
export const I64 GMEM = 5;
export const I64 PARTS = 6;
export const I64 PROCS = 64;           // facts kind 2's table
export const I64 NONE = -1;            // what a click or a key did: nothing,
export const I64 FOLD = 10;            // the list folded or opened,
export const I64 END = 11;             // End Process on the chosen process (end_pid),
export const I64 PICK = 12;            // a process chosen; or a part's own number, that part chosen
export const I64 SIDE_FLIP = 13;       // the folded sidebar opened or closed
export const I64 GRANT_DISK = 1;       // the grant word's bits (src/fs.ci)
export const I64 GRANT_NET = 2;
export const I64 GRANT_AUDIO = 4;

const I64 SIDE = 216;                  // the sidebar's width
const I64 HIST = 61;                   // a minute of samples, both ends
const I64 SPARK = 15;                  // the sidebar graph's samples
const I64 DIM = 102;                   // 40 percent in 256ths
const I64 WASH = 51;                   // a graph's wash, 20 percent
const I64 SPARK_WASH = 56;             // a sidebar graph's, 22 percent
const I64 THUMB = 128;                 // the scroll thumb, 50 percent
const I64 PITCH = 30;                  // a list row and its gap
const I64 MIN_W = 480;                 // the least box laid out; a smaller one clips at the right and bottom (DN-63)
const I64 MIN_H = 360;
const I64 NARROW = 640;                // under this width the sidebar folds behind a button (DN-63, DN-55's form)
const I64 CONTENT_MAX = 960;           // the right side's content, centered past this
const I64 GRAPH_H = 132;               // the minute's graph; on a part with no list it grows with the box to GRAPH_MAX
const I64 GRAPH_MAX = 240;
const I64 RATE_MAX = 1125899906842624; // 1 PiB/s, the most a rate reads; a graph's points stay inside I64 under it
const I64 GRAPH_MIN = 48;              // a short box shortens a listed part's graph to this, for a whole row
const I64 SHADOW = 3;                  // the folded sidebar's shadow: High

// The parts' colors, dark then light (frames 42 and 45; RS spec section 5's light map).
U32[12] part_c = [0x4a88c7, 0xfabd2f, 0xd65d0e, 0x8ec07c, 0xd3869b, 0x7daea3,
                  0x1a4b8c, 0xc98f00, 0x9e4724, 0x3f7d3a, 0xa04a78, 0x2f7a72];
U8[64] part_words;
Bool words_ready = false;

void copy_words(in U8[_] src) {
    for i in 0..len(src) { part_words[i] = src[i]; }
}

void words() {
    if (words_ready) { return; }
    copy_words("ProcessorMemoryDiskNetworkGraphicsGraphics Memory");
    words_ready = true;
}
I64[7] part_at = [0, 9, 15, 19, 26, 34, 49];

