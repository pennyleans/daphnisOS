// user/ci/blake2b.ci: BLAKE2b (RFC 7693) in cint, keyed or not, digests of 1 to 64 bytes. AC-1b
// (docs/specs/2026-11-08-ac-accounts.md section 6): Argon2id's hash (user/ci/argon2.ci) and the verifier of AC-D9.
// Words are U64; the algorithm's arithmetic is modulo 2^64 by definition, so it uses the wrapping `+%` and `<<%`
// and the logical `>>`; every other operation is checked. Each ROTR^n of RFC 7693 section 2.1 is written inline with
// a constant count. The message schedule SIGMA (section 2.7) is ten words of sixteen 4-bit indices, first index in
// the top nibble, since this tree has no array literals.

export const I64 B2_BLOCK_BYTES = 128;
export const I64 B2_MAX_OUT = 64;
export const I64 B2_MAX_KEY = 64;

export struct Blake2b {
    U64[8] h;
    U8[128] block;
    I64 fill;
    I64 total;
    I64 outlen;
}

U64 iv(I64 i) {
    if (i == 0) { return 0x6a09e667f3bcc908; }
    if (i == 1) { return 0xbb67ae8584caa73b; }
    if (i == 2) { return 0x3c6ef372fe94f82b; }
    if (i == 3) { return 0xa54ff53a5f1d36f1; }
    if (i == 4) { return 0x510e527fade682d1; }
    if (i == 5) { return 0x9b05688c2b3e6c1f; }
    if (i == 6) { return 0x1f83d9abfb41bd6b; }
    return 0x5be0cd19137e2179;
}

U64 sigma_row(I64 r) {
    if (r == 0) { return 0x0123456789abcdef; }
    if (r == 1) { return 0xea489fd61c02b753; }
    if (r == 2) { return 0xb8c052fdae367194; }
    if (r == 3) { return 0x7931dcbe265a40f8; }
    if (r == 4) { return 0x905724afe1bc683d; }
    if (r == 5) { return 0x2c6a0b834d75fe19; }
    if (r == 6) { return 0xc51fed4a0763928b; }
    if (r == 7) { return 0xdb7ec13950f4862a; }
    if (r == 8) { return 0x6fe9b308c2d714a5; }
    return 0xa2847615fb9e3cd0;
}

// The mixing function G (RFC 7693 section 3.1) on v[a], v[b], v[c], v[d] with message words x and y.
void g(inout U64[_] v, I64 a, I64 b, I64 c, I64 d, U64 x, U64 y) {
    v[a] = v[a] +% v[b] +% x;
    U64 t = v[d] ^ v[a];
    v[d] = (t >> 32) | (t <<% 32);
    v[c] = v[c] +% v[d];
    t = v[b] ^ v[c];
    v[b] = (t >> 24) | (t <<% 40);
    v[a] = v[a] +% v[b] +% y;
    t = v[d] ^ v[a];
    v[d] = (t >> 16) | (t <<% 48);
    v[c] = v[c] +% v[d];
    t = v[b] ^ v[c];
    v[b] = (t >> 63) | (t <<% 1);
}

// The compression function F (RFC 7693 section 3.2) on s[0].block; last is the final block's flag.
void compress(inout Blake2b[_] s, Bool last) {
    U64[16] m;
    U64[16] v;
    for i in 0..16 {
        U64 w = 0;
        for k in 0..8 {
            w = w | ((s[0].block[8 * i + k] as U64) << (8 * k));
        }
        m[i] = w;
    }
    for i in 0..8 {
        v[i] = s[0].h[i];
        v[i + 8] = iv(i);
    }
    v[12] = v[12] ^ (s[0].total as U64);   // the counter's high word stays 0: a message under 2^63 bytes
    if (last) {
        v[14] = ~v[14];
    }
    for r in 0..12 {
        U64 row = sigma_row(r % 10);
        I64[16] sg;
        for i in 0..16 {
            sg[i] = ((row >> (60 - 4 * i)) & 15) as I64;
        }
        g(v, 0, 4, 8, 12, m[sg[0]], m[sg[1]]);
        g(v, 1, 5, 9, 13, m[sg[2]], m[sg[3]]);
        g(v, 2, 6, 10, 14, m[sg[4]], m[sg[5]]);
        g(v, 3, 7, 11, 15, m[sg[6]], m[sg[7]]);
        g(v, 0, 5, 10, 15, m[sg[8]], m[sg[9]]);
        g(v, 1, 6, 11, 12, m[sg[10]], m[sg[11]]);
        g(v, 2, 7, 8, 13, m[sg[12]], m[sg[13]]);
        g(v, 3, 4, 9, 14, m[sg[14]], m[sg[15]]);
    }
    for i in 0..8 {
        s[0].h[i] = s[0].h[i] ^ v[i] ^ v[i + 8];
    }
}

// Starts a digest of outlen bytes (1 to 64) keyed by key[0..keylen) (0 to 64 bytes; 0 is unkeyed).
export void b2_init(inout Blake2b[_] s, I64 outlen, in U8[_] key, I64 keylen) {
    assert(outlen >= 1 && outlen <= B2_MAX_OUT);
    assert(keylen >= 0 && keylen <= B2_MAX_KEY && keylen <= len(key));
    for i in 0..8 {
        s[0].h[i] = iv(i);
    }
    s[0].h[0] = s[0].h[0] ^ 0x01010000 ^ ((keylen as U64) << 8) ^ (outlen as U64);
    s[0].fill = 0;
    s[0].total = 0;
    s[0].outlen = outlen;
    for i in 0..B2_BLOCK_BYTES {
        s[0].block[i] = 0;
    }
    if (keylen > 0) {
        for i in 0..keylen {
            s[0].block[i] = key[i];
        }
        s[0].fill = B2_BLOCK_BYTES;   // the padded key is the first block, compressed when more data comes
    }
}

// Appends data[start..start + nbytes). A full block waits in s[0].block until more data arrives, so the last block
// is compressed by b2_final with its flag.
export void b2_update(inout Blake2b[_] s, in U8[_] data, I64 start, I64 nbytes) {
    for i in start..start + nbytes {
        if (s[0].fill == B2_BLOCK_BYTES) {
            s[0].total += B2_BLOCK_BYTES;
            compress(s, false);
            s[0].fill = 0;
        }
        s[0].block[s[0].fill] = data[i];
        s[0].fill += 1;
    }
}

// Pads and compresses the last block, and writes the digest to dst[0..outlen).
export void b2_final(inout Blake2b[_] s, inout U8[_] dst) {
    s[0].total += s[0].fill;
    for i in s[0].fill..B2_BLOCK_BYTES {
        s[0].block[i] = 0;
    }
    compress(s, true);
    for i in 0..s[0].outlen {
        dst[i] = (s[0].h[i / 8] >> (8 * (i % 8))) as% U8;
    }
}

// The outlen-byte digest of data[0..nbytes) under key[0..keylen), in one call.
export void b2_digest(in U8[_] data, I64 nbytes, in U8[_] key, I64 keylen, inout U8[_] dst, I64 outlen) {
    Blake2b[1] s;
    b2_init(s, outlen, key, keylen);
    b2_update(s, data, 0, nbytes);
    b2_final(s, dst);
}

// Appends the 32-bit little-endian encoding of v (0 <= v < 2^32), as Argon2's LE32 (RFC 9106 section 3.1).
export void b2_le32(inout Blake2b[_] s, I64 v) {
    U8[4] b;
    for k in 0..4 {
        b[k] = ((v >> (8 * k)) & 255) as U8;
    }
    b2_update(s, b, 0, 4);
}
