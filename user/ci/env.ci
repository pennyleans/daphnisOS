// user/ci/env.ci: env [-i] [NAME=VALUE...] [UTILITY [ARGUMENT...]] (docs/specs/2026-11-06-c-core.md, CT-4): the
// environment, without the start one under -i (or a first operand `-`, as busybox), with each NAME=VALUE set in
// order as putenv sets it. With no UTILITY it is written one string a line; else UTILITY runs in its place, found
// on the new environment's PATH, and a failure is `env: UTILITY: reason` with status 127 (not found) or 126.
import user.ci.dev;
import user.ci.shctl;
import user.ci.runctl;
import user.ci.core.put;
import user.ci.core.msg;
import user.ci.core.args;
import user.ci.core.run;

Bool has_eq(in U8[_] s) {
    for i in 0..len(s) {
        if (s[i] == '=') { return true; }
    }
    return false;
}

void main(in U8[_] a) {
    msg.name(b"env");
    args.parse(a, b"i", b"");
    run.env_load();
    if (args.has('i')) { run.env_clear(); }
    I64 n = args.operands();
    I64 k = 0;
    if (n > 0 && args.op_stop(a, 0) - args.op_start(0) == 1 && a[args.op_start(0)] == '-') {
        run.env_clear();
        k = 1;
    }
    Bool going = true;
    while (going && k < n) {
        I64 s = args.op_start(k);
        I64 e = args.op_stop(a, k);
        if (has_eq(a[s..e])) {
            if (a[s] == '=') {
                msg.file(a[s..e], 22);
                msg.finish();
            }
            run.env_set(a[s..e]);
            k = k + 1;
        } else {
            going = false;
        }
    }
    if (k == n) {
        run.env_print('\n');
        msg.finish();
    }
    put.flush();
    I64 at = args.op_start(k);
    I64 err = run.exec(a[at..len(a)]);
    run.say(a[at..len(a)], err);
    put.flush();
    dev.exit_now(run.status_of(err));
}
