// user/ci/cp.ci: cp [-R|-r] [-fiHLP] SOURCE... TARGET (docs/specs/2026-11-06-c-core.md, CT-2): each SOURCE to TARGET,
// or into TARGET when TARGET is a directory (then TARGET/base name of SOURCE); two or more SOURCEs need a directory.
// A regular file's bytes go to a target made with its mode less the umask, or truncated; -R copies a directory's
// tree (core/files.ci), which may not land in itself. Links: -L follows every link, -H those named here, -P none;
// without -R a named link is followed, with -R none (as busybox) unless -H or -L, the last of the three given wins.
// -i asks before a target is overwritten; -f unlinks a target that cannot be opened and opens it again.
// -p is refused until C-2 (K4: chmod, utimensat, chown).
import user.ci.dev;
import user.ci.shctl;
import user.ci.corectl;
import user.ci.core.put;
import user.ci.core.msg;
import user.ci.core.args;
import user.ci.core.path;
import user.ci.core.files;   // user/ci/build.sh emits the modules in this order, each after what it imports

U8[4096] dst;
I64[16] rt;

void main(in U8[_] a) {
    msg.name(b"cp");
    args.parse(a, b"RrfiHLP", b"");
    I64 n = args.operands();
    if (n < 2) { msg.usage(b"missing operand"); }
    Bool rec = args.has('R') || args.has('r');
    U8 how = args.last(b"HLP");
    Bool root = how == 'H' || how == 'L' || (how == 0 && !rec);
    files.set(rec, args.has('f'), args.has('i'), root, how == 'L');
    I64 ts = args.op_start(n - 1);
    I64 te = args.op_stop(a, n - 1);
    Bool into = corectl.co_stat(a[ts..te], 1, rt) == 0 && (rt[corectl.ST_MODE] & corectl.S_IFMT) == corectl.S_IFDIR;
    if (n > 2 && !into) {
        msg.file(a[ts..te], 20);
        msg.finish();
    }
    for i in 0..(n - 1) {
        I64 s = args.op_start(i);
        I64 e = args.op_stop(a, i);
        if (into) {
            I64 b = path.base_start(a[s..e]);
            I64 k = path.join(a[ts..te], a[(s + b)..(s + path.base_stop(a[s..e]))], dst);
            files.clone(a[s..e], dst[0..k]);
        } else {
            files.clone(a[s..e], a[ts..te]);
        }
    }
    msg.finish();
}
