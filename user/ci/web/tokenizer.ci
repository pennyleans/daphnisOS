}
export I64 next(in U32[_] input) {
    if (fault_reason != 0) { return -1; }
    if (ended) { return 0; }
    I64 result = next_token(input);
    if (result == 0) { ended = true; }
    return result;
}
export I64 name_len() { return nn; }
export U32 name_cp(I64 i) { if (i < 0 || i >= nn) { return 0; } return nm[i]; }
export I64 data_len() { return dn; }
export U32 data_cp(I64 i) { if (i < 0 || i >= dn) { return 0; } return dt[i]; }
export I64 attr_count() { return ac; }
export I64 attr_name_len(I64 i) { if (i < 0 || i >= ac) { return 0; } return alen[i]; }
export U32 attr_name_cp(I64 i, I64 j) { if (i < 0 || i >= ac || j < 0 || j >= alen[i]) { return 0; } return arena[astart[i] + j]; }
export I64 attr_value_len(I64 i) { if (i < 0 || i >= ac) { return 0; } return vlen[i]; }
export U32 attr_value_cp(I64 i, I64 j) { if (i < 0 || i >= ac || j < 0 || j >= vlen[i]) { return 0; } return arena[vstart[i] + j]; }
export Bool self_closing() { return closed; }
export Bool force_quirks() { return quirks; }
export Bool public_present() { return pp; }
export I64 public_len() { return pn; }
export U32 public_cp(I64 i) { if (i < 0 || i >= pn) { return 0; } return pub[i]; }
export Bool system_present() { return sp; }
export I64 system_len() { return sn; }
export U32 system_cp(I64 i) { if (i < 0 || i >= sn) { return 0; } return sys[i]; }
export I64 errors() { return parse_errors; }
export I64 limit_reason() { return fault_reason; }
