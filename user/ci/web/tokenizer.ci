I64 next_token(in U32[_] input) {
    if (fault_reason != 0) { return -1; }
    clear_token();
    while (true) {
        I64 c = peek(input);
        if (mode_now == 3) { return script(input); }
        if (c < 0) { if (mode_now == 5) { bad(); } return 0; }
        if (mode_now == 5) {
            if (match(input, b"]]>", false)) { pos = pos + 3; mode_now = 0; }
            else { advance(input); add_data(c as U32); return 1; }
        } else if (mode_now != 0) {
            if ((mode_now == 1 || mode_now == 2) && c == 60 && raw_end(input)) { pos = pos + 2; return tag(input, true); }
            advance(input);
            if (mode_now == 1 && c == 38) { reference_into(input, false); }
            else { add_data(nonnull(c)); }
            if (fault_reason != 0) { return -1; } return 1;
        } else if (c == 38) { advance(input); reference_into(input, false); if (fault_reason != 0) { return -1; } return 1; }
        else if (c != 60) { advance(input); if (c == 0) { bad(); } add_data(c as U32); return 1; }
        else {
            advance(input); c = peek(input);
            if (c < 0) { bad(); add_data(60); return 1; }
            if (alpha(c as U32)) { return tag(input, false); }
            if (c == 63) { advance(input); return processing(input); }
            if (c == 47) {
                advance(input); c = peek(input);
                if (c < 0) { bad(); add_data(60); add_data(47); return 1; }
                if (alpha(c as U32)) { return tag(input, true); }
                bad(); if (c == 62) { advance(input); } else { return bogus_comment(input); }
            } else if (c == 33) {
                advance(input);
                if (match(input, b"--", false)) { pos = pos + 2; return comment(input); }
                if (match(input, b"doctype", true)) { pos = pos + 7; return doctype(input); }
                if (match(input, b"[CDATA[", false)) {
                    if (cdata_ok) { pos = pos + 7; mode_now = 5; }
                    else { bad(); return bogus_comment(input); }
