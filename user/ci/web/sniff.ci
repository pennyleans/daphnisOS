// Bounded HTML prescan. No input view survives choose.
import user.ci.web.encoding;
I64 selected_source = 4;
I64 pos = 0;
U8[1024] attr_name;
U8[1024] attr_value;
I64 name_n = 0;
I64 value_n = 0;
Bool space(U8 c) { return c == 9 || c == 10 || c == 12 || c == 13 || c == 32; }
Bool alpha(U8 c) { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122); }
U8 folded(U8 c) { if (c >= 65 && c <= 90) { return (c as I64 + 32) as U8; } return c; }
Bool match(in U8[_] input, I64 at, in U8[_] word, Bool fold) {
    if (at < 0 || at > len(input) || len(word) > len(input)-at) { return false; }
    for i in 0..len(word) {
        U8 c = input[at+i]; if (fold) { c = folded(c); }
        if (c != word[i]) { return false; }
    }
    return true;
}
Bool same_bytes(in U8[_] input, in U8[_] word) { return len(input) == len(word) && match(input, 0, word, false); }
// -1 aborts the entire prescan, 0 ends attributes, 1 returns an attribute.
I64 attribute(in U8[_] input) {
    name_n = 0; value_n = 0;
    while (pos < len(input) && (space(input[pos]) || input[pos] == 47)) { pos = pos + 1; }
    if (pos >= len(input)) { return -1; }
    if (input[pos] == 62) { return 0; }
    while (true) {
        if (pos >= len(input)) { return -1; }
        U8 c = input[pos];
        if (c == 61 && name_n > 0) { break; }
        if (space(c)) {
            while (pos < len(input) && space(input[pos])) { pos = pos + 1; }
            if (pos >= len(input)) { return -1; }
            if (input[pos] != 61) { return 1; }
            break;
        }
        if (c == 47 || c == 62) { return 1; }
        attr_name[name_n] = folded(c); name_n = name_n + 1; pos = pos + 1;
    }
    pos = pos + 1;
    while (pos < len(input) && space(input[pos])) { pos = pos + 1; }
    if (pos >= len(input)) { return -1; }
    U8 quote = input[pos];
    if (quote == 34 || quote == 39) {
        pos = pos + 1;
        while (pos < len(input) && input[pos] != quote) {
            attr_value[value_n] = folded(input[pos]); value_n = value_n + 1; pos = pos + 1;
        }
        if (pos >= len(input)) { return -1; }
        pos = pos + 1; return 1;
    }
    if (input[pos] == 62) { return 1; }
    while (pos < len(input) && !space(input[pos]) && input[pos] != 62) {
        attr_value[value_n] = folded(input[pos]); value_n = value_n + 1; pos = pos + 1;
    }
    if (pos >= len(input)) { return -1; }
    return 1;
}
I64 content_encoding(in U8[_] input) {
    I64 at = 0;
    while (at < len(input)) {
        if (!match(input, at, b"charset", true)) { at = at + 1; continue; }
        at = at + 7;
        while (at < len(input) && space(input[at])) { at = at + 1; }
        if (at >= len(input)) { return 0; }
        if (input[at] != 61) { continue; }
        at = at + 1;
        while (at < len(input) && space(input[at])) { at = at + 1; }
        if (at >= len(input)) { return 0; }
        I64 start = at;
        if (input[at] == 34 || input[at] == 39) {
            U8 quote = input[at]; at = at + 1; start = at;
            while (at < len(input) && input[at] != quote) { at = at + 1; }
            if (at >= len(input)) { return 0; }
        } else {
            while (at < len(input) && !space(input[at]) && input[at] != 59) { at = at + 1; }
        }
        return encoding.label(input[start..at]);
    }
    return 0;
}
I64 xml_encoding(in U8[_] input) {
    if (!match(input, 0, b"<?xml", false)) { return 0; }
    I64 end = 5;
    while (end < len(input) && input[end] != 62) { end = end + 1; }
    if (end == len(input)) { return 0; }
    I64 at = 0;
    while (at < end && !match(input, at, b"encoding", false)) { at = at + 1; }
    if (at == end) { return 0; }
    at = at + 8;
    while (at < len(input) && input[at] <= 32) { at = at + 1; }
    if (at >= len(input) || input[at] != 61) { return 0; }
    at = at + 1;
    while (at < len(input) && input[at] <= 32) { at = at + 1; }
    if (at >= len(input)) { return 0; }
    U8 quote = input[at]; if (quote != 34 && quote != 39) { return 0; }
    at = at + 1; I64 start = at;
    while (at < len(input) && input[at] != quote) {
        if (input[at] <= 32) { return 0; }
        at = at + 1;
    }
    if (at == len(input)) { return 0; }
    I64 result = encoding.label(input[start..at]);
    if (result == 38 || result == 39) { return 1; }
    return result;
}
I64 prescan(in U8[_] input) {
    pos = 0;
    if (match(input,0,b"<\x00?\x00x\x00",false)) { return 39; }
    if (match(input,0,b"\x00<\x00?\x00x",false)) { return 38; }
    while (pos < len(input)) {
        if (match(input,pos,b"<!--",false)) {
            pos = pos + 2;
            while (pos < len(input) && !(input[pos] == 62 && input[pos-1] == 45 && input[pos-2] == 45)) { pos = pos + 1; }
        } else if (match(input,pos,b"<meta",true) && pos + 5 < len(input) && (space(input[pos+5]) || input[pos+5] == 47)) {
            pos = pos + 5;
            Bool seen_http = false; Bool seen_content = false; Bool seen_charset = false;
            Bool got_pragma = false; I64 need_pragma = -1; I64 charset = -1;
            while (true) {
                I64 status = attribute(input);
                if (status < 0) { return xml_encoding(input); }
                if (status == 0) { break; }
                if (same_bytes(attr_name[0..name_n], b"http-equiv") && !seen_http) {
                    seen_http = true; got_pragma = same_bytes(attr_value[0..value_n], b"content-type");
                } else if (same_bytes(attr_name[0..name_n], b"content") && !seen_content) {
                    seen_content = true;
                    I64 candidate = content_encoding(attr_value[0..value_n]);
                    if (candidate > 0 && charset == -1) { charset = candidate; need_pragma = 1; }
                } else if (same_bytes(attr_name[0..name_n], b"charset") && !seen_charset) {
                    seen_charset = true; charset = encoding.label(attr_value[0..value_n]); need_pragma = 0;
                }
            }
            if (need_pragma >= 0 && (need_pragma == 0 || got_pragma) && charset > 0) {
                if (charset == 38 || charset == 39) { charset = 1; }
                if (charset == 40) { charset = 22; }
                return charset;
            }
        } else if (input[pos] == 60 && ((pos+1 < len(input) && alpha(input[pos+1])) || (pos+2 < len(input) && input[pos+1] == 47 && alpha(input[pos+2])))) {
            while (pos < len(input) && !space(input[pos]) && input[pos] != 62) { pos = pos + 1; }
            while (true) {
                I64 status = attribute(input);
                if (status < 0) { return xml_encoding(input); }
                if (status == 0) { break; }
            }
        } else if (match(input,pos,b"<!",false) || match(input,pos,b"</",false) || match(input,pos,b"<?",false)) {
            while (pos < len(input) && input[pos] != 62) { pos = pos + 1; }
        }
        pos = pos + 1;
    }
    return xml_encoding(input);
}
export I64 source() { return selected_source; }
export I64 choose(in U8[_] prefix, in U8[_] transport_label, I64 fallback) {
    selected_source = 1;
    if (match(prefix,0,b"\xef\xbb\xbf",false)) { return 1; }
    if (match(prefix,0,b"\xff\xfe",false)) { return 39; }
    if (match(prefix,0,b"\xfe\xff",false)) { return 38; }
    selected_source = 2;
    I64 transport = encoding.label(transport_label); if (transport > 0) { return transport; }
    I64 bound = len(prefix); if (bound > 1024) { bound = 1024; }
    selected_source = 3;
    I64 scanned = prescan(prefix[0..bound]); if (scanned > 0) { return scanned; }
    selected_source = 4;
    if (fallback >= 1 && fallback <= 40) { return fallback; }
    return 22;
}
