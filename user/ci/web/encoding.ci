I64 euckr(I64 value) {
    if (value < 0) { if (a != 0) { a = 0; return -4; } return -1; }
    if (a != 0) {
        I64 leading = a; a = 0; I64 pointer = -1;
        if (between(value, 65, 254)) { pointer = (leading - 129) * 190 + value - 65; }
