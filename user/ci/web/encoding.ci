    if (selected == 33) { return eucjp(value); }
    if (selected == 34) { return iso2022jp(value); }
    if (selected == 35) { return sjis(value); }
    if (selected == 36) { return euckr(value); }
    if (value < 0) { return -1; }
    if (selected == 37) { if (a == 0) { a = 1; return -4; } return -5; }
    if (value < 128) { return value; }
    if (selected == 40) { return 63360 + value - 128; }
    I64 point = encoding_data.single(selected, value - 128);
    if (point < 0) { return -4; } return point;
}
export Step next(in U8[_] input, Bool final) {
    Step result; result.used = 0; result.value = terminal;
    if (terminal != 0) { return result; }
    while (true) {
        I64 point = -5;
        if (pending >= 0) { point = pending; pending = -1; }
        else {
            I64 value = -1;
            if (replay_n > 0) {
                value = replay[0]; replay_n = replay_n - 1;
                I64 index = 0;
                while (index < replay_n) { replay[index] = replay[index + 1]; index = index + 1; }
            } else if (result.used < len(input)) {
                value = input[result.used] as I64; result.used = result.used + 1; byte_position = byte_position + 1;
            } else if (!final) { result.value = -3; return result; }
            point = handle(value);
        }
        if (point == -5) { continue; }
        if (point == -4) {
            fault_count = fault_count + 1;
            if (fatal_mode) { terminal = -2; result.value = -2; return result; }
            point = 65533;
        }
        if (point == -1) { terminal = -1; result.value = -1; return result; }
        if (!bom_seen && (selected == 1 || selected == 38 || selected == 39)) {
            bom_seen = true;
            if (!keep_bom && point == 65279) { continue; }
        }
        result.value = point; return result;
    }
    return result;
}
