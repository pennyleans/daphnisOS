// States: ASCII, Roman, katakana, leading, trailing, escape start, escape.
I64 iso2022jp(I64 value) {
    if (jp_state <= 3) {
        if (value == 27) { jp_state = 5; return -5; }
        if (value < 0) { return -1; }
        jp_output = false;
        if (jp_state <= 1) {
            if (value < 128 && value != 14 && value != 15) {
                if (jp_state == 1 && value == 92) { return 165; }
                if (jp_state == 1 && value == 126) { return 8254; }
                return value;
            }
            return -4;
        }
        if (jp_state == 2) { if (between(value, 33, 95)) { return 65377 - 33 + value; } return -4; }
        if (between(value, 33, 126)) { a = value; jp_state = 4; return -5; }
        return -4;
    }
    if (jp_state == 4) {
        if (value == 27) { jp_state = 5; return -4; }
        jp_state = 3;
        if (between(value, 33, 126)) {
            I64 point = encoding_data.jis0208((a - 33) * 94 + value - 33);
            if (point >= 0) { return point; }
        }
        return -4;
    }
    if (jp_state == 5) {
        if (value == 36 || value == 40) { a = value; jp_state = 6; return -5; }
        if (value >= 0) { restore(value); }
        jp_output = false; jp_state = jp_output_state; return -4;
    }
    I64 leading = a; a = 0; I64 state = -1;
    if (leading == 40 && value == 66) { state = 0; }
    if (leading == 40 && value == 74) { state = 1; }
    if (leading == 40 && value == 73) { state = 2; }
    if (leading == 36 && (value == 64 || value == 66)) { state = 3; }
    if (state >= 0) {
        jp_state = state; jp_output_state = state;
