// Native WHATWG handlers. Replay stores accepted bytes and never retains a view.
import user.ci.web.encoding_data;
export struct Step { I64 used; I64 value; }
I64 selected = 0;
Bool fatal_mode = false;
Bool keep_bom = false;
Bool bom_seen = false;
I64 terminal = -2;
I64 byte_position = 0;
I64 fault_count = 0;
I64 a = 0;
I64 b = 0;
I64 c = 0;
I64 remaining = 0;
I64 accumulator = 0;
I64 utf_lower = 128;
I64 utf_upper = 191;
I64 utf_byte = -1;
I64 surrogate = -1;
Bool jis0212 = false;
I64 jp_state = 0;
I64 jp_output_state = 0;
Bool jp_output = false;
I64 pending = -1;
I64[3] replay;
I64 replay_n = 0;

Bool between(I64 v, I64 low, I64 high) { return v >= low && v <= high; }
Bool ascii_space(I64 v) { return v == 9 || v == 10 || v == 12 || v == 13 || v == 32; }
I64 folded(I64 v) { if (between(v, 65, 90)) { return v + 32; } return v; }
export I64 label(in U8[_] name) {
    I64 start = 0; I64 end = len(name);
    while (start < end && ascii_space(name[start] as I64)) { start = start + 1; }
    while (end > start && ascii_space(name[end - 1] as I64)) { end = end - 1; }
    I64 low = 0; I64 high = encoding_data.alias_count();
    while (low < high) {
        I64 row = low + (high - low) / 2;
        I64 at = encoding_data.alias_offset(row);
        I64 index = start;
        while (index < end && encoding_data.alias_character(at) != 0 && folded(name[index] as I64) == encoding_data.alias_character(at)) {
            index = index + 1; at = at + 1;
        }
        I64 wanted = 0; if (index < end) { wanted = folded(name[index] as I64); }
        I64 actual = encoding_data.alias_character(at);
        if (index == end && actual == 0) { return encoding_data.alias_character(at + 1); }
        if (index == end || (actual != 0 && wanted < actual)) { high = row; } else { low = row + 1; }
    }
    return 0;
}
export Bool reset(I64 encoding, Bool fatal, Bool ignore_bom) {
    selected = encoding; fatal_mode = fatal; keep_bom = ignore_bom;
    bom_seen = false; byte_position = 0; fault_count = 0; terminal = 0;
    a = 0; b = 0; c = 0; remaining = 0; accumulator = 0; utf_lower = 128; utf_upper = 191;
    utf_byte = -1; surrogate = -1; jis0212 = false;
    jp_state = 0; jp_output_state = 0; jp_output = false;
    pending = -1; replay_n = 0; replay[0] = 0; replay[1] = 0; replay[2] = 0;
    if (encoding < 1 || encoding > encoding_data.COUNT) { terminal = -2; return false; }
    return true;
}
export I64 errors() { return fault_count; }
export I64 position() { return byte_position; }
void restore(I64 value) {
    assert(replay_n < 3);
    I64 index = replay_n;
    while (index > 0) { replay[index] = replay[index - 1]; index = index - 1; }
    replay[0] = value; replay_n = replay_n + 1;
}
I64 handle_utf8(I64 value) {
    if (value < 0) {
        if (remaining != 0) { remaining = 0; accumulator = 0; return -4; }
        return -1;
    }
    if (remaining == 0) {
        if (value < 128) { return value; }
        if (between(value, 194, 223)) { remaining = 1; accumulator = value - 192; return -5; }
        if (between(value, 224, 239)) {
            remaining = 2; accumulator = value - 224;
            if (value == 224) { utf_lower = 160; }
            if (value == 237) { utf_upper = 159; }
            return -5;
        }
        if (between(value, 240, 244)) {
            remaining = 3; accumulator = value - 240;
            if (value == 240) { utf_lower = 144; }
            if (value == 244) { utf_upper = 143; }
            return -5;
        }
        return -4;
    }
    if (value < utf_lower || value > utf_upper) {
        remaining = 0; accumulator = 0; utf_lower = 128; utf_upper = 191;
        restore(value); return -4;
    }
    utf_lower = 128; utf_upper = 191; accumulator = accumulator * 64 + value - 128; remaining = remaining - 1;
    if (remaining != 0) { return -5; }
    I64 result = accumulator; accumulator = 0; return result;
}
I64 utf16(I64 value) {
    if (value < 0) {
        if (utf_byte >= 0 || surrogate >= 0) { utf_byte = -1; surrogate = -1; return -4; }
        return -1;
    }
    if (utf_byte < 0) { utf_byte = value; return -5; }
    I64 unit = utf_byte + value * 256;
    if (selected == 38) { unit = utf_byte * 256 + value; }
    utf_byte = -1;
    if (surrogate >= 0) {
        I64 leading = surrogate; surrogate = -1;
        if (between(unit, 56320, 57343)) { return 65536 + (leading - 55296) * 1024 + unit - 56320; }
        if (selected == 38) { restore(unit % 256); restore(unit / 256); }
        else { restore(unit / 256); restore(unit % 256); }
        return -4;
    }
    if (between(unit, 55296, 56319)) { surrogate = unit; return -5; }
    if (between(unit, 56320, 57343)) { return -4; }
    return unit;
}
I64 gb(I64 value) {
    if (value < 0) {
        if (a != 0 || b != 0 || c != 0) { a = 0; b = 0; c = 0; return -4; }
        return -1;
    }
    if (c != 0) {
        if (!between(value, 48, 57)) {
            restore(value); restore(c); restore(b); a = 0; b = 0; c = 0; return -4;
        }
        I64 point = encoding_data.gb_range((a - 129) * 12600 + (b - 48) * 1260 + (c - 129) * 10 + value - 48);
        a = 0; b = 0; c = 0;
        if (point < 0) { return -4; } return point;
    }
    if (b != 0) {
        if (between(value, 129, 254)) { c = value; return -5; }
        restore(value); restore(b); a = 0; b = 0; return -4;
    }
    if (a != 0) {
        if (between(value, 48, 57)) { b = value; return -5; }
        I64 leading = a; a = 0; I64 pointer = -1;
        I64 offset = 65; if (value < 127) { offset = 64; }
        if (between(value, 64, 126) || between(value, 128, 254)) { pointer = (leading - 129) * 190 + value - offset; }
        I64 point = encoding_data.gb18030(pointer);
        if (point >= 0) { return point; }
        if (value < 128) { restore(value); }
        return -4;
    }
    if (value < 128) { return value; }
    if (value == 128) { return 8364; }
    if (between(value, 129, 254)) { a = value; return -5; }
    return -4;
}
I64 big5(I64 value) {
    if (value < 0) { if (a != 0) { a = 0; return -4; } return -1; }
    if (a != 0) {
        I64 leading = a; a = 0; I64 pointer = -1;
        I64 offset = 98; if (value < 127) { offset = 64; }
        if (between(value, 64, 126) || between(value, 161, 254)) { pointer = (leading - 129) * 157 + value - offset; }
        if (pointer == 1133 || pointer == 1135 || pointer == 1164 || pointer == 1166) {
            pending = 772; if (pointer == 1135 || pointer == 1166) { pending = 780; }
            if (pointer < 1164) { return 202; } return 234;
        }
        I64 point = encoding_data.big5(pointer);
        if (point >= 0) { return point; }
        if (value < 128) { restore(value); }
        return -4;
    }
    if (value < 128) { return value; }
    if (between(value, 129, 254)) { a = value; return -5; }
    return -4;
}
I64 eucjp(I64 value) {
    if (value < 0) { if (a != 0) { a = 0; return -4; } return -1; }
    if (a == 142 && between(value, 161, 223)) { a = 0; return 65377 - 161 + value; }
    if (a == 143 && between(value, 161, 254)) { jis0212 = true; a = value; return -5; }
    if (a != 0) {
        I64 leading = a; a = 0; I64 point = -1;
        if (between(leading, 161, 254) && between(value, 161, 254)) {
            I64 pointer = (leading - 161) * 94 + value - 161;
            if (jis0212) { point = encoding_data.jis0212(pointer); }
            else { point = encoding_data.jis0208(pointer); }
        }
        jis0212 = false;
        if (point >= 0) { return point; }
        if (value < 128) { restore(value); }
        return -4;
    }
    if (value < 128) { return value; }
    if (value == 142 || value == 143 || between(value, 161, 254)) { a = value; return -5; }
    return -4;
}
I64 sjis(I64 value) {
    if (value < 0) { if (a != 0) { a = 0; return -4; } return -1; }
    if (a != 0) {
        I64 leading = a; a = 0; I64 pointer = -1;
        I64 offset = 65; if (value < 127) { offset = 64; }
        I64 leading_offset = 193; if (leading < 160) { leading_offset = 129; }
        if (between(value, 64, 126) || between(value, 128, 252)) { pointer = (leading - leading_offset) * 188 + value - offset; }
        if (between(pointer, 8836, 10715)) { return 57344 - 8836 + pointer; }
        I64 point = encoding_data.jis0208(pointer);
        if (point >= 0) { return point; }
        if (value < 128) { restore(value); }
        return -4;
    }
    if (value <= 128) { return value; }
    if (between(value, 161, 223)) { return 65377 - 161 + value; }
    if (between(value, 129, 159) || between(value, 224, 252)) { a = value; return -5; }
