// user/ci/cib.ci: cib [-r] [-t TOOLCHAIN] OUT PROGRAM.ci (docs/specs/2026-11-07-bu4-toolchain.md 4.2, unit BU-4g):
// builds PROGRAM.ci, its imports found from the working directory as the root, into the executable OUT through the
// SW-2 toolchain, with no C compiler: `cint emit-qbe`, QBE, cint-as and cint ld.
//   TOOLCHAIN  cint's own toolchain file (default /home/opt/cint/cpu-qbe.toolchain); cib runs the `cint` beside it
//              and takes `qbe`, `assembler`, `linker`, `link_before`, `runtime_object` (the archive libci.a: the
//              runtime and the runner shim) and `link_after` from it, in the order written.
//   OUT.cib    the work, made new (it must not exist): e/ and its stage directory, emit-qbe's tree; p.ssa, the
//              program file with its runner calls renamed to the shim's (section 4.1, cint #595); then for module K
//              of the manifest, in its order, K.s from QBE and K.o from cint-as; then m.a, an ar archive of every
//              K.o in that order (cint ld takes one directory grant an argument, and a process holds 16
//              descriptors until FS-4, so the objects go to it as one input).
//   -r         keep the runtime's runner: the program runs as `cint run` would, its fs/1 grants from its arguments
//              (cint-as and cint ld are built so); the shim's members are then never linked.
// The link is `ld OUT link_before... m.a runtime_object link_after...`, then OUT gets mode 0755 (cint ld
// writes the mode fs/1 gives). Every step runs with an empty environment. A step that does not end with status 0
// stops cib after `cib: STEP: exit N` (or `signal N`, or the reason it could not run): status 1. A usage error,
// an unreadable toolchain or manifest, or a work directory that exists: status 2.
//
// cib --self [-t TOOLCHAIN] OUT (unit BU-4h1, goal 5): rebuilds cint itself, Q4's recipe of cint's
// tools/cint_qbe_selfhost.py. The `cint` beside TOOLCHAIN runs emit-qbe on main.ci with SRC/src/compiler as the
// root, SRC the directory of the toolchain's compiler_sources (the pinned sources beside their manifest); no runner is
// renamed (the compiler is a library: the CLI's main calls it); cint-as and cint ld run under --frame-arena
// 134217728, their large tiers (cint #596, #597); the link is `ld OUT link_before... SRC/libcli.a m.a
// link_after...`, libcli.a the pinned CLI, runtime, bridge and build objects (its main pulls the compiler's objects
// from m.a). Then OUT.toolchain: TOOLCHAIN with executable_sha256 the SHA-256 of OUT (src/sha256.ci), so OUT passes
// ready() with it, and `cib --self -t OUT.toolchain` rebuilds with OUT when OUT is named cint. After each step one line
// `cib: STEP [K] peak N KiB`: the child's ru_maxrss from wait4 (under Daphnis its peak of frames, the quota's count).
import user.ci.dev;
import user.ci.shctl;
import user.ci.corectl;
import user.ci.runctl;
import user.ci.metactl;
import user.ci.peakctl;
import src.sha256;
import user.ci.core.put;
import user.ci.core.msg;
import user.ci.core.run;

const I64 MODS = 128;          // modules of one program (hdesk imports 91 since the batch k desk)
const I64 PARTS = 32;          // link_before and link_after lines together
const I64 O_RDONLY = 0;
const I64 O_WRITE = 577;       // O_WRONLY | O_CREAT | O_TRUNC
const I64 EEXIST = 17;

U8[8192] tc;       // the toolchain file
I64 tcn = 0;
U8[65536] mf;      // the emitted tree's MANIFEST
I64 mfn = 0;
U8[65536] fb;      // a file read whole
I64 fbn = 0;
U8[8192] av;       // the argv of the next step, NUL-ended strings
I64 avn = 0;
U8[4096] p;        // a path being built
I64 pn = 0;

I64 qs = -1;       // where each toolchain value starts and ends in tc
I64 qe = -1;
I64 as_s = -1;
I64 as_e = -1;
I64 ld_s = -1;
I64 ld_e = -1;
I64 rt_s = -1;
I64 rt_e = -1;
I64 cs_s = -1;     // compiler_sources, up to its last '/' (--self: src/compiler and libcli.a are beside it)
I64 cs_e = -1;
I64[32] ps;        // the link parts in order: start, end, and whether before the objects
I64[32] pe;
Bool[32] pbefore;
I64 np = 0;

U8[4096] tpath;    // TOOLCHAIN
I64 tpn = 0;
I64 dir_end = 0;   // its directory: tpath[0..dir_end]
U8[4096] outp;     // OUT
I64 outn = 0;
U8[4096] prog;     // PROGRAM.ci
I64 progn = 0;
U8[4096] work;     // OUT.cib
I64 workn = 0;
U8[256] stage;     // emit-qbe's stage directory, beside e
I64 stn = 0;
I64[128] ms;       // each module's .ssa path in mf
I64[128] me;
I64 nm = 0;
I64 prog_mod = -1; // the module that is the program file, cint-program.ssa
Bool keep_runner = false;
Bool self_build = false;  // --self: cint itself

void fail2(in U8[_] what) {
    msg.begin();
    msg.text(what);
    msg.send();
    put.flush();
    dev.exit_now(2);
}

// The whole of file path into fb, at most len(fb) bytes; false when it cannot be read or is larger.
Bool slurp(in U8[_] path) {
    fbn = 0;
    I64 fd = shctl.sh_open(path, O_RDONLY, 0);
    if (fd < 0) { return false; }
    Bool going = true;
    Bool ok = true;
    while (going) {
        if (fbn == len(fb)) {
            ok = false;
            going = false;
        } else {
            I64 r = shctl.fd_read(fd, fb[fbn..len(fb)]);
            if (r < 0) {
                ok = false;
                going = false;
            } else if (r == 0) {
                going = false;
            } else {
                fbn = fbn + r;
            }
        }
    }
    _ = shctl.fd_close(fd);
    return ok;
}

void p_reset() {
    pn = 0;
}

void p_add(in U8[_] s) {
    for i in 0..len(s) {
        if (pn == len(p)) { msg.limit(b"PATH_MAX"); }
        p[pn] = s[i];
        pn = pn + 1;
    }
}

void p_num(I64 v) {
    U8[20] d;
    I64 k = 0;
    I64 x = v;
    if (x == 0) {
        d[0] = '0';
        k = 1;
    }
    while (x > 0) {
        d[k] = ('0' as I64 + x % 10) as U8;
        x = x / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        p_add(d[k..k + 1]);
    }
}

// p: OUT.cib/NAME.
void p_work(in U8[_] name) {
    p_reset();
    p_add(work[0..workn]);
    p_add(b"/");
    p_add(name);
}

// OUT.cib/m.a: `!<arch>`, then for each K.o a 60-byte header (the name `K.o/`, mtime, owner, group 0, mode 644,
// the size) and its bytes, padded to an even length with a newline, as GNU ar writes a member without its symbol
// index (cint ld reads each member's own symbol table).
void archive() {
    p_work(b"m.a");
    U8[4096] path;
    I64 pl = pn;
    for i in 0..pn {
        path[i] = p[i];
    }
    I64 fd = shctl.sh_open(path[0..pl], O_WRITE, 420);
    if (fd < 0) { fail2(b"m.a: cannot write"); }
    if (shctl.fd_write(fd, b"!<arch>\n") < 0) { fail2(b"m.a: cannot write"); }
    for k in 0..nm {
        p_mod(k, b".o");
        I64[16] st;
        if (corectl.co_stat(p[0..pn], 1, st) < 0) { fail2(b"m.a: an object is missing"); }
        I64 osz = st[corectl.ST_SIZE];
        U8[60] h;
        for i in 0..60 {
            h[i] = ' ';
        }
        I64 at = put_num(h, 0, k);
        h[at] = '.';
        h[at + 1] = 'o';
        h[at + 2] = '/';
        _ = put_num(h, 16, 0);
        _ = put_num(h, 28, 0);
        _ = put_num(h, 34, 0);
        h[40] = '6';
        h[41] = '4';
        h[42] = '4';
        _ = put_num(h, 48, osz);
        h[58] = 0x60;
        h[59] = '\n';
        if (shctl.fd_write(fd, h) < 0) { fail2(b"m.a: cannot write"); }
        I64 src = shctl.sh_open(p[0..pn], O_RDONLY, 0);
        if (src < 0) { fail2(b"m.a: an object cannot be read"); }
        I64 left = osz;
        while (left > 0) {
            I64 r = shctl.fd_read(src, fb);
            if (r <= 0) { fail2(b"m.a: an object cannot be read"); }
            if (shctl.fd_write(fd, fb[0..r]) < 0) { fail2(b"m.a: cannot write"); }
            left = left - r;
        }
        _ = shctl.fd_close(src);
        if (osz % 2 == 1 && shctl.fd_write(fd, b"\n") < 0) { fail2(b"m.a: cannot write"); }
    }
    _ = shctl.fd_close(fd);
}

// v in decimal into b from at; the index after it.
I64 put_num(inout U8[60] b, I64 at, I64 v) {
    U8[20] d;
    I64 k = 0;
    I64 x = v;
    if (x == 0) {
        d[0] = '0';
        k = 1;
    }
    while (x > 0) {
        d[k] = ('0' as I64 + x % 10) as U8;
        x = x / 10;
        k = k + 1;
    }
    I64 i = at;
    while (k > 0) {
        k = k - 1;
        b[i] = d[k];
        i = i + 1;
    }
    return i;
}

// p: OUT.cib/K.EXT.
void p_mod(I64 k, in U8[_] ext) {
    p_reset();
    p_add(work[0..workn]);
    p_add(b"/");
    p_num(k);
    p_add(ext);
}

void av_reset() {
    avn = 0;
}

void av_add(in U8[_] s) {
    if (avn + len(s) + 1 > len(av)) { msg.limit(b"ARG_MAX"); }
    for i in 0..len(s) {
        av[avn + i] = s[i];
    }
    av[avn + len(s)] = 0;
    avn = avn + len(s) + 1;
}

// Runs av; on any end but exit 0, `cib: STEP K: ...` and status 1 (K omitted when below 0).
void step(in U8[_] what, I64 k) {
    I64 st = run.spawn(av[0..avn]);
    if (st == 0 && self_build) {
        msg.begin();
        msg.text(what);
        if (k >= 0) {
            msg.text(b" ");
            msg.num(k);
        }
        msg.text(b" peak ");
        msg.num(peakctl.sh_maxrss());
        msg.text(b" KiB");
        msg.send();
    }
    if (st == 0) { return; }
    msg.begin();
    msg.text(what);
    if (k >= 0) {
        msg.text(b" ");
        msg.num(k);
    }
    msg.text(b": ");
    if (st < 0) {
        msg.reason(0 - st);
    } else if ((st & 127) == 0) {
        msg.text(b"exit ");
        msg.num((st >> 8) & 255);
    } else {
        msg.text(b"signal ");
        msg.num(st & 127);
    }
    msg.send();
    put.flush();
    dev.exit_now(1);
}

Bool key_is(I64 s, I64 e, in U8[_] k) {
    if (e - s != len(k)) { return false; }
    for i in 0..len(k) {
        if (tc[s + i] != k[i]) { return false; }
    }
    return true;
}

// The toolchain's lines `KEY VALUE`, the keys cib takes; false when one it needs is missing.
Bool read_toolchain() {
    if (!slurp(tpath[0..tpn]) || fbn > len(tc)) { return false; }
    for i in 0..fbn {
        tc[i] = fb[i];
    }
    tcn = fbn;
    I64 at = 0;
    while (at < tcn) {
        I64 e = at;
        while (e < tcn && tc[e] != '\n') { e = e + 1; }
        I64 sp = at;
        while (sp < e && tc[sp] != ' ') { sp = sp + 1; }
        I64 vs = sp + 1;
        if (sp < e) {
            if (key_is(at, sp, b"qbe")) {
                qs = vs;
                qe = e;
            } else if (key_is(at, sp, b"assembler")) {
                as_s = vs;
                as_e = e;
            } else if (key_is(at, sp, b"linker")) {
                ld_s = vs;
                ld_e = e;
            } else if (key_is(at, sp, b"runtime_object")) {
                rt_s = vs;
                rt_e = e;
            } else if (key_is(at, sp, b"compiler_sources")) {
                cs_s = vs;
                cs_e = vs;
                for i in vs..e {
                    if (tc[i] == '/') { cs_e = i; }
                }
            } else if (key_is(at, sp, b"link_before") || key_is(at, sp, b"link_after")) {
                if (np == PARTS) { return false; }
                ps[np] = vs;
                pe[np] = e;
                pbefore[np] = key_is(at, sp, b"link_before");
                np = np + 1;
            }
        }
        at = e + 1;
    }
    dir_end = 0;
    for i in 0..tpn {
        if (tpath[i] == '/') { dir_end = i; }
    }
    return qs >= 0 && as_s >= 0 && ld_s >= 0 && rt_s >= 0 && dir_end > 0 && (!self_build || cs_e > cs_s);
}

// e/MANIFEST.ref names the stage directory beside e; its MANIFEST lists `SHA256 SIZE PATH` after its first line.
// The .ssa paths, in that order, go to ms and me; the program file is the one named cint-program.ssa.
void read_manifest() {
    p_work(b"e/MANIFEST.ref");
    if (!slurp(p[0..pn])) { fail2(b"e/MANIFEST.ref: unreadable"); }
    stn = 0;
    while (stn < fbn && fb[stn] != ' ' && fb[stn] != '\n') {
        if (stn == len(stage)) { fail2(b"e/MANIFEST.ref: a stage name past 256 bytes"); }
        stage[stn] = fb[stn];
        stn = stn + 1;
    }
    if (stn == 0) { fail2(b"e/MANIFEST.ref: no stage"); }
    p_work(stage[0..stn]);
    p_add(b"/MANIFEST");
    if (!slurp(p[0..pn]) || fbn > len(mf)) { fail2(b"MANIFEST: unreadable"); }
    for i in 0..fbn {
        mf[i] = fb[i];
    }
    mfn = fbn;
    I64 at = 0;
    while (at < mfn && mf[at] != '\n') { at = at + 1; }
    at = at + 1;
    nm = 0;
    while (at < mfn) {
        I64 e = at;
        while (e < mfn && mf[e] != '\n') { e = e + 1; }
        I64 s = at;
        I64 sp = 0;
        while (s < e && sp < 2) {
            if (mf[s] == ' ') { sp = sp + 1; }
            s = s + 1;
        }
        if (e - s > 4 && mf[e - 4] == '.' && mf[e - 3] == 's' && mf[e - 2] == 's' && mf[e - 1] == 'a') {
            if (nm == MODS) { msg.limit(b"MODULES"); }
            ms[nm] = s;
            me[nm] = e;
            if (same(mf[s..e], b"cint-program.ssa")) { prog_mod = nm; }
            nm = nm + 1;
        }
        at = e + 1;
    }
    if (nm == 0 || (prog_mod < 0 && !self_build)) { fail2(b"MANIFEST: no program file"); }
}

Bool same(in U8[_] a, in U8[_] b) {
    if (len(a) != len(b)) { return false; }
    for i in 0..len(a) {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

// The program file with `call $cint_program_run_args(` and `call $cint_program_run_argv(` renamed to the shim's
// `ci_program_run_args` and `ci_program_run_argv`, into OUT.cib/p.ssa.
void rename_runner() {
    p_work(stage[0..stn]);
    p_add(b"/cint-program.ssa");
    if (!slurp(p[0..pn])) { fail2(b"cint-program.ssa: unreadable"); }
    p_work(b"p.ssa");
    I64 fd = shctl.sh_open(p[0..pn], O_WRITE, 420);
    if (fd < 0) { fail2(b"p.ssa: cannot write"); }
    I64 at = 0;
    I64 from = 0;
    I64 hits = 0;
    while (at < fbn) {
        if (at + 28 <= fbn && same(fb[at..at + 23], b"call $cint_program_run_")
                && (same(fb[at + 23..at + 28], b"args(") || same(fb[at + 23..at + 28], b"argv("))) {
            if (shctl.fd_write(fd, fb[from..at]) < 0 || shctl.fd_write(fd, b"call $ci_program_run_") < 0) {
                fail2(b"p.ssa: cannot write");
            }
            at = at + 23;
            from = at;
            hits = hits + 1;
        } else {
            at = at + 1;
        }
    }
    if (shctl.fd_write(fd, fb[from..fbn]) < 0) { fail2(b"p.ssa: cannot write"); }
    _ = shctl.fd_close(fd);
    if (hits != 1) { fail2(b"cint-program.ssa: not one runner call"); }
}

void main(in U8[_] a) {
    msg.name(b"cib");
    run.env_clear();
    // the arguments: -r, -t TOOLCHAIN, then OUT and PROGRAM.ci
    I64[8] wa;
    I64[8] wb;
    I64 nw = 0;
    I64 at = 0;
    while (at < len(a)) {
        I64 e = at;
        while (e < len(a) && a[e] != 0) { e = e + 1; }
        if (nw == 8) { fail2(b"usage: cib [-r] [-t TOOLCHAIN] OUT PROGRAM.ci, or cib --self [-t TOOLCHAIN] OUT"); }
        wa[nw] = at;
        wb[nw] = e;
        nw = nw + 1;
        at = e + 1;
    }
    I64 w = 0;
    tpn = 0;
    p_reset();
    p_add(b"/home/opt/cint/cpu-qbe.toolchain");
    for i in 0..pn {
        tpath[i] = p[i];
    }
    tpn = pn;
    Bool opts = true;
    while (opts && w < nw) {
        if (same(a[wa[w]..wb[w]], b"-r")) {
            keep_runner = true;
            w = w + 1;
        } else if (same(a[wa[w]..wb[w]], b"--self")) {
            self_build = true;
            keep_runner = true;
            w = w + 1;
        } else if (same(a[wa[w]..wb[w]], b"-t") && w + 1 < nw && wb[w + 1] - wa[w + 1] <= len(tpath)) {
            tpn = wb[w + 1] - wa[w + 1];
            for i in 0..tpn {
                tpath[i] = a[wa[w + 1] + i];
            }
            w = w + 2;
        } else {
            opts = false;
        }
    }
    I64 want = 2;
    if (self_build) { want = 1; }
    if (nw - w != want || wb[w] - wa[w] < 1 || wb[w + want - 1] - wa[w + want - 1] < 1
            || wb[w] - wa[w] + 4 > len(work)) {
        fail2(b"usage: cib [-r] [-t TOOLCHAIN] OUT PROGRAM.ci, or cib --self [-t TOOLCHAIN] OUT");
    }
    outn = wb[w] - wa[w];
    for i in 0..outn {
        outp[i] = a[wa[w] + i];
        work[i] = a[wa[w] + i];
    }
    if (self_build) {
        prog[0] = 'm';
        prog[1] = 'a';
        prog[2] = 'i';
        prog[3] = 'n';
        prog[4] = '.';
        prog[5] = 'c';
        prog[6] = 'i';
        progn = 7;
    } else {
        progn = wb[w + 1] - wa[w + 1];
        for i in 0..progn {
            prog[i] = a[wa[w + 1] + i];
        }
    }
    work[outn] = '.';
    work[outn + 1] = 'c';
    work[outn + 2] = 'i';
    work[outn + 3] = 'b';
    workn = outn + 4;
    if (!read_toolchain()) { fail2(b"the toolchain file: unreadable, or no qbe, assembler, linker or runtime_object"); }
    I64 r = corectl.co_mkdir(work[0..workn], 493);
    if (r == 0 - EEXIST) { fail2(b"the work directory OUT.cib exists"); }
    if (r < 0) { fail2(b"the work directory OUT.cib: cannot make it"); }
    // 1. emit-qbe
    av_reset();
    p_reset();
    p_add(tpath[0..dir_end]);
    p_add(b"/cint");
    av_add(p[0..pn]);
    av_add(b"emit-qbe");
    av_add(b"--toolchain");
    av_add(tpath[0..tpn]);
    av_add(b"--root");
    if (self_build) {
        p_reset();
        p_add(tc[cs_s..cs_e]);
        p_add(b"/src/compiler");
        av_add(p[0..pn]);
    } else {
        av_add(b".");
    }
    av_add(b"--out");
    p_work(b"e");
    av_add(p[0..pn]);
    av_add(prog[0..progn]);
    step(b"emit-qbe", -1);
    read_manifest();
    // 2. the runner
    if (!keep_runner) { rename_runner(); }
    // 3. QBE and cint-as, module by module
    for k in 0..nm {
        av_reset();
        av_add(tc[qs..qe]);
        av_add(b"-t");
        av_add(b"amd64_sysv");
        av_add(b"-o");
        p_mod(k, b".s");
        av_add(p[0..pn]);
        if (k == prog_mod && !keep_runner) {
            p_work(b"p.ssa");
        } else {
            p_work(stage[0..stn]);
            p_add(b"/");
            p_add(mf[ms[k]..me[k]]);
        }
        av_add(p[0..pn]);
        step(b"qbe", k);
        av_reset();
        av_add(tc[as_s..as_e]);
        av_arena();
        av_add(b"--");
        p_mod(k, b".s");
        av_add(p[0..pn]);
        p_mod(k, b".o");
        av_add(p[0..pn]);
        step(b"as", k);
    }
    // 4. the objects as one archive, cint ld, then the mode
    archive();
    av_reset();
    av_add(tc[ld_s..ld_e]);
    av_arena();
    av_add(b"--");
    av_add(outp[0..outn]);
    for i in 0..np {
        if (pbefore[i]) { av_add(tc[ps[i]..pe[i]]); }
    }
    if (self_build) {
        p_reset();
        p_add(tc[cs_s..cs_e]);
        p_add(b"/libcli.a");
        av_add(p[0..pn]);
        p_work(b"m.a");
        av_add(p[0..pn]);
    } else {
        p_work(b"m.a");
        av_add(p[0..pn]);
        av_add(tc[rt_s..rt_e]);
    }
    for i in 0..np {
        if (!pbefore[i]) { av_add(tc[ps[i]..pe[i]]); }
    }
    step(b"ld", -1);
    r = metactl.co_chmod(outp[0..outn], 493);
    if (r < 0) {
        msg.begin();
        msg.text(b"chmod: ");
        msg.reason(0 - r);
        msg.send();
        put.flush();
        dev.exit_now(1);
    }
    if (self_build) { write_toolchain(); }
    put.flush();
}

// The frame arena of cint-as and cint ld: their large tier's, for every step. Each picks its tier from its input
// (cint-as's small one takes 4 MiB, hdesk's .s is over 6) and takes the arena lazily, so a small input maps what it
// did under 67108864 (BU4-D5, edition 8).
void av_arena() {
    av_add(b"--frame-arena");
    av_add(b"134217728");
}

// OUT.toolchain: the toolchain file, its executable_sha256 line the SHA-256 of OUT.
void write_toolchain() {
    I64 fd = shctl.sh_open(outp[0..outn], O_RDONLY, 0);
    if (fd < 0) { fail2(b"OUT: cannot read it back"); }
    sha256.Sha256[1] st;
    sha256.sha_init(st);
    Bool going = true;
    while (going) {
        I64 r = shctl.fd_read(fd, fb);
        if (r < 0) { fail2(b"OUT: cannot read it back"); }
        if (r == 0) {
            going = false;
        } else {
            sha256.sha_update(st, fb, 0, r);
        }
    }
    _ = shctl.fd_close(fd);
    U8[32] d;
    sha256.sha_final(st, d);
    U8[64] hx;
    for i in 0..32 {
        hx[2 * i] = hexd((d[i] >> 4) as I64);
        hx[2 * i + 1] = hexd((d[i] & 15) as I64);
    }
    p_reset();
    p_add(outp[0..outn]);
    p_add(b".toolchain");
    fd = shctl.sh_open(p[0..pn], O_WRITE, 420);
    if (fd < 0) { fail2(b"OUT.toolchain: cannot write"); }
    I64 at = 0;
    Bool seen = false;
    while (at < tcn) {
        I64 e = at;
        while (e < tcn && tc[e] != '\n') { e = e + 1; }
        I64 sp = at;
        while (sp < e && tc[sp] != ' ') { sp = sp + 1; }
        Bool ok = true;
        if (key_is(at, sp, b"executable_sha256")) {
            seen = true;
            ok = shctl.fd_write(fd, b"executable_sha256 ") >= 0 && shctl.fd_write(fd, hx) >= 0;
        } else {
            ok = shctl.fd_write(fd, tc[at..e]) >= 0;
        }
        if (!ok || shctl.fd_write(fd, b"\n") < 0) { fail2(b"OUT.toolchain: cannot write"); }
        at = e + 1;
    }
    _ = shctl.fd_close(fd);
    if (!seen) { fail2(b"the toolchain file: no executable_sha256"); }
}

U8 hexd(I64 v) {
    if (v < 10) { return (v + 48) as U8; }
    return (v + 87) as U8;
}
